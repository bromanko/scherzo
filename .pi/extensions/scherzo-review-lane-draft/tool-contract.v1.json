{
  "schema_version": 1,
  "artifact_type": "pi_extension_tool_contract",
  "tool_name": "submit_review_lane_draft",
  "label": "Submit Review Lane Draft",
  "description": "Submit the final review_lane_draft object for a native Scherzo review lane. This tool performs no file, network, Linear, git, or remote mutations and rejects common schema-invalid paths, categories, severities, and evidence targets before terminating.",
  "top_level_required": [
    "schema_version",
    "artifact_type",
    "generated_at_utc",
    "producer",
    "lane",
    "input_refs",
    "draft_findings",
    "review_notes",
    "evidence_requests",
    "self_check",
    "remote_mutations"
  ],
  "allowed_workflow_step_scopes": {
    "implementation": [
      "lane_correctness",
      "lane_test_quality",
      "lane_idioms_maintainability",
      "lane_security_performance"
    ],
    "execplan-implementation": [
      "lane_correctness",
      "lane_test_quality",
      "lane_idioms_maintainability",
      "lane_security_performance"
    ],
    "review-native": [
      "lane_correctness",
      "lane_test_quality",
      "lane_idioms_maintainability",
      "lane_security_performance"
    ],
    "review-native-contract-spike": [
      "valid_lane",
      "malformed_lane",
      "failed_lane"
    ]
  },
  "allowed_lane_ids": [
    "correctness",
    "test-quality",
    "idioms-maintainability",
    "security-performance"
  ],
  "allowed_review_note_categories": [
    "correctness",
    "maintainability",
    "security",
    "performance",
    "testing",
    "workflow",
    "documentation",
    "artifact_contract",
    "other"
  ],
  "allowed_evidence_target_keys": [
    "test_name",
    "fixture_id",
    "artifact_path",
    "changed_file_path",
    "static_scan_rule"
  ],
  "defense_in_depth_rules": {
    "schema_version": 1,
    "artifact_type": "review_lane_draft",
    "remote_mutations": "none",
    "paths_must_be_relative": true,
    "reject_sibling_tool_calls": true
  },
  "script_owned_deep_validation": [
    "input_refs artifact reference semantics, including repository- or run-root-relative paths such as artifacts/review/prepare_review/diff.patch and rejection of absolute local paths",
    "draft finding severity and category policy",
    "finding location line-range semantics",
    "finding location path portability",
    "finding category policy beyond JSON type checks",
    "evidence request target path portability",
    "finding-to-evidence linkage",
    "duplicate ids",
    "blocking correctness evidence policy",
    "final synthesis readiness"
  ]
