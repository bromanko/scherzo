if command -v devenv >/dev/null 2>&1; then
  source <(devenv direnvrc)
fi
use devenv

# Load local secrets and overrides such as LINEAR_API_KEY, LINEAR_PROJECT_SLUG,
# and LINEAR_DEFAULT_PROJECT.
# .env and .env.local are gitignored; keep them out of version control.
dotenv_if_exists .env
dotenv_if_exists .env.local
