{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/implementation-pack-submission.v2.schema.json",
  "title": "Scherzo ExecPlan v2 implementation pack provider submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "source_issue", "sections", "conflict_policy"],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_type": { "const": "implementation_pack_submission" },
    "pack_id": { "type": "string", "minLength": 1 },
    "source_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "title", "url"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_context",
        "verified_facts",
        "concrete_steps",
        "testing_and_falsifiability",
        "interfaces_and_dependencies",
        "artifacts_and_notes"
      ],
      "properties": {
        "repo_context": { "type": "string", "minLength": 1 },
        "verified_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact", "evidence"],
            "properties": {
              "fact": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "concrete_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "instructions", "files", "commands", "expected_result"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "instructions": { "type": "string", "minLength": 1 },
              "files": { "type": "array", "items": { "$ref": "#/$defs/repo_path" } },
              "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "expected_result": { "type": "string", "minLength": 1 }
            }
          }
        },
        "testing_and_falsifiability": { "type": "string", "minLength": 1 },
        "interfaces_and_dependencies": { "type": "string", "minLength": 1 },
        "artifacts_and_notes": { "type": "string", "minLength": 1 }
      }
    },
    "conflict_policy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
    }
  }
}
