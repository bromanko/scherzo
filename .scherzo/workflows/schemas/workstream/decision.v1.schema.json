{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "workstream_id",
    "kind",
    "summary",
    "decided_by",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "scherzo.decision.v1"
    },
    "artifact_id": {
      "type": "string"
    },
    "workstream_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "approve",
        "request_changes",
        "reject",
        "deviate"
      ]
    },
    "summary": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    }
  }
}
