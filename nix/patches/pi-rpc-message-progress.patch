diff --git a/packages/coding-agent/src/modes/rpc/rpc-message-updates.ts b/packages/coding-agent/src/modes/rpc/rpc-message-updates.ts
new file mode 100644
index 0000000..5c41aaf
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-message-updates.ts
@@ -0,0 +1,87 @@
+import type { AgentSessionEvent } from "../../core/agent-session.ts";
+
+export const RPC_MESSAGE_UPDATE_MODES = ["full", "progress", "off"] as const;
+export type RpcMessageUpdates = (typeof RPC_MESSAGE_UPDATE_MODES)[number];
+
+export const RPC_MESSAGE_PROGRESS_INTERVAL_MS = 10_000;
+
+export interface RpcMessageProgressEvent {
+	type: "message_progress";
+	assistantEventType: string;
+}
+
+export type RpcOutputEvent = AgentSessionEvent | RpcMessageProgressEvent;
+
+export interface RpcMessageUpdateParseResult {
+	mode: RpcMessageUpdates;
+	warning?: string;
+}
+
+export function isRpcMessageUpdates(value: string): value is RpcMessageUpdates {
+	return RPC_MESSAGE_UPDATE_MODES.includes(value as RpcMessageUpdates);
+}
+
+export function parseRpcMessageUpdates(
+	value: string | undefined,
+	source: "cli" | "env",
+): RpcMessageUpdateParseResult {
+	if (value === undefined) {
+		return { mode: "full" };
+	}
+
+	if (isRpcMessageUpdates(value)) {
+		return { mode: value };
+	}
+
+	return {
+		mode: "full",
+		warning:
+			`Invalid RPC message update mode "${value}" from ${source}. Valid values: ${RPC_MESSAGE_UPDATE_MODES.join(", ")}`,
+	};
+}
+
+export interface ResolveRpcMessageUpdatesOptions {
+	cliMode?: RpcMessageUpdates;
+	cliFlagSeen?: boolean;
+	envValue?: string;
+}
+
+export function resolveRpcMessageUpdates(options: ResolveRpcMessageUpdatesOptions): RpcMessageUpdateParseResult {
+	if (options.cliFlagSeen) {
+		return { mode: options.cliMode ?? "full" };
+	}
+	return parseRpcMessageUpdates(options.envValue, "env");
+}
+
+export function createRpcSessionEventFilter(
+	mode: RpcMessageUpdates,
+	now: () => number = Date.now,
+	progressIntervalMs = RPC_MESSAGE_PROGRESS_INTERVAL_MS,
+): (event: AgentSessionEvent) => RpcOutputEvent | undefined {
+	let nextProgressAt = 0;
+
+	return (event) => {
+		if (event.type === "message_start") {
+			nextProgressAt = 0;
+			return event;
+		}
+
+		if (event.type !== "message_update" || mode === "full") {
+			return event;
+		}
+
+		if (mode === "off") {
+			return undefined;
+		}
+
+		const observedAt = now();
+		if (observedAt < nextProgressAt) {
+			return undefined;
+		}
+		nextProgressAt = observedAt + progressIntervalMs;
+		return {
+			type: "message_progress",
+			assistantEventType: event.assistantMessageEvent.type,
+		};
+	};
+}
diff --git a/packages/coding-agent/test/rpc-message-updates.test.ts b/packages/coding-agent/test/rpc-message-updates.test.ts
new file mode 100644
index 0000000..5d040ae
--- /dev/null
+++ b/packages/coding-agent/test/rpc-message-updates.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, test } from "vitest";
+import type { AgentSessionEvent } from "../src/core/agent-session.ts";
+import {
+	createRpcSessionEventFilter,
+	parseRpcMessageUpdates,
+	resolveRpcMessageUpdates,
+} from "../src/modes/rpc/rpc-message-updates.ts";
+
+function messageUpdate(type = "thinking_delta"): AgentSessionEvent {
+	return {
+		type: "message_update",
+		message: { growing: "content that must not reach progress output" },
+		assistantMessageEvent: {
+			type,
+			delta: "secret streamed content",
+			partial: { growing: "content that must not reach progress output" },
+		},
+	} as unknown as AgentSessionEvent;
+}
+
+function messageStart(): AgentSessionEvent {
+	return { type: "message_start", message: {} } as unknown as AgentSessionEvent;
+}
+
+describe("RPC message update modes", () => {
+	test("defaults to full and resolves environment configuration", () => {
+		expect(parseRpcMessageUpdates(undefined, "cli")).toEqual({ mode: "full" });
+		expect(resolveRpcMessageUpdates({ envValue: "progress" })).toEqual({ mode: "progress" });
+		expect(resolveRpcMessageUpdates({ cliMode: "off", cliFlagSeen: true, envValue: "full" })).toEqual({
+			mode: "off",
+		});
+	});
+
+	test("preserves full updates in full mode", () => {
+		const update = messageUpdate();
+		expect(createRpcSessionEventFilter("full")(update)).toBe(update);
+	});
+
+	test("suppresses message updates in off mode", () => {
+		expect(createRpcSessionEventFilter("off")(messageUpdate())).toBeUndefined();
+	});
+
+	test("emits bounded content-free progress while updates continue", () => {
+		let observedAt = 1_000;
+		const filter = createRpcSessionEventFilter("progress", () => observedAt, 10_000);
+
+		expect(filter(messageUpdate())).toEqual({
+			type: "message_progress",
+			assistantEventType: "thinking_delta",
+		});
+
+		observedAt = 5_000;
+		expect(filter(messageUpdate("text_delta"))).toBeUndefined();
+
+		observedAt = 11_000;
+		expect(filter(messageUpdate("text_delta"))).toEqual({
+			type: "message_progress",
+			assistantEventType: "text_delta",
+		});
+	});
+
+	test("starts a fresh progress interval for each message", () => {
+		let observedAt = 1_000;
+		const filter = createRpcSessionEventFilter("progress", () => observedAt, 10_000);
+		expect(filter(messageUpdate())).toBeDefined();
+
+		observedAt = 2_000;
+		expect(filter(messageUpdate())).toBeUndefined();
+		expect(filter(messageStart())).toEqual(messageStart());
+		expect(filter(messageUpdate())).toBeDefined();
+	});
+});
