#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$repo_root"

python3 - <<'PY'
from pathlib import Path
import json
try:
    import jsonschema
except Exception as exc:
    raise SystemExit(f"jsonschema_unavailable:{exc}")
root = Path('test/fixtures/structured_output/pi_raw_schema')
schema = json.loads(Path('.scherzo/workflows/schemas/provider/review-lane-draft.correctness.v1.schema.json').read_text())
validator = jsonschema.Draft202012Validator(schema)
validator.validate(json.loads((root / 'valid-review-lane.arguments.json').read_text()))
for name in [
    'invalid-review-note-category.arguments.json',
    'invalid-evidence-target-field.arguments.json',
]:
    payload = json.loads((root / name).read_text())
    try:
        validator.validate(payload)
    except jsonschema.ValidationError:
        continue
    raise SystemExit(f'invalid_fixture_accepted:{name}')
spec = json.loads((root / 'spec.correctness.json').read_text())
assert spec['tool_name'] == 'submit_structured_output'
assert spec['parameters_schema_path'] == '.scherzo/workflows/schemas/provider/review-lane-draft.correctness.v1.schema.json'
assert spec['parameters_schema'].get('type') == 'object'
assert 'validation_schema' not in spec
assert 'require_single' not in spec
assert 'reject_sibling_tool_calls' not in spec
assert spec['terminate'] is True
PY

if command -v pi >/dev/null 2>&1; then
  pi_version="$(pi --version 2>&1 | tail -n 1 | tr ' ' '_')"
else
  printf 'STRUCTURED_OUTPUT_RAW_SCHEMA_SMOKE status=failed reason=pi_unavailable\n' >&2
  exit 1
fi

output_dir="${SCHERZO_STRUCTURED_OUTPUT_SMOKE_DIR:-tmp/scherzo-structured-output-raw-schema-smoke}"
mkdir -p "$output_dir"
spec_path="$repo_root/test/fixtures/structured_output/pi_raw_schema/spec.correctness.json"
provider_path="$repo_root/test/fixtures/structured_output/pi_raw_schema/smoke_provider.ts"

stdout_path=""
stderr_path=""

fail_smoke() {
  reason="$1"
  printf 'STRUCTURED_OUTPUT_RAW_SCHEMA_SMOKE status=failed reason=%s transcript=%s stderr=%s\n' "$reason" "$stdout_path" "$stderr_path" >&2
  if [ -s "$stderr_path" ]; then
    printf '%s\n' '--- pi stderr ---' >&2
    tail -80 "$stderr_path" >&2
  fi
  if [ -s "$stdout_path" ]; then
    printf '%s\n' '--- pi transcript tail ---' >&2
    tail -120 "$stdout_path" >&2
  fi
  exit 1
}

run_smoke_case() {
  name="$1"
  invalid_fixture="${2:-}"
  stdout_path="$output_dir/$name.transcript.jsonl"
  stderr_path="$output_dir/$name.pi.stderr"
  : >"$stdout_path"
  : >"$stderr_path"

  rpc_requests=$(
    cat <<'EOF'
{"id":"structured-output-tool-info","type":"prompt","message":"/structured-output-tool-info"}
{"id":"raw-schema-smoke","type":"prompt","message":"run structured output raw schema smoke"}
EOF
  )

  if ! printf '%s\n' "$rpc_requests" | \
    SCHERZO_RAW_SCHEMA_SMOKE_API_KEY=dummy \
    SCHERZO_RAW_SCHEMA_SMOKE_INVALID_FIXTURE="$invalid_fixture" \
    SCHERZO_STRUCTURED_OUTPUT_TOOL_SPEC_PATH="$spec_path" \
    SCHERZO_WORKFLOW_ID=implementation \
    SCHERZO_STEP_ID=lane_correctness \
    pi \
      --mode rpc \
      --no-session \
      --no-builtin-tools \
      --no-skills \
      --no-prompt-templates \
      --no-themes \
      --no-context-files \
      --extension "$provider_path" \
      --model scherzo-raw-schema-smoke/scherzo-raw-schema-smoke \
      >"$stdout_path" 2>"$stderr_path"; then
    fail_smoke "${name}_pi_rpc_failed"
  fi

  if grep -q 'Extension runtime not initialized' "$stdout_path" "$stderr_path"; then
    fail_smoke "${name}_extension_runtime_not_initialized"
  fi
  if ! grep -q 'SCHERZO_STRUCTURED_OUTPUT_TOOL_ADVERTISED=.*"status":"active"' "$stdout_path" "$stderr_path"; then
    fail_smoke "${name}_structured_output_tool_not_active"
  fi
  if grep -q 'RAW_SCHEMA_SMOKE_INVALID_REACHED_EXECUTE' "$stdout_path"; then
    fail_smoke "${name}_invalid_payload_accepted"
  fi
  if ! grep -q 'scherzo_structured_output_tool_receipt' "$stdout_path"; then
    fail_smoke "${name}_valid_payload_not_accepted"
  fi
  if ! grep -q '"terminate":true' "$stdout_path"; then
    fail_smoke "${name}_terminating_tool_result_missing"
  fi
}

run_smoke_case missing-required ""
if ! grep -q 'Validation failed for tool.*submit_structured_output' "$stdout_path"; then
  fail_smoke missing_required_not_rejected_by_provider_validation
fi
missing_required_transcript="$stdout_path"

run_smoke_case invalid-category invalid-review-note-category.arguments.json
if ! grep -q 'Validation failed for tool.*submit_structured_output' "$stdout_path"; then
  fail_smoke invalid_category_not_rejected_by_provider_validation
fi
invalid_category_transcript="$stdout_path"

printf 'STRUCTURED_OUTPUT_RAW_SCHEMA_SMOKE status=passed pi_version=%s invalid_required=rejected_before_execute invalid_category=rejected_before_execute valid=accepted terminate=true extension=active transcripts=%s,%s\n' "$pi_version" "$missing_required_transcript" "$invalid_category_transcript"
