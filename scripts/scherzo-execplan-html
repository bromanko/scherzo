def render_command(args: Sequence[str]) -> None:
    if len(args) not in {2, 3}:
        usage()
        sys.exit(2)
    plan_path = Path(args[0])
    output_path = Path(args[1])
    display_path = args[2] if len(args) == 3 else None
    if not plan_path.exists():
        fail(f"plan file does not exist: {plan_path}")
    html_text = render_plan(plan_path, display_path)
    try:
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(html_text, encoding="utf-8")
    except OSError as exc:
        fail(f"could not write HTML artifact: {exc}")
    print(f"PLAN_HTML_PATH={output_path}")


def main(argv: Sequence[str]) -> None:
    command = argv[1] if len(argv) > 1 else ""
    args = argv[2:]
    if command == "render":
        render_command(args)
    elif command == "extract-md":
        extract_md_command(args)
    elif command == "extract-text":
        extract_text_command(args)
    elif command == "section":
        section_command(args)
    elif command == "brief":
        brief_command(args)
    elif command in {"-h", "--help", "help"}:
        usage()
    else:
        usage()
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
