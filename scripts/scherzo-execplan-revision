#!/usr/bin/env python3
"""Helpers for Scherzo's workflow:execplan-revision pipeline.

The workflow starts in a fresh jj workspace created from the coordinating repo.
This helper deterministically finds the referenced GitHub PR from the Linear
issue, fetches the latest PR branch, collects review feedback, validates that
only the ExecPlan changed, pushes the existing PR branch, and posts one concise
PR acknowledgement comment.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import textwrap
import urllib.request
from pathlib import Path
from typing import Any

TRUSTED_ASSOCIATIONS = {"OWNER", "MEMBER", "COLLABORATOR", "CONTRIBUTOR"}
TMP_DIR = Path("tmp")
METADATA_PATH = TMP_DIR / "execplan-revision-pr.json"
FEEDBACK_JSON_PATH = TMP_DIR / "execplan-revision-feedback.json"
FEEDBACK_MD_PATH = TMP_DIR / "execplan-revision-feedback.md"
SUMMARY_PATH = TMP_DIR / "execplan-revision-summary.md"
PUBLISH_PATH = TMP_DIR / "execplan-revision-publish.json"
ACK_COMMENT_PATH = TMP_DIR / "execplan-revision-pr-comment.md"


def usage() -> None:
    print(
        """Usage: scherzo-execplan-revision <prepare|validate|publish|acknowledge>

Run from a Scherzo jj workspace root.

prepare      Find the PR referenced by the Linear issue, fetch latest PR head,
             rebase the workspace onto it, and collect PR feedback into tmp/.
validate     Validate that the agent edited only the referenced ExecPlan file,
             or that it intentionally made no plan changes.
publish      Commit/describe the revision and push the existing PR branch, or
             no-op when validation found no plan changes.
acknowledge  Post one concise PR comment summarizing the revision pass and
             print the final Linear handoff result inline.
""",
        file=sys.stderr,
    )


def fail(message: str) -> None:
    print(f"scherzo-execplan-revision: {message}", file=sys.stderr)
    sys.exit(1)


def run(args: list[str], *, check: bool = True) -> str:
    proc = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and proc.returncode != 0:
        stderr = proc.stderr.strip()
        stdout = proc.stdout.strip()
        details = stderr or stdout or f"exit code {proc.returncode}"
        fail(f"command failed: {' '.join(args)}\n{details}")
    return proc.stdout


def require_command(name: str) -> None:
    proc = subprocess.run(
        ["sh", "-c", f"command -v {name} >/dev/null 2>&1"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        fail(f"required command not found: {name}")


def load_json(path: Path) -> dict[str, Any]:
    if not path.exists():
        fail(f"missing {path}; run prepare first")
    return json.loads(path.read_text())


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def owner_repo_from_url(url: str) -> str | None:
    if url.startswith("https://github.com/"):
        value = url.removeprefix("https://github.com/")
    elif url.startswith("git@github.com:"):
        value = url.removeprefix("git@github.com:")
    elif url.startswith("ssh://git@github.com/"):
        value = url.removeprefix("ssh://git@github.com/")
    else:
        return None
    value = value.removesuffix(".git")
    parts = value.split("/")
    if len(parts) >= 2 and parts[0] and parts[1]:
        return f"{parts[0]}/{parts[1]}"
    return None


def remote_url(remote: str) -> str | None:
    output = run(["jj", "git", "remote", "list", "--color=never"])
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == remote:
            return parts[1]
    return None


def default_repo(remote: str) -> str:
    explicit = os.environ.get("SCHERZO_PR_REPO", "").strip()
    if explicit:
        return explicit
    url = remote_url(remote)
    if not url:
        fail(f"could not find jj git remote: {remote}")
    repo = owner_repo_from_url(url)
    if not repo:
        fail(f"could not infer GitHub owner/repo from remote URL: {url}")
    return repo


def infer_issue_identifier() -> str:
    explicit = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if explicit:
        return explicit

    cwd = str(Path.cwd())
    marker = "/.scherzo/workspaces/"
    if marker in cwd:
        tail = cwd.split(marker, 1)[1]
        parts = tail.split("/")
        # .scherzo/workspaces/<workflow>/<issue>/<run>/<workspace>
        if len(parts) >= 2 and parts[1]:
            return parts[1]

    fail(
        "could not infer Linear issue identifier from cwd; set "
        "SCHERZO_ISSUE_IDENTIFIER"
    )


def linear_graphql(query: str, variables: dict[str, Any]) -> dict[str, Any]:
    token = os.environ.get("LINEAR_API_KEY", "").strip()
    if not token:
        fail("LINEAR_API_KEY is required to locate PR references on the Linear issue")
    payload = json.dumps({"query": query, "variables": variables}).encode()
    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": token},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            response = json.loads(resp.read())
    except Exception as exc:  # pragma: no cover - defensive CLI boundary
        fail(f"Linear GraphQL request failed: {exc}")
    if response.get("errors"):
        fail("Linear GraphQL returned errors: " + json.dumps(response["errors"]))
    return response["data"]


def fetch_linear_issue(identifier: str) -> dict[str, Any]:
    query = """
    query($id: String!) {
      issue(id: $id) {
        identifier
        title
        description
        url
        comments(first: 100) {
          nodes {
            createdAt
            body
            user { name }
          }
        }
      }
    }
    """
    issue = linear_graphql(query, {"id": identifier}).get("issue")
    if not issue:
        fail(f"Linear issue not found: {identifier}")
    return issue


def extract_pr_candidates(issue: dict[str, Any], repo: str) -> list[dict[str, Any]]:
    texts: list[tuple[str, str]] = [
        ("title", issue.get("title") or ""),
        ("description", issue.get("description") or ""),
    ]
    comments = issue.get("comments", {}).get("nodes", [])
    comments = sorted(comments, key=lambda c: c.get("createdAt") or "", reverse=True)
    for comment in comments:
        source = "comment"
        if comment.get("createdAt"):
            source += f" {comment['createdAt']}"
        texts.append((source, comment.get("body") or ""))

    patterns = [
        (
            re.compile(
                r"https?://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/(\d+)",
                re.IGNORECASE,
            ),
            "github-url",
        ),
        (
            re.compile(
                r"(?<![\w./-])([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)\b"
            ),
            "owner-repo-number",
        ),
        (
            re.compile(r"\b(?:PR|pull request|pull)\s*#?\s*(\d+)\b", re.IGNORECASE),
            "local-pr-number",
        ),
    ]

    found: dict[tuple[str, int], dict[str, Any]] = {}
    for source, text in texts:
        if not text:
            continue
        for pattern, kind in patterns:
            for match in pattern.finditer(text):
                if kind == "local-pr-number":
                    candidate_repo = repo
                    number = int(match.group(1))
                else:
                    candidate_repo = match.group(1)
                    number = int(match.group(2))
                key = (candidate_repo.lower(), number)
                entry = found.setdefault(
                    key,
                    {
                        "repo": candidate_repo,
                        "number": number,
                        "sources": [],
                    },
                )
                entry["sources"].append(f"{kind} in {source}")

    return list(found.values())


def choose_pr_candidate(candidates: list[dict[str, Any]]) -> dict[str, Any]:
    if not candidates:
        fail(
            "no GitHub PR reference found on the Linear issue. Add a human-friendly "
            "reference such as 'Revise PR #51', 'bromanko/scherzo#51', or a full "
            "https://github.com/<owner>/<repo>/pull/<number> URL."
        )
    if len(candidates) > 1:
        details = "; ".join(
            f"{c['repo']}#{c['number']} from {', '.join(c['sources'])}"
            for c in candidates
        )
        fail("multiple GitHub PR references found; please clarify one PR. " + details)
    return candidates[0]


def gh_json(args: list[str]) -> Any:
    raw = run(args)
    return json.loads(raw) if raw.strip() else None


def fetch_pr(candidate: dict[str, Any], expected_repo: str) -> dict[str, Any]:
    repo = candidate["repo"]
    if repo.lower() != expected_repo.lower():
        fail(
            f"PR reference points at {repo}, but this workflow is configured for "
            f"{expected_repo}. Set SCHERZO_PR_REPO to override intentionally."
        )

    fields = ",".join(
        [
            "number",
            "url",
            "state",
            "title",
            "baseRefName",
            "headRefName",
            "headRefOid",
            "headRepository",
            "headRepositoryOwner",
            "isCrossRepository",
            "maintainerCanModify",
            "files",
        ]
    )
    pr = gh_json(["gh", "pr", "view", str(candidate["number"]), "--repo", repo, "--json", fields])
    if not pr:
        fail(f"GitHub PR not found: {repo}#{candidate['number']}")
    if pr.get("state") != "OPEN":
        fail(f"GitHub PR must be OPEN, got {pr.get('state')}: {pr.get('url')}")
    if pr.get("isCrossRepository"):
        fail(
            "cross-repository PRs are not supported by this first revision workflow; "
            "use a same-repository branch or revise manually"
        )

    plan_paths = [
        f.get("path")
        for f in pr.get("files", [])
        if re.match(r"^docs/plans/[^/]+\.md$", f.get("path") or "")
        and f.get("changeType") != "REMOVED"
    ]
    plan_paths = [p for p in plan_paths if p]
    if len(plan_paths) != 1:
        fail(
            "expected the PR to contain exactly one docs/plans/*.md file, found "
            f"{len(plan_paths)}"
        )

    pr["repo"] = repo
    pr["plan_path"] = plan_paths[0]
    return pr


def gh_api_paginated_array(endpoint: str) -> list[dict[str, Any]]:
    raw = run(["gh", "api", "--paginate", "--slurp", endpoint])
    data = json.loads(raw) if raw.strip() else []
    if isinstance(data, list) and data and all(isinstance(item, list) for item in data):
        flattened: list[dict[str, Any]] = []
        for page in data:
            flattened.extend(page)
        return flattened
    if isinstance(data, list):
        return data
    return [data]


def normalize_feedback(pr: dict[str, Any]) -> list[dict[str, Any]]:
    repo = pr["repo"]
    number = pr["number"]
    issue_comments = gh_api_paginated_array(
        f"repos/{repo}/issues/{number}/comments?per_page=100"
    )
    reviews = gh_api_paginated_array(f"repos/{repo}/pulls/{number}/reviews?per_page=100")
    inline_comments = gh_api_paginated_array(
        f"repos/{repo}/pulls/{number}/comments?per_page=100"
    )

    items: list[dict[str, Any]] = []

    def association(obj: dict[str, Any]) -> str:
        return (obj.get("author_association") or "NONE").upper()

    def login(obj: dict[str, Any]) -> str:
        user = obj.get("user") or {}
        return user.get("login") or "<unknown>"

    for comment in issue_comments:
        assoc = association(comment)
        items.append(
            {
                "kind": "pr_comment",
                "id": comment.get("id"),
                "url": comment.get("html_url"),
                "author": login(comment),
                "author_association": assoc,
                "trusted": assoc in TRUSTED_ASSOCIATIONS,
                "created_at": comment.get("created_at"),
                "updated_at": comment.get("updated_at"),
                "body": comment.get("body") or "",
            }
        )

    for review in reviews:
        assoc = association(review)
        items.append(
            {
                "kind": "review_summary",
                "id": review.get("id"),
                "url": review.get("html_url"),
                "author": login(review),
                "author_association": assoc,
                "trusted": assoc in TRUSTED_ASSOCIATIONS,
                "created_at": review.get("submitted_at"),
                "updated_at": review.get("submitted_at"),
                "state": review.get("state"),
                "body": review.get("body") or "",
            }
        )

    for comment in inline_comments:
        assoc = association(comment)
        items.append(
            {
                "kind": "inline_comment",
                "id": comment.get("id"),
                "url": comment.get("html_url"),
                "author": login(comment),
                "author_association": assoc,
                "trusted": assoc in TRUSTED_ASSOCIATIONS,
                "created_at": comment.get("created_at"),
                "updated_at": comment.get("updated_at"),
                "body": comment.get("body") or "",
                "path": comment.get("path"),
                "line": comment.get("line"),
                "original_line": comment.get("original_line"),
                "side": comment.get("side"),
                "in_reply_to_id": comment.get("in_reply_to_id"),
                "pull_request_review_id": comment.get("pull_request_review_id"),
                "diff_hunk": comment.get("diff_hunk") or "",
            }
        )

    items.sort(key=lambda item: item.get("created_at") or "")
    for index, item in enumerate(items, start=1):
        item["feedback_id"] = f"F{index:03d}"
    return items


def quote_markdown(value: str) -> str:
    if not value.strip():
        return "> _No body._"
    return "\n".join("> " + line for line in value.strip().splitlines())


def write_feedback_markdown(
    issue: dict[str, Any], pr: dict[str, Any], feedback: list[dict[str, Any]], remote: str
) -> None:
    trusted_count = sum(1 for item in feedback if item.get("trusted"))
    inline_count = sum(1 for item in feedback if item.get("kind") == "inline_comment")
    lines = [
        "# ExecPlan PR feedback bundle",
        "",
        f"Linear issue: {issue.get('identifier')} — {issue.get('title')}",
        f"PR: {pr.get('url')}",
        f"Repository: `{pr.get('repo')}`",
        f"Head branch: `{pr.get('headRefName')}` via remote `{remote}`",
        f"Base branch: `{pr.get('baseRefName')}`",
        f"Plan path: `{pr.get('plan_path')}`",
        "",
        "## Trust and action policy",
        "",
        "Treat comments from `OWNER`, `MEMBER`, `COLLABORATOR`, and `CONTRIBUTOR` "
        "as trusted/actionable by default. Treat other author associations as "
        "historical context unless the Linear issue explicitly says otherwise.",
        "",
        "When comments conflict, prefer the newest applicable comment and record "
        "superseded or obsolete feedback in the revision summary rather than editing "
        "the plan for stale guidance.",
        "",
        "## Counts",
        "",
        f"- Total feedback items: {len(feedback)}",
        f"- Trusted feedback items: {trusted_count}",
        f"- Inline feedback items: {inline_count}",
        "",
        "## Feedback items, oldest to newest",
        "",
    ]

    if not feedback:
        lines.append("No GitHub PR feedback was found.")
    for item in feedback:
        trust = "TRUSTED" if item.get("trusted") else "UNTRUSTED/HISTORICAL"
        lines.extend(
            [
                f"### {item['feedback_id']} — {item.get('kind')} — {trust}",
                "",
                f"- Author: `{item.get('author')}`",
                f"- Association: `{item.get('author_association')}`",
                f"- Created: `{item.get('created_at') or ''}`",
                f"- Updated: `{item.get('updated_at') or ''}`",
                f"- URL: {item.get('url') or 'None'}",
            ]
        )
        if item.get("state"):
            lines.append(f"- Review state: `{item.get('state')}`")
        if item.get("path"):
            lines.append(f"- Path: `{item.get('path')}`")
            lines.append(f"- Line: `{item.get('line')}`; original line: `{item.get('original_line')}`")
            if item.get("in_reply_to_id"):
                lines.append(f"- Reply to comment id: `{item.get('in_reply_to_id')}`")
        lines.extend(["", "Body:", "", quote_markdown(item.get("body") or ""), ""])
        if item.get("diff_hunk"):
            diff = item["diff_hunk"]
            if len(diff) > 6000:
                diff = diff[:6000] + "\n...diff hunk truncated..."
            lines.extend(["Diff hunk:", "", "```diff", diff, "```", ""])

    FEEDBACK_MD_PATH.write_text("\n".join(lines).rstrip() + "\n")


def current_commit(rev: str) -> str:
    return run(["jj", "log", "-r", rev, "--no-graph", "-T", "commit_id", "--color=never"]).strip()


def current_commit_short(rev: str) -> str:
    return run(["jj", "log", "-r", rev, "--no-graph", "-T", "commit_id.short()", "--color=never"]).strip()


def prepare_command() -> None:
    require_command("jj")
    require_command("gh")
    require_command("python3")

    remote = os.environ.get("SCHERZO_PR_REMOTE", "origin").strip() or "origin"
    repo = default_repo(remote)
    issue_identifier = infer_issue_identifier()
    issue = fetch_linear_issue(issue_identifier)
    candidate = choose_pr_candidate(extract_pr_candidates(issue, repo))
    pr = fetch_pr(candidate, repo)

    head_branch = pr.get("headRefName")
    if not head_branch:
        fail("GitHub PR is missing headRefName")

    # Always refresh the branch before editing so the agent sees the latest
    # published PR head rather than an older local bookmark.
    run(["jj", "git", "fetch", "--remote", remote, "--branch", head_branch])
    run(["jj", "describe", "-m", f"Scherzo execplan revision workspace for PR #{pr['number']}"])
    run(["jj", "rebase", "-r", "@", "-d", f"{head_branch}@{remote}"])

    plan_path = Path(pr["plan_path"])
    if not plan_path.exists():
        fail(f"plan path from PR does not exist after fetching PR head: {plan_path}")

    TMP_DIR.mkdir(parents=True, exist_ok=True)
    feedback = normalize_feedback(pr)
    parent_commit = current_commit("@-")
    metadata = {
        "linear_issue_identifier": issue.get("identifier"),
        "linear_issue_url": issue.get("url"),
        "repo": pr["repo"],
        "remote": remote,
        "pr_number": pr["number"],
        "pr_url": pr["url"],
        "pr_title": pr.get("title"),
        "base_branch": pr.get("baseRefName"),
        "head_branch": head_branch,
        "head_oid_at_prepare": pr.get("headRefOid"),
        "parent_commit_at_prepare": parent_commit,
        "plan_path": pr["plan_path"],
        "feedback_items": len(feedback),
        "trusted_feedback_items": sum(1 for item in feedback if item.get("trusted")),
    }
    write_json(METADATA_PATH, metadata)
    write_json(FEEDBACK_JSON_PATH, {"metadata": metadata, "items": feedback})
    write_feedback_markdown(issue, pr, feedback, remote)

    print(f"PR_URL={metadata['pr_url']}")
    print(f"PR_NUMBER={metadata['pr_number']}")
    print(f"REPO={metadata['repo']}")
    print(f"HEAD_BRANCH={metadata['head_branch']}")
    print(f"BASE_BRANCH={metadata['base_branch']}")
    print(f"PLAN_PATH={metadata['plan_path']}")
    print(f"FEEDBACK_ITEMS={metadata['feedback_items']}")
    print(f"TRUSTED_FEEDBACK_ITEMS={metadata['trusted_feedback_items']}")
    print(f"FEEDBACK_BUNDLE={FEEDBACK_MD_PATH}")


def changed_files() -> list[str]:
    output = run(["jj", "diff", "--from", "@-", "--to", "@", "--name-only", "--color=never"])
    return [line.strip() for line in output.splitlines() if line.strip()]


def validate_plan(plan_path: str) -> None:
    path = Path(plan_path)
    if not path.exists():
        fail(f"plan file does not exist: {plan_path}")
    text = path.read_text()
    if not re.search(r"^# .+", text, flags=re.MULTILINE):
        fail("plan must contain a level-1 title")
    for heading in ["Progress", "Open Questions and Clarifications Needed"]:
        if f"## {heading}" not in text:
            fail(f"missing required heading: ## {heading}")
    if not re.search(r"^- \[[ xX]\] ", text, flags=re.MULTILINE):
        fail("Progress must contain at least one checklist item")
    local_path_match = re.search(r"/Users/|/home/|/private/|/var/folders/", text)
    if local_path_match:
        fail("plan contains absolute local paths; use repository-relative paths only")


def require_summary() -> str:
    if not SUMMARY_PATH.exists():
        fail(
            f"missing {SUMMARY_PATH}; the revise_plan step must write a concise "
            "revision summary before validation"
        )
    summary = SUMMARY_PATH.read_text().strip()
    if not summary:
        fail(f"{SUMMARY_PATH} is empty")
    return summary


def validate_revision(*, emit: bool = True) -> str:
    metadata = load_json(METADATA_PATH)
    require_summary()
    plan_path = metadata["plan_path"]
    files = changed_files()

    if not files:
        validate_plan(plan_path)
        if emit:
            print(f"PR_URL={metadata['pr_url']}")
            print(f"PLAN_PATH={plan_path}")
            print("REVISION=none")
            print("VALIDATION=ok")
        return "none"

    if files != [plan_path]:
        fail(
            "workflow:execplan-revision may only edit the referenced plan file; "
            f"changed files: {', '.join(files)}; expected only {plan_path}"
        )

    summary = run(["jj", "diff", "--summary", "--from", "@-", "--to", "@", "--color=never", "--", plan_path])
    status = summary.split()[0] if summary.split() else ""
    if status != "M":
        fail(f"plan file must be modified in place, got status {status or 'unknown'}: {plan_path}")

    validate_plan(plan_path)
    if emit:
        print(f"PR_URL={metadata['pr_url']}")
        print(f"PLAN_PATH={plan_path}")
        print("REVISION=updated")
        print("VALIDATION=ok")
    return "updated"


def publish_command() -> None:
    require_command("jj")
    require_command("gh")
    metadata = load_json(METADATA_PATH)
    revision = validate_revision(emit=False)

    publish: dict[str, Any] = {
        "revision": revision,
        "pushed": False,
        "pr_url": metadata["pr_url"],
        "plan_path": metadata["plan_path"],
        "head_branch": metadata["head_branch"],
    }

    if revision == "updated":
        remote = metadata["remote"]
        branch = metadata["head_branch"]
        run(["jj", "git", "fetch", "--remote", remote, "--branch", branch])
        remote_commit = current_commit(f"{branch}@{remote}")
        parent_commit = current_commit("@-")
        if remote_commit != parent_commit:
            fail(
                "PR branch advanced after prepare; rerun the revision workflow on "
                "the latest PR head before pushing"
            )

        run(["jj", "describe", "-m", f"docs(plan): revise execplan from PR #{metadata['pr_number']} feedback"])
        run(["jj", "bookmark", "set", branch, "--revision", "@"])
        run(["jj", "git", "push", "--remote", remote, "--bookmark", branch])
        publish.update(
            {
                "pushed": True,
                "commit": current_commit_short("@"),
            }
        )

    write_json(PUBLISH_PATH, publish)
    print(f"PR_URL={metadata['pr_url']}")
    print(f"PLAN_PATH={metadata['plan_path']}")
    print(f"BRANCH={metadata['head_branch']}")
    print(f"REVISION={revision}")
    print(f"PUSHED={'true' if publish['pushed'] else 'false'}")
    if publish.get("commit"):
        print(f"COMMIT={publish['commit']}")


def acknowledge_command() -> None:
    require_command("gh")
    metadata = load_json(METADATA_PATH)
    summary = require_summary()
    publish = load_json(PUBLISH_PATH) if PUBLISH_PATH.exists() else {"revision": "unknown", "pushed": False}

    comment_lines = [
        f"Scherzo ExecPlan revision pass complete for Linear `{metadata['linear_issue_identifier']}`.",
        "",
        f"PR: {metadata['pr_url']}",
        f"Plan: `{metadata['plan_path']}`",
        f"Revision: `{publish.get('revision', 'unknown')}`",
        f"Pushed: `{'true' if publish.get('pushed') else 'false'}`",
    ]
    if publish.get("commit"):
        comment_lines.append(f"Commit: `{publish['commit']}`")
    comment_lines.extend(["", "## Summary", "", summary, ""])
    ACK_COMMENT_PATH.write_text("\n".join(comment_lines))

    skip_comment = os.environ.get("SCHERZO_EXECPLAN_REVISION_SKIP_PR_COMMENT", "").lower() in {
        "1",
        "true",
        "yes",
    }
    commented = False
    if not skip_comment:
        run(
            [
                "gh",
                "pr",
                "comment",
                str(metadata["pr_number"]),
                "--repo",
                metadata["repo"],
                "--body-file",
                str(ACK_COMMENT_PATH),
            ]
        )
        commented = True

    print(f"PR_URL={metadata['pr_url']}")
    print(f"PLAN_PATH={metadata['plan_path']}")
    print(f"BRANCH={metadata['head_branch']}")
    print(f"REVISION={publish.get('revision', 'unknown')}")
    print(f"PUSHED={'true' if publish.get('pushed') else 'false'}")
    print(f"COMMENTED={'true' if commented else 'false'}")
    if publish.get("commit"):
        print(f"COMMIT={publish['commit']}")
    print("SUMMARY:")
    print(summary)


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] in {"-h", "--help", "help"}:
        usage()
        return 0 if len(argv) == 2 else 2
    command = argv[1]
    if command == "prepare":
        prepare_command()
    elif command == "validate":
        validate_revision()
    elif command == "publish":
        publish_command()
    elif command == "acknowledge":
        acknowledge_command()
    else:
        usage()
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
