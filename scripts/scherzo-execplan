#!/usr/bin/env python3
"""Deterministic helpers for Scherzo ExecPlan bundle workflows."""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import glob
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, Iterable

try:
    import jsonschema
except Exception:  # pragma: no cover - surfaced as a runtime diagnostic.
    jsonschema = None  # type: ignore[assignment]

SCRIPT_ROOT = Path(__file__).resolve().parents[1]
SCHEMA_DIR = Path(".scherzo/workflows/schemas")
IMPLEMENTATION_PACK_SCHEMA = SCHEMA_DIR / "implementation-pack.v2.schema.json"
EXEC_PLAN_BUNDLE_SCHEMA = SCHEMA_DIR / "exec-plan-bundle.v2.schema.json"
CODE_CHANGE_BUNDLE_SCHEMA = SCHEMA_DIR / "code-change-bundle.v2.schema.json"
IMPLEMENTATION_PACK_SUBMISSION_SCHEMA = SCHEMA_DIR / "implementation-pack-submission.v2.schema.json"
EXEC_PLAN_REVISION_SUBMISSION_SCHEMA = SCHEMA_DIR / "exec-plan-revision-submission.v2.schema.json"

REQUIRED_REVIEW_DOC_SECTIONS = [
    "Purpose / Big Picture",
    "Problem Framing and Constraints",
    "Strategy Overview",
    "Alternatives Considered",
    "Risks and Countermeasures",
    "Scope Boundaries",
    "Milestones",
    "Progress",
    "Decision Log",
    "Validation and Acceptance",
    "Rollout, Recovery, and Idempotence",
    "Open Questions and Clarifications Needed",
]
FORBIDDEN_REVIEW_DOC_SECTIONS = {
    "Concrete Steps",
    "Testing and Falsifiability",
    "Interfaces and Dependencies",
    "Artifacts and Notes",
}
BUNDLE_REF_RE = re.compile(r"(?i)\bBundle\s+ref:\s*`?(runs/[^\s`<>)\],;]+)`?")
BUNDLE_SHA_RE = re.compile(r"(?i)\bBundle\s+sha256:\s*`?([a-f0-9]{64})`?")
RUN_ARTIFACT_REF_RE = re.compile(r"\bruns/[A-Za-z0-9._~/-]+")
URL_RE = re.compile(r"https?://[^\s`<>)\]\"']+")
GITHUB_PR_URL_RE = re.compile(r"https?://github\.com/([^/\s]+)/([^/\s]+)/pull/(\d+)", re.IGNORECASE)
GITHUB_PR_TEXT_RE = re.compile(r"\b(?:PR|pull request)\s*#?\s*(\d+)\b", re.IGNORECASE)
REVIEW_DOC_PATH_RE = re.compile(r"\b(?:docs/plans|test/fixtures/execplan_v2)/[^\s`<>)\],;]+\.md\b")
SHA256_TEXT_RE = re.compile(r"\b[a-f0-9]{64}\b", re.IGNORECASE)
ANSI_ESCAPE_RE = re.compile(r"\x1B\[[0-?]*[ -/]*[@-~]")
LINEAR_ISSUE_URL_RE = re.compile(
    r"https://linear\.app/[^\s)>\"]+/issue/([A-Za-z][A-Za-z0-9]*-\d+)[^\s)>\"]*"
)
LINEAR_ISSUE_IDENTIFIER_RE = re.compile(r"\b([A-Za-z][A-Za-z0-9]*-\d+)\b")
FAILURE_PREFIX = "SCHERZO_FAILURE_CODE="
CANONICAL_IMPLEMENTATION_WORKFLOW_LABEL = "workflow:execplan-implementation"
LEGACY_IMPLEMENTATION_WORKFLOW_LABEL = "workflow:execplan-implementation-v2"
REVISION_HEAD_RE = re.compile(r"^[a-f0-9]{12,64}$")
REVISION_BRANCH_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$")
REVISION_REMOTE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
DEFAULT_REVISION_REFRESH_TIMEOUT_SECONDS = 120.0
MAX_WORKSPACE_DRIVER_DETAIL_CHARS = 4000


def usage() -> None:
    print(
        """Usage: scherzo-execplan <command> [options]

Commands:
  validate-review-doc --path PATH
  validate-review-doc --discover-changed-review-doc --write-path PATH
  materialize-pack --review-doc PATH --submission PATH --output PATH
  materialize-pack --review-doc-path-file PATH --submission-step STEP --submission-artifact NAME --output PATH
  validate-bundle --bundle PATH [--bundle-sha256 SHA] [--artifact-root PATH] --repo-root PATH
  publish-review-doc --review-doc-path-file PATH --publish-context PATH [--pack PATH] [--previous-bundle PATH --skip-if-unchanged]
  materialize-bundle --review-doc-path-file PATH --pack PATH --publish-context PATH --output PATH
  prepare-revision --from-issue-context --write-bundle PATH --write-review-doc-path PATH --write-pack PATH
  materialize-revision --previous-bundle PATH --review-doc-path-file PATH --pack PATH --publish-context PATH --status auto --output PATH
  implementation-prepare --from-issue-context
  gate-no-conflict
  materialize-code-change-bundle --bundle PATH --output PATH
""",
        file=sys.stderr,
    )


def fail(message: str, *, code: str | None = None, exit_code: int = 2) -> None:
    if code:
        print(f"{FAILURE_PREFIX}{code}", file=sys.stderr)
    print(f"scherzo-execplan: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def env_value(name: str, default: str = "", *, legacy: str | None = None) -> str:
    value = os.environ.get(name, "").strip()
    if value:
        return value
    if legacy:
        value = os.environ.get(legacy, "").strip()
        if value:
            return value
    return default


def env_enabled(name: str, *, legacy: str | None = None) -> bool:
    return bool(env_value(name, legacy=legacy))


def canonical_json(value: Any) -> str:
    return json.dumps(value, indent=2, sort_keys=True, separators=(",", ": ")) + "\n"


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(canonical_json(value), encoding="utf-8")


def load_json(path: Path, *, code: str | None = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"missing JSON file: {path}", code=code)
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON in {path}: {exc}", code=code)


def path_bytes(path: Path, *, code: str | None = None) -> bytes:
    try:
        return path.read_bytes()
    except FileNotFoundError:
        fail(f"missing file: {path}", code=code)
    except OSError as exc:
        fail(f"could not read {path}: {exc}", code=code)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def file_meta(path: Path, *, code: str | None = None) -> dict[str, Any]:
    data = path_bytes(path, code=code)
    return {"sha256": sha256_bytes(data), "bytes": len(data)}


def repo_root(default: str | None = None) -> Path:
    if default:
        return Path(default)
    value = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if value:
        return Path(value)
    return Path.cwd()


def schema_path(path: Path, root: Path | None = None) -> Path:
    if path.is_absolute():
        return path
    return (root or SCRIPT_ROOT) / path


def validate_schema(value: Any, schema_rel: Path, *, root: Path | None = None) -> None:
    if jsonschema is None:
        fail("python jsonschema package is required")
    schema_file = schema_path(schema_rel, root)
    schema = load_json(schema_file)
    validator = jsonschema.Draft202012Validator(schema)
    errors = sorted(validator.iter_errors(value), key=lambda e: list(e.path))
    if errors:
        first = errors[0]
        location = "/".join(str(part) for part in first.path) or "<root>"
        fail(f"schema validation failed for {schema_rel} at {location}: {first.message}")


def is_repo_relative(value: str) -> bool:
    if not value or value.startswith("/") or value.startswith("<absolute-local-path>"):
        return False
    if re.match(r"^[A-Za-z]:[\\/]", value):
        return False
    parts = Path(value).parts
    return ".." not in parts


def ensure_repo_relative_path(value: str, *, label: str) -> None:
    if not is_repo_relative(value):
        fail(f"{label} must be repository-relative and must not contain parent-directory traversal: {value!r}")


def review_doc_filesystem_path(path_value: str, root: Path | None = None) -> Path:
    ensure_repo_relative_path(path_value, label="review doc path")
    return (root or repo_root()) / path_value


def headings(markdown: str) -> list[tuple[int, str]]:
    result: list[tuple[int, str]] = []
    in_fence = False
    fence_marker = ""
    heading_re = re.compile(r"^(#{1,6})[ \t]+(.+?)\s*#*\s*$")
    for line in markdown.splitlines():
        fence_match = re.match(r"^\s*(```+|~~~+)", line)
        if fence_match:
            marker = fence_match.group(1)[:3]
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif marker == fence_marker:
                in_fence = False
                fence_marker = ""
            continue
        if in_fence:
            continue
        match = heading_re.match(line)
        if not match:
            continue
        title = re.sub(r"\s+", " ", match.group(2)).strip()
        title = re.sub(r"\s+#*$", "", title).strip()
        if title:
            result.append((len(match.group(1)), title))
    return result


def validate_review_doc_path(path: Path, *, allow_fixture: bool = True) -> dict[str, Any]:
    value = str(path)
    ensure_repo_relative_path(value, label="review doc path")
    if not value.endswith(".md"):
        fail(f"review doc must be Markdown source, not generated HTML or another format: {value}")
    if not allow_fixture and not re.match(r"^docs/plans/[^/]+\.md$", value):
        fail(f"discovered review doc must be exactly one docs/plans/*.md path: {value}")
    data = path_bytes(path)
    text = data.decode("utf-8", errors="replace")
    if re.search(r"<!doctype\s+html|<html\b", text, flags=re.IGNORECASE):
        fail("review doc must be Markdown source, not generated HTML")
    if re.search(r"/Users/|/home/|/private/|/var/folders/|<absolute-local-path>", text):
        fail("review doc contains absolute local path shapes; use repository-relative paths only")
    all_headings = headings(text)
    if not any(level == 1 for level, _ in all_headings):
        fail("review doc must contain a level-1 title")
    section_titles = {title for level, title in all_headings if level == 2}
    for section in REQUIRED_REVIEW_DOC_SECTIONS:
        if section not in section_titles:
            fail(f"review doc missing required section: {section}")
    forbidden = sorted(FORBIDDEN_REVIEW_DOC_SECTIONS.intersection(section_titles))
    if forbidden:
        fail(
            "review doc contains mechanical implementation sections that belong in implementation_pack.sections: "
            + ", ".join(forbidden)
        )
    return {"path": value, "sha256": sha256_bytes(data), "bytes": len(data)}


def workspace_driver_command() -> str | None:
    value = os.environ.get("SCHERZO_WORKSPACE_DRIVER", "").strip()
    return value or None


def subprocess_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def format_seconds(value: float) -> str:
    number = float(value)
    if number.is_integer():
        return str(int(number))
    return str(number)


def run_proc(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        stdout = subprocess_text(exc.stdout)
        stderr = subprocess_text(exc.stderr).strip()
        timeout_text = format_seconds(timeout or 0.0)
        message = f"command timed out after {timeout_text}s"
        detail = (stderr + "\n" + message).strip() if stderr else message
        return subprocess.CompletedProcess(args, 124, stdout, detail)


def run(args: list[str], *, check: bool = True) -> str:
    proc = run_proc(args)
    if check and proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        fail(f"command failed: {' '.join(args)}\n{detail}")
    return proc.stdout


def workspace_driver_json(args: list[str]) -> dict[str, Any]:
    driver = workspace_driver_command()
    if not driver:
        fail("SCHERZO_WORKSPACE_DRIVER is required for this operation")
    proc = run_proc([driver, *args])
    try:
        payload = json.loads(proc.stdout)
    except Exception as exc:
        fail(f"workspace driver returned malformed JSON for {' '.join(args)}: {exc}")
    if proc.returncode != 0:
        fail(str(payload.get("message") or proc.stderr or "workspace driver command failed"))
    if not isinstance(payload, dict) or payload.get("version") != 1:
        fail(f"workspace driver JSON for {' '.join(args)} must be an object with version=1")
    return payload


def changed_file_records() -> list[dict[str, str]]:
    payload = workspace_driver_json(["changed-files", "--json"])
    files = payload.get("files")
    if not isinstance(files, list):
        fail("workspace driver changed-files JSON must contain a files list")
    records: list[dict[str, str]] = []
    for item in files:
        if not isinstance(item, dict):
            fail("workspace driver changed-files entries must be objects")
        path = item.get("path")
        status = item.get("status")
        if not isinstance(path, str) or not isinstance(status, str):
            fail("workspace driver changed-files entries must include path and status strings")
        records.append({"path": path, "status": status})
    return records


def discover_changed_review_doc(write_path: Path) -> dict[str, Any]:
    records = changed_file_records()
    candidates = [
        record["path"]
        for record in records
        if record["status"] in {"added", "modified"}
        and re.match(r"^docs/plans/[^/]+\.md$", record["path"])
    ]
    if len(candidates) != 1:
        fail(f"expected exactly one added or modified docs/plans/*.md review doc, found {len(candidates)}")
    review_path = Path(candidates[0])
    meta = validate_review_doc_path(review_path, allow_fixture=False)
    write_path.parent.mkdir(parents=True, exist_ok=True)
    write_path.write_text(str(review_path) + "\n", encoding="utf-8")
    print(f"REVIEW_DOC_PATH={review_path}")
    print(f"REVIEW_DOC_SHA256={meta['sha256']}")
    print(f"REVIEW_DOC_PATH_FILE={write_path}")
    return meta


def command_validate_review_doc(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan validate-review-doc")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--path")
    group.add_argument("--discover-changed-review-doc", action="store_true")
    parser.add_argument("--write-path")
    ns = parser.parse_args(args)
    if ns.discover_changed_review_doc:
        if not ns.write_path:
            fail("--discover-changed-review-doc requires --write-path")
        discover_changed_review_doc(Path(ns.write_path))
        return
    if ns.write_path:
        fail("--write-path is only valid with --discover-changed-review-doc")
    meta = validate_review_doc_path(Path(ns.path))
    print("REVIEW_DOC_VALID=ok")
    print(f"REVIEW_DOC_PATH={meta['path']}")
    print(f"REVIEW_DOC_SHA256={meta['sha256']}")


def read_review_doc_path_file(path: Path) -> Path:
    try:
        value = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        fail(f"missing review doc path file: {path}")
    if not value:
        fail(f"review doc path file is empty: {path}")
    ensure_repo_relative_path(value, label="review doc path")
    return Path(value)


def run_root() -> Path | None:
    value = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    return Path(value) if value else None


def run_artifact_dir() -> Path | None:
    value = os.environ.get("SCHERZO_RUN_ARTIFACT_DIR", "").strip()
    return Path(value) if value else None


def unique_paths(paths: Iterable[Path]) -> list[Path]:
    unique: list[Path] = []
    seen: set[str] = set()
    for path in paths:
        key = str(path)
        if key not in seen:
            unique.append(path)
            seen.add(key)
    return unique


def run_root_artifact_roots() -> list[Path]:
    root = run_root()
    if root is None:
        return []
    workspace_root = (root / "../../..").resolve()
    return unique_paths(
        [
            root / ".scherzo-state" / "artifacts",
            workspace_root / ".scherzo-state" / "artifacts",
        ]
    )


def artifact_roots(*, artifact_root: str | None = None, repo_root_arg: str | None = None) -> list[Path]:
    roots: list[Path] = []
    if artifact_root:
        roots.append(Path(artifact_root))
    run_dir = run_artifact_dir()
    if run_dir is not None:
        roots.append(run_dir.parent)
    roots.extend(run_root_artifact_roots())
    env_root = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if env_root:
        roots.append(Path(env_root) / ".scherzo-state" / "artifacts")
    roots.append(Path.cwd() / ".scherzo-state" / "artifacts")
    if repo_root_arg:
        roots.append(Path(repo_root_arg) / "test" / "fixtures" / "execplan_v2" / "artifacts")
    return unique_paths(roots)


def validate_artifact_ref(ref: str) -> None:
    if not ref.startswith("runs/"):
        fail(f"artifact ref must start with runs/: {ref!r}")
    ensure_repo_relative_path(ref, label="artifact ref")


def resolve_artifact_ref(ref: str, *, artifact_root: str | None = None, repo_root_arg: str | None = None, code: str | None = None) -> Path:
    validate_artifact_ref(ref)
    tried: list[str] = []
    for root in artifact_roots(artifact_root=artifact_root, repo_root_arg=repo_root_arg):
        tried.append(str(root))
        candidate = root / ref
        try:
            candidate.resolve().relative_to(root.resolve())
        except Exception:
            continue
        if candidate.exists():
            return candidate
    fail(
        f"could not resolve artifact ref {ref}; tried artifact roots from --artifact-root, SCHERZO_RUN_ARTIFACT_DIR parent, SCHERZO_RUN_ROOT, SCHERZO_REPO_ROOT, .scherzo-state/artifacts, and test fixtures: {', '.join(tried)}",
        code=code,
    )


def structured_artifact_candidates(step: str, artifact_name: str) -> list[Path]:
    roots: list[Path] = []
    run_dir = run_artifact_dir()
    if run_dir is not None:
        roots.append(run_dir)
    run_id = os.environ.get("SCHERZO_RUN_ID", "").strip()
    if run_id:
        roots.extend(root / "runs" / run_id for root in run_root_artifact_roots())
    env_root = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if run_id and env_root:
        roots.append(Path(env_root) / ".scherzo-state" / "artifacts" / "runs" / run_id)
    if run_id:
        roots.append(Path.cwd() / ".scherzo-state" / "artifacts" / "runs" / run_id)
    candidates: list[Path] = []
    for root in unique_paths(roots):
        pattern = str(root / step / "attempt-*" / "structured" / f"{artifact_name}.json")
        candidates.extend(Path(path) for path in glob.glob(pattern))
    return sorted(unique_paths(candidates))


def attempt_number(path: Path) -> int:
    for part in path.parts:
        match = re.match(r"attempt-(\d+)$", part)
        if match:
            return int(match.group(1))
    return 0


def resolve_structured_submission(step: str, artifact_name: str) -> Path:
    candidates = structured_artifact_candidates(step, artifact_name)
    valid: list[Path] = []
    for candidate in candidates:
        payload = load_json(candidate)
        if isinstance(payload, dict) and payload.get("artifact_name") == artifact_name and isinstance(payload.get("payload"), dict):
            valid.append(candidate)
    if not valid:
        fail(f"no structured-output artifact found for step {step!r} artifact {artifact_name!r}")
    highest = max(attempt_number(path) for path in valid)
    latest = [path for path in valid if attempt_number(path) == highest]
    if len(latest) != 1:
        fail(f"ambiguous structured-output artifacts for step {step!r} artifact {artifact_name!r}")
    return latest[0]


def submission_payload(path: Path) -> dict[str, Any]:
    value = load_json(path)
    if not isinstance(value, dict):
        fail(f"submission must be a JSON object: {path}")
    if isinstance(value.get("payload"), dict):
        value = value["payload"]
    if not isinstance(value, dict):
        fail(f"submission payload must be a JSON object: {path}")
    return value


def now_iso() -> str:
    fixed = env_value("SCHERZO_EXECPLAN_FIXED_TIME", legacy="SCHERZO_EXECPLAN_V2_FIXED_TIME")
    if fixed:
        return fixed
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def source_issue_from_submission_or_env(payload: dict[str, Any]) -> dict[str, str]:
    source = payload.get("source_issue")
    if isinstance(source, dict):
        identifier = str(source.get("identifier") or "").strip()
        title = str(source.get("title") or "").strip()
        url = str(source.get("url") or "").strip()
        if identifier and title and url:
            return {"identifier": identifier, "title": title, "url": url}
    identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "LIV-UNKNOWN").strip() or "LIV-UNKNOWN"
    title = os.environ.get("SCHERZO_ISSUE_TITLE", "Untitled source task").strip() or "Untitled source task"
    url = os.environ.get("SCHERZO_ISSUE_URL", f"https://linear.app/living-systems/issue/{identifier}").strip()
    return {"identifier": identifier, "title": title, "url": url}


def materialize_pack(review_doc: Path, submission: Path, output: Path) -> dict[str, Any]:
    review_meta = validate_review_doc_path(review_doc)
    payload = submission_payload(submission)
    artifact_type = payload.get("artifact_type")
    if artifact_type == "exec_plan_revision_submission":
        validate_schema(payload, EXEC_PLAN_REVISION_SUBMISSION_SCHEMA)
    else:
        validate_schema(payload, IMPLEMENTATION_PACK_SUBMISSION_SCHEMA)
    source_issue = source_issue_from_submission_or_env(payload)
    pack_id = str(payload.get("pack_id") or f"pack-{source_issue['identifier'].lower()}-{os.environ.get('SCHERZO_RUN_ID', 'local')}")
    pack = {
        "schema_version": 2,
        "artifact_type": "implementation_pack",
        "pack_id": pack_id,
        "source_issue": source_issue,
        "review_doc": review_meta,
        "derived_from": {
            "review_doc_path": review_meta["path"],
            "review_doc_sha256": review_meta["sha256"],
        },
        "provenance": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan"),
            "run_id": os.environ.get("SCHERZO_RUN_ID", "local-run"),
            "step_id": os.environ.get("SCHERZO_STEP_ID", "materialize_pack"),
            "created_at": now_iso(),
        },
        "sections": payload["sections"],
        "conflict_policy": str(payload["conflict_policy"]),
    }
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA)
    write_json(output, pack)
    sys.stdout.write(canonical_json(pack))
    return pack


def command_materialize_pack(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-pack")
    parser.add_argument("--review-doc")
    parser.add_argument("--review-doc-path-file")
    parser.add_argument("--submission")
    parser.add_argument("--submission-step")
    parser.add_argument("--submission-artifact")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    if bool(ns.review_doc) == bool(ns.review_doc_path_file):
        fail("provide exactly one of --review-doc or --review-doc-path-file")
    if ns.review_doc_path_file:
        review_doc = read_review_doc_path_file(Path(ns.review_doc_path_file))
    else:
        review_doc = Path(ns.review_doc)
    if ns.submission:
        submission = Path(ns.submission)
    else:
        if not ns.submission_step or not ns.submission_artifact:
            fail("provide --submission or both --submission-step and --submission-artifact")
        submission = resolve_structured_submission(ns.submission_step, ns.submission_artifact)
    materialize_pack(review_doc, submission, Path(ns.output))


def reject_bundle_self_hash(bundle: dict[str, Any]) -> None:
    forbidden = {"sha256", "bundle_sha256", "bundle_hash", "self_sha256", "canonical_sha256"}
    present = sorted(forbidden.intersection(bundle.keys()))
    if present:
        fail("exec_plan_bundle must not store its own SHA-256 inside the bundle body: " + ", ".join(present))


def canonicalize_execplan_bundle(bundle: Any) -> Any:
    if not isinstance(bundle, dict):
        return bundle
    handoff = bundle.get("implementation_handoff")
    if isinstance(handoff, dict) and handoff.get("workflow_label") == LEGACY_IMPLEMENTATION_WORKFLOW_LABEL:
        handoff["workflow_label"] = CANONICAL_IMPLEMENTATION_WORKFLOW_LABEL
    return bundle


def load_execplan_bundle_payload(
    bundle_path: Path, *, bundle_sha256: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], str]:
    bundle_data = path_bytes(bundle_path, code="execplan_v2_bundle_missing")
    actual_bundle_sha = sha256_bytes(bundle_data)
    expected_bundle_sha = bundle_sha256.lower() if bundle_sha256 else None
    if expected_bundle_sha and actual_bundle_sha != expected_bundle_sha:
        fail("bundle file SHA-256 does not match supplied --bundle-sha256", code="execplan_v2_bundle_hash_mismatch")
    try:
        bundle = json.loads(bundle_data.decode("utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"invalid bundle JSON: {exc}", code="execplan_v2_bundle_missing")
    if not isinstance(bundle, dict):
        fail("bundle JSON must be an object", code="execplan_v2_bundle_missing")
    reject_bundle_self_hash(bundle)
    canonicalize_execplan_bundle(bundle)
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA, root=repo_root(repo_root_arg))
    return bundle, actual_bundle_sha


def load_bundle_json(bundle_path: Path, *, bundle_sha256: str | None = None, repo_root_arg: str | None = None) -> dict[str, Any]:
    bundle, _actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    return bundle


def validate_bundle_review_doc(
    bundle: dict[str, Any],
    *,
    repo_root_arg: str | None = None,
    missing_code: str = "execplan_v2_review_doc_missing",
) -> dict[str, Any]:
    review_doc = bundle["review_doc"]
    review_path = review_doc_filesystem_path(review_doc["path"], repo_root(repo_root_arg))
    review_meta = file_meta(review_path, code=missing_code)
    if review_meta["sha256"] != review_doc["sha256"] or review_meta["bytes"] != review_doc["bytes"]:
        fail("review doc bytes do not match exec_plan_bundle.review_doc", code="execplan_v2_review_doc_hash_mismatch")
    return review_meta


def review_doc_meta_for_bundle(
    bundle: dict[str, Any],
    *,
    repo_root_arg: str | None = None,
    missing_code: str = "execplan_v2_review_doc_missing",
) -> dict[str, Any]:
    return validate_bundle_review_doc(bundle, repo_root_arg=repo_root_arg, missing_code=missing_code)


def validate_bundle_implementation_pack(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    review_doc = bundle["review_doc"]
    pack_ref = bundle["implementation_pack"]["ref"]
    pack_path = resolve_artifact_ref(
        pack_ref,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
        code="execplan_v2_implementation_pack_missing",
    )
    pack_data = path_bytes(pack_path, code="execplan_v2_implementation_pack_missing")
    pack_sha = sha256_bytes(pack_data)
    if pack_sha != bundle["implementation_pack"]["sha256"] or len(pack_data) != bundle["implementation_pack"]["bytes"]:
        fail("implementation pack bytes do not match bundle metadata", code="execplan_v2_implementation_pack_hash_mismatch")
    try:
        pack = json.loads(pack_data.decode("utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"invalid implementation pack JSON: {exc}", code="execplan_v2_implementation_pack_missing")
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA, root=repo_root(repo_root_arg))
    pack_review_sha = str(pack.get("derived_from", {}).get("review_doc_sha256") or "")
    if pack_review_sha != review_doc["sha256"]:
        fail("implementation pack was derived from a different review doc hash", code="execplan_v2_stale_implementation_pack")
    if bundle["implementation_pack"]["derived_from_review_doc_sha256"] != review_doc["sha256"]:
        fail("bundle implementation_pack.derived_from_review_doc_sha256 is stale", code="execplan_v2_stale_implementation_pack")
    if pack.get("review_doc", {}).get("sha256") != review_doc["sha256"]:
        fail("implementation pack review_doc hash does not match bundle", code="execplan_v2_stale_implementation_pack")
    return pack, pack_path


def load_bundle_pack(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    return validate_bundle_implementation_pack(bundle, artifact_root=artifact_root, repo_root_arg=repo_root_arg)


def load_and_validate_bundle(
    bundle_path: Path, *, bundle_sha256: str | None = None, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], dict[str, Any], Path]:
    bundle, _actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    validate_bundle_review_doc(bundle, repo_root_arg=repo_root_arg)
    pack, pack_path = validate_bundle_implementation_pack(
        bundle,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
    )
    return bundle, pack, pack_path


def load_and_validate_retained_bundle(
    bundle_path: Path, *, bundle_sha256: str | None = None, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], dict[str, Any], Path, str]:
    bundle, actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    pack, pack_path = validate_bundle_implementation_pack(
        bundle,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
    )
    return bundle, pack, pack_path, actual_bundle_sha


def command_validate_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan validate-bundle")
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--bundle-sha256")
    parser.add_argument("--artifact-root")
    parser.add_argument("--repo-root", required=True)
    ns = parser.parse_args(args)
    bundle, _pack, _pack_path = load_and_validate_bundle(
        Path(ns.bundle),
        bundle_sha256=ns.bundle_sha256,
        artifact_root=ns.artifact_root,
        repo_root_arg=ns.repo_root,
    )
    print("BUNDLE_VALID=ok")
    print(f"BUNDLE_ID={bundle['bundle_id']}")


def slug(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value or "task"


def issue_context_text() -> str:
    env = os.environ.get("SCHERZO_ISSUE_CONTEXT", "")
    if env:
        return env
    identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if identifier and shutil.which("linear"):
        proc = run_proc(["linear", "issue", "view", identifier, "--json", "--no-download"])
        if proc.returncode == 0:
            try:
                data = json.loads(proc.stdout)
            except Exception:
                data = {}
            if isinstance(data, dict):
                return "\n".join(
                    str(data.get(key) or "") for key in ["identifier", "title", "url", "description"]
                )
    title = os.environ.get("SCHERZO_ISSUE_TITLE", "")
    url = os.environ.get("SCHERZO_ISSUE_URL", "")
    return f"{identifier}\n{title}\n\n{url}"


def source_issue_from_context_or_env(default: dict[str, Any] | None = None) -> dict[str, str]:
    if default:
        return {
            "identifier": str(default.get("identifier") or "LIV-UNKNOWN"),
            "title": str(default.get("title") or "Untitled source task"),
            "url": str(default.get("url") or "https://linear.app/living-systems/issue/LIV-UNKNOWN"),
        }
    return source_issue_from_submission_or_env({})


def load_pack_for_review(pack_path: Path, review_meta: dict[str, Any]) -> dict[str, Any]:
    pack = load_json(pack_path)
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA)
    expected_sha = review_meta["sha256"]
    if pack.get("derived_from", {}).get("review_doc_sha256") != expected_sha:
        fail("implementation pack is stale for current review doc", code="execplan_v2_stale_implementation_pack")
    if pack.get("review_doc", {}).get("sha256") != expected_sha:
        fail("implementation pack review_doc hash does not match current review doc", code="execplan_v2_stale_implementation_pack")
    return pack


def pack_source_issue(pack_path: Path, review_meta: dict[str, Any]) -> dict[str, str]:
    return source_issue_from_submission_or_env(load_pack_for_review(pack_path, review_meta))


def ensure_source_issue_identifier_matches(source_issue: dict[str, str], expected_identifier: str | None, context: str) -> None:
    expected = str(expected_identifier or "").strip()
    if not expected or expected == "LIV-UNKNOWN":
        return
    actual = source_issue["identifier"].strip()
    if actual != expected:
        fail(
            f"implementation pack source issue identifier {actual!r} does not match {context} {expected!r}",
            code="execplan_v2_source_issue_mismatch",
        )


def write_publish_context(path: Path, *, review_meta: dict[str, Any], source_issue: dict[str, str], pr: dict[str, Any], review_surface: dict[str, Any]) -> dict[str, Any]:
    context = {
        "schema_version": 1,
        "artifact_type": "execplan_v2_publish_context",
        "published_at": now_iso(),
        "source_issue": source_issue,
        "review_doc": review_meta,
        "pr": {
            "url": str(pr.get("url") or ""),
            "branch": str(pr.get("branch") or ""),
            "base_revision": str(pr.get("base_revision") or pr.get("base_ref") or "main"),
            "head_revision": str(pr.get("head_revision") or pr.get("head_ref") or pr.get("branch") or "head"),
        },
        "review_surface": review_surface,
    }
    write_json(path, context)
    return context


def revision_publish_target(previous: dict[str, Any]) -> tuple[str, str]:
    surface = previous.get("review_surface") if isinstance(previous.get("review_surface"), dict) else {}
    branch = str(surface.get("branch") or "").strip()
    if not branch or not safe_revision_branch(branch):
        fail(
            "previous exec_plan_bundle review_surface.branch must identify the existing ExecPlan PR branch for revisions",
            code="execplan_revision_review_surface_missing",
        )
    pr_url = str(surface.get("pr_url") or "").strip()
    match = GITHUB_PR_URL_RE.search(pr_url)
    if not match:
        fail(
            "previous exec_plan_bundle review_surface.pr_url must be a GitHub pull request URL for revisions",
            code="execplan_revision_review_surface_missing",
        )
    return branch, match.group(3)


def publish_review_doc(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan publish-review-doc")
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--publish-context", required=True)
    parser.add_argument("--previous-bundle")
    parser.add_argument("--pack")
    parser.add_argument("--skip-if-unchanged", action="store_true")
    ns = parser.parse_args(args)
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    review_meta = validate_review_doc_path(review_path)
    previous: dict[str, Any] | None = None
    if ns.previous_bundle:
        previous = load_json(Path(ns.previous_bundle))
    pack_issue = pack_source_issue(Path(ns.pack), review_meta) if ns.pack else None
    if pack_issue:
        previous_issue = previous.get("source_issue") if previous else None
        if isinstance(previous_issue, dict):
            ensure_source_issue_identifier_matches(
                pack_issue,
                str(previous_issue.get("identifier") or ""),
                "previous bundle source_issue.identifier",
            )
        else:
            ensure_source_issue_identifier_matches(
                pack_issue,
                os.environ.get("SCHERZO_ISSUE_IDENTIFIER"),
                "SCHERZO_ISSUE_IDENTIFIER",
            )
    if ns.skip_if_unchanged and previous and previous.get("review_doc", {}).get("sha256") == review_meta["sha256"]:
        source_issue = source_issue_from_context_or_env(pack_issue or previous.get("source_issue"))
        surface = previous.get("review_surface", {}) if isinstance(previous.get("review_surface"), dict) else {}
        pr = {
            "url": surface.get("pr_url"),
            "branch": surface.get("branch"),
            "base_revision": "reused",
            "head_revision": surface.get("head_revision") or "reused",
        }
        context = write_publish_context(
            Path(ns.publish_context),
            review_meta=review_meta,
            source_issue=source_issue,
            pr=pr,
            review_surface={
                "status": "reused",
                "source_bundle_ref": previous.get("implementation_handoff", {}).get("bundle_ref"),
                "head_revision": surface.get("head_revision"),
            },
        )
        print("PUBLISH_REVIEW_DOC_STATUS=reused")
        print(f"PUBLISH_CONTEXT={ns.publish_context}")
        print(f"PR_URL={context['pr']['url']}")
        return
    records: list[dict[str, str]] = []
    if workspace_driver_command():
        records = changed_file_records()
        unexpected = [record["path"] for record in records if record["path"] != str(review_path)]
        if unexpected:
            fail("refusing to publish review doc with unrelated checked-in changes: " + ", ".join(unexpected))
    elif not env_enabled("SCHERZO_EXECPLAN_OFFLINE_PUBLISH", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_PUBLISH"):
        fail("SCHERZO_WORKSPACE_DRIVER is required for publish-review-doc unless SCHERZO_EXECPLAN_OFFLINE_PUBLISH=1")
    source_issue = source_issue_from_context_or_env(pack_issue or (previous.get("source_issue") if previous else None))
    revision_target = revision_publish_target(previous) if previous else None
    branch = "execplan/" + slug(source_issue["identifier"] + "-" + source_issue["title"])[:80]
    title_text = f"ExecPlan: {source_issue['identifier']} {source_issue['title']}"
    body_text = (
        f"Adds a concise ExecPlan review document.\n\nReview doc: `{review_meta['path']}`\n\n"
        f"Source task: {source_issue['url']}\n\n"
        "Implementation details are retained in Scherzo artifacts rather than checked in.\n"
    )
    tmp = Path("tmp")
    tmp.mkdir(exist_ok=True)
    title_file = tmp / "execplan-pr-title.txt"
    body_file = tmp / "execplan-pr-body.md"
    title_file.write_text(title_text + "\n", encoding="utf-8")
    body_file.write_text(body_text, encoding="utf-8")
    if workspace_driver_command():
        driver_args = [
            "publish-change",
            "--kind",
            "execplan-revision" if revision_target else "execplan",
            "--title-file",
            str(title_file),
            "--body-file",
            str(body_file),
            "--branch-prefix",
            branch,
            "--base",
            os.environ.get("SCHERZO_PR_BASE", "main"),
        ]
        if revision_target:
            target_branch, target_pr = revision_target
            driver_args.extend([
                "--target-branch",
                target_branch,
                "--target-pr",
                target_pr,
                "--allow-no-changes",
                "true",
            ])
        driver_args.append("--json")
        payload = workspace_driver_json(driver_args)
        if payload.get("status") not in {"published", "updated", "unchanged"}:
            fail(f"workspace driver publish-change returned status {payload.get('status')!r}")
        pr = payload
    else:
        base_revision = env_value("SCHERZO_EXECPLAN_OFFLINE_BASE", "offline-base", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_BASE")
        head_revision = env_value("SCHERZO_EXECPLAN_OFFLINE_HEAD", "offline-head", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_HEAD")
        if revision_target and previous:
            surface = previous.get("review_surface", {}) if isinstance(previous.get("review_surface"), dict) else {}
            pr = {
                "url": surface.get("pr_url"),
                "branch": revision_target[0],
                "base_revision": base_revision,
                "head_revision": head_revision,
            }
        else:
            pr = {
                "url": env_value("SCHERZO_EXECPLAN_OFFLINE_PR_URL", "https://github.com/living-systems/scherzo/pull/0", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_PR_URL"),
                "branch": branch,
                "base_revision": base_revision,
                "head_revision": head_revision,
            }
    context = write_publish_context(
        Path(ns.publish_context),
        review_meta=review_meta,
        source_issue=source_issue,
        pr=pr,
        review_surface={"status": "published", "source_bundle_ref": None},
    )
    print("PUBLISH_REVIEW_DOC_STATUS=published")
    print(f"PUBLISH_CONTEXT={ns.publish_context}")
    print(f"PR_URL={context['pr']['url']}")
    print(f"BRANCH={context['pr']['branch']}")


def linear_issue_nodes(payload: Any) -> list[Any]:
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict) and isinstance(payload.get("nodes"), list):
        return payload["nodes"]
    return []


def issue_has_workflow_label(issue: dict[str, Any], label: str) -> bool:
    raw_labels = issue.get("labels")
    if isinstance(raw_labels, dict):
        raw_labels = raw_labels.get("nodes")
    if not isinstance(raw_labels, list):
        return False
    for item in raw_labels:
        if isinstance(item, str) and item.lower() == label.lower():
            return True
        if isinstance(item, dict) and str(item.get("name") or "").lower() == label.lower():
            return True
    return False


def strip_ansi(value: str) -> str:
    return ANSI_ESCAPE_RE.sub("", value)


def linear_issue_identifier(value: str) -> str:
    match = LINEAR_ISSUE_IDENTIFIER_RE.search(strip_ansi(value))
    return match.group(1).upper() if match else ""


def find_existing_handoff_issue(team: str, bundle_ref: str) -> dict[str, str] | None:
    proc = run_proc(["linear", "issue", "query", "--team", team, "--search", bundle_ref, "--limit", "250", "--json"])
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except Exception:
        return None
    for item in linear_issue_nodes(payload):
        if not isinstance(item, dict):
            continue
        text = str(item.get("title") or "") + "\n" + str(item.get("description") or "")
        if bundle_ref in text and issue_has_workflow_label(item, "workflow:execplan-implementation"):
            return issue_result_from_json(item)
    return None


def issue_result_from_json(data: Any) -> dict[str, str] | None:
    if not isinstance(data, dict):
        return None
    if isinstance(data.get("issue"), dict):
        data = data["issue"]
    elif isinstance(data.get("data"), dict):
        nested = data["data"]
        if isinstance(nested.get("issue"), dict):
            data = nested["issue"]
        elif isinstance(nested.get("issueCreate"), dict) and isinstance(nested["issueCreate"].get("issue"), dict):
            data = nested["issueCreate"]["issue"]
    identifier = linear_issue_identifier(str(data.get("identifier") or data.get("id") or ""))
    url = strip_ansi(str(data.get("url") or "")).strip()
    if not identifier and url:
        identifier = linear_issue_identifier(url)
    if not identifier:
        return None
    if not url:
        url = f"https://linear.app/living-systems/issue/{identifier}"
    return {"issue_identifier": identifier, "issue_url": url}


def issue_result_from_create_output(output: str) -> dict[str, str] | None:
    cleaned = strip_ansi(output)
    try:
        parsed = json.loads(cleaned)
    except Exception:
        parsed = None
    from_json = issue_result_from_json(parsed)
    if from_json is not None:
        return from_json

    url_match = LINEAR_ISSUE_URL_RE.search(cleaned)
    if url_match:
        return {"issue_identifier": url_match.group(1).upper(), "issue_url": url_match.group(0).rstrip(".,;")}

    identifier = linear_issue_identifier(cleaned)
    if identifier:
        return {"issue_identifier": identifier, "issue_url": f"https://linear.app/living-systems/issue/{identifier}"}
    return None


def view_linear_issue_json(identifier: str) -> Any | None:
    proc = run_proc(["linear", "issue", "view", identifier, "--json", "--no-download"])
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout)
    except Exception:
        return None


def view_linear_issue(identifier: str) -> dict[str, str] | None:
    data = view_linear_issue_json(identifier)
    if data is None:
        return None
    return issue_result_from_json(data)


def linear_issue_project_name(identifier: str) -> str:
    data = view_linear_issue_json(identifier)
    if not isinstance(data, dict):
        return ""
    issue = data
    if isinstance(data.get("issue"), dict):
        issue = data["issue"]
    elif isinstance(data.get("data"), dict) and isinstance(data["data"].get("issue"), dict):
        issue = data["data"]["issue"]
    project = issue.get("project")
    if not isinstance(project, dict):
        return ""
    return str(project.get("name") or "").strip()


def handoff_issue_description(
    source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str
) -> str:
    note = (
        "This description will be updated automatically with the final bundle hash before implementation dispatch. "
        "If it still says `pending`, use the follow-up helper comment with the final bundle hash."
        if bundle_sha == "pending"
        else "This description contains the final bundle hash required by the implementation workflow."
    )
    return (
        f"Implement the ExecPlan bundle produced for {source_issue['identifier']}.\n\n"
        f"Bundle ref: {bundle_ref}\n"
        f"Bundle sha256: {bundle_sha}\n"
        f"Review doc: {review_path}\n"
        f"Implementation pack sha256: {pack_sha}\n\n"
        "Use `workflow:execplan-implementation` after the review doc PR is merged and a human moves this task to Todo. "
        f"{note}\n"
    )


def create_or_reuse_handoff_issue(
    source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str
) -> dict[str, str]:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        identifier = env_value("SCHERZO_EXECPLAN_HANDOFF_IDENTIFIER", source_issue["identifier"] + "-IMPL", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_IDENTIFIER")
        url = env_value("SCHERZO_EXECPLAN_HANDOFF_URL", f"https://linear.app/living-systems/issue/{identifier}", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_URL")
        return {"issue_identifier": identifier, "issue_url": url}
    team = source_issue["identifier"].split("-", 1)[0]
    existing = find_existing_handoff_issue(team, bundle_ref)
    if existing is not None and existing.get("issue_identifier"):
        return existing
    title = f"Implement: {source_issue['title']}"
    description = handoff_issue_description(source_issue, bundle_ref, bundle_sha, pack_sha, review_path)
    tmp = Path("tmp") / "execplan-handoff-body.md"
    tmp.parent.mkdir(exist_ok=True)
    tmp.write_text(description, encoding="utf-8")
    create_args = [
        "linear",
        "issue",
        "create",
        "--team",
        team,
        "--title",
        title,
        "--description-file",
        str(tmp),
        "--label",
        "workflow:execplan-implementation",
        "--state",
        "Backlog",
        "--no-interactive",
    ]
    project = env_value("SCHERZO_EXECPLAN_HANDOFF_PROJECT", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_PROJECT") or linear_issue_project_name(
        source_issue["identifier"]
    )
    if project:
        create_args.extend(["--project", project])
    proc = run_proc(create_args)
    if proc.returncode != 0:
        fail("failed to create Linear implementation handoff task: " + (proc.stderr.strip() or proc.stdout.strip()))
    created = issue_result_from_create_output(proc.stdout)
    if created is None:
        fail("failed to parse created Linear implementation handoff task: " + proc.stdout.strip())
    viewed = view_linear_issue(created["issue_identifier"])
    return viewed or created


def update_handoff_issue_description(handoff: dict[str, str], source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str) -> None:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        return
    identifier = handoff.get("issue_identifier", "").strip()
    if not identifier:
        return
    tmp = Path("tmp") / "execplan-handoff-body-final.md"
    tmp.parent.mkdir(exist_ok=True)
    tmp.write_text(
        handoff_issue_description(source_issue, bundle_ref, bundle_sha, pack_sha, review_path),
        encoding="utf-8",
    )
    proc = run_proc(["linear", "issue", "update", identifier, "--description-file", str(tmp)])
    if proc.returncode != 0:
        fail("failed to update Linear implementation handoff task with final bundle hash: " + (proc.stderr.strip() or proc.stdout.strip()))


def annotate_handoff_issue(handoff: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str) -> None:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        return
    identifier = handoff.get("issue_identifier", "").strip()
    if not identifier:
        return
    body = (
        "ExecPlan bundle materialized.\n\n"
        f"Bundle ref: {bundle_ref}\n"
        f"Bundle sha256: {bundle_sha}\n"
        f"Review doc: {review_path}\n"
        f"Implementation pack sha256: {pack_sha}\n"
    )
    proc = run_proc(["linear", "issue", "comment", "add", identifier, "--body", body])
    if proc.returncode != 0:
        fail("failed to annotate Linear implementation handoff task: " + (proc.stderr.strip() or proc.stdout.strip()))


def materialize_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-bundle")
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--pack", required=True)
    parser.add_argument("--publish-context", required=True)
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    review_meta = validate_review_doc_path(review_path)
    pack_path = Path(ns.pack)
    pack = load_pack_for_review(pack_path, review_meta)
    pack_meta = file_meta(pack_path)
    source_issue = source_issue_from_submission_or_env(pack)
    ensure_source_issue_identifier_matches(source_issue, os.environ.get("SCHERZO_ISSUE_IDENTIFIER"), "SCHERZO_ISSUE_IDENTIFIER")
    publish_context = load_json(Path(ns.publish_context))
    publish_source_issue = publish_context.get("source_issue")
    if isinstance(publish_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(publish_source_issue.get("identifier") or ""),
            "publish context source_issue.identifier",
        )
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    pack_ref = f"runs/{run_id}/outputs/implementation_pack.json"
    bundle_ref = f"runs/{run_id}/outputs/exec_plan_bundle.json"
    bundle = {
        "schema_version": 2,
        "artifact_type": "exec_plan_bundle",
        "bundle_id": f"bundle-{source_issue['identifier'].lower()}-{run_id}",
        "source_issue": source_issue,
        "workflow": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan"),
            "run_id": run_id,
            "workflow_fingerprint": os.environ.get("SCHERZO_WORKFLOW_FINGERPRINT", "unknown"),
        },
        "revision": {"status": "created", "number": 1, "supersedes": None},
        "review_doc": review_meta,
        "implementation_pack": {
            "ref": pack_ref,
            "sha256": pack_meta["sha256"],
            "bytes": pack_meta["bytes"],
            "schema": str(IMPLEMENTATION_PACK_SCHEMA),
            "derived_from_review_doc_sha256": review_meta["sha256"],
        },
        "review_surface": {
            "status": publish_context["review_surface"]["status"],
            "pr_url": publish_context["pr"]["url"],
            "branch": publish_context["pr"]["branch"],
            "source_bundle_ref": publish_context["review_surface"].get("source_bundle_ref"),
            "head_revision": publish_context["review_surface"].get("head_revision") or publish_context["pr"].get("head_revision"),
        },
        "implementation_handoff": {
            "issue_identifier": "pending",
            "issue_url": "https://linear.app/living-systems/issue/pending",
            "workflow_label": "workflow:execplan-implementation",
            "bundle_ref": bundle_ref,
        },
        "validation": [{"name": "materialize-bundle", "status": "passed"}],
    }
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    handoff = create_or_reuse_handoff_issue(
        bundle["source_issue"],
        bundle_ref,
        "pending",
        pack_meta["sha256"],
        review_meta["path"],
    )
    bundle["implementation_handoff"]["issue_identifier"] = handoff["issue_identifier"]
    bundle["implementation_handoff"]["issue_url"] = handoff["issue_url"]
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    write_json(Path(ns.output), bundle)
    final_text = canonical_json(bundle)
    final_sha = sha256_bytes(final_text.encode("utf-8"))
    update_handoff_issue_description(
        handoff,
        bundle["source_issue"],
        bundle_ref,
        final_sha,
        pack_meta["sha256"],
        review_meta["path"],
    )
    annotate_handoff_issue(handoff, bundle_ref, final_sha, pack_meta["sha256"], review_meta["path"])
    print(f"BUNDLE_REF={bundle_ref}", file=sys.stderr)
    print(f"BUNDLE_SHA256={final_sha}", file=sys.stderr)
    sys.stdout.write(final_text)


def explicit_bundle_ref_and_sha(text: str) -> tuple[str, str] | None:
    ref_match = BUNDLE_REF_RE.search(text)
    sha_match = BUNDLE_SHA_RE.search(text)
    if not ref_match or not sha_match:
        return None
    return ref_match.group(1).rstrip(".,;"), sha_match.group(1)


def parse_bundle_ref_and_sha(text: str) -> tuple[str, str]:
    parsed = explicit_bundle_ref_and_sha(text)
    if parsed is None:
        fail("task context must contain `Bundle ref:` and `Bundle sha256:` lines")
    return parsed


def load_bundle_payload_from_context() -> tuple[dict[str, Any], Path, str, str]:
    ref, sha = parse_bundle_ref_and_sha(issue_context_text())
    bundle_path = resolve_artifact_ref(ref, code="execplan_v2_bundle_missing")
    bundle, actual_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=sha,
        repo_root_arg=str(Path.cwd()),
    )
    return bundle, bundle_path, ref, actual_sha


def trim_reference(value: str) -> str:
    return value.strip().strip("`'\"<>").rstrip(".,;:")


def normalize_url(value: str) -> str:
    return trim_reference(value).rstrip("/").lower()


def github_pr_key(value: str) -> str:
    match = GITHUB_PR_URL_RE.search(trim_reference(value))
    if not match:
        return ""
    return f"{match.group(1).lower()}/{match.group(2).lower()}#{match.group(3)}"


def github_pr_number(value: str) -> str:
    match = GITHUB_PR_URL_RE.search(trim_reference(value))
    return match.group(3) if match else ""


def bundle_discovery_anchors(text: str) -> dict[str, set[str]]:
    urls = {normalize_url(match.group(0)) for match in URL_RE.finditer(text)}
    issue_identifiers = {match.group(1).upper() for match in LINEAR_ISSUE_IDENTIFIER_RE.finditer(strip_ansi(text))}
    current_issue_identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip().upper()
    if current_issue_identifier:
        issue_identifiers.discard(current_issue_identifier)
        urls = {url for url in urls if f"/issue/{current_issue_identifier.lower()}" not in url}
    pr_keys = {key for key in (github_pr_key(url) for url in urls) if key}
    pr_numbers = {match.group(1) for match in GITHUB_PR_TEXT_RE.finditer(text)}
    pr_numbers.update(number for number in (github_pr_number(url) for url in urls) if number)
    return {
        "artifact_refs": {trim_reference(match.group(0)) for match in RUN_ARTIFACT_REF_RE.finditer(text)},
        "issue_identifiers": issue_identifiers,
        "pr_keys": pr_keys,
        "pr_numbers": pr_numbers,
        "review_doc_paths": {trim_reference(match.group(0)) for match in REVIEW_DOC_PATH_RE.finditer(text)},
        "sha256s": {match.group(0).lower() for match in SHA256_TEXT_RE.finditer(text)},
        "urls": urls,
    }


def has_bundle_discovery_anchors(anchors: dict[str, set[str]]) -> bool:
    return any(anchors.get(key) for key in ["artifact_refs", "issue_identifiers", "pr_keys", "pr_numbers", "review_doc_paths", "sha256s", "urls"])


def output_manifest_bundle_entries(root: Path, manifest_path: Path) -> list[dict[str, Any]]:
    try:
        payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception:
        return []
    outputs = payload.get("outputs") if isinstance(payload, dict) else None
    if not isinstance(outputs, list):
        return []
    entries: list[dict[str, Any]] = []
    for output in outputs:
        if not isinstance(output, dict):
            continue
        value = output.get("value")
        if not isinstance(value, dict):
            continue
        if value.get("type") != "exec_plan_bundle" or value.get("status") != "present":
            continue
        if value.get("ref_kind") != "run_artifact":
            continue
        ref = value.get("ref")
        if not isinstance(ref, str) or not ref.startswith("runs/"):
            continue
        sha = value.get("sha256")
        if isinstance(sha, str):
            sha = sha.lower()
        else:
            sha = None
        entries.append({"root": root, "ref": ref, "sha256": sha, "source": str(manifest_path)})
    return entries


def retained_bundle_entries() -> list[dict[str, Any]]:
    roots = [root for root in artifact_roots() if root.exists()]
    entries: list[dict[str, Any]] = []
    manifest_refs: set[tuple[str, str]] = set()
    for root in roots:
        for manifest_path in sorted(root.glob("runs/*/outputs.v1.json")):
            for entry in output_manifest_bundle_entries(root, manifest_path):
                entries.append(entry)
                manifest_refs.add((str(root.resolve()), str(entry["ref"])))
    for root in roots:
        for bundle_path in sorted(root.glob("runs/*/outputs/exec_plan_bundle.json")):
            try:
                ref = str(bundle_path.relative_to(root)).replace(os.sep, "/")
            except ValueError:
                continue
            if (str(root.resolve()), ref) in manifest_refs:
                continue
            entries.append({"root": root, "ref": ref, "sha256": None, "source": str(bundle_path)})
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[str, str, str]] = set()
    for entry in entries:
        key = (str(Path(entry["root"]).resolve()), str(entry["ref"]), str(entry.get("sha256") or ""))
        if key not in seen:
            deduped.append(entry)
            seen.add(key)
    return deduped


def retained_bundle_path(root: Path, ref: str) -> Path:
    validate_artifact_ref(ref)
    candidate = root / ref
    try:
        candidate.resolve().relative_to(root.resolve())
    except Exception:
        fail(f"artifact ref escapes artifact root: {ref!r}", code="execplan_v2_bundle_missing")
    return candidate


def load_retained_bundle_metadata(entry: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
    root = Path(entry["root"])
    ref = str(entry["ref"])
    stderr = io.StringIO()
    try:
        with contextlib.redirect_stderr(stderr):
            bundle_path = retained_bundle_path(root, ref)
            bundle, actual_sha = load_execplan_bundle_payload(
                bundle_path,
                bundle_sha256=entry.get("sha256"),
                repo_root_arg=str(Path.cwd()),
            )
        return {
            "bundle": bundle,
            "ref": ref,
            "sha256": actual_sha,
            "root": root,
            "source": entry.get("source"),
        }, None
    except SystemExit:
        detail = stderr.getvalue().strip() or "candidate failed retained bundle metadata validation"
        return None, f"{ref} ({detail})"


def load_retained_bundle_candidate(entry: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
    root = Path(entry["root"])
    ref = str(entry["ref"])
    stderr = io.StringIO()
    try:
        with contextlib.redirect_stderr(stderr):
            bundle_path = retained_bundle_path(root, ref)
            bundle, pack, pack_path, actual_sha = load_and_validate_retained_bundle(
                bundle_path,
                bundle_sha256=entry.get("sha256"),
                artifact_root=str(root),
                repo_root_arg=str(Path.cwd()),
            )
        return {
            "bundle": bundle,
            "pack": pack,
            "pack_path": pack_path,
            "ref": ref,
            "sha256": actual_sha,
            "root": root,
            "source": entry.get("source"),
        }, None
    except SystemExit:
        detail = stderr.getvalue().strip() or "candidate failed retained bundle validation"
        return None, f"{ref} ({detail})"


def bundle_url_matches(label: str, value: Any, anchors: dict[str, set[str]], reasons: list[str]) -> None:
    if not isinstance(value, str) or not value.strip():
        return
    normalized = normalize_url(value)
    if normalized in anchors["urls"]:
        reasons.append(f"{label}:{value}")


def bundle_match_reasons(candidate: dict[str, Any], anchors: dict[str, set[str]]) -> list[str]:
    bundle = candidate["bundle"]
    ref = str(candidate["ref"])
    sha = str(candidate["sha256"])
    reasons: list[str] = []
    handoff = bundle.get("implementation_handoff") if isinstance(bundle.get("implementation_handoff"), dict) else {}
    source_issue = bundle.get("source_issue") if isinstance(bundle.get("source_issue"), dict) else {}
    review_surface = bundle.get("review_surface") if isinstance(bundle.get("review_surface"), dict) else {}
    review_doc = bundle.get("review_doc") if isinstance(bundle.get("review_doc"), dict) else {}
    implementation_pack = bundle.get("implementation_pack") if isinstance(bundle.get("implementation_pack"), dict) else {}

    for candidate_ref, label in [
        (ref, "bundle_ref"),
        (handoff.get("bundle_ref"), "handoff_bundle_ref"),
        (review_surface.get("source_bundle_ref"), "source_bundle_ref"),
    ]:
        if isinstance(candidate_ref, str) and candidate_ref in anchors["artifact_refs"]:
            reasons.append(f"{label}:{candidate_ref}")

    for issue, label in [(source_issue, "source_issue"), (handoff, "handoff_issue")]:
        identifier = str(issue.get("identifier") or issue.get("issue_identifier") or "").upper()
        if identifier and identifier in anchors["issue_identifiers"]:
            reasons.append(f"{label}:{identifier}")
        bundle_url_matches(label, issue.get("url") or issue.get("issue_url"), anchors, reasons)

    pr_url = review_surface.get("pr_url")
    bundle_url_matches("pr_url", pr_url, anchors, reasons)
    if isinstance(pr_url, str):
        pr_key = github_pr_key(pr_url)
        pr_number = github_pr_number(pr_url)
        if pr_key and pr_key in anchors["pr_keys"]:
            reasons.append(f"pr:{pr_key}")
        if pr_number and pr_number in anchors["pr_numbers"]:
            reasons.append(f"pr_number:{pr_number}")

    review_path = str(review_doc.get("path") or "")
    if review_path and review_path in anchors["review_doc_paths"]:
        reasons.append(f"review_doc:{review_path}")
    pack_sha = str(implementation_pack.get("sha256") or "").lower()
    if sha in anchors["sha256s"]:
        reasons.append("bundle_sha256")
    if pack_sha and pack_sha in anchors["sha256s"]:
        reasons.append("implementation_pack_sha256")

    deduped: list[str] = []
    seen: set[str] = set()
    for reason in reasons:
        if reason not in seen:
            deduped.append(reason)
            seen.add(reason)
    return deduped


def bundle_candidate_summary(candidate: dict[str, Any]) -> str:
    bundle = candidate["bundle"]
    source_issue = bundle.get("source_issue") if isinstance(bundle.get("source_issue"), dict) else {}
    review_surface = bundle.get("review_surface") if isinstance(bundle.get("review_surface"), dict) else {}
    handoff = bundle.get("implementation_handoff") if isinstance(bundle.get("implementation_handoff"), dict) else {}
    return (
        f"ref={candidate['ref']} sha256={candidate['sha256']} "
        f"source_issue={source_issue.get('identifier') or '-'} "
        f"pr={review_surface.get('pr_url') or '-'} "
        f"handoff={handoff.get('issue_identifier') or '-'} "
        f"matched_on={','.join(candidate.get('matches') or [])}"
    )


def missing_bundle_discovery_message(anchors: dict[str, set[str]], skipped: list[str]) -> str:
    anchor_hint = ""
    if not has_bundle_discovery_anchors(anchors):
        anchor_hint = " No PR URL, source issue identifier, review doc path, handoff issue, bundle ref, or hash anchor was found in the issue context."
    skipped_hint = ""
    if skipped:
        skipped_hint = " Skipped invalid retained bundle candidates: " + "; ".join(skipped[:5])
    return (
        "missing-bundle-discovery: could not discover a retained exec_plan_bundle for this revision issue."
        + anchor_hint
        + skipped_hint
        + " Include a PR URL/number, source Linear issue URL or identifier, implementation handoff issue, review doc path, or explicit `Bundle ref:` and `Bundle sha256:` lines. If the matching artifacts were pruned, rerun or recover the source execplan workflow, or paste the bundle lines from trusted Scherzo output."
    )


def discover_bundle_from_issue_context(text: str) -> tuple[dict[str, Any], dict[str, Any], Path, str, str, dict[str, Any]]:
    anchors = bundle_discovery_anchors(text)
    if not has_bundle_discovery_anchors(anchors):
        fail(missing_bundle_discovery_message(anchors, []), code="execplan_v2_missing_bundle_discovery")
    matches: list[dict[str, Any]] = []
    skipped: list[str] = []
    for entry in retained_bundle_entries():
        metadata, error = load_retained_bundle_metadata(entry)
        if metadata is None:
            if error:
                skipped.append(error)
            continue
        reasons = bundle_match_reasons(metadata, anchors)
        if not reasons:
            continue
        candidate, error = load_retained_bundle_candidate(entry)
        if candidate is None:
            if error:
                skipped.append(error)
            continue
        candidate["matches"] = reasons
        matches.append(candidate)
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for candidate in matches:
        key = (str(candidate["ref"]), str(candidate["sha256"]))
        if key in seen:
            continue
        deduped.append(candidate)
        seen.add(key)
    if len(deduped) == 1:
        candidate = deduped[0]
        return (
            candidate["bundle"],
            candidate["pack"],
            candidate["pack_path"],
            str(candidate["ref"]),
            str(candidate["sha256"]),
            {"source": "discovered", "matches": candidate.get("matches") or []},
        )
    if len(deduped) > 1:
        detail = "\n- ".join(bundle_candidate_summary(candidate) for candidate in deduped)
        fail(
            "ambiguous-bundle-discovery: multiple retained exec_plan_bundle artifacts match this revision issue. Add explicit `Bundle ref:` and `Bundle sha256:` lines to disambiguate. Candidates:\n- "
            + detail,
            code="execplan_v2_ambiguous_bundle_discovery",
        )
    fail(missing_bundle_discovery_message(anchors, skipped), code="execplan_v2_missing_bundle_discovery")


def load_bundle_from_context(
    *, allow_discovery: bool = False, validate_review_doc: bool = True
) -> tuple[dict[str, Any], dict[str, Any], Path, str, str, dict[str, Any]]:
    text = issue_context_text()
    explicit = explicit_bundle_ref_and_sha(text)
    if explicit is not None:
        ref, sha = explicit
        bundle_path = resolve_artifact_ref(ref, code="execplan_v2_bundle_missing")
        bundle, actual_sha = load_execplan_bundle_payload(
            bundle_path,
            bundle_sha256=sha,
            repo_root_arg=str(Path.cwd()),
        )
        if validate_review_doc:
            validate_bundle_review_doc(bundle, repo_root_arg=str(Path.cwd()))
        pack, pack_path = validate_bundle_implementation_pack(
            bundle,
            artifact_root=None,
            repo_root_arg=str(Path.cwd()),
        )
        return bundle, pack, pack_path, ref, actual_sha, {"source": "explicit", "matches": []}
    if not allow_discovery:
        parse_bundle_ref_and_sha(text)
    bundle, pack, pack_path, ref, sha, diagnostics = discover_bundle_from_issue_context(text)
    if validate_review_doc:
        validate_bundle_review_doc(bundle, repo_root_arg=str(Path.cwd()))
    return bundle, pack, pack_path, ref, sha, diagnostics



def review_doc_state_for_bundle(bundle: dict[str, Any], *, repo_root_arg: str | None = None) -> tuple[str, dict[str, Any] | None, str]:
    review_doc = bundle["review_doc"]
    review_path = review_doc_filesystem_path(review_doc["path"], repo_root(repo_root_arg))
    try:
        data = review_path.read_bytes()
    except FileNotFoundError:
        return "missing", None, str(review_path)
    except OSError as exc:
        fail(f"could not read {review_path}: {exc}", code="execplan_v2_review_doc_missing")
    meta = {"sha256": sha256_bytes(data), "bytes": len(data)}
    if meta["sha256"] == review_doc["sha256"] and meta["bytes"] == review_doc["bytes"]:
        return "ok", meta, str(review_path)
    return "mismatch", meta, str(review_path)


def truncate_driver_detail(value: str) -> str:
    text = ANSI_ESCAPE_RE.sub("", value).strip()
    if len(text) <= MAX_WORKSPACE_DRIVER_DETAIL_CHARS:
        return text
    return text[:MAX_WORKSPACE_DRIVER_DETAIL_CHARS] + "... [truncated]"


def revision_refresh_timeout_seconds() -> float:
    raw = env_value("SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS")
    if not raw:
        return DEFAULT_REVISION_REFRESH_TIMEOUT_SECONDS
    try:
        value = float(raw)
    except ValueError:
        fail(
            "SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS must be a positive number",
            code="execplan_revision_base_missing",
        )
    if value <= 0:
        fail(
            "SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS must be greater than zero",
            code="execplan_revision_base_missing",
        )
    return value


def safe_revision_head(value: str) -> bool:
    return bool(REVISION_HEAD_RE.fullmatch(value))


def safe_revision_branch(value: str) -> bool:
    if not REVISION_BRANCH_RE.fullmatch(value):
        return False
    if value.endswith(("/", ".", ".lock")):
        return False
    if ".." in value or "@{" in value or "//" in value:
        return False
    parts = value.split("/")
    return all(
        part not in {"", ".", ".."} and not part.startswith(".") and not part.endswith(".lock")
        for part in parts
    )


def safe_revision_remote(value: str) -> bool:
    return bool(REVISION_REMOTE_RE.fullmatch(value))


def revision_remote() -> str:
    remote = env_value("SCHERZO_JJ_WORKSPACE_REMOTE") or env_value("SCHERZO_PR_REMOTE") or "origin"
    if not safe_revision_remote(remote):
        fail(
            f"revision remote {remote!r} is not a safe remote name for refresh-base",
            code="execplan_revision_base_missing",
        )
    return remote


def revision_base_candidates(bundle: dict[str, Any]) -> list[str]:
    surface = bundle.get("review_surface") if isinstance(bundle.get("review_surface"), dict) else {}
    head = str(surface.get("head_revision") or "").strip() if isinstance(surface, dict) else ""
    branch = str(surface.get("branch") or "").strip() if isinstance(surface, dict) else ""
    values: list[str] = []
    rejected: list[str] = []
    if head and head not in {"head", "reused"}:
        if safe_revision_head(head):
            values.append(head)
        else:
            rejected.append("review_surface.head_revision is not a hex commit id")
    if branch and branch != "reused":
        if safe_revision_branch(branch):
            remote = revision_remote()
            values.append(f"{branch}@{remote}")
            values.append(branch)
        else:
            rejected.append("review_surface.branch contains unsupported revision-ref characters")
    if rejected and not values:
        fail(
            "previous exec_plan_bundle records no safe review_surface branch/head to resolve: "
            + "; ".join(rejected),
            code="execplan_revision_base_missing",
        )
    unique: list[str] = []
    seen: set[str] = set()
    for value in values:
        if value not in seen:
            unique.append(value)
            seen.add(value)
    return unique


def refresh_revision_base(target: str) -> tuple[bool, str]:
    driver = workspace_driver_command()
    if not driver:
        return False, "SCHERZO_WORKSPACE_DRIVER is not set"
    timeout = revision_refresh_timeout_seconds()
    proc = run_proc(
        [driver, "refresh-base", "--stage", "prepare_revision", "--target", target, "--json"],
        timeout=timeout,
    )
    payload: dict[str, Any] = {}
    if proc.stdout.strip():
        try:
            parsed = json.loads(proc.stdout)
            if isinstance(parsed, dict):
                payload = parsed
        except Exception:
            payload = {}
    detail = truncate_driver_detail(
        str(
            payload.get("message")
            or proc.stderr.strip()
            or proc.stdout.strip()
            or f"exit {proc.returncode}"
        )
    )
    if proc.returncode != 0:
        return False, detail
    if payload.get("version") != 1:
        return False, "workspace driver returned malformed refresh-base JSON"
    status = str(payload.get("status") or "")
    if status in {"fresh", "rebased_clean"}:
        return True, status
    return False, detail or f"refresh-base returned status {status!r}"


def ensure_revision_review_doc_available(bundle: dict[str, Any], *, repo_root_arg: str | None = None) -> None:
    state, _meta, review_path = review_doc_state_for_bundle(bundle, repo_root_arg=repo_root_arg)
    if state == "ok":
        return
    candidates = revision_base_candidates(bundle)
    if not candidates:
        fail(
            f"review doc {review_path} is {state}, and the previous exec_plan_bundle does not record a review_surface branch/head to resolve",
            code="execplan_revision_base_missing",
        )
    attempts: list[str] = []
    mismatch_details: list[str] = []
    for target in candidates:
        refreshed, message = refresh_revision_base(target)
        if not refreshed:
            attempts.append(f"{target}: {message}")
            continue
        resolved_state, resolved_meta, _ = review_doc_state_for_bundle(bundle, repo_root_arg=repo_root_arg)
        if resolved_state == "ok":
            return
        if resolved_state == "mismatch" and resolved_meta is not None:
            mismatch_details.append(
                f"{target}: resolved review doc hash {resolved_meta['sha256']} bytes {resolved_meta['bytes']} did not match bundle"
            )
        else:
            attempts.append(f"{target}: review doc still missing after refresh-base")
    if mismatch_details:
        fail(
            "resolved previous ExecPlan review surface, but review doc bytes do not match exec_plan_bundle.review_doc: "
            + "; ".join(mismatch_details),
            code="execplan_v2_review_doc_hash_mismatch",
        )
    fail(
        "could not resolve previous ExecPlan review surface for revision; tried " + "; ".join(attempts),
        code="execplan_revision_base_missing",
    )


def command_prepare_revision(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan prepare-revision")
    parser.add_argument("--from-issue-context", action="store_true", required=True)
    parser.add_argument("--write-bundle", required=True)
    parser.add_argument("--write-review-doc-path", required=True)
    parser.add_argument("--write-pack", required=True)
    ns = parser.parse_args(args)
    bundle, _pack, pack_path, ref, sha, diagnostics = load_bundle_from_context(
        allow_discovery=True,
        validate_review_doc=False,
    )
    ensure_revision_review_doc_available(bundle, repo_root_arg=str(Path.cwd()))
    validate_bundle_review_doc(
        bundle,
        repo_root_arg=str(Path.cwd()),
        missing_code="execplan_revision_base_missing",
    )
    write_json(Path(ns.write_bundle), bundle)
    shutil.copyfile(pack_path, ns.write_pack)
    Path(ns.write_review_doc_path).parent.mkdir(parents=True, exist_ok=True)
    Path(ns.write_review_doc_path).write_text(bundle["review_doc"]["path"] + "\n", encoding="utf-8")
    print("PREPARE_REVISION_STATUS=ok")
    print(f"BUNDLE_DISCOVERY_STATUS={diagnostics['source']}")
    if diagnostics.get("matches"):
        print("BUNDLE_DISCOVERY_MATCHES=" + ",".join(diagnostics["matches"]))
    print(f"BUNDLE_REF={ref}")
    print(f"BUNDLE_SHA256={sha}")
    print(f"REVIEW_DOC_PATH={bundle['review_doc']['path']}")


def materialize_revision(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-revision")
    parser.add_argument("--previous-bundle", required=True)
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--pack", required=True)
    parser.add_argument("--publish-context", required=True)
    parser.add_argument("--status", choices=["auto", "changed", "unchanged"], default="auto")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    previous = canonicalize_execplan_bundle(load_json(Path(ns.previous_bundle)))
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    review_meta = validate_review_doc_path(review_path)
    pack_path = Path(ns.pack)
    pack = load_pack_for_review(pack_path, review_meta)
    pack_meta = file_meta(pack_path)
    source_issue = source_issue_from_submission_or_env(pack)
    previous_source_issue = previous.get("source_issue")
    if isinstance(previous_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(previous_source_issue.get("identifier") or ""),
            "previous bundle source_issue.identifier",
        )
    publish_context = load_json(Path(ns.publish_context))
    publish_source_issue = publish_context.get("source_issue")
    if isinstance(publish_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(publish_source_issue.get("identifier") or ""),
            "publish context source_issue.identifier",
        )
    previous_ref = previous.get("implementation_handoff", {}).get("bundle_ref") or "runs/unknown/outputs/exec_plan_bundle.json"
    previous_sha = sha256_bytes(canonical_json(previous).encode("utf-8"))
    status = ns.status
    if status == "auto":
        status = "unchanged" if review_meta["sha256"] == previous["review_doc"]["sha256"] and pack_meta["sha256"] == previous["implementation_pack"]["sha256"] else "changed"
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    bundle_ref = f"runs/{run_id}/outputs/exec_plan_bundle.json"
    bundle = {
        **previous,
        "bundle_id": f"bundle-{source_issue['identifier'].lower()}-{run_id}",
        "source_issue": source_issue,
        "workflow": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan-revision"),
            "run_id": run_id,
            "workflow_fingerprint": os.environ.get("SCHERZO_WORKFLOW_FINGERPRINT", previous.get("workflow", {}).get("workflow_fingerprint", "unknown")),
        },
        "revision": {
            "status": status,
            "number": int(previous.get("revision", {}).get("number") or 1) + 1,
            "supersedes": {"ref": previous_ref, "sha256": previous_sha},
        },
        "review_doc": review_meta,
        "implementation_pack": {
            "ref": f"runs/{run_id}/outputs/implementation_pack.json",
            "sha256": pack_meta["sha256"],
            "bytes": pack_meta["bytes"],
            "schema": str(IMPLEMENTATION_PACK_SCHEMA),
            "derived_from_review_doc_sha256": review_meta["sha256"],
        },
        "review_surface": {
            "status": publish_context["review_surface"]["status"],
            "pr_url": publish_context["pr"]["url"],
            "branch": publish_context["pr"]["branch"],
            "source_bundle_ref": publish_context["review_surface"].get("source_bundle_ref"),
            "head_revision": publish_context["review_surface"].get("head_revision") or publish_context["pr"].get("head_revision"),
        },
        "implementation_handoff": {
            **previous["implementation_handoff"],
            "bundle_ref": bundle_ref,
        },
        "validation": [{"name": "materialize-revision", "status": "passed"}],
    }
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    write_json(Path(ns.output), bundle)
    sys.stdout.write(canonical_json(bundle))


def command_implementation_prepare(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan implementation-prepare")
    parser.add_argument("--from-issue-context", action="store_true", required=True)
    parser.parse_args(args)
    bundle, _pack, pack_path, _ref, _sha, _diagnostics = load_bundle_from_context()
    review_path = review_doc_filesystem_path(bundle["review_doc"]["path"], Path.cwd())
    review_meta = file_meta(review_path, code="execplan_v2_review_doc_missing")
    if review_meta["sha256"] != bundle["review_doc"]["sha256"]:
        fail("checked-in review doc hash does not match bundle", code="execplan_v2_review_doc_hash_mismatch")
    tmp = Path("tmp")
    tmp.mkdir(exist_ok=True)
    shutil.copyfile(review_path, tmp / "execplan-review-doc.md")
    shutil.copyfile(pack_path, tmp / "execplan-implementation-pack.json")
    write_json(tmp / "execplan-bundle.json", bundle)
    base_change_id = "unknown-base"
    if workspace_driver_command():
        try:
            baseline = workspace_driver_json(["baseline", "--json"])
            base_change_id = str(baseline.get("baseline_id") or baseline.get("base_revision") or base_change_id)
        except SystemExit:
            raise
    metadata = {
        "source_kind": "execplan",
        "issue_identifier": bundle["implementation_handoff"].get("issue_identifier", ""),
        "issue_title": bundle["source_issue"].get("title", ""),
        "issue_url": bundle["implementation_handoff"].get("issue_url", ""),
        "plan_path": bundle["review_doc"]["path"],
        "base_change_id": base_change_id,
        "execplan_v2_bundle_path": "tmp/execplan-bundle.json",
        "execplan_v2_implementation_pack_path": "tmp/execplan-implementation-pack.json",
    }
    write_json(tmp / "scherzo-implementation.json", metadata)
    print("IMPLEMENTATION_PREPARE_STATUS=ok")
    print("REVIEW_DOC=tmp/execplan-review-doc.md")
    print("IMPLEMENTATION_PACK=tmp/execplan-implementation-pack.json")
    print("BUNDLE=tmp/execplan-bundle.json")


def command_gate_no_conflict(args: list[str]) -> None:
    if args:
        fail("gate-no-conflict takes no arguments")
    path = Path("tmp/execplan-conflict.md")
    if path.exists() and path.read_text(encoding="utf-8").strip():
        fail("implementation agent reported a review-doc / implementation-pack conflict; see tmp/execplan-conflict.md", code="execplan_v2_conflict")
    print("EXECPLAN_V2_CONFLICT=none")


def copy_file_to_artifact(src: Path, dest: Path) -> dict[str, Any]:
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.exists():
        shutil.copyfile(src, dest)
    else:
        dest.write_text("", encoding="utf-8")
    data = dest.read_bytes()
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    run_dir = run_artifact_dir()
    if run_dir is None:
        ref = "runs/" + run_id + "/" + str(dest).replace("\\", "/")
    else:
        ref = "runs/" + run_id + "/" + str(dest.relative_to(run_dir)).replace("\\", "/")
    return {"ref": ref, "sha256": sha256_bytes(data), "bytes": len(data)}


def source_file_candidates(paths: Iterable[Path]) -> Path | None:
    for path in paths:
        if path.exists():
            return path
    return None


def normalize_changed_files(value: Any) -> list[dict[str, str]]:
    if not isinstance(value, list):
        return []
    out: list[dict[str, str]] = []
    for item in value:
        if isinstance(item, str):
            out.append({"path": item, "status": "modified"})
        elif isinstance(item, dict) and isinstance(item.get("path"), str):
            out.append({"path": str(item["path"]), "status": str(item.get("status") or "modified")})
    return out


def materialize_code_change_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-code-change-bundle")
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    bundle_path = Path(ns.bundle)
    bundle = canonicalize_execplan_bundle(load_json(bundle_path))
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    bundle_meta = file_meta(bundle_path)
    publish = load_json(Path("tmp/scherzo-implementation-publish.json")) if Path("tmp/scherzo-implementation-publish.json").exists() else {}
    validation_path = Path("tmp/scherzo-implementation-validation.json")
    plan_completion_path = Path("tmp/scherzo-plan-completion-verdict.json")
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    run_dir = run_artifact_dir() or (Path(".scherzo-state") / "artifacts" / "runs" / run_id)
    code_dir = run_dir / "execplan" / "code-change"
    diff_path = env_value("SCHERZO_EXECPLAN_DIFF_PATH", legacy="SCHERZO_EXECPLAN_V2_DIFF_PATH")
    diff_src = source_file_candidates([
        Path(diff_path) if diff_path else Path("__missing__"),
        Path(os.environ.get("SCHERZO_RUN_ROOT", "")) / "input.diff" if os.environ.get("SCHERZO_RUN_ROOT") else Path("__missing__"),
        Path("tmp/scherzo-implementation.diff"),
    ])
    diff_meta = copy_file_to_artifact(diff_src or Path("__missing__"), code_dir / "diff.patch")
    changed_files = normalize_changed_files(publish.get("changed_files"))
    changed_path = code_dir / "changed-files.v1.json"
    changed_path.parent.mkdir(parents=True, exist_ok=True)
    changed_path.write_text(canonical_json(changed_files), encoding="utf-8")
    validation_artifacts: list[dict[str, Any]] = []
    if validation_path.exists():
        meta = copy_file_to_artifact(validation_path, code_dir / "validation" / "selfci.json")
        validation_artifacts.append({"name": "selfci", **meta})
    plan_completion_payload = load_json(plan_completion_path) if plan_completion_path.exists() else {"verdict": "blocked"}
    pc_meta = copy_file_to_artifact(plan_completion_path if plan_completion_path.exists() else Path("__missing__"), code_dir / "plan-completion.json")
    raw_verdict = str(plan_completion_payload.get("verdict") or "blocked")
    verdict = {"pass": "complete", "fail": "incomplete"}.get(raw_verdict, raw_verdict)
    if verdict not in {"complete", "incomplete", "blocked"}:
        verdict = "blocked"
    review_artifacts: list[dict[str, Any]] = []
    review_final = source_file_candidates([
        Path(os.environ.get("SCHERZO_RUN_ROOT", "")) / "artifacts" / "review" / "synthesize_review" / "final-review.v1.json" if os.environ.get("SCHERZO_RUN_ROOT") else Path("__missing__"),
        Path("tmp/final-review.v1.json"),
    ])
    if review_final:
        meta = copy_file_to_artifact(review_final, code_dir / "review" / "final-review.v1.json")
        review_artifacts.append({"name": "final-review", **meta})
    pack = bundle["implementation_pack"]
    code_bundle = {
        "schema_version": 2,
        "artifact_type": "code_change_bundle",
        "source_bundle": {
            "ref": bundle["implementation_handoff"]["bundle_ref"],
            "sha256": bundle_meta["sha256"],
            "review_doc_sha256": bundle["review_doc"]["sha256"],
            "implementation_pack_sha256": pack["sha256"],
        },
        "review_doc": {"path": bundle["review_doc"]["path"], "sha256": bundle["review_doc"]["sha256"]},
        "implementation_pack": {"ref": pack["ref"], "sha256": pack["sha256"]},
        "pr": {
            "url": str(publish.get("pr_url") or publish.get("url") or "https://github.com/living-systems/scherzo/pull/0"),
            "branch": str(publish.get("branch") or "unknown"),
            "base_revision": str(publish.get("publish_base_revision") or publish.get("base_revision") or "unknown-base"),
            "head_revision": str(publish.get("driver_head_revision") or publish.get("head_revision") or publish.get("branch") or "unknown-head"),
        },
        "change": {"changed_files": changed_files, "diff": diff_meta},
        "validation_artifacts": validation_artifacts,
        "plan_completion": {"verdict": verdict, **pc_meta},
        "review_artifacts": review_artifacts,
    }
    validate_schema(code_bundle, CODE_CHANGE_BUNDLE_SCHEMA)
    write_json(Path(ns.output), code_bundle)
    sys.stdout.write(canonical_json(code_bundle))


def main(argv: list[str]) -> None:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        raise SystemExit(0 if argv else 2)
    command, args = argv[0], argv[1:]
    if command == "validate-review-doc":
        command_validate_review_doc(args)
    elif command == "materialize-pack":
        command_materialize_pack(args)
    elif command == "validate-bundle":
        command_validate_bundle(args)
    elif command == "publish-review-doc":
        publish_review_doc(args)
    elif command == "materialize-bundle":
        materialize_bundle(args)
    elif command == "prepare-revision":
        command_prepare_revision(args)
    elif command == "materialize-revision":
        materialize_revision(args)
    elif command == "implementation-prepare":
        command_implementation_prepare(args)
    elif command == "gate-no-conflict":
        command_gate_no_conflict(args)
    elif command == "materialize-code-change-bundle":
        materialize_code_change_bundle(args)
    else:
        usage()
        fail(f"unknown command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])
