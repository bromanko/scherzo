#!/bin/sh
# Helpers for Scherzo's workflow:execplan pipeline.

set -eu

usage() {
  cat >&2 <<'EOF'
Usage: scherzo-execplan <validate|create-pr>

Run from the Scherzo jj workspace root. The workflow must leave exactly one
changed ExecPlan file under docs/plans/. create-pr validates, pushes a jj
bookmark to origin, and opens a ready GitHub PR against main.
EOF
}

fail() {
  echo "scherzo-execplan: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

sanitize_ref_part() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9._-' '-' \
    | sed 's/^-*//; s/-*$//; s/--*/-/g'
}

changed_files() {
  jj diff --from @- --to @ --name-only --color=never
}

find_plan_path() {
  files=$(changed_files | sed '/^[[:space:]]*$/d')
  [ -n "$files" ] || fail "no changed files found"

  plan_files=$(printf '%s\n' "$files" | grep -E '^docs/plans/[^/]+\.md$' || true)
  plan_count=$(printf '%s\n' "$plan_files" | sed '/^[[:space:]]*$/d' | wc -l | tr -d '[:space:]')
  [ "$plan_count" = "1" ] || fail "expected exactly one changed docs/plans/*.md file, found $plan_count"

  plan=$(printf '%s\n' "$plan_files" | sed -n '1p')
  [ -f "$plan" ] || fail "plan file does not exist: $plan"
  plan_status=$(jj diff --summary --from @- --to @ --color=never -- "$plan" | awk '{ print $1; exit }')
  [ "$plan_status" = "A" ] || fail "plan file must be newly added, got status ${plan_status:-unknown}: $plan"

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ "$file" = "$plan" ] || fail "unexpected changed file: $file; workflow:execplan PRs may only change $plan"
  done <<EOF_FILES
$files
EOF_FILES

  printf '%s\n' "$plan"
}

require_heading() {
  plan=$1
  heading=$2
  grep -Fx "## $heading" "$plan" >/dev/null 2>&1 || fail "missing required heading: ## $heading"
}

warn_heading() {
  plan=$1
  heading=$2
  if ! grep -Fx "## $heading" "$plan" >/dev/null 2>&1; then
    echo "scherzo-execplan: warning: missing expected heading: ## $heading" >&2
  fi
}

validate_plan() {
  plan=$1

  grep -Eq '^# .+' "$plan" || fail "plan must start with a level-1 title"

  warn_heading "$plan" "Purpose / Big Picture"
  warn_heading "$plan" "Problem Framing and Constraints"
  warn_heading "$plan" "Strategy Overview"
  warn_heading "$plan" "Alternatives Considered"
  warn_heading "$plan" "Risks and Countermeasures"
  require_heading "$plan" "Progress"
  warn_heading "$plan" "Surprises & Discoveries"
  warn_heading "$plan" "Decision Log"
  warn_heading "$plan" "Outcomes & Retrospective"
  warn_heading "$plan" "Context and Orientation"
  warn_heading "$plan" "Preconditions and Verified Facts"
  warn_heading "$plan" "Scope Boundaries"
  warn_heading "$plan" "Milestones"
  warn_heading "$plan" "Plan of Work"
  warn_heading "$plan" "Concrete Steps"
  warn_heading "$plan" "Testing and Falsifiability"
  warn_heading "$plan" "Validation and Acceptance"
  warn_heading "$plan" "Rollout, Recovery, and Idempotence"
  warn_heading "$plan" "Artifacts and Notes"
  warn_heading "$plan" "Interfaces and Dependencies"
  require_heading "$plan" "Open Questions and Clarifications Needed"

  grep -Eq '^- \[[ xX]\] ' "$plan" || fail "Progress must contain at least one checklist item"

  if grep -nE '/Users/|/home/|/private/|/var/folders/' "$plan" >&2; then
    fail "plan contains absolute local paths; use repository-relative paths only"
  fi
}

validate_command() {
  require_command jj
  plan=$(find_plan_path)
  validate_plan "$plan"
  echo "PLAN_PATH=$plan"
  echo "VALIDATION=ok"
}

owner_repo_from_url() {
  url=$1
  case "$url" in
    https://github.com/*)
      value=${url#https://github.com/}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    git@github.com:*)
      value=${url#git@github.com:}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    ssh://git@github.com/*)
      value=${url#ssh://git@github.com/}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    *)
      return 1
      ;;
  esac
}

remote_url() {
  remote=$1
  jj git remote list --color=never | awk -v remote="$remote" '$1 == remote { print $2; exit }'
}

revision_exists() {
  revision=$1
  jj log -r "$revision" --no-graph -T 'commit_id' --color=never >/dev/null 2>&1
}

revision_commit_ids() {
  revision=$1
  jj log -r "$revision" --no-graph -T 'commit_id ++ "\n"' --color=never | sed '/^[[:space:]]*$/d'
}

current_parent_commit_ids() {
  revision_commit_ids @-
}

fetch_publish_base() {
  base=$1
  remote=$2
  if ! output=$(jj git fetch --remote "$remote" --branch "$base" 2>&1); then
    printf '%s\n' "$output" >&2
    fail "could not fetch PR base $base from remote $remote; configure SCHERZO_PR_REMOTE/SCHERZO_PR_BASE and retry"
  fi
  [ -z "$output" ] || printf '%s\n' "$output"
}

publish_base_revision() {
  base=$1
  remote=$2
  remote_base="${base}@${remote}"
  if revision_exists "$remote_base"; then
    printf '%s\n' "$remote_base"
  elif revision_exists "$base"; then
    echo "scherzo-execplan: warning: remote publish base $remote_base was not found after fetch; falling back to local revision $base" >&2
    printf '%s\n' "$base"
  else
    fail "could not find publish base revision $remote_base or $base"
  fi
}

has_unresolved_conflicts() {
  revision=$1
  conflicts=$(jj log -r "conflicts() & ($revision)" --no-graph -T 'change_id.short()' --color=never 2>/dev/null || true)
  [ -n "$conflicts" ]
}

normalize_publish_base() {
  base_revision=$1
  base_commit_ids=$(revision_commit_ids "$base_revision")
  parent_commit_ids=$(current_parent_commit_ids)
  base_count=$(printf '%s\n' "$base_commit_ids" | sed '/^[[:space:]]*$/d' | wc -l | tr -d '[:space:]')
  if [ "$base_count" = "1" ] && [ "$parent_commit_ids" = "$base_commit_ids" ]; then
    return 1
  fi

  echo "## Publish base normalization"
  echo "Rebasing final ExecPlan change onto \`$base_revision\` before publishing so the PR branch does not push local workspace ancestors."
  jj rebase -r @ -d "$base_revision" --color=never || \
    fail "could not rebase the final ExecPlan change onto the PR base $base_revision; resolve the retained workspace manually, rerun validation, and publish again"
  if has_unresolved_conflicts @; then
    status=$(jj status --color=never 2>/dev/null || true)
    fail "rebasing the final ExecPlan change onto the PR base left unresolved conflicts. Resolve the retained workspace manually, rerun validation, and publish again.${status:+\n$status}"
  fi
  return 0
}

empty_description_commits_to_push() {
  remote=$1
  revset='remote_bookmarks(remote='"$remote"')..@ & description(exact:"") & ~root()'
  jj log -r "$revset" --no-graph \
    -T 'change_id.short() ++ " " ++ commit_id.short() ++ " " ++ if(empty, "(empty) ", "") ++ if(description, description.first_line(), "(no description set)") ++ "\n"' \
    --color=never
}

ensure_no_empty_descriptions_to_push() {
  remote=$1
  if ! undescribed=$(empty_description_commits_to_push "$remote" 2>&1); then
    printf '%s\n' "$undescribed" >&2
    fail "could not inspect commits that would be pushed to $remote"
  fi
  if [ -n "$undescribed" ]; then
    echo "scherzo-execplan: refusing to push because these commits in the push range have empty descriptions:" >&2
    printf '%s\n' "$undescribed" >&2
    exit 1
  fi
}

create_pr_command() {
  require_command jj
  require_command gh

  plan=$(find_plan_path)
  validate_plan "$plan"

  base=${SCHERZO_PR_BASE:-main}
  remote=${SCHERZO_PR_REMOTE:-origin}
  repo=${SCHERZO_PR_REPO:-}
  if [ -z "$repo" ]; then
    url=$(remote_url "$remote")
    [ -n "$url" ] || fail "could not find jj git remote: $remote"
    repo=$(owner_repo_from_url "$url") || fail "could not infer GitHub owner/repo from remote URL: $url"
  fi
  fetch_publish_base "$base" "$remote"
  base_revision=$(publish_base_revision "$base" "$remote")
  if normalize_publish_base "$base_revision"; then
    echo ""
    echo "## Validation after publish-base normalization"
    plan=$(find_plan_path)
    validate_plan "$plan"
  fi

  title=$(sed -n 's/^# //p' "$plan" | sed -n '1p')
  [ -n "$title" ] || title="Add ExecPlan $(basename "$plan" .md)"
  case "$title" in
    ExecPlan:*|execplan:*) pr_title=$title ;;
    *) pr_title="ExecPlan: $title" ;;
  esac

  slug=$(sanitize_ref_part "$(basename "$plan" .md)" | cut -c 1-60)
  [ -n "$slug" ] || slug=plan
  change_id=$(jj log -r @ --no-graph -T 'change_id.short()' --color=never | tr -d '[:space:]')
  [ -n "$change_id" ] || fail "could not determine jj change id"
  branch="scherzo/execplan/${slug}-${change_id}"

  jj describe -m "docs(plan): add execplan for $slug"
  ensure_no_empty_descriptions_to_push "$remote"
  jj bookmark set "$branch" --revision @
  jj git push --remote "$remote" --bookmark "$branch" --allow-new

  mkdir -p tmp
  body_file=tmp/execplan-pr-body.md
  cat >"$body_file" <<EOF_BODY
Adds an ExecPlan generated from a Linear \`workflow:execplan\` ticket.

Plan: \`$plan\`

This PR is ready for review. If the source ticket left unresolved design choices, they are recorded in the plan's \`Open Questions and Clarifications Needed\` section.
EOF_BODY

  if pr_url=$(gh pr view "$branch" --repo "$repo" --json url --jq .url 2>/dev/null); then
    :
  else
    pr_url=$(gh pr create --repo "$repo" --base "$base" --head "$branch" --title "$pr_title" --body-file "$body_file") || {
      if pr_url=$(gh pr view "$branch" --repo "$repo" --json url --jq .url 2>/dev/null); then
        :
      else
        fail "failed to create or locate PR for branch $branch"
      fi
    }
  fi

  echo "PLAN_PATH=$plan"
  echo "BRANCH=$branch"
  echo "PUBLISH_BASE=$base_revision"
  echo "PR_URL=$pr_url"
}

case "${1:-}" in
  validate)
    validate_command
    ;;
  create-pr)
    create_pr_command
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
