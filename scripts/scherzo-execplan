#!/bin/sh
# Helpers for Scherzo's workflow:execplan pipeline.

set -eu

usage() {
  cat >&2 <<'EOF'
Usage:
  scherzo-execplan validate [PLAN]
  scherzo-execplan create-pr [--publish-context FILE]
  scherzo-execplan create-implementation-issue [--publish-context FILE]
  scherzo-execplan create-implementation-issue --plan PLAN --pr-url URL [--branch BRANCH] [--source-issue ISSUE]

Run from the Scherzo jj workspace root. The workflow must leave exactly one
changed ExecPlan HTML artifact under docs/plans/. validate and create-pr treat
that docs/plans/*.html file as the primary retained plan artifact and print
PRIMARY_PLAN_ARTIFACT and PLAN_HTML_PATH pointing at it. create-pr validates,
pushes a jj bookmark to origin, opens a ready GitHub PR against main, and writes
a durable publish context artifact. create-implementation-issue creates or finds
the follow-up Linear issue that will run workflow:execplan-implementation after
the plan PR is merged, using the publish context or explicit inputs instead of
the current jj diff.
EOF
}

fail() {
  echo "scherzo-execplan: $*" >&2
  exit 1
}

plan_stem() {
  base=$(basename "$1")
  base=${base%.html}
  base=${base%.md}
  printf '%s\n' "$base"
}

print_primary_plan_artifact() {
  plan=$1
  echo "PRIMARY_PLAN_ARTIFACT=$plan"
  echo "PLAN_HTML_PATH=$plan"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

default_publish_context_path() {
  printf '%s\n' "${SCHERZO_EXECPLAN_PUBLISH_CONTEXT:-tmp/scherzo-execplan-publish-context.json}"
}

sanitize_ref_part() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9._-' '-' \
    | sed 's/^-*//; s/-*$//; s/--*/-/g'
}

changed_files() {
  jj diff --from @- --to @ --name-only --color=never
}

find_plan_path() {
  files=$(changed_files | sed '/^[[:space:]]*$/d')
  [ -n "$files" ] || fail "no changed files found"

  plan_files=$(printf '%s\n' "$files" | grep -E '^docs/plans/[^/]+\.html$' || true)
  plan_count=$(printf '%s\n' "$plan_files" | sed '/^[[:space:]]*$/d' | wc -l | tr -d '[:space:]')
  [ "$plan_count" = "1" ] || fail "expected exactly one changed docs/plans/*.html file, found $plan_count"

  plan=$(printf '%s\n' "$plan_files" | sed -n '1p')
  [ -f "$plan" ] || fail "plan file does not exist: $plan"
  plan_status=$(jj diff --summary --from @- --to @ --color=never -- "$plan" | awk '{ print $1; exit }')
  [ "$plan_status" = "A" ] || fail "plan file must be newly added, got status ${plan_status:-unknown}: $plan"

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ "$file" = "$plan" ] || fail "unexpected changed file: $file; workflow:execplan PRs may only change $plan"
  done <<EOF_FILES
$files
EOF_FILES

  printf '%s\n' "$plan"
}

validate_plan() {
  plan=$1

  printf '%s\n' "$plan" | grep -Eq '^docs/plans/[^/]+\.html$' || \
    fail "invalid ExecPlan artifact path: $plan; expected docs/plans/<file>.html"

  python3 - "$plan" <<'PY'
import html
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])

def fail(message: str) -> None:
    print(f"scherzo-execplan: {message}", file=sys.stderr)
    sys.exit(1)

try:
    text = path.read_text(encoding="utf-8")
except OSError as exc:
    fail(f"could not read plan artifact: {exc}")

if not re.search(r"<!doctype\s+html", text, flags=re.IGNORECASE):
    fail("plan artifact must be a complete HTML document starting with <!doctype html>")
if not re.search(r"<html\b", text, flags=re.IGNORECASE):
    fail("plan artifact must contain an <html> root")
if not re.search(r"<h1\b[^>]*\bcommentable\b[^>]*data-comment-id=", text, flags=re.IGNORECASE | re.DOTALL):
    fail("plan artifact must contain a commentable <h1> with data-comment-id")
if "carbon-shell" not in text or "toc-panel" not in text:
    fail("plan artifact must use the Carbon structured shell with sidebar navigation")
if "commentable" not in text or "data-comment-id=" not in text:
    fail("plan artifact must include commentable DOM metadata")
if "comment-hint" in text or "Stable DOM targets" in text:
    fail("plan artifact must not include visible comment UI hints or target-count messaging")
if re.search(r"/Users/|/home/|/private/|/var/folders/", text):
    fail("plan contains absolute local paths; use repository-relative paths only")

body_without_code = re.sub(r"<script\b.*?</script>", " ", text, flags=re.IGNORECASE | re.DOTALL)
body_without_code = re.sub(r"<style\b.*?</style>", " ", body_without_code, flags=re.IGNORECASE | re.DOTALL)
visible = html.unescape(re.sub(r"<[^>]+>", " ", body_without_code))
visible = re.sub(r"\s+", " ", visible)

if not re.search(r"\bProgress\b", visible):
    fail("missing required section: Progress")
if "Open Questions and Clarifications Needed" not in visible:
    fail("missing required section: Open Questions and Clarifications Needed")
if not re.search(r"<input\b[^>]*type=[\"']checkbox[\"']|checklist-item", text, flags=re.IGNORECASE):
    fail("Progress must contain at least one checklist item")

expected = [
    "Purpose / Big Picture",
    "Problem Framing and Constraints",
    "Strategy Overview",
    "Alternatives Considered",
    "Risks and Countermeasures",
    "Surprises & Discoveries",
    "Decision Log",
    "Outcomes & Retrospective",
    "Context and Orientation",
    "Preconditions and Verified Facts",
    "Scope Boundaries",
    "Milestones",
    "Plan of Work",
    "Concrete Steps",
    "Testing and Falsifiability",
    "Validation and Acceptance",
    "Rollout, Recovery, and Idempotence",
    "Artifacts and Notes",
    "Interfaces and Dependencies",
]
for heading in expected:
    if heading not in visible:
        print(f"scherzo-execplan: warning: missing expected section: {heading}", file=sys.stderr)
PY
}

validate_command() {
  require_command jj
  require_command python3
  explicit_plan=${1:-}
  if [ -n "$explicit_plan" ]; then
    [ -f "$explicit_plan" ] || fail "plan file does not exist: $explicit_plan"
    plan=$explicit_plan
  else
    plan=$(find_plan_path)
  fi
  validate_plan "$plan"
  print_primary_plan_artifact "$plan"
  echo "PLAN_PATH=$plan"
  echo "VALIDATION=ok"
}

owner_repo_from_url() {
  url=$1
  case "$url" in
    https://github.com/*)
      value=${url#https://github.com/}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    git@github.com:*)
      value=${url#git@github.com:}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    ssh://git@github.com/*)
      value=${url#ssh://git@github.com/}
      value=${value%.git}
      printf '%s\n' "$value"
      ;;
    *)
      return 1
      ;;
  esac
}

remote_url() {
  remote=$1
  jj git remote list --color=never | awk -v remote="$remote" '$1 == remote { print $2; exit }'
}

revision_exists() {
  revision=$1
  jj log -r "$revision" --no-graph -T 'commit_id' --color=never >/dev/null 2>&1
}

revision_commit_ids() {
  revision=$1
  jj log -r "$revision" --no-graph -T 'commit_id ++ "\n"' --color=never | sed '/^[[:space:]]*$/d'
}

current_parent_commit_ids() {
  revision_commit_ids @-
}

current_change_id_short() {
  jj log -r @ --no-graph -T 'change_id.short()' --color=never | tr -d '[:space:]'
}

execplan_branch_name() {
  plan=$1
  slug=$(sanitize_ref_part "$(plan_stem "$plan")" | cut -c 1-60)
  [ -n "$slug" ] || slug=plan
  change_id=$(current_change_id_short)
  [ -n "$change_id" ] || fail "could not determine jj change id"
  printf '%s\n' "scherzo/execplan/${slug}-${change_id}"
}

maybe_source_issue_identifier() {
  plan=$1

  if [ -n "${SCHERZO_ISSUE_IDENTIFIER:-}" ]; then
    printf '%s\n' "$SCHERZO_ISSUE_IDENTIFIER"
    return
  fi

  stem=$(plan_stem "$plan")
  issue=$(printf '%s\n' "$stem" | sed -n 's/^\([A-Za-z][A-Za-z0-9]*-[0-9][0-9]*\).*/\1/p')
  if [ -n "$issue" ]; then
    printf '%s\n' "$issue"
    return
  fi

  cwd=$(pwd -P)
  case "$cwd" in
    */.scherzo/workspaces/*)
      tail=${cwd#*/.scherzo/workspaces/}
      rest=${tail#*/}
      issue=${rest%%/*}
      if [ -n "$issue" ] && [ "$issue" != "$rest" ]; then
        printf '%s\n' "$issue"
        return
      fi
      ;;
  esac

  return 0
}

infer_source_issue_identifier() {
  plan=$1
  issue=$(maybe_source_issue_identifier "$plan")
  [ -n "$issue" ] || fail "could not infer source Linear issue identifier from cwd or plan filename: $plan"
  printf '%s\n' "$issue"
}

plan_title() {
  plan=$1
  python3 - "$plan" <<'PY'
import html
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
for pattern in [r"<h1\b[^>]*>(.*?)</h1>", r"<title\b[^>]*>(.*?)</title>"]:
    match = re.search(pattern, text, flags=re.IGNORECASE | re.DOTALL)
    if match:
        value = re.sub(r"<[^>]+>", " ", match.group(1))
        value = html.unescape(re.sub(r"\s+", " ", value)).strip()
        value = re.sub(r"\s+[—-]\s+Scherzo ExecPlan.*$", "", value).strip()
        if value:
            print(value)
            raise SystemExit(0)
print("")
PY
}

write_publish_context() {
  context_path=$1
  plan=$2
  branch=$3
  pr_url=$4
  source_issue=$5
  context_dir=$(dirname "$context_path")
  mkdir -p "$context_dir"
  python3 - "$context_path" "$plan" "$branch" "$pr_url" "$source_issue" <<'PY'
import json
import os
import pathlib
import sys

context_path, plan_path, branch, pr_url, source_issue = sys.argv[1:6]
path = pathlib.Path(context_path)
data = {
    "plan_path": plan_path,
    "branch": branch,
    "pr_url": pr_url,
    "source_issue": source_issue,
}
tmp = path.with_name(path.name + ".tmp")
tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
os.replace(tmp, path)
PY
}

load_publish_context() {
  context_path=$1
  [ -f "$context_path" ] || fail "publish context file not found: $context_path"
  python3 - "$context_path" <<'PY'
import json
import pathlib
import sys
from typing import Any

context_path = sys.argv[1]


def fail(message: str) -> None:
    print(f"scherzo-execplan: {message}", file=sys.stderr)
    sys.exit(1)


try:
    data: Any = json.loads(pathlib.Path(context_path).read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    fail(f"could not read publish context {context_path}: {exc}")

if not isinstance(data, dict):
    fail(f"publish context {context_path} must contain a JSON object")

for key in ["plan_path", "branch", "pr_url", "source_issue"]:
    value = data.get(key, "")
    if value is None:
        value = ""
    if not isinstance(value, str):
        fail(f"publish context field {key!r} must be a string")
    if "\n" in value or "\r" in value:
        fail(f"publish context field {key!r} must not contain newlines")
    print(f"{key}={value}")
PY
}

fetch_publish_base() {
  base=$1
  remote=$2
  if ! output=$(jj git fetch --remote "$remote" --branch "$base" 2>&1); then
    printf '%s\n' "$output" >&2
    fail "could not fetch PR base $base from remote $remote; configure SCHERZO_PR_REMOTE/SCHERZO_PR_BASE and retry"
  fi
  [ -z "$output" ] || printf '%s\n' "$output"
}

publish_base_revision() {
  base=$1
  remote=$2
  remote_base="${base}@${remote}"
  if revision_exists "$remote_base"; then
    printf '%s\n' "$remote_base"
  elif revision_exists "$base"; then
    echo "scherzo-execplan: warning: remote publish base $remote_base was not found after fetch; falling back to local revision $base" >&2
    printf '%s\n' "$base"
  else
    fail "could not find publish base revision $remote_base or $base"
  fi
}

has_unresolved_conflicts() {
  revision=$1
  conflicts=$(jj log -r "conflicts() & ($revision)" --no-graph -T 'change_id.short()' --color=never 2>/dev/null || true)
  [ -n "$conflicts" ]
}

normalize_publish_base() {
  base_revision=$1
  base_commit_ids=$(revision_commit_ids "$base_revision")
  parent_commit_ids=$(current_parent_commit_ids)
  base_count=$(printf '%s\n' "$base_commit_ids" | sed '/^[[:space:]]*$/d' | wc -l | tr -d '[:space:]')
  if [ "$base_count" = "1" ] && [ "$parent_commit_ids" = "$base_commit_ids" ]; then
    return 1
  fi

  echo "## Publish base normalization"
  echo "Rebasing final ExecPlan change onto \`$base_revision\` before publishing so the PR branch does not push local workspace ancestors."
  jj rebase -r @ -d "$base_revision" --color=never || \
    fail "could not rebase the final ExecPlan change onto the PR base $base_revision; resolve the retained workspace manually, rerun validation, and publish again"
  if has_unresolved_conflicts @; then
    status=$(jj status --color=never 2>/dev/null || true)
    fail "rebasing the final ExecPlan change onto the PR base left unresolved conflicts. Resolve the retained workspace manually, rerun validation, and publish again.${status:+\n$status}"
  fi
  return 0
}

empty_description_commits_to_push() {
  remote=$1
  revset='remote_bookmarks(remote='"$remote"')..@ & description(exact:"") & ~root()'
  jj log -r "$revset" --no-graph \
    -T 'change_id.short() ++ " " ++ commit_id.short() ++ " " ++ if(empty, "(empty) ", "") ++ if(description, description.first_line(), "(no description set)") ++ "\n"' \
    --color=never
}

ensure_no_empty_descriptions_to_push() {
  remote=$1
  if ! undescribed=$(empty_description_commits_to_push "$remote" 2>&1); then
    printf '%s\n' "$undescribed" >&2
    fail "could not inspect commits that would be pushed to $remote"
  fi
  if [ -n "$undescribed" ]; then
    echo "scherzo-execplan: refusing to push because these commits in the push range have empty descriptions:" >&2
    printf '%s\n' "$undescribed" >&2
    exit 1
  fi
}

create_pr_command() {
  require_command jj
  require_command gh
  require_command python3

  context_path=$(default_publish_context_path)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --publish-context)
        [ "$#" -gt 1 ] || fail "--publish-context requires a value"
        context_path=$2
        shift 2
        ;;
      *)
        fail "unknown create-pr option: $1"
        ;;
    esac
  done

  plan=$(find_plan_path)
  validate_plan "$plan"

  base=${SCHERZO_PR_BASE:-main}
  remote=${SCHERZO_PR_REMOTE:-origin}
  repo=${SCHERZO_PR_REPO:-}
  if [ -z "$repo" ]; then
    url=$(remote_url "$remote")
    [ -n "$url" ] || fail "could not find jj git remote: $remote"
    repo=$(owner_repo_from_url "$url") || fail "could not infer GitHub owner/repo from remote URL: $url"
  fi
  fetch_publish_base "$base" "$remote"
  base_revision=$(publish_base_revision "$base" "$remote")
  if normalize_publish_base "$base_revision"; then
    echo ""
    echo "## Validation after publish-base normalization"
    plan=$(find_plan_path)
    validate_plan "$plan"
  fi

  title=$(plan_title "$plan")
  [ -n "$title" ] || title="Add ExecPlan $(plan_stem "$plan")"
  case "$title" in
    ExecPlan:*|execplan:*) pr_title=$title ;;
    *) pr_title="ExecPlan: $title" ;;
  esac

  slug=$(sanitize_ref_part "$(plan_stem "$plan")" | cut -c 1-60)
  [ -n "$slug" ] || slug=plan
  branch=$(execplan_branch_name "$plan")

  jj describe -m "docs(plan): add execplan for $slug"
  ensure_no_empty_descriptions_to_push "$remote"
  jj bookmark set "$branch" --revision @
  jj git push --remote "$remote" --bookmark "$branch" --allow-new

  mkdir -p tmp
  body_file=tmp/execplan-pr-body.md
  cat >"$body_file" <<EOF_BODY
Adds a Carbon HTML ExecPlan artifact generated from a Linear \`workflow:execplan\` ticket.

Plan artifact: \`$plan\`

This PR is ready for review. If the source ticket left unresolved design choices, they are recorded in the plan's \`Open Questions and Clarifications Needed\` section.
EOF_BODY

  if pr_url=$(gh pr view "$branch" --repo "$repo" --json url --jq .url 2>/dev/null); then
    :
  else
    pr_url=$(gh pr create --repo "$repo" --base "$base" --head "$branch" --title "$pr_title" --body-file "$body_file") || {
      if pr_url=$(gh pr view "$branch" --repo "$repo" --json url --jq .url 2>/dev/null); then
        :
      else
        fail "failed to create or locate PR for branch $branch"
      fi
    }
  fi
  [ -n "$pr_url" ] || fail "ExecPlan PR URL was empty for branch $branch"

  source_issue=$(maybe_source_issue_identifier "$plan")
  write_publish_context "$context_path" "$plan" "$branch" "$pr_url" "$source_issue"
  print_primary_plan_artifact "$plan"

  echo "PLAN_PATH=$plan"
  echo "BRANCH=$branch"
  echo "PUBLISH_BASE=$base_revision"
  echo "PR_URL=$pr_url"
  echo "PUBLISH_CONTEXT=$context_path"
}

create_implementation_issue_command() {
  require_command linear
  require_command python3

  context_path=$(default_publish_context_path)
  explicit_context=0
  direct_inputs=0
  plan=
  branch=
  pr_url=
  source_issue=

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --publish-context)
        [ "$#" -gt 1 ] || fail "--publish-context requires a value"
        context_path=$2
        explicit_context=1
        shift 2
        ;;
      --plan)
        [ "$#" -gt 1 ] || fail "--plan requires a value"
        plan=$2
        direct_inputs=1
        shift 2
        ;;
      --pr-url)
        [ "$#" -gt 1 ] || fail "--pr-url requires a value"
        pr_url=$2
        direct_inputs=1
        shift 2
        ;;
      --branch)
        [ "$#" -gt 1 ] || fail "--branch requires a value"
        branch=$2
        direct_inputs=1
        shift 2
        ;;
      --source-issue)
        [ "$#" -gt 1 ] || fail "--source-issue requires a value"
        source_issue=$2
        direct_inputs=1
        shift 2
        ;;
      *)
        fail "unknown create-implementation-issue option: $1"
        ;;
    esac
  done

  if [ "$explicit_context" = "1" ] || [ "$direct_inputs" = "0" ]; then
    if [ -f "$context_path" ]; then
      context_values=$(load_publish_context "$context_path")
      while IFS='=' read -r key value; do
        case "$key" in
          plan_path) [ -n "$plan" ] || plan=$value ;;
          branch) [ -n "$branch" ] || branch=$value ;;
          pr_url) [ -n "$pr_url" ] || pr_url=$value ;;
          source_issue) [ -n "$source_issue" ] || source_issue=$value ;;
        esac
      done <<EOF_CONTEXT
$context_values
EOF_CONTEXT
    elif [ "$explicit_context" = "1" ]; then
      fail "publish context file not found: $context_path"
    fi
  fi

  [ -n "$plan" ] || fail "missing ExecPlan path; run create-pr first or pass --publish-context/--plan"
  [ -f "$plan" ] || fail "plan file does not exist: $plan"
  validate_plan "$plan"

  if [ -z "$pr_url" ]; then
    [ -n "$branch" ] || fail "missing ExecPlan PR URL; run create-pr first or pass --pr-url"
    require_command jj
    require_command gh
    remote=${SCHERZO_PR_REMOTE:-origin}
    repo=${SCHERZO_PR_REPO:-}
    if [ -z "$repo" ]; then
      url=$(remote_url "$remote")
      [ -n "$url" ] || fail "could not find jj git remote: $remote"
      repo=$(owner_repo_from_url "$url") || fail "could not infer GitHub owner/repo from remote URL: $url"
    fi
    pr_url=$(gh pr view "$branch" --repo "$repo" --json url --jq .url 2>/dev/null) || \
      fail "could not find ExecPlan PR for branch $branch; pass --pr-url or rerun create-pr"
  fi
  [ -n "$pr_url" ] || fail "ExecPlan PR URL was empty"

  if [ -z "$source_issue" ]; then
    source_issue=$(infer_source_issue_identifier "$plan")
  fi
  implementation_state=${SCHERZO_EXECPLAN_IMPLEMENTATION_STATE:-Backlog}

  python3 - "$plan" "$pr_url" "$source_issue" "$implementation_state" <<'PY'
import html
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
from typing import Any

plan_path, pr_url, source_identifier, implementation_state = sys.argv[1:5]
workflow_label = os.environ.get(
    "SCHERZO_EXECPLAN_IMPLEMENTATION_LABEL",
    "workflow:execplan-implementation",
).strip() or "workflow:execplan-implementation"
support_labels = {"needs-workflow", "needs-clarification"}


def fail(message: str) -> None:
    print(f"scherzo-execplan: {message}", file=sys.stderr)
    sys.exit(1)


def run(args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and proc.returncode != 0:
        details = proc.stderr.strip() or proc.stdout.strip() or f"exit code {proc.returncode}"
        fail(f"command failed: {' '.join(args)}\n{details}")
    return proc


def load_json_from_command(args: list[str]) -> Any:
    out = run(args).stdout.strip()
    if not out:
        fail(f"command produced empty JSON: {' '.join(args)}")
    try:
        return json.loads(out)
    except json.JSONDecodeError as exc:
        fail(f"could not parse JSON from {' '.join(args)}: {exc}")


def normalize_issue(value: Any) -> dict[str, Any]:
    if isinstance(value, dict):
        if isinstance(value.get("issue"), dict):
            return value["issue"]
        if isinstance(value.get("data"), dict) and isinstance(value["data"].get("issue"), dict):
            return value["data"]["issue"]
        return value
    fail("Linear issue payload was not an object")


def label_names(issue: dict[str, Any]) -> list[str]:
    labels = issue.get("labels") or []
    if isinstance(labels, dict):
        labels = labels.get("nodes") or []
    names: list[str] = []
    if isinstance(labels, list):
        for label in labels:
            if isinstance(label, dict):
                name = label.get("name")
            else:
                name = str(label)
            if name:
                names.append(str(name))
    return names


def domain_labels_for_followup(issue: dict[str, Any]) -> list[str]:
    names: list[str] = []
    for name in label_names(issue):
        normalized = name.strip().lower()
        if not normalized:
            continue
        if normalized.startswith("workflow:"):
            continue
        if normalized in support_labels:
            continue
        names.append(name.strip())
    if workflow_label.lower() not in {name.lower() for name in names}:
        names.append(workflow_label)
    return names


def first_heading(path: str) -> str:
    try:
        text = pathlib.Path(path).read_text(encoding="utf-8")
    except OSError as exc:
        fail(f"could not read plan title from {path}: {exc}")
    for pattern in [r"<h1\b[^>]*>(.*?)</h1>", r"<title\b[^>]*>(.*?)</title>"]:
        match = re.search(pattern, text, flags=re.IGNORECASE | re.DOTALL)
        if match is not None:
            title = re.sub(r"<[^>]+>", " ", match.group(1))
            title = html.unescape(re.sub(r"\s+", " ", title)).strip()
            title = re.sub(r"\s+[—-]\s+Scherzo ExecPlan.*$", "", title).strip()
            if title:
                return title
    for line in text.splitlines():
        if line.startswith("# "):
            title = line.removeprefix("# ").strip()
            if title:
                return title
    return f"ExecPlan {path}"


def implementation_title(plan_title: str) -> str:
    if plan_title.lower().startswith("implement"):
        title = plan_title
    else:
        title = "Implement: " + plan_title
    return title[:240]


def nested_name(issue: dict[str, Any], key: str) -> str:
    value = issue.get(key) or {}
    if isinstance(value, dict):
        return str(value.get("name") or value.get("key") or value.get("id") or "")
    return ""


def issue_labels_lower(issue: dict[str, Any]) -> set[str]:
    return {name.lower() for name in label_names(issue)}


def issue_contains_plan(issue: dict[str, Any]) -> bool:
    text = "\n".join([
        str(issue.get("title") or ""),
        str(issue.get("description") or ""),
    ])
    return plan_path in text and workflow_label.lower() in issue_labels_lower(issue)


def issue_nodes(payload: Any, command_name: str) -> list[Any]:
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        nodes = payload.get("nodes")
        if isinstance(nodes, list):
            return nodes
    fail(f"Linear {command_name} payload did not contain an issue list")


def find_existing(team_key: str, project_name: str) -> dict[str, Any] | None:
    args = [
        "linear",
        "issue",
        "query",
        "--team",
        team_key,
        "--search",
        plan_path,
        "--limit",
        "250",
        "--json",
    ]
    if project_name:
        args.extend(["--project", project_name])
    issues = issue_nodes(load_json_from_command(args), "issue query")
    for issue in issues:
        if isinstance(issue, dict) and issue_contains_plan(issue):
            return issue
    return None


def readiness_note(state: str) -> str:
    if state.strip().lower() in {"todo", "in progress"}:
        return (
            "This issue was created in an active Scherzo state, so it may dispatch "
            "immediately. Use this only when the ExecPlan file already exists on "
            "the workflow base branch."
        )
    return (
        f"This issue was created in `{state}` so Scherzo will not dispatch it yet. "
        f"After the ExecPlan PR is merged and `{plan_path}` exists on the workflow "
        "base branch, move this issue to `Todo`."
    )


def source_line(issue: dict[str, Any]) -> str:
    identifier = issue.get("identifier") or source_identifier
    title = issue.get("title") or "Untitled"
    url = issue.get("url") or ""
    if url:
        return f"[{identifier}: {title}]({url})"
    return f"{identifier}: {title}"


def render_description(source_issue: dict[str, Any]) -> str:
    return "\n".join([
        f"Implements the ExecPlan produced from {source_line(source_issue)}.",
        "",
        f"Plan path: `{plan_path}`",
        f"ExecPlan PR: {pr_url}",
        "Implementation workflow: `workflow:execplan-implementation`",
        "",
        "## Readiness",
        "",
        readiness_note(implementation_state),
        "",
        "## Operator handoff",
        "",
        "1. Review and merge the ExecPlan PR.",
        f"2. Confirm `{plan_path}` exists on the workflow base branch.",
        "3. Move this issue to `Todo` to let Scherzo implement the plan.",
        "",
    ])


def issue_ref(issue: dict[str, Any]) -> str:
    return str(issue.get("identifier") or issue.get("id") or "")


def issue_url(issue: dict[str, Any]) -> str:
    return str(issue.get("url") or "")


def source_team_key(issue: dict[str, Any]) -> str:
    team = issue.get("team") or {}
    if isinstance(team, dict):
        value = str(team.get("key") or team.get("name") or team.get("id") or "")
        if value:
            return value.upper()
    identifier = str(issue.get("identifier") or source_identifier)
    if "-" in identifier:
        return identifier.split("-", 1)[0].upper()
    fail(f"could not infer source issue team from {identifier!r}")


def created_issue_from_output(output: str) -> dict[str, Any]:
    urls = re.findall(r"https?://[^\s]+", output)
    issue_url = ""
    for url in reversed(urls):
        if "/issue/" in url or re.search(r"\b[A-Za-z][A-Za-z0-9]*-[0-9]+\b", url):
            issue_url = url.rstrip(".,;)")
            break
    if not issue_url:
        fail("could not find created Linear issue URL in issue create output")
    match = re.search(r"/issue/([A-Za-z][A-Za-z0-9]*-[0-9]+)(?:/|$)", issue_url)
    if match is None:
        match = re.search(r"\b([A-Za-z][A-Za-z0-9]*-[0-9]+)\b", issue_url)
    if match is None:
        fail(f"could not infer created issue identifier from URL: {issue_url}")
    return {"identifier": match.group(1).upper(), "url": issue_url}


source_issue = normalize_issue(load_json_from_command([
    "linear",
    "issue",
    "view",
    source_identifier,
    "--json",
]))
team_key = source_team_key(source_issue)
project_name = nested_name(source_issue, "project")
priority = source_issue.get("priority")
plan_title = first_heading(plan_path)
title = implementation_title(plan_title)
labels = domain_labels_for_followup(source_issue)
description = render_description(source_issue)

existing = find_existing(team_key, project_name)
if existing is not None:
    print("IMPLEMENTATION_ISSUE_STATUS=existing")
    print(f"IMPLEMENTATION_ISSUE={issue_ref(existing)}")
    if issue_url(existing):
        print(f"IMPLEMENTATION_ISSUE_URL={issue_url(existing)}")
    print(f"PLAN_PATH={plan_path}")
    print(f"PR_URL={pr_url}")
    sys.exit(0)

description_file = ""
try:
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        prefix="scherzo-execplan-implementation-",
        suffix=".md",
        delete=False,
    ) as handle:
        handle.write(description)
        description_file = handle.name

    create_args = [
        "linear",
        "issue",
        "create",
        "--team",
        team_key,
        "--title",
        title,
        "--description-file",
        description_file,
        "--state",
        implementation_state,
        "--no-interactive",
    ]
    for label in labels:
        create_args.extend(["--label", label])
    if project_name:
        create_args.extend(["--project", project_name])
    if priority is not None:
        create_args.extend(["--priority", str(priority)])
    if source_identifier:
        create_args.extend(["--parent", source_identifier])
    created = created_issue_from_output(run(create_args).stdout)
finally:
    if description_file:
        try:
            os.unlink(description_file)
        except OSError:
            pass

created_ref = issue_ref(created)
created_url = issue_url(created)

if created_ref and pr_url:
    attach = run([
        "linear",
        "issue",
        "link",
        created_ref,
        pr_url,
        "--title",
        "ExecPlan PR",
    ], check=False)
    if attach.returncode != 0:
        details = attach.stderr.strip() or attach.stdout.strip() or f"exit code {attach.returncode}"
        print(
            f"scherzo-execplan: warning: created issue but could not attach PR URL: {details}",
            file=sys.stderr,
        )

print("IMPLEMENTATION_ISSUE_STATUS=created")
print(f"IMPLEMENTATION_ISSUE={created_ref}")
if created_url:
    print(f"IMPLEMENTATION_ISSUE_URL={created_url}")
print(f"IMPLEMENTATION_ISSUE_STATE={implementation_state}")
print(f"PLAN_PATH={plan_path}")
print(f"PR_URL={pr_url}")
PY
}

case "${1:-}" in
  validate)
    shift
    validate_command "${1:-}"
    ;;
  create-pr)
    shift
    create_pr_command "$@"
    ;;
  create-implementation-issue)
    shift
    create_implementation_issue_command "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
