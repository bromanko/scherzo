#!/bin/sh
# Shared jj workspace hook helpers for checked-in Scherzo workflows.
#
# Scherzo runs hooks with cwd set to the per-issue workspace path. This script
# is intentionally invoked from the coordinating repository root, for example:
#
#   sh "$repo_root/scripts/scherzo-jj-workspace" after-create research
#
# The target workspace path is always the hook cwd.

set -eu

usage() {
  cat >&2 <<'EOF'
Usage: scherzo-jj-workspace <after-create|before-run|before-remove> <workflow-name>

Run from a Scherzo hook cwd. SCHERZO_REPO_ROOT may point at the coordinating
jj repository; otherwise the script infers it from .scherzo/workspaces layout.
Set SCHERZO_JJ_WORKSPACE_BASE to override the initial base revision; otherwise
new root workspaces prefer ${SCHERZO_PR_BASE:-main}@${SCHERZO_PR_REMOTE:-origin},
then ${SCHERZO_PR_BASE:-main}, then main@origin, then main, then @.
EOF
}

fail() {
  echo "scherzo-jj-workspace: $*" >&2
  exit 1
}

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

command=$1
workflow_name=$2
workspace_path=$(pwd -P)

sanitize_key() {
  printf '%s' "$1" \
    | tr -c 'A-Za-z0-9_.-' '-' \
    | sed 's/^-*//; s/-*$//; s/--*/-/g'
}

issue_key=$(sanitize_key "${SCHERZO_ISSUE_IDENTIFIER:-issue}")
run_key=$(sanitize_key "${SCHERZO_RUN_ID:-run}")
logical_workspace_key=$(sanitize_key "${SCHERZO_WORKSPACE_NAME:-$(basename "$workspace_path")}")

[ -n "$issue_key" ] || issue_key=issue
[ -n "$run_key" ] || run_key=run
[ -n "$logical_workspace_key" ] || logical_workspace_key=workspace

workspace_key="${issue_key}-${run_key}-${logical_workspace_key}"
workspace_name="scherzo-${workflow_name}-${workspace_key}"

infer_repo_root() {
  if [ -n "${SCHERZO_REPO_ROOT:-}" ]; then
    (cd "$SCHERZO_REPO_ROOT" && pwd -P)
    return
  fi

  # Expected checked-in convention:
  #   <repo>/.scherzo/workspaces/<workflow-name>/<issue-key>
  (cd "$workspace_path/../../../.." && pwd -P)
}

repo_root=$(infer_repo_root)

require_jj_repo_root() {
  test -d "$repo_root/.jj" || fail "repo root is not a jj repository: $repo_root"
}

current_change_id() {
  jj log -r @ --no-graph -T 'change_id'
}

revision_exists() {
  revision=$1
  jj --repository "$repo_root" log -r "$revision" --no-graph -T 'commit_id' --color=never >/dev/null 2>&1
}

workspace_base_revision() {
  default_base=${SCHERZO_PR_BASE:-main}
  default_remote=${SCHERZO_PR_REMOTE:-origin}
  remote_base="${default_base}@${default_remote}"

  if [ -n "${SCHERZO_JJ_WORKSPACE_BASE:-}" ]; then
    revision_exists "$SCHERZO_JJ_WORKSPACE_BASE" || \
      fail "SCHERZO_JJ_WORKSPACE_BASE does not resolve in repo: $SCHERZO_JJ_WORKSPACE_BASE"
    printf '%s\n' "$SCHERZO_JJ_WORKSPACE_BASE"
  elif revision_exists "$remote_base"; then
    printf '%s\n' "$remote_base"
  elif revision_exists "$default_base"; then
    printf '%s\n' "$default_base"
  elif [ "$remote_base" != main@origin ] && revision_exists main@origin; then
    printf '%s\n' main@origin
  elif [ "$default_base" != main ] && revision_exists main; then
    printf '%s\n' main
  else
    printf '%s\n' @
  fi
}

workspace_row_for_change() {
  change=$1
  jj workspace list --color=never -T 'name ++ ":" ++ self.target().change_id() ++ "\n"' \
    | awk -F: -v change="$change" '$2 == change { print $0; exit }'
}

prepare_destination_for_workspace_add() {
  workspace_parent=$(dirname "$workspace_path")
  workspace_leaf=$(basename "$workspace_path")
  mkdir -p "$workspace_parent" || fail "could not create workspace parent: $workspace_parent"
  cd "$workspace_parent"
  if [ -d "$workspace_leaf" ]; then
    rmdir "$workspace_leaf" 2>/dev/null || \
      fail "workspace path exists and is not empty before jj workspace add: $workspace_path"
  fi
}

verify_current_workspace() {
  cd "$workspace_path"
  test -e .jj || fail "workspace is missing .jj: $workspace_path"
  test "$(jj root)" = "$workspace_path" || fail "jj root does not match workspace path"

  change=$(current_change_id)
  row=$(workspace_row_for_change "$change")
  test "$row" = "${workspace_name}:${change}" || \
    fail "expected workspace ${workspace_name} for change ${change}, got: ${row:-<none>}"

  jj status --color=never
}

allow_trusted_envrc_after_create() {
  cd "$workspace_path"
  if [ -f .envrc ]; then
    command -v direnv >/dev/null 2>&1 || \
      fail ".envrc exists but direnv is not installed in workspace setup environment"
    if ! output=$(direnv allow . 2>&1); then
      printf '%s\n' "$output" >&2
      fail "direnv allow failed for workspace: $workspace_path"
    fi
  fi
}

case "$command" in
  after-create)
    require_jj_repo_root
    if [ -d "$workspace_path/.jj" ]; then
      verify_current_workspace
      exit 0
    fi
    prepare_destination_for_workspace_add
    if [ -n "${SCHERZO_SOURCE_WORKSPACE_PATH:-}" ]; then
      test -d "$SCHERZO_SOURCE_WORKSPACE_PATH/.jj" || \
        fail "source workspace is missing .jj: $SCHERZO_SOURCE_WORKSPACE_PATH"
      jj --repository "$SCHERZO_SOURCE_WORKSPACE_PATH" workspace add \
        --name "$workspace_name" \
        --revision @ \
        --sparse-patterns full \
        "$workspace_path"
    else
      base_revision=$(workspace_base_revision)
      jj --repository "$repo_root" workspace add \
        --name "$workspace_name" \
        --revision "$base_revision" \
        --sparse-patterns full \
        "$workspace_path"
    fi
    verify_current_workspace
    allow_trusted_envrc_after_create
    ;;

  before-run)
    verify_current_workspace
    ;;

  before-remove)
    if [ -d "$workspace_path" ]; then
      cd "$workspace_path"
    fi
    if command -v jj >/dev/null 2>&1 && jj root >/dev/null 2>&1; then
      change=$(current_change_id)
      row=$(workspace_row_for_change "$change")
      name=${row%%:*}
      if [ -n "$name" ]; then
        jj workspace forget "$name"
      fi
    fi
    ;;

  *)
    usage
    exit 2
    ;;
esac
