#!/bin/sh
# Deprecated compatibility wrapper for legacy Scherzo jj workspace hooks.
#
# The authoritative jj workspace driver is scripts/scherzo-workspace-jj. Keep
# this wrapper only for older local hook snippets that still call the historical
# after-create/before-run/before-remove verbs. Follow-up: delete this wrapper once
# downstream hook snippets have migrated. New config and workflows must call
# scripts/scherzo-workspace-jj lifecycle <operation> directly.

set -eu

usage() {
  cat >&2 <<'EOF'
Usage: scherzo-jj-workspace <after-create|before-run|before-remove> <workflow-name>

Deprecated compatibility wrapper. Use:
  scherzo-workspace-jj lifecycle create
  scherzo-workspace-jj lifecycle before-step
  scherzo-workspace-jj lifecycle remove
EOF
}

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

case "$0" in
  */*) wrapper_script=$0 ;;
  *) wrapper_script=$(command -v "$0" 2>/dev/null || printf '%s\n' "$0") ;;
esac
wrapper_dir=$(CDPATH= cd "$(dirname "$wrapper_script")" && pwd -P)
driver=$wrapper_dir/scherzo-workspace-jj

case "$1" in
  after-create) lifecycle_operation=create ;;
  before-run) lifecycle_operation=before-step ;;
  before-remove) lifecycle_operation=remove ;;
  *)
    usage
    exit 2
    ;;
esac

SCHERZO_WORKFLOW_ID=$2
export SCHERZO_WORKFLOW_ID

echo "scherzo-jj-workspace: deprecated; use scherzo-workspace-jj lifecycle $lifecycle_operation" >&2
exec "$driver" lifecycle "$lifecycle_operation"
