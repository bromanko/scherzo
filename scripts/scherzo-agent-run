#!/usr/bin/env sh
set -e

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
repo_root=$(CDPATH= cd "$script_dir/.." && pwd)
. "$script_dir/scherzo-agent-common.sh"

SCHERZO_REPO_ROOT=${SCHERZO_REPO_ROOT:-${DEVENV_ROOT:-$repo_root}}
export SCHERZO_REPO_ROOT

prepare_agent_env
require_live_identity
require_github_identity
require_github_repo_access
require_github_pr_create_permission
require_linear_identity
require_ssh_identity

if [ "$LINEAR_API_KEY" != "$SCHERZO_AGENT_LINEAR_API_KEY" ]; then
  fail "LINEAR_API_KEY was not derived from SCHERZO_AGENT_LINEAR_API_KEY"
fi

echo "Scherzo agent identity checks passed for GitHub login $SCHERZO_AGENT_GITHUB_LOGIN and repo $SCHERZO_GITHUB_REPO"
echo "Linear key source=SCHERZO_AGENT_LINEAR_API_KEY"
echo "SCHERZO_AGENT_JJ_WORKSPACE_PUBLISH_REMOTE=$SCHERZO_AGENT_JJ_WORKSPACE_PUBLISH_REMOTE"
echo "remote url=$(require_agent_remote)"
show_identities

SCHERZO_START_RUNNER_NAME=${SCHERZO_START_RUNNER_NAME:-scherzo-agent-run}
export SCHERZO_START_RUNNER_NAME

exec "$script_dir/scherzo-start-runner" -- gleam run -- .scherzo/scherzo.yaml
