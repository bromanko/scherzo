#!/bin/sh
case "$0" in
  */*) SCHERZO_DRIVER_SCRIPT=$0 ;;
  *) SCHERZO_DRIVER_SCRIPT=$(command -v "$0" 2>/dev/null || printf '%s\n' "$0") ;;
esac
export SCHERZO_DRIVER_SCRIPT
exec python3 - "$@" <<'PY'
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

USAGE = """Usage:
  scherzo-workspace-jj describe --json
  scherzo-workspace-jj lifecycle <create|before-step|after-step|remove>
  scherzo-workspace-jj status --human
  scherzo-workspace-jj diff --human
  scherzo-workspace-jj diff --json
  scherzo-workspace-jj changed-files --json
  scherzo-workspace-jj baseline --json
  scherzo-workspace-jj refresh-base --stage <stage> [--target <driver-ref>] --json
  scherzo-workspace-jj publish-change --kind <kind> --title-file <path> --body-file <path> --branch-prefix <prefix> --base <driver-ref> [--target-branch <branch>] [--target-pr <number>] [--allow-no-changes <true|false>] --json
  scherzo-workspace-jj assert-only --path <relative-file>
"""

WINDOWS_ABSOLUTE_RE = re.compile(r"^[A-Za-z]:[\\/]")
REFRESH_STAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
PUBLISH_KIND_RE = re.compile(r"^[a-z][a-z0-9-]*$")
STATUS_MAP = {
    "A": "added",
    "M": "modified",
    "D": "deleted",
    "R": "renamed",
    "C": "modified",
}
PORTABLE_SCHERZO_BRIDGE_NAME = "scherzo"
PORTABLE_SCHERZO_LINKS = [
    ("scripts", "scripts"),
    (".scherzo/workflows", ".scherzo/workflows"),
]


def usage_error(message: str | None = None) -> None:
    if message:
        print(f"scherzo-workspace-jj: {message}", file=sys.stderr)
    print(USAGE, file=sys.stderr, end="")
    raise SystemExit(2)


def fail(message: str) -> None:
    print(f"scherzo-workspace-jj: {message}", file=sys.stderr)
    raise SystemExit(1)


def json_dump(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def describe_json() -> None:
    json_dump({
        "version": 1,
        "capabilities": [
            "status",
            "diff",
            "changed-files",
            "assert-only",
            "baseline",
            "refresh-base",
            "publish-change",
        ],
    })


def json_failure(
    *,
    status: str,
    failure_code: str,
    message: str,
    exit_code: int = 1,
    **extra: object,
) -> None:
    payload: dict[str, object] = {
        "version": 1,
        "status": status,
        "failure_code": failure_code,
        "message": message,
    }
    payload.update(extra)
    json_dump(payload)
    raise SystemExit(exit_code)


def env_value(name: str) -> str | None:
    value = os.environ.get(name)
    if value is None:
        return None
    value = value.strip()
    return value or None


def env_is_present(name: str) -> bool:
    return env_value(name) is not None


def selected_workspace_base_branch() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_BASE_BRANCH") or env_value("SCHERZO_PR_BASE") or "main"


def selected_workspace_base_remote() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_REMOTE") or env_value("SCHERZO_PR_REMOTE") or "origin"


def selected_publication_remote() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE") or env_value("SCHERZO_PR_REMOTE") or "origin"


def base_selection_was_configured() -> bool:
    return any(
        env_is_present(name)
        for name in [
            "SCHERZO_JJ_WORKSPACE_REMOTE",
            "SCHERZO_JJ_WORKSPACE_BASE_BRANCH",
            "SCHERZO_PR_REMOTE",
            "SCHERZO_PR_BASE",
        ]
    )


def fetch_base_enabled() -> bool:
    value = env_value("SCHERZO_JJ_WORKSPACE_FETCH_BASE")
    if value is None or value == "true":
        return True
    if value == "false":
        return False
    usage_error("SCHERZO_JJ_WORKSPACE_FETCH_BASE must be true or false")


def pr_draft_setting() -> bool | None:
    value = env_value("SCHERZO_PR_DRAFT")
    if value is None:
        return None
    if value == "true":
        return True
    if value == "false":
        return False
    json_failure(
        status="invalid_request",
        failure_code="invalid_configuration",
        message="SCHERZO_PR_DRAFT must be true or false",
    )


def unique_values(values: list[str]) -> list[str]:
    unique: list[str] = []
    for value in values:
        if value not in unique:
            unique.append(value)
    return unique


def safe_resolve(raw: str) -> Path:
    try:
        return Path(raw).resolve(strict=False)
    except OSError as exc:
        fail(f"could not resolve workspace path: {exc}")


def capability_root() -> Path:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw:
        return safe_resolve(raw)
    try:
        return Path.cwd().resolve(strict=False)
    except OSError as exc:
        fail(f"could not resolve current workspace: {exc}")


def validate_relative_path(value: str, *, usage_label: str = "path") -> str:
    if value == "":
        usage_error(f"{usage_label} must not be empty")
    if value == ".":
        usage_error(f"{usage_label} must name a file, not .")
    if Path(value).is_absolute() or WINDOWS_ABSOLUTE_RE.match(value):
        usage_error(f"{usage_label} must be relative to the workspace root")
    segments = value.replace("\\", "/").split("/")
    if any(segment == ".." for segment in segments):
        usage_error(f"{usage_label} must not contain .. segments")
    return value


def parse_path_argument(args: list[str]) -> str:
    if len(args) != 2 or args[0] != "--path":
        usage_error("assert-only requires --path <relative-file>")
    return validate_relative_path(args[1], usage_label="assert-only path")


def require_explicit_workspace_path(operation: str) -> None:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw is None or raw == "":
        usage_error(f"SCHERZO_WORKSPACE_PATH is required for lifecycle {operation}")


def resolve_existing_dir(raw: str, label: str) -> Path:
    try:
        path = Path(raw).resolve(strict=True)
    except OSError as exc:
        fail(f"could not resolve {label}: {exc}")
    if not path.is_dir():
        fail(f"{label} is not a directory: {path}")
    return path


def resolve_dir_or_raw(raw: str) -> Path:
    path = Path(raw)
    try:
        if path.is_dir():
            return path.resolve(strict=True)
    except OSError:
        pass
    return path.resolve(strict=False)


def lifecycle_workspace_path() -> Path:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw:
        return resolve_dir_or_raw(raw)
    try:
        return Path.cwd().resolve(strict=True)
    except OSError as exc:
        fail(f"could not resolve current workspace: {exc}")


def lifecycle_run_root() -> Path | None:
    raw = os.environ.get("SCHERZO_RUN_ROOT")
    if not raw:
        return None
    return resolve_dir_or_raw(raw)


def contained_by(child: Path, parent: Path) -> bool:
    try:
        child_text = str(child.resolve(strict=False))
        parent_text = str(parent.resolve(strict=False))
        return (
            child_text != parent_text
            and os.path.commonpath([child_text, parent_text]) == parent_text
        )
    except (OSError, ValueError):
        return False


def validate_remove_target(workspace_path: Path, run_root: Path | None) -> None:
    if workspace_path.parent == workspace_path:
        usage_error("refusing filesystem root as workspace path")
    if run_root is not None and not contained_by(workspace_path, run_root):
        usage_error("refusing to remove workspace outside SCHERZO_RUN_ROOT")


def infer_repo_root(workspace_path: Path) -> Path:
    raw_repo = os.environ.get("SCHERZO_REPO_ROOT")
    if raw_repo:
        return resolve_existing_dir(raw_repo, "repo root")

    raw_config = os.environ.get("SCHERZO_CONFIG_DIR")
    if raw_config:
        config_dir = resolve_existing_dir(raw_config, "config directory")
        return resolve_existing_dir(str(config_dir.parent), "repo root")

    try:
        candidate = workspace_path.parents[6]
    except IndexError:
        fail("could not infer repo root from workspace path; set SCHERZO_REPO_ROOT")
    return resolve_existing_dir(str(candidate), "repo root")


def sanitize_workspace_key(value: str) -> str:
    sanitized = re.sub(r"[^A-Za-z0-9_.-]+", "-", value)
    sanitized = re.sub(r"-+", "-", sanitized).strip("-")
    return sanitized


def lifecycle_workspace_name(workspace_path: Path) -> str:
    workflow = os.environ.get("SCHERZO_WORKFLOW_ID") or "workflow"
    issue_key = sanitize_workspace_key(os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "issue")) or "issue"
    run_key = sanitize_workspace_key(os.environ.get("SCHERZO_RUN_ID", "run")) or "run"
    logical = os.environ.get("SCHERZO_WORKSPACE_NAME") or workspace_path.name
    logical_key = sanitize_workspace_key(logical) or "workspace"
    return f"scherzo-{workflow}-{issue_key}-{run_key}-{logical_key}"


def run_backend_proc(
    args: list[str],
    *,
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            cwd=str(cwd) if cwd is not None else None,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError:
        fail(f"required command not found: {args[0]}")


def run_backend_stream(args: list[str], *, cwd: Path | None = None) -> int:
    try:
        return subprocess.call(args, cwd=str(cwd) if cwd is not None else None)
    except FileNotFoundError:
        fail(f"required command not found: {args[0]}")


def write_bounded_backend_output(proc: subprocess.CompletedProcess[str]) -> None:
    text = proc.stderr or proc.stdout
    if text:
        sys.stderr.write(text[:4000])
        if not text.endswith("\n"):
            sys.stderr.write("\n")


def require_jj_repo_root(repo_root: Path) -> None:
    if not (repo_root / ".jj").is_dir():
        fail(f"repo root is not a jj repository: {repo_root}")


def revision_exists(repo_root: Path, revision: str) -> bool:
    proc = run_backend_proc(
        [
            "jj",
            "--repository",
            str(repo_root),
            "log",
            "-r",
            revision,
            "--no-graph",
            "-T",
            "commit_id",
            "--color=never",
        ]
    )
    return proc.returncode == 0


def fetch_workspace_base(repo_root: Path, branch: str, remote: str) -> None:
    proc = run_backend_proc(
        [
            "jj",
            "--repository",
            str(repo_root),
            "git",
            "fetch",
            "--remote",
            remote,
            "--branch",
            branch,
        ]
    )
    if proc.returncode != 0:
        write_bounded_backend_output(proc)
        fail(
            f"could not fetch workspace base '{branch}' from remote "
            f"'{remote}' before creating root workspace; for local-only use set "
            "SCHERZO_JJ_WORKSPACE_BASE=@ or SCHERZO_JJ_WORKSPACE_FETCH_BASE=false, "
            "for non-main branches set SCHERZO_JJ_WORKSPACE_BASE_BRANCH, and for "
            "alternate remotes set SCHERZO_JJ_WORKSPACE_REMOTE. Legacy "
            "SCHERZO_PR_REMOTE and SCHERZO_PR_BASE remain supported when the "
            "jj-specific names are absent."
        )


def configured_base_candidates(branch: str, remote: str) -> list[str]:
    return unique_values([f"{branch}@{remote}", branch])


def default_base_candidates(branch: str, remote: str) -> list[str]:
    return unique_values([f"{branch}@{remote}", branch, "main@origin", "main", "@"])


def lexical_absolute(path: Path) -> Path:
    return Path(os.path.abspath(os.path.normpath(str(path))))


def valid_scherzo_core_checkout(root: Path) -> bool:
    return (root / "scripts").is_dir() and (root / ".scherzo" / "workflows").is_dir()


def candidate_core_from_script_path(raw: str) -> Path | None:
    script_path = Path(raw)
    if not script_path.is_absolute():
        script_path = Path.cwd() / script_path
    try:
        resolved = script_path.resolve(strict=True)
    except OSError:
        return None

    candidates: list[Path] = []
    if resolved.parent.name == "scripts":
        candidates.append(resolved.parent.parent)
    candidates.append(resolved.parent)
    for candidate in candidates:
        try:
            root = candidate.resolve(strict=True)
        except OSError:
            continue
        if valid_scherzo_core_checkout(root):
            return root
    return None


def append_valid_core_candidate(candidates: list[Path], candidate: Path) -> None:
    try:
        root = candidate.resolve(strict=True)
    except OSError:
        return
    if not valid_scherzo_core_checkout(root):
        return
    if root not in candidates:
        candidates.append(root)


def core_candidates_from_repo_links() -> list[Path]:
    raw_repo = env_value("SCHERZO_REPO_ROOT")
    if raw_repo is None:
        return []
    try:
        repo_root = Path(raw_repo).resolve(strict=True)
    except OSError:
        return []

    candidates: list[Path] = []
    try:
        scripts_target = (repo_root / "scripts").resolve(strict=True)
    except OSError:
        scripts_target = None
    if scripts_target is not None:
        candidate = (
            scripts_target.parent
            if scripts_target.name == "scripts"
            else scripts_target
        )
        append_valid_core_candidate(candidates, candidate)

    try:
        workflows_target = (
            repo_root / ".scherzo" / "workflows"
        ).resolve(strict=True)
    except OSError:
        workflows_target = None
    if workflows_target is not None and workflows_target.name == "workflows":
        workflows_parent = workflows_target.parent
        if workflows_parent.name == ".scherzo":
            append_valid_core_candidate(candidates, workflows_parent.parent)

    return candidates


def scherzo_core_checkout_for_bridge() -> Path:
    candidates: list[Path] = []
    for env_name in ["SCHERZO_DRIVER_SCRIPT", "SCHERZO_WORKSPACE_DRIVER"]:
        raw = env_value(env_name)
        if raw is None:
            continue
        candidate = candidate_core_from_script_path(raw)
        if candidate is not None:
            append_valid_core_candidate(candidates, candidate)
    for candidate in core_candidates_from_repo_links():
        append_valid_core_candidate(candidates, candidate)
    if candidates:
        return candidates[0]
    fail(
        "portable symlink bridge needed but could not locate a Scherzo core "
        "checkout from SCHERZO_DRIVER_SCRIPT, SCHERZO_WORKSPACE_DRIVER, or "
        "SCHERZO_REPO_ROOT"
    )


def portable_link_uses_bridge(
    workspace_path: Path,
    rel: str,
    suffix: str,
) -> bool:
    link = workspace_path / Path(rel)
    if not link.is_symlink():
        return False
    try:
        raw_target = os.readlink(link)
    except OSError as exc:
        fail(f"portable symlink preflight failed: could not read {link}: {exc}")

    target_path = Path(raw_target)
    target_abs = lexical_absolute(
        target_path if target_path.is_absolute() else link.parent / target_path
    )
    expected_abs = lexical_absolute(
        workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME / Path(suffix)
    )
    uses_bridge = not target_path.is_absolute() and target_abs == expected_abs
    if not uses_bridge and not link.exists():
        fail(
            "portable symlink preflight failed before review lanes: "
            f"{rel} in {workspace_path} is broken; target {raw_target!r} "
            f"resolves to {target_abs}, not expected sibling bridge path "
            f"{expected_abs}"
        )
    return uses_bridge


def portable_bridge_link_rels(workspace_path: Path) -> list[str]:
    rels: list[str] = []
    for rel, suffix in PORTABLE_SCHERZO_LINKS:
        if portable_link_uses_bridge(workspace_path, rel, suffix):
            rels.append(rel)
    return rels


def ensure_scherzo_bridge_path(bridge: Path, core_checkout: Path) -> None:
    if bridge.is_symlink():
        try:
            current = bridge.resolve(strict=True)
        except OSError:
            fail(
                f"portable symlink bridge collision: {bridge} is a broken symlink"
            )
        if current != core_checkout:
            fail(
                "portable symlink bridge collision: "
                f"{bridge} points to {current}, expected {core_checkout}"
            )
        return
    if bridge.exists():
        fail(
            "portable symlink bridge collision: "
            f"{bridge} exists and is not a symlink to {core_checkout}"
        )
    try:
        os.symlink(str(core_checkout), str(bridge), target_is_directory=True)
    except FileExistsError:
        ensure_scherzo_bridge_path(bridge, core_checkout)
    except OSError as exc:
        fail(
            "could not create portable symlink bridge "
            f"{bridge} -> {core_checkout}: {exc}"
        )


def verify_portable_bridge_links(
    workspace_path: Path,
    core_checkout: Path,
    bridge_rels: list[str],
) -> None:
    for rel in bridge_rels:
        link = workspace_path / Path(rel)
        try:
            actual = link.resolve(strict=True)
        except OSError as exc:
            fail(
                "portable symlink preflight failed before review lanes: "
                f"{rel} in {workspace_path} still does not resolve after "
                f"creating/verifying {workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME}: {exc}"
            )
        try:
            expected = (core_checkout / Path(rel)).resolve(strict=True)
        except OSError as exc:
            fail(
                "portable symlink bridge target is not a complete Scherzo core "
                f"checkout: {core_checkout / Path(rel)} is missing: {exc}"
            )
        if actual != expected:
            fail(
                "portable symlink preflight failed before review lanes: "
                f"{rel} in {workspace_path} resolved to {actual}, expected {expected}"
            )


def ensure_portable_scherzo_bridge(workspace_path: Path) -> None:
    bridge_rels = portable_bridge_link_rels(workspace_path)
    if not bridge_rels:
        return
    core_checkout = scherzo_core_checkout_for_bridge()
    bridge = workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME
    ensure_scherzo_bridge_path(bridge, core_checkout)
    verify_portable_bridge_links(workspace_path, core_checkout, bridge_rels)


def first_existing_revision(repo_root: Path, candidates: list[str]) -> str | None:
    for candidate in candidates:
        if revision_exists(repo_root, candidate):
            return candidate
    return None


def workspace_base_revision(repo_root: Path) -> str:
    explicit_base = env_value("SCHERZO_JJ_WORKSPACE_BASE")
    if explicit_base is not None:
        if not revision_exists(repo_root, explicit_base):
            fail(f"SCHERZO_JJ_WORKSPACE_BASE does not resolve in repo: {explicit_base}")
        return explicit_base

    branch = selected_workspace_base_branch()
    remote = selected_workspace_base_remote()
    configured = base_selection_was_configured()
    candidates = configured_base_candidates(branch, remote) if configured else default_base_candidates(branch, remote)
    revision = first_existing_revision(repo_root, candidates)
    if revision is not None:
        return revision
    if configured:
        tried = ", ".join(configured_base_candidates(branch, remote))
        fail(
            f"configured workspace base did not resolve for branch '{branch}' "
            f"from remote '{remote}'; tried {tried}. Set "
            "SCHERZO_JJ_WORKSPACE_BASE to an explicit local revision, use "
            "SCHERZO_JJ_WORKSPACE_BASE_BRANCH and SCHERZO_JJ_WORKSPACE_REMOTE "
            "for jj-specific base policy, or update legacy SCHERZO_PR_BASE and "
            "SCHERZO_PR_REMOTE."
        )
    fail("could not resolve any default workspace base candidate: main@origin, main, @")


def prepare_destination_for_workspace_add(workspace_path: Path) -> Path:
    workspace_parent = workspace_path.parent
    try:
        workspace_parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(f"could not create workspace parent: {workspace_parent}: {exc}")
    if workspace_path.is_dir():
        try:
            workspace_path.rmdir()
        except OSError:
            fail(f"workspace path exists and is not empty before jj workspace add: {workspace_path}")
    return workspace_parent


def run_jj_root(workspace_path: Path) -> str:
    proc = run_backend_proc(["jj", "root"], cwd=workspace_path)
    if proc.returncode != 0:
        write_bounded_backend_output(proc)
        fail("jj root failed")
    return proc.stdout.strip()


def verify_current_workspace(workspace_path: Path) -> None:
    if not (workspace_path / ".jj").exists():
        fail(f"workspace is missing .jj: {workspace_path}")
    if run_jj_root(workspace_path) != str(workspace_path):
        fail("jj root does not match workspace path")

    current_root = run_jj_root(workspace_path)
    if current_root != str(workspace_path):
        fail(f"jj root does not match workspace path: expected {workspace_path}, got {current_root}")

    ensure_portable_scherzo_bridge(workspace_path)

    status = run_backend_stream(["jj", "status", "--color=never"], cwd=workspace_path)
    if status != 0:
        fail("jj status failed")


def allow_trusted_envrc_after_create(workspace_path: Path) -> None:
    if not (workspace_path / ".envrc").is_file():
        return
    if shutil.which("direnv") is None:
        fail(".envrc exists but direnv is not installed in workspace setup environment")
    proc = run_backend_proc(["direnv", "allow", "."], cwd=workspace_path)
    if proc.returncode != 0:
        write_bounded_backend_output(proc)
        print(
            f"scherzo-workspace-jj: warning: direnv allow failed for workspace: {workspace_path}",
            file=sys.stderr,
        )


def add_workspace(args: list[str], workspace_parent: Path) -> None:
    status = run_backend_stream(args, cwd=workspace_parent)
    if status != 0:
        fail("jj workspace add failed")


def lifecycle_create() -> None:
    workspace_path = lifecycle_workspace_path()
    repo_root = infer_repo_root(workspace_path)
    require_jj_repo_root(repo_root)

    if (workspace_path / ".jj").is_dir():
        verify_current_workspace(workspace_path)
        return

    source_workspace = env_value("SCHERZO_SOURCE_WORKSPACE_PATH")
    explicit_base = env_value("SCHERZO_JJ_WORKSPACE_BASE")
    if source_workspace is None and explicit_base is None:
        branch = selected_workspace_base_branch()
        remote = selected_workspace_base_remote()
        if fetch_base_enabled():
            fetch_workspace_base(repo_root, branch, remote)

    workspace_parent = prepare_destination_for_workspace_add(workspace_path)
    workspace_name = lifecycle_workspace_name(workspace_path)
    if source_workspace:
        source_path = resolve_dir_or_raw(source_workspace)
        if not (source_path / ".jj").is_dir():
            fail(f"source workspace is missing .jj: {source_path}")
        add_workspace(
            [
                "jj",
                "--repository",
                str(source_path),
                "workspace",
                "add",
                "--name",
                workspace_name,
                "--revision",
                "@",
                "--sparse-patterns",
                "full",
                str(workspace_path),
            ],
            workspace_parent,
        )
    else:
        base_revision = workspace_base_revision(repo_root)
        add_workspace(
            [
                "jj",
                "--repository",
                str(repo_root),
                "workspace",
                "add",
                "--name",
                workspace_name,
                "--revision",
                base_revision,
                "--sparse-patterns",
                "full",
                str(workspace_path),
            ],
            workspace_parent,
        )

    verify_current_workspace(workspace_path)
    allow_trusted_envrc_after_create(workspace_path)


def forget_workspace_at(target: Path) -> None:
    if not target.is_dir():
        return
    root_proc = run_backend_proc(["jj", "root"], cwd=target)
    if root_proc.returncode != 0:
        return
    status = run_backend_stream(["jj", "workspace", "forget"], cwd=target)
    if status != 0:
        fail(f"could not forget jj workspace: {target}")


def forget_workspace_children(base: Path) -> None:
    if not base.is_dir():
        return
    for target in sorted(base.iterdir()):
        if target.is_symlink():
            continue
        if target.is_dir() and (target / ".jj").is_dir():
            forget_workspace_at(target)


def forget_run_workspaces(workspace_path: Path, run_root: Path | None) -> None:
    if run_root is not None:
        forget_workspace_children(run_root / "workspaces")
        return
    if (workspace_path / "workspaces").is_dir():
        forget_workspace_children(workspace_path / "workspaces")
        return
    if (workspace_path / ".jj").is_dir():
        forget_workspace_at(workspace_path)


def remove_workspace_directory(workspace_path: Path, run_root: Path | None) -> None:
    if run_root is None or not workspace_path.exists():
        return
    try:
        shutil.rmtree(workspace_path)
    except OSError as exc:
        fail(f"could not remove workspace directory: {workspace_path}: {exc}")


def lifecycle_remove() -> None:
    require_explicit_workspace_path("remove")
    workspace_path = lifecycle_workspace_path()
    run_root = lifecycle_run_root()
    validate_remove_target(workspace_path, run_root)
    if shutil.which("jj") is None:
        return
    forget_run_workspaces(workspace_path, run_root)
    remove_workspace_directory(workspace_path, run_root)


def lifecycle(args: list[str]) -> None:
    if len(args) != 1:
        usage_error("lifecycle requires one operation")
    operation = args[0]
    if operation == "create":
        lifecycle_create()
        return
    if operation == "before-step":
        verify_current_workspace(lifecycle_workspace_path())
        return
    if operation == "after-step":
        return
    if operation == "remove":
        lifecycle_remove()
        return
    usage_error(f"unsupported lifecycle operation: {operation}")


def ensure_workspace(root: Path) -> None:
    if not root.is_dir():
        fail("workspace directory does not exist")


def run_jj_stream(root: Path, args: list[str]) -> None:
    ensure_workspace(root)
    try:
        status = subprocess.call(["jj", *args], cwd=str(root))
    except FileNotFoundError:
        fail("jj executable not found")
    raise SystemExit(0 if status == 0 else 1)


def run_jj_proc(root: Path, args: list[str]) -> subprocess.CompletedProcess[str]:
    ensure_workspace(root)
    try:
        return subprocess.run(
            ["jj", *args],
            cwd=str(root),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError:
        fail("jj executable not found")


def run_jj_capture(root: Path, args: list[str]) -> str:
    completed = run_jj_proc(root, args)
    if completed.returncode != 0:
        if completed.stderr:
            sys.stderr.write(completed.stderr[:4000])
            if not completed.stderr.endswith("\n"):
                sys.stderr.write("\n")
        fail("jj command failed")
    return completed.stdout


def run_jj_capture_json(root: Path, args: list[str], failure_code: str) -> str:
    completed = run_jj_proc(root, args)
    if completed.returncode != 0:
        message = (completed.stderr or completed.stdout or "jj command failed").strip()
        json_failure(
            status="command_failed",
            failure_code=failure_code,
            message=message[:4000] or "jj command failed",
        )
    return completed.stdout


def clean_lines(output: str) -> list[str]:
    values: list[str] = []
    seen: set[str] = set()
    for line in output.splitlines():
        path = line.rstrip("\r").strip()
        if path and path not in seen:
            values.append(path)
            seen.add(path)
    return values


def changed_paths(root: Path) -> list[str]:
    # Use jj's current-change diff instead of an explicit @-..@ range. Merge
    # resolution workspaces have two parents, so @- is ambiguous there.
    output = run_jj_capture(root, ["diff", "--name-only", "--color=never"])
    return sorted(clean_lines(output))


def parse_rename_summary_paths(rest: str) -> tuple[str, str]:
    text = rest.strip()
    if " -> " in text:
        old_path, new_path = text.split(" -> ", 1)
        return old_path.strip(), new_path.strip()

    brace_start = text.find("{")
    if brace_start >= 0:
        brace_end = text.find("}", brace_start + 1)
        if brace_end >= 0:
            inside = text[brace_start + 1 : brace_end]
            if "=>" in inside:
                old_part, new_part = inside.split("=>", 1)
                prefix = text[:brace_start]
                suffix = text[brace_end + 1 :]
                old_path = prefix + old_part.strip() + suffix
                new_path = prefix + new_part.strip() + suffix
                return old_path.strip(), new_path.strip()

    if "=>" in text:
        old_path, new_path = text.split("=>", 1)
        return old_path.strip("{} "), new_path.strip("{} ")

    return "", text


def parse_summary_records(summary: str) -> dict[str, dict[str, str]]:
    records: dict[str, dict[str, str]] = {}
    for raw_line in summary.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        parts = line.split(maxsplit=1)
        if len(parts) != 2:
            continue
        token, rest = parts[0], parts[1].strip()
        status = STATUS_MAP.get(token[:1], "modified")
        record: dict[str, str]
        if status == "renamed":
            old_path, new_path = parse_rename_summary_paths(rest)
            record = {"path": new_path.strip(), "status": "renamed"}
            if old_path.strip():
                record["old_path"] = old_path.strip()
        else:
            record = {"path": rest, "status": status}
        path = record.get("path", "").strip()
        if path:
            records[path] = record
    return records


def changed_file_records(root: Path) -> list[dict[str, str]]:
    paths = changed_paths(root)
    summary_proc = run_jj_proc(root, ["diff", "--summary", "--color=never"])
    summary_records = (
        parse_summary_records(summary_proc.stdout) if summary_proc.returncode == 0 else {}
    )
    records: list[dict[str, str]] = []
    seen: set[str] = set()
    for path in paths:
        record = summary_records.get(path, {"path": path, "status": "modified"})
        records.append(record)
        seen.add(path)
    for path, record in summary_records.items():
        if path not in seen:
            records.append(record)
    records.sort(key=lambda record: record.get("path", ""))
    return records


def print_changed_files_json(root: Path) -> None:
    json_dump({"version": 1, "files": changed_file_records(root)})


def assert_only(root: Path, target: str) -> None:
    files = [record["path"] for record in changed_file_records(root)]
    if files == [target]:
        return
    actual = ", ".join(files) if files else "none"
    print(
        f"scherzo-workspace-jj: expected only {target}; actual changed files: {actual}",
        file=sys.stderr,
    )
    raise SystemExit(1)


def revision_value(root: Path, revision: str, template: str, *, default: str = "") -> str:
    proc = run_jj_proc(
        root,
        ["log", "-r", revision, "--no-graph", "-T", template, "--color=never"],
    )
    if proc.returncode != 0:
        return default
    return proc.stdout.strip() or default


def revision_commit_ids(root: Path, revision: str) -> list[str] | None:
    proc = run_jj_proc(
        root,
        ["log", "-r", revision, "--no-graph", "-T", "commit_id ++ \"\\n\"", "--color=never"],
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    return clean_lines(proc.stdout)


def current_parent_commit_ids(root: Path) -> list[str]:
    return revision_commit_ids(root, "@-") or []


def has_unresolved_conflicts(root: Path, revision: str = "@") -> bool:
    proc = run_jj_proc(
        root,
        [
            "log",
            "-r",
            f"conflicts() & ({revision})",
            "--no-graph",
            "-T",
            "change_id.short()",
            "--color=never",
        ],
    )
    return proc.returncode == 0 and bool(proc.stdout.strip())


def normalize_conflict_file_path(value: str) -> str:
    return re.sub(r"\s+\d+-sided conflict(?:\s+.*)?$", "", value.strip())


def conflict_files(root: Path) -> list[str]:
    proc = run_jj_proc(root, ["resolve", "--list", "--color=never"])
    if proc.returncode == 0:
        return sorted(
            path
            for path in [normalize_conflict_file_path(line) for line in proc.stdout.splitlines()]
            if path
        )
    if "No conflicts found" in proc.stdout or "No conflicts found" in proc.stderr:
        return []
    return []


def baseline_json(root: Path) -> None:
    records = changed_file_records(root)
    json_dump({
        "version": 1,
        "baseline_id": revision_value(root, "@-", "change_id", default="unknown-baseline"),
        "workspace_revision_id": revision_value(root, "@", "commit_id", default="unknown-revision"),
        "change_id": revision_value(root, "@", "change_id.short()", default="unknown-change"),
        "dirty": bool(records),
    })


def diff_json(root: Path) -> None:
    text = run_jj_capture_json(
        root,
        ["diff", "--git", "--color=never"],
        "diff_failed",
    )
    json_dump({"version": 1, "format": "unified", "text": text, "truncated": False})


def configured_base_ref() -> tuple[str, str, str]:
    base = selected_workspace_base_branch()
    remote = selected_workspace_base_remote()
    return base, remote, f"{base}@{remote}"


def parse_refresh_args(args: list[str]) -> tuple[str, str | None]:
    stage: str | None = None
    target: str | None = None
    saw_json = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--stage" and index + 1 < len(args):
            stage = args[index + 1]
            index += 2
        elif arg == "--target" and index + 1 < len(args):
            target = args[index + 1]
            index += 2
        elif arg == "--json":
            saw_json = True
            index += 1
        else:
            usage_error(f"unsupported refresh-base argument: {arg}")
    if not saw_json:
        usage_error("refresh-base requires --json")
    if not stage or not REFRESH_STAGE_RE.fullmatch(stage):
        usage_error("refresh-base requires safe --stage <stage>")
    if target is not None and target.strip() == "":
        usage_error("refresh-base --target must not be empty")
    return stage, target


def fetch_ref(root: Path, base: str, remote: str) -> tuple[bool, str]:
    proc = run_jj_proc(root, ["git", "fetch", "--remote", remote, "--branch", base])
    text = (proc.stderr or proc.stdout or "").strip()
    return proc.returncode == 0, text


def refresh_base(root: Path, args: list[str]) -> None:
    stage, target = parse_refresh_args(args)
    fetch_enabled = fetch_base_enabled()
    base, remote, remote_base = configured_base_ref()
    base_ref = base
    base_revision = remote_base
    before_revision = revision_value(root, "@", "commit_id", default="unknown-before")

    if target:
        base_ref = target
        base_revision = target
        if fetch_enabled and "@" in target:
            branch, target_remote = target.rsplit("@", 1)
            if branch and target_remote:
                ok, message = fetch_ref(root, branch, target_remote)
                if not ok:
                    json_failure(
                        status="fetch_failed",
                        failure_code="fetch_failed",
                        message=message or f"could not fetch {target}",
                        stage=stage,
                        base_ref=base_ref,
                        base_revision=base_revision,
                        before_revision=before_revision,
                        after_revision=before_revision,
                        conflict_files=[],
                    )
    else:
        if fetch_enabled:
            ok, message = fetch_ref(root, base, remote)
            if not ok:
                json_failure(
                    status="fetch_failed",
                    failure_code="fetch_failed",
                    message=message or f"could not fetch {base} from {remote}",
                    stage=stage,
                    base_ref=base_ref,
                    base_revision=base_revision,
                    before_revision=before_revision,
                    after_revision=before_revision,
                    conflict_files=conflict_files(root),
                )
        if revision_commit_ids(root, remote_base) is None:
            if revision_commit_ids(root, base) is None:
                json_failure(
                    status="base_not_found",
                    failure_code="base_not_found",
                    message=f"could not find base revision {remote_base} or {base}",
                    stage=stage,
                    base_ref=base_ref,
                    base_revision=remote_base,
                    before_revision=before_revision,
                    after_revision=before_revision,
                    conflict_files=conflict_files(root),
                )
            base_revision = base

    base_commits = revision_commit_ids(root, base_revision)
    if base_commits is None:
        json_failure(
            status="base_not_found",
            failure_code="base_not_found",
            message=f"could not find base revision {base_revision}",
            stage=stage,
            base_ref=base_ref,
            base_revision=base_revision,
            before_revision=before_revision,
            after_revision=before_revision,
            conflict_files=conflict_files(root),
        )

    parent_commits = current_parent_commit_ids(root)
    if len(base_commits) == 1 and parent_commits == base_commits:
        json_dump({
            "version": 1,
            "status": "fresh",
            "stage": stage,
            "base_ref": base_ref,
            "base_revision": base_revision,
            "before_revision": before_revision,
            "after_revision": revision_value(root, "@", "commit_id", default=before_revision),
            "conflict_files": [],
        })
        return

    proc = run_jj_proc(root, ["rebase", "-r", "@", "-d", base_revision, "--color=never"])
    files = conflict_files(root) if has_unresolved_conflicts(root) else []
    after_revision = revision_value(root, "@", "commit_id", default=before_revision)
    if files:
        json_failure(
            status="conflicts",
            failure_code="conflicts",
            message="refresh-base left unresolved conflicts",
            exit_code=20,
            stage=stage,
            base_ref=base_ref,
            base_revision=base_revision,
            before_revision=before_revision,
            after_revision=after_revision,
            conflict_files=files,
        )
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout or "could not rebase workspace").strip()
        json_failure(
            status="rebase_failed",
            failure_code="rebase_failed",
            message=message[:4000],
            stage=stage,
            base_ref=base_ref,
            base_revision=base_revision,
            before_revision=before_revision,
            after_revision=after_revision,
            conflict_files=[],
        )
    json_dump({
        "version": 1,
        "status": "rebased_clean",
        "stage": stage,
        "base_ref": base_ref,
        "base_revision": base_revision,
        "before_revision": before_revision,
        "after_revision": after_revision,
        "conflict_files": [],
    })


def parse_publish_args(args: list[str]) -> dict[str, str]:
    values: dict[str, str] = {"allow-no-changes": "false"}
    saw_json = False
    with_value = {
        "--kind",
        "--title-file",
        "--body-file",
        "--branch-prefix",
        "--base",
        "--target-branch",
        "--target-pr",
        "--allow-no-changes",
    }
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--json":
            saw_json = True
            index += 1
        elif arg in with_value and index + 1 < len(args):
            values[arg[2:]] = args[index + 1]
            index += 2
        else:
            usage_error(f"unsupported publish-change argument: {arg}")
    for key in ["kind", "title-file", "body-file", "branch-prefix", "base"]:
        if not values.get(key):
            usage_error(f"publish-change requires --{key}")
    if not saw_json:
        usage_error("publish-change requires --json")
    if values.get("allow-no-changes") not in {"true", "false"}:
        usage_error("--allow-no-changes must be true or false")
    if not PUBLISH_KIND_RE.match(values["kind"]):
        usage_error("publish-change --kind must be a lowercase token containing letters, numbers, and hyphens")
    return values


def sanitize_ref_part(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-._")
    return value or "change"


def read_required_file(path: str, label: str) -> str:
    relative = validate_relative_path(path, usage_label=label)
    full = capability_root() / relative
    try:
        return full.read_text(encoding="utf-8")
    except OSError as exc:
        usage_error(f"could not read {label}: {exc}")


def remote_url(root: Path, remote: str) -> str | None:
    proc = run_jj_proc(root, ["git", "remote", "list", "--color=never"])
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == remote:
            return parts[1]
    return None


def owner_repo_from_url(url: str) -> str | None:
    if url.startswith("https://github.com/"):
        value = url.removeprefix("https://github.com/")
    elif url.startswith("git@github.com:"):
        value = url.removeprefix("git@github.com:")
    elif url.startswith("ssh://git@github.com/"):
        value = url.removeprefix("ssh://git@github.com/")
    else:
        return None
    value = value.removesuffix(".git")
    parts = value.split("/")
    if len(parts) >= 2 and parts[0] and parts[1]:
        return f"{parts[0]}/{parts[1]}"
    return None


def default_repo(root: Path, remote: str) -> str:
    explicit = env_value("SCHERZO_PR_REPO")
    if explicit:
        return explicit
    url = remote_url(root, remote)
    if not url:
        json_failure(status="invalid_request", failure_code="repo_not_found", message=f"could not find jj git remote: {remote}")
    repo = owner_repo_from_url(url)
    if not repo:
        json_failure(status="invalid_request", failure_code="repo_not_found", message=f"could not infer GitHub owner/repo from remote URL: {url}")
    return repo


def run_capture(args: list[str], root: Path) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            cwd=str(root),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError:
        json_failure(status="invalid_request", failure_code="command_not_found", message=f"required command not found: {args[0]}")


def publish_change(root: Path, args: list[str]) -> None:
    values = parse_publish_args(args)
    draft = pr_draft_setting()
    title = read_required_file(values["title-file"], "title-file").strip().splitlines()
    title_text = title[0].strip() if title else "Scherzo change"
    _body = read_required_file(values["body-file"], "body-file")
    records = changed_file_records(root)
    allow_no_changes = values["allow-no-changes"] == "true"
    base = values["base"]
    remote = selected_publication_remote()
    repo = default_repo(root, remote)

    if not records and allow_no_changes:
        branch = values.get("target-branch") or ""
        url = ""
        if values.get("target-pr"):
            proc = run_capture(
                ["gh", "pr", "view", values["target-pr"], "--repo", repo, "--json", "url", "--jq", ".url"],
                root,
            )
            url = proc.stdout.strip() if proc.returncode == 0 else ""
        json_dump({
            "version": 1,
            "status": "unchanged",
            "url": url,
            "branch": branch,
            "base_ref": base,
            "base_revision": base,
            "head_revision": revision_value(root, "@", "commit_id", default=""),
            "change_id": revision_value(root, "@", "change_id.short()", default=""),
            "created": False,
            "updated": False,
        })
        return
    if not records:
        json_failure(status="nothing_to_publish", failure_code="nothing_to_publish", message="no changed files to publish")

    change_id = revision_value(root, "@", "change_id.short()", default="change")
    branch = values.get("target-branch") or f"{values['branch-prefix'].rstrip('/')}/{sanitize_ref_part(title_text)[:60]}-{change_id}"
    describe = run_jj_proc(root, ["describe", "-m", title_text])
    if describe.returncode != 0:
        json_failure(status="publication_failed", failure_code="describe_failed", message=(describe.stderr or describe.stdout or "jj describe failed").strip())
    bookmark_args = ["bookmark", "set"]
    if values.get("target-branch"):
        # Merge-conflict resolution publishes intentionally retarget an existing
        # PR branch. Ensure jj treats the selected remote bookmark as the
        # tracking source, then allow replacing stale local resolver bookmarks.
        # The subsequent git push remains non-force and remote fast-forward-safe.
        track = run_jj_proc(root, ["bookmark", "track", branch, f"--remote={remote}"])
        if track.returncode != 0:
            json_failure(
                status="publication_failed",
                failure_code="bookmark_track_failed",
                message=(track.stderr or track.stdout or "jj bookmark track failed").strip(),
            )
        bookmark_args.append("--allow-backwards")
    bookmark_args.extend([branch, "--revision", "@"])
    bookmark = run_jj_proc(root, bookmark_args)
    if bookmark.returncode != 0:
        json_failure(status="publication_failed", failure_code="bookmark_failed", message=(bookmark.stderr or bookmark.stdout or "jj bookmark failed").strip())
    push_args = ["git", "push", "--remote", remote, "--bookmark", branch]
    if not values.get("target-branch"):
        push_args.append("--allow-new")
    push = run_jj_proc(root, push_args)
    if push.returncode != 0:
        json_failure(status="remote_rejected", failure_code="push_failed", message=(push.stderr or push.stdout or "jj git push failed").strip())

    pr_url = ""
    created = False
    updated = bool(values.get("target-branch") or values.get("target-pr"))
    if values.get("target-pr"):
        view = run_capture(["gh", "pr", "view", values["target-pr"], "--repo", repo, "--json", "url", "--jq", ".url"], root)
        if view.returncode == 0:
            pr_url = view.stdout.strip()
    if not pr_url:
        view = run_capture(["gh", "pr", "view", branch, "--repo", repo, "--json", "url", "--jq", ".url"], root)
        if view.returncode == 0:
            pr_url = view.stdout.strip()
    if not pr_url and not values.get("target-pr"):
        gh_base = base.split("@", 1)[0]
        create_args = [
            "gh",
            "pr",
            "create",
            "--repo",
            repo,
            "--base",
            gh_base,
            "--head",
            branch,
            "--title",
            title_text,
            "--body-file",
            values["body-file"],
        ]
        if draft is True:
            create_args.append("--draft")
        create = run_capture(
            create_args,
            root,
        )
        if create.returncode == 0:
            pr_url = create.stdout.strip()
            created = True
            updated = False
    if not pr_url:
        json_failure(status="publication_failed", failure_code="pr_url_missing", message=f"failed to create or locate hosted review URL for {branch}")

    json_dump({
        "version": 1,
        "status": "published" if created else "updated",
        "url": pr_url,
        "branch": branch,
        "base_ref": base,
        "base_revision": base,
        "head_revision": revision_value(root, "@", "commit_id", default=""),
        "change_id": change_id,
        "created": created,
        "updated": updated,
    })


def main(argv: list[str]) -> None:
    if not argv:
        usage_error()
    command, rest = argv[0], argv[1:]
    if command == "describe":
        if rest != ["--json"]:
            usage_error("describe requires --json")
        describe_json()
        return

    if command == "lifecycle":
        lifecycle(rest)
        return

    root = capability_root()

    if command == "status":
        if rest != ["--human"]:
            usage_error("status requires --human")
        run_jj_stream(root, ["status", "--color=never"])
        return

    if command == "diff":
        if rest == ["--human"]:
            run_jj_stream(root, ["diff", "--color=never"])
            return
        if rest == ["--json"]:
            diff_json(root)
            return
        usage_error("diff requires --human or --json")

    if command == "changed-files":
        if rest != ["--json"]:
            usage_error("changed-files requires --json")
        print_changed_files_json(root)
        return

    if command == "baseline":
        if rest != ["--json"]:
            usage_error("baseline requires --json")
        baseline_json(root)
        return

    if command == "refresh-base":
        refresh_base(root, rest)
        return

    if command == "publish-change":
        publish_change(root, rest)
        return

    if command == "assert-only":
        target = parse_path_argument(rest)
        assert_only(root, target)
        return

    usage_error(f"unsupported command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])
PY
