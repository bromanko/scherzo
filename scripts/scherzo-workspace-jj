#!/usr/bin/env python3
from __future__ import annotations

import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from typing import NoReturn

USAGE = """Usage:
  scherzo-workspace-jj describe --json
  scherzo-workspace-jj lifecycle <create|before-step|after-step|remove>
  scherzo-workspace-jj status --human
  scherzo-workspace-jj diff --human
  scherzo-workspace-jj diff --json
  scherzo-workspace-jj changed-files --json
  scherzo-workspace-jj baseline --json
  scherzo-workspace-jj refresh-base --stage <stage> [--target <driver-ref>] --json
  scherzo-workspace-jj publish-commit-stack --kind <kind> --title-file <path> --body-file <path> --branch-prefix <prefix> --base <driver-ref> [--target-branch <branch>] [--target-pr <number>] [--expected-head <sha>] [--allow-no-changes <true|false>] --json
  scherzo-workspace-jj assert-only --path <relative-file>
"""

WINDOWS_ABSOLUTE_RE = re.compile(r"^[A-Za-z]:[\\/]")
REFRESH_STAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
PUBLISH_KIND_RE = re.compile(r"^[a-z][a-z0-9-]*$")
EXPECTED_HEAD_RE = re.compile(r"[0-9a-f]{40}")
STATUS_MAP = {
    "A": "added",
    "M": "modified",
    "D": "deleted",
    "R": "renamed",
    "C": "modified",
}
PORTABLE_SCHERZO_BRIDGE_NAME = "scherzo"
PUBLISH_CHANGE_MIGRATION_DOC = "docs/runbooks/workspace-driver-migration.md#migrating-from-publish-change-to-publish-commit-stack"
PUBLISH_CHANGE_MIGRATION_MESSAGE = (
    "publish-change was removed; use publish-commit-stack for same-repo "
    "commit_stack publication and update custom drivers to advertise and "
    f"implement publish-commit-stack. See {PUBLISH_CHANGE_MIGRATION_DOC}."
)
PORTABLE_SCHERZO_LINKS = [
    ("scripts", "scripts"),
    (".scherzo/workflows", ".scherzo/workflows"),
]
DEFAULT_BASE_CANDIDATES = ["main@origin", "main", "@"]
OUTPUT_TEXT_LIMIT = 4000
ERROR_CHANNEL_HUMAN = "human"
ERROR_CHANNEL_JSON = "json"


class ConflictFilesListFailed(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


def usage_error(message: str | None = None) -> NoReturn:
    if message:
        print(f"scherzo-workspace-jj: {message}", file=sys.stderr)
    print(USAGE, file=sys.stderr, end="")
    raise SystemExit(2)


def fail(message: str) -> NoReturn:
    print(f"scherzo-workspace-jj: {message}", file=sys.stderr)
    raise SystemExit(1)


def json_dump(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def describe_json() -> None:
    json_dump({
        "version": 1,
        "capabilities": [
            "status",
            "diff",
            "changed-files",
            "assert-only",
            "baseline",
            "refresh-base",
            "publish-commit-stack",
        ],
    })


def json_failure(
    *,
    status: str,
    failure_code: str,
    message: str,
    exit_code: int = 1,
    **extra: object,
) -> NoReturn:
    payload: dict[str, object] = {
        "version": 1,
        "status": status,
        "failure_code": failure_code,
        "message": message,
    }
    payload.update(extra)
    json_dump(payload)
    raise SystemExit(exit_code)


def invalid_configuration(message: str, *, error_channel: str) -> NoReturn:
    if error_channel == ERROR_CHANNEL_JSON:
        json_failure(
            status="invalid_request",
            failure_code="invalid_configuration",
            message=message,
        )
    fail(message)


def legacy_publish_change_command(args: list[str]) -> None:
    if "--json" in args:
        json_failure(
            status="invalid_request",
            failure_code="legacy_publish_change_removed",
            message=PUBLISH_CHANGE_MIGRATION_MESSAGE,
            exit_code=2,
            legacy_command="publish-change",
            replacement_command="publish-commit-stack",
            migration_doc=PUBLISH_CHANGE_MIGRATION_DOC,
        )
    usage_error(PUBLISH_CHANGE_MIGRATION_MESSAGE)


def env_value(name: str) -> str | None:
    value = os.environ.get(name)
    if value is None:
        return None
    value = value.strip()
    return value or None


def env_is_present(name: str) -> bool:
    return env_value(name) is not None


def selected_workspace_base_branch() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_BASE_BRANCH") or "main"


def selected_workspace_base_remote() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_REMOTE") or "origin"


def selected_publication_remote() -> str:
    return env_value("SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE") or "origin"


def reject_legacy_publication_remote_without_canonical() -> None:
    if env_is_present("SCHERZO_PR_REMOTE") and not env_is_present(
        "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE"
    ):
        json_failure(
            status="configuration_error",
            failure_code="legacy_publication_remote_unsupported",
            message=(
                "SCHERZO_PR_REMOTE is no longer a jj driver publication remote; "
                "set SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE for publish-commit-stack, "
                "or unset SCHERZO_PR_REMOTE to use origin"
            ),
            legacy_env="SCHERZO_PR_REMOTE",
            canonical_env="SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE",
        )


def base_selection_was_configured() -> bool:
    return any(
        env_is_present(name)
        for name in [
            "SCHERZO_JJ_WORKSPACE_REMOTE",
            "SCHERZO_JJ_WORKSPACE_BASE_BRANCH",
        ]
    )


def fetch_base_enabled(*, error_channel: str) -> bool:
    value = env_value("SCHERZO_JJ_WORKSPACE_FETCH_BASE")
    if value is None or value == "true":
        return True
    if value == "false":
        return False
    invalid_configuration(
        "SCHERZO_JJ_WORKSPACE_FETCH_BASE must be true or false",
        error_channel=error_channel,
    )


def pr_draft_setting() -> bool:
    value = env_value("SCHERZO_PR_DRAFT")
    if value is None:
        return False
    if value == "true":
        return True
    if value == "false":
        return False
    invalid_configuration(
        "SCHERZO_PR_DRAFT must be true or false",
        error_channel=ERROR_CHANNEL_JSON,
    )


def unique_values(values: list[str]) -> list[str]:
    unique: list[str] = []
    for value in values:
        if value not in unique:
            unique.append(value)
    return unique


def safe_resolve(raw: str) -> Path:
    try:
        return Path(raw).resolve(strict=False)
    except OSError as exc:
        fail(f"could not resolve workspace path: {exc}")


def capability_root() -> Path:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw:
        return safe_resolve(raw)
    try:
        return Path.cwd().resolve(strict=False)
    except OSError as exc:
        fail(f"could not resolve current workspace: {exc}")


def validate_relative_path(value: str, *, usage_label: str = "path") -> str:
    if value == "":
        usage_error(f"{usage_label} must not be empty")
    if value == ".":
        usage_error(f"{usage_label} must name a file, not .")
    if Path(value).is_absolute() or WINDOWS_ABSOLUTE_RE.match(value):
        usage_error(f"{usage_label} must be relative to the workspace root")
    segments = value.replace("\\", "/").split("/")
    if any(segment == ".." for segment in segments):
        usage_error(f"{usage_label} must not contain .. segments")
    return value


def parse_path_argument(args: list[str]) -> str:
    if len(args) != 2 or args[0] != "--path":
        usage_error("assert-only requires --path <relative-file>")
    return validate_relative_path(args[1], usage_label="assert-only path")


def require_explicit_workspace_path(operation: str) -> None:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw is None or raw == "":
        usage_error(f"SCHERZO_WORKSPACE_PATH is required for lifecycle {operation}")


def resolve_existing_dir(raw: str, label: str) -> Path:
    try:
        path = Path(raw).resolve(strict=True)
    except OSError as exc:
        fail(f"could not resolve {label}: {exc}")
    if not path.is_dir():
        fail(f"{label} is not a directory: {path}")
    return path


def resolve_dir_or_raw(raw: str) -> Path:
    path = Path(raw)
    try:
        if path.is_dir():
            return path.resolve(strict=True)
    except OSError:
        pass
    return path.resolve(strict=False)


def lifecycle_workspace_path() -> Path:
    raw = os.environ.get("SCHERZO_WORKSPACE_PATH")
    if raw:
        return resolve_dir_or_raw(raw)
    try:
        return Path.cwd().resolve(strict=True)
    except OSError as exc:
        fail(f"could not resolve current workspace: {exc}")


def lifecycle_run_root() -> Path | None:
    raw = os.environ.get("SCHERZO_RUN_ROOT")
    if not raw:
        return None
    return resolve_dir_or_raw(raw)


def contained_by(child: Path, parent: Path) -> bool:
    try:
        child_text = str(child.resolve(strict=False))
        parent_text = str(parent.resolve(strict=False))
        return (
            child_text != parent_text
            and os.path.commonpath([child_text, parent_text]) == parent_text
        )
    except (OSError, ValueError):
        return False


def validate_remove_target(workspace_path: Path, run_root: Path | None) -> None:
    if workspace_path.parent == workspace_path:
        usage_error("refusing filesystem root as workspace path")
    if run_root is not None and not contained_by(workspace_path, run_root):
        usage_error("refusing to remove workspace outside SCHERZO_RUN_ROOT")


def infer_repo_root(workspace_path: Path) -> Path:
    raw_repo = os.environ.get("SCHERZO_REPO_ROOT")
    if raw_repo:
        return resolve_existing_dir(raw_repo, "repo root")

    raw_config = os.environ.get("SCHERZO_CONFIG_DIR")
    if raw_config:
        config_dir = resolve_existing_dir(raw_config, "config directory")
        return resolve_existing_dir(str(config_dir.parent), "repo root")

    candidate = workspace_path
    while True:
        try:
            if (candidate / ".jj").is_dir():
                return resolve_existing_dir(str(candidate), "repo root")
        except OSError:
            pass
        if candidate.parent == candidate:
            break
        candidate = candidate.parent
    fail("could not infer repo root from workspace path; set SCHERZO_REPO_ROOT")


def sanitize_workspace_key(value: str) -> str:
    sanitized = re.sub(r"[^A-Za-z0-9_.-]+", "-", value)
    sanitized = re.sub(r"-+", "-", sanitized).strip("-")
    return sanitized


def lifecycle_workspace_name(workspace_path: Path) -> str:
    workflow = os.environ.get("SCHERZO_WORKFLOW_ID") or "workflow"
    issue_key = sanitize_workspace_key(os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "issue")) or "issue"
    run_key = sanitize_workspace_key(os.environ.get("SCHERZO_RUN_ID", "run")) or "run"
    logical = os.environ.get("SCHERZO_WORKSPACE_NAME") or workspace_path.name
    logical_key = sanitize_workspace_key(logical) or "workspace"
    return f"scherzo-{workflow}-{issue_key}-{run_key}-{logical_key}"


def timeout_output_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def missing_command(args: list[str], *, error_channel: str, human_message: str | None = None) -> NoReturn:
    message = human_message or f"required command not found: {args[0]}"
    if error_channel == ERROR_CHANNEL_JSON:
        json_failure(
            status="invalid_request",
            failure_code="command_not_found",
            message=f"required command not found: {args[0]}",
        )
    fail(message)


def run_command(
    args: list[str],
    *,
    cwd: Path | None = None,
    capture: bool = True,
    timeout: float | None = None,
    error_channel: str = ERROR_CHANNEL_HUMAN,
    missing_command_message: str | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            cwd=str(cwd) if cwd is not None else None,
            text=True,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        stdout = timeout_output_text(exc.stdout)
        stderr = timeout_output_text(exc.stderr)
        timeout_detail = (
            f"{args[0]} timed out after {timeout:g} seconds"
            if timeout is not None
            else f"{args[0]} timed out"
        )
        stderr = f"{stderr}\n{timeout_detail}" if stderr else timeout_detail
        return subprocess.CompletedProcess(args, 124, stdout, stderr)
    except FileNotFoundError:
        missing_command(
            args,
            error_channel=error_channel,
            human_message=missing_command_message,
        )


def run_jj(
    root: Path,
    args: list[str],
    *,
    capture: bool = True,
    ignore_working_copy: bool = False,
    repository: bool = False,
    timeout: float | None = None,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> subprocess.CompletedProcess[str]:
    command = ["jj"]
    cwd: Path | None = root
    if repository:
        command.extend(["--repository", str(root)])
        cwd = None
    else:
        ensure_workspace(root)
    if ignore_working_copy:
        command.append("--ignore-working-copy")
    command.extend(args)
    return run_command(
        command,
        cwd=cwd,
        capture=capture,
        timeout=timeout,
        error_channel=error_channel,
        missing_command_message="jj executable not found",
    )


def write_bounded_backend_output(proc: subprocess.CompletedProcess[str]) -> None:
    text = proc.stderr or proc.stdout
    if text:
        sys.stderr.write(text[:OUTPUT_TEXT_LIMIT])
        if not text.endswith("\n"):
            sys.stderr.write("\n")


def require_jj_repo_root(repo_root: Path) -> None:
    if not (repo_root / ".jj").is_dir():
        fail(f"repo root is not a jj repository: {repo_root}")


def configured_base_candidates(branch: str, remote: str) -> list[str]:
    return unique_values([f"{branch}@{remote}", branch])


def lexical_absolute(path: Path) -> Path:
    return Path(os.path.abspath(os.path.normpath(str(path))))


def valid_scherzo_core_checkout(root: Path) -> bool:
    return (root / "scripts").is_dir() and (root / ".scherzo" / "workflows").is_dir()


def candidate_core_from_script_path(raw: str) -> Path | None:
    script_path = Path(raw)
    if not script_path.is_absolute():
        script_path = Path.cwd() / script_path
    try:
        resolved = script_path.resolve(strict=True)
    except OSError:
        return None

    candidates: list[Path] = []
    if resolved.parent.name == "scripts":
        candidates.append(resolved.parent.parent)
    candidates.append(resolved.parent)
    for candidate in candidates:
        try:
            root = candidate.resolve(strict=True)
        except OSError:
            continue
        if valid_scherzo_core_checkout(root):
            return root
    return None


def append_valid_core_candidate(candidates: list[Path], candidate: Path) -> None:
    try:
        root = candidate.resolve(strict=True)
    except OSError:
        return
    if not valid_scherzo_core_checkout(root):
        return
    if root not in candidates:
        candidates.append(root)


def core_candidates_from_repo_links() -> list[Path]:
    raw_repo = env_value("SCHERZO_REPO_ROOT")
    if raw_repo is None:
        return []
    try:
        repo_root = Path(raw_repo).resolve(strict=True)
    except OSError:
        return []

    candidates: list[Path] = []
    try:
        scripts_target = (repo_root / "scripts").resolve(strict=True)
    except OSError:
        scripts_target = None
    if scripts_target is not None:
        candidate = (
            scripts_target.parent
            if scripts_target.name == "scripts"
            else scripts_target
        )
        append_valid_core_candidate(candidates, candidate)

    try:
        workflows_target = (
            repo_root / ".scherzo" / "workflows"
        ).resolve(strict=True)
    except OSError:
        workflows_target = None
    if workflows_target is not None and workflows_target.name == "workflows":
        workflows_parent = workflows_target.parent
        if workflows_parent.name == ".scherzo":
            append_valid_core_candidate(candidates, workflows_parent.parent)

    return candidates


def current_script_path_candidates() -> list[str]:
    candidates: list[str] = []
    for raw in [sys.argv[0], globals().get("__file__")]:
        if not isinstance(raw, str):
            continue
        value = raw.strip()
        if value and value != "-":
            candidates.append(value)
    return unique_values(candidates)


def append_core_candidate_from_script_path(candidates: list[Path], raw: str) -> None:
    candidate = candidate_core_from_script_path(raw)
    if candidate is not None:
        append_valid_core_candidate(candidates, candidate)


def scherzo_core_checkout_for_bridge() -> Path:
    candidates: list[Path] = []
    raw_driver_script = env_value("SCHERZO_DRIVER_SCRIPT")
    if raw_driver_script is not None:
        append_core_candidate_from_script_path(candidates, raw_driver_script)
    for raw in current_script_path_candidates():
        append_core_candidate_from_script_path(candidates, raw)
    raw_workspace_driver = env_value("SCHERZO_WORKSPACE_DRIVER")
    if raw_workspace_driver is not None:
        append_core_candidate_from_script_path(candidates, raw_workspace_driver)
    for candidate in core_candidates_from_repo_links():
        append_valid_core_candidate(candidates, candidate)
    if candidates:
        return candidates[0]
    fail(
        "portable symlink bridge needed but could not locate a Scherzo core "
        "checkout from SCHERZO_DRIVER_SCRIPT, the running driver script, "
        "SCHERZO_WORKSPACE_DRIVER, or SCHERZO_REPO_ROOT"
    )


def portable_link_uses_bridge(
    workspace_path: Path,
    rel: str,
    suffix: str,
) -> bool:
    link = workspace_path / Path(rel)
    if not link.is_symlink():
        return False
    try:
        raw_target = os.readlink(link)
    except OSError as exc:
        fail(f"portable symlink preflight failed: could not read {link}: {exc}")

    target_path = Path(raw_target)
    target_abs = lexical_absolute(
        target_path if target_path.is_absolute() else link.parent / target_path
    )
    expected_abs = lexical_absolute(
        workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME / Path(suffix)
    )
    uses_bridge = not target_path.is_absolute() and target_abs == expected_abs
    if not uses_bridge and not link.exists():
        fail(
            "portable symlink preflight failed before review lanes: "
            f"{rel} in {workspace_path} is broken; target {raw_target!r} "
            f"resolves to {target_abs}, not expected sibling bridge path "
            f"{expected_abs}"
        )
    return uses_bridge


def portable_bridge_link_rels(workspace_path: Path) -> list[str]:
    rels: list[str] = []
    for rel, suffix in PORTABLE_SCHERZO_LINKS:
        if portable_link_uses_bridge(workspace_path, rel, suffix):
            rels.append(rel)
    return rels


def ensure_scherzo_bridge_path(bridge: Path, core_checkout: Path) -> None:
    if bridge.is_symlink():
        try:
            current = bridge.resolve(strict=True)
        except OSError:
            fail(
                f"portable symlink bridge collision: {bridge} is a broken symlink"
            )
        if current != core_checkout:
            fail(
                "portable symlink bridge collision: "
                f"{bridge} points to {current}, expected {core_checkout}"
            )
        return
    if bridge.exists():
        fail(
            "portable symlink bridge collision: "
            f"{bridge} exists and is not a symlink to {core_checkout}"
        )
    try:
        os.symlink(str(core_checkout), str(bridge), target_is_directory=True)
    except FileExistsError:
        ensure_scherzo_bridge_path(bridge, core_checkout)
    except OSError as exc:
        fail(
            "could not create portable symlink bridge "
            f"{bridge} -> {core_checkout}: {exc}"
        )


def verify_portable_bridge_links(
    workspace_path: Path,
    core_checkout: Path,
    bridge_rels: list[str],
) -> None:
    for rel in bridge_rels:
        link = workspace_path / Path(rel)
        try:
            actual = link.resolve(strict=True)
        except OSError as exc:
            fail(
                "portable symlink preflight failed before review lanes: "
                f"{rel} in {workspace_path} still does not resolve after "
                f"creating/verifying {workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME}: {exc}"
            )
        try:
            expected = (core_checkout / Path(rel)).resolve(strict=True)
        except OSError as exc:
            fail(
                "portable symlink bridge target is not a complete Scherzo core "
                f"checkout: {core_checkout / Path(rel)} is missing: {exc}"
            )
        if actual != expected:
            fail(
                "portable symlink preflight failed before review lanes: "
                f"{rel} in {workspace_path} resolved to {actual}, expected {expected}"
            )


def ensure_portable_scherzo_bridge(workspace_path: Path) -> None:
    bridge_rels = portable_bridge_link_rels(workspace_path)
    if not bridge_rels:
        return
    core_checkout = scherzo_core_checkout_for_bridge()
    bridge = workspace_path.parent / PORTABLE_SCHERZO_BRIDGE_NAME
    ensure_scherzo_bridge_path(bridge, core_checkout)
    verify_portable_bridge_links(workspace_path, core_checkout, bridge_rels)


def first_existing_revision(repo_root: Path, candidates: list[str]) -> str | None:
    for candidate in candidates:
        if revision_commit_ids(repo_root, candidate, repository=True) is not None:
            return candidate
    return None


def workspace_base_revision(repo_root: Path) -> str:
    explicit_base = env_value("SCHERZO_JJ_WORKSPACE_BASE")
    if explicit_base is not None:
        if revision_commit_ids(repo_root, explicit_base, repository=True) is None:
            fail(f"SCHERZO_JJ_WORKSPACE_BASE does not resolve in repo: {explicit_base}")
        return explicit_base

    branch = selected_workspace_base_branch()
    remote = selected_workspace_base_remote()
    configured = base_selection_was_configured()
    candidates = (
        configured_base_candidates(branch, remote)
        if configured
        else DEFAULT_BASE_CANDIDATES
    )
    revision = first_existing_revision(repo_root, candidates)
    if revision is not None:
        return revision
    if configured:
        tried = ", ".join(configured_base_candidates(branch, remote))
        fail(
            f"configured workspace base did not resolve for branch '{branch}' "
            f"from remote '{remote}'; tried {tried}. Set "
            "SCHERZO_JJ_WORKSPACE_BASE to an explicit local revision, or use "
            "SCHERZO_JJ_WORKSPACE_BASE_BRANCH and SCHERZO_JJ_WORKSPACE_REMOTE "
            "for jj workspace base policy."
        )
    fail(
        "could not resolve any default workspace base candidate: "
        f"{', '.join(DEFAULT_BASE_CANDIDATES)}"
    )


def prepare_destination_for_workspace_add(workspace_path: Path) -> Path:
    workspace_parent = workspace_path.parent
    try:
        workspace_parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(f"could not create workspace parent: {workspace_parent}: {exc}")
    if workspace_path.is_dir():
        try:
            workspace_path.rmdir()
        except OSError:
            fail(f"workspace path exists and is not empty before jj workspace add: {workspace_path}")
    return workspace_parent


def run_jj_root(workspace_path: Path) -> str:
    proc = run_jj(workspace_path, ["root"])
    if proc.returncode != 0:
        write_bounded_backend_output(proc)
        fail("jj root failed")
    return proc.stdout.strip()


def verify_current_workspace(workspace_path: Path) -> None:
    if not (workspace_path / ".jj").exists():
        fail(f"workspace is missing .jj: {workspace_path}")
    current_root = run_jj_root(workspace_path)
    if current_root != str(workspace_path):
        fail(f"jj root does not match workspace path: expected {workspace_path}, got {current_root}")

    ensure_portable_scherzo_bridge(workspace_path)

    status = run_jj(workspace_path, ["status", "--color=never"], capture=False)
    if status.returncode != 0:
        fail("jj status failed")


def allow_trusted_envrc_after_create(workspace_path: Path) -> None:
    if not (workspace_path / ".envrc").is_file():
        return
    if shutil.which("direnv") is None:
        fail(".envrc exists but direnv is not installed in workspace setup environment")
    proc = run_command(["direnv", "allow", "."], cwd=workspace_path)
    if proc.returncode != 0:
        write_bounded_backend_output(proc)
        print(
            f"scherzo-workspace-jj: warning: direnv allow failed for workspace: {workspace_path}",
            file=sys.stderr,
        )


def add_workspace(args: list[str], workspace_parent: Path) -> None:
    proc = run_command(args, cwd=workspace_parent, capture=False)
    if proc.returncode != 0:
        fail("jj workspace add failed")


def lifecycle_create() -> None:
    workspace_path = lifecycle_workspace_path()
    repo_root = infer_repo_root(workspace_path)
    require_jj_repo_root(repo_root)

    if (workspace_path / ".jj").is_dir():
        verify_current_workspace(workspace_path)
        return

    source_workspace = env_value("SCHERZO_SOURCE_WORKSPACE_PATH")
    explicit_base = env_value("SCHERZO_JJ_WORKSPACE_BASE")
    if source_workspace is None and explicit_base is None:
        branch = selected_workspace_base_branch()
        remote = selected_workspace_base_remote()
        if fetch_base_enabled(error_channel=ERROR_CHANNEL_HUMAN):
            ok, message = fetch_ref(
                repo_root,
                branch,
                remote,
                repository=True,
                error_channel=ERROR_CHANNEL_HUMAN,
            )
            if not ok:
                sys.stderr.write(message[:OUTPUT_TEXT_LIMIT])
                if message and not message.endswith("\n"):
                    sys.stderr.write("\n")
                fail(
                    f"could not fetch workspace base '{branch}' from remote "
                    f"'{remote}' before creating root workspace; for local-only use set "
                    "SCHERZO_JJ_WORKSPACE_BASE=@ or SCHERZO_JJ_WORKSPACE_FETCH_BASE=false, "
                    "for non-main branches set SCHERZO_JJ_WORKSPACE_BASE_BRANCH, and for "
                    "alternate remotes set SCHERZO_JJ_WORKSPACE_REMOTE."
                )

    workspace_parent = prepare_destination_for_workspace_add(workspace_path)
    workspace_name = lifecycle_workspace_name(workspace_path)
    if source_workspace:
        source_path = resolve_dir_or_raw(source_workspace)
        if not (source_path / ".jj").is_dir():
            fail(f"source workspace is missing .jj: {source_path}")
        add_workspace(
            [
                "jj",
                "--repository",
                str(source_path),
                "workspace",
                "add",
                "--name",
                workspace_name,
                "--revision",
                "@",
                "--sparse-patterns",
                "full",
                str(workspace_path),
            ],
            workspace_parent,
        )
    else:
        base_revision = workspace_base_revision(repo_root)
        add_workspace(
            [
                "jj",
                "--repository",
                str(repo_root),
                "workspace",
                "add",
                "--name",
                workspace_name,
                "--revision",
                base_revision,
                "--sparse-patterns",
                "full",
                str(workspace_path),
            ],
            workspace_parent,
        )

    verify_current_workspace(workspace_path)
    allow_trusted_envrc_after_create(workspace_path)


def forget_workspace_at(target: Path) -> None:
    if not target.is_dir():
        return
    root_proc = run_command(["jj", "root"], cwd=target, missing_command_message="jj executable not found")
    if root_proc.returncode != 0:
        return
    # Cleanup must be able to forget workspaces left stale by concurrent
    # workflow lanes. We are deleting the workspace tree anyway, so avoid
    # snapshot/update of the working copy during this metadata operation.
    status = run_command(
        ["jj", "--ignore-working-copy", "workspace", "forget"],
        cwd=target,
        capture=False,
        missing_command_message="jj executable not found",
    )
    if status.returncode != 0:
        fail(f"could not forget jj workspace: {target}")


def forget_workspace_children(base: Path) -> None:
    if not base.is_dir():
        return
    for target in sorted(base.iterdir()):
        if target.is_symlink():
            continue
        if target.is_dir() and (target / ".jj").is_dir():
            forget_workspace_at(target)


def forget_run_workspaces(workspace_path: Path, run_root: Path | None) -> None:
    if run_root is not None:
        forget_workspace_children(run_root / "workspaces")
        return
    # Daemon cleanup always passes SCHERZO_RUN_ROOT and forgets every manifest
    # workspace under that run root. Without SCHERZO_RUN_ROOT, only the explicit
    # workspace path is supported; do not infer a legacy run root from
    # SCHERZO_WORKSPACE_PATH/workspaces.
    if (workspace_path / ".jj").is_dir():
        forget_workspace_at(workspace_path)


def remove_workspace_directory(workspace_path: Path, run_root: Path | None) -> None:
    if run_root is None or not workspace_path.exists():
        return
    try:
        shutil.rmtree(workspace_path)
    except OSError as exc:
        fail(f"could not remove workspace directory: {workspace_path}: {exc}")


def lifecycle_remove() -> None:
    require_explicit_workspace_path("remove")
    workspace_path = lifecycle_workspace_path()
    run_root = lifecycle_run_root()
    validate_remove_target(workspace_path, run_root)
    if shutil.which("jj") is None:
        return
    forget_run_workspaces(workspace_path, run_root)
    remove_workspace_directory(workspace_path, run_root)


def lifecycle(args: list[str]) -> None:
    if len(args) != 1:
        usage_error("lifecycle requires one operation")
    operation = args[0]
    if operation == "create":
        lifecycle_create()
        return
    if operation == "before-step":
        verify_current_workspace(lifecycle_workspace_path())
        return
    if operation == "after-step":
        return
    if operation == "remove":
        lifecycle_remove()
        return
    usage_error(f"unsupported lifecycle operation: {operation}")


def ensure_workspace(root: Path) -> None:
    if not root.is_dir():
        fail("workspace directory does not exist")


def write_process_output(completed: subprocess.CompletedProcess[str]) -> None:
    if completed.stdout:
        sys.stdout.write(completed.stdout)
    if completed.stderr:
        sys.stderr.write(completed.stderr)


def run_jj_status_human(root: Path) -> None:
    status_args = ["status", "--color=never"]
    completed = run_jj(root, status_args)
    if completed.returncode == 0:
        write_process_output(completed)
        raise SystemExit(0)

    combined_output = f"{completed.stdout}{completed.stderr}"
    if "workspace update-stale" not in combined_output:
        write_process_output(completed)
        raise SystemExit(1)

    sys.stderr.write(
        "scherzo-workspace-jj: running "
        "`jj workspace update-stale` before retrying status\n"
    )
    update = run_jj(root, ["workspace", "update-stale"])
    if update.returncode != 0:
        write_process_output(completed)
        write_process_output(update)
        raise SystemExit(1)

    retried = run_jj(root, status_args)
    write_process_output(retried)
    raise SystemExit(0 if retried.returncode == 0 else 1)


def run_jj_capture(
    root: Path,
    args: list[str],
    *,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> str:
    completed = run_jj(root, args, error_channel=error_channel)
    if completed.returncode != 0:
        if completed.stderr:
            sys.stderr.write(completed.stderr[:OUTPUT_TEXT_LIMIT])
            if not completed.stderr.endswith("\n"):
                sys.stderr.write("\n")
        fail("jj command failed")
    return completed.stdout


def run_jj_capture_json(root: Path, args: list[str], failure_code: str) -> str:
    completed = run_jj(root, args, error_channel=ERROR_CHANNEL_JSON)
    if completed.returncode != 0:
        message = (completed.stderr or completed.stdout or "jj command failed").strip()
        json_failure(
            status="command_failed",
            failure_code=failure_code,
            message=message[:OUTPUT_TEXT_LIMIT] or "jj command failed",
        )
    return completed.stdout


def clean_lines(output: str) -> list[str]:
    values: list[str] = []
    seen: set[str] = set()
    for line in output.splitlines():
        path = line.rstrip("\r").strip()
        if path and path not in seen:
            values.append(path)
            seen.add(path)
    return values


def changed_paths(
    root: Path,
    *,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> list[str]:
    # Fallback path list: use jj's current-change diff instead of an explicit
    # @-..@ range. Merge resolution workspaces have two parents, so @- is
    # ambiguous there.
    output = run_jj_capture(
        root,
        ["diff", "--name-only", "--color=never"],
        error_channel=error_channel,
    )
    return sorted(clean_lines(output))


def parse_rename_summary_paths(rest: str) -> tuple[str, str]:
    # Assumes jj diff --summary human rename formats observed in jj 0.41.0:
    # either "old -> new" or brace-compacted "{old => new}" path segments.
    # If jj changes this output, replace this parser with a template-based query.
    text = rest.strip()
    if " -> " in text:
        old_path, new_path = text.split(" -> ", 1)
        return old_path.strip(), new_path.strip()

    brace_start = text.find("{")
    if brace_start >= 0:
        brace_end = text.find("}", brace_start + 1)
        if brace_end >= 0:
            inside = text[brace_start + 1 : brace_end]
            if "=>" in inside:
                old_part, new_part = inside.split("=>", 1)
                prefix = text[:brace_start]
                suffix = text[brace_end + 1 :]
                old_path = prefix + old_part.strip() + suffix
                new_path = prefix + new_part.strip() + suffix
                return old_path.strip(), new_path.strip()

    if "=>" in text:
        old_path, new_path = text.split("=>", 1)
        return old_path.strip("{} "), new_path.strip("{} ")

    return "", text


def parse_summary_records(summary: str) -> tuple[dict[str, dict[str, str]], list[str]]:
    records: dict[str, dict[str, str]] = {}
    unparsed_lines: list[str] = []
    for raw_line in summary.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        parts = line.split(maxsplit=1)
        if len(parts) != 2:
            unparsed_lines.append(line)
            continue
        token, rest = parts[0], parts[1].strip()
        status = STATUS_MAP.get(token[:1], "modified")
        record: dict[str, str]
        if status == "renamed":
            old_path, new_path = parse_rename_summary_paths(rest)
            old_path = old_path.strip()
            new_path = new_path.strip()
            if not old_path or not new_path:
                unparsed_lines.append(line)
                continue
            record = {"path": new_path, "status": "renamed", "old_path": old_path}
        else:
            record = {"path": rest, "status": status}
        path = record.get("path", "").strip()
        if path:
            records[path] = record
        else:
            unparsed_lines.append(line)
    return records, unparsed_lines


def changed_file_records(
    root: Path,
    *,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> list[dict[str, str]]:
    summary_proc = run_jj(
        root,
        ["diff", "--summary", "--color=never"],
        error_channel=error_channel,
    )
    if summary_proc.returncode == 0:
        summary_records, unparsed_lines = parse_summary_records(summary_proc.stdout)
        # A successful but unrecognized human summary must not make safety
        # checks see a clean workspace; fail closed instead of dropping lines.
        if unparsed_lines:
            sample = "; ".join(unparsed_lines[:3])
            suffix = (
                "" if len(unparsed_lines) <= 3
                else f" (+{len(unparsed_lines) - 3} more)"
            )
            fail(f"unrecognized jj diff --summary output: {sample}{suffix}")
        records = list(summary_records.values())
    else:
        records = [
            {"path": path, "status": "modified"}
            for path in changed_paths(root, error_channel=error_channel)
        ]
    records.sort(key=lambda record: record.get("path", ""))
    return records


def print_changed_files_json(root: Path) -> None:
    json_dump({
        "version": 1,
        "files": changed_file_records(root, error_channel=ERROR_CHANNEL_JSON),
    })


def assert_only(root: Path, target: str) -> None:
    files = [record["path"] for record in changed_file_records(root)]
    if files == [target]:
        return
    actual = ", ".join(files) if files else "none"
    print(
        f"scherzo-workspace-jj: expected only {target}; actual changed files: {actual}",
        file=sys.stderr,
    )
    raise SystemExit(1)


def revision_value(
    root: Path,
    revision: str,
    template: str,
    *,
    default: str = "",
    ignore_working_copy: bool = False,
    repository: bool = False,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> str:
    proc = run_jj(
        root,
        ["log", "-r", revision, "--no-graph", "-T", template, "--color=never"],
        ignore_working_copy=ignore_working_copy,
        repository=repository,
        error_channel=error_channel,
    )
    if proc.returncode != 0:
        return default
    return proc.stdout.strip() or default


def revision_commit_ids(
    root: Path,
    revision: str,
    *,
    repository: bool = False,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> list[str] | None:
    template = "commit_id" if repository else "commit_id ++ \"\\n\""
    proc = run_jj(
        root,
        ["log", "-r", revision, "--no-graph", "-T", template, "--color=never"],
        repository=repository,
        error_channel=error_channel,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    return clean_lines(proc.stdout)


def current_parent_commit_ids(
    root: Path,
    *,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> list[str]:
    return revision_commit_ids(root, "@-", error_channel=error_channel) or []


def normalize_conflict_file_path(value: str) -> str:
    return re.sub(r"\s+\d+-sided conflict(?:\s+.*)?$", "", value.strip())


def conflict_files(
    root: Path,
    *,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> list[str]:
    proc = run_jj(
        root,
        ["resolve", "--list", "--color=never"],
        error_channel=error_channel,
    )
    if proc.returncode == 0:
        return sorted(
            path
            for path in [normalize_conflict_file_path(line) for line in proc.stdout.splitlines()]
            if path
        )
    if "No conflicts found" in proc.stdout or "No conflicts found" in proc.stderr:
        return []

    message = (proc.stderr or proc.stdout or "jj resolve --list failed").strip()
    message = message[:OUTPUT_TEXT_LIMIT] or "jj resolve --list failed"
    if error_channel == ERROR_CHANNEL_JSON:
        raise ConflictFilesListFailed(message)
    fail(f"could not list conflict files: {message}")


def baseline_json(root: Path) -> None:
    records = changed_file_records(root, error_channel=ERROR_CHANNEL_JSON)
    json_dump({
        "version": 1,
        "baseline_id": revision_value(
            root,
            "@-",
            "change_id",
            default="unknown-baseline",
            error_channel=ERROR_CHANNEL_JSON,
        ),
        "workspace_revision_id": revision_value(
            root,
            "@",
            "commit_id",
            default="unknown-revision",
            error_channel=ERROR_CHANNEL_JSON,
        ),
        "change_id": revision_value(
            root,
            "@",
            "change_id.short()",
            default="unknown-change",
            error_channel=ERROR_CHANNEL_JSON,
        ),
        "dirty": bool(records),
    })


def diff_json(root: Path) -> None:
    text = run_jj_capture_json(
        root,
        ["diff", "--git", "--color=never"],
        "diff_failed",
    )
    json_dump({"version": 1, "format": "unified", "text": text, "truncated": False})


def configured_base_ref() -> tuple[str, str, str]:
    base = selected_workspace_base_branch()
    remote = selected_workspace_base_remote()
    return base, remote, f"{base}@{remote}"


def parse_refresh_args(args: list[str]) -> tuple[str, str | None]:
    stage: str | None = None
    target: str | None = None
    saw_json = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--stage" and index + 1 < len(args):
            stage = args[index + 1]
            index += 2
        elif arg == "--target" and index + 1 < len(args):
            target = args[index + 1]
            index += 2
        elif arg == "--json":
            saw_json = True
            index += 1
        else:
            usage_error(f"unsupported refresh-base argument: {arg}")
    if not saw_json:
        usage_error("refresh-base requires --json")
    if not stage or not REFRESH_STAGE_RE.fullmatch(stage):
        usage_error("refresh-base requires safe --stage <stage>")
    if target is not None and target.strip() == "":
        usage_error("refresh-base --target must not be empty")
    return stage, target


def fetch_ref(
    root: Path,
    base: str,
    remote: str,
    *,
    repository: bool = False,
    error_channel: str = ERROR_CHANNEL_HUMAN,
) -> tuple[bool, str]:
    proc = run_jj(
        root,
        ["git", "fetch", "--remote", remote, "--branch", base],
        repository=repository,
        error_channel=error_channel,
    )
    text = (proc.stderr or proc.stdout or "").strip()
    return proc.returncode == 0, text


def refresh_base(root: Path, args: list[str]) -> None:
    stage, target = parse_refresh_args(args)
    fetch_enabled = fetch_base_enabled(error_channel=ERROR_CHANNEL_JSON)
    base, remote, remote_base = configured_base_ref()
    base_ref = base
    base_revision = remote_base
    before_revision = revision_value(
        root,
        "@",
        "commit_id",
        default="unknown-before",
        error_channel=ERROR_CHANNEL_JSON,
    )

    # Refresh failure payload policy: every failure path uses fail_refresh(),
    # which reports the best available conflict file list. Listing failures are
    # not silently converted to an empty list: non-rebase primary failures keep
    # their original status and include the listing problem in the message,
    # while a successful rebase whose conflicts cannot be listed fails closed as
    # rebase_failed/conflict_listing_failed. The public refresh statuses remain
    # fresh, rebased_clean, conflicts, fetch_failed, base_not_found, and
    # rebase_failed.
    def conflict_files_for_failure() -> tuple[list[str], str | None]:
        try:
            return conflict_files(root, error_channel=ERROR_CHANNEL_JSON), None
        except ConflictFilesListFailed as exc:
            return [], exc.message

    def message_with_conflict_listing_warning(
        message: str,
        listing_error: str | None,
    ) -> str:
        if listing_error is None:
            return message
        warning = f"could not list conflict files: {listing_error}"
        if message:
            return f"{message}; {warning}"
        return warning

    def fail_refresh(
        *,
        status: str,
        failure_code: str,
        message: str,
        exit_code: int = 1,
        base_revision_value: str | None = None,
        after_revision: str | None = None,
        conflict_files_value: list[str] | None = None,
        conflict_listing_error: str | None = None,
    ) -> NoReturn:
        files = conflict_files_value
        listing_error = conflict_listing_error
        if files is None:
            files, listing_error = conflict_files_for_failure()
        json_failure(
            status=status,
            failure_code=failure_code,
            message=message_with_conflict_listing_warning(
                message,
                listing_error,
            )[:OUTPUT_TEXT_LIMIT],
            exit_code=exit_code,
            stage=stage,
            base_ref=base_ref,
            base_revision=base_revision_value or base_revision,
            before_revision=before_revision,
            after_revision=after_revision or before_revision,
            conflict_files=files,
        )

    if target:
        base_ref = target
        base_revision = target
        if fetch_enabled and "@" in target:
            branch, target_remote = target.rsplit("@", 1)
            if branch and target_remote:
                ok, message = fetch_ref(
                    root,
                    branch,
                    target_remote,
                    error_channel=ERROR_CHANNEL_JSON,
                )
                if not ok:
                    fail_refresh(
                        status="fetch_failed",
                        failure_code="fetch_failed",
                        message=message or f"could not fetch {target}",
                    )
    else:
        if fetch_enabled:
            ok, message = fetch_ref(
                root,
                base,
                remote,
                error_channel=ERROR_CHANNEL_JSON,
            )
            if not ok:
                fail_refresh(
                    status="fetch_failed",
                    failure_code="fetch_failed",
                    message=message or f"could not fetch {base} from {remote}",
                )
        if revision_commit_ids(root, remote_base, error_channel=ERROR_CHANNEL_JSON) is None:
            if revision_commit_ids(root, base, error_channel=ERROR_CHANNEL_JSON) is None:
                fail_refresh(
                    status="base_not_found",
                    failure_code="base_not_found",
                    message=f"could not find base revision {remote_base} or {base}",
                    base_revision_value=remote_base,
                )
            base_revision = base

    base_commits = revision_commit_ids(
        root,
        base_revision,
        error_channel=ERROR_CHANNEL_JSON,
    )
    if base_commits is None:
        fail_refresh(
            status="base_not_found",
            failure_code="base_not_found",
            message=f"could not find base revision {base_revision}",
        )

    parent_commits = current_parent_commit_ids(root, error_channel=ERROR_CHANNEL_JSON)
    if len(base_commits) == 1 and parent_commits == base_commits:
        json_dump({
            "version": 1,
            "status": "fresh",
            "stage": stage,
            "base_ref": base_ref,
            "base_revision": base_revision,
            "before_revision": before_revision,
            "after_revision": revision_value(
                root,
                "@",
                "commit_id",
                default=before_revision,
                error_channel=ERROR_CHANNEL_JSON,
            ),
            "conflict_files": [],
        })
        return

    proc = run_jj(
        root,
        ["rebase", "-r", "@", "-d", base_revision, "--color=never"],
        error_channel=ERROR_CHANNEL_JSON,
    )
    after_revision = revision_value(
        root,
        "@",
        "commit_id",
        default=before_revision,
        error_channel=ERROR_CHANNEL_JSON,
    )
    files: list[str] = []
    conflict_listing_error: str | None = None
    try:
        files = conflict_files(root, error_channel=ERROR_CHANNEL_JSON)
    except ConflictFilesListFailed as exc:
        conflict_listing_error = exc.message

    if conflict_listing_error is not None and proc.returncode == 0:
        fail_refresh(
            status="rebase_failed",
            failure_code="conflict_listing_failed",
            message=f"could not list conflict files after rebase: {conflict_listing_error}",
            after_revision=after_revision,
            conflict_files_value=[],
        )
    if files:
        fail_refresh(
            status="conflicts",
            failure_code="conflicts",
            message="refresh-base left unresolved conflicts",
            exit_code=20,
            after_revision=after_revision,
            conflict_files_value=files,
        )
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout or "could not rebase workspace").strip()
        fail_refresh(
            status="rebase_failed",
            failure_code="rebase_failed",
            message=message[:OUTPUT_TEXT_LIMIT],
            after_revision=after_revision,
            conflict_files_value=files,
            conflict_listing_error=conflict_listing_error,
        )
    json_dump({
        "version": 1,
        "status": "rebased_clean",
        "stage": stage,
        "base_ref": base_ref,
        "base_revision": base_revision,
        "before_revision": before_revision,
        "after_revision": after_revision,
        "conflict_files": [],
    })


def parse_publish_args(args: list[str]) -> dict[str, str]:
    command = "publish-commit-stack"
    values: dict[str, str] = {"allow-no-changes": "false"}
    saw_json = False
    with_value = {
        "--kind",
        "--title-file",
        "--body-file",
        "--branch-prefix",
        "--base",
        "--target-branch",
        "--target-pr",
        "--expected-head",
        "--allow-no-changes",
    }
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--json":
            saw_json = True
            index += 1
        elif arg in with_value and index + 1 < len(args):
            values[arg[2:]] = args[index + 1]
            index += 2
        else:
            usage_error(f"unsupported {command} argument: {arg}")
    for key in ["kind", "title-file", "body-file", "branch-prefix", "base"]:
        if not values.get(key):
            usage_error(f"{command} requires --{key}")
    if not saw_json:
        usage_error(f"{command} requires --json")
    if values.get("allow-no-changes") not in {"true", "false"}:
        usage_error("--allow-no-changes must be true or false")
    if not PUBLISH_KIND_RE.match(values["kind"]):
        usage_error(f"{command} --kind must be a lowercase token containing letters, numbers, and hyphens")
    return values


def read_required_file(path: str, label: str) -> str:
    relative = validate_relative_path(path, usage_label=label)
    full = capability_root() / relative
    try:
        return full.read_text(encoding="utf-8")
    except OSError as exc:
        usage_error(f"could not read {label}: {exc}")


def remote_url(root: Path, remote: str, *, ignore_working_copy: bool = False) -> str | None:
    proc = run_jj(
        root,
        ["git", "remote", "list", "--color=never"],
        ignore_working_copy=ignore_working_copy,
        error_channel=ERROR_CHANNEL_JSON,
    )
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == remote:
            return parts[1]
    return None


def githubish_host(host: str) -> bool:
    normalized = host.lower()
    return normalized == "github.com" or normalized.startswith("github")


def owner_repo_from_url(url: str) -> str | None:
    if url.startswith("https://github.com/"):
        value = url.removeprefix("https://github.com/")
    else:
        scp_match = re.match(r"^git@([^:]+):(.+)$", url)
        ssh_match = re.match(r"^ssh://(?:git@)?([^/]+)/(.+)$", url)
        if scp_match and githubish_host(scp_match.group(1)):
            value = scp_match.group(2)
        elif ssh_match and githubish_host(ssh_match.group(1)):
            value = ssh_match.group(2)
        else:
            return None
    value = value.split("?", 1)[0].split("#", 1)[0].rstrip("/").removesuffix(".git")
    parts = value.split("/")
    if len(parts) >= 2 and parts[0] and parts[1]:
        return f"{parts[0]}/{parts[1]}"
    return None


def explicit_repo_env() -> tuple[str, str] | None:
    for name in ["SCHERZO_GITHUB_REPO", "SCHERZO_PR_REPO"]:
        explicit = env_value(name)
        if explicit:
            return name, explicit
    return None


def default_repo(root: Path, remote: str, *, ignore_working_copy: bool = False) -> str:
    url = remote_url(root, remote, ignore_working_copy=ignore_working_copy)
    if not url:
        json_failure(status="invalid_request", failure_code="repo_not_found", message=f"could not find jj git remote: {remote}")
    remote_repo = owner_repo_from_url(url)
    explicit = explicit_repo_env()
    if explicit:
        name, repo = explicit
        if remote_repo and repo.lower() != remote_repo.lower():
            json_failure(
                status="invalid_request",
                failure_code="repo_remote_mismatch",
                message=(
                    f"{name}={repo} does not match selected jj publication remote "
                    f"'{remote}' ({remote_repo}); update {name} or "
                    "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE"
                ),
            )
        return repo
    if remote_repo:
        return remote_repo
    github_repo = env_value("GITHUB_REPOSITORY")
    if github_repo:
        return github_repo
    json_failure(status="invalid_request", failure_code="repo_not_found", message=f"could not infer GitHub owner/repo from remote URL: {url}")



def normalize_expected_head(expected: str) -> str:
    normalized = expected.strip().lower()
    if not EXPECTED_HEAD_RE.fullmatch(normalized):
        usage_error("--expected-head must be a 40-character Git object ID")
    return normalized


def validate_expected_target_head(root: Path, remote: str, branch: str, expected: str) -> None:
    expected = normalize_expected_head(expected)
    fetch = run_jj(
        root,
        ["git", "fetch", "--remote", remote, "--branch", branch],
        error_channel=ERROR_CHANNEL_JSON,
    )
    if fetch.returncode != 0:
        json_failure(
            status="publication_failed",
            failure_code="target_fetch_failed",
            message=(fetch.stderr or fetch.stdout or "jj git fetch failed").strip(),
        )
    actual = revision_value(
        root,
        f"{branch}@{remote}",
        "commit_id",
        default="",
        error_channel=ERROR_CHANNEL_JSON,
    ).lower()
    if actual != expected:
        json_failure(
            status="stale_existing_branch",
            failure_code="stale_existing_branch",
            message=f"remote branch {branch} is no longer at expected head {expected}",
            expected_head=expected,
            actual_head=actual,
            branch=branch,
        )


def validate_expected_selected_head(root: Path, expected: str) -> str:
    expected = normalize_expected_head(expected)
    actual = revision_value(
        root,
        "@",
        "commit_id",
        default="",
        ignore_working_copy=True,
        error_channel=ERROR_CHANNEL_JSON,
    ).lower()
    if actual != expected:
        json_failure(
            status="invalid_commit_stack",
            failure_code="selected_commit_stack_head_mismatch",
            message=(
                "publish-commit-stack refused before push because the selected "
                f"workspace head is {actual or '<unknown>'} but the expected "
                f"commit_stack head is {expected}; rerun commit-stack "
                "materialization and validation before retrying publication"
            ),
            expected_head=expected,
            actual_head=actual,
        )
    return expected


def publish_needs_repo(values: dict[str, str]) -> bool:
    if values.get("target-pr"):
        return True
    return not bool(values.get("target-branch"))


def uses_stable_commit_stack_branch(values: dict[str, str]) -> bool:
    return not bool(values.get("target-branch"))


def publication_branch(values: dict[str, str]) -> str:
    if values.get("target-branch"):
        return values["target-branch"]
    return values["branch-prefix"]


def base_branch_name(driver_ref: str) -> str:
    return driver_ref.split("@", 1)[0].strip()


def reject_unsafe_stable_commit_stack_branch(branch: str, base: str) -> None:
    stable_branch = branch.strip()
    base_branch = base_branch_name(base)
    if stable_branch.lower() == "head":
        json_failure(
            status="invalid_request",
            failure_code="unsafe_publication_branch",
            message="stable commit-stack publication branch must not be HEAD",
            branch=branch,
            base_ref=base,
        )
    if base_branch and stable_branch == base_branch:
        json_failure(
            status="invalid_request",
            failure_code="unsafe_publication_branch",
            message=f"stable commit-stack publication branch must not match base branch {base_branch}",
            branch=branch,
            base_ref=base,
        )


def require_commit_stack_head_description(
    root: Path,
    revision: str = "@",
    *,
    ignore_working_copy: bool = False,
) -> None:
    description = revision_value(
        root,
        revision,
        "description",
        default="",
        ignore_working_copy=ignore_working_copy,
        error_channel=ERROR_CHANNEL_JSON,
    )
    if description.strip():
        return
    json_failure(
        status="invalid_commit_stack",
        failure_code="commit_stack_head_description_empty",
        message=(
            "commit_stack publication refused because the selected head commit "
            "has an empty jj description; rerun the workflow materialization "
            "helper or set a description before publication"
        ),
    )


def stable_commit_stack_push_needs_reconcile(message: str) -> bool:
    normalized = message.lower()
    reconcile_markers = [
        "non-fast-forward",
        "not a fast-forward",
        "fetch first",
        "stale branch",
        "stale bookmark",
        "stale remote",
        "remote has changed",
        "diverg",
        "conflict",
        "would move backwards",
        "move backward",
        "moved backwards",
        "bookmark already exists",
        "remote bookmark",
    ]
    return any(marker in normalized for marker in reconcile_markers)


PR_LOOKUP_ATTEMPTS = 3
PR_LOOKUP_TIMEOUT_SECONDS = 60.0


class PullRequestLookupResult:
    def __init__(self, selector: str, attempts: list[subprocess.CompletedProcess[str]]) -> None:
        self.selector = selector
        self.attempts = attempts

    @property
    def url(self) -> str:
        for attempt in self.attempts:
            if attempt.returncode == 0 and attempt.stdout.strip():
                return attempt.stdout.strip()
        return ""

    @property
    def failed(self) -> bool:
        return bool(self.attempts) and all(attempt.returncode != 0 for attempt in self.attempts)


def truncate_diagnostic_text(value: str) -> str:
    text = value.strip()
    if len(text) <= OUTPUT_TEXT_LIMIT:
        return text
    return text[: OUTPUT_TEXT_LIMIT - 3] + "..."


def command_diagnostics(label: str, proc: subprocess.CompletedProcess[str]) -> str:
    parts = [f"{label} exit_code={proc.returncode}"]
    stdout = truncate_diagnostic_text(proc.stdout)
    stderr = truncate_diagnostic_text(proc.stderr)
    if stdout:
        parts.append(f"stdout={stdout}")
    elif proc.returncode == 0:
        parts.append("stdout=<empty>")
    if stderr:
        parts.append(f"stderr={stderr}")
    return "; ".join(parts)


def lookup_diagnostics(lookup: PullRequestLookupResult | None) -> str:
    if lookup is None or not lookup.attempts:
        return "no gh pr view lookup was attempted"
    details = []
    for index, attempt in enumerate(lookup.attempts, start=1):
        details.append(command_diagnostics(f"gh pr view {lookup.selector} attempt {index}", attempt))
    return f"{len(lookup.attempts)} lookup attempt(s): " + " | ".join(details)


def pr_lookup_timeout_seconds() -> float:
    value = env_value("SCHERZO_PR_LOOKUP_TIMEOUT_SECONDS")
    if value is None:
        return PR_LOOKUP_TIMEOUT_SECONDS
    try:
        seconds = float(value)
    except ValueError:
        invalid_configuration(
            "SCHERZO_PR_LOOKUP_TIMEOUT_SECONDS must be a positive number",
            error_channel=ERROR_CHANNEL_JSON,
        )
    if not math.isfinite(seconds) or seconds <= 0:
        invalid_configuration(
            "SCHERZO_PR_LOOKUP_TIMEOUT_SECONDS must be a positive number",
            error_channel=ERROR_CHANNEL_JSON,
        )
    return seconds


def lookup_pull_request_url(
    root: Path,
    repo: str,
    selector: str,
    *,
    attempts: int = PR_LOOKUP_ATTEMPTS,
) -> PullRequestLookupResult:
    results: list[subprocess.CompletedProcess[str]] = []
    timeout = pr_lookup_timeout_seconds()
    for _ in range(max(1, attempts)):
        proc = run_command(
            ["gh", "pr", "view", selector, "--repo", repo, "--json", "url", "--jq", ".url"],
            cwd=root,
            timeout=timeout,
            error_channel=ERROR_CHANNEL_JSON,
        )
        results.append(proc)
        if proc.returncode == 0 and proc.stdout.strip():
            break
    return PullRequestLookupResult(selector, results)


def remaining_pull_request_lookup_attempts(lookup: PullRequestLookupResult | None) -> int:
    used = len(lookup.attempts) if lookup is not None else 0
    return max(0, PR_LOOKUP_ATTEMPTS - used)


def combine_pull_request_lookups(
    first: PullRequestLookupResult | None,
    second: PullRequestLookupResult | None,
) -> PullRequestLookupResult | None:
    if first is None:
        return second
    if second is None:
        return first
    if first.selector != second.selector:
        return second
    return PullRequestLookupResult(first.selector, first.attempts + second.attempts)


def view_pull_request_url(root: Path, repo: str, selector: str) -> str:
    return lookup_pull_request_url(root, repo, selector, attempts=1).url


def fail_pr_url_unavailable(
    *,
    branch: str,
    create: subprocess.CompletedProcess[str] | None,
    lookup: PullRequestLookupResult | None,
) -> None:
    lookup_detail = lookup_diagnostics(lookup)
    if create is None:
        if lookup is not None and lookup.failed:
            json_failure(
                status="publication_failed",
                failure_code="pr_lookup_failed",
                message=f"gh pr view lookup failed while locating hosted review URL for {branch}. {lookup_detail}",
                branch=branch,
            )
        json_failure(
            status="publication_failed",
            failure_code="pr_url_missing",
            message=f"hosted review URL for {branch} remained unavailable after bounded lookup attempts. {lookup_detail}",
            branch=branch,
        )
    if create.returncode != 0:
        json_failure(
            status="publication_failed",
            failure_code="pr_create_failed",
            message=(
                f"gh pr create failed for {branch}; pushed branch may be manually recoverable, "
                f"but bounded PR adoption did not find a URL. "
                f"{command_diagnostics('gh pr create', create)}; {lookup_detail}"
            ),
            branch=branch,
        )
    if lookup is not None and lookup.failed:
        json_failure(
            status="publication_failed",
            failure_code="pr_lookup_failed",
            message=(
                f"gh pr create succeeded for {branch} but returned no URL, and follow-up "
                f"gh pr view lookup failed after bounded adoption attempts. "
                f"{command_diagnostics('gh pr create', create)}; {lookup_detail}"
            ),
            branch=branch,
        )
    json_failure(
        status="publication_failed",
        failure_code="pr_create_url_missing",
        message=(
            f"gh pr create succeeded for {branch} but returned no URL, and bounded PR "
            f"lookup did not recover one. {command_diagnostics('gh pr create', create)}; "
            f"{lookup_detail}"
        ),
        branch=branch,
    )


def publish_commit_stack(root: Path, args: list[str]) -> None:
    values = parse_publish_args(args)
    reject_legacy_publication_remote_without_canonical()
    draft = pr_draft_setting()
    base = values["base"]
    stable_commit_stack_branch = uses_stable_commit_stack_branch(values)
    if stable_commit_stack_branch:
        reject_unsafe_stable_commit_stack_branch(values["branch-prefix"], base)
    title = read_required_file(values["title-file"], "title-file").strip().splitlines()
    title_text = title[0].strip() if title else "Scherzo change"
    _body = read_required_file(values["body-file"], "body-file")
    allow_no_changes = values["allow-no-changes"] == "true"
    remote = selected_publication_remote()
    expected_selected_head = ""
    has_expected_head = "expected-head" in values
    if values.get("target-branch") and has_expected_head:
        validate_expected_target_head(root, remote, values["target-branch"], values["expected-head"])
    elif has_expected_head:
        expected_selected_head = validate_expected_selected_head(root, values["expected-head"])
    ignore_working_copy = bool(expected_selected_head)
    publish_revision = expected_selected_head or "@"
    repo = default_repo(root, remote, ignore_working_copy=ignore_working_copy) if publish_needs_repo(values) else ""

    if not ignore_working_copy:
        records = changed_file_records(root, error_channel=ERROR_CHANNEL_JSON)
        if not records and allow_no_changes:
            branch = publication_branch(values)
            url = ""
            if values.get("target-pr"):
                url = view_pull_request_url(root, repo, values["target-pr"])
            elif stable_commit_stack_branch:
                url = view_pull_request_url(root, repo, branch)
            json_dump({
                "version": 1,
                "status": "unchanged",
                "url": url,
                "branch": branch,
                "base_ref": base,
                "base_revision": base,
                "head_revision": revision_value(
                    root,
                    "@",
                    "commit_id",
                    default="",
                    error_channel=ERROR_CHANNEL_JSON,
                ),
                "change_id": revision_value(
                    root,
                    "@",
                    "change_id.short()",
                    default="",
                    error_channel=ERROR_CHANNEL_JSON,
                ),
                "created": False,
                "updated": False,
            })
            return
        if not records:
            json_failure(status="nothing_to_publish", failure_code="nothing_to_publish", message="no changed files to publish")

    require_commit_stack_head_description(
        root,
        publish_revision,
        ignore_working_copy=ignore_working_copy,
    )

    change_id = revision_value(
        root,
        publish_revision,
        "change_id.short()",
        default="change",
        ignore_working_copy=ignore_working_copy,
        error_channel=ERROR_CHANNEL_JSON,
    )
    branch = publication_branch(values)
    # publish-commit-stack receives an already-selected commit_stack head;
    # describing it here would rewrite the commit object and break head checks.
    bookmark_args = ["bookmark", "set"]
    if values.get("target-branch"):
        # Merge-conflict resolution publishes intentionally retarget an existing
        # PR/head branch. Ensure jj treats the selected remote bookmark as the
        # tracking source, then allow replacing stale local resolver bookmarks.
        # The subsequent git push remains non-force and remote fast-forward-safe.
        track = run_jj(
            root,
            ["bookmark", "track", branch, f"--remote={remote}"],
            ignore_working_copy=ignore_working_copy,
            error_channel=ERROR_CHANNEL_JSON,
        )
        if track.returncode != 0:
            json_failure(
                status="publication_failed",
                failure_code="bookmark_track_failed",
                message=(track.stderr or track.stdout or "jj bookmark track failed").strip(),
            )
        bookmark_args.append("--allow-backwards")
    elif stable_commit_stack_branch:
        # Stable commit-stack publications intentionally reuse the same local
        # bookmark across retries. Allow local replacement here; the subsequent
        # non-force git push remains the remote safety check.
        bookmark_args.append("--allow-backwards")
    bookmark_args.extend([branch, "--revision", publish_revision])
    bookmark = run_jj(
        root,
        bookmark_args,
        ignore_working_copy=ignore_working_copy,
        error_channel=ERROR_CHANNEL_JSON,
    )
    if bookmark.returncode != 0:
        json_failure(status="publication_failed", failure_code="bookmark_failed", message=(bookmark.stderr or bookmark.stdout or "jj bookmark failed").strip())
    push_args = ["git", "push", "--remote", remote, "--bookmark", branch]
    push = run_jj(
        root,
        push_args,
        ignore_working_copy=ignore_working_copy,
        error_channel=ERROR_CHANNEL_JSON,
    )
    if push.returncode != 0:
        push_message = (push.stderr or push.stdout or "jj git push failed").strip()
        if stable_commit_stack_branch and stable_commit_stack_push_needs_reconcile(push_message):
            existing_url = view_pull_request_url(root, repo, branch)
            if existing_url:
                json_failure(
                    status="reconcile_needed",
                    failure_code="commit_stack_reconcile_needed",
                    message=(
                        f"existing hosted review {existing_url} for stable commit-stack "
                        f"branch {branch} could not be safely updated; reconcile the "
                        f"branch/PR before retrying: {push_message}"
                    ),
                    branch=branch,
                    url=existing_url,
                )
        json_failure(status="remote_rejected", failure_code="push_failed", message=push_message)

    pr_url = ""
    created = False
    target_pr = values.get("target-pr")
    target_branch = values.get("target-branch")
    updated = bool(target_branch or target_pr)
    branch_only_commit_stack = bool(target_branch) and not target_pr
    stable_create_or_update = not target_pr and not target_branch
    lookup: PullRequestLookupResult | None = None
    create: subprocess.CompletedProcess[str] | None = None

    if target_pr:
        # Retargeting an existing PR must only adopt by explicit PR number;
        # branch-name lookup can adopt an unrelated PR for the same head branch.
        lookup = lookup_pull_request_url(root, repo, target_pr)
        pr_url = lookup.url
        if not pr_url:
            fail_pr_url_unavailable(branch=branch, create=None, lookup=lookup)
    elif branch_only_commit_stack:
        # Target-branch-only publications update a branch without PR interaction.
        pass
    else:
        # Stable commit-stack branches first reuse an existing PR, then create or
        # recover one while keeping total gh pr view attempts bounded.
        lookup = lookup_pull_request_url(root, repo, branch, attempts=1)
        pr_url = lookup.url
        if not pr_url:
            gh_base = base.split("@", 1)[0]
            create_args = [
                "gh",
                "pr",
                "create",
                "--repo",
                repo,
                "--base",
                gh_base,
                "--head",
                branch,
                "--title",
                title_text,
                "--body-file",
                values["body-file"],
            ]
            if draft:
                create_args.append("--draft")
            create = run_command(
                create_args,
                cwd=root,
                error_channel=ERROR_CHANNEL_JSON,
            )
            if create.returncode == 0:
                pr_url = create.stdout.strip()
                created = True
                updated = False
            if not pr_url:
                remaining_attempts = remaining_pull_request_lookup_attempts(lookup)
                if remaining_attempts > 0:
                    recovery_lookup = lookup_pull_request_url(
                        root,
                        repo,
                        branch,
                        attempts=remaining_attempts,
                    )
                    lookup = combine_pull_request_lookups(lookup, recovery_lookup)
                    pr_url = lookup.url if lookup is not None else ""
                if pr_url and create.returncode != 0:
                    created = False
                    updated = True
        if not pr_url:
            fail_pr_url_unavailable(branch=branch, create=create, lookup=lookup)
    if pr_url and not created and stable_create_or_update:
        edit = run_command(
            [
                "gh",
                "pr",
                "edit",
                branch,
                "--repo",
                repo,
                "--title",
                title_text,
                "--body-file",
                values["body-file"],
            ],
            cwd=root,
            error_channel=ERROR_CHANNEL_JSON,
        )
        if edit.returncode != 0:
            json_failure(
                status="publication_failed",
                failure_code="pr_edit_failed",
                message=(edit.stderr or edit.stdout or "gh pr edit failed").strip(),
            )
        updated = True

    json_dump({
        "version": 1,
        "status": "published" if created else "updated",
        "url": pr_url,
        "branch": branch,
        "base_ref": base,
        "base_revision": base,
        "head_revision": expected_selected_head or revision_value(
            root,
            "@",
            "commit_id",
            default="",
            error_channel=ERROR_CHANNEL_JSON,
        ),
        "change_id": change_id,
        "created": created,
        "updated": updated,
    })


def main(argv: list[str]) -> None:
    if not argv:
        usage_error()
    command, rest = argv[0], argv[1:]
    if command == "describe":
        if rest != ["--json"]:
            usage_error("describe requires --json")
        describe_json()
        return

    if command == "lifecycle":
        lifecycle(rest)
        return

    root = capability_root()

    if command == "status":
        if rest != ["--human"]:
            usage_error("status requires --human")
        run_jj_status_human(root)
        return

    if command == "diff":
        if rest == ["--human"]:
            completed = run_jj(root, ["diff", "--color=never"], capture=False)
            raise SystemExit(0 if completed.returncode == 0 else 1)
        if rest == ["--json"]:
            diff_json(root)
            return
        usage_error("diff requires --human or --json")

    if command == "changed-files":
        if rest != ["--json"]:
            usage_error("changed-files requires --json")
        print_changed_files_json(root)
        return

    if command == "baseline":
        if rest != ["--json"]:
            usage_error("baseline requires --json")
        baseline_json(root)
        return

    if command == "refresh-base":
        refresh_base(root, rest)
        return

    if command == "publish-change":
        legacy_publish_change_command(rest)
        return

    if command == "publish-commit-stack":
        publish_commit_stack(root, rest)
        return

    if command == "assert-only":
        target = parse_path_argument(rest)
        assert_only(root, target)
        return

    usage_error(f"unsupported command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])
