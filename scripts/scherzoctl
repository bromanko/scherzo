#!/bin/sh
# Development wrapper for the local Scherzo control CLI. Packaged releases may
# replace this with a compiled executable that invokes the same ctl mode.
set -eu
CALLER_CWD=$(pwd -P)
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(dirname -- "$SCRIPT_DIR")
export SCHERZO_CALLER_CWD="$CALLER_CWD"
cd "$ROOT"
exec direnv exec "$ROOT" gleam run -- ctl "$@"
