#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
repo_root=$(CDPATH= cd "$script_dir/.." && pwd)
cd "${SCHERZO_REPO_ROOT:-${DEVENV_ROOT:-$repo_root}}"

child_pid=""
shutdown_requested=0
shutdown_watchdog_pid=""
shutdown_grace_seconds=${SCHERZO_START_SHUTDOWN_GRACE_SECONDS:-15}
use_process_group=0

# With job control enabled, Bash starts the background child in its own process
# group. That keeps terminal Ctrl-C on the wrapper process and lets us forward a
# graceful SIGTERM to the whole Gleam/BEAM process group instead of only the
# immediate `gleam run` process. If job control is unavailable, the child still
# inherits SIGINT ignored and we fall back to signaling the immediate child.
if set -m 2>/dev/null; then
  use_process_group=1
fi

direct_child_is_alive() {
  if [[ -z "$child_pid" ]]; then
    return 1
  fi
  kill -0 "$child_pid" 2>/dev/null
}

process_group_is_alive() {
  if [[ -z "$child_pid" || "$use_process_group" -ne 1 ]]; then
    return 1
  fi
  kill -0 -- "-$child_pid" 2>/dev/null
}

child_is_alive() {
  direct_child_is_alive || process_group_is_alive
}

signal_child() {
  local signal=$1
  if process_group_is_alive; then
    kill "-$signal" -- "-$child_pid" 2>/dev/null || true
  else
    kill "-$signal" "$child_pid" 2>/dev/null || true
  fi
}

start_shutdown_watchdog() {
  if [[ -n "$shutdown_watchdog_pid" ]]; then
    return
  fi

  (
    elapsed=0
    while child_is_alive; do
      sleep 1
      if ! child_is_alive; then
        exit 0
      fi

      # The child runs in a separate process group so terminal Ctrl-C reaches
      # this wrapper first. In interactive shells that process group can become
      # stopped (status T, typically from terminal job-control signals). A
      # stopped BEAM VM cannot run Scherzo's SIGTERM handler or complete halt(0)
      # until it is continued, so keep nudging it while graceful shutdown is in
      # progress.
      signal_child CONT
      elapsed=$((elapsed + 1))

      if [[ "$elapsed" -ge "$shutdown_grace_seconds" ]]; then
        echo "scherzo-start: graceful shutdown still running after ${shutdown_grace_seconds}s; forwarding SIGKILL" >&2
        signal_child KILL
        exit 0
      fi
    done
  ) &
  shutdown_watchdog_pid=$!
}

request_shutdown() {
  local received_signal=$1
  if ! child_is_alive; then
    return
  fi

  if [[ "$shutdown_requested" -eq 0 ]]; then
    shutdown_requested=1
    echo "scherzo-start: received SIG$received_signal; forwarding SIGTERM for graceful shutdown" >&2
    signal_child TERM
    signal_child CONT
    start_shutdown_watchdog
  else
    echo "scherzo-start: received SIG$received_signal again; forwarding SIGKILL" >&2
    signal_child KILL
  fi
}

trap 'request_shutdown INT' INT
trap 'request_shutdown TERM' TERM
trap 'request_shutdown HUP' HUP

(
  # If job control could not isolate the child process group, terminal Ctrl-C is
  # delivered to both wrapper and child. Keep SIGINT ignored in the child so the
  # wrapper can translate Ctrl-C into Scherzo's existing SIGTERM lifecycle path.
  trap '' INT
  exec gleam run -- "$@"
) &
child_pid=$!
if [[ "$use_process_group" -eq 1 ]]; then
  set +m 2>/dev/null || true
fi

status=0
set +e
while true; do
  wait "$child_pid" 2>/dev/null
  wait_status=$?
  if [[ "$wait_status" -ne 127 ]]; then
    status=$wait_status
  fi

  # Bash wait returns early when a trapped signal is handled. In that case the
  # direct child is still alive and we should keep waiting for the graceful
  # shutdown we requested above. Once the direct `gleam run` child has exited,
  # the wrapper must also exit: the BEAM VM has returned control to Gleam, and
  # any remaining process-group members are detached runtime helpers or leaked
  # ports. Waiting on the whole process group here can leave the wrapper stuck
  # after Scherzo has already logged daemon_shutdown_complete.
  if direct_child_is_alive; then
    continue
  fi

  if process_group_is_alive; then
    signal_child TERM
  fi

  break
done
set -e

if [[ -n "$shutdown_watchdog_pid" ]]; then
  kill "$shutdown_watchdog_pid" 2>/dev/null || true
fi

trap - INT TERM HUP
exit "$status"
