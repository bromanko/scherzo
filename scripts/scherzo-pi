#!/bin/sh
# Launch pi for Scherzo dogfood workflows.
#
# Scherzo currently has one pi.command for all routed workflows, so this wrapper
# selects workflow-specific pi flags from the prepared workspace path.
# Bundle-based ExecPlan drafting, revision, and implementation use the same high-capacity model.

set -eu

cwd=$(pwd -P)
research_model=${SCHERZO_RESEARCH_PI_MODEL:-openai-codex/gpt-5.5:xhigh}
execplan_model=${SCHERZO_EXECPLAN_PI_MODEL:-openai-codex/gpt-5.5:xhigh}

resolve_pi_bin() {
  if [ -n "${SCHERZO_PI_BIN:-}" ]; then
    if [ ! -x "$SCHERZO_PI_BIN" ]; then
      printf 'SCHERZO_PI_BIN does not point to an executable: %s\n' "$SCHERZO_PI_BIN" >&2
      return 127
    fi
    printf '%s\n' "$SCHERZO_PI_BIN"
    return 0
  fi

  case "$cwd" in
    */.scherzo/workspaces/*)
      printf 'SCHERZO_PI_BIN is required when launching pi from a Scherzo managed workspace.\n' >&2
      printf 'Start Scherzo from the core devenv, or preserve SCHERZO_PI_BIN through the workspace direnv exec.\n' >&2
      return 127
      ;;
  esac

  # Keep a PATH fallback for explicit manual source-checkout usage outside
  # managed dogfood workspaces.
  if command -v pi >/dev/null 2>&1; then
    printf 'warning: SCHERZO_PI_BIN is unset; using pi from PATH for manual launch\n' >&2
    command -v pi
    return 0
  fi

  printf 'SCHERZO_PI_BIN is unset and pi was not found on PATH.\n' >&2
  printf 'Run from the core Scherzo devenv or set SCHERZO_PI_BIN to the packaged pi executable.\n' >&2
  return 127
}

pi_bin=$(resolve_pi_bin)

run_pi() {
  exec "$pi_bin" "$@"
}

case "$cwd" in
  */.scherzo/workspaces/research/*)
    run_pi --model "$research_model" "$@"
    ;;
  */.scherzo/workspaces/execplan/*|*/.scherzo/workspaces/execplan-revision/*|*/.scherzo/workspaces/execplan-implementation/*)
    run_pi --model "$execplan_model" "$@"
    ;;
  *)
    run_pi "$@"
    ;;
esac
