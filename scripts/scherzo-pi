#!/bin/sh
# Launch pi for Scherzo dogfood workflows.
#
# Scherzo currently has one pi.command for all routed workflows, so this wrapper
# selects workflow-specific pi flags from the prepared workspace path.
# Bundle-based ExecPlan drafting, revision, and implementation use the same high-capacity model.

set -eu

cwd=$(pwd -P)
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(dirname -- "$script_dir")
research_model=${SCHERZO_RESEARCH_PI_MODEL:-openai-codex/gpt-5.5:xhigh}
execplan_model=${SCHERZO_EXECPLAN_PI_MODEL:-openai-codex/gpt-5.5:xhigh}

resolve_pi_bin() {
  if [ -n "${SCHERZO_PI_BIN:-}" ]; then
    printf '%s\n' "$SCHERZO_PI_BIN"
    return 0
  fi

  # Scherzo dogfood runs often invoke this wrapper from a prepared issue
  # workspace via `direnv exec "$workspace_dir"`. That consumer workspace can
  # reset the environment and drop the core checkout's SCHERZO_PI_BIN, causing
  # PATH to pick up a stale user-installed pi. Re-enter the core checkout's
  # direnv once to recover its pinned Nix-packaged pi before falling back.
  if command -v direnv >/dev/null 2>&1 && [ -f "$repo_root/.envrc" ]; then
    core_pi_bin=$(direnv exec "$repo_root" sh -c 'printf "%s\n" "${SCHERZO_PI_BIN:-}"' 2>/dev/null || true)
    core_pi_bin=$(printf '%s\n' "$core_pi_bin" | awk 'NF { last = $0 } END { print last }')
    if [ -n "$core_pi_bin" ]; then
      printf '%s\n' "$core_pi_bin"
      return 0
    fi
  fi

  # Keep a PATH fallback for non-devenv source-checkout usage.
  printf '%s\n' pi
}

pi_bin=$(resolve_pi_bin)

run_pi() {
  if [ "${SCHERZO_PI_SESSION_PERSISTENCE:-0}" = "1" ]; then
    exec "$pi_bin" "$@" --rpc-message-updates off
  fi
  exec "$pi_bin" "$@" --no-session --rpc-message-updates off
}

case "$cwd" in
  */.scherzo/workspaces/research/*)
    run_pi --model "$research_model" --mode rpc "$@"
    ;;
  */.scherzo/workspaces/execplan/*|*/.scherzo/workspaces/execplan-revision/*|*/.scherzo/workspaces/execplan-implementation/*)
    run_pi --model "$execplan_model" --mode rpc "$@"
    ;;
  *)
    run_pi --mode rpc "$@"
    ;;
esac
