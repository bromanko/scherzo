#!/bin/sh
# Launch pi for Scherzo dogfood workflows.
#
# Scherzo currently has one pi.command for all routed workflows, so this wrapper
# selects workflow-specific pi flags from the prepared workspace path.
# ExecPlan drafting, revision, and implementation use the same high-capacity model.

set -eu

cwd=$(pwd -P)
research_model=${SCHERZO_RESEARCH_PI_MODEL:-openai-codex/gpt-5.5:xhigh}
execplan_model=${SCHERZO_EXECPLAN_PI_MODEL:-openai-codex/gpt-5.5:xhigh}

run_pi() {
  if [ "${SCHERZO_PI_SESSION_PERSISTENCE:-0}" = "1" ]; then
    exec pi "$@"
  fi
  exec pi "$@" --no-session
}

case "$cwd" in
  */.scherzo/workspaces/research/*)
    run_pi --model "$research_model" --mode rpc "$@"
    ;;
  */.scherzo/workspaces/execplan/*|*/.scherzo/workspaces/execplan-revision/*|*/.scherzo/workspaces/execplan-implementation/*)
    run_pi --model "$execplan_model" --mode rpc "$@"
    ;;
  *)
    run_pi --mode rpc "$@"
    ;;
esac
