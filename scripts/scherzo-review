    apply_feedback = subparsers.add_parser(
        "apply-feedback",
        help="Apply local review feedback artifacts or write a no-op feedback manifest.",
    )
    apply_feedback.add_argument("--final-review", required=True, help="FinalReview artifact path.")
    apply_feedback.add_argument(
        "--feedback-artifact",
        action="append",
        default=[],
        help="Optional local feedback JSON artifact. Repeat to supply multiple artifacts.",
    )
    apply_feedback.add_argument("--output-dir", required=True, help="Directory for feedback artifacts.")
    apply_feedback.set_defaults(func=apply_feedback_command)

    publish = subparsers.add_parser(
        "publish",
        help="Publish or dry-run publish a final review artifact. Only dry-run is supported in this issue.",
    )
    publish.add_argument("--final-review", required=True, help="FinalReview artifact path.")
    publish.add_argument("--mode", required=True, help="Publish mode. Only dry-run is accepted.")
    publish.add_argument("--output-dir", required=True, help="Directory for publish artifacts.")
    publish.set_defaults(func=publish_command)

    native_preflight = subparsers.add_parser(
        "native-preflight",
        help="Retired standalone native-review workflow preflight; use review-lane contract checks against routed implementation workflows.",
    )
    native_preflight.add_argument(
        "--output-dir",
        default=str(DEFAULT_NATIVE_PREFLIGHT_OUTPUT_DIR),
        help="Directory for native preflight artifacts (default: tmp/scherzo-review-native-preflight).",
    )
    native_preflight.add_argument(
        "--scenario",
        action="append",
        default=[],
        help="Run only the named native preflight scenario. Repeat to select multiple scenarios.",
    )
    native_preflight.set_defaults(func=native_preflight_command)

    validate = subparsers.add_parser("validate", help="Validate a review artifact JSON object.")
    validate.add_argument("--artifact", required=True, help="Artifact path to validate.")
    validate.add_argument(
        "--require-cutover-ready",
        action="store_true",
        help="For preflight manifests, require the fixture/external cutover-readiness gate to be ready.",
    )
    validate.set_defaults(func=validate_command)

    validate_structured = subparsers.add_parser(
        "validate-structured-output",
        help="Validate one structured-output JSON payload from stdin against a named contract.",
    )
    validate_structured.add_argument(
        "--validator",
        required=True,
        help="Named structured-output validator to apply (for example: review_lane_draft).",
    )
    validate_structured.set_defaults(func=validate_structured_output_command)
    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command in {"dry-run", "prepare-native", "run-lane"} and args.repo and not args.pr:
        usage_error("--repo can only be used with --pr")
    try:
        args.func(args)
    except ReviewError as exc:
        if args.command == "run-lane":
            try:
                write_failed_lane_artifacts(args, str(exc))
            except Exception:
                pass
        if args.command == "validate":
            print("REVIEW_ARTIFACT_VALID=error")
        fail(str(exc))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
