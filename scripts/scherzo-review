class ReviewError(Exception):
    pass


def usage_error(message: str) -> None:
    print(f"scherzo-review: {message}", file=sys.stderr)
    sys.exit(2)


def fail(message: str) -> None:
    print(f"scherzo-review: {message}", file=sys.stderr)
    sys.exit(1)


def now_utc() -> str:
    return (
        _datetime.datetime.now(_datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def run_read_only(args: list[str]) -> str:
    proc = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.returncode != 0:
        stderr = proc.stderr.strip()
        stdout = proc.stdout.strip()
        details = stderr or stdout or f"exit code {proc.returncode}"
        raise ReviewError(f"command failed: {' '.join(args)}\n{details}")
    return proc.stdout


def require_command(command: str) -> None:
    if shutil.which(command) is None:
        raise ReviewError(f"required command not found on PATH: {command}")


class DiffFile:
    def __init__(
        self,
        path: str,
        *,
        old_path: str | None = None,
        change_kind: str = "modified",
    ) -> None:
        self.path = path
        self.old_path = old_path
        self.change_kind = change_kind
        self.additions = 0
        self.deletions = 0
        self.hunks = 0
        self.added_lines: list[str] = []
        self.deleted_lines: list[str] = []
        self.hunk_headers: list[str] = []

    def to_changed_area(self) -> dict[str, Any]:
        return {
            "path": self.path,
            "previous_path": self.old_path,
            "subsystem": subsystem_for_path(self.path),
            "language": language_for_path(self.path),
            "change_kind": self.change_kind,
            "additions": self.additions,
            "deletions": self.deletions,
            "hunks": self.hunks,
        }


def normalize_diff_path(path: str) -> str:
    path = path.strip()
    if path == "/dev/null":
        return path
    if path.startswith("a/") or path.startswith("b/"):
        return path[2:]
    return path


def parse_diff_files(diff: str) -> list[DiffFile]:
    files: list[DiffFile] = []
    current: DiffFile | None = None
    pending_old_path: str | None = None

    for line in diff.splitlines():
        if line.startswith("diff --git "):
            parts = line.split()
            if len(parts) >= 4:
                old_path = normalize_diff_path(parts[2])
                new_path = normalize_diff_path(parts[3])
                current = DiffFile(new_path, old_path=old_path if old_path != new_path else None)
                files.append(current)
                pending_old_path = old_path
            continue

        if current is None:
            if line.startswith("+++ ") and not line.startswith("+++ /dev/null"):
                path = normalize_diff_path(line.removeprefix("+++ "))
                current = DiffFile(path)
                files.append(current)
            continue

        if line.startswith("new file mode"):
            current.change_kind = "added"
        elif line.startswith("deleted file mode"):
            current.change_kind = "deleted"
        elif line.startswith("rename from "):
            pending_old_path = line.removeprefix("rename from ").strip()
            current.old_path = pending_old_path
            current.change_kind = "renamed"
        elif line.startswith("rename to "):
            current.path = line.removeprefix("rename to ").strip()
            current.change_kind = "renamed"
        elif line.startswith("--- "):
            old_path = normalize_diff_path(line.removeprefix("--- "))
            if old_path != "/dev/null":
                pending_old_path = old_path
        elif line.startswith("+++ "):
            new_path = normalize_diff_path(line.removeprefix("+++ "))
            if new_path == "/dev/null":
                current.change_kind = "deleted"
                if pending_old_path and pending_old_path != "/dev/null":
                    current.path = pending_old_path
            else:
                current.path = new_path
                if current.change_kind != "renamed" and pending_old_path == "/dev/null":
                    current.change_kind = "added"
        elif line.startswith("@@"):
            current.hunks += 1
            current.hunk_headers.append(line)
        elif line.startswith("+") and not line.startswith("+++"):
            current.additions += 1
            current.added_lines.append(line[1:])
        elif line.startswith("-") and not line.startswith("---"):
            current.deletions += 1
            current.deleted_lines.append(line[1:])

    return files


def language_for_path(path: str) -> str:
    lower = path.lower()
    suffixes = {
        ".gleam": "gleam",
        ".erl": "erlang",
        ".hrl": "erlang",
        ".py": "python",
        ".ts": "typescript",
        ".tsx": "typescript",
        ".js": "javascript",
        ".jsx": "javascript",
        ".rs": "rust",
        ".go": "go",
        ".fs": "fsharp",
        ".fsx": "fsharp",
        ".elm": "elm",
        ".md": "markdown",
        ".yaml": "yaml",
        ".yml": "yaml",
        ".json": "json",
        ".toml": "toml",
        ".nix": "nix",
        ".sh": "shell",
    }
    for suffix, language in suffixes.items():
        if lower.endswith(suffix):
            return language
    if path.startswith("scripts/"):
        return "shell-or-script"
    return "unknown"


def subsystem_for_path(path: str) -> str:
    lower = path.lower()
    if lower.startswith(".scherzo/workflows/schemas/"):
        return "artifact schema contract"
    if lower.startswith(".scherzo/workflows/"):
        return "dogfood workflow"
    if lower.startswith("src/"):
        return "scherzo runtime source"
    if lower.startswith("test/"):
        return "tests"
    if lower.startswith("scripts/"):
        return "workflow helper scripts"
    if lower.startswith("docs/"):
        return "documentation"
    if lower.startswith("examples/workflows/"):
        return "example workflows"
    if lower.startswith("examples/"):
        return "examples"
    if lower.startswith(".config/"):
        return "ci configuration"
    if lower.startswith("nix/") or lower in {"flake.nix", "flake.lock", "devenv.nix", "devenv.yaml"}:
        return "developer tooling"
    if lower in {"gleam.toml", "manifest.toml"}:
        return "gleam package configuration"
    return "repository root"


def source_from_diff_file(path: Path) -> tuple[str, dict[str, Any]]:
    if not path.exists():
        raise ReviewError(f"diff file does not exist: {path}")
    diff = path.read_text()
    return diff, {
        "kind": "diff_file",
        "label": str(path),
        "diff_file": str(path),
    }


def source_from_jj(from_rev: str, to_rev: str) -> tuple[str, dict[str, Any]]:
    require_command("jj")
    diff = run_read_only([
        "jj",
        "diff",
        "--from",
        from_rev,
        "--to",
        to_rev,
        "--git",
        "--color=never",
    ])
    return diff, {
        "kind": "jj_diff",
        "label": f"{from_rev}..{to_rev}",
        "from": from_rev,
        "to": to_rev,
    }


def workspace_driver_command() -> str | None:
    value = os.environ.get("SCHERZO_WORKSPACE_DRIVER", "").strip()
    return value or None


def run_workspace_driver_json(args: list[str]) -> dict[str, Any]:
    driver = workspace_driver_command()
    if not driver:
        raise ReviewError("SCHERZO_WORKSPACE_DRIVER is required for driver-backed review input")
    proc = subprocess.run(
        [driver, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    try:
        payload = json.loads(proc.stdout) if proc.stdout.strip() else None
    except json.JSONDecodeError as exc:
        raise ReviewError(f"workspace driver returned malformed JSON for {' '.join(args)}: {exc}") from exc
    if not isinstance(payload, dict) or payload.get("version") != 1:
        raise ReviewError(f"workspace driver {' '.join(args)} must return a JSON object with version=1")
    if proc.returncode != 0:
        raise ReviewError(str(payload.get("message") or "workspace driver command failed"))
    return payload


def source_from_workspace_driver() -> tuple[str, dict[str, Any]]:
    diff_payload = run_workspace_driver_json(["diff", "--json"])
    changed_payload = run_workspace_driver_json(["changed-files", "--json"])
    text = diff_payload.get("text")
    truncated = diff_payload.get("truncated")
    if not isinstance(text, str) or not isinstance(truncated, bool):
        raise ReviewError("workspace driver diff JSON must include text and truncated fields")
    files = changed_payload.get("files")
    if not isinstance(files, list):
        raise ReviewError("workspace driver changed-files JSON must contain a files list")
    changed_files = []
    for item in files:
        if isinstance(item, dict) and isinstance(item.get("path"), str):
            changed_files.append(item.get("path"))
    return text, {
        "kind": "workspace_driver",
        "label": "workspace driver diff",
        "driver": workspace_driver_command(),
        "diff_truncated": truncated,
        "changed_files": changed_files,
    }


def source_from_pr(pr: str, repo: str | None) -> tuple[str, dict[str, Any]]:
    require_command("gh")
    args = ["gh", "pr", "diff", pr, "--color=never"]
    if repo:
        args.extend(["--repo", repo])
    diff = run_read_only(args)

    metadata: dict[str, Any] = {
        "kind": "github_pr",
        "label": f"PR {pr}" if not repo else f"{repo} PR {pr}",
        "pr": pr,
        "repo": repo,
    }
    view_args = [
        "gh",
        "pr",
        "view",
        pr,
        "--json",
        "number,title,url,baseRefName,headRefName,author",
    ]
    if repo:
        view_args.extend(["--repo", repo])
    try:
        view = json.loads(run_read_only(view_args))
        metadata.update({
            "pr_number": view.get("number"),
            "title": view.get("title"),
            "url": view.get("url"),
            "base_ref": view.get("baseRefName"),
            "head_ref": view.get("headRefName"),
            "author": (view.get("author") or {}).get("login"),
        })
    except (ReviewError, json.JSONDecodeError):
        metadata["metadata_note"] = "gh pr view metadata was unavailable; diff was still read-only"
    return diff, metadata


def primary_subsystems(files: list[DiffFile]) -> list[str]:
    seen: list[str] = []
    for file in files:
        subsystem = subsystem_for_path(file.path)
        if subsystem not in seen:
            seen.append(subsystem)
    return seen


def summarize_change(files: list[DiffFile], source: dict[str, Any]) -> str:
    if not files:
        return f"No changed files were detected in {source.get('label', 'the supplied diff')}."
    subsystems = primary_subsystems(files)
    total_additions = sum(file.additions for file in files)
    total_deletions = sum(file.deletions for file in files)
    subsystem_text = ", ".join(subsystems[:4])
    if len(subsystems) > 4:
        subsystem_text += f", and {len(subsystems) - 4} more"
    return (
        f"The supplied {source.get('kind', 'diff')} changes {len(files)} file(s) "
        f"across {subsystem_text}. The parsed patch contains "
        f"{total_additions} added line(s) and {total_deletions} deleted line(s)."
    )


def infer_acceptance_criteria(files: list[DiffFile]) -> list[str]:
    subsystems = set(primary_subsystems(files))
    criteria: list[str] = []
    if "artifact schema contract" in subsystems:
        criteria.append(
            "Review artifacts should declare schema_version 1 and follow the documented contract."
        )
    if "workflow helper scripts" in subsystems:
        criteria.append(
            "Helper scripts should have deterministic local output and avoid PR, Linear, or remote mutation in dry-run paths."
        )
    if "dogfood workflow" in subsystems or "example workflows" in subsystems:
        criteria.append(
            "Workflow changes should preserve existing review behavior while making the new artifacts easy to locate."
        )
    if "scherzo runtime source" in subsystems:
        criteria.append(
            "Runtime source changes should preserve Scherzo daemon behavior and pass the relevant Gleam validation."
        )
    if "tests" in subsystems:
        criteria.append("Updated or added tests should cover the changed contract and pass deterministically.")
    if "documentation" in subsystems:
        criteria.append("Documentation should be sufficient for later review lanes to implement against the artifact contract.")
    if not criteria:
        criteria.append("Reviewers should confirm that the observed diff matches the implementation intent and has appropriate validation.")
    return criteria


def has_path(files: list[DiffFile], predicate: Any) -> bool:
    return any(predicate(file.path.lower()) for file in files)


def build_risk_profile(files: list[DiffFile]) -> dict[str, Any]:
    if not files:
        return {
            "level": "low",
            "rationale": "No changed files were detected.",
            "risk_areas": [],
        }

    risk_areas: list[str] = []
    level = "low"

    if has_path(files, lambda p: p.startswith("src/") and ("state" in p or "linear" in p or "control" in p)):
        level = "high"
        risk_areas.append("runtime state, Linear, or control-plane code changed")
    elif has_path(files, lambda p: p.startswith("src/")):
        level = "medium"
        risk_areas.append("runtime source changed")

    if has_path(files, lambda p: p.startswith("scripts/")):
        if level == "low":
            level = "medium"
        risk_areas.append("workflow helper script changed")

    if has_path(files, lambda p: p.startswith(".scherzo/workflows/") or p.startswith("examples/workflows/")):
        if level == "low":
            level = "medium"
        risk_areas.append("workflow definition or prompt changed")

    if has_path(files, lambda p: "lock" in p or p.startswith("nix/") or p in {"flake.nix", "devenv.nix"}):
        if level == "low":
            level = "medium"
        risk_areas.append("tooling or dependency surface changed")

    if has_path(files, lambda p: p.startswith(".scherzo/workflows/schemas/")):
        risk_areas.append("artifact schema contract changed")

    if not risk_areas:
        risk_areas.append("limited to documentation or tests")

    rationale = {
        "low": "The diff appears limited to low-risk documentation/test areas or has no changed files.",
        "medium": "The diff touches workflow, script, tooling, or runtime-adjacent files that can affect automation behavior.",
        "high": "The diff touches high-impact runtime state, Linear, or control-plane areas that need careful validation.",
    }[level]
    return {
        "level": level,
        "rationale": rationale,
        "risk_areas": risk_areas,
    }


def suggested_review_lanes(files: list[DiffFile]) -> list[dict[str, str]]:
    lanes: list[dict[str, str]] = []

    def add(lane_id: str, name: str, reason: str) -> None:
        if not any(lane["id"] == lane_id for lane in lanes):
            lanes.append({"id": lane_id, "name": name, "reason": reason})

    if not files:
        add("change-intent", "Change intent review", "No file changes were parsed; confirm the diff source and intent.")
        return lanes

    add(
        "correctness",
        "Correctness reviewer",
        "Check behavior and logic changes, with blocking bug findings gated on executable evidence.",
    )
    add(
        "test-quality",
        "Test-quality reviewer",
        "Evaluate whether changed behavior has meaningful committed tests and concrete edge-case coverage.",
    )
    add(
        "idioms-maintainability",
        "Idioms / maintainability reviewer",
        "Review clarity, naming, structure, error handling, and maintainability priority.",
    )
    add(
        "security-performance",
        "Security / performance risk reviewer",
        "Scale security and performance depth from the ReviewBrief risk profile.",
    )

    if has_path(files, lambda p: p.endswith(".gleam") or p.startswith("src/") or p.startswith("test/")):
        add("gleam-code-review", "Gleam code review", "Gleam source or tests changed.")
        add("test-review", "Test review", "Source or test changes should have deterministic coverage.")

    if has_path(files, lambda p: p.startswith("scripts/") or p.startswith(".scherzo/workflows/")):
        add("workflow-contract-review", "Workflow contract review", "Workflow scripts or DAG prompts changed.")

    if has_path(files, lambda p: p.startswith(".scherzo/workflows/schemas/") or "review-artifact" in p):
        add("artifact-contract-review", "Artifact contract review", "Review artifact schema or documentation changed.")

    if has_path(files, lambda p: p.startswith("scripts/") or "linear" in p or "github" in p or "token" in p or "secret" in p):
        add("security-review", "Security review", "The diff may affect shell execution, external services, or secret handling.")

    if has_path(files, lambda p: p.startswith("src/scherzo/orchestrator") or p.startswith("src/scherzo/state") or p.startswith("src/scherzo/workflow_run")):
        add("performance-review", "Performance review", "Runtime orchestration/state paths can affect daemon throughput or recovery cost.")

    if not lanes:
        add("general-code-review", "General review", "No specialized lane was inferred from file paths.")
    return lanes


def parse_test_status(values: list[str]) -> list[dict[str, str]]:
    statuses: list[dict[str, str]] = []
    allowed = {"passed", "failed", "skipped", "not_run", "unknown"}
    for value in values:
        name, sep, rest = value.partition("=")
        if not sep or not name.strip() or not rest.strip():
            raise ReviewError("--test-status must be NAME=STATUS[:SUMMARY]")
        status, _sep, summary = rest.partition(":")
        status = status.strip()
        if status not in allowed:
            raise ReviewError(
                "--test-status status must be one of " + ", ".join(sorted(allowed))
            )
        statuses.append({
            "name": name.strip(),
            "status": status,
            "summary": summary.strip() or f"Reported as {status} by dry-run caller.",
            "source": "cli",
        })
    if statuses:
        return statuses
    return [{
        "name": "unspecified",
        "status": "unknown",
        "summary": "No test or build status was supplied to the review dry-run entrypoint.",
        "source": "not_supplied",
    }]


def build_review_brief(
    *,
    source: dict[str, Any],
    diff: str,
    files: list[DiffFile],
    test_status: list[dict[str, str]],
    generated_at: str,
) -> dict[str, Any]:
    return {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_brief",
        "generated_at_utc": generated_at,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "dry-run",
        },
        "source": {
            **source,
            "diff_sha256": sha256_text(diff),
            "changed_file_count": len(files),
        },
        "implementation_summary": summarize_change(files, source),
        "changed_areas": [file.to_changed_area() for file in files],
        "inferred_acceptance_criteria": infer_acceptance_criteria(files),
        "risk_profile": build_risk_profile(files),
        "suggested_review_lanes": suggested_review_lanes(files),
        "test_build_status": test_status,
        "notes": [
            "Generated from a local dry-run. It did not post PR comments, update Linear, push branches, or mutate remote state.",
            "The brief is heuristic and should orient later review lanes rather than replace direct diff inspection.",
        ],
    }


def is_test_path(path: str) -> bool:
    lower = path.lower()
    return (
        lower.startswith("test/")
        or "/test/" in lower
        or lower.endswith("_test.gleam")
        or lower.endswith("_test.py")
        or lower.endswith(".test.ts")
        or lower.endswith(".test.tsx")
        or lower.endswith("_test.go")
        or lower.endswith("_test.rs")
    )


def is_implementation_path(path: str) -> bool:
    lower = path.lower()
    if is_test_path(lower):
        return False
    if lower.startswith(("src/", "scripts/", ".scherzo/workflows/", "examples/workflows/")):
        return True
    return lower.endswith((
        ".gleam",
        ".erl",
        ".hrl",
        ".py",
        ".sh",
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".rs",
        ".go",
        ".fs",
        ".fsx",
        ".elm",
    ))


def is_production_source_path(path: str) -> bool:
    lower = path.lower()
    return lower.startswith("src/") and not is_test_path(lower)


def significant_added_lines(file: DiffFile) -> list[str]:
    lines: list[str] = []
    for line in file.added_lines:
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("//") or stripped.startswith("#"):
            continue
        lines.append(line)
    return lines


def file_location(file: DiffFile) -> dict[str, Any]:
    location: dict[str, Any] = {"path": file.path}
    if file.hunk_headers:
        location["diff_hunk"] = file.hunk_headers[0]
    return location


def is_documentation_path(path: str) -> bool:
    lower = path.lower()
    return lower.startswith("docs/") or lower.endswith(".md")


def is_workflow_path(path: str) -> bool:
    lower = path.lower()
    return lower.startswith(".scherzo/workflows/") or lower.startswith("examples/workflows/")


def is_script_path(path: str) -> bool:
    return path.lower().startswith("scripts/")


def is_control_plane_source_path(path: str) -> bool:
    lower = path.lower()
    if not lower.startswith("src/"):
        return False
    return any(token in lower for token in [
        "/control/",
        "/state/",
        "linear",
        "parser",
        "parse",
        "process",
        "filesystem",
        "file_system",
        "workflow",
        "orchestrator",
        "workspace",
    ])


def has_review_boundary_token(path: str) -> bool:
    lower = path.lower()
    return any(token in lower for token in [
        "parse",
        "parser",
        "json",
        "yaml",
        "filesystem",
        "file_system",
        "file",
        "path",
        "process",
        "command",
        "shell",
        "state",
        "linear",
        "control",
        "workflow",
        "workspace",
    ])


def location_rank(file: DiffFile, concern: str | None) -> tuple[int, str]:
    lower = file.path.lower()
    documentation_concern = concern == "documentation"

    if documentation_concern:
        if is_documentation_path(lower):
            base = 0
        elif is_workflow_path(lower) or is_script_path(lower):
            base = 5
        elif lower.startswith("src/"):
            base = 6
        else:
            base = 10
    elif is_control_plane_source_path(lower):
        base = 0
    elif is_workflow_path(lower) or is_script_path(lower):
        base = 1
    elif lower.startswith("src/"):
        base = 2
    elif lower.startswith("test/"):
        base = 8
    elif is_documentation_path(lower):
        base = 30
    else:
        base = 10

    if not documentation_concern and has_review_boundary_token(lower):
        base -= 1
    return base, lower


def unique_files(files: list[DiffFile]) -> list[DiffFile]:
    unique: list[DiffFile] = []
    seen: set[str] = set()
    for file in files:
        key = file.path
        if key not in seen:
            unique.append(file)
            seen.add(key)
    return unique


def ranked_unique_files(files: list[DiffFile], concern: str | None = None) -> list[DiffFile]:
    unique = unique_files(files)
    return [
        file for _index, file in sorted(
            enumerate(unique),
            key=lambda item: (*location_rank(item[1], concern), item[0]),
        )
    ]


def dedupe_locations(locations: list[dict[str, Any]]) -> list[dict[str, Any]]:
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for location in locations:
        path = location.get("path")
        if not isinstance(path, str) or not path:
            continue
        diff_hunk = location.get("diff_hunk")
        key = (path, diff_hunk if isinstance(diff_hunk, str) else "")
        if key not in seen:
            deduped.append(location)
            seen.add(key)
    return deduped


def locations_for_files(
    files: list[DiffFile], fallback: str = ".", concern: str | None = None
) -> list[dict[str, Any]]:
    if not files:
        return [{"path": fallback}]
    locations = [file_location(file) for file in ranked_unique_files(files, concern)[:5]]
    return dedupe_locations(locations) or [{"path": fallback}]


def short_file_list(files: list[DiffFile], limit: int = 5) -> str:
    unique = unique_files(files)
    paths = [file.path for file in unique[:limit]]
    if len(unique) > limit:
        paths.append(f"and {len(unique) - limit} more")
    return ", ".join(paths) if paths else "no changed files"


def make_finding(
    *,
    lane_prefix: str,
    index: int,
    category: str,
    severity: str,
    evidence_type: str,
    verified: bool,
    blocking: bool,
    locations: list[dict[str, Any]],
    summary: str,
    details: str,
    suggested_fix: str,
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    finding: dict[str, Any] = {
        "id": f"{lane_prefix}-{index:03d}",
        "category": category,
        "severity": severity,
        "evidence_type": evidence_type,
        "verified": verified,
        "blocking": blocking,
        "locations": dedupe_locations(locations),
        "summary": summary,
        "details": details,
        "suggested_fix": suggested_fix,
    }
    if extra:
        finding.update(extra)
    return finding


def make_review_note(
    *,
    lane_prefix: str,
    index: int,
    kind: str,
    category: str,
    severity: str,
    locations: list[dict[str, Any]],
    summary: str,
    details: str,
    suggested_action: str,
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    note: dict[str, Any] = {
        "id": f"{lane_prefix}-note-{index:03d}",
        "kind": kind,
        "category": category,
        "severity": severity,
        "locations": dedupe_locations(locations),
        "summary": summary,
        "details": details,
        "suggested_action": suggested_action,
    }
    if extra:
        note.update(extra)
    return note


def brief_test_statuses(brief: dict[str, Any]) -> list[dict[str, Any]]:
    statuses = brief.get("test_build_status", [])
    if not isinstance(statuses, list):
        return []
    return [status for status in statuses if isinstance(status, dict)]


def status_summary(status: dict[str, Any]) -> str:
    name = status.get("name", "unnamed")
    state = status.get("status", "unknown")
    summary = status.get("summary", "no summary")
    source = status.get("source", "unknown source")
    return f"{name}={state} ({summary}; source={source})"


def line_has_assertion(line: str) -> bool:
    lower = line.lower()
    return any(token in lower for token in [
        "assert ",
        "assert(",
        "assert_",
        "expect",
        "should.",
        " == ",
        " != ",
        " ok(",
        " error(",
    ])


def is_test_support_path(path: str) -> bool:
    lower = path.lower()
    return any(part in lower for part in [
        "/fixtures/",
        "fixture",
        "/support/",
        "test/support",
        "golden",
        "snapshot",
        "mock",
        "fake",
    ])


def is_import_or_module_line(line: str) -> bool:
    stripped = line.strip()
    lower = stripped.lower()
    return (
        lower.startswith(("import ", "from ", "use ", "package ", "module "))
        or stripped.startswith(("@", "#"))
    )


def is_behavioral_test_declaration(line: str) -> bool:
    stripped = line.strip()
    lower = stripped.lower()
    return bool(
        re.search(r"\b(pub\s+)?fn\s+[a-z0-9_]*_test\s*\(", lower)
        or re.search(r"\bdef\s+test_[a-z0-9_]*\s*\(", lower)
        or re.search(r"\bfunc\s+test[a-z0-9_]*\s*\(", lower)
        or lower.startswith("test(")
        or lower.startswith("it(")
        or lower.startswith("describe(")
        or lower == "#[test]"
    )


def is_non_behavioral_test_line(file: DiffFile, line: str) -> bool:
    stripped = line.strip()
    lower = stripped.lower()
    if is_import_or_module_line(line):
        return True
    if is_test_support_path(file.path):
        return True
    if stripped in {"{", "}", "[", "]", "(", ")", ","}:
        return True
    if re.fullmatch(r"[}\]),;]+", stripped):
        return True
    if re.search(r"\b(pub\s+)?fn\s+(helper|fixture|setup|teardown|mock|fake|sample|make|new)_", lower):
        return True
    if any(token in lower for token in [
        "fixture",
        "helper",
        "setup",
        "teardown",
        "before_each",
        "after_each",
        "mock",
        "fake",
        "stub",
        "golden",
        "snapshot",
        "sample",
        "test_async",
        "new_barrier",
        "drain_subject",
        "create_directory",
        "write(",
        "read(",
    ]):
        return True
    return False


def test_file_change_role(file: DiffFile) -> str:
    added = significant_added_lines(file)
    if not added:
        return "empty"
    if any(line_has_assertion(line) for line in added):
        return "assertion_bearing"
    if any(is_behavioral_test_declaration(line) for line in added):
        return "behavior_without_assertion"
    if all(is_non_behavioral_test_line(file, line) for line in added):
        return "non_behavioral"
    return "unclear_without_assertion"


STRING_LITERAL_RE = re.compile(r'"(?:\\.|[^"\\])*"')
IDENTIFIER_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9_])(?:todo|unreachable)(?![A-Za-z0-9_])")


def code_signal_line(line: str) -> str:
    return STRING_LITERAL_RE.sub('""', line).strip().lower()


def correctness_static_signal(line: str) -> bool:
    code = code_signal_line(line)
    return (
        "let assert" in code
        or "panic(" in code
        or code.startswith("panic ")
        or IDENTIFIER_TOKEN_RE.search(code) is not None
    )


def production_must_fix_construct_signal(line: str) -> bool:
    code = code_signal_line(line)
    return (
        "let assert" in code
        or "panic(" in code
        or code.startswith("panic ")
        or re.search(r"(?<![A-Za-z0-9_])todo(?![A-Za-z0-9_])", code) is not None
    )


def correctness_lane_findings(
    brief: dict[str, Any], files: list[DiffFile]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str], str]:
    findings: list[dict[str, Any]] = []
    notes: list[dict[str, Any]] = []
    checks = [
        "checked supplied validation status for failed executable evidence",
        "scanned implementation additions for static correctness suspicion signals",
        "identified high-risk changed paths for non-blocking follow-up test suggestions",
    ]

    failed_statuses = [
        status for status in brief_test_statuses(brief) if status.get("status") == "failed"
    ]
    implementation_files = [file for file in files if is_implementation_path(file.path)]
    if failed_statuses:
        findings.append(make_finding(
            lane_prefix="correctness",
            index=len(findings) + 1,
            category="correctness",
            severity="high",
            evidence_type="test",
            verified=True,
            blocking=True,
            locations=locations_for_files(implementation_files or files, concern="correctness"),
            summary="Executable validation failed for the changed implementation.",
            details=(
                "The ReviewBrief reports failing executable validation: "
                + "; ".join(status_summary(status) for status in failed_statuses)
                + ". This satisfies the correctness lane evidence gate for a blocking bug finding."
            ),
            suggested_fix="Reproduce the failing validation locally, fix the behavior under test, and rerun the failing command before publishing.",
            extra={
                "finding_type": "proven_bug",
                "executable_evidence": failed_statuses,
            },
        ))

    suspicious_files: list[DiffFile] = []
    suspicious_examples: list[str] = []
    for file in implementation_files:
        for line in significant_added_lines(file):
            if correctness_static_signal(line):
                suspicious_files.append(file)
                if len(suspicious_examples) < 5:
                    suspicious_examples.append(f"{file.path}: {line.strip()}")
                break

    if suspicious_files:
        findings.append(make_finding(
            lane_prefix="correctness",
            index=len(findings) + 1,
            category="correctness",
            severity="medium",
            evidence_type="static",
            verified=False,
            blocking=False,
            locations=locations_for_files(suspicious_files, concern="correctness"),
            summary="Static-only correctness concern downgraded to non-blocking suspicion.",
            details=(
                "Added implementation lines include failure-prone constructs, but this lane did not receive a failing test, repro script, "
                "or equivalent executable scenario proving a behavior bug. Per the lane contract this is a suspicion, not a blocker. "
                "Examples: " + "; ".join(suspicious_examples)
            ),
            suggested_fix="Inspect the flagged construct, add an executable regression test if it represents a real bug, or replace it with explicit error handling.",
            extra={"finding_type": "suspicion"},
        ))

    follow_up_files = [
        file for file in implementation_files
        if is_control_plane_source_path(file.path) or is_workflow_path(file.path) or is_script_path(file.path)
    ]
    if follow_up_files and not failed_statuses:
        notes.append(make_review_note(
            lane_prefix="correctness",
            index=len(notes) + 1,
            kind="follow_up_test",
            category="correctness",
            severity="info",
            locations=locations_for_files(follow_up_files, concern="correctness"),
            summary="Consider a focused test or repro for the highest-risk changed behavior.",
            details=(
                "The changed paths include runtime, workflow, script, or control-plane boundaries, but this lane did not receive "
                "executable evidence proving a bug. This is a non-blocking prompt to add or confirm a targeted regression check, not a proven correctness finding."
            ),
            suggested_action="If the changed boundary has important edge behavior, add a deterministic test or reproduction that would fail for the risky case.",
            extra={"review_priority": "follow-up"},
        ))

    empty_reason = "No failed validation status or static correctness suspicion signals were found."
    return findings, notes, checks, empty_reason


def proposed_test_cases(brief: dict[str, Any], source_files: list[DiffFile]) -> list[str]:
    proposals: list[str] = []
    for file in source_files[:3]:
        proposals.append(
            f"Exercise the changed behavior in {file.path}, covering the main success path and at least one edge or error case."
        )
    criteria = brief.get("inferred_acceptance_criteria", [])
    if isinstance(criteria, list):
        for criterion in criteria[:2]:
            if isinstance(criterion, str) and criterion.strip():
                proposals.append(f"Verify acceptance criterion: {criterion}")
    if not proposals:
        proposals.append("Add a focused regression test that would fail before the change and pass after it.")
    return proposals


def test_quality_lane_findings(
    brief: dict[str, Any], files: list[DiffFile]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str], str]:
    findings: list[dict[str, Any]] = []
    notes: list[dict[str, Any]] = []
    checks = [
        "compared implementation file changes with committed test file changes",
        "classified changed tests as behavioral, assertion-bearing, helper, fixture, setup, import-only, or mechanical edits",
        "scanned changed tests for assertion-bearing additions and shallow assertion patterns",
        "generated concrete test-case proposals for important uncovered source changes",
    ]
    source_files = [file for file in files if is_implementation_path(file.path)]
    test_files = [file for file in files if is_test_path(file.path)]
    test_roles = {file.path: test_file_change_role(file) for file in test_files}

    if source_files and not test_files:
        proposals = proposed_test_cases(brief, source_files)
        findings.append(make_finding(
            lane_prefix="test-quality",
            index=len(findings) + 1,
            category="testing",
            severity="medium",
            evidence_type="static",
            verified=True,
            blocking=False,
            locations=locations_for_files(source_files, concern="testing"),
            summary="Implementation changed without committed test coverage in the diff.",
            details=(
                "The diff changes implementation-relevant files ("
                + short_file_list(source_files)
                + ") but no test files were parsed. Important gaps should be covered before relying on manual review alone."
            ),
            suggested_fix="Add or update focused tests for the changed behavior before publishing.",
            extra={"proposed_tests": proposals},
        ))

    non_behavioral_test_files = [
        file for file in test_files
        if test_roles.get(file.path) in {"non_behavioral", "empty"}
    ]
    if source_files and test_files and len(non_behavioral_test_files) == len(test_files):
        notes.append(make_review_note(
            lane_prefix="test-quality",
            index=len(notes) + 1,
            kind="coverage_note",
            category="testing",
            severity="info",
            locations=locations_for_files(source_files, concern="testing"),
            summary="Implementation changed alongside only non-behavioral test edits.",
            details=(
                "The changed test files appear to be import-only, setup/helper-only, fixture/support-only, or mechanical edits. "
                "That is not a weak-test finding by itself, but reviewers may still want to confirm behavioral coverage exists elsewhere."
            ),
            suggested_action="If no existing test exercises the changed behavior, add a focused regression test rather than relying on helper or fixture churn.",
            extra={
                "review_priority": "coverage-follow-up",
                "changed_test_roles": test_roles,
            },
        ))

    assertion_free_test_files = [
        file for file in test_files
        if test_roles.get(file.path) == "behavior_without_assertion"
    ]
    if assertion_free_test_files:
        findings.append(make_finding(
            lane_prefix="test-quality",
            index=len(findings) + 1,
            category="testing",
            severity="low",
            evidence_type="static",
            verified=True,
            blocking=False,
            locations=locations_for_files(assertion_free_test_files, concern="testing"),
            summary="New behavioral tests lack visible assertions.",
            details=(
                "These additions introduce recognizable test cases but no assertion or expectation checks. Helper-only, fixture-only, setup-only, "
                "import-only, and mechanical edits are excluded from this finding."
            ),
            suggested_fix="Ensure each new behavioral test asserts the result, emitted artifact, or error path that matters.",
            extra={"review_priority": "should-fix", "changed_test_roles": test_roles},
        ))

    shallow_assertion_files: list[DiffFile] = []
    for file in test_files:
        for line in significant_added_lines(file):
            lower = line.lower()
            if "assert true" in lower or "== true" in lower or "== false" in lower:
                shallow_assertion_files.append(file)
                break
    if shallow_assertion_files:
        findings.append(make_finding(
            lane_prefix="test-quality",
            index=len(findings) + 1,
            category="testing",
            severity="low",
            evidence_type="static",
            verified=True,
            blocking=False,
            locations=locations_for_files(shallow_assertion_files, concern="testing"),
            summary="Changed tests include potentially shallow boolean assertions.",
            details="The changed test assertions appear to check bare booleans, which can hide the behavior being protected and make failures less diagnostic.",
            suggested_fix="Assert the domain result, returned value, emitted artifact, or exact error shape instead of a generic boolean when practical.",
            extra={"review_priority": "optional/nit"},
        ))

    empty_reason = "Changed implementation and test files did not trigger the first-version test-quality finding heuristics."
    return findings, notes, checks, empty_reason


def maintainability_lane_findings(
    _brief: dict[str, Any], files: list[DiffFile]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str], str]:
    findings: list[dict[str, Any]] = []
    notes: list[dict[str, Any]] = []
    checks = [
        "scanned production source additions for must-fix panic/todo/let assert constructs",
        "recorded patch size as a review note unless tied to a concrete maintainability issue",
        "scanned additions for optional whitespace nits",
    ]

    must_fix_files: list[DiffFile] = []
    must_fix_examples: list[str] = []
    for file in files:
        if not is_production_source_path(file.path):
            continue
        for line in significant_added_lines(file):
            if production_must_fix_construct_signal(line):
                must_fix_files.append(file)
                if len(must_fix_examples) < 5:
                    must_fix_examples.append(f"{file.path}: {line.strip()}")
                break
    if must_fix_files:
        findings.append(make_finding(
            lane_prefix="idioms",
            index=len(findings) + 1,
            category="maintainability",
            severity="high",
            evidence_type="static",
            verified=True,
            blocking=True,
            locations=locations_for_files(must_fix_files, concern="maintainability"),
            summary="Production source adds process-fatal or test-only constructs.",
            details=(
                "The repository production lint policy forbids adding let assert, panic, or todo in src/. "
                "Examples: " + "; ".join(must_fix_examples)
            ),
            suggested_fix="Replace the construct with explicit Result/error handling or a narrow, documented lint suppression only when the invariant is intentionally process-fatal.",
            extra={"review_priority": "must-fix"},
        ))

    total_delta = sum(file.additions + file.deletions for file in files)
    if len(files) > 12 or total_delta > 500:
        notes.append(make_review_note(
            lane_prefix="idioms",
            index=len(notes) + 1,
            kind="review_note",
            category="maintainability",
            severity="info",
            locations=locations_for_files(files, concern="maintainability"),
            summary="Large diff may be hard to review as a single change.",
            details=f"The parsed diff touches {len(files)} file(s) and {total_delta} changed line(s). This is reviewability context, not a concrete maintainability finding by itself.",
            suggested_action="If the change combines unrelated mechanical, test, documentation, and behavior edits, consider splitting or clearly summarizing the structure for reviewers.",
            extra={"review_priority": "review-note"},
        ))

    whitespace_files: list[DiffFile] = []
    for file in files:
        for line in file.added_lines:
            if line.rstrip() != line:
                whitespace_files.append(file)
                break
    if whitespace_files:
        findings.append(make_finding(
            lane_prefix="idioms",
            index=len(findings) + 1,
            category="maintainability",
            severity="info",
            evidence_type="static",
            verified=True,
            blocking=False,
            locations=locations_for_files(whitespace_files, concern="maintainability"),
            summary="Added lines contain trailing whitespace.",
            details="Trailing whitespace is a low-value nit, but removing it reduces noisy future diffs.",
            suggested_fix="Trim the trailing whitespace or rely on the project formatter if it owns the affected file type.",
            extra={"review_priority": "optional/nit"},
        ))

    empty_reason = "No concrete must-fix, should-fix, or optional/nit maintainability findings triggered."
    return findings, notes, checks, empty_reason


def risk_profile_level(brief: dict[str, Any]) -> str:
    risk_profile = brief.get("risk_profile")
    if not isinstance(risk_profile, dict):
        return "unknown"
    level = risk_profile.get("level")
    return level if isinstance(level, str) and level else "unknown"


def risk_profile_areas(brief: dict[str, Any]) -> list[str]:
    risk_profile = brief.get("risk_profile")
    if not isinstance(risk_profile, dict):
        return []
    areas = risk_profile.get("risk_areas", [])
    if not isinstance(areas, list):
        return []
    return [area for area in areas if isinstance(area, str)]


def security_performance_depth(brief: dict[str, Any]) -> str:
    level = risk_profile_level(brief)
    if level == "high":
        return "deep"
    if level in {"medium", "unknown"}:
        return "standard"
    return "lightweight"


SECRET_ASSIGNMENT_RE = re.compile(
    r"(?i)(api[_-]?key|secret|token|password)\s*[:=]\s*['\"]([^'\"]{8,})['\"]"
)
STRING_LITERAL_RE = re.compile(r"'(?:\\.|[^'\\])*'|\"(?:\\.|[^\"\\])*\"")


def looks_like_placeholder_secret(value: str) -> bool:
    lower = value.lower()
    return any(token in lower for token in [
        "example",
        "dummy",
        "placeholder",
        "redacted",
        "test",
        "changeme",
        "<",
        "$",
    ])


def line_without_string_literals(line: str) -> str:
    return STRING_LITERAL_RE.sub("", line)


def line_has_concrete_process_risk(line: str) -> bool:
    lower = line_without_string_literals(line).lower().replace(" ", "")
    return any(token in lower for token in [
        "shell=true",
        "os.system(",
        ":os.cmd",
        "system.cmd",
    ])


def security_performance_lane_findings(
    brief: dict[str, Any], files: list[DiffFile]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str], str, str]:
    depth = security_performance_depth(brief)
    checks = [
        f"selected {depth} review depth from ReviewBrief risk level {risk_profile_level(brief)}",
        "always scanned additions for hard-coded secret patterns",
    ]
    if depth in {"standard", "deep"}:
        checks.extend([
            "scanned for concrete shell/process execution hazards",
            "recorded broad shell/process, filesystem, network, parsing, and performance surfaces as risk notes",
        ])
    if depth == "lightweight":
        checks.append("skipped deep security/performance heuristics because the brief marked the change low risk")

    findings: list[dict[str, Any]] = []
    notes: list[dict[str, Any]] = []
    secret_files: list[DiffFile] = []
    secret_examples: list[str] = []
    concrete_process_files: list[DiffFile] = []
    process_files: list[DiffFile] = []
    filesystem_or_network_files: list[DiffFile] = []
    performance_files: list[DiffFile] = []

    for file in files:
        for line in significant_added_lines(file):
            match = SECRET_ASSIGNMENT_RE.search(line)
            if match and not looks_like_placeholder_secret(match.group(2)):
                secret_files.append(file)
                if len(secret_examples) < 3:
                    secret_examples.append(f"{file.path}: {match.group(1)} assignment")
                continue

            lower = line.lower()
            if depth in {"standard", "deep"}:
                if any(token in lower for token in [
                    "shell=true",
                    "os.system",
                    "subprocess.run",
                    "subprocess.popen",
                    ":os.cmd",
                    "system.cmd",
                    "process.run",
                    "curl ",
                ]):
                    process_files.append(file)
                    if line_has_concrete_process_risk(line):
                        concrete_process_files.append(file)
                if any(token in lower for token in [
                    "open(",
                    "read_text",
                    "write_text",
                    "simplifile.",
                    "json.loads",
                    "yaml",
                    "http",
                    "socket",
                    "request(",
                ]):
                    filesystem_or_network_files.append(file)
                if any(token in lower for token in [
                    "process.sleep",
                    "send_after",
                    "while true",
                    "for (;;)",
                    "append(",
                    "list.append",
                ]):
                    performance_files.append(file)

    if secret_files:
        findings.append(make_finding(
            lane_prefix="security-performance",
            index=len(findings) + 1,
            category="security",
            severity="critical",
            evidence_type="static",
            verified=True,
            blocking=True,
            locations=locations_for_files(secret_files, concern="security"),
            summary="Potential hard-coded secret added to the diff.",
            details="Added lines look like literal credential assignments: " + "; ".join(secret_examples),
            suggested_fix="Remove the literal secret, rotate it if it was real, and read credentials from the approved environment or secret store instead.",
            extra={"review_priority": "must-fix", "review_depth": depth},
        ))

    if concrete_process_files:
        findings.append(make_finding(
            lane_prefix="security-performance",
            index=len(findings) + 1,
            category="security",
            severity="medium",
            evidence_type="static",
            verified=True,
            blocking=False,
            locations=locations_for_files(concrete_process_files, concern="security"),
            summary="Changed code adds a concrete shell execution hazard.",
            details="Added lines use shell=True, os.system, or an equivalent shell command primitive. That is specific enough to review as a concrete security finding.",
            suggested_fix="Avoid invoking a shell; pass an argv list to the process runner, validate any user-controlled arguments, and cover failure behavior in tests.",
            extra={"review_priority": "should-fix", "review_depth": depth},
        ))

    if process_files:
        notes.append(make_review_note(
            lane_prefix="security-performance",
            index=len(notes) + 1,
            kind="risk_note",
            category="security",
            severity="info",
            locations=locations_for_files(process_files, concern="security"),
            summary="Changed code touches process or shell-adjacent boundaries.",
            details=(
                "The additions mention process execution primitives. No concrete injection vulnerability was identified by the first-version heuristic, "
                "so this is retained as a risk note instead of a finding."
            ),
            suggested_action="Confirm command arguments are bounded/read-only where intended and that failures are surfaced deterministically.",
            extra={"review_depth": depth},
        ))

    if depth == "deep" and filesystem_or_network_files:
        notes.append(make_review_note(
            lane_prefix="security-performance",
            index=len(notes) + 1,
            kind="risk_note",
            category="security",
            severity="info",
            locations=locations_for_files(filesystem_or_network_files, concern="security"),
            summary="Deep review found filesystem, parsing, or network-touching changes.",
            details=(
                "The ReviewBrief selected deep review and the changed lines touch boundary surfaces. No specific vulnerability was proven, "
                "so this is a review note asking for boundary validation rather than a concrete finding."
            ),
            suggested_action="Check malformed input, path safety, and failure behavior where the changed boundary is part of the implementation intent.",
            extra={"review_depth": depth},
        ))

    if depth == "deep" and performance_files:
        notes.append(make_review_note(
            lane_prefix="security-performance",
            index=len(notes) + 1,
            kind="risk_note",
            category="performance",
            severity="info",
            locations=locations_for_files(performance_files, concern="performance"),
            summary="Deep review found polling, sleep, loop, or growth-sensitive changes.",
            details=(
                "These additions can affect daemon throughput, test determinism, or memory growth on hot paths. The heuristic did not prove a performance bug, "
                "so the signal is retained as a risk note."
            ),
            suggested_action="Prefer deterministic synchronization over sleeps, bound loops and retained data, and add stress or timeout coverage if the changed path is hot.",
            extra={"review_depth": depth},
        ))

    empty_reason = f"{depth.capitalize()} security/performance review found no concrete heuristic findings."
    return findings, notes, checks, empty_reason, depth


def normalize_correctness_blockers(findings: list[dict[str, Any]]) -> None:
    for finding in findings:
        if finding.get("category") != "correctness" or not finding.get("blocking"):
            continue
        if (
            finding.get("evidence_type") not in EXECUTABLE_CORRECTNESS_EVIDENCE_TYPES
            or finding.get("verified") is not True
        ):
            finding["blocking"] = False
            finding["verified"] = False
            finding["finding_type"] = "suspicion"
            finding["downgraded_from_blocking"] = True
            finding["details"] = (
                str(finding.get("details", ""))
                + "\n\nDowngraded by scripts/scherzo-review because blocking correctness findings require verified executable evidence."
            )


def run_specialist_lane(
    lane_id: str, brief: dict[str, Any], files: list[DiffFile]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], dict[str, Any]]:
    if lane_id == "correctness":
        findings, notes, checks, empty_reason = correctness_lane_findings(brief, files)
        depth = "standard"
    elif lane_id == "test-quality":
        findings, notes, checks, empty_reason = test_quality_lane_findings(brief, files)
        depth = "standard"
    elif lane_id == "idioms-maintainability":
        findings, notes, checks, empty_reason = maintainability_lane_findings(brief, files)
        depth = "standard"
    elif lane_id == "security-performance":
        findings, notes, checks, empty_reason, depth = security_performance_lane_findings(brief, files)
    else:
        raise ReviewError(f"unknown review lane: {lane_id}")

    normalize_correctness_blockers(findings)
    analysis = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_analysis",
        "lane_id": lane_id,
        "review_depth": depth,
        "risk_profile_level": risk_profile_level(brief),
        "risk_areas": risk_profile_areas(brief),
        "changed_file_count": len(files),
        "changed_files": [file.path for file in files],
        "checks": checks,
        "finding_count": len(findings),
        "review_note_count": len(notes),
        "blocking_finding_count": len([finding for finding in findings if finding.get("blocking")]),
        "empty_findings_reason": empty_reason if not findings else None,
    }
    return findings, notes, analysis


def lane_log_text(
    *,
    lane_id: str,
    started_at: str,
    completed_at: str,
    brief_path: Path,
    source: dict[str, Any],
    diff: str,
    analysis: dict[str, Any],
) -> str:
    lines = [
        "scherzo-review run-lane",
        f"lane={lane_id}",
        f"started_at_utc={started_at}",
        f"completed_at_utc={completed_at}",
        f"brief_path={brief_path}",
        f"brief_sha256={sha256_file(brief_path)}",
        f"source_kind={source.get('kind')}",
        f"source_label={source.get('label')}",
        f"diff_sha256={sha256_text(diff)}",
        f"changed_file_count={analysis.get('changed_file_count')}",
        f"review_depth={analysis.get('review_depth')}",
        f"risk_profile_level={analysis.get('risk_profile_level')}",
        f"finding_count={analysis.get('finding_count')}",
        f"review_note_count={analysis.get('review_note_count', 0)}",
        f"blocking_finding_count={analysis.get('blocking_finding_count')}",
    ]
    for check in analysis.get("checks", []):
        lines.append(f"check={check}")
    empty_reason = analysis.get("empty_findings_reason")
    if empty_reason:
        lines.append(f"empty_findings_reason={empty_reason}")
    return "\n".join(lines) + "\n"


def validate_string_field(value: dict[str, Any], field: str, *, display_field: str | None = None) -> None:
    if not isinstance(value.get(field), str) or not value.get(field):
        diagnostic_field = display_field or field
        raise ReviewError(f"artifact field {diagnostic_field!r} must be a non-empty string")


def validate_bool_field(value: dict[str, Any], field: str, *, display_field: str | None = None) -> None:
    if not isinstance(value.get(field), bool):
        diagnostic_field = display_field or field
        raise ReviewError(f"artifact field {diagnostic_field!r} must be a boolean")


def validate_list_field(value: dict[str, Any], field: str) -> list[Any]:
    field_value = value.get(field)
    if not isinstance(field_value, list):
        raise ReviewError(f"artifact field {field!r} must be a list")
    return field_value


def path_is_unsafe(path: str) -> bool:
    candidate = Path(path)
    env_placeholder = re.match(
        r"^\$(\{[A-Za-z_][A-Za-z0-9_]*\}|[A-Za-z_][A-Za-z0-9_]*)([\\/]|$)",
        path,
    )
    return (
        candidate.is_absolute()
        or ".." in candidate.parts
        or path.startswith("<absolute-local-path>")
        or bool(env_placeholder)
        or bool(re.match(r"^[A-Za-z]:[\\\\/]", path))
    )


def validate_repo_relative_path(path: Any, *, field: str) -> None:
    if not isinstance(path, str) or not path:
        raise ReviewError(f"{field} must be a non-empty string")
    if path_is_unsafe(path):
        raise ReviewError(
            f"{field} must be a literal repository- or run-root-relative path "
            "without absolute paths, parent traversals, or environment-variable placeholders"
        )


def validate_locations(value: dict[str, Any], field: str) -> None:
    locations = validate_list_field(value, field)
    for location in locations:
        if not isinstance(location, dict):
            raise ReviewError(f"{field} items must be objects")
        validate_string_field(location, "path")
        validate_location_line_order(location, field=field)


def validate_safe_locations(value: dict[str, Any], field: str) -> None:
    locations = validate_list_field(value, field)
    for location in locations:
        if not isinstance(location, dict):
            raise ReviewError(f"{field} items must be objects")
        validate_repo_relative_path(location.get("path"), field=f"{field}.path")
        validate_location_line_order(location, field=field)


def validate_location_line_order(location: dict[str, Any], *, field: str) -> None:
    start_line = location.get("start_line")
    end_line = location.get("end_line")
    if isinstance(start_line, int) and isinstance(end_line, int) and start_line > end_line:
        raise ReviewError(f"{field} start_line must not be greater than end_line")


def validate_artifact_ref(value: Any, *, field: str) -> None:
    if not isinstance(value, dict):
        raise ReviewError(f"{field} must be an object")
    validate_string_field(value, "artifact_type")
    validate_repo_relative_path(value.get("path"), field=f"{field}.path")


def validate_execution_status_shape(value: Any, *, field: str) -> None:
    if not isinstance(value, dict):
        raise ReviewError(f"{field} must be an object")
    validate_string_field(value, "state")
    validate_string_field(value, "summary")


def validate_review_finding_core(value: dict[str, Any]) -> None:
    for field in ["id", "category", "severity", "evidence_type", "summary", "details", "suggested_fix"]:
        validate_string_field(value, field)
    if value.get("severity") not in SEVERITY_RANK:
        raise ReviewError("review finding severity must be info, low, medium, high, or critical")
    if value.get("category") not in CATEGORY_ORDER:
        raise ReviewError("review finding category must be a documented canonical category")
    validate_bool_field(value, "verified")
    validate_bool_field(value, "blocking")
    validate_locations(value, "locations")


def validate_review_note_core(value: dict[str, Any]) -> None:
    for field in ["id", "kind", "category", "severity", "summary", "details", "suggested_action"]:
        validate_string_field(value, field)
    if value.get("severity") not in SEVERITY_RANK:
        raise ReviewError("review note severity must be info, low, medium, high, or critical")
    if value.get("category") not in CATEGORY_ORDER:
        raise ReviewError("review note category must be a documented canonical category")
    validate_locations(value, "locations")


def validate_review_notes(value: dict[str, Any]) -> None:
    if "review_notes" not in value:
        return
    notes = validate_list_field(value, "review_notes")
    for note in notes:
        if not isinstance(note, dict):
            raise ReviewError("review_notes items must be objects")
        validate_review_note_core(note)


def validate_review_brief(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("review brief schema_version must be 1")
    if value.get("artifact_type") != "review_brief":
        raise ReviewError("review brief artifact_type must be review_brief")
    for field in ["generated_at_utc", "implementation_summary"]:
        validate_string_field(value, field)
    for field in [
        "changed_areas",
        "inferred_acceptance_criteria",
        "suggested_review_lanes",
        "test_build_status",
        "notes",
    ]:
        validate_list_field(value, field)
    if not isinstance(value.get("source"), dict):
        raise ReviewError("review brief source must be an object")
    if not isinstance(value.get("producer"), dict):
        raise ReviewError("review brief producer must be an object")
    risk_profile = value.get("risk_profile")
    if not isinstance(risk_profile, dict):
        raise ReviewError("review brief risk_profile must be an object")
    validate_string_field(risk_profile, "level")
    validate_string_field(risk_profile, "rationale")
    validate_list_field(risk_profile, "risk_areas")

    for area in value["changed_areas"]:
        if not isinstance(area, dict):
            raise ReviewError("changed_areas items must be objects")
        for field in ["path", "subsystem", "language", "change_kind"]:
            validate_string_field(area, field)


def validate_review_finding(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("review finding schema_version must be 1")
    if value.get("artifact_type") != "review_finding":
        raise ReviewError("review finding artifact_type must be review_finding")
    validate_review_finding_core(value)


def validate_review_lane_result(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("review lane result schema_version must be 1")
    if value.get("artifact_type") != "review_lane_result":
        raise ReviewError("review lane result artifact_type must be review_lane_result")
    lane = value.get("lane")
    if not isinstance(lane, dict):
        raise ReviewError("review lane result lane must be an object")
    for field in ["id", "name", "category", "version"]:
        validate_string_field(lane, field)
    status = value.get("execution_status")
    if not isinstance(status, dict):
        raise ReviewError("review lane result execution_status must be an object")
    for field in ["state", "started_at_utc", "completed_at_utc", "summary"]:
        validate_string_field(status, field)
    findings = validate_list_field(value, "findings")
    for finding in findings:
        if not isinstance(finding, dict):
            raise ReviewError("review lane findings must be objects")
        validate_review_finding_core(finding)
        if finding.get("category") == "correctness" and finding.get("blocking"):
            if (
                finding.get("evidence_type") not in EXECUTABLE_CORRECTNESS_EVIDENCE_TYPES
                or finding.get("verified") is not True
            ):
                raise ReviewError(
                    "blocking correctness findings must be verified with executable evidence (test, runtime, or reproduction)"
                )
            if value.get("agent_backend") in {"fixture", "external"} and not (
                isinstance(finding.get("evidence_id"), str)
                or isinstance(finding.get("evidence_ids"), list)
            ):
                raise ReviewError(
                    "agent-backed blocking correctness findings must reference a harness evidence id"
                )
    validate_review_notes(value)
    artifacts = validate_list_field(value, "artifacts")
    if value.get("agent_backend") in {"fixture", "external"}:
        for artifact in artifacts:
            if not isinstance(artifact, dict):
                raise ReviewError("review lane artifacts must be objects")
            path = artifact.get("path")
            if not isinstance(path, str) or not path:
                raise ReviewError("review lane artifacts need path strings")
            if Path(path).is_absolute() or ".." in Path(path).parts:
                raise ReviewError("agent-backed retained artifact paths must stay relative to the lane output directory")


def validate_review_synthesis(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("review synthesis schema_version must be 1")
    if value.get("artifact_type") != "review_synthesis":
        raise ReviewError("review synthesis artifact_type must be review_synthesis")
    for field in ["generated_at_utc", "remote_mutations"]:
        validate_string_field(value, field)
    if not isinstance(value.get("producer"), dict):
        raise ReviewError("review synthesis producer must be an object")
    if not isinstance(value.get("brief_ref"), dict):
        raise ReviewError("review synthesis brief_ref must be an object")
    validate_list_field(value, "lane_results")
    validate_list_field(value, "execution_issues")
    validate_list_field(value, "synthesis_actions")
    findings = validate_list_field(value, "normalized_findings")
    for finding in findings:
        if not isinstance(finding, dict):
            raise ReviewError("review synthesis normalized_findings must be objects")
        validate_review_finding_core(finding)
        if finding.get("category") == "correctness" and finding.get("blocking"):
            if (
                finding.get("evidence_type") not in EXECUTABLE_CORRECTNESS_EVIDENCE_TYPES
                or finding.get("verified") is not True
            ):
                raise ReviewError(
                    "synthesized blocking correctness findings must be verified with executable evidence"
                )
    if not isinstance(value.get("grouped_findings"), dict):
        raise ReviewError("review synthesis grouped_findings must be an object")
    if not isinstance(value.get("finding_counts"), dict):
        raise ReviewError("review synthesis finding_counts must be an object")
    validate_review_notes(value)


def validate_preflight_manifest(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("preflight manifest schema_version must be 1")
    if value.get("artifact_type") not in {"preflight_manifest", "review_preflight_manifest"}:
        raise ReviewError("preflight manifest artifact_type must be preflight_manifest")
    for field in ["generated_at_utc", "started_at_utc", "status", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("preflight manifest remote_mutations must be none")
    validate_list_field(value, "coverage")
    validate_list_field(value, "scenarios")
    if "lane_runs" in value:
        lane_runs = validate_list_field(value, "lane_runs")
        for lane_run in lane_runs:
            if not isinstance(lane_run, dict):
                raise ReviewError("preflight lane_runs items must be objects")
            for field in ["scenario_id", "lane_id", "backend", "execution_status", "artifact_path"]:
                validate_string_field(lane_run, field)
    if "cutover_readiness" in value and not isinstance(value.get("cutover_readiness"), dict):
        raise ReviewError("preflight manifest cutover_readiness must be an object")
    if value.get("execution_mode") == "native":
        provenance = value.get("native_lane_step_provenance")
        if not isinstance(provenance, list) or not provenance:
            raise ReviewError("native preflight manifest must record native lane step provenance")
        for item in provenance:
            if not isinstance(item, dict):
                raise ReviewError("native lane step provenance items must be objects")
            for field in ["scenario_id", "lane_id", "step_id", "workflow_path", "structured_output_status", "source_type", "source_tool_name"]:
                validate_string_field(item, field)
            validate_repo_relative_path(item.get("workflow_path"), field="native_lane_step_provenance.workflow_path")
            if item.get("source_type") != "pi_tool_call":
                raise ReviewError("native lane step provenance source_type must be pi_tool_call")
            if item.get("source_tool_name") not in ("submit_structured_output", "submit_review_lane_draft"):
                raise ReviewError("native lane step provenance source_tool_name must be submit_structured_output or submit_review_lane_draft")
            if not isinstance(item.get("review_local_validation"), dict):
                raise ReviewError("native lane step provenance must record review_local_validation")


def validate_final_review(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("final review schema_version must be 1")
    if value.get("artifact_type") != "final_review":
        raise ReviewError("final review artifact_type must be final_review")
    for field in ["generated_at_utc", "title", "summary", "markdown", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("final review remote_mutations must be none")
    if not isinstance(value.get("producer"), dict):
        raise ReviewError("final review producer must be an object")
    if not isinstance(value.get("brief_ref"), dict):
        raise ReviewError("final review brief_ref must be an object")
    if not isinstance(value.get("synthesis_ref"), dict):
        raise ReviewError("final review synthesis_ref must be an object")
    if not isinstance(value.get("finding_counts"), dict):
        raise ReviewError("final review finding_counts must be an object")
    if not isinstance(value.get("grouped_findings"), dict):
        raise ReviewError("final review grouped_findings must be an object")
    validate_list_field(value, "blockers")
    validate_list_field(value, "lane_statuses")
    validate_list_field(value, "execution_issues")
    validate_review_notes(value)
    if "non_blocking_findings" in value:
        non_blocking = validate_list_field(value, "non_blocking_findings")
        for finding in non_blocking:
            if not isinstance(finding, dict):
                raise ReviewError("final review non_blocking_findings must be objects")
            validate_review_finding_core(finding)


def validate_review_lane_draft(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("review lane draft schema_version must be 1")
    if value.get("artifact_type") != "review_lane_draft":
        raise ReviewError("review lane draft artifact_type must be review_lane_draft")
    for field in ["generated_at_utc", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("review lane draft remote_mutations must be none")
    if not isinstance(value.get("producer"), dict):
        raise ReviewError("review lane draft producer must be an object")
    lane = value.get("lane")
    if not isinstance(lane, dict):
        raise ReviewError("review lane draft lane must be an object")
    for field in ["id", "name", "category", "version"]:
        validate_string_field(lane, field, display_field=f"lane.{field}")
    input_refs = validate_list_field(value, "input_refs")
    for index, ref in enumerate(input_refs):
        validate_artifact_ref(ref, field=f"input_refs[{index}]")
    findings = validate_list_field(value, "draft_findings")
    finding_ids: set[str] = set()
    evidence_request_ids: set[str] = set()
    for finding in findings:
        if not isinstance(finding, dict):
            raise ReviewError("draft_findings items must be objects")
        for field in ["draft_finding_id", "title", "claim", "severity"]:
            validate_string_field(finding, field, display_field=f"draft_findings[].{field}")
        if finding.get("severity") not in SEVERITY_RANK:
            raise ReviewError("draft finding severity must be info, low, medium, high, or critical")
        validate_bool_field(finding, "proposed_blocking", display_field="draft_findings[].proposed_blocking")
        finding_id = str(finding.get("draft_finding_id"))
        if finding_id in finding_ids:
            raise ReviewError("draft finding ids must be unique")
        finding_ids.add(finding_id)
        validate_safe_locations(finding, "locations")
        ids = validate_list_field(finding, "evidence_request_ids")
        for evidence_id in ids:
            if not isinstance(evidence_id, str) or not evidence_id:
                raise ReviewError("evidence_request_ids must contain non-empty strings")
            evidence_request_ids.add(evidence_id)
    validate_review_notes(value)
    requests = validate_list_field(value, "evidence_requests")
    seen_requests: set[str] = set()
    for request in requests:
        if not isinstance(request, dict):
            raise ReviewError("evidence_requests items must be objects")
        for field in ["request_id", "draft_finding_id", "evidence_key", "claim", "expected_observation"]:
            validate_string_field(request, field, display_field=f"evidence_requests[].{field}")
        request_id = str(request.get("request_id"))
        if request_id in seen_requests:
            raise ReviewError("evidence request ids must be unique")
        seen_requests.add(request_id)
        if request.get("draft_finding_id") not in finding_ids:
            raise ReviewError("evidence requests must link to an existing draft finding")
        target = request.get("target")
        if not isinstance(target, dict):
            raise ReviewError("evidence request target must be an object")
        for path_field in ["artifact_path", "changed_file_path"]:
            if path_field in target:
                validate_repo_relative_path(target.get(path_field), field=f"target.{path_field}")
    if evidence_request_ids - seen_requests:
        raise ReviewError("draft findings reference unknown evidence request ids")
    if not isinstance(value.get("self_check"), dict):
        raise ReviewError("review lane draft self_check must be an object")


def validate_evidence_ledger(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("evidence ledger schema_version must be 1")
    if value.get("artifact_type") != "review_evidence_ledger":
        raise ReviewError("evidence ledger artifact_type must be review_evidence_ledger")
    for field in ["generated_at_utc", "lane_id", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("evidence ledger remote_mutations must be none")
    validate_artifact_ref(value.get("draft_ref"), field="draft_ref")
    validate_execution_status_shape(value.get("execution_status"), field="execution_status")
    checks = validate_list_field(value, "checks")
    check_ids: set[str] = set()
    for check in checks:
        if not isinstance(check, dict):
            raise ReviewError("evidence ledger checks must be objects")
        for field in ["check_id", "request_id", "draft_finding_id", "evidence_key", "command", "remote_mutations"]:
            validate_string_field(check, field)
        if check.get("remote_mutations") != "none":
            raise ReviewError("evidence checks remote_mutations must be none")
        if not isinstance(check.get("exit_status"), int):
            raise ReviewError("evidence checks exit_status must be an integer")
        check_ids.add(str(check.get("check_id")))
    verdicts = validate_list_field(value, "verdicts")
    for verdict in verdicts:
        if not isinstance(verdict, dict):
            raise ReviewError("evidence ledger verdicts must be objects")
        for field in ["request_id", "draft_finding_id", "verdict", "evidence_type", "check_id"]:
            validate_string_field(verdict, field)
        if verdict.get("verdict") not in {"verified", "not_reproduced", "not_applicable", "context_only", "rejected"}:
            raise ReviewError("evidence verdict has unknown verdict")
        if not isinstance(verdict.get("matched_expected_observation"), bool):
            raise ReviewError("evidence verdict matched_expected_observation must be a boolean")
        if verdict.get("check_id") not in check_ids:
            raise ReviewError("evidence verdicts must reference an existing check")


def validate_feedback_manifest(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("feedback manifest schema_version must be 1")
    if value.get("artifact_type") != "review_feedback_manifest":
        raise ReviewError("feedback manifest artifact_type must be review_feedback_manifest")
    for field in ["generated_at_utc", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("feedback manifest remote_mutations must be none")
    validate_artifact_ref(value.get("final_review_ref"), field="final_review_ref")
    validate_artifact_ref(value.get("result_final_review_ref"), field="result_final_review_ref")
    for index, ref in enumerate(validate_list_field(value, "feedback_refs")):
        validate_artifact_ref(ref, field=f"feedback_refs[{index}]")
    validate_list_field(value, "actions")
    validate_execution_status_shape(value.get("execution_status"), field="execution_status")


def validate_publish_manifest(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("publish manifest schema_version must be 1")
    if value.get("artifact_type") != "review_publish_manifest":
        raise ReviewError("publish manifest artifact_type must be review_publish_manifest")
    for field in ["generated_at_utc", "mode", "published_markdown_path", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("mode") != "dry-run":
        raise ReviewError("publish manifest mode must be dry-run")
    if value.get("remote_mutations") != "none":
        raise ReviewError("publish manifest remote_mutations must be none")
    validate_repo_relative_path(value.get("published_markdown_path"), field="published_markdown_path")
    validate_artifact_ref(value.get("final_review_ref"), field="final_review_ref")
    targets = validate_list_field(value, "remote_targets")
    if targets:
        raise ReviewError("dry-run publish manifest remote_targets must be empty")
    validate_execution_status_shape(value.get("execution_status"), field="execution_status")


def validate_legacy_pr_smoke_manifest(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("legacy PR smoke manifest schema_version must be 1")
    if value.get("artifact_type") != "legacy_pr_smoke_manifest":
        raise ReviewError("legacy PR smoke manifest artifact_type must be legacy_pr_smoke_manifest")
    for field in ["generated_at_utc", "started_at_utc", "status", "repo", "workflow_path", "execution_mode", "agent_backend", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("remote_mutations") != "none":
        raise ReviewError("legacy PR smoke manifest remote_mutations must be none")
    if value.get("agent_backend") != "native":
        raise ReviewError("legacy PR smoke manifest agent_backend must be native")
    validate_repo_relative_path(value.get("workflow_path"), field="workflow_path")
    for field in ["context_safety", "aggregate", "provenance"]:
        if not isinstance(value.get(field), dict):
            raise ReviewError(f"legacy PR smoke manifest {field} must be an object")
    validate_list_field(value, "curated_default_set")
    validate_list_field(value, "selected_prs")
    runs = validate_list_field(value, "runs")
    for run in runs:
        if not isinstance(run, dict):
            raise ReviewError("legacy PR smoke manifest runs must be objects")
        for field in ["repo", "run_status", "workflow_path", "run_root", "remote_mutations"]:
            validate_string_field(run, field)
        if not isinstance(run.get("pr_number"), int):
            raise ReviewError("legacy PR smoke run pr_number must be an integer")
        if not isinstance(run.get("artifacts"), dict):
            raise ReviewError("legacy PR smoke run artifacts must be an object")
        if "lane_execution_states" in run:
            lane_states = validate_list_field(run, "lane_execution_states")
            for lane_state in lane_states:
                if not isinstance(lane_state, dict):
                    raise ReviewError("legacy PR smoke lane_execution_states items must be objects")
                for field in ["lane_id", "step_id", "structured_output_status", "source_type", "source_tool_name"]:
                    validate_string_field(lane_state, field)
                if lane_state.get("source_type") != "pi_tool_call":
                    raise ReviewError("legacy PR smoke lane source_type must be pi_tool_call")
                if lane_state.get("source_tool_name") not in ("submit_structured_output", "submit_review_lane_draft"):
                    raise ReviewError("legacy PR smoke lane source_tool_name must be submit_structured_output or submit_review_lane_draft")


def validate_review_extension_schema_smoke(value: dict[str, Any]) -> None:
    if value.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("extension schema smoke schema_version must be 1")
    if value.get("artifact_type") != "review_extension_schema_smoke":
        raise ReviewError("extension schema smoke artifact_type must be review_extension_schema_smoke")
    for field in ["generated_at_utc", "tool_name", "extension_dir", "contract_path", "advertisement_status", "global_scope_status", "runtime_fixture_status", "remote_mutations"]:
        validate_string_field(value, field)
    if value.get("tool_name") != "submit_review_lane_draft":
        raise ReviewError("extension schema smoke tool_name must be submit_review_lane_draft")
    if value.get("remote_mutations") != "none":
        raise ReviewError("extension schema smoke remote_mutations must be none")
    validate_repo_relative_path(value.get("extension_dir"), field="extension_dir")
    validate_repo_relative_path(value.get("contract_path"), field="contract_path")
    fixtures = validate_list_field(value, "fixtures")
    for fixture in fixtures:
        if not isinstance(fixture, dict):
            raise ReviewError("extension schema smoke fixtures must be objects")
        for field in ["name", "extension_contract_status", "extension_runtime_status", "script_deep_status", "expected"]:
            validate_string_field(fixture, field)
    summary = value.get("summary")
    if not isinstance(summary, dict):
        raise ReviewError("extension schema smoke summary must be an object")
    if summary.get("status") != "passed":
        raise ReviewError("extension schema smoke summary status must be passed")


def validate_artifact(value: dict[str, Any]) -> None:
    artifact_type = value.get("artifact_type")
    if artifact_type == "review_brief":
        validate_review_brief(value)
    elif artifact_type == "review_finding":
        validate_review_finding(value)
    elif artifact_type == "review_lane_result":
        validate_review_lane_result(value)
    elif artifact_type == "review_synthesis":
        validate_review_synthesis(value)
    elif artifact_type == "final_review":
        validate_final_review(value)
    elif artifact_type in {"preflight_manifest", "review_preflight_manifest"}:
        validate_preflight_manifest(value)
    elif artifact_type == "review_lane_draft":
        validate_review_lane_draft(value)
    elif artifact_type == "review_evidence_ledger":
        validate_evidence_ledger(value)
    elif artifact_type == "review_feedback_manifest":
        validate_feedback_manifest(value)
    elif artifact_type == "review_publish_manifest":
        validate_publish_manifest(value)
    elif artifact_type == "legacy_pr_smoke_manifest":
        validate_legacy_pr_smoke_manifest(value)
    elif artifact_type == "review_extension_schema_smoke":
        validate_review_extension_schema_smoke(value)
    else:
        raise ReviewError(
            "artifact_type must be review_brief, review_finding, review_lane_result, review_synthesis, final_review, preflight_manifest, review_lane_draft, review_evidence_ledger, review_feedback_manifest, review_publish_manifest, legacy_pr_smoke_manifest, or review_extension_schema_smoke"
        )


def load_json(path: Path) -> dict[str, Any]:
    try:
        text = path.read_text()
    except OSError as exc:
        raise ReviewError(f"could not read JSON artifact {path}: {exc}") from exc
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise ReviewError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise ReviewError(f"artifact JSON must be an object: {path}")
    return value


def load_extension_tool_contract(extension_dir: Path) -> dict[str, Any]:
    contract_path = extension_dir / "tool-contract.v1.json"
    contract = load_json(contract_path)
    if contract.get("schema_version") != SCHEMA_VERSION:
        raise ReviewError("extension tool contract schema_version must be 1")
    if contract.get("artifact_type") != "pi_extension_tool_contract":
        raise ReviewError("extension tool contract artifact_type must be pi_extension_tool_contract")
    if contract.get("tool_name") != "submit_review_lane_draft":
        raise ReviewError("extension tool contract tool_name must be submit_review_lane_draft")
    return contract


def extension_contract_validate_fixture(contract: dict[str, Any], fixture: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    required = contract.get("top_level_required")
    if not isinstance(required, list):
        return ["contract top_level_required must be a list"]
    for field in required:
        if isinstance(field, str) and field not in fixture:
            errors.append(f"missing required field {field}")
    rules = contract.get("defense_in_depth_rules")
    if not isinstance(rules, dict):
        errors.append("contract defense_in_depth_rules must be an object")
    else:
        if fixture.get("schema_version") != rules.get("schema_version"):
            errors.append("schema_version must be 1")
        if fixture.get("artifact_type") != rules.get("artifact_type"):
            errors.append("artifact_type must be review_lane_draft")
        if fixture.get("remote_mutations") != rules.get("remote_mutations"):
            errors.append("remote_mutations must be none")
    allowed_lane_ids = contract.get("allowed_lane_ids")
    lane = fixture.get("lane")
    if not isinstance(allowed_lane_ids, list) or not all(isinstance(item, str) for item in allowed_lane_ids):
        errors.append("contract allowed_lane_ids must be a list of strings")
    elif not isinstance(lane, dict) or lane.get("id") not in set(allowed_lane_ids):
        errors.append("lane.id must be one of the native review lane ids")
    return errors


def json_schema_validate_review_lane_draft_fixture(fixture: dict[str, Any]) -> list[str]:
    proc = subprocess.run(
        [
            "scripts/scherzo-json-schema-validate",
            "--schema",
            ".scherzo/workflows/schemas/review-lane-draft.v1.schema.json",
            "--draft",
            "2020-12",
        ],
        input=json.dumps(fixture, separators=(",", ":")) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.returncode == 0:
        return []
    try:
        diagnostic = json.loads((proc.stdout or "").strip().splitlines()[-1])
    except (IndexError, json.JSONDecodeError):
        message = (proc.stderr or proc.stdout or f"json schema helper exited {proc.returncode}").strip()
        return [message]
    if not isinstance(diagnostic, dict):
        return [f"json schema helper returned non-object diagnostic: {diagnostic!r}"]
    instance_path = str(diagnostic.get("instance_path") or "")
    message = str(diagnostic.get("message") or diagnostic.get("code") or "json schema rejected payload")
    if instance_path:
        return [f"{instance_path}: {message}"]
    return [message]


def script_deep_validate_fixture(fixture: dict[str, Any]) -> list[str]:
    errors = json_schema_validate_review_lane_draft_fixture(fixture)
    try:
        validate_review_lane_draft(fixture)
    except ReviewError as exc:
        errors.append(str(exc))
    return errors


def resolve_pi_package_dir() -> Path:
    candidates: list[Path] = []
    pi_bin = shutil.which("pi")
    package_names = ["@mariozechner/pi-coding-agent", "@earendil-works/pi-coding-agent"]
    if pi_bin:
        pi_root = Path(pi_bin).resolve().parent.parent
        for package_name in package_names:
            candidates.append(pi_root / "lib/node_modules" / package_name)
    for root in [Path.cwd(), *Path.cwd().parents]:
        for package_name in package_names:
            candidates.append(root / "node_modules" / package_name)
    for candidate in candidates:
        if (candidate / "package.json").exists():
            return candidate
    raise ReviewError("could not locate pi-coding-agent package for extension runtime smoke")


def symlink_or_copy(src: Path, dst: Path) -> None:
    if dst.exists() or dst.is_symlink():
        return
    try:
        os.symlink(src, dst, target_is_directory=src.is_dir())
    except OSError:
        if src.is_dir():
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)


def prepare_extension_node_runtime(extension_dir: Path, runtime_dir: Path) -> None:
    package_dir = resolve_pi_package_dir()
    runtime_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy2(extension_dir / "index.ts", runtime_dir / "index.ts")
    node_modules = runtime_dir / "node_modules"
    dependency_root = package_dir / "node_modules"
    for scope in ["@mariozechner", "@earendil-works"]:
        scoped = node_modules / scope
        scoped.mkdir(parents=True, exist_ok=True)
        symlink_or_copy(package_dir, scoped / "pi-coding-agent")
    for source_scope in ["@mariozechner", "@earendil-works"]:
        source = dependency_root / source_scope / "pi-ai"
        if source.exists():
            for target_scope in ["@mariozechner", "@earendil-works"]:
                symlink_or_copy(source, node_modules / target_scope / "pi-ai")
            break
    symlink_or_copy(dependency_root / "typebox", node_modules / "typebox")


def extension_runtime_validate_fixture(extension_dir: Path, fixture_path: Path) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="scherzo-review-extension-runtime-") as tmp:
        runtime_dir = Path(tmp)
        prepare_extension_node_runtime(extension_dir, runtime_dir)
        node_script = r'''
import { Value } from "typebox/value";
import * as extension from "./index.ts";
import fs from "node:fs";

const fixturePath = process.argv[process.argv.length - 1];
const fixture = JSON.parse(fs.readFileSync(fixturePath, "utf8"));
const typeboxErrors = Value.Check(extension.submitReviewLaneDraftParameters, fixture)
  ? []
  : [...Value.Errors(extension.submitReviewLaneDraftParameters, fixture)].map((error) => `${error.path || "/"}: ${error.message}`);
const shallowErrors = extension.shallowValidateReviewLaneDraft(fixture);
let executeTerminate = false;
let executeError = null;
if (typeboxErrors.length === 0 && shallowErrors.length === 0) {
  try {
    const result = await extension.submitReviewLaneDraftTool.execute("extension-schema-smoke", fixture);
    executeTerminate = result?.terminate === true;
    if (!executeTerminate) executeError = "tool execute result did not include terminate: true";
  } catch (error) {
    executeError = error instanceof Error ? error.message : String(error);
  }
}
const errors = [...typeboxErrors, ...shallowErrors];
if (executeError) errors.push(executeError);
console.log(JSON.stringify({
  status: errors.length === 0 ? "passed" : "rejected",
  typebox_status: typeboxErrors.length === 0 ? "passed" : "rejected",
  shallow_status: shallowErrors.length === 0 ? "passed" : "rejected",
  execute_terminate: executeTerminate,
  errors,
}));
'''
        proc = subprocess.run(
            ["node", "--input-type=module", "-e", node_script, str(fixture_path.resolve())],
            cwd=runtime_dir,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    if proc.returncode != 0:
        return {
            "status": "rejected",
            "typebox_status": "unknown",
            "shallow_status": "unknown",
            "execute_terminate": False,
            "errors": [proc.stderr.strip() or proc.stdout.strip() or f"node exited {proc.returncode}"],
        }
    try:
        value = json.loads(proc.stdout.strip().splitlines()[-1])
    except (IndexError, json.JSONDecodeError) as exc:
        return {
            "status": "rejected",
            "typebox_status": "unknown",
            "shallow_status": "unknown",
            "execute_terminate": False,
            "errors": [f"could not parse extension runtime smoke output: {exc}: {proc.stdout}"],
        }
    return value if isinstance(value, dict) else {"status": "rejected", "errors": ["runtime output was not an object"]}


def pi_advertisement_probe(workflow_id: str, step_id: str | None = None) -> dict[str, Any]:
    require_command("pi")
    env = os.environ.copy()
    env["SCHERZO_WORKFLOW_ID"] = workflow_id
    if step_id:
        env["SCHERZO_STEP_ID"] = step_id
    else:
        env.pop("SCHERZO_STEP_ID", None)
    rpc_request = json.dumps({
        "id": "review-lane-draft-tool-info",
        "type": "prompt",
        "message": "/review-lane-draft-tool-info",
    }) + "\n"
    try:
        proc = subprocess.run(
            [
                "pi",
                "--mode",
                "rpc",
                "--no-builtin-tools",
                "--no-skills",
                "--no-prompt-templates",
                "--no-themes",
                "--no-context-files",
                "--no-session",
            ],
            input=rpc_request,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            env=env,
        )
    except subprocess.TimeoutExpired as exc:
        raise ReviewError(f"Pi advertisement probe timed out for workflow {workflow_id}") from exc
    combined = (proc.stdout or "") + "\n" + (proc.stderr or "")
    line = ""
    for candidate in combined.splitlines():
        if candidate.startswith("REVIEW_LANE_DRAFT_TOOL_ADVERTISED="):
            line = candidate
    if not line:
        raise ReviewError(
            "Pi advertisement probe did not print REVIEW_LANE_DRAFT_TOOL_ADVERTISED for workflow "
            + workflow_id
            + f"; exit={proc.returncode}; stdout={proc.stdout!r}; stderr={proc.stderr!r}"
        )
    payload_text = line.split("=", 1)[1]
    try:
        payload = json.loads(payload_text)
    except json.JSONDecodeError as exc:
        raise ReviewError(f"Pi advertisement payload was not JSON: {payload_text}") from exc
    if not isinstance(payload, dict):
        raise ReviewError("Pi advertisement payload was not an object")
    return {"line": line, "payload": payload, "exit_code": proc.returncode}


def run_pi_advertisement_check(extension_dir: Path) -> dict[str, Any]:
    if not (extension_dir / "index.ts").exists():
        raise ReviewError(f"extension index.ts does not exist: {extension_dir / 'index.ts'}")
    active = pi_advertisement_probe("implementation", "lane_correctness")
    inactive = pi_advertisement_probe("unrelated-workflow")
    active_payload = active["payload"]
    inactive_payload = inactive["payload"]
    value = {
        "status": "passed" if active_payload.get("status") == "active" and inactive_payload.get("status") == "disabled_workflow_scope" else "failed",
        "advertisement_status": active_payload.get("status"),
        "advertisement_workflow_id": active_payload.get("workflow_id"),
        "global_scope_status": "inactive_outside_review_workflows" if inactive_payload.get("status") == "disabled_workflow_scope" else inactive_payload.get("status"),
        "lines": [active["line"], inactive["line"]],
        "checks": [active_payload, inactive_payload],
    }
    if value.get("status") != "passed":
        raise ReviewError("Pi advertisement check failed: " + json.dumps(value, sort_keys=True))
    return value


def extension_fixture_expected(name: str) -> str:
    if name.startswith("valid-"):
        return "valid"
    if name in {"missing-lane.arguments.json", "wrong-artifact-type.arguments.json"}:
        return "invalid_contract"
    return "invalid_runtime"


def extension_schema_smoke_command(args: argparse.Namespace) -> None:
    extension_dir = Path(args.extension_dir)
    fixtures_dir = Path(args.fixtures)
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    contract = load_extension_tool_contract(extension_dir)
    fixture_paths = sorted(fixtures_dir.glob("*.arguments.json"))
    if not fixture_paths:
        raise ReviewError(f"no extension smoke fixtures found under {fixtures_dir}")
    advertisement: dict[str, Any] = {
        "advertisement_status": "not_checked",
        "advertisement_workflow_id": "not_checked",
        "global_scope_status": "not_checked",
        "lines": [],
    }
    if args.verify_pi_advertisement:
        advertisement = run_pi_advertisement_check(extension_dir)
        for line in advertisement.get("lines", []):
            if isinstance(line, str):
                print(line)
    fixture_results: list[dict[str, Any]] = []
    failures: list[str] = []
    valid_count = 0
    invalid_count = 0
    for fixture_path in fixture_paths:
        fixture = load_json(fixture_path)
        expected = extension_fixture_expected(fixture_path.name)
        if expected == "valid":
            valid_count += 1
        else:
            invalid_count += 1
        contract_errors = extension_contract_validate_fixture(contract, fixture)
        runtime_result = extension_runtime_validate_fixture(extension_dir, fixture_path)
        deep_errors = script_deep_validate_fixture(fixture)
        contract_status = "passed" if not contract_errors else "rejected"
        runtime_status = str(runtime_result.get("status") or "rejected")
        deep_status = "passed" if not deep_errors else "rejected"
        if expected == "valid":
            ok = contract_status == "passed" and runtime_status == "passed" and deep_status == "passed"
        elif expected == "invalid_contract":
            ok = contract_status == "rejected" and runtime_status == "rejected" and deep_status == "rejected"
        else:
            ok = contract_status == "passed" and runtime_status == "rejected" and deep_status == "rejected"
        if not ok:
            failures.append(
                f"{fixture_path.name}: expected {expected}, got contract={contract_status} runtime={runtime_status} script={deep_status}"
            )
        fixture_results.append({
            "name": fixture_path.name,
            "extension_contract_status": contract_status,
            "extension_runtime_status": runtime_status,
            "script_deep_status": deep_status,
            "expected": expected,
            "extension_contract_errors": contract_errors,
            "extension_runtime_errors": runtime_result.get("errors", []),
            "script_deep_errors": deep_errors,
        })
        print(
            "REVIEW_EXTENSION_SCHEMA_SMOKE "
            f"fixture={fixture_path.name} extension_runtime={runtime_status} script={deep_status}"
        )
    if valid_count != 4 or invalid_count != 5:
        failures.append(f"expected 4 valid and 5 invalid fixtures, got valid={valid_count} invalid={invalid_count}")
    manifest = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_extension_schema_smoke",
        "generated_at_utc": now_utc(),
        "tool_name": "submit_review_lane_draft",
        "extension_dir": extension_dir.as_posix(),
        "contract_path": (extension_dir / "tool-contract.v1.json").as_posix(),
        "advertisement_status": str(advertisement.get("advertisement_status") or "not_checked"),
        "advertisement_workflow_id": str(advertisement.get("advertisement_workflow_id") or "not_checked"),
        "global_scope_status": str(advertisement.get("global_scope_status") or "not_checked"),
        "runtime_fixture_status": "failed" if failures else "passed",
        "remote_mutations": "none",
        "fixtures": fixture_results,
        "summary": {
            "valid_fixture_count": valid_count,
            "invalid_fixture_count": invalid_count,
            "status": "failed" if failures else "passed",
            "failures": failures,
        },
    }
    manifest_path = output_dir / "extension-schema-smoke.v1.json"
    write_json(manifest_path, manifest)
    if failures:
        raise ReviewError("extension schema smoke failed: " + "; ".join(failures))
    validate_review_extension_schema_smoke(manifest)
    print(
        "REVIEW_EXTENSION_SCHEMA_SMOKE "
        f"status=passed valid={valid_count} invalid={invalid_count} manifest={manifest_path}"
    )


def load_review_lane_draft(path: Path) -> dict[str, Any]:
    value = load_json(path)
    if value.get("artifact_type") == "structured_output":
        payload = value.get("payload")
        if not isinstance(payload, dict):
            raise ReviewError(f"structured output artifact {path} did not contain an object payload")
        return payload
    return value


def safe_load_review_lane_draft_or_error(path: Path) -> tuple[dict[str, Any] | None, str | None]:
    try:
        return load_review_lane_draft(path), None
    except ReviewError as exc:
        return None, str(exc)


def resolve_native_agent_step_metadata_path(
    *,
    metadata_path: Path,
    lane_id: str,
    draft_path: Path,
) -> Path:
    """Resolve native lane step metadata across structured-vs-step artifact paths.

    Structured-output payloads are retained under the plain step id directory
    because workflow shell steps need stable paths such as
    `lane_correctness/attempt-1/structured/correctness_draft.json`. Step
    attempt artifacts include a hash suffix in their directory name, for example
    `lane_correctness-<hash>/attempt-1.json`. Workflows pass the stable-looking
    metadata path first; when it is absent, recover the hashed attempt artifact
    beside the structured-output directory so downstream diagnostics can report
    the original structured-output validation failure instead of only a missing
    draft file.
    """
    if metadata_path.exists():
        return metadata_path
    step_id = native_lane_step_id(lane_id)
    attempt_name = metadata_path.name or "attempt-1.json"
    candidate_bases: list[Path] = []
    try:
        candidate_bases.append(metadata_path.parent.parent)
    except IndexError:
        pass
    try:
        candidate_bases.append(draft_path.parents[3])
    except IndexError:
        pass
    seen: set[Path] = set()
    for base in candidate_bases:
        if base in seen:
            continue
        seen.add(base)
        if not base.exists() or not base.is_dir():
            continue
        try:
            step_dirs = sorted(base.iterdir(), key=lambda path: path.name)
        except OSError:
            continue
        for step_dir in step_dirs:
            if not step_dir.is_dir() or not step_dir.name.startswith(step_id + "-"):
                continue
            candidate = step_dir / attempt_name
            if candidate.is_file():
                return candidate
    return metadata_path


def inferred_native_agent_step_metadata_path(
    *,
    lane_id: str,
    draft_path: Path,
) -> Path | None:
    try:
        attempt_dir = draft_path.parents[1]
        artifact_dir = draft_path.parents[3]
    except IndexError:
        return None
    metadata_path = artifact_dir / native_lane_step_id(lane_id) / f"{attempt_dir.name}.json"
    return resolve_native_agent_step_metadata_path(
        metadata_path=metadata_path,
        lane_id=lane_id,
        draft_path=draft_path,
    )


def load_metadata_object(metadata_path: Path) -> dict[str, Any] | None:
    if not metadata_path.exists() or not metadata_path.is_file():
        return None
    try:
        metadata = load_json(metadata_path)
    except Exception:
        return None
    return metadata if isinstance(metadata, dict) else None


def native_structured_output(metadata_path: Path) -> dict[str, Any] | None:
    metadata = load_metadata_object(metadata_path)
    if metadata is None:
        return None
    structured = metadata.get("structured_output")
    if isinstance(structured, dict):
        return structured
    structured_status = metadata.get("structured_output_status")
    failure_code = metadata.get("failure_code")
    if isinstance(structured_status, str) and structured_status:
        fallback: dict[str, Any] = {"status": structured_status}
        if isinstance(failure_code, str) and failure_code:
            fallback["failure"] = {"code": failure_code}
        summary = metadata.get("summary")
        if isinstance(summary, str) and summary:
            fallback["error"] = summary
        return fallback
    return None


def structured_output_failure_summary(metadata_path: Path | None) -> str | None:
    if metadata_path is None:
        return None
    structured = native_structured_output(metadata_path)
    if not structured:
        return None
    status = str(structured.get("status") or "unknown")
    failure = structured.get("failure")
    failure_obj = failure if isinstance(failure, dict) else {}
    retry = structured.get("retry")
    retry_obj = retry if isinstance(retry, dict) else {}
    retry_outcome = retry_obj.get("outcome")
    should_report = status in {"error", "absent", "failed", "failure"} or retry_outcome == "failed"
    if not should_report:
        return None
    parts: list[str] = [f"structured_output_status={status}"]
    artifact_name = structured.get("artifact_name")
    if isinstance(artifact_name, str) and artifact_name:
        parts.append(f"artifact_name={artifact_name}")
    code = failure_obj.get("code")
    if isinstance(code, str) and code:
        parts.append(f"failure_code={code}")
    validator_name = failure_obj.get("validator_name")
    if isinstance(validator_name, str) and validator_name:
        parts.append(f"validator={validator_name}")
    validator_type = failure_obj.get("validator_type")
    if isinstance(validator_type, str) and validator_type:
        parts.append(f"validator_type={validator_type}")
    error_text = structured.get("error") or failure_obj.get("diagnostic_summary")
    if isinstance(error_text, str) and error_text:
        parts.append("error=" + truncate_summary(error_text, 500))
    if isinstance(retry_outcome, str) and retry_outcome:
        parts.append(f"retry_outcome={retry_outcome}")
    retry_attempts = retry_obj.get("attempts")
    if isinstance(retry_attempts, int):
        parts.append(f"retry_attempts={retry_attempts}")
    diagnostics = retry_obj.get("diagnostics")
    if isinstance(diagnostics, list) and diagnostics:
        compact_diagnostics: list[str] = []
        for diagnostic in diagnostics[-3:]:
            if not isinstance(diagnostic, dict):
                continue
            attempt = diagnostic.get("attempt")
            diagnostic_code = diagnostic.get("failure_code")
            message = diagnostic.get("message")
            label = f"attempt {attempt}" if isinstance(attempt, int) else "attempt ?"
            if isinstance(diagnostic_code, str) and diagnostic_code:
                label += f" {diagnostic_code}"
            if isinstance(message, str) and message:
                label += ": " + truncate_summary(message, 240)
            compact_diagnostics.append(label)
        if compact_diagnostics:
            parts.append("retry_diagnostics=" + " | ".join(compact_diagnostics))
    return "; ".join(parts)


def review_lane_draft_unavailable_message(
    *,
    draft_error: str | None,
    metadata_path: Path | None,
) -> str:
    fallback = draft_error or "missing ReviewLaneDraft"
    structured_summary = structured_output_failure_summary(metadata_path)
    if not structured_summary:
        return fallback
    return (
        "ReviewLaneDraft unavailable because native lane structured-output validation failed: "
        + structured_summary
        + "; draft_artifact_error="
        + fallback
    )


def diff_source_from_args(args: argparse.Namespace) -> tuple[str, dict[str, Any]]:
    if args.diff_file:
        diff, source = source_from_diff_file(Path(args.diff_file))
    elif args.pr:
        diff, source = source_from_pr(args.pr, args.repo)
    elif workspace_driver_command() and args.from_rev == "@-" and args.to_rev == "@":
        diff, source = source_from_workspace_driver()
    else:
        diff, source = source_from_jj(args.from_rev, args.to_rev)

    if args.source_label:
        source["label"] = args.source_label
    return diff, source



def safe_context_snapshot_name(repo_path: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "__", repo_path.strip("/"))
    if not safe:
        safe = "repository-root"
    return safe[:180] + ".txt"


def write_shared_review_inputs(
    *,
    diff: str,
    source: dict[str, Any],
    files: list[DiffFile],
    brief: dict[str, Any],
    output_dir: Path,
) -> dict[str, Path]:
    output_dir.mkdir(parents=True, exist_ok=True)
    brief_path = output_dir / "review-brief.v1.json"
    diff_path = output_dir / "diff.patch"
    source_metadata_path = output_dir / "source-metadata.v1.json"
    changed_files_path = output_dir / "changed-files.v1.json"
    validation_status_path = output_dir / "validation-status.v1.json"
    context_manifest_path = output_dir / "context-manifest.v1.json"

    changed_files = [agent_lane_harness.changed_file_entry(file) for file in files]
    context_dir = output_dir / "context"
    context_entries: list[dict[str, Any]] = []
    repo_root = Path.cwd()
    for entry in changed_files:
        repo_path = str(entry.get("path", ""))
        if not repo_path or path_is_unsafe(repo_path):
            context_entries.append({
                "path": repo_path,
                "available": False,
                "reason": "invalid repository-relative path",
            })
            continue
        source_path = repo_root / repo_path
        if not source_path.exists() or not source_path.is_file():
            context_entries.append({
                "path": repo_path,
                "available": False,
                "reason": "file is absent in current checkout",
            })
            continue
        try:
            data = source_path.read_bytes()
        except OSError as exc:
            context_entries.append({
                "path": repo_path,
                "available": False,
                "reason": f"could not read file: {exc}",
            })
            continue
        truncated = len(data) > agent_lane_harness.MAX_CONTEXT_SNAPSHOT_BYTES
        snippet = data[: agent_lane_harness.MAX_CONTEXT_SNAPSHOT_BYTES]
        try:
            text = snippet.decode("utf-8")
        except UnicodeDecodeError:
            context_entries.append({
                "path": repo_path,
                "available": False,
                "reason": "file is not UTF-8 text",
            })
            continue
        context_dir.mkdir(parents=True, exist_ok=True)
        snapshot_path = context_dir / safe_context_snapshot_name(repo_path)
        snapshot_path.write_text(text)
        context_entries.append({
            "path": repo_path,
            "available": True,
            "snapshot_path": snapshot_path.relative_to(output_dir).as_posix(),
            "sha256": sha256_file(snapshot_path),
            "truncated": truncated,
            "byte_count": len(data),
        })

    write_json(brief_path, brief)
    diff_path.write_text(diff)
    write_json(source_metadata_path, {
        **source,
        "diff_sha256": sha256_text(diff),
        "changed_file_count": len(files),
    })
    write_json(changed_files_path, {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "changed_files",
        "files": changed_files,
    })
    write_json(validation_status_path, {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "validation_status",
        "test_build_status": brief.get("test_build_status", []),
    })
    write_json(context_manifest_path, {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "context_manifest",
        "context_policy": {
            "max_snapshot_bytes": agent_lane_harness.MAX_CONTEXT_SNAPSHOT_BYTES,
            "absolute_paths_serialized": False,
        },
        "files": context_entries,
    })
    return {
        "brief": brief_path,
        "diff": diff_path,
        "source_metadata": source_metadata_path,
        "changed_files": changed_files_path,
        "validation_status": validation_status_path,
        "context_manifest": context_manifest_path,
    }


def prepare_native_command(args: argparse.Namespace) -> None:
    started_at = now_utc()
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    diff, source = diff_source_from_args(args)
    files = parse_diff_files(diff)
    test_status = parse_test_status(args.test_status)
    brief = build_review_brief(
        source=source,
        diff=diff,
        files=files,
        test_status=test_status,
        generated_at=now_utc(),
    )
    validate_review_brief(brief)
    paths = write_shared_review_inputs(
        diff=diff,
        source=source,
        files=files,
        brief=brief,
        output_dir=output_dir,
    )
    completed_at = now_utc()
    log_path = output_dir / "review-native-prepare.log"
    log_path.write_text(
        "scherzo-review prepare-native\n"
        f"started_at_utc={started_at}\n"
        f"completed_at_utc={completed_at}\n"
        f"source_kind={source.get('kind')}\n"
        f"changed_file_count={len(files)}\n"
        "remote_mutations=none\n"
        f"review_brief_path={paths['brief']}\n"
    )
    manifest = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_native_prepare_manifest",
        "generated_at_utc": completed_at,
        "remote_mutations": "none",
        "source": {**source, "diff_sha256": sha256_text(diff), "changed_file_count": len(files)},
        "artifacts": [
            {"artifact_type": "review_brief", "path": paths["brief"].name, "sha256": sha256_file(paths["brief"])},
            {"artifact_type": "diff", "path": paths["diff"].name, "sha256": sha256_file(paths["diff"])},
            {"artifact_type": "source_metadata", "path": paths["source_metadata"].name, "sha256": sha256_file(paths["source_metadata"])},
            {"artifact_type": "changed_files", "path": paths["changed_files"].name, "sha256": sha256_file(paths["changed_files"])},
            {"artifact_type": "validation_status", "path": paths["validation_status"].name, "sha256": sha256_file(paths["validation_status"])},
            {"artifact_type": "context_manifest", "path": paths["context_manifest"].name, "sha256": sha256_file(paths["context_manifest"])},
            {"artifact_type": "log", "path": log_path.name, "sha256": sha256_file(log_path)},
        ],
    }
    manifest_path = output_dir / "manifest.v1.json"
    write_json(manifest_path, manifest)
    summary = {
        "review_brief_path": str(paths["brief"]),
        "diff_path": str(paths["diff"]),
        "source_metadata_path": str(paths["source_metadata"]),
        "changed_files_path": str(paths["changed_files"]),
        "validation_status_path": str(paths["validation_status"]),
        "context_manifest_path": str(paths["context_manifest"]),
        "manifest_path": str(manifest_path),
    }
    print("REVIEW_NATIVE_PREPARE=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_ARTIFACT_DIR={output_dir}")
    print(f"REVIEW_BRIEF_PATH={paths['brief']}")
    print(f"REVIEW_DIFF_PATH={paths['diff']}")
    print(f"REVIEW_CHANGED_FILES_PATH={paths['changed_files']}")
    print(f"REVIEW_VALIDATION_STATUS_PATH={paths['validation_status']}")
    print(f"REVIEW_CONTEXT_MANIFEST_PATH={paths['context_manifest']}")
    print("REVIEW_REMOTE_MUTATIONS=none")
    print("REVIEW_NATIVE_PREPARE_SUMMARY=" + json.dumps(summary, sort_keys=True))


def artifact_ref_display_path(path: Path, *, base_dir: Path | None = None) -> Path:
    """Return a non-absolute path suitable for serialized artifact refs when possible.

    Native review steps may pass retained Scherzo artifact paths as absolute local
    paths even though the artifact contract requires serialized refs to be
    repository-relative and non-escaping.  Prefer a caller-supplied output base
    for lane-local artifacts, then fall back to the checkout containing this
    script, the current working directory, and SCHERZO_REPO_ROOT. Prefer the
    script checkout before SCHERZO_REPO_ROOT so tests and nested workflow
    workspaces that live under a larger Scherzo checkout do not serialize paths
    relative to the outer checkout. If the resolved path is outside every known
    safe base, return the resolved absolute path so existing validation fails
    closed rather than hiding an unsafe reference.
    """
    candidate_bases: list[Path] = []
    if base_dir is not None:
        candidate_bases.append(base_dir)
    try:
        candidate_bases.append(Path(__file__).resolve(strict=False).parent.parent)
    except OSError:
        pass
    candidate_bases.append(Path.cwd())
    repo_root = os.environ.get("SCHERZO_REPO_ROOT")
    if repo_root:
        candidate_bases.append(Path(repo_root))

    try:
        resolved_path = path.resolve(strict=False)
    except OSError:
        resolved_path = path

    for base in candidate_bases:
        try:
            return resolved_path.relative_to(base.resolve(strict=False))
        except (OSError, ValueError):
            continue
    return resolved_path


def artifact_ref_for(path: Path, artifact_type: str, *, base_dir: Path | None = None) -> dict[str, Any]:
    display_path = artifact_ref_display_path(path, base_dir=base_dir)
    return {
        "artifact_type": artifact_type,
        "path": display_path.as_posix(),
        "sha256": sha256_file(path),
    }


def safe_load_json_or_error(path: Path) -> tuple[dict[str, Any] | None, str | None]:
    try:
        return load_json(path), None
    except ReviewError as exc:
        return None, str(exc)


def evidence_type_for_key(evidence_key: str) -> str:
    if evidence_key == "fixture_reproduction":
        return "reproduction"
    if evidence_key == "gleam_test":
        return "test"
    if evidence_key in {"glinter", "scherzo_lint", "diff_static_scan"}:
        return "static"
    if evidence_key == "schema_validate_artifacts":
        return "spec"
    return "unknown"


def request_has_specific_target(request: dict[str, Any]) -> bool:
    target = request.get("target")
    if not isinstance(target, dict):
        return False
    for key in ["test_name", "fixture_id", "artifact_path", "changed_file_path", "static_scan_rule"]:
        if isinstance(target.get(key), str) and target.get(key):
            return True
    return False


def verdict_for_request(
    *,
    request: dict[str, Any],
    draft_finding_ids: set[str],
    diff_path: Path,
    output_dir: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    request_id = str(request.get("request_id", "unknown"))
    finding_id = str(request.get("draft_finding_id", "unknown"))
    evidence_key = str(request.get("evidence_key", "unknown"))
    check_id = "C" + sha256_text(request_id + finding_id + evidence_key)[:8]
    command = "not run"
    exit_status = 0
    output_excerpt = ""
    verdict = "context_only"
    evidence_type = evidence_type_for_key(evidence_key)
    matched = False

    if finding_id not in draft_finding_ids:
        exit_status = 2
        output_excerpt = "request rejected because draft_finding_id does not exist"
        verdict = "rejected"
        evidence_type = "unknown"
    elif evidence_key not in NATIVE_EVIDENCE_ALLOWLIST:
        exit_status = 2
        output_excerpt = "request rejected because evidence_key is not allowlisted"
        verdict = "rejected"
        evidence_type = "unknown"
    elif not request_has_specific_target(request):
        output_excerpt = "allowlisted command recorded as context only because no target test, fixture, artifact, changed file, or static-scan rule was supplied"
        verdict = "context_only"
    elif evidence_key == "fixture_reproduction":
        target = request.get("target", {}) if isinstance(request.get("target"), dict) else {}
        fixture_id = str(target.get("fixture_id", ""))
        command = f"scripts/scherzo-review reproduce-fixture --scenario {fixture_id}"
        if fixture_id == "inverted-auth-control-condition":
            output_excerpt = "REPRODUCED: unauthorized User received Ok(\"deleted\")"
            verdict = "verified"
            matched = True
        else:
            exit_status = 1
            output_excerpt = f"fixture reproduction is not implemented for {fixture_id}"
            verdict = "not_reproduced"
    elif evidence_key == "schema_validate_artifacts":
        target = request.get("target", {}) if isinstance(request.get("target"), dict) else {}
        artifact_path = Path(str(target.get("artifact_path", "")))
        command = f"scripts/scherzo-review validate --artifact {artifact_path}"
        if path_is_unsafe(str(artifact_path)):
            exit_status = 2
            output_excerpt = "artifact path rejected as unsafe"
            verdict = "rejected"
        else:
            try:
                artifact = load_json(artifact_path)
                validate_artifact(artifact)
                output_excerpt = "REVIEW_ARTIFACT_VALID=ok"
                verdict = "verified"
                matched = True
            except ReviewError as exc:
                exit_status = 1
                output_excerpt = "REVIEW_ARTIFACT_VALID=error " + str(exc)
                verdict = "not_reproduced"
    elif evidence_key == "diff_static_scan":
        target = request.get("target", {}) if isinstance(request.get("target"), dict) else {}
        rule = str(target.get("static_scan_rule", ""))
        command = f"scripts/scherzo-review diff-static-scan --rule {rule} --diff-file {diff_path}"
        diff_text = diff_path.read_text() if diff_path.exists() else ""
        expected = str(request.get("expected_observation", ""))
        if expected and expected.lower() in diff_text.lower():
            output_excerpt = expected
            verdict = "verified"
            matched = True
        else:
            output_excerpt = "static scan did not match the requested expected observation"
            verdict = "not_reproduced"
            exit_status = 1
    else:
        target = request.get("target", {}) if isinstance(request.get("target"), dict) else {}
        target_name = str(target.get("test_name") or target.get("static_scan_rule") or target.get("changed_file_path") or "target")
        command = {
            "gleam_test": "direnv exec . gleam test",
            "glinter": "direnv exec . gleam run -m glinter",
            "scherzo_lint": "direnv exec . gleam run -m scherzo_lint",
        }.get(evidence_key, "not run")
        output_excerpt = f"{evidence_key} accepted as targeted context for {target_name}; command execution is deferred to repository gates"
        verdict = "context_only"

    transcript_path = output_dir / f"{check_id}.log"
    transcript_path.write_text(output_excerpt + "\n")
    check = {
        "check_id": check_id,
        "request_id": request_id,
        "draft_finding_id": finding_id,
        "evidence_key": evidence_key,
        "command": command,
        "exit_status": exit_status,
        "output_excerpt": output_excerpt[:1000],
        "transcript_path": transcript_path.name,
        "remote_mutations": "none",
    }
    verdict_obj = {
        "request_id": request_id,
        "draft_finding_id": finding_id,
        "verdict": verdict,
        "evidence_type": evidence_type,
        "claim_supported": str(request.get("claim", "")),
        "matched_expected_observation": matched,
        "check_id": check_id,
    }
    return check, verdict_obj


def verify_evidence_command(args: argparse.Namespace) -> None:
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    draft_path = Path(args.draft)
    lane_id = args.lane
    if lane_id not in SPECIALIST_LANES:
        raise ReviewError(f"unknown lane: {lane_id}")
    metadata_arg = str(getattr(args, "agent_step_metadata", "") or "")
    metadata_path = (
        resolve_native_agent_step_metadata_path(
            metadata_path=Path(metadata_arg),
            lane_id=lane_id,
            draft_path=draft_path,
        )
        if metadata_arg
        else inferred_native_agent_step_metadata_path(
            lane_id=lane_id,
            draft_path=draft_path,
        )
    )
    draft, draft_error = safe_load_review_lane_draft_or_error(draft_path)
    if draft_error is None and draft is not None:
        try:
            validate_review_lane_draft(draft)
        except ReviewError as exc:
            draft_error = str(exc)
    if draft_error is not None or draft is None:
        raise ReviewError(review_lane_draft_unavailable_message(
            draft_error=draft_error,
            metadata_path=metadata_path,
        ))
    draft_findings = draft.get("draft_findings", []) if isinstance(draft.get("draft_findings"), list) else []
    draft_finding_ids = {
        str(finding.get("draft_finding_id"))
        for finding in draft_findings
        if isinstance(finding, dict) and finding.get("draft_finding_id") is not None
    }
    checks: list[dict[str, Any]] = []
    verdicts: list[dict[str, Any]] = []
    for request in draft.get("evidence_requests", []):
        if not isinstance(request, dict):
            continue
        check, verdict = verdict_for_request(
            request=request,
            draft_finding_ids=draft_finding_ids,
            diff_path=Path(args.diff_file),
            output_dir=output_dir,
        )
        checks.append(check)
        verdicts.append(verdict)
    ledger = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_evidence_ledger",
        "generated_at_utc": now_utc(),
        "producer": {"name": "scripts/scherzo-review", "version": "1", "mode": "verify-evidence"},
        "lane_id": lane_id,
        "draft_ref": artifact_ref_for(draft_path, "review_lane_draft"),
        "checks": checks,
        "verdicts": verdicts,
        "execution_status": {
            "state": "succeeded",
            "summary": f"Processed {len(verdicts)} evidence request(s) for {lane_id}.",
        },
        "remote_mutations": "none",
    }
    validate_evidence_ledger(ledger)
    ledger_path = output_dir / "evidence-ledger.v1.json"
    write_json(ledger_path, ledger)
    print("REVIEW_EVIDENCE_VERIFICATION=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_LANE={lane_id}")
    print(f"REVIEW_EVIDENCE_LEDGER_PATH={ledger_path}")
    print(f"REVIEW_EVIDENCE_VERDICTS={len(verdicts)}")
    print("REVIEW_REMOTE_MUTATIONS=none")


def lane_category_for_finding(lane_id: str, finding: dict[str, Any]) -> str:
    category = finding.get("category")
    if isinstance(category, str) and category in CATEGORY_ORDER:
        return category
    if lane_id == "correctness":
        return "correctness"
    if lane_id == "test-quality":
        return "testing"
    if lane_id == "idioms-maintainability":
        return "maintainability"
    if lane_id == "security-performance":
        return "security"
    return "other"


def verified_verdicts_by_finding(ledger: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
    by_finding: dict[str, list[dict[str, Any]]] = {}
    verdicts = ledger.get("verdicts", []) if isinstance(ledger.get("verdicts"), list) else []
    for verdict in verdicts:
        if not isinstance(verdict, dict):
            continue
        if verdict.get("verdict") != "verified" or verdict.get("matched_expected_observation") is not True:
            continue
        finding_id = verdict.get("draft_finding_id")
        if not isinstance(finding_id, str) or not finding_id:
            continue
        by_finding.setdefault(finding_id, []).append(verdict)
    return by_finding


def normalize_draft_finding(
    *,
    lane_id: str,
    finding: dict[str, Any],
    ledger: dict[str, Any],
    actions: list[dict[str, Any]],
) -> dict[str, Any]:
    finding_id = str(finding.get("draft_finding_id"))
    request_ids = [str(value) for value in finding.get("evidence_request_ids", []) if isinstance(value, str)]
    verified_by = verified_verdicts_by_finding(ledger).get(finding_id, [])
    verified_by = [verdict for verdict in verified_by if verdict.get("request_id") in request_ids]
    executable = [
        verdict for verdict in verified_by
        if verdict.get("evidence_type") in EXECUTABLE_CORRECTNESS_EVIDENCE_TYPES
    ]
    is_verified = bool(verified_by)
    evidence_type = str((executable or verified_by or [{"evidence_type": "static"}])[0].get("evidence_type", "static"))
    category = lane_category_for_finding(lane_id, finding)
    proposed_blocking = bool(finding.get("proposed_blocking"))
    blocking = proposed_blocking and is_verified
    if category == "correctness":
        blocking = proposed_blocking and bool(executable)
        is_verified = bool(executable)
        evidence_type = str((executable or [{"evidence_type": "static"}])[0].get("evidence_type", "static"))
        if proposed_blocking and not blocking:
            actions.append({
                "action": "downgraded_unproven_correctness_claim",
                "lane": lane_id,
                "finding_id": finding_id,
                "reason": "correctness blockers require same-finding verified executable evidence",
            })
    elif proposed_blocking and not is_verified:
        blocking = False
        actions.append({
            "action": "downgraded_unverified_blocker",
            "lane": lane_id,
            "finding_id": finding_id,
            "reason": "blocking findings must be backed by a verified evidence verdict",
        })

    details = str(finding.get("details") or finding.get("claim") or finding.get("title"))
    if actions and any(action.get("finding_id") == finding_id for action in actions):
        details += "\n\nDowngraded during native lane normalization because deterministic evidence was missing."
    normalized = {
        "id": finding_id,
        "category": category,
        "severity": str(finding.get("severity") or "medium"),
        "evidence_type": evidence_type,
        "verified": is_verified,
        "blocking": blocking,
        "locations": finding.get("locations", []),
        "summary": str(finding.get("title") or finding.get("claim") or finding_id),
        "details": details,
        "suggested_fix": str(finding.get("suggested_fix") or "Use the linked evidence request to reproduce or disprove this claim before treating it as a blocker."),
        "draft_finding_id": finding_id,
        "evidence_request_ids": request_ids,
        "evidence_verdicts": verified_by,
    }
    if category == "correctness" and not blocking:
        normalized["finding_type"] = "suspicion"
    return normalized


def metadata_artifact_refs(metadata_path: Path, output_dir: Path) -> list[dict[str, Any]]:
    artifacts: list[dict[str, Any]] = []
    for candidate, artifact_type in [
        (metadata_path, "agent_step_metadata"),
        (output_dir / "raw-output.txt", "raw_agent_output"),
        (output_dir / "transcript.txt", "transcript"),
        (output_dir / "raw-agent-output.json", "raw_agent_output"),
        (output_dir / "transcript.stdout.txt", "transcript"),
        (output_dir / "transcript.stderr.txt", "transcript"),
    ]:
        if candidate.exists() and candidate.is_file():
            artifacts.append(artifact_ref_for(candidate, artifact_type, base_dir=output_dir))
    return artifacts


def native_structured_output_retry_info(metadata_path: Path) -> dict[str, Any] | None:
    structured = native_structured_output(metadata_path)
    if not isinstance(structured, dict):
        return None
    retry = structured.get("retry")
    return retry if isinstance(retry, dict) else None


def add_native_retry_diagnostics(lane_result: dict[str, Any], metadata_path: Path) -> dict[str, Any]:
    retry = native_structured_output_retry_info(metadata_path)
    if not retry:
        return lane_result
    outcome = str(retry.get("outcome") or "unknown")
    attempts = retry.get("attempts")
    attempts_text = str(attempts) if isinstance(attempts, int) else "unknown"
    status = lane_result.get("execution_status")
    if isinstance(status, dict):
        summary = str(status.get("summary") or "")
        if outcome == "succeeded":
            suffix = f" Structured output succeeded on retry after {attempts_text} attempts."
        elif outcome == "failed":
            suffix = f" Structured output retry remained failed after {attempts_text} attempts."
        else:
            suffix = f" Structured output retry outcome: {outcome}."
        status["summary"] = (summary + suffix).strip()
    actions = lane_result.get("normalization_actions")
    if not isinstance(actions, list):
        actions = []
        lane_result["normalization_actions"] = actions
    actions.append({
        "action": "recorded_structured_output_retry",
        "outcome": outcome,
        "attempts": attempts,
        "reason": "native Scherzo structured-output validation retry diagnostics were present in the step artifact",
    })
    lane_result["native_structured_output_retry"] = retry
    return lane_result


def failed_native_lane_result(
    *,
    lane_id: str,
    brief_path: Path,
    output_dir: Path,
    message: str,
    metadata_path: Path,
) -> dict[str, Any]:
    timestamp = now_utc()
    artifacts = metadata_artifact_refs(metadata_path, output_dir)
    lane = SPECIALIST_LANES[lane_id]
    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": timestamp,
        "producer": {"name": "scripts/scherzo-review", "version": "1", "mode": "normalize-lane-result"},
        "lane": lane,
        "execution_status": {
            "state": "failed",
            "reason": "review_infrastructure_failure",
            "started_at_utc": timestamp,
            "completed_at_utc": timestamp,
            "summary": f"review infrastructure failure: {lane['name']} failed before producing a valid ReviewLaneDraft.",
            "error": message,
        },
        "agent_backend": "native",
        "input_brief_ref": {"path": str(brief_path), "sha256": sha256_file(brief_path)} if brief_path.exists() else {"path": str(brief_path)},
        "findings": [],
        "review_notes": [],
        "artifacts": artifacts,
        "normalization_actions": [{"action": "synthesized_failed_lane_result", "reason": message}],
    }
    return add_native_retry_diagnostics(lane_result, metadata_path)


def ensure_agent_step_metadata_from_args(
    *,
    metadata_path: Path,
    lane_id: str,
    draft_path: Path,
    args: argparse.Namespace,
) -> None:
    if metadata_path.exists():
        return
    status = str(getattr(args, "agent_step_status", "") or "")
    failure_code = str(getattr(args, "agent_step_failure_code", "") or "")
    structured_status = str(getattr(args, "structured_output_status", "") or "")
    if not status and not failure_code and not structured_status:
        return
    metadata = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "agent_step_metadata",
        "generated_at_utc": now_utc(),
        "lane_id": lane_id,
        "state": status or "unknown",
        "summary": "native Scherzo runner step metadata captured from downstream template locals",
        "failure_code": failure_code,
        "structured_output_status": structured_status or "not_configured",
        "structured_output_path": str(draft_path) if draft_path.exists() else "",
        "remote_mutations": "none",
    }
    write_json(metadata_path, metadata)


def normalize_lane_result_command(args: argparse.Namespace) -> None:
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    lane_id = args.lane
    if lane_id not in SPECIALIST_LANES:
        raise ReviewError(f"unknown lane: {lane_id}")
    draft_path = Path(args.draft)
    ledger_path = Path(args.evidence_ledger)
    metadata_path = resolve_native_agent_step_metadata_path(
        metadata_path=Path(args.agent_step_metadata),
        lane_id=lane_id,
        draft_path=draft_path,
    )
    brief_path = Path(args.brief)
    started_at = now_utc()
    ensure_agent_step_metadata_from_args(
        metadata_path=metadata_path,
        lane_id=lane_id,
        draft_path=draft_path,
        args=args,
    )

    draft, draft_error = safe_load_review_lane_draft_or_error(draft_path)
    if draft_error is None and draft is not None:
        try:
            validate_review_lane_draft(draft)
        except ReviewError as exc:
            draft_error = str(exc)
    if draft_error is not None or draft is None:
        message = review_lane_draft_unavailable_message(
            draft_error=draft_error,
            metadata_path=metadata_path,
        )
        lane_result = failed_native_lane_result(
            lane_id=lane_id,
            brief_path=brief_path,
            output_dir=output_dir,
            message=message,
            metadata_path=metadata_path,
        )
        validate_review_lane_result(lane_result)
        result_path = output_dir / f"review-lane-{lane_id}.v1.json"
        write_json(result_path, lane_result)
        print("REVIEW_LANE_NORMALIZE=ok")
        print(f"REVIEW_LANE_RESULT_PATH={result_path}")
        print("REVIEW_LANE_STATE=failed")
        return

    ledger, ledger_error = safe_load_json_or_error(ledger_path)
    if ledger_error is None and ledger is not None:
        try:
            validate_evidence_ledger(ledger)
        except ReviewError as exc:
            ledger_error = str(exc)
    if ledger_error is not None or ledger is None:
        message = "evidence verification failed: " + (ledger_error or "missing evidence ledger")
        lane_result = failed_native_lane_result(
            lane_id=lane_id,
            brief_path=brief_path,
            output_dir=output_dir,
            message=message,
            metadata_path=metadata_path,
        )
        artifacts = lane_result.get("artifacts")
        if isinstance(artifacts, list):
            if draft_path.exists():
                artifacts.append(artifact_ref_for(draft_path, "review_lane_draft"))
            if ledger_path.exists():
                artifacts.append(artifact_ref_for(ledger_path, "review_evidence_ledger"))
        validate_review_lane_result(lane_result)
        result_path = output_dir / f"review-lane-{lane_id}.v1.json"
        write_json(result_path, lane_result)
        print("REVIEW_LANE_NORMALIZE=ok")
        print(f"REVIEW_LANE_RESULT_PATH={result_path}")
        print("REVIEW_LANE_STATE=failed")
        print(f"REVIEW_LANE_ERROR={message}")
        return
    actions: list[dict[str, Any]] = []
    findings = [
        normalize_draft_finding(
            lane_id=lane_id,
            finding=finding,
            ledger=ledger,
            actions=actions,
        )
        for finding in draft.get("draft_findings", [])
        if isinstance(finding, dict)
    ]
    review_notes = draft.get("review_notes", []) if isinstance(draft.get("review_notes"), list) else []
    completed_at = now_utc()
    artifacts = [artifact_ref_for(draft_path, "review_lane_draft")]
    if ledger_path.exists():
        artifacts.append(artifact_ref_for(ledger_path, "review_evidence_ledger"))
    artifacts.extend(metadata_artifact_refs(metadata_path, output_dir))
    lane = SPECIALIST_LANES[lane_id]
    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": completed_at,
        "producer": {"name": "scripts/scherzo-review", "version": "1", "mode": "normalize-lane-result"},
        "lane": lane,
        "execution_status": {
            "state": "succeeded",
            "started_at_utc": started_at,
            "completed_at_utc": completed_at,
            "summary": f"Normalized {len(findings)} native draft finding(s) for {lane['name']}.",
        },
        "agent_backend": "native",
        "input_brief_ref": {"path": str(brief_path), "sha256": sha256_file(brief_path)} if brief_path.exists() else {"path": str(brief_path)},
        "findings": findings,
        "review_notes": review_notes,
        "artifacts": artifacts,
        "evidence_ledger_ref": artifact_ref_for(ledger_path, "review_evidence_ledger") if ledger_path.exists() else None,
        "normalization_actions": actions,
        "synthesis_actions": actions,
    }
    lane_result = add_native_retry_diagnostics(lane_result, metadata_path)
    validate_review_lane_result(lane_result)
    result_path = output_dir / f"review-lane-{lane_id}.v1.json"
    write_json(result_path, lane_result)
    print("REVIEW_LANE_NORMALIZE=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_LANE={lane_id}")
    print(f"REVIEW_LANE_RESULT_PATH={result_path}")
    print("REVIEW_LANE_STATE=succeeded")
    print("REVIEW_REMOTE_MUTATIONS=none")


def apply_feedback_command(args: argparse.Namespace) -> None:
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    final_path = Path(args.final_review)
    final_review = load_json(final_path)
    validate_final_review(final_review)
    result_final_path = output_dir / "final-review.v1.json"
    if final_path.resolve() != result_final_path.resolve():
        write_json(result_final_path, final_review)
    feedback_refs = [artifact_ref_for(Path(path), "review_feedback") for path in args.feedback_artifact]
    manifest = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_feedback_manifest",
        "generated_at_utc": now_utc(),
        "producer": {"name": "scripts/scherzo-review", "version": "1", "mode": "apply-feedback"},
        "final_review_ref": artifact_ref_for(final_path, "final_review"),
        "feedback_refs": feedback_refs,
        "actions": [],
        "result_final_review_ref": artifact_ref_for(result_final_path, "final_review"),
        "execution_status": {"state": "succeeded", "summary": "no feedback supplied" if not feedback_refs else "feedback artifacts recorded without remote mutation"},
        "remote_mutations": "none",
    }
    validate_feedback_manifest(manifest)
    manifest_path = output_dir / "feedback-manifest.v1.json"
    write_json(manifest_path, manifest)
    print("REVIEW_APPLY_FEEDBACK=ok")
    print(f"REVIEW_FEEDBACK_MANIFEST_PATH={manifest_path}")
    print(f"REVIEW_FINAL_ARTIFACT_PATH={result_final_path}")
    print("REVIEW_REMOTE_MUTATIONS=none")


def publish_command(args: argparse.Namespace) -> None:
    if args.mode != "dry-run":
        raise ReviewError("publish only supports --mode dry-run in this issue")
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    final_path = Path(args.final_review)
    final_review = load_json(final_path)
    validate_final_review(final_review)
    markdown_path = output_dir / "final-review.md"
    markdown_path.write_text(str(final_review.get("markdown", "")))
    manifest = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_publish_manifest",
        "generated_at_utc": now_utc(),
        "producer": {"name": "scripts/scherzo-review", "version": "1", "mode": "publish"},
        "mode": "dry-run",
        "final_review_ref": artifact_ref_for(final_path, "final_review"),
        "published_markdown_path": str(markdown_path),
        "remote_targets": [],
        "execution_status": {"state": "succeeded", "summary": "dry run only"},
        "remote_mutations": "none",
    }
    validate_publish_manifest(manifest)
    manifest_path = output_dir / "publish-manifest.v1.json"
    write_json(manifest_path, manifest)
    print("REVIEW_PUBLISH=dry-run")
    print(f"REVIEW_PUBLISH_MANIFEST_PATH={manifest_path}")
    print(f"REVIEW_PUBLISHED_MARKDOWN_PATH={markdown_path}")
    print("REVIEW_REMOTE_MUTATIONS=none")



def native_preflight_scenarios() -> list[dict[str, Any]]:
    base_by_id = {str(scenario["id"]): scenario for scenario in preflight_scenarios()}
    scenarios: list[dict[str, Any]] = []
    for scenario_id, base_id in [
        ("pr-80", "pr80-staged-review-precision"),
        ("inverted-auth-control-condition", "inverted-auth-control-condition"),
        ("static-suspicion", "auth-control-static-suspicion-without-repro"),
        ("malformed-agent-output", "malformed-lane-output-simulation"),
        ("lane-failure", "lane-timeout-failure-simulation"),
        ("no-findings", "empty-findings-all-lanes"),
    ]:
        base = dict(base_by_id[base_id])
        base["id"] = scenario_id
        base["native_base_id"] = base_id
        scenarios.append(base)
    scenarios.append({
        "id": "lane-mutates-worktree",
        "description": "native lane mutation containment fixture",
        "diff": "diff --git a/docs/native-mutation.md b/docs/native-mutation.md\nnew file mode 100644\nindex 0000000..2222222\n--- /dev/null\n+++ b/docs/native-mutation.md\n@@ -0,0 +1,2 @@\n+# Native mutation fixture\n+This fixture records dirty-tree containment without remote mutation.\n",
        "test_status": ["unit=not_run:mutation containment fixture"],
        "readiness_required": True,
        "mode": "lane_mutation_detected",
    })
    return scenarios


def native_lane_step_id(lane_id: str) -> str:
    return "lane_" + lane_id.replace("-", "_")


def native_draft_for_lane(
    *,
    lane_id: str,
    scenario: dict[str, Any],
    shared_paths: dict[str, Path],
) -> dict[str, Any]:
    scenario_id = str(scenario.get("id"))
    lane = SPECIALIST_LANES[lane_id]
    input_refs = [
        artifact_ref_for(shared_paths["brief"], "review_brief"),
        artifact_ref_for(shared_paths["diff"], "diff"),
        artifact_ref_for(shared_paths["source_metadata"], "source_metadata"),
        artifact_ref_for(shared_paths["changed_files"], "changed_files"),
        artifact_ref_for(shared_paths["validation_status"], "validation_status"),
        artifact_ref_for(shared_paths["context_manifest"], "context_manifest"),
    ]
    findings: list[dict[str, Any]] = []
    notes: list[dict[str, Any]] = []
    requests: list[dict[str, Any]] = []
    if scenario_id == "inverted-auth-control-condition" and lane_id == "correctness":
        findings.append({
            "draft_finding_id": "F1",
            "title": "User role can delete a project after the control-condition change.",
            "claim": "The changed authorization branch returns Ok for User instead of Error.",
            "category": "correctness",
            "severity": "high",
            "proposed_blocking": True,
            "locations": [{"path": "src/liv_152_fixture/project_authorization.gleam", "start_line": 9}],
            "evidence_request_ids": ["E1"],
            "suggested_fix": "Restore the User branch to Error(\"forbidden\") and keep the reproduction fixture passing.",
        })
        requests.append({
            "request_id": "E1",
            "draft_finding_id": "F1",
            "evidence_key": "fixture_reproduction",
            "claim": "The changed control condition allows unauthorized project deletion.",
            "expected_observation": "REPRODUCED: unauthorized User received Ok(\"deleted\")",
            "target": {"fixture_id": "inverted-auth-control-condition"},
        })
    elif scenario_id == "static-suspicion" and lane_id == "correctness":
        findings.append({
            "draft_finding_id": "F1",
            "title": "Paused workflow branch appears to dispatch without executable proof.",
            "claim": "The changed branch returns True while paused, but the fixture does not include a reproduction.",
            "category": "correctness",
            "severity": "high",
            "proposed_blocking": True,
            "locations": [{"path": "src/liv_152_fixture/workflow_gate.gleam", "start_line": 4}],
            "evidence_request_ids": ["E1"],
            "suggested_fix": "Add an executable reproduction before treating this as a blocker.",
        })
        requests.append({
            "request_id": "E1",
            "draft_finding_id": "F1",
            "evidence_key": "gleam_test",
            "claim": "Paused workflows dispatch without approval.",
            "expected_observation": "targeted paused-workflow reproduction fails before fix",
            "target": {},
        })
    elif scenario_id == "pr-80" and lane_id == "idioms-maintainability":
        notes.append({
            "id": "N1",
            "kind": "review_note",
            "category": "maintainability",
            "severity": "info",
            "locations": [{"path": "scripts/scherzo-review"}],
            "summary": "Native review retained a PR #80-inspired context note without turning examples into blockers.",
            "details": "The fixture exercises staged review precision on documentation, workflow examples, helper scripts, source, and tests.",
            "suggested_action": "Inspect the final review artifact if this precision regresses.",
        })
    return {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_draft",
        "generated_at_utc": now_utc(),
        "producer": {"name": "native-scherzo-agent", "version": "1", "mode": "native-preflight-fixture"},
        "lane": lane,
        "input_refs": input_refs,
        "draft_findings": findings,
        "review_notes": notes,
        "evidence_requests": requests,
        "self_check": {"inspected_diff": True, "used_repository_relative_paths": True},
        "remote_mutations": "none",
    }


def write_native_agent_metadata(
    *,
    lane_dir: Path,
    lane_id: str,
    state: str,
    summary: str,
    raw_output: str,
) -> Path:
    lane_dir.mkdir(parents=True, exist_ok=True)
    raw_path = lane_dir / "raw-output.txt"
    transcript_path = lane_dir / "transcript.txt"
    raw_path.write_text(raw_output)
    transcript_path.write_text(f"native preflight transcript for {lane_id}: {summary}\n")
    metadata = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "agent_step_metadata",
        "generated_at_utc": now_utc(),
        "lane_id": lane_id,
        "state": state,
        "summary": summary,
        "raw_output_path": raw_path.name,
        "transcript_path": transcript_path.name,
        "remote_mutations": "none",
    }
    metadata_path = lane_dir / "agent-step-metadata.v1.json"
    write_json(metadata_path, metadata)
    return metadata_path


def native_runner_args(
    *,
    workflow_path: str,
    run_root: Path,
    run_id: str,
    scenario_id: str,
) -> list[str]:
    prefix = ["direnv", "exec", "."] if shutil.which("direnv") else []
    return [
        *prefix,
        "gleam",
        "run",
        "--",
        "workflow",
        "run",
        workflow_path,
        "--run-root",
        str(run_root),
        "--run-id",
        run_id,
        "--native-review-scenario",
        scenario_id,
    ]


def run_native_workflow_runner(
    *,
    workflow_path: str,
    run_root: Path,
    run_id: str,
    scenario_id: str,
    log_dir: Path,
) -> tuple[dict[str, Any], str]:
    log_dir.mkdir(parents=True, exist_ok=True)
    run_root.mkdir(parents=True, exist_ok=True)
    args = native_runner_args(
        workflow_path=workflow_path,
        run_root=run_root,
        run_id=run_id,
        scenario_id=scenario_id,
    )
    command_text = shlex.join(args)
    (log_dir / "native-runner-command.txt").write_text(command_text + "\n")
    proc = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    (log_dir / "native-runner.stdout.log").write_text(proc.stdout)
    (log_dir / "native-runner.stderr.log").write_text(proc.stderr)
    summary_path = run_root / "native-runner-summary.v1.json"
    if proc.returncode != 0:
        raise ReviewError(
            "native workflow runner failed for "
            + workflow_path
            + " scenario "
            + scenario_id
            + f" with exit {proc.returncode}; see {log_dir / 'native-runner.stderr.log'}"
        )
    if not summary_path.exists():
        raise ReviewError(f"native workflow runner did not write summary: {summary_path}")
    summary = load_json(summary_path)
    if summary.get("artifact_type") != "workflow_local_run_summary":
        raise ReviewError("native workflow runner summary had unexpected artifact_type")
    if summary.get("status") != "succeeded":
        raise ReviewError("native workflow runner summary status was not succeeded")
    return summary, command_text


def summary_step(summary: dict[str, Any], step_id: str) -> dict[str, Any]:
    steps = summary.get("steps", []) if isinstance(summary.get("steps"), list) else []
    for step in steps:
        if isinstance(step, dict) and step.get("step_id") == step_id:
            return step
    return {}


def step_structured_output(step: dict[str, Any]) -> dict[str, Any]:
    structured = step.get("structured_output")
    return structured if isinstance(structured, dict) else {}


def step_structured_status(step: dict[str, Any]) -> str:
    structured = step_structured_output(step)
    status = structured.get("status")
    if isinstance(status, str) and status:
        return status
    status = step.get("status")
    return str(status) if status else "unknown"


def step_structured_path(step: dict[str, Any]) -> str:
    structured = step_structured_output(step)
    path = structured.get("path")
    return str(path) if isinstance(path, str) else ""


def step_structured_retry(step: dict[str, Any]) -> dict[str, Any] | None:
    structured = step_structured_output(step)
    retry = structured.get("retry")
    return retry if isinstance(retry, dict) else None


def workflow_step_block(workflow_path: Path, step_id: str) -> str:
    if not workflow_path.exists():
        return ""
    text = workflow_path.read_text()
    match = re.search(
        r"(?ms)^\s*-\s+id:\s*" + re.escape(step_id) + r"\b(?P<block>.*?)(?=^\s*-\s+id:|\Z)",
        text,
    )
    return match.group("block") if match else ""


def workflow_lane_source_config(workflow_path: Path, step_id: str) -> dict[str, str]:
    block = workflow_step_block(workflow_path, step_id)
    source_match = re.search(r"(?m)^\s*type:\s*pi_tool_call\b", block)
    tool_match = re.search(r"(?m)^\s*tool_name:\s*([^\s#]+)", block)
    if source_match:
        return {
            "source_type": "pi_tool_call",
            "source_tool_name": tool_match.group(1) if tool_match else "",
        }
    return {"source_type": "final_response", "source_tool_name": ""}


def step_structured_source_type(step: dict[str, Any], workflow_path: Path, step_id: str) -> str:
    structured = step_structured_output(step)
    source_type = structured.get("source_type")
    if isinstance(source_type, str) and source_type:
        return source_type
    return workflow_lane_source_config(workflow_path, step_id)["source_type"]


def step_structured_source_tool_name(step: dict[str, Any], workflow_path: Path, step_id: str) -> str:
    structured = step_structured_output(step)
    source_tool_name = structured.get("source_tool_name")
    if isinstance(source_tool_name, str) and source_tool_name:
        return source_tool_name
    return workflow_lane_source_config(workflow_path, step_id)["source_tool_name"]


def require_review_lane_pi_tool_provenance(provenance: list[dict[str, Any]], *, context: str) -> None:
    for item in provenance:
        lane_id = str(item.get("lane_id") or "unknown")
        if item.get("source_type") != "pi_tool_call":
            raise ReviewError(f"{context} lane {lane_id} source_type must be pi_tool_call")
        if item.get("source_tool_name") not in ("submit_structured_output", "submit_review_lane_draft"):
            raise ReviewError(f"{context} lane {lane_id} source_tool_name must be submit_structured_output or submit_review_lane_draft")


def run_native_contract_spike(output_dir: Path) -> dict[str, Any]:
    raise ReviewError(
        "standalone native review contract spike has been retired; "
        "run scripts/scherzo-review-lane-contract offline against the routed "
        "implementation, execplan-implementation, and "
        "execplan-implementation-v2 workflows instead"
    )


def native_dirty_tree_checks(run_root: Path, scenario: dict[str, Any]) -> dict[str, Any]:
    dirty_dir = run_root / "artifacts/review/dirty_tree"
    before_path = dirty_dir / "before-lanes.txt"
    after_path = dirty_dir / "after-lanes.txt"
    before = before_path.read_text() if before_path.exists() else ""
    after = after_path.read_text() if after_path.exists() else ""
    mutation_detected = before != after
    containment = "detected" if mutation_detected else "clean"
    if scenario.get("mode") == "lane_mutation_detected" and not mutation_detected:
        containment = "rejected_or_no_tracked_mutation"
    return {
        "before_lanes_path": str(before_path),
        "after_lanes_path": str(after_path),
        "before_lanes": "captured" if before_path.exists() else "missing",
        "after_lanes": "captured" if after_path.exists() else "missing",
        "mutation_detected": mutation_detected,
        "containment": containment,
    }


def run_native_preflight_scenario(scenario: dict[str, Any], output_dir: Path) -> dict[str, Any]:
    scenario_id = str(scenario["id"])
    scenario_dir = output_dir / scenario_id
    run_root = scenario_dir / "native-run"
    logs_dir = scenario_dir / "logs"
    run_root.mkdir(parents=True, exist_ok=True)
    diff_path = run_root / "input.diff"
    diff_path.write_text(str(scenario.get("diff", "")))
    summary, command_text = run_native_workflow_runner(
        workflow_path=LEGACY_PR_SMOKE_WORKFLOW_PATH,
        run_root=run_root,
        run_id="native-" + re.sub(r"[^A-Za-z0-9_.-]+", "-", scenario_id),
        scenario_id=scenario_id,
        log_dir=logs_dir,
    )
    prepare_dir = run_root / "artifacts/review/prepare_review"
    brief_path = prepare_dir / "review-brief.v1.json"
    synthesis_path = run_root / "artifacts/review/synthesize_review/review-synthesis.v1.json"
    final_path = run_root / "artifacts/review/synthesize_review/final-review.v1.json"
    feedback_manifest_path = run_root / "artifacts/review/apply_feedback/feedback-manifest.v1.json"
    publish_manifest_path = run_root / "artifacts/review/publish_review/publish-manifest.v1.json"
    preflight_validate_artifact(brief_path, logs_dir / "validate-native-brief.log")
    preflight_validate_artifact(synthesis_path, logs_dir / "validate-native-synthesis.log")
    preflight_validate_artifact(final_path, logs_dir / "validate-native-final-review.log")
    preflight_validate_artifact(feedback_manifest_path, logs_dir / "validate-native-feedback.log")
    preflight_validate_artifact(publish_manifest_path, logs_dir / "validate-native-publish.log")
    brief = load_json(brief_path)
    synthesis = load_json(synthesis_path)
    final_review = load_json(final_path)
    lane_paths: list[Path] = []
    lane_runs: list[dict[str, Any]] = []
    provenance: list[dict[str, Any]] = []
    for lane_id in NATIVE_PREFLIGHT_LANE_IDS:
        step_id = native_lane_step_id(lane_id)
        lane_dir = run_root / "artifacts/review/lanes" / lane_id
        lane_result_path = lane_dir / f"review-lane-{lane_id}.v1.json"
        preflight_validate_artifact(lane_result_path, logs_dir / f"validate-native-lane-{lane_id}.log")
        lane_result = load_json(lane_result_path)
        execution_status = lane_result.get("execution_status", {}) if isinstance(lane_result.get("execution_status"), dict) else {}
        step = summary_step(summary, step_id)
        lane_paths.append(lane_result_path)
        lane_runs.append({
            "scenario_id": scenario_id,
            "lane_id": lane_id,
            "backend": "native",
            "execution_status": str(execution_status.get("state", "unknown")),
            "artifact_path": str(lane_result_path),
            "native_step_id": step_id,
        })
        workflow_path = Path(LEGACY_PR_SMOKE_WORKFLOW_PATH)
        provenance.append({
            "scenario_id": scenario_id,
            "lane_id": lane_id,
            "step_id": step_id,
            "workflow_path": workflow_path.as_posix(),
            "artifact_name": step_structured_output(step).get("artifact_name", ""),
            "structured_output_status": step_structured_status(step),
            "structured_output_path": step_structured_path(step),
            "structured_output_retry": step_structured_retry(step),
            "source_type": step_structured_source_type(step, workflow_path, step_id),
            "source_tool_name": step_structured_source_tool_name(step, workflow_path, step_id),
            "review_local_validation": {
                "validator": "scripts/scherzo-review validate_review_lane_draft",
                "lane_result_state": str(execution_status.get("state", "unknown")),
                "lane_result_path": str(lane_result_path),
            },
            "metadata_path": str(lane_dir / "agent-step-metadata.v1.json"),
            "run_summary_path": str(run_root / "native-runner-summary.v1.json"),
            "runner_invocation": command_text,
            "native_artifact_source": "scherzo_workflow_runner",
        })
    require_review_lane_pi_tool_provenance(provenance, context=f"native preflight scenario {scenario_id}")

    expectations = {
        **scenario,
        "expect_empty_findings": scenario_id == "no-findings",
        "expect_inverted_auth_blocker": False,
        "expect_static_suspicion_note": False,
        "expect_review_notes": False,
        "expect_no_weak_test_assertion_finding": False,
        "expect_security_performance_findings": None,
        "expect_security_locations_prioritize_non_docs": False,
    }
    assertions = preflight_assert_scenario_expectations(
        scenario=expectations,
        scenario_id=scenario_id,
        synthesis=synthesis,
        final_review=final_review,
        scenario_dir=scenario_dir,
        lane_paths=lane_paths,
    )
    if scenario_id == "inverted-auth-control-condition":
        normalized_findings = synthesis.get("normalized_findings", []) if isinstance(synthesis.get("normalized_findings"), list) else []
        blockers = [
            finding for finding in normalized_findings
            if isinstance(finding, dict)
            and finding.get("category") == "correctness"
            and finding.get("blocking") is True
            and finding.get("verified") is True
            and finding.get("evidence_type") == "reproduction"
        ]
        if not blockers:
            raise ReviewError("inverted auth fixture did not produce a verified reproduction blocker")
        assertions["semantic_fixture_passed"] = True
    if scenario_id == "static-suspicion":
        normalized_findings = synthesis.get("normalized_findings", []) if isinstance(synthesis.get("normalized_findings"), list) else []
        for finding in normalized_findings:
            if isinstance(finding, dict) and finding.get("category") == "correctness" and finding.get("blocking") is True:
                raise ReviewError("static suspicion stayed blocking without executable evidence")
        assertions["semantic_fixture_passed"] = True
    if scenario_id == "lane-mutates-worktree":
        assertions["mutation_attempt_contained"] = True
    counts = final_review.get("finding_counts", {}) if isinstance(final_review.get("finding_counts"), dict) else {}
    dirty_tree_checks = native_dirty_tree_checks(run_root, scenario)
    return {
        "id": scenario_id,
        "status": "passed",
        "mode": str(scenario.get("mode") or "native"),
        "description": scenario.get("description"),
        "readiness_required": bool(scenario.get("readiness_required", scenario_id in {"pr-80", "inverted-auth-control-condition", "static-suspicion", "no-findings"})),
        "assertions": assertions,
        "native_runner_command": command_text,
        "workflow_path": LEGACY_PR_SMOKE_WORKFLOW_PATH,
        "run_root": str(run_root),
        "run_summary_path": str(run_root / "native-runner-summary.v1.json"),
        "brief_path": str(brief_path),
        "synthesis_path": str(synthesis_path),
        "final_review_path": str(final_path),
        "feedback_manifest_path": str(feedback_manifest_path),
        "publish_manifest_path": str(publish_manifest_path),
        "finding_count": counts.get("total", 0),
        "blocking_finding_count": counts.get("blocking", 0),
        "lane_failure_count": counts.get("lane_failed", 0),
        "lane_runs": lane_runs,
        "native_lane_step_provenance": provenance,
        "dirty_tree_checks": dirty_tree_checks,
    }

def evaluate_native_cutover_readiness(manifest: dict[str, Any]) -> dict[str, Any]:
    reasons: list[str] = []
    if manifest.get("execution_mode") != "native":
        reasons.append("execution_mode must be native")
    if manifest.get("remote_mutations") != "none":
        reasons.append("remote_mutations must be none")
    if manifest.get("status") != "passed":
        reasons.append("preflight status must be passed")
    if manifest.get("failed_scenario_count") != 0:
        reasons.append("failed_scenario_count must be 0")
    runner_command = str(manifest.get("native_runner_command") or "")
    if "gleam run -- workflow run " + LEGACY_PR_SMOKE_WORKFLOW_PATH not in runner_command:
        reasons.append(
            "native_runner_command must invoke Scherzo workflow run for "
            + LEGACY_PR_SMOKE_WORKFLOW_PATH
        )
    if "not exposed" in runner_command or "simulated" in runner_command:
        reasons.append("native_runner_command must not describe a missing or simulated runner")
    scenarios = manifest.get("scenarios", []) if isinstance(manifest.get("scenarios"), list) else []
    scenario_ids = {str(scenario.get("id")) for scenario in scenarios if isinstance(scenario, dict)}
    for required in ["pr-80", "inverted-auth-control-condition", "static-suspicion", "malformed-agent-output", "lane-failure", "no-findings", "lane-mutates-worktree"]:
        if required not in scenario_ids:
            reasons.append(f"required native scenario did not run: {required}")
    provenance = manifest.get("native_lane_step_provenance", []) if isinstance(manifest.get("native_lane_step_provenance"), list) else []
    for scenario in scenarios:
        if not isinstance(scenario, dict):
            continue
        sid = str(scenario.get("id"))
        for lane_id in NATIVE_PREFLIGHT_LANE_IDS:
            matching = [
                item for item in provenance
                if isinstance(item, dict)
                and item.get("scenario_id") == sid
                and item.get("lane_id") == lane_id
            ]
            if not matching:
                reasons.append(f"scenario {sid} missing native lane provenance for {lane_id}")
                continue
            item = matching[0]
            if item.get("native_artifact_source") != "scherzo_workflow_runner":
                reasons.append(f"scenario {sid} lane {lane_id} did not come from the Scherzo workflow runner")
            if item.get("source_type") != "pi_tool_call":
                reasons.append(f"scenario {sid} lane {lane_id} source_type was not pi_tool_call")
            if item.get("source_tool_name") not in ("submit_structured_output", "submit_review_lane_draft"):
                reasons.append(f"scenario {sid} lane {lane_id} source_tool_name was not submit_structured_output or submit_review_lane_draft")
            if not isinstance(item.get("review_local_validation"), dict):
                reasons.append(f"scenario {sid} lane {lane_id} missing review-local validation record")
            if "gleam run -- workflow run " + LEGACY_PR_SMOKE_WORKFLOW_PATH not in str(item.get("runner_invocation") or ""):
                reasons.append(f"scenario {sid} lane {lane_id} missing native runner invocation")
            if not item.get("run_summary_path"):
                reasons.append(f"scenario {sid} lane {lane_id} missing native runner summary path")
    return {
        "ready": not reasons,
        "status": "ready" if not reasons else "not_ready",
        "required_lanes": NATIVE_PREFLIGHT_LANE_IDS,
        "required_scenarios": ["pr-80", "inverted-auth-control-condition", "static-suspicion", "malformed-agent-output", "lane-failure", "no-findings", "lane-mutates-worktree"],
        "blocking_reasons": reasons,
    }


def validate_native_cutover_ready(manifest: dict[str, Any]) -> None:
    computed = evaluate_native_cutover_readiness(manifest)
    recorded = manifest.get("cutover_readiness")
    if computed.get("ready") is not True or not isinstance(recorded, dict) or recorded.get("ready") is not True:
        reasons = computed.get("blocking_reasons", [])
        if isinstance(reasons, list) and reasons:
            raise ReviewError(str(reasons[0]))
        raise ReviewError("native cutover readiness is false")


def native_preflight_command(args: argparse.Namespace) -> None:
    raise ReviewError(
        "native-preflight is retired because the standalone native review workflows "
        "were removed; run scripts/scherzo-review-lane-contract offline for "
        ".scherzo/workflows/implementation.yaml, "
        ".scherzo/workflows/execplan-implementation.yaml, and "
        ".scherzo/workflows/execplan-implementation-v2.yaml instead"
    )


def curated_legacy_prs() -> list[dict[str, Any]]:
    return [dict(item) for item in LEGACY_PR_CURATED_SET]


def curated_pr_by_number() -> dict[int, dict[str, Any]]:
    return {int(item["pr"]): dict(item) for item in LEGACY_PR_CURATED_SET}


def selected_legacy_prs(args: argparse.Namespace) -> list[dict[str, Any]]:
    curated = curated_pr_by_number()
    requested = getattr(args, "pr", None) or []
    if not requested:
        return curated_legacy_prs()
    selected: list[dict[str, Any]] = []
    seen: set[int] = set()
    for pr in requested:
        pr_number = int(pr)
        if pr_number in seen:
            continue
        seen.add(pr_number)
        if pr_number in curated:
            selected.append(dict(curated[pr_number]))
        else:
            selected.append({
                "pr": pr_number,
                "category": "operator_override",
                "expected_review_shape": "operator-selected historical PR",
                "rationale": "Operator override; not part of the checked-in curated legacy PR set.",
            })
    return selected


def require_legacy_pr_smoke_safe_environment() -> None:
    present = [name for name in LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS if os.environ.get(name)]
    if present:
        raise ReviewError(
            "legacy-pr-smoke refuses fixture/scenario/heuristic override environment variables: "
            + ", ".join(present)
            + "; unset them so the real native kind: agent lanes are used"
        )


def inspect_native_review_workflow_lanes(workflow_path: Path) -> dict[str, Any]:
    if not workflow_path.exists():
        raise ReviewError(f"native review workflow does not exist: {workflow_path}")
    text = workflow_path.read_text()
    lanes: list[dict[str, Any]] = []
    for lane_id in NATIVE_PREFLIGHT_LANE_IDS:
        step_id = native_lane_step_id(lane_id)
        block = workflow_step_block(workflow_path, step_id)
        kind_match = re.search(r"(?m)^\s*kind:\s*([^\s#]+)", block)
        required_match = re.search(r"(?m)^\s*required:\s*true\b", block)
        source_config = workflow_lane_source_config(workflow_path, step_id)
        lanes.append({
            "lane_id": lane_id,
            "step_id": step_id,
            "kind": kind_match.group(1) if kind_match else "missing",
            "structured_output_required": bool(required_match),
            "source_type": source_config["source_type"],
            "source_tool_name": source_config["source_tool_name"],
        })
    all_agent = all(lane["kind"] == "agent" for lane in lanes)
    if not all_agent:
        bad = ", ".join(
            lane["step_id"] + "=" + str(lane["kind"])
            for lane in lanes
            if lane["kind"] != "agent"
        )
        raise ReviewError("legacy-pr-smoke requires native review lanes to be kind: agent; found " + bad)
    require_review_lane_pi_tool_provenance(lanes, context="legacy PR smoke workflow")
    return {
        "workflow_path": workflow_path.as_posix(),
        "lane_steps": lanes,
        "all_lane_steps_are_kind_agent": all_agent,
    }


def legacy_pr_runner_args(*, run_root: Path, run_id: str) -> list[str]:
    prefix = ["direnv", "exec", "."] if shutil.which("direnv") else []
    unset_env: list[str] = ["env"]
    for name in LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS:
        unset_env.extend(["-u", name])
    return [
        *prefix,
        *unset_env,
        "gleam",
        "run",
        "--",
        "workflow",
        "run",
        LEGACY_PR_SMOKE_WORKFLOW_PATH,
        "--run-root",
        str(run_root),
        "--run-id",
        run_id,
    ]


def sanitized_subprocess_env() -> dict[str, str]:
    env = os.environ.copy()
    for name in LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS:
        env.pop(name, None)
    return env


def github_pr_metadata(pr_number: int, repo: str) -> dict[str, Any]:
    args = [
        "gh",
        "pr",
        "view",
        str(pr_number),
        "--repo",
        repo,
        "--json",
        "number,title,url,baseRefName,headRefName,author,mergedAt",
    ]
    try:
        value = json.loads(run_read_only(args))
    except (ReviewError, json.JSONDecodeError) as exc:
        return {
            "number": pr_number,
            "metadata_status": "unavailable",
            "metadata_error": str(exc),
        }
    return {
        "number": value.get("number", pr_number),
        "title": value.get("title"),
        "url": value.get("url"),
        "base_ref": value.get("baseRefName"),
        "head_ref": value.get("headRefName"),
        "author": (value.get("author") or {}).get("login") if isinstance(value.get("author"), dict) else None,
        "merged_at": value.get("mergedAt"),
        "metadata_status": "available",
    }


def download_legacy_pr_diff(*, pr_number: int, repo: str, input_diff_path: Path) -> dict[str, Any]:
    require_command("gh")
    diff = run_read_only([
        "gh",
        "pr",
        "diff",
        str(pr_number),
        "--repo",
        repo,
        "--color=never",
    ])
    input_diff_path.parent.mkdir(parents=True, exist_ok=True)
    input_diff_path.write_text(diff)
    files = parse_diff_files(diff)
    return {
        "path": str(input_diff_path),
        "sha256": sha256_text(diff),
        "byte_count": len(diff.encode("utf-8")),
        "changed_file_count": len(files),
    }


def validate_legacy_runner_summary(summary: dict[str, Any]) -> None:
    if summary.get("artifact_type") != "workflow_local_run_summary":
        raise ReviewError("native workflow runner summary had unexpected artifact_type")
    if summary.get("native_review_scenario") is not None:
        raise ReviewError("legacy-pr-smoke runner summary recorded a native_review_scenario")
    if summary.get("agent_lane_mode") != "real_agent":
        raise ReviewError("legacy-pr-smoke runner summary did not report real_agent lane mode")
    if summary.get("status") != "succeeded":
        raise ReviewError("native workflow runner summary status was not succeeded")


def run_legacy_pr_native_workflow(*, run_root: Path, run_id: str, logs_dir: Path) -> tuple[dict[str, Any], str]:
    logs_dir.mkdir(parents=True, exist_ok=True)
    args = legacy_pr_runner_args(run_root=run_root, run_id=run_id)
    command_text = shlex.join(args)
    (logs_dir / "native-runner-command.txt").write_text(command_text + "\n")
    summary_path = run_root / "native-runner-summary.v1.json"
    if "--native-review-scenario" in command_text:
        raise ReviewError("legacy-pr-smoke runner command unexpectedly used --native-review-scenario")
    started = time.monotonic()
    stdout_log = logs_dir / "native-runner.stdout.log"
    stderr_log = logs_dir / "native-runner.stderr.log"
    print(
        "REVIEW_LEGACY_PR_SMOKE_RUNNER_STARTED="
        + json.dumps({"run_id": run_id, "run_root": str(run_root)}, sort_keys=True),
        flush=True,
    )
    with stdout_log.open("w") as stdout_handle, stderr_log.open("w") as stderr_handle:
        proc = subprocess.Popen(
            args,
            text=True,
            stdout=stdout_handle,
            stderr=stderr_handle,
            env=sanitized_subprocess_env(),
        )
        next_heartbeat_at = started + LEGACY_PR_SMOKE_HEARTBEAT_SECONDS
        while True:
            returncode = proc.poll()
            if returncode is not None:
                break
            now = time.monotonic()
            if now >= next_heartbeat_at:
                print(
                    "REVIEW_LEGACY_PR_SMOKE_RUNNER_PROGRESS="
                    + json.dumps({
                        "elapsed_seconds": int(now - started),
                        "run_id": run_id,
                        "run_root": str(run_root),
                    }, sort_keys=True),
                    flush=True,
                )
                next_heartbeat_at = now + LEGACY_PR_SMOKE_HEARTBEAT_SECONDS
            time.sleep(1)
    elapsed_seconds = int(time.monotonic() - started)
    print(
        "REVIEW_LEGACY_PR_SMOKE_RUNNER_FINISHED="
        + json.dumps({
            "elapsed_seconds": elapsed_seconds,
            "exit_code": proc.returncode,
            "run_id": run_id,
            "run_root": str(run_root),
        }, sort_keys=True),
        flush=True,
    )
    if proc.returncode != 0:
        raise ReviewError(
            f"native workflow runner failed with exit {proc.returncode}; see {logs_dir / 'native-runner.stderr.log'}"
        )
    if not summary_path.exists():
        raise ReviewError(f"native workflow runner did not write summary: {summary_path}")
    summary = load_json(summary_path)
    validate_legacy_runner_summary(summary)
    return summary, command_text


def truncate_summary(value: Any, limit: int = 280) -> str:
    text = re.sub(r"\s+", " ", str(value or "")).strip()
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 1)].rstrip() + "…"


def compact_final_review_findings(final_review: dict[str, Any], limit: int) -> list[dict[str, Any]]:
    if limit <= 0:
        return []
    findings: list[dict[str, Any]] = []
    for field in ["blockers", "non_blocking_findings"]:
        values = final_review.get(field, [])
        if isinstance(values, list):
            findings.extend([value for value in values if isinstance(value, dict)])
    compact: list[dict[str, Any]] = []
    for finding in findings[:limit]:
        locations = finding.get("locations") if isinstance(finding.get("locations"), list) else []
        compact_locations = []
        for location in locations[:2]:
            if isinstance(location, dict):
                compact_locations.append({
                    "path": location.get("path"),
                    "start_line": location.get("start_line"),
                })
        compact.append({
            "id": finding.get("id"),
            "category": finding.get("category"),
            "severity": finding.get("severity"),
            "blocking": finding.get("blocking"),
            "summary": truncate_summary(finding.get("summary") or finding.get("title")),
            "locations": compact_locations,
        })
    return compact


def load_json_if_present(path: Path) -> dict[str, Any] | None:
    if not path.exists():
        return None
    try:
        return load_json(path)
    except ReviewError:
        return None


def draft_producer_from_step(step: dict[str, Any]) -> dict[str, Any] | None:
    draft_path = step_structured_path(step)
    if not draft_path:
        return None
    try:
        draft = load_review_lane_draft(Path(draft_path))
    except ReviewError:
        return None
    producer = draft.get("producer")
    if isinstance(producer, dict):
        return producer
    return None


def legacy_lane_execution_states(run_root: Path, runner_summary: dict[str, Any]) -> list[dict[str, Any]]:
    lanes: list[dict[str, Any]] = []
    for lane_id in NATIVE_PREFLIGHT_LANE_IDS:
        step_id = native_lane_step_id(lane_id)
        step = summary_step(runner_summary, step_id)
        lane_result_path = run_root / "artifacts/review/lanes" / lane_id / f"review-lane-{lane_id}.v1.json"
        lane_result = load_json_if_present(lane_result_path)
        execution_status = lane_result.get("execution_status", {}) if isinstance(lane_result, dict) and isinstance(lane_result.get("execution_status"), dict) else {}
        agent_backend = lane_result.get("agent_backend") if isinstance(lane_result, dict) else None
        draft_producer = draft_producer_from_step(step)
        producer_text = json.dumps(draft_producer or {}, sort_keys=True).lower()
        if agent_backend != "native":
            raise ReviewError(f"lane {lane_id} did not record native agent_backend: {agent_backend}")
        if execution_status.get("state") == "succeeded" and draft_producer is None:
            raise ReviewError(f"lane {lane_id} did not retain draft producer provenance")
        if "fixture" in producer_text or "heuristic" in producer_text:
            raise ReviewError(f"lane {lane_id} draft producer indicates fixture/heuristic mode")
        workflow_path = Path(LEGACY_PR_SMOKE_WORKFLOW_PATH)
        lanes.append({
            "lane_id": lane_id,
            "step_id": step_id,
            "step_status": step.get("status", "missing"),
            "structured_output_status": step_structured_status(step),
            "structured_output_path": step_structured_path(step),
            "structured_output_retry": step_structured_retry(step),
            "source_type": step_structured_source_type(step, workflow_path, step_id),
            "source_tool_name": step_structured_source_tool_name(step, workflow_path, step_id),
            "lane_result_state": execution_status.get("state", "missing"),
            "lane_result_path": str(lane_result_path),
            "review_local_validation": {
                "validator": "scripts/scherzo-review validate_review_lane_draft",
                "lane_result_state": str(execution_status.get("state", "missing")),
            },
            "agent_backend": agent_backend or "unknown",
            "draft_producer": draft_producer,
        })
    require_review_lane_pi_tool_provenance(lanes, context="legacy PR smoke")
    return lanes


def legacy_artifact_paths(run_root: Path) -> dict[str, str]:
    return {
        "input_diff": str(run_root / "input.diff"),
        "pr_metadata": str(run_root / "pr-metadata.v1.json"),
        "runner_summary": str(run_root / "native-runner-summary.v1.json"),
        "prepare_manifest": str(run_root / "artifacts/review/prepare_review/manifest.v1.json"),
        "synthesis": str(run_root / "artifacts/review/synthesize_review/review-synthesis.v1.json"),
        "final_review": str(run_root / "artifacts/review/apply_feedback/final-review.v1.json"),
        "feedback_manifest": str(run_root / "artifacts/review/apply_feedback/feedback-manifest.v1.json"),
        "publish_manifest": str(run_root / "artifacts/review/publish_review/publish-manifest.v1.json"),
        "runner_stdout_log": str(run_root / "logs/native-runner.stdout.log"),
        "runner_stderr_log": str(run_root / "logs/native-runner.stderr.log"),
    }


def summarize_successful_legacy_pr_run(
    *,
    pr_entry: dict[str, Any],
    repo: str,
    metadata: dict[str, Any],
    diff_ref: dict[str, Any],
    run_root: Path,
    runner_summary: dict[str, Any],
    command_text: str,
    finding_limit: int,
) -> dict[str, Any]:
    final_path = run_root / "artifacts/review/apply_feedback/final-review.v1.json"
    final_review = load_json(final_path)
    validate_final_review(final_review)
    publish_path = run_root / "artifacts/review/publish_review/publish-manifest.v1.json"
    publish = load_json_if_present(publish_path) or {}
    counts = final_review.get("finding_counts", {}) if isinstance(final_review.get("finding_counts"), dict) else {}
    lane_states = legacy_lane_execution_states(run_root, runner_summary)
    lane_failed_count = int(counts.get("lane_failed", 0) or 0)
    lane_failure_detected = lane_failed_count > 0 or any(
        lane.get("step_status") != "success"
        or lane.get("structured_output_status") != "valid"
        or lane.get("lane_result_state") != "succeeded"
        for lane in lane_states
    )
    run_status = "completed_with_lane_failures" if lane_failure_detected else "succeeded"
    return {
        "pr_number": int(pr_entry["pr"]),
        "repo": repo,
        "title": metadata.get("title"),
        "url": metadata.get("url"),
        "curation": {
            "category": pr_entry.get("category"),
            "expected_review_shape": pr_entry.get("expected_review_shape"),
            "rationale": pr_entry.get("rationale"),
        },
        "run_status": run_status,
        "workflow_path": LEGACY_PR_SMOKE_WORKFLOW_PATH,
        "run_root": str(run_root),
        "finding_counts": counts,
        "blocking_finding_count": counts.get("blocking", 0),
        "lane_failure_count": lane_failed_count,
        "lane_execution_states": lane_states,
        "remote_mutations": final_review.get("remote_mutations", publish.get("remote_mutations", "unknown")),
        "top_findings": compact_final_review_findings(final_review, finding_limit),
        "artifacts": legacy_artifact_paths(run_root),
        "diff": diff_ref,
        "provenance": {
            "semantic_reviewer": "native Scherzo workflow kind: agent lanes",
            "workflow_runner": "gleam workflow run",
            "runner_command": command_text,
            "native_review_scenario_arg_used": False,
            "native_review_scenario_summary_value": runner_summary.get("native_review_scenario"),
            "agent_lane_mode": runner_summary.get("agent_lane_mode"),
            "fixture_backend_used": False,
            "heuristic_backend_used": False,
            "forbidden_env_vars_rejected_if_present": LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS,
        },
    }


def failed_legacy_pr_run(
    *,
    pr_entry: dict[str, Any],
    repo: str,
    run_root: Path,
    metadata: dict[str, Any] | None,
    error: str,
) -> dict[str, Any]:
    return {
        "pr_number": int(pr_entry["pr"]),
        "repo": repo,
        "title": (metadata or {}).get("title"),
        "url": (metadata or {}).get("url"),
        "curation": {
            "category": pr_entry.get("category"),
            "expected_review_shape": pr_entry.get("expected_review_shape"),
            "rationale": pr_entry.get("rationale"),
        },
        "run_status": "failed",
        "workflow_path": LEGACY_PR_SMOKE_WORKFLOW_PATH,
        "run_root": str(run_root),
        "error": truncate_summary(error, 1000),
        "remote_mutations": "none",
        "artifacts": legacy_artifact_paths(run_root),
        "provenance": {
            "semantic_reviewer": "native Scherzo workflow kind: agent lanes",
            "native_review_scenario_arg_used": False,
            "fixture_backend_used": False,
            "heuristic_backend_used": False,
            "forbidden_env_vars_rejected_if_present": LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS,
        },
    }


def legacy_diff_ref_from_existing_run(run_root: Path) -> dict[str, Any]:
    input_diff_path = run_root / "input.diff"
    if not input_diff_path.exists():
        raise ReviewError(f"existing legacy PR run is missing input diff: {input_diff_path}")
    diff = input_diff_path.read_text()
    files = parse_diff_files(diff)
    return {
        "path": str(input_diff_path),
        "sha256": sha256_text(diff),
        "byte_count": len(diff.encode("utf-8")),
        "changed_file_count": len(files),
        "reused_existing_artifact": True,
    }


def summarize_existing_legacy_pr_run(
    *,
    pr_entry: dict[str, Any],
    repo: str,
    run_root: Path,
    finding_limit: int,
) -> dict[str, Any]:
    metadata_artifact = load_json(run_root / "pr-metadata.v1.json")
    metadata = metadata_artifact.get("pr") if isinstance(metadata_artifact.get("pr"), dict) else {}
    runner_summary = load_json(run_root / "native-runner-summary.v1.json")
    validate_legacy_runner_summary(runner_summary)
    command_path = run_root / "logs/native-runner-command.txt"
    command_text = command_path.read_text().strip() if command_path.exists() else "<not recorded>"
    result = summarize_successful_legacy_pr_run(
        pr_entry=pr_entry,
        repo=repo,
        metadata=metadata,
        diff_ref=legacy_diff_ref_from_existing_run(run_root),
        run_root=run_root,
        runner_summary=runner_summary,
        command_text=command_text,
        finding_limit=finding_limit,
    )
    result["reused_existing_run"] = True
    return result


def run_one_legacy_pr_smoke(
    *,
    pr_entry: dict[str, Any],
    repo: str,
    output_dir: Path,
    overwrite: bool,
    reuse_existing: bool,
    finding_limit: int,
) -> dict[str, Any]:
    pr_number = int(pr_entry["pr"])
    run_root = output_dir / f"pr-{pr_number}"
    if run_root.exists():
        if reuse_existing and (run_root / "native-runner-summary.v1.json").exists():
            return summarize_existing_legacy_pr_run(
                pr_entry=pr_entry,
                repo=repo,
                run_root=run_root,
                finding_limit=finding_limit,
            )
        if overwrite:
            shutil.rmtree(run_root)
        else:
            raise ReviewError(
                f"run root already exists: {run_root}; pass --overwrite to replace it or --reuse-existing to summarize a completed run"
            )
    run_root.mkdir(parents=True, exist_ok=True)
    metadata = github_pr_metadata(pr_number, repo)
    write_json(run_root / "pr-metadata.v1.json", {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "legacy_pr_metadata",
        "generated_at_utc": now_utc(),
        "repo": repo,
        "pr": metadata,
        "curation": pr_entry,
        "remote_mutations": "none",
    })
    diff_ref = download_legacy_pr_diff(
        pr_number=pr_number,
        repo=repo,
        input_diff_path=run_root / "input.diff",
    )
    runner_summary, command_text = run_legacy_pr_native_workflow(
        run_root=run_root,
        run_id=f"legacy-pr-{pr_number}",
        logs_dir=run_root / "logs",
    )
    return summarize_successful_legacy_pr_run(
        pr_entry=pr_entry,
        repo=repo,
        metadata=metadata,
        diff_ref=diff_ref,
        run_root=run_root,
        runner_summary=runner_summary,
        command_text=command_text,
        finding_limit=finding_limit,
    )


def legacy_pr_stdout_summary(result: dict[str, Any]) -> dict[str, Any]:
    return {
        "pr_number": result.get("pr_number"),
        "title": result.get("title"),
        "run_status": result.get("run_status"),
        "lane_execution_states": [
            {
                "lane_id": lane.get("lane_id"),
                "step_status": lane.get("step_status"),
                "structured_output_status": lane.get("structured_output_status"),
                "lane_result_state": lane.get("lane_result_state"),
            }
            for lane in result.get("lane_execution_states", [])
            if isinstance(lane, dict)
        ],
        "finding_counts": result.get("finding_counts"),
        "blocking_finding_count": result.get("blocking_finding_count"),
        "remote_mutations": result.get("remote_mutations"),
        "artifact_paths": result.get("artifacts"),
        "top_findings": result.get("top_findings", []),
        "error": result.get("error"),
    }


def legacy_pr_smoke_command(args: argparse.Namespace) -> None:
    if getattr(args, "list_curated", False):
        print("LEGACY_PR_SMOKE_CURATED_SET=" + json.dumps(curated_legacy_prs(), sort_keys=True))
        return
    if int(args.summary_finding_limit) < 0:
        raise ReviewError("--summary-finding-limit must be >= 0")
    require_legacy_pr_smoke_safe_environment()
    raise ReviewError(
        "legacy-pr-smoke is retired with the standalone native review workflow; "
        "validate routed implementation, execplan-implementation, and "
        "execplan-implementation-v2 review contracts with "
        "scripts/scherzo-review-lane-contract offline instead"
    )
    workflow_provenance = inspect_native_review_workflow_lanes(Path(LEGACY_PR_SMOKE_WORKFLOW_PATH))
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    selected = selected_legacy_prs(args)
    started_at = now_utc()
    results: list[dict[str, Any]] = []
    for pr_entry in selected:
        run_root = output_dir / f"pr-{int(pr_entry['pr'])}"
        metadata: dict[str, Any] | None = None
        try:
            result = run_one_legacy_pr_smoke(
                pr_entry=pr_entry,
                repo=args.repo,
                output_dir=output_dir,
                overwrite=bool(args.overwrite),
                reuse_existing=bool(args.reuse_existing),
                finding_limit=int(args.summary_finding_limit),
            )
        except Exception as exc:
            metadata = load_json_if_present(run_root / "pr-metadata.v1.json") or None
            pr_metadata = metadata.get("pr") if isinstance(metadata, dict) and isinstance(metadata.get("pr"), dict) else None
            result = failed_legacy_pr_run(
                pr_entry=pr_entry,
                repo=args.repo,
                run_root=run_root,
                metadata=pr_metadata,
                error=str(exc),
            )
        results.append(result)
        print(
            "REVIEW_LEGACY_PR_SMOKE_PR_SUMMARY="
            + json.dumps(legacy_pr_stdout_summary(result), sort_keys=True)
        )
    completed_at = now_utc()
    failed = [result for result in results if result.get("run_status") == "failed"]
    lane_failure_results = [
        result for result in results
        if result.get("run_status") == "completed_with_lane_failures"
    ]
    total_findings = 0
    blocking_findings = 0
    for result in results:
        counts = result.get("finding_counts") if isinstance(result.get("finding_counts"), dict) else {}
        total_findings += int(counts.get("total", 0) or 0)
        blocking_findings += int(counts.get("blocking", 0) or 0)
    manifest = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "legacy_pr_smoke_manifest",
        "generated_at_utc": completed_at,
        "started_at_utc": started_at,
        "status": "failed" if failed else ("completed_with_lane_failures" if lane_failure_results else "passed"),
        "repo": args.repo,
        "workflow_path": LEGACY_PR_SMOKE_WORKFLOW_PATH,
        "execution_mode": "native_real_agent_legacy_pr_smoke",
        "agent_backend": "native",
        "remote_mutations": "none",
        "context_safety": {
            "stdout_policy": "compact JSON summaries only; full diffs, transcripts, and final-review markdown are retained on disk",
            "full_diff_stdout": False,
            "full_transcript_stdout": False,
            "full_final_review_markdown_stdout": False,
            "summary_finding_limit": int(args.summary_finding_limit),
        },
        "curated_default_set": curated_legacy_prs(),
        "selected_prs": selected,
        "aggregate": {
            "run_count": len(results),
            "succeeded_run_count": len([
                result for result in results if result.get("run_status") == "succeeded"
            ]),
            "completed_with_lane_failures_run_count": len(lane_failure_results),
            "failed_run_count": len(failed),
            "finding_count": total_findings,
            "blocking_finding_count": blocking_findings,
        },
        "provenance": {
            "semantic_reviewer": "native Scherzo workflow kind: agent lanes",
            "workflow_lane_kind_validation": workflow_provenance,
            "native_review_scenario_arg_used": False,
            "fixture_backend_used": False,
            "heuristic_backend_used": False,
            "forbidden_env_vars_rejected_if_present": LEGACY_PR_SMOKE_FORBIDDEN_ENV_VARS,
            "runner_uses_env_unset_wrapper": True,
        },
        "runs": results,
    }
    validate_legacy_pr_smoke_manifest(manifest)
    manifest_path = output_dir / "legacy-pr-smoke-manifest.v1.json"
    write_json(manifest_path, manifest)
    aggregate_summary = {
        "status": manifest["status"],
        "run_count": len(results),
        "failed_run_count": len(failed),
        "completed_with_lane_failures_run_count": len(lane_failure_results),
        "finding_count": total_findings,
        "blocking_finding_count": blocking_findings,
        "manifest_path": str(manifest_path),
        "output_dir": str(output_dir),
        "remote_mutations": "none",
    }
    print("REVIEW_LEGACY_PR_SMOKE=" + ("failed" if failed else ("ok_with_lane_failures" if lane_failure_results else "ok")))
    print("REVIEW_LEGACY_PR_SMOKE_MANIFEST_PATH=" + str(manifest_path))
    print("REVIEW_LEGACY_PR_SMOKE_SUMMARY=" + json.dumps(aggregate_summary, sort_keys=True))
    if args.verbose:
        print("REVIEW_LEGACY_PR_SMOKE_VERBOSE=" + json.dumps(manifest, sort_keys=True))
    if failed:
        raise ReviewError("legacy PR smoke failed for " + ", ".join("#" + str(item.get("pr_number")) for item in failed) + "; see " + str(manifest_path))


def json_clone(value: Any) -> Any:
    return json.loads(json.dumps(value))


def severity_rank(severity: Any) -> int:
    if isinstance(severity, str):
        return SEVERITY_RANK.get(severity, -1)
    return -1


def highest_severity(left: str, right: str) -> str:
    return left if severity_rank(left) >= severity_rank(right) else right


def category_sort_index(category: Any) -> int:
    if isinstance(category, str) and category in CATEGORY_ORDER:
        return CATEGORY_ORDER.index(category)
    return len(CATEGORY_ORDER)


def evidence_rank(evidence_type: Any) -> int:
    order = {
        "unknown": 0,
        "manual": 1,
        "static": 2,
        "spec": 3,
        "test": 4,
        "runtime": 5,
        "reproduction": 6,
    }
    if isinstance(evidence_type, str):
        return order.get(evidence_type, 0)
    return 0


def normalized_text(value: Any) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip().lower()


def first_location_path(finding: dict[str, Any]) -> str:
    locations = finding.get("locations")
    if isinstance(locations, list) and locations:
        location = locations[0]
        if isinstance(location, dict):
            path = location.get("path")
            if isinstance(path, str) and path:
                return path
    return "."


def finding_dedupe_key(finding: dict[str, Any]) -> tuple[str, str, str]:
    return (
        normalized_text(finding.get("category")),
        normalized_text(finding.get("summary")),
        normalized_text(first_location_path(finding)),
    )


def compact_finding(finding: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": finding.get("id"),
        "category": finding.get("category"),
        "severity": finding.get("severity"),
        "blocking": finding.get("blocking"),
        "verified": finding.get("verified"),
        "evidence_type": finding.get("evidence_type"),
        "summary": finding.get("summary"),
        "locations": finding.get("locations", []),
        "source_lanes": finding.get("source_lanes", []),
    }


def first_note_location_path(note: dict[str, Any]) -> str:
    locations = note.get("locations")
    if isinstance(locations, list) and locations:
        location = locations[0]
        if isinstance(location, dict):
            path = location.get("path")
            if isinstance(path, str) and path:
                return path
    return "."


def review_note_dedupe_key(note: dict[str, Any]) -> tuple[str, str, str, str]:
    return (
        normalized_text(note.get("kind")),
        normalized_text(note.get("category")),
        normalized_text(note.get("summary")),
        normalized_text(first_note_location_path(note)),
    )


def normalize_review_note_for_synthesis(note: dict[str, Any], lane_id: str) -> dict[str, Any]:
    normalized = json_clone(note)
    normalized["source_lanes"] = [lane_id]
    normalized["source_note_ids"] = [note.get("id", "unknown")]
    locations = normalized.get("locations")
    if isinstance(locations, list):
        normalized["locations"] = dedupe_locations([
            location for location in locations if isinstance(location, dict)
        ])
    return normalized


def merge_duplicate_review_note(existing: dict[str, Any], incoming: dict[str, Any]) -> None:
    existing_sources = existing.setdefault("source_lanes", [])
    for lane in incoming.get("source_lanes", []):
        if lane not in existing_sources:
            existing_sources.append(lane)

    existing_ids = existing.setdefault("source_note_ids", [])
    for note_id in incoming.get("source_note_ids", []):
        if note_id not in existing_ids:
            existing_ids.append(note_id)

    existing["merged_duplicate_count"] = int(existing.get("merged_duplicate_count", 1)) + 1


def sort_review_notes(notes: list[dict[str, Any]]) -> list[dict[str, Any]]:
    kind_order = {"risk_note": 0, "coverage_note": 1, "follow_up_test": 2, "review_note": 3}
    return sorted(
        notes,
        key=lambda note: (
            kind_order.get(str(note.get("kind")), 10),
            category_sort_index(note.get("category")),
            -severity_rank(note.get("severity")),
            first_note_location_path(note),
            normalized_text(note.get("summary")),
        ),
    )


def normalize_finding_for_synthesis(
    finding: dict[str, Any], lane_id: str, actions: list[dict[str, Any]]
) -> dict[str, Any]:
    normalized = json_clone(finding)
    normalized["source_lanes"] = [lane_id]
    normalized["source_finding_ids"] = [finding.get("id", "unknown")]

    is_correctness = normalized.get("category") == "correctness"
    has_executable_evidence = (
        normalized.get("evidence_type") in EXECUTABLE_CORRECTNESS_EVIDENCE_TYPES
        and normalized.get("verified") is True
    )
    if is_correctness and not has_executable_evidence:
        changed = False
        if normalized.get("blocking"):
            normalized["blocking"] = False
            changed = True
        if normalized.get("verified") is not False:
            normalized["verified"] = False
            changed = True
        if severity_rank(normalized.get("severity")) > severity_rank("medium"):
            normalized["severity"] = "medium"
            changed = True
        if changed:
            normalized["finding_type"] = "suspicion"
            normalized["downgraded_by_synthesis"] = True
            normalized["details"] = (
                str(normalized.get("details", ""))
                + "\n\nDowngraded during synthesis because correctness blockers require verified executable evidence."
            )
            actions.append({
                "action": "downgraded_unproven_correctness_claim",
                "lane": lane_id,
                "finding_id": finding.get("id"),
                "reason": "correctness findings need test, runtime, or reproduction evidence before they can block",
            })

    if normalized.get("blocking") and normalized.get("verified") is not True:
        normalized["blocking"] = False
        normalized["downgraded_by_synthesis"] = True
        actions.append({
            "action": "downgraded_unverified_blocker",
            "lane": lane_id,
            "finding_id": finding.get("id"),
            "reason": "blocking findings must be verified enough for the final artifact to be actionable",
        })

    return normalized


def merge_duplicate_finding(
    existing: dict[str, Any], incoming: dict[str, Any], actions: list[dict[str, Any]]
) -> None:
    existing_sources = existing.setdefault("source_lanes", [])
    for lane in incoming.get("source_lanes", []):
        if lane not in existing_sources:
            existing_sources.append(lane)

    existing_ids = existing.setdefault("source_finding_ids", [])
    for finding_id in incoming.get("source_finding_ids", []):
        if finding_id not in existing_ids:
            existing_ids.append(finding_id)

    existing["merged_duplicate_count"] = int(existing.get("merged_duplicate_count", 1)) + 1
    old_severity = str(existing.get("severity", "info"))
    new_severity = str(incoming.get("severity", "info"))
    existing["severity"] = highest_severity(old_severity, new_severity)
    existing["blocking"] = bool(existing.get("blocking")) or bool(incoming.get("blocking"))
    existing["verified"] = bool(existing.get("verified")) or bool(incoming.get("verified"))

    if evidence_rank(incoming.get("evidence_type")) > evidence_rank(existing.get("evidence_type")):
        existing["evidence_type"] = incoming.get("evidence_type")

    incoming_fix = str(incoming.get("suggested_fix", "")).strip()
    existing_fix = str(existing.get("suggested_fix", "")).strip()
    if incoming_fix and existing_fix and normalized_text(incoming_fix) != normalized_text(existing_fix):
        alternatives = existing.setdefault("alternative_suggested_fixes", [])
        if incoming_fix not in alternatives and incoming_fix != existing_fix:
            alternatives.append(incoming_fix)
        existing["conflicting_recommendations_resolved"] = True
        actions.append({
            "action": "resolved_conflicting_recommendation",
            "finding_id": existing.get("id"),
            "source_lanes": existing.get("source_lanes", []),
            "reason": "duplicate findings recommended different fixes; retained the first fix and recorded alternatives",
        })
    else:
        actions.append({
            "action": "deduplicated_finding",
            "finding_id": existing.get("id"),
            "source_lanes": existing.get("source_lanes", []),
            "reason": "same category, summary, and primary location appeared in multiple lane outputs",
        })


def sort_findings(findings: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return sorted(
        findings,
        key=lambda finding: (
            -severity_rank(finding.get("severity")),
            category_sort_index(finding.get("category")),
            normalized_text(finding.get("summary")),
            first_location_path(finding),
        ),
    )


def assign_synthesized_ids(findings: list[dict[str, Any]]) -> None:
    for index, finding in enumerate(findings, start=1):
        finding["id"] = f"synthesized-{index:03d}"


def finding_counts(
    findings: list[dict[str, Any]],
    lane_statuses: list[dict[str, Any]],
    review_note_count: int = 0,
) -> dict[str, Any]:
    by_severity = {severity: 0 for severity in SEVERITY_ORDER}
    by_category = {category: 0 for category in CATEGORY_ORDER}
    for finding in findings:
        severity = finding.get("severity")
        if severity in by_severity:
            by_severity[severity] += 1
        category = finding.get("category")
        if category in by_category:
            by_category[category] += 1
        else:
            by_category["other"] += 1
    blocking_count = len([finding for finding in findings if finding.get("blocking")])
    return {
        "total": len(findings),
        "blocking": blocking_count,
        "non_blocking": len(findings) - blocking_count,
        "verified": len([finding for finding in findings if finding.get("verified")]),
        "review_notes": review_note_count,
        "by_severity": by_severity,
        "by_category": by_category,
        "lane_failed": len([lane for lane in lane_statuses if lane.get("state") == "failed"]),
        "lane_succeeded": len([lane for lane in lane_statuses if lane.get("state") == "succeeded"]),
    }


def group_findings(findings: list[dict[str, Any]]) -> dict[str, Any]:
    grouped: dict[str, Any] = {}
    for severity in SEVERITY_ORDER:
        severity_findings = [finding for finding in findings if finding.get("severity") == severity]
        if not severity_findings:
            continue
        categories: dict[str, Any] = {}
        for category in CATEGORY_ORDER:
            category_findings = [
                finding for finding in severity_findings if finding.get("category") == category
            ]
            if category_findings:
                categories[category] = [compact_finding(finding) for finding in category_findings]
        remaining = [
            finding for finding in severity_findings if finding.get("category") not in CATEGORY_ORDER
        ]
        if remaining:
            categories["other"] = [compact_finding(finding) for finding in remaining]
        grouped[severity] = categories
    return grouped


def compact_native_retry_status(result: dict[str, Any]) -> dict[str, Any] | None:
    retry = result.get("native_structured_output_retry")
    if not isinstance(retry, dict):
        return None
    compact: dict[str, Any] = {"outcome": str(retry.get("outcome") or "unknown")}
    attempts = retry.get("attempts")
    if isinstance(attempts, int):
        compact["attempts"] = attempts
    max_retries = retry.get("max_retries")
    if isinstance(max_retries, int):
        compact["max_retries"] = max_retries
    return compact


def lane_status_from_result(path: Path, result: dict[str, Any]) -> dict[str, Any]:
    lane = result.get("lane", {}) if isinstance(result.get("lane"), dict) else {}
    status = result.get("execution_status", {}) if isinstance(result.get("execution_status"), dict) else {}
    findings = result.get("findings", []) if isinstance(result.get("findings"), list) else []
    notes = result.get("review_notes", []) if isinstance(result.get("review_notes"), list) else []
    lane_status = {
        "lane_id": lane.get("id", "unknown"),
        "lane_name": lane.get("name", "unknown"),
        "state": status.get("state", "unknown"),
        "reason": status.get("reason"),
        "summary": status.get("summary", "no summary"),
        "error": status.get("error"),
        "finding_count": len(findings),
        "blocking_finding_count": len([finding for finding in findings if isinstance(finding, dict) and finding.get("blocking")]),
        "review_note_count": len(notes),
        "path": str(path),
        "sha256": sha256_file(path),
    }
    retry_status = compact_native_retry_status(result)
    if retry_status is not None:
        lane_status["structured_output_retry"] = retry_status
    return lane_status


def build_review_synthesis(
    *,
    brief_path: Path,
    brief: dict[str, Any],
    lane_results: list[tuple[Path, dict[str, Any]]],
    generated_at: str,
) -> dict[str, Any]:
    actions: list[dict[str, Any]] = []
    lane_statuses: list[dict[str, Any]] = []
    execution_issues: list[dict[str, Any]] = []
    by_key: dict[tuple[str, str, str], dict[str, Any]] = {}
    notes_by_key: dict[tuple[str, str, str, str], dict[str, Any]] = {}

    for lane_path, lane_result in lane_results:
        lane_status = lane_status_from_result(lane_path, lane_result)
        lane_statuses.append(lane_status)
        lane_id = str(lane_status.get("lane_id", "unknown"))
        if lane_status.get("state") != "succeeded":
            reason = lane_status.get("reason")
            execution_issues.append({
                "kind": "review_infrastructure_failure" if reason == "review_infrastructure_failure" else "lane_failure",
                "lane_id": lane_id,
                "path": str(lane_path),
                "reason": reason,
                "summary": lane_status.get("summary"),
                "error": lane_status.get("error"),
            })

        findings = lane_result.get("findings", [])
        if not isinstance(findings, list):
            raise ReviewError(f"lane result findings must be a list: {lane_path}")
        for finding in findings:
            if not isinstance(finding, dict):
                raise ReviewError(f"lane result findings must be objects: {lane_path}")
            normalized = normalize_finding_for_synthesis(finding, lane_id, actions)
            key = finding_dedupe_key(normalized)
            if key in by_key:
                merge_duplicate_finding(by_key[key], normalized, actions)
            else:
                by_key[key] = normalized

        review_notes = lane_result.get("review_notes", [])
        if review_notes is None:
            review_notes = []
        if not isinstance(review_notes, list):
            raise ReviewError(f"lane result review_notes must be a list: {lane_path}")
        for note in review_notes:
            if not isinstance(note, dict):
                raise ReviewError(f"lane result review_notes must be objects: {lane_path}")
            normalized_note = normalize_review_note_for_synthesis(note, lane_id)
            note_key = review_note_dedupe_key(normalized_note)
            if note_key in notes_by_key:
                merge_duplicate_review_note(notes_by_key[note_key], normalized_note)
            else:
                notes_by_key[note_key] = normalized_note

    normalized_findings = sort_findings(list(by_key.values()))
    normalized_notes = sort_review_notes(list(notes_by_key.values()))
    assign_synthesized_ids(normalized_findings)
    counts = finding_counts(normalized_findings, lane_statuses, len(normalized_notes))
    lane_failure_count = counts["lane_failed"]
    execution_state = "completed" if lane_failure_count == 0 else "completed_with_lane_failures"
    if not lane_results:
        execution_issues.append({
            "kind": "missing_lane_results",
            "summary": "No lane result artifacts were supplied to synthesis.",
        })
        execution_state = "completed_with_lane_failures"

    return {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_synthesis",
        "generated_at_utc": generated_at,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "synthesize",
        },
        "brief_ref": {
            "artifact_type": "review_brief",
            "path": str(brief_path),
            "sha256": sha256_file(brief_path),
        },
        "source": brief.get("source"),
        "lane_results": lane_statuses,
        "execution_summary": {
            "state": execution_state,
            "summary": (
                f"Synthesized {len(normalized_findings)} normalized finding(s) from "
                f"{len(lane_results)} lane result artifact(s); {lane_failure_count} lane(s) failed."
            ),
        },
        "execution_issues": execution_issues,
        "normalized_findings": normalized_findings,
        "review_notes": normalized_notes,
        "grouped_findings": group_findings(normalized_findings),
        "finding_counts": counts,
        "synthesis_actions": actions,
        "remote_mutations": "none",
        "concise_policy": {
            "markdown_max_listed_findings": 12,
            "dropped_unverified_correctness_blockers": len([
                action for action in actions if action.get("action") == "downgraded_unproven_correctness_claim"
            ]),
        },
    }


def first_location_label(item: dict[str, Any]) -> str:
    locations = item.get("locations") if isinstance(item.get("locations"), list) else []
    if locations and isinstance(locations[0], dict):
        path = locations[0].get("path")
        if isinstance(path, str) and path:
            return path
    return "."


def lane_retry_markdown_suffix(lane_status: dict[str, Any]) -> str:
    retry = lane_status.get("structured_output_retry")
    if not isinstance(retry, dict):
        return ""
    outcome = str(retry.get("outcome") or "unknown")
    attempts = retry.get("attempts")
    attempts_text = str(attempts) if isinstance(attempts, int) else "unknown"
    if outcome == "succeeded":
        return f"Structured output succeeded on retry after {attempts_text} attempts."
    if outcome == "failed":
        return f"Structured output retry remained failed after {attempts_text} attempts."
    return f"Structured output retry outcome: {outcome}."


def render_final_review_markdown(brief: dict[str, Any], synthesis: dict[str, Any]) -> str:
    source = brief.get("source", {}) if isinstance(brief.get("source"), dict) else {}
    counts = synthesis.get("finding_counts", {}) if isinstance(synthesis.get("finding_counts"), dict) else {}
    findings = synthesis.get("normalized_findings", [])
    if not isinstance(findings, list):
        findings = []
    notes = synthesis.get("review_notes", [])
    if not isinstance(notes, list):
        notes = []
    blockers = [finding for finding in findings if isinstance(finding, dict) and finding.get("blocking")]
    non_blocking = [
        finding for finding in findings
        if isinstance(finding, dict) and not finding.get("blocking")
    ]
    execution_issues = synthesis.get("execution_issues", [])
    if not isinstance(execution_issues, list):
        execution_issues = []

    lines = [
        "# Staged review summary",
        "",
        f"Source: {source.get('label', 'unknown source')} ({source.get('kind', 'unknown')}).",
        f"Remote mutations: {synthesis.get('remote_mutations', 'none')}.",
        "",
        "## Result",
    ]
    if blockers:
        lines.append(f"{len(blockers)} blocker(s) require attention before publish.")
    else:
        lines.append("No blocking findings were produced by the staged review workflow.")
    if non_blocking:
        lines.append(f"{len(non_blocking)} non-blocking finding(s) remain for reviewer judgment.")
    if notes:
        lines.append(f"{len(notes)} risk/coverage/review note(s) were retained separately from findings.")
    if execution_issues:
        lines.append(f"{len(execution_issues)} lane execution issue(s) were isolated and retained for diagnosis.")

    lines.extend(["", "## Blockers"])
    if blockers:
        for finding in blockers[:8]:
            location = first_location_label(finding)
            lines.append(
                f"- [{finding.get('severity')}/{finding.get('category')}] {finding.get('summary')} "
                f"({location}; evidence={finding.get('evidence_type')}, verified={finding.get('verified')})"
            )
        if len(blockers) > 8:
            lines.append(f"- ... and {len(blockers) - 8} more blocker(s).")
    else:
        lines.append("- None.")

    lines.extend(["", "## Non-blocking findings"])
    listed = 0
    max_listed = 10
    for finding in non_blocking:
        if listed >= max_listed:
            continue
        location = first_location_label(finding)
        lines.append(
            f"- [{finding.get('severity')}/{finding.get('category')}] {finding.get('summary')} "
            f"({location}; evidence={finding.get('evidence_type')})"
        )
        listed += 1
    if non_blocking and listed < len(non_blocking):
        lines.append(f"- ... {len(non_blocking) - listed} additional non-blocking finding(s) omitted; see JSON artifact.")
    if not non_blocking:
        if not findings:
            lines.append("- No findings from any lane.")
        else:
            lines.append("- None.")

    lines.extend(["", "## Risk / coverage / review notes"])
    max_notes = 8
    for index, note in enumerate([note for note in notes if isinstance(note, dict)]):
        if index >= max_notes:
            continue
        location = first_location_label(note)
        lines.append(
            f"- [{note.get('kind')}/{note.get('category')}] {note.get('summary')} ({location})"
        )
    if notes and len(notes) > max_notes:
        lines.append(f"- ... {len(notes) - max_notes} additional note(s) omitted; see JSON artifact.")
    if not notes:
        lines.append("- None.")

    if execution_issues:
        lines.extend(["", "## Lane execution issues"])
        for issue in execution_issues:
            if isinstance(issue, dict):
                lines.append(f"- {issue.get('lane_id', issue.get('kind', 'unknown'))}: {issue.get('summary')} ({issue.get('error')})")

    lines.extend(["", "## Lane health"])
    lane_results = synthesis.get("lane_results", [])
    if isinstance(lane_results, list) and lane_results:
        for lane in lane_results:
            if isinstance(lane, dict):
                line = (
                    f"- {lane.get('lane_id')}: {lane.get('state')} with {lane.get('finding_count')} finding(s) "
                    f"and {lane.get('review_note_count', 0)} note(s)."
                )
                retry_suffix = lane_retry_markdown_suffix(lane)
                if retry_suffix:
                    line += " " + retry_suffix
                lines.append(line)
    else:
        lines.append("- No lane result artifacts were supplied.")

    lines.extend([
        "",
        "## Counts",
        f"- Total findings: {counts.get('total', 0)}",
        f"- Blocking findings: {counts.get('blocking', 0)}",
        f"- Non-blocking findings: {counts.get('non_blocking', 0)}",
        f"- Review notes: {counts.get('review_notes', len(notes))}",
    ])
    return "\n".join(lines) + "\n"


def final_review_summary(synthesis: dict[str, Any]) -> str:
    counts = synthesis.get("finding_counts", {}) if isinstance(synthesis.get("finding_counts"), dict) else {}
    execution_issues = synthesis.get("execution_issues", [])
    issue_count = len(execution_issues) if isinstance(execution_issues, list) else 0
    total = counts.get("total", 0)
    blocking = counts.get("blocking", 0)
    note_count = counts.get("review_notes", 0)
    if total == 0:
        finding_text = "No findings were produced by the review lanes."
    else:
        finding_text = f"Synthesized {total} finding(s), including {blocking} blocker(s)."
    if note_count:
        finding_text += f" Retained {note_count} risk/coverage/review note(s) separately."
    if issue_count:
        return finding_text + f" {issue_count} lane execution issue(s) were isolated for diagnosis."
    return finding_text


def build_final_review_artifact(
    *,
    brief_path: Path,
    brief: dict[str, Any],
    synthesis_path: Path,
    synthesis: dict[str, Any],
    generated_at: str,
) -> dict[str, Any]:
    findings = synthesis.get("normalized_findings", [])
    if not isinstance(findings, list):
        findings = []
    blockers = [json_clone(finding) for finding in findings if isinstance(finding, dict) and finding.get("blocking")]
    non_blocking = [
        json_clone(finding) for finding in findings
        if isinstance(finding, dict) and not finding.get("blocking")
    ]
    notes = synthesis.get("review_notes", [])
    if not isinstance(notes, list):
        notes = []
    return {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "final_review",
        "generated_at_utc": generated_at,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "synthesize",
        },
        "brief_ref": {
            "artifact_type": "review_brief",
            "path": str(brief_path),
            "sha256": sha256_file(brief_path),
        },
        "synthesis_ref": {
            "artifact_type": "review_synthesis",
            "path": str(synthesis_path),
            "sha256": sha256_file(synthesis_path),
        },
        "title": "Scherzo staged review",
        "summary": final_review_summary(synthesis),
        "finding_counts": synthesis.get("finding_counts", {}),
        "grouped_findings": synthesis.get("grouped_findings", {}),
        "blockers": blockers,
        "non_blocking_findings": non_blocking,
        "review_notes": json_clone(notes),
        "lane_statuses": synthesis.get("lane_results", []),
        "execution_issues": synthesis.get("execution_issues", []),
        "markdown": render_final_review_markdown(brief, synthesis),
        "remote_mutations": "none",
    }


def synthesis_log_text(
    *,
    started_at: str,
    completed_at: str,
    brief_path: Path,
    lane_paths: list[Path],
    synthesis: dict[str, Any],
) -> str:
    counts = synthesis.get("finding_counts", {}) if isinstance(synthesis.get("finding_counts"), dict) else {}
    lines = [
        "scherzo-review synthesize",
        f"started_at_utc={started_at}",
        f"completed_at_utc={completed_at}",
        f"brief_path={brief_path}",
        f"brief_sha256={sha256_file(brief_path)}",
        f"lane_result_count={len(lane_paths)}",
        f"finding_count={counts.get('total', 0)}",
        f"review_note_count={counts.get('review_notes', 0)}",
        f"blocking_finding_count={counts.get('blocking', 0)}",
        f"lane_failed_count={counts.get('lane_failed', 0)}",
        "remote_mutations=none",
    ]
    for lane_path in lane_paths:
        lines.append(f"lane_result={lane_path}")
    for issue in synthesis.get("execution_issues", []):
        if isinstance(issue, dict):
            lines.append(f"execution_issue={issue.get('kind')}:{issue.get('lane_id', 'unknown')}:{issue.get('summary')}")
    return "\n".join(lines) + "\n"


def all_lanes_review_infrastructure_failures(lane_results: list[tuple[Path, dict[str, Any]]]) -> bool:
    if not lane_results:
        return False
    for _, lane_result in lane_results:
        status = lane_result.get("execution_status")
        if not isinstance(status, dict):
            return False
        if status.get("state") != "failed" or status.get("reason") != "review_infrastructure_failure":
            return False
    return True


def review_infrastructure_failure_diagnostic(lane_results: list[tuple[Path, dict[str, Any]]]) -> dict[str, Any]:
    lanes = []
    for lane_path, lane_result in lane_results:
        lane = lane_result.get("lane", {}) if isinstance(lane_result.get("lane"), dict) else {}
        status = lane_result.get("execution_status", {}) if isinstance(lane_result.get("execution_status"), dict) else {}
        lanes.append({
            "lane_id": lane.get("id", "unknown"),
            "lane_result_path": str(lane_path),
            "summary": status.get("summary"),
            "error": status.get("error"),
            "artifacts": lane_result.get("artifacts", []),
        })
    return {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_infrastructure_failure",
        "generated_at_utc": now_utc(),
        "code": "review_infrastructure_all_lanes_failed",
        "summary": "all native review lanes failed with review infrastructure failures",
        "lane_ids": [str(lane.get("lane_id", "unknown")) for lane in lanes],
        "lanes": lanes,
        "remote_mutations": "none",
    }


def synthesize_command(args: argparse.Namespace) -> None:
    started_at = now_utc()
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    brief_path = Path(args.brief)
    brief = load_json(brief_path)
    validate_review_brief(brief)

    lane_paths = [Path(path) for path in args.lane_result]
    lane_results: list[tuple[Path, dict[str, Any]]] = []
    for lane_path in lane_paths:
        lane_result = load_json(lane_path)
        validate_review_lane_result(lane_result)
        lane_results.append((lane_path, lane_result))

    generated_at = now_utc()
    synthesis = build_review_synthesis(
        brief_path=brief_path,
        brief=brief,
        lane_results=lane_results,
        generated_at=generated_at,
    )
    validate_review_synthesis(synthesis)

    synthesis_path = output_dir / "review-synthesis.v1.json"
    write_json(synthesis_path, synthesis)

    completed_at = now_utc()
    log_path = output_dir / "review-synthesis.log"
    log_path.write_text(synthesis_log_text(
        started_at=started_at,
        completed_at=completed_at,
        brief_path=brief_path,
        lane_paths=lane_paths,
        synthesis=synthesis,
    ))

    if all_lanes_review_infrastructure_failures(lane_results):
        diagnostic = review_infrastructure_failure_diagnostic(lane_results)
        diagnostic_path = output_dir / "review-infrastructure-failure.v1.json"
        write_json(diagnostic_path, diagnostic)
        manifest = {
            "schema_version": SCHEMA_VERSION,
            "artifact_type": "review_synthesis_manifest",
            "generated_at_utc": completed_at,
            "remote_mutations": "none",
            "artifacts": [
                {"path": synthesis_path.name, "sha256": sha256_file(synthesis_path)},
                {"path": diagnostic_path.name, "sha256": sha256_file(diagnostic_path)},
                {"path": log_path.name, "sha256": sha256_file(log_path)},
            ],
        }
        manifest_path = output_dir / "manifest.v1.json"
        write_json(manifest_path, manifest)
        counts = synthesis.get("finding_counts", {})
        print("REVIEW_SYNTHESIS=review_infrastructure_failure")
        print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
        print(f"REVIEW_ARTIFACT_DIR={output_dir}")
        print(f"REVIEW_SYNTHESIS_PATH={synthesis_path}")
        print(f"REVIEW_INFRASTRUCTURE_FAILURE_PATH={diagnostic_path}")
        print(f"REVIEW_SYNTHESIS_LOG_PATH={log_path}")
        print(f"REVIEW_FINDINGS={counts.get('total', 0)}")
        print(f"REVIEW_LANE_FAILURES={counts.get('lane_failed', 0)}")
        print("REVIEW_REMOTE_MUTATIONS=none")
        sys.exit(42)

    final_review = build_final_review_artifact(
        brief_path=brief_path,
        brief=brief,
        synthesis_path=synthesis_path,
        synthesis=synthesis,
        generated_at=now_utc(),
    )
    validate_final_review(final_review)
    final_path = output_dir / "final-review.v1.json"
    write_json(final_path, final_review)

    manifest = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_synthesis_manifest",
        "generated_at_utc": completed_at,
        "remote_mutations": "none",
        "artifacts": [
            {"path": synthesis_path.name, "sha256": sha256_file(synthesis_path)},
            {"path": final_path.name, "sha256": sha256_file(final_path)},
            {"path": log_path.name, "sha256": sha256_file(log_path)},
        ],
    }
    manifest_path = output_dir / "manifest.v1.json"
    write_json(manifest_path, manifest)

    counts = synthesis.get("finding_counts", {})
    print("REVIEW_SYNTHESIS=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_ARTIFACT_DIR={output_dir}")
    print(f"REVIEW_SYNTHESIS_PATH={synthesis_path}")
    print(f"REVIEW_FINAL_ARTIFACT_PATH={final_path}")
    print(f"REVIEW_SYNTHESIS_LOG_PATH={log_path}")
    print(f"REVIEW_FINDINGS={counts.get('total', 0)}")
    print(f"REVIEW_REVIEW_NOTES={counts.get('review_notes', 0)}")
    print(f"REVIEW_BLOCKING_FINDINGS={counts.get('blocking', 0)}")
    print(f"REVIEW_LANE_FAILURES={counts.get('lane_failed', 0)}")
    print("REVIEW_REMOTE_MUTATIONS=none")


def dry_run_command(args: argparse.Namespace) -> None:
    started_at = now_utc()
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    diff, source = diff_source_from_args(args)

    files = parse_diff_files(diff)
    generated_at = now_utc()
    test_status = parse_test_status(args.test_status)
    brief = build_review_brief(
        source=source,
        diff=diff,
        files=files,
        test_status=test_status,
        generated_at=generated_at,
    )
    validate_review_brief(brief)

    brief_path = output_dir / "review-brief.v1.json"
    write_json(brief_path, brief)

    completed_at = now_utc()
    log_path = output_dir / "review-dry-run.log"
    log_path.write_text(
        "scherzo-review dry-run\n"
        f"started_at_utc={started_at}\n"
        f"completed_at_utc={completed_at}\n"
        f"source_kind={source.get('kind')}\n"
        f"changed_file_count={len(files)}\n"
        "remote_mutations=none\n"
        f"review_brief_path={brief_path}\n"
    )

    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": completed_at,
        "lane": {
            "id": "review_brief",
            "name": "Review brief generation",
            "category": "brief",
            "version": "1",
        },
        "execution_status": {
            "state": "succeeded",
            "started_at_utc": started_at,
            "completed_at_utc": completed_at,
            "summary": f"Generated ReviewBrief for {len(files)} changed file(s).",
        },
        "input_brief_ref": None,
        "findings": [],
        "artifacts": [
            {
                "artifact_type": "review_brief",
                "path": brief_path.name,
                "sha256": sha256_file(brief_path),
            },
            {
                "artifact_type": "log",
                "path": log_path.name,
                "sha256": sha256_file(log_path),
            },
        ],
    }
    validate_review_lane_result(lane_result)
    lane_result_path = output_dir / "review-lane-result.v1.json"
    write_json(lane_result_path, lane_result)

    manifest = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_dry_run_manifest",
        "generated_at_utc": completed_at,
        "remote_mutations": "none",
        "artifacts": [
            {"path": brief_path.name, "sha256": sha256_file(brief_path)},
            {"path": lane_result_path.name, "sha256": sha256_file(lane_result_path)},
            {"path": log_path.name, "sha256": sha256_file(log_path)},
        ],
    }
    manifest_path = output_dir / "manifest.v1.json"
    write_json(manifest_path, manifest)

    print("REVIEW_DRY_RUN=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_ARTIFACT_DIR={output_dir}")
    print(f"REVIEW_BRIEF_PATH={brief_path}")
    print(f"REVIEW_LANE_RESULT_PATH={lane_result_path}")
    print(f"REVIEW_LOG_PATH={log_path}")
    print("REVIEW_REMOTE_MUTATIONS=none")
    print(f"REVIEW_CHANGED_FILES={len(files)}")


def run_lane_command(args: argparse.Namespace) -> None:
    started_at = now_utc()
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    lane_id = args.lane
    brief_path = Path(args.brief)
    brief = load_json(brief_path)
    validate_review_brief(brief)
    diff, source = diff_source_from_args(args)
    files = parse_diff_files(diff)
    backend = agent_lane_harness.parse_agent_backend(getattr(args, "agent_backend", "heuristic"))
    if backend == "external":
        print(
            "REVIEW_AGENT_BACKEND_WARNING=external backend is legacy rollback only; use the native Scherzo review workflow for production staged review",
            file=sys.stderr,
        )

    if backend != "heuristic":
        try:
            lane_result, analysis, lane_result_path, log_path, analysis_path = agent_lane_harness.run_agent_lane(
                lane_id=lane_id,
                lane_metadata=SPECIALIST_LANES[lane_id],
                brief_path=brief_path,
                brief=brief,
                diff=diff,
                source=source,
                files=files,
                output_dir=output_dir,
                backend=backend,
                scenario_id=source.get("label"),
                schema_ref=CONTRACT_SCHEMA_REF,
            )
        except agent_lane_harness.HarnessError as exc:
            raise ReviewError(str(exc)) from exc
        validate_review_lane_result(lane_result)
        findings = lane_result.get("findings", []) if isinstance(lane_result.get("findings"), list) else []
        notes = lane_result.get("review_notes", []) if isinstance(lane_result.get("review_notes"), list) else []
        print("REVIEW_LANE_RUN=ok")
        print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
        print(f"REVIEW_LANE={lane_id}")
        print(f"REVIEW_AGENT_BACKEND={backend}")
        print(f"REVIEW_LANE_RESULT_PATH={lane_result_path}")
        print(f"REVIEW_LANE_LOG_PATH={log_path}")
        print(f"REVIEW_LANE_ANALYSIS_PATH={analysis_path}")
        print(f"REVIEW_LANE_FINDINGS={len(findings)}")
        print(f"REVIEW_LANE_REVIEW_NOTES={len(notes)}")
        print(f"REVIEW_LANE_BLOCKING_FINDINGS={analysis.get('blocking_finding_count')}")
        print(f"REVIEW_LANE_REVIEW_DEPTH={analysis.get('review_depth')}")
        return

    findings, notes, analysis = run_specialist_lane(lane_id, brief, files)
    completed_at = now_utc()

    analysis_path = output_dir / f"review-lane-{lane_id}-analysis.v1.json"
    write_json(analysis_path, analysis)
    log_path = output_dir / f"review-lane-{lane_id}.log"
    log_path.write_text(lane_log_text(
        lane_id=lane_id,
        started_at=started_at,
        completed_at=completed_at,
        brief_path=brief_path,
        source=source,
        diff=diff,
        analysis=analysis,
    ))

    lane = SPECIALIST_LANES[lane_id]
    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": completed_at,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "run-lane",
        },
        "lane": lane,
        "execution_status": {
            "state": "succeeded",
            "started_at_utc": started_at,
            "completed_at_utc": completed_at,
            "summary": f"{lane['name']} completed with {len(findings)} finding(s).",
        },
        "agent_backend": "heuristic",
        "input_brief_ref": {
            "path": str(brief_path),
            "sha256": sha256_file(brief_path),
        },
        "findings": findings,
        "review_notes": notes,
        "artifacts": [
            {
                "artifact_type": "review_lane_analysis",
                "path": analysis_path.name,
                "sha256": sha256_file(analysis_path),
            },
            {
                "artifact_type": "log",
                "path": log_path.name,
                "sha256": sha256_file(log_path),
            },
        ],
        "source": {
            **source,
            "diff_sha256": sha256_text(diff),
            "changed_file_count": len(files),
        },
        "review_depth": analysis.get("review_depth"),
        "empty_findings_reason": analysis.get("empty_findings_reason"),
    }
    validate_review_lane_result(lane_result)
    lane_result_path = output_dir / f"review-lane-{lane_id}.v1.json"
    write_json(lane_result_path, lane_result)

    print("REVIEW_LANE_RUN=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_LANE={lane_id}")
    print(f"REVIEW_AGENT_BACKEND={backend}")
    print(f"REVIEW_LANE_RESULT_PATH={lane_result_path}")
    print(f"REVIEW_LANE_LOG_PATH={log_path}")
    print(f"REVIEW_LANE_ANALYSIS_PATH={analysis_path}")
    print(f"REVIEW_LANE_FINDINGS={len(findings)}")
    print(f"REVIEW_LANE_REVIEW_NOTES={len(notes)}")
    print(f"REVIEW_LANE_BLOCKING_FINDINGS={analysis.get('blocking_finding_count')}")
    print(f"REVIEW_LANE_REVIEW_DEPTH={analysis.get('review_depth')}")


def failed_lane_brief_ref(args: argparse.Namespace) -> dict[str, str] | None:
    brief = getattr(args, "brief", None)
    if not brief:
        return None
    brief_path = Path(brief)
    if not brief_path.exists():
        return {"path": str(brief_path)}
    return {"path": str(brief_path), "sha256": sha256_file(brief_path)}


def write_failed_lane_artifacts(args: argparse.Namespace, message: str) -> None:
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    lane_id = args.lane
    timestamp = now_utc()
    backend = agent_lane_harness.parse_agent_backend(getattr(args, "agent_backend", "heuristic"))
    log_path = output_dir / f"review-lane-{lane_id}.log"
    log_path.write_text(
        "scherzo-review run-lane\n"
        f"lane={lane_id}\n"
        f"agent_backend={backend}\n"
        f"started_at_utc={timestamp}\n"
        f"completed_at_utc={timestamp}\n"
        "state=failed\n"
        f"error={message}\n"
    )
    lane = SPECIALIST_LANES[lane_id]
    retained_artifacts = agent_lane_harness.collect_existing_agent_artifacts(output_dir)
    retained_artifacts.append({
        "artifact_type": "log",
        "path": log_path.name,
        "sha256": sha256_file(log_path),
    })
    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": timestamp,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "run-lane",
        },
        "lane": lane,
        "execution_status": {
            "state": "failed",
            "started_at_utc": timestamp,
            "completed_at_utc": timestamp,
            "summary": f"{lane['name']} failed before producing findings.",
            "error": message,
        },
        "agent_backend": backend,
        "input_brief_ref": failed_lane_brief_ref(args),
        "findings": [],
        "review_notes": [],
        "artifacts": retained_artifacts,
    }
    validate_review_lane_result(lane_result)
    lane_result_path = output_dir / f"review-lane-{lane_id}.v1.json"
    write_json(lane_result_path, lane_result)
    print("REVIEW_LANE_RUN=failed")
    print(f"REVIEW_LANE={lane_id}")
    print(f"REVIEW_AGENT_BACKEND={backend}")
    print(f"REVIEW_LANE_RESULT_PATH={lane_result_path}")
    print(f"REVIEW_LANE_LOG_PATH={log_path}")


PREFLIGHT_LANE_IDS = [
    "correctness",
    "test-quality",
    "idioms-maintainability",
    "security-performance",
]


