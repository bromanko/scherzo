def preflight_run_subcommand(
    argv: list[str], log_path: Path, *, expect_success: bool = True
) -> subprocess.CompletedProcess[str]:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    command = [sys.executable, str(Path(__file__).resolve()), *argv]
    proc = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    log_path.write_text(
        "$ " + " ".join(command) + "\n"
        + f"exit_code={proc.returncode}\n"
        + "--- stdout ---\n"
        + proc.stdout
        + "--- stderr ---\n"
        + proc.stderr
    )
    succeeded = proc.returncode == 0
    if succeeded != expect_success:
        expectation = "succeed" if expect_success else "fail"
        raise ReviewError(
            f"preflight command was expected to {expectation} but exited {proc.returncode}; see {log_path}"
        )
    return proc


def preflight_validate_artifact(path: Path, log_path: Path) -> None:
    try:
        value = load_json(path)
        validate_artifact(value)
    except ReviewError as exc:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        log_path.write_text(f"artifact={path}\nstatus=failed\nerror={exc}\n")
        raise
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.write_text(
        f"artifact={path}\nstatus=ok\nartifact_type={value.get('artifact_type')}\nschema_version={value.get('schema_version')}\n"
    )


def preflight_has_synthesis_action(synthesis: dict[str, Any], action_name: str) -> bool:
    actions = synthesis.get("synthesis_actions", [])
    if not isinstance(actions, list):
        return False
    return any(
        isinstance(action, dict) and action.get("action") == action_name
        for action in actions
    )


def preflight_has_execution_issue(synthesis: dict[str, Any], kind: str) -> bool:
    issues = synthesis.get("execution_issues", [])
    if not isinstance(issues, list):
        return False
    return any(
        isinstance(issue, dict) and issue.get("kind") == kind
        for issue in issues
    )


def preflight_assert_scenario_expectations(
    scenario: dict[str, Any],
    scenario_id: str,
    synthesis: dict[str, Any],
    final_review: dict[str, Any],
) -> None:
    counts = (
        final_review.get("finding_counts", {})
        if isinstance(final_review.get("finding_counts"), dict)
        else {}
    )
    if scenario.get("expect_empty_findings") and counts.get("total") != 0:
        raise ReviewError(
            f"scenario {scenario_id} expected empty findings but saw {counts.get('total')}"
        )
    if final_review.get("remote_mutations") != "none":
        raise ReviewError(
            f"scenario {scenario_id} final artifact did not preserve remote_mutations=none"
        )

    if scenario.get("mode") == "lane_failure":
        if counts.get("lane_failed", 0) < 1:
            raise ReviewError(
                f"scenario {scenario_id} expected at least one failed lane in synthesis counts"
            )
        if not preflight_has_execution_issue(synthesis, "lane_failure"):
            raise ReviewError(
                f"scenario {scenario_id} expected a lane_failure execution issue in synthesis"
            )

    expected_actions = scenario.get("expect_synthesis_actions", [])
    if isinstance(expected_actions, list):
        for action_name in expected_actions:
            if isinstance(action_name, str) and not preflight_has_synthesis_action(
                synthesis,
                action_name,
            ):
                raise ReviewError(
                    f"scenario {scenario_id} expected synthesis action {action_name}"
                )


def simulated_lane_result(
    *,
    brief_path: Path,
    lane_id: str,
    output_dir: Path,
    state: str,
    summary: str,
    findings: list[dict[str, Any]],
    error: str | None = None,
) -> Path:
    output_dir.mkdir(parents=True, exist_ok=True)
    timestamp = now_utc()
    log_path = output_dir / f"review-lane-{lane_id}.log"
    log_path.write_text(
        "scherzo-review preflight simulated lane\n"
        f"lane={lane_id}\n"
        f"state={state}\n"
        f"error={error or ''}\n"
    )
    lane = SPECIALIST_LANES[lane_id]
    lane_result = {
        "$schema": CONTRACT_SCHEMA_REF,
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_lane_result",
        "generated_at_utc": timestamp,
        "producer": {
            "name": "scripts/scherzo-review",
            "version": "1",
            "mode": "preflight-simulation",
        },
        "lane": lane,
        "execution_status": {
            "state": state,
            "started_at_utc": timestamp,
            "completed_at_utc": timestamp,
            "summary": summary,
            "error": error,
        },
        "input_brief_ref": {
            "path": str(brief_path),
            "sha256": sha256_file(brief_path),
        },
        "findings": findings,
        "artifacts": [
            {
                "artifact_type": "log",
                "path": log_path.name,
                "sha256": sha256_file(log_path),
            }
        ],
    }
    validate_review_lane_result(lane_result)
    result_path = output_dir / f"review-lane-{lane_id}.v1.json"
    write_json(result_path, lane_result)
    return result_path


def duplicate_conflict_lane_results(brief_path: Path, scenario_dir: Path) -> list[Path]:
    shared_location = [{"path": "src/scherzo/review_conflict_fixture.gleam", "diff_hunk": "@@ -1,3 +1,4 @@"}]
    correctness = make_finding(
        lane_prefix="correctness",
        index=1,
        category="correctness",
        severity="high",
        evidence_type="static",
        verified=True,
        blocking=False,
        locations=shared_location,
        summary="Parser accepts invalid input without proof of a runtime failure.",
        details="This is intentionally static-only so synthesis must downgrade it rather than treat it as a blocker.",
        suggested_fix="Add an executable reproduction before claiming a blocking correctness bug.",
    )
    test_gap = make_finding(
        lane_prefix="test-quality",
        index=1,
        category="testing",
        severity="medium",
        evidence_type="static",
        verified=True,
        blocking=False,
        locations=shared_location,
        summary="Missing edge-case coverage for parser behavior.",
        details="The changed parser path lacks edge-case assertions.",
        suggested_fix="Add boundary tests for empty and malformed input.",
    )
    duplicate_test_gap = make_finding(
        lane_prefix="idioms",
        index=1,
        category="testing",
        severity="medium",
        evidence_type="static",
        verified=True,
        blocking=False,
        locations=shared_location,
        summary="Missing edge-case coverage for parser behavior.",
        details="A second lane spotted the same test gap with the same remediation.",
        suggested_fix="Add boundary tests for empty and malformed input.",
    )
    conflicting_test_gap = make_finding(
        lane_prefix="idioms",
        index=2,
        category="testing",
        severity="low",
        evidence_type="static",
        verified=True,
        blocking=False,
        locations=shared_location,
        summary="Missing edge-case coverage for parser behavior.",
        details="A second lane spotted the same test gap but suggested a different remediation.",
        suggested_fix="Add table-driven parser fixtures for malformed input.",
    )
    return [
        simulated_lane_result(
            brief_path=brief_path,
            lane_id="correctness",
            output_dir=scenario_dir / "02-lane-correctness",
            state="succeeded",
            summary="Simulated correctness lane for synthesis downgrade coverage.",
            findings=[correctness],
        ),
        simulated_lane_result(
            brief_path=brief_path,
            lane_id="test-quality",
            output_dir=scenario_dir / "02-lane-test-quality",
            state="succeeded",
            summary="Simulated test-quality lane for duplicate coverage.",
            findings=[test_gap],
        ),
        simulated_lane_result(
            brief_path=brief_path,
            lane_id="idioms-maintainability",
            output_dir=scenario_dir / "02-lane-idioms-maintainability",
            state="succeeded",
            summary="Simulated idioms lane for duplicate and conflict coverage.",
            findings=[duplicate_test_gap, conflicting_test_gap],
        ),
        simulated_lane_result(
            brief_path=brief_path,
            lane_id="security-performance",
            output_dir=scenario_dir / "02-lane-security-performance",
            state="succeeded",
            summary="Simulated security/performance lane with no findings.",
            findings=[],
        ),
    ]


def run_standard_preflight_scenario(scenario: dict[str, Any], output_dir: Path) -> dict[str, Any]:
    scenario_id = str(scenario["id"])
    scenario_dir = output_dir / scenario_id
    scenario_dir.mkdir(parents=True, exist_ok=True)
    diff_path = scenario_dir / "input.diff"
    diff_path.write_text(str(scenario.get("diff", "")))

    brief_dir = scenario_dir / "01-brief"
    dry_args = [
        "dry-run",
        "--diff-file",
        str(diff_path),
        "--output-dir",
        str(brief_dir),
        "--source-label",
        scenario_id,
    ]
    for status in scenario.get("test_status", []):
        dry_args.extend(["--test-status", str(status)])
    preflight_run_subcommand(dry_args, scenario_dir / "logs" / "01-dry-run.command.log")

    brief_path = brief_dir / "review-brief.v1.json"
    preflight_validate_artifact(brief_path, scenario_dir / "logs" / "validate-review-brief.log")
    preflight_validate_artifact(
        brief_dir / "review-lane-result.v1.json",
        scenario_dir / "logs" / "validate-brief-lane-result.log",
    )

    mode = scenario.get("mode")
    if mode == "malformed_lane":
        malformed_path = scenario_dir / "02-malformed-lane-result.json"
        malformed_path.write_text("{ this is not valid JSON\n")
        synth_dir = scenario_dir / "03-synthesis"
        preflight_run_subcommand(
            [
                "synthesize",
                "--brief",
                str(brief_path),
                "--lane-result",
                str(malformed_path),
                "--output-dir",
                str(synth_dir),
            ],
            scenario_dir / "logs" / "03-synthesize-expected-failure.command.log",
            expect_success=False,
        )
        return {
            "id": scenario_id,
            "status": "passed",
            "mode": "expected_failure",
            "description": scenario.get("description"),
            "diagnostic_log": str(scenario_dir / "logs" / "03-synthesize-expected-failure.command.log"),
        }

    if mode == "duplicate_conflict":
        lane_paths = duplicate_conflict_lane_results(brief_path, scenario_dir)
        for lane_path in lane_paths:
            preflight_validate_artifact(
                lane_path,
                scenario_dir / "logs" / f"validate-{lane_path.parent.name}.log",
            )
    else:
        lane_paths = []
        for lane_id in PREFLIGHT_LANE_IDS:
            lane_dir = scenario_dir / f"02-lane-{lane_id}"
            if mode == "lane_failure" and lane_id == "correctness":
                lane_path = simulated_lane_result(
                    brief_path=brief_path,
                    lane_id=lane_id,
                    output_dir=lane_dir,
                    state="failed",
                    summary="Simulated lane timeout before producing findings.",
                    findings=[],
                    error="simulated timeout after 1ms",
                )
            else:
                preflight_run_subcommand(
                    [
                        "run-lane",
                        "--lane",
                        lane_id,
                        "--brief",
                        str(brief_path),
                        "--diff-file",
                        str(diff_path),
                        "--output-dir",
                        str(lane_dir),
                        "--source-label",
                        scenario_id,
                    ],
                    scenario_dir / "logs" / f"02-run-lane-{lane_id}.command.log",
                )
                lane_path = lane_dir / f"review-lane-{lane_id}.v1.json"
            preflight_validate_artifact(
                lane_path,
                scenario_dir / "logs" / f"validate-lane-{lane_id}.log",
            )
            lane_paths.append(lane_path)

    synth_dir = scenario_dir / "03-synthesis"
    synth_args = ["synthesize", "--brief", str(brief_path), "--output-dir", str(synth_dir)]
    for lane_path in lane_paths:
        synth_args.extend(["--lane-result", str(lane_path)])
    preflight_run_subcommand(synth_args, scenario_dir / "logs" / "03-synthesize.command.log")

    synthesis_path = synth_dir / "review-synthesis.v1.json"
    final_path = synth_dir / "final-review.v1.json"
    preflight_validate_artifact(synthesis_path, scenario_dir / "logs" / "validate-synthesis.log")
    preflight_validate_artifact(final_path, scenario_dir / "logs" / "validate-final-review.log")

    synthesis = load_json(synthesis_path)
    final_review = load_json(final_path)
    preflight_assert_scenario_expectations(
        scenario=scenario,
        scenario_id=scenario_id,
        synthesis=synthesis,
        final_review=final_review,
    )
    counts = (
        final_review.get("finding_counts", {})
        if isinstance(final_review.get("finding_counts"), dict)
        else {}
    )

    return {
        "id": scenario_id,
        "status": "passed",
        "mode": str(mode or "standard"),
        "description": scenario.get("description"),
        "brief_path": str(brief_path),
        "synthesis_path": str(synthesis_path),
        "final_review_path": str(final_path),
        "finding_count": counts.get("total", 0),
        "blocking_finding_count": counts.get("blocking", 0),
        "lane_failure_count": counts.get("lane_failed", 0),
    }


def preflight_command(args: argparse.Namespace) -> None:
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    selected = set(args.scenario or [])
    scenarios = preflight_scenarios()
    if selected:
        known = {str(scenario["id"]) for scenario in scenarios}
        unknown = selected - known
        if unknown:
            raise ReviewError("unknown preflight scenario(s): " + ", ".join(sorted(unknown)))
        scenarios = [scenario for scenario in scenarios if str(scenario["id"]) in selected]

    started_at = now_utc()
    results: list[dict[str, Any]] = []
    failures: list[str] = []
    for scenario in scenarios:
        scenario_id = str(scenario["id"])
        try:
            results.append(run_standard_preflight_scenario(scenario, output_dir))
        except Exception as exc:
            failure_message = f"{scenario_id}: {exc}"
            failures.append(failure_message)
            failure_dir = output_dir / scenario_id / "logs"
            failure_dir.mkdir(parents=True, exist_ok=True)
            (failure_dir / "preflight-failure.log").write_text(failure_message + "\n")
            results.append({
                "id": scenario_id,
                "status": "failed",
                "description": scenario.get("description"),
                "error": str(exc),
            })

    completed_at = now_utc()
    coverage = [
        "small/trivial PR",
        "medium feature PR",
        "test-heavy PR",
        "PR with no meaningful findings",
        "correctness issue requiring test/repro evidence",
        "security-sensitive filesystem/process/network PR",
        "performance-sensitive PR",
        "lane timeout/failure simulation",
        "malformed lane output simulation",
        "empty findings from all lanes",
        "synthesis with duplicate or conflicting findings",
    ]
    manifest = {
        "schema_version": SCHEMA_VERSION,
        "artifact_type": "review_preflight_manifest",
        "generated_at_utc": completed_at,
        "started_at_utc": started_at,
        "status": "failed" if failures else "passed",
        "remote_mutations": "none",
        "coverage": coverage,
        "scenario_count": len(scenarios),
        "passed_scenario_count": len([result for result in results if result.get("status") == "passed"]),
        "failed_scenario_count": len(failures),
        "scenarios": results,
    }
    manifest_path = output_dir / "preflight-manifest.v1.json"
    write_json(manifest_path, manifest)

    if failures:
        raise ReviewError(
            "review preflight failed; see " + str(manifest_path) + ": " + "; ".join(failures)
        )

    print("REVIEW_PREFLIGHT=ok")
    print(f"REVIEW_SCHEMA_VERSION={SCHEMA_VERSION}")
    print(f"REVIEW_PREFLIGHT_ARTIFACT_DIR={output_dir}")
    print(f"REVIEW_PREFLIGHT_MANIFEST_PATH={manifest_path}")
    print(f"REVIEW_PREFLIGHT_SCENARIOS={len(scenarios)}")
    print("REVIEW_REMOTE_MUTATIONS=none")


def validate_command(args: argparse.Namespace) -> None:
    artifact_path = Path(args.artifact)
    value = load_json(artifact_path)
    validate_artifact(value)
    print("REVIEW_ARTIFACT_VALID=ok")
    print(f"REVIEW_SCHEMA_VERSION={value.get('schema_version')}")
    print(f"REVIEW_ARTIFACT_TYPE={value.get('artifact_type')}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scherzo-review",
        description="Generate and validate no-side-effect Scherzo review artifacts.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    dry_run = subparsers.add_parser(
        "dry-run",
        help="Generate a ReviewBrief from a PR or diff without mutating remote state.",
    )
    source = dry_run.add_mutually_exclusive_group()
    source.add_argument("--diff-file", help="Read a unified git diff from this file.")
    source.add_argument("--pr", help="Read a GitHub PR diff with gh pr diff (read-only).")
    dry_run.add_argument("--repo", help="GitHub owner/repo for --pr.")
    dry_run.add_argument(
        "--from",
        dest="from_rev",
        default="@-",
        help="jj revision for the left side of the local diff (default: @-).",
    )
    dry_run.add_argument(
        "--to",
        dest="to_rev",
        default="@",
        help="jj revision for the right side of the local diff (default: @).",
    )
    dry_run.add_argument(
        "--output-dir",
        default=str(DEFAULT_OUTPUT_DIR),
        help="Directory for local review artifacts (default: tmp/scherzo-review-dry-run).",
    )
    dry_run.add_argument(
        "--source-label",
        help="Human label to record in the ReviewBrief source object.",
    )
    dry_run.add_argument(
        "--test-status",
        action="append",
        default=[],
        help="Record available validation as NAME=STATUS[:SUMMARY]. STATUS is passed, failed, skipped, not_run, or unknown.",
    )
    dry_run.set_defaults(func=dry_run_command)

    run_lane = subparsers.add_parser(
        "run-lane",
        help="Run one specialist review lane against a ReviewBrief and diff source.",
    )
    run_lane.add_argument(
        "--lane",
        required=True,
        choices=sorted(SPECIALIST_LANES.keys()),
        help="Specialist lane id to run independently.",
    )
    run_lane.add_argument(
        "--brief",
        required=True,
        help="ReviewBrief artifact path consumed by the lane.",
    )
    lane_source = run_lane.add_mutually_exclusive_group()
    lane_source.add_argument("--diff-file", help="Read a unified git diff from this file.")
    lane_source.add_argument("--pr", help="Read a GitHub PR diff with gh pr diff (read-only).")
    run_lane.add_argument("--repo", help="GitHub owner/repo for --pr.")
    run_lane.add_argument(
        "--from",
        dest="from_rev",
        default="@-",
        help="jj revision for the left side of the local diff (default: @-).",
    )
    run_lane.add_argument(
        "--to",
        dest="to_rev",
        default="@",
        help="jj revision for the right side of the local diff (default: @).",
    )
    run_lane.add_argument(
        "--output-dir",
        default=str(DEFAULT_LANE_OUTPUT_DIR),
        help="Directory for local lane artifacts (default: tmp/scherzo-review-lanes).",
    )
    run_lane.add_argument(
        "--source-label",
        help="Human label to record in the lane result source object.",
    )
    run_lane.set_defaults(func=run_lane_command)

    synthesize = subparsers.add_parser(
        "synthesize",
        help="Synthesize specialist lane results and write the final review artifact.",
    )
    synthesize.add_argument(
        "--brief",
        required=True,
        help="ReviewBrief artifact path consumed by synthesis.",
    )
    synthesize.add_argument(
        "--lane-result",
        action="append",
        default=[],
        help="ReviewLaneResult artifact path. Repeat for each specialist lane.",
    )
    synthesize.add_argument(
        "--output-dir",
        default=str(DEFAULT_SYNTHESIS_OUTPUT_DIR),
        help="Directory for synthesis artifacts (default: tmp/scherzo-review-synthesis).",
    )
    synthesize.set_defaults(func=synthesize_command)

    preflight = subparsers.add_parser(
        "preflight",
        help="Run the full staged review workflow in local dry-run mode against representative fixtures.",
    )
    preflight.add_argument(
        "--output-dir",
        default=str(DEFAULT_PREFLIGHT_OUTPUT_DIR),
        help="Directory for preflight logs and artifacts (default: tmp/scherzo-review-preflight).",
    )
    preflight.add_argument(
        "--scenario",
        action="append",
        default=[],
        help="Run only the named preflight scenario. Repeat to select multiple scenarios.",
    )
    preflight.set_defaults(func=preflight_command)

    validate = subparsers.add_parser("validate", help="Validate a review artifact JSON object.")
    validate.add_argument("--artifact", required=True, help="Artifact path to validate.")
    validate.set_defaults(func=validate_command)
    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command in {"dry-run", "run-lane"} and args.repo and not args.pr:
        usage_error("--repo can only be used with --pr")
    try:
        args.func(args)
    except ReviewError as exc:
        if args.command == "run-lane":
            try:
                write_failed_lane_artifacts(args, str(exc))
            except Exception:
                pass
        fail(str(exc))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
