#!/usr/bin/env python3
"""Shared helpers for Scherzo implementation workflows.

The checked-in dogfood workflows have two implementation contracts:

* workflow:implementation implements directly from task context fetched from Linear.
* workflow:execplan-implementation implements a retained ExecPlan bundle
  prepared by scripts/scherzo-execplan.

This helper keeps the common mechanics in one place: fetching source context,
recording the starting jj parent, retaining failed run workspaces until a PR is
published, detecting changed file languages across the full workflow history,
running final validation, and materializing declarative commit_stack publication artifacts.
"""

from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any

from scherzo_workflow import commit_stack as commit_stack_helper

TMP_DIR = Path("tmp")
METADATA_PATH = TMP_DIR / "scherzo-implementation.json"
CANONICAL_METADATA_RELATIVE_PATH = Path("state") / "implementation" / "metadata.json"
CANONICAL_IMPLEMENTATION_STATE_RELATIVE_DIR = Path("state") / "implementation"
CANONICAL_EXECPLAN_REVIEW_DOC_NAME = "execplan-review-doc.md"
CANONICAL_EXECPLAN_PACK_NAME = "execplan-implementation-pack.json"
CANONICAL_EXECPLAN_BUNDLE_NAME = "execplan-bundle.json"
CANONICAL_PLAN_COMPLETION_VERDICT_NAME = "scherzo-plan-completion-verdict.json"
ANALYSIS_PATH = TMP_DIR / "scherzo-implementation-analysis.json"
PLAN_COMPLETION_CONTEXT_PATH = TMP_DIR / "scherzo-plan-completion-context.json"
PLAN_COMPLETION_VERDICT_PATH = TMP_DIR / "scherzo-plan-completion-verdict.json"
PLAN_COMPLETION_RECOVERY_PATH = TMP_DIR / "scherzo-plan-completion-recovery.json"
PLAN_COMPLETION_RECOVERY_SUMMARY_PATH = TMP_DIR / "scherzo-plan-completion-recovery.md"
VALIDATION_PATH = TMP_DIR / "scherzo-implementation-validation.json"
PUBLISH_PATH = TMP_DIR / "scherzo-implementation-publish.json"
COMMIT_STACK_PATH = TMP_DIR / "scherzo-implementation-commit-stack.json"
COMMIT_STACK_CARRIER_NAME = "commit_stack.bundle"
TICKET_BRIEF_PATH = TMP_DIR / "scherzo-implementation-brief.md"
PLAN_BRIEF_PATH = TMP_DIR / "scherzo-execplan-brief.md"
PLAN_INDEX_PATH = TMP_DIR / "scherzo-execplan-index.json"
PREPARED_EXECPLAN_PATH = TMP_DIR / "execplan-review-doc.md"
PR_BODY_PATH = TMP_DIR / "scherzo-implementation-pr-body.md"
BASE_REFRESH_LATEST_PATH = TMP_DIR / "scherzo-implementation-refresh-base-latest.json"
BASE_DRIFT_REPAIR_SUMMARY_PATH = TMP_DIR / "scherzo-implementation-base-drift-repair.md"
BASE_DRIFT_REPAIR_FAILURE_PATH = TMP_DIR / "scherzo-implementation-base-drift-failure.md"
RETENTION_MARKER = ".scherzo-keep-workspace"
REFRESH_STAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
JJ_CONFLICT_STATUS_RE = re.compile(r"\s+\d+-sided conflict(?:\s+.*)?$")
COMMAND_DIAGNOSTIC_MAX_CHARS = 3500
VALIDATION_RESULT_EXCERPT_MAX_CHARS = 4000
VALIDATION_FAILURE_SUMMARY_MAX_CHARS = 2500
ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def usage() -> None:
    print(
        """Usage: scherzo-implementation <prepare|refresh-base|analyze|restore-execplan-artifacts|plan-completion-context|checkpoint-plan-completion-verdict|gate-plan-completion|plan-completion-recovery|assert-base-drift-repair|validate|publish|plan-brief|languages|ticket-brief>

Run from a Scherzo jj workflow workspace root.

prepare --source ticket
              Fetch the Linear-backed source task, write a task-context brief
              under tmp/, record the starting jj parent, and mark the run for
              retention until a PR is safely published.
analyze       Diff from the recorded starting parent to @, detect review-
              relevant languages/files, and print review metadata.
restore-execplan-artifacts
              Restore the tmp/ ExecPlan compatibility files from run-root
              canonical state after tests or helper fixtures clobber tmp/.
plan-completion-context
              Write and print the current ExecPlan implementation patch
              fingerprint that a plan-completion verifier must copy into its
              verdict artifact.
checkpoint-plan-completion-verdict
              Validate and copy tmp/scherzo-plan-completion-verdict.json into
              run-root canonical state so validation tests cannot clobber it
              before the final gate.
plan-brief [--check|--refresh-if-stale]
              Regenerate, check, or refresh the derived ExecPlan brief and JSON
              index recorded in tmp/scherzo-implementation.json.
gate-plan-completion [--final]
              Fail closed unless tmp/scherzo-plan-completion-verdict.json is
              a fresh, well-formed passing verdict for the current ExecPlan
              implementation patch.
plan-completion-recovery --phase before-late-repair|before-final-repair|after-late-repair|after-final-repair|final --attempt INT --max-attempts INT
              Classify the current plan-completion verdict for bounded recovery,
              write tmp/scherzo-plan-completion-recovery.{json,md}, and either
              authorize one bounded repair pass or fail with retained
              workspace diagnostics.
refresh-base --stage <stage>
              Fetch the canonical jj workspace base, rebase @ when needed,
              and write structured base-refresh JSON under tmp/.
assert-base-drift-repair
              Fail closed when the bounded base-drift repair worker wrote a
              nonrepairable failure marker; otherwise report that final
              validation may proceed.
validate      Run the final direnv-backed scripts/scherzo-ci gate.
publish       Normalize and validate the final change, then materialize the
              commit_stack and PR metadata consumed by Scherzo core's
              declarative same-repo publication route.

Test helpers:
languages <file-list>
              Detect review-relevant languages from a newline-separated list.
ticket-brief <issue-json>
              Render a task-context Markdown brief from a saved Linear issue
              JSON object and print it to stdout. This helper is Linear-only.
""",
        file=sys.stderr,
    )


def fail(message: str, *, failure_code: str | None = None) -> None:
    if failure_code:
        print(f"SCHERZO_FAILURE_CODE={failure_code}", file=sys.stderr)
    print(f"scherzo-implementation: {message}", file=sys.stderr)
    sys.exit(1)


def diagnostic_excerpt(value: str, max_chars: int = COMMAND_DIAGNOSTIC_MAX_CHARS) -> str:
    value = value.strip()
    if len(value) <= max_chars:
        return value
    marker = "\n... truncated ...\n"
    available = max(0, max_chars - len(marker))
    omitted = len(value) - available
    marker = f"\n... truncated {omitted} chars ...\n"
    available = max(0, max_chars - len(marker))
    head_chars = available // 2
    tail_chars = available - head_chars
    return value[:head_chars] + marker + value[-tail_chars:]


def subprocess_failure_details(stdout: str, stderr: str, returncode: int) -> str:
    parts = [f"exit_code: {returncode}"]
    if stderr.strip():
        parts.append("stderr:\n" + diagnostic_excerpt(stderr))
    if stdout.strip():
        parts.append("stdout:\n" + diagnostic_excerpt(stdout))
    return "\n\n".join(parts)


def run_proc(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )


def run_proc_with_heartbeat(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
    heartbeat_seconds: int = 60,
) -> subprocess.CompletedProcess[str]:
    proc = subprocess.Popen(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    started = time.monotonic()
    command = " ".join(shell_display(arg) for arg in args)
    while True:
        try:
            stdout, stderr = proc.communicate(timeout=heartbeat_seconds)
            return subprocess.CompletedProcess(
                args,
                proc.returncode,
                stdout or "",
                stderr or "",
            )
        except subprocess.TimeoutExpired:
            elapsed = int(time.monotonic() - started)
            print(
                f"[scherzo-implementation] still running after {elapsed}s: {command}",
                flush=True,
            )


def run(
    args: list[str],
    *,
    check: bool = True,
    failure_code: str | None = None,
    env: dict[str, str] | None = None,
) -> str:
    proc = run_proc(args, env=env)
    if check and proc.returncode != 0:
        details = subprocess_failure_details(proc.stdout, proc.stderr, proc.returncode)
        fail(f"command failed: {' '.join(args)}\n{details}", failure_code=failure_code)
    return proc.stdout


def print_process_output(proc: subprocess.CompletedProcess[str]) -> None:
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)


def workspace_driver_command() -> str | None:
    driver = os.environ.get("SCHERZO_WORKSPACE_DRIVER", "").strip()
    return driver or None


def workspace_driver_available() -> bool:
    return workspace_driver_command() is not None


def pr_draft_setting() -> bool | None:
    value = os.environ.get("SCHERZO_PR_DRAFT")
    if value is None:
        return None
    value = value.strip()
    if not value:
        return None
    if value == "true":
        return True
    if value == "false":
        return False
    fail(
        "SCHERZO_PR_DRAFT must be true or false",
        failure_code="invalid_configuration",
    )


def workspace_driver_missing(*, failure_code: str = "workspace_driver_unavailable") -> None:
    fail(
        "SCHERZO_WORKSPACE_DRIVER is required for this driver-backed workflow operation",
        failure_code=failure_code,
    )


def run_workspace_driver_json(
    args: list[str],
    *,
    check: bool = True,
    failure_code: str = "workspace_driver_failed",
) -> tuple[dict[str, Any], subprocess.CompletedProcess[str]]:
    driver = workspace_driver_command()
    if driver is None:
        workspace_driver_missing(failure_code="workspace_driver_unavailable")
    proc = run_proc([driver, *args])
    try:
        payload = json.loads(proc.stdout) if proc.stdout.strip() else None
    except json.JSONDecodeError as exc:
        fail(
            "workspace driver returned malformed JSON for `"
            + " ".join(args)
            + f"`: {exc}",
            failure_code=failure_code,
        )
    if not isinstance(payload, dict):
        details = subprocess_failure_details(proc.stdout, proc.stderr, proc.returncode)
        fail(
            "workspace driver did not return a JSON object for `"
            + " ".join(args)
            + "`\n"
            + details,
            failure_code=failure_code,
        )
    if payload.get("version") != 1:
        fail(
            "workspace driver JSON for `"
            + " ".join(args)
            + "` must set version=1",
            failure_code=failure_code,
        )
    if check and proc.returncode != 0:
        message = str(payload.get("message") or "workspace driver command failed")
        fail(
            "workspace driver command failed: `"
            + " ".join(args)
            + "`\n"
            + message,
            failure_code=str(payload.get("failure_code") or failure_code),
        )
    return payload, proc


def workspace_driver_changed_file_records() -> list[dict[str, str]]:
    payload, _ = run_workspace_driver_json(
        ["changed-files", "--json"],
        failure_code="workspace_driver_changed_files_failed",
    )
    raw_files = payload.get("files")
    records: list[dict[str, str]] = []
    if isinstance(raw_files, list):
        for item in raw_files:
            if not isinstance(item, dict):
                fail(
                    "workspace driver changed-files JSON field 'files' must contain objects",
                    failure_code="workspace_driver_changed_files_failed",
                )
            path = item.get("path")
            status = item.get("status")
            if not isinstance(path, str) or not path.strip():
                fail(
                    "workspace driver changed-files record is missing a non-empty path",
                    failure_code="workspace_driver_changed_files_failed",
                )
            if status not in {"added", "modified", "deleted", "renamed", "conflicted"}:
                fail(
                    f"workspace driver changed-files record for {path!r} has invalid status {status!r}",
                    failure_code="workspace_driver_changed_files_failed",
                )
            record = {"path": path.strip(), "status": str(status)}
            old_path = item.get("old_path")
            if isinstance(old_path, str) and old_path.strip():
                record["old_path"] = old_path.strip()
            records.append(record)
    else:
        fail(
            "workspace driver changed-files JSON must contain a files list",
            failure_code="workspace_driver_changed_files_failed",
        )
    return sorted(records, key=lambda record: record["path"])


def workspace_driver_changed_files() -> list[str]:
    return [record["path"] for record in workspace_driver_changed_file_records()]


def workspace_driver_diff_text() -> str:
    payload, _ = run_workspace_driver_json(
        ["diff", "--json"],
        failure_code="workspace_driver_diff_failed",
    )
    text = payload.get("text")
    truncated = payload.get("truncated")
    if not isinstance(text, str) or not isinstance(truncated, bool):
        fail(
            "workspace driver diff JSON must include text and truncated fields",
            failure_code="workspace_driver_diff_failed",
        )
    return text


def workspace_driver_baseline() -> dict[str, Any]:
    payload, _ = run_workspace_driver_json(
        ["baseline", "--json"],
        failure_code="workspace_driver_baseline_failed",
    )
    for key in ["baseline_id", "workspace_revision_id", "change_id"]:
        if not isinstance(payload.get(key), str) or not str(payload.get(key)).strip():
            fail(
                f"workspace driver baseline JSON missing non-empty {key}",
                failure_code="workspace_driver_baseline_failed",
            )
    if not isinstance(payload.get("dirty"), bool):
        fail(
            "workspace driver baseline JSON missing boolean dirty",
            failure_code="workspace_driver_baseline_failed",
        )
    return payload


def run_and_print(
    args: list[str],
    *,
    failure_code: str | None = None,
    env: dict[str, str] | None = None,
) -> None:
    print("$ " + " ".join(shell_display(arg) for arg in args), flush=True)
    proc = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    print_process_output(proc)
    if proc.returncode != 0:
        fail(
            f"command failed with exit code {proc.returncode}: {' '.join(args)}",
            failure_code=failure_code,
        )


def strip_ansi(value: str) -> str:
    return ANSI_ESCAPE_RE.sub("", value)


def is_progress_noise_line(line: str) -> bool:
    stripped = line.strip()
    if len(stripped) < 120:
        return False
    dot_count = stripped.count(".")
    return dot_count * 2 > len(stripped)


def validation_failure_summary(stdout: str, stderr: str) -> str:
    combined = "\n".join(part for part in [stdout, stderr] if part)
    lines = [strip_ansi(line).rstrip() for line in combined.splitlines()]
    interesting: set[int] = set()
    for index, line in enumerate(lines):
        lower = line.lower()
        stripped_lower = lower.lstrip()
        stripped = line.lstrip()
        is_interesting = (
            "❌ failed" in line
            or "hash mismatch" in lower
            or "fixed-output derivation" in lower
            or stripped_lower.startswith("error:")
            or stripped_lower.startswith("error ")
            or stripped.startswith("Error:")
            or "check command failed" in lower
            or "failed with error" in lower
            or stripped_lower.startswith("specified:")
            or stripped_lower.startswith("got:")
        )
        if is_interesting:
            for nearby in range(max(0, index - 1), min(len(lines), index + 4)):
                interesting.add(nearby)

    summary_lines: list[str] = []
    for index in sorted(interesting):
        line = lines[index].strip()
        if (
            line
            and not is_progress_noise_line(line)
            and (not summary_lines or summary_lines[-1] != line)
        ):
            summary_lines.append(line)
        if len(summary_lines) >= 24:
            break

    if not summary_lines:
        summary_lines = [line.strip() for line in lines if line.strip()][-24:]

    return diagnostic_excerpt(
        "\n".join(summary_lines), VALIDATION_FAILURE_SUMMARY_MAX_CHARS
    )


def shell_display(value: str) -> str:
    if re.match(r"^[A-Za-z0-9_./:=+@-]+$", value):
        return value
    return "'" + value.replace("'", "'\\''") + "'"


def command_exists(name: str) -> bool:
    proc = subprocess.run(
        ["sh", "-c", f"command -v {name} >/dev/null 2>&1"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return proc.returncode == 0


def require_command(name: str) -> None:
    if not command_exists(name):
        fail(f"required command not found: {name}")


def load_json(path: Path) -> dict[str, Any]:
    if not path.exists():
        fail(f"missing {path}; run prepare first")
    return json.loads(path.read_text())


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def canonical_metadata_path() -> Path | None:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return None
    return Path(run_root) / CANONICAL_METADATA_RELATIVE_PATH


def canonical_implementation_state_path(name: str) -> Path | None:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return None
    return Path(run_root) / CANONICAL_IMPLEMENTATION_STATE_RELATIVE_DIR / name


def metadata_path_field(metadata: dict[str, Any], key: str) -> Path | None:
    value = str(metadata.get(key) or "").strip()
    if not value:
        return None
    return Path(value)


def metadata_missing_message(canonical_path: Path) -> str:
    return (
        "unrecoverable workflow-state loss: missing implementation metadata in "
        f"canonical run state ({canonical_path}) and compatibility cache "
        f"({METADATA_PATH}). Restore "
        f"{CANONICAL_METADATA_RELATIVE_PATH} from retained run artifacts or "
        "abort and restart from a clean baseline; do not rerun prepare after "
        "implementation because that would overwrite the original workflow "
        "source and base metadata."
    )


def print_metadata_backfill_diagnostic(canonical_path: Path) -> None:
    print(
        "scherzo-implementation: backfilled canonical implementation metadata "
        f"from {METADATA_PATH} to {canonical_path} "
        f"({CANONICAL_METADATA_RELATIVE_PATH})",
        file=sys.stderr,
    )


def load_implementation_metadata() -> dict[str, Any]:
    canonical_path = canonical_metadata_path()
    if canonical_path is None:
        return load_json(METADATA_PATH)

    if canonical_path.exists():
        try:
            metadata = load_json(canonical_path)
        except json.JSONDecodeError as exc:
            fail(f"invalid canonical implementation metadata at {canonical_path}: {exc}")
        write_json(METADATA_PATH, metadata)
        return metadata

    if METADATA_PATH.exists():
        metadata = load_json(METADATA_PATH)
        write_json(canonical_path, metadata)
        print_metadata_backfill_diagnostic(canonical_path)
        return metadata

    fail(metadata_missing_message(canonical_path))


def write_implementation_metadata(metadata: dict[str, Any]) -> None:
    canonical_path = canonical_metadata_path()
    if canonical_path is not None:
        write_json(canonical_path, metadata)
    write_json(METADATA_PATH, metadata)


def canonical_execplan_artifact_path(
    metadata: dict[str, Any],
    *,
    metadata_key: str,
    state_name: str,
) -> Path | None:
    explicit = metadata_path_field(metadata, metadata_key)
    if explicit is not None:
        return explicit
    return canonical_implementation_state_path(state_name)


def copy_execplan_artifact(source: Path, destination: Path, *, label: str) -> None:
    if not source.exists():
        fail(
            f"missing canonical ExecPlan {label} artifact at {source}; "
            "run implementation-prepare again or recover the retained run state",
            failure_code="execplan_artifacts_missing",
        )
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.resolve() != destination.resolve():
        destination.write_bytes(source.read_bytes())


def validate_restored_plan(metadata: dict[str, Any], plan_path: Path) -> None:
    expected_sha = str(metadata.get("plan_sha256") or "").strip()
    expected_bytes_raw = metadata.get("plan_bytes")
    data = plan_path.read_bytes()
    if expected_sha:
        actual_sha = hashlib.sha256(data).hexdigest()
        if actual_sha != expected_sha:
            fail(
                f"restored ExecPlan review doc hash mismatch for {plan_path}: "
                f"expected {expected_sha}, got {actual_sha}",
                failure_code="execplan_artifacts_mismatch",
            )
    if isinstance(expected_bytes_raw, int) and len(data) != expected_bytes_raw:
        fail(
            f"restored ExecPlan review doc byte length mismatch for {plan_path}: "
            f"expected {expected_bytes_raw}, got {len(data)}",
            failure_code="execplan_artifacts_mismatch",
        )


def restore_execplan_artifacts() -> str:
    canonical_metadata = canonical_metadata_path()
    if canonical_metadata is None:
        if not METADATA_PATH.exists():
            return "skipped_no_metadata"
    elif not canonical_metadata.exists() and not METADATA_PATH.exists():
        return "skipped_no_metadata"
    metadata = load_implementation_metadata()
    if metadata.get("source_kind") != "execplan":
        return "skipped_non_execplan"

    plan_source = canonical_execplan_artifact_path(
        metadata,
        metadata_key="canonical_plan_path",
        state_name=CANONICAL_EXECPLAN_REVIEW_DOC_NAME,
    )
    pack_source = canonical_execplan_artifact_path(
        metadata,
        metadata_key="canonical_execplan_v2_implementation_pack_path",
        state_name=CANONICAL_EXECPLAN_PACK_NAME,
    )
    bundle_source = canonical_execplan_artifact_path(
        metadata,
        metadata_key="canonical_execplan_v2_bundle_path",
        state_name=CANONICAL_EXECPLAN_BUNDLE_NAME,
    )
    if plan_source is None or pack_source is None or bundle_source is None:
        return "skipped_no_run_root"

    explicit_canonical_paths = [
        metadata_path_field(metadata, "canonical_plan_path"),
        metadata_path_field(metadata, "canonical_execplan_v2_implementation_pack_path"),
        metadata_path_field(metadata, "canonical_execplan_v2_bundle_path"),
    ]
    missing_sources = [
        source
        for source in [plan_source, pack_source, bundle_source]
        if not source.exists()
    ]
    if missing_sources:
        if any(path is not None for path in explicit_canonical_paths):
            fail(
                "missing canonical ExecPlan artifact(s): "
                + ", ".join(str(source) for source in missing_sources)
                + "; run implementation-prepare again or recover the retained run state",
                failure_code="execplan_artifacts_missing",
            )
        return "skipped_no_canonical_state"

    copy_execplan_artifact(
        plan_source,
        PREPARED_EXECPLAN_PATH,
        label="review doc",
    )
    copy_execplan_artifact(
        pack_source,
        Path(
            str(
                metadata.get("execplan_v2_implementation_pack_path")
                or "tmp/execplan-implementation-pack.json"
            )
        ),
        label="implementation pack",
    )
    copy_execplan_artifact(
        bundle_source,
        Path(
            str(metadata.get("execplan_v2_bundle_path") or "tmp/execplan-bundle.json")
        ),
        label="bundle",
    )
    validate_restored_plan(metadata, PREPARED_EXECPLAN_PATH)
    write_implementation_metadata(metadata)
    return "restored"


def restore_execplan_artifacts_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    status = restore_execplan_artifacts()
    print(f"EXECPLAN_ARTIFACT_RESTORE_STATUS={status}")
    print(f"PLAN={PREPARED_EXECPLAN_PATH}")
    print("IMPLEMENTATION_PACK=tmp/execplan-implementation-pack.json")
    print("BUNDLE=tmp/execplan-bundle.json")


def infer_issue_identifier() -> str:
    explicit = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if explicit:
        return explicit

    cwd = str(Path.cwd())
    marker = "/.scherzo/workspaces/"
    if marker in cwd:
        tail = cwd.split(marker, 1)[1]
        parts = tail.split("/")
        # .scherzo/workspaces/<workflow>/<issue>/<run>/<workspace>
        if len(parts) >= 2 and parts[1]:
            return parts[1]

    fail(
        "could not infer Linear issue identifier from cwd; set "
        "SCHERZO_ISSUE_IDENTIFIER"
    )


def linear_graphql(query: str, variables: dict[str, Any]) -> dict[str, Any]:
    fixture_path = os.environ.get("SCHERZO_TEST_LINEAR_GRAPHQL_JSON", "").strip()
    if fixture_path:
        try:
            response = json.loads(Path(fixture_path).read_text())
        except (OSError, json.JSONDecodeError) as exc:
            fail(f"could not read SCHERZO_TEST_LINEAR_GRAPHQL_JSON fixture: {exc}")
        if response.get("errors"):
            fail(
                "Linear GraphQL fixture returned errors:\n"
                + diagnostic_excerpt(json.dumps(response["errors"], indent=2))
            )
        data = response.get("data")
        if not isinstance(data, dict):
            fail("SCHERZO_TEST_LINEAR_GRAPHQL_JSON fixture must contain a data object")
        return data

    token = os.environ.get("LINEAR_API_KEY", "").strip()
    if not token:
        fail("LINEAR_API_KEY is required to fetch Linear issue context")
    payload = json.dumps({"query": query, "variables": variables}).encode()
    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": token},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            response = json.loads(resp.read())
    except Exception as exc:  # pragma: no cover - defensive CLI boundary
        fail(f"Linear GraphQL request failed: {exc}")
    if response.get("errors"):
        fail(
            "Linear GraphQL returned errors:\n"
            + diagnostic_excerpt(json.dumps(response["errors"], indent=2))
        )
    return response["data"]


def fetch_linear_issue_context(identifier: str) -> dict[str, Any]:
    query = """
    query($id: String!) {
      issue(id: $id) {
        identifier
        title
        description
        url
        priority
        state { name }
        labels(first: 50) {
          nodes { name }
          pageInfo { hasNextPage }
        }
        comments(first: 100) {
          nodes {
            createdAt
            body
            user { name }
          }
          pageInfo { hasNextPage }
        }
      }
    }
    """
    issue = linear_graphql(query, {"id": identifier}).get("issue")
    if not issue:
        fail(f"Linear issue not found: {identifier}")
    return issue


def validate_prepared_execplan_path(plan_path: str, repo_root: Path) -> None:
    path = Path(plan_path)
    if path.is_absolute() or ".." in path.parts:
        fail(
            f"invalid prepared ExecPlan path: {plan_path}; "
            "expected a repository-relative Markdown path",
            failure_code="execplan_metadata_invalid",
        )
    if path.suffix.lower() != ".md":
        fail(
            f"invalid prepared ExecPlan path: {plan_path}; expected a Markdown path",
            failure_code="execplan_metadata_invalid",
        )
    if not (repo_root / path).is_file():
        fail(
            f"ExecPlan file does not exist: {plan_path}",
            failure_code="execplan_metadata_invalid",
        )


def plan_source_sha256(plan_path: str) -> str:
    try:
        return hashlib.sha256(Path(plan_path).read_bytes()).hexdigest()
    except OSError as exc:
        fail(f"could not read ExecPlan file {plan_path}: {exc}")


def execplan_html_helper_path() -> Path:
    override = os.environ.get("SCHERZO_EXECPLAN_HTML_HELPER", "").strip()
    if override:
        return Path(override)
    return Path(__file__).resolve().parent / "scherzo-execplan-html"


def remove_plan_brief_artifacts() -> None:
    for path in [PLAN_BRIEF_PATH, PLAN_INDEX_PATH]:
        try:
            if path.exists():
                path.unlink()
        except OSError:
            pass


def plan_brief_warning(value: str) -> str:
    return re.sub(r"\s+", " ", diagnostic_excerpt(value, 900)).strip()


def generate_plan_brief(plan_path: str) -> dict[str, str]:
    helper = execplan_html_helper_path()
    proc = run_proc([
        sys.executable or "python3",
        str(helper),
        "brief",
        plan_path,
        str(PLAN_BRIEF_PATH),
        str(PLAN_INDEX_PATH),
    ])
    if proc.returncode != 0:
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: "
            + plan_brief_warning(subprocess_failure_details(proc.stdout, proc.stderr, proc.returncode)),
        }
    try:
        index = json.loads(PLAN_INDEX_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: " + plan_brief_warning(str(exc)),
        }
    source_hash = str(index.get("source_sha256") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{64}", source_hash):
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: JSON index missing lowercase source_sha256",
        }
    return {
        "status": "ok",
        "brief_path": str(PLAN_BRIEF_PATH),
        "index_path": str(PLAN_INDEX_PATH),
        "source_sha256": source_hash,
    }


def apply_plan_brief_result(metadata: dict[str, Any], result: dict[str, str]) -> None:
    for key in [
        "plan_brief_path",
        "plan_index_path",
        "plan_source_sha256",
        "plan_brief_warning",
    ]:
        metadata.pop(key, None)
    if result["status"] == "ok":
        metadata["plan_brief_status"] = "ok"
        metadata["plan_brief_path"] = result["brief_path"]
        metadata["plan_index_path"] = result["index_path"]
        metadata["plan_source_sha256"] = result["source_sha256"]
    else:
        metadata["plan_brief_status"] = "unavailable"
        metadata["plan_brief_warning"] = result.get("warning", "brief generation failed")


def print_plan_brief_result(result: dict[str, str]) -> None:
    if result["status"] == "ok":
        print("PLAN_BRIEF_STATUS=ok")
        print(f"PLAN_BRIEF_PATH={result['brief_path']}")
        print(f"PLAN_INDEX_PATH={result['index_path']}")
        print(f"PLAN_SOURCE_SHA256={result['source_sha256']}")
    else:
        print("PLAN_BRIEF_STATUS=unavailable")
        print(f"PLAN_BRIEF_WARNING={result.get('warning', 'brief generation failed')}")


def current_base_change_id() -> str:
    return run(["jj", "log", "-r", "@-", "--no-graph", "-T", "change_id", "--color=never"]).strip()


def current_change_id_short() -> str:
    return run(["jj", "log", "-r", "@", "--no-graph", "-T", "change_id.short()", "--color=never"]).strip()


def changed_files_since(base_change_id: str) -> list[str]:
    output = run([
        "jj",
        "diff",
        "--from",
        base_change_id,
        "--to",
        "@",
        "--name-only",
        "--color=never",
    ])
    return clean_lines(output)


def revision_commit_ids(revision: str) -> list[str]:
    output = run([
        "jj",
        "log",
        "-r",
        revision,
        "--no-graph",
        "-T",
        "commit_id ++ \"\\n\"",
        "--color=never",
    ])
    return clean_lines(output)


def revision_commit_ids_if_exists(revision: str) -> list[str] | None:
    proc = run_proc([
        "jj",
        "log",
        "-r",
        revision,
        "--no-graph",
        "-T",
        "commit_id ++ \"\\n\"",
        "--color=never",
    ])
    if proc.returncode == 0 and proc.stdout.strip():
        return clean_lines(proc.stdout)
    return None


def current_parent_commit_ids() -> list[str]:
    return revision_commit_ids("@-")


def has_unresolved_conflicts(revision: str) -> bool:
    proc = subprocess.run(
        [
            "jj",
            "log",
            "-r",
            f"conflicts() & ({revision})",
            "--no-graph",
            "-T",
            "change_id.short()",
            "--color=never",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return proc.returncode == 0 and bool(proc.stdout.strip())


def command_display(args: list[str]) -> str:
    return " ".join(args)


def configured_publish_base() -> tuple[str, str]:
    base = os.environ.get("SCHERZO_JJ_WORKSPACE_BASE_BRANCH", "main").strip() or "main"
    remote = os.environ.get("SCHERZO_JJ_WORKSPACE_REMOTE", "origin").strip() or "origin"
    return base, remote


def configured_publication_remote() -> str:
    return os.environ.get("SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE", "origin").strip() or "origin"


def parse_refresh_base_args(args: list[str]) -> str:
    if len(args) != 2 or args[0] != "--stage":
        fail("refresh-base requires exactly: --stage <stage>")
    stage = args[1].strip()
    if stage in {"", ".", ".."} or "/" in stage or "\\" in stage:
        fail(f"invalid refresh-base stage {args[1]!r}; stage must be a safe filename segment")
    if not REFRESH_STAGE_RE.fullmatch(stage):
        fail(
            f"invalid refresh-base stage {args[1]!r}; expected "
            "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        )
    return stage


def refresh_base_json_path(stage: str) -> Path:
    # Re-parse the constructed stage to keep this helper safe when called directly.
    safe_stage = parse_refresh_base_args(["--stage", stage])
    return TMP_DIR / f"scherzo-implementation-refresh-base-{safe_stage}.json"


def fetch_base_result(base: str, remote: str) -> tuple[list[str], subprocess.CompletedProcess[str]]:
    args = ["jj", "git", "fetch", "--remote", remote, "--branch", base]
    return args, run_proc(args)


def resolve_base_revision(base: str, remote: str) -> tuple[str | None, list[str] | None, bool]:
    remote_base = f"{base}@{remote}"
    remote_commits = revision_commit_ids_if_exists(remote_base)
    if remote_commits is not None:
        return remote_base, remote_commits, False
    local_commits = revision_commit_ids_if_exists(base)
    if local_commits is not None:
        print(
            f"warning: remote workspace base {remote_base!r} was not found after fetch; "
            f"falling back to local revision {base!r}",
            file=sys.stderr,
        )
        return base, local_commits, True
    return None, None, False


def normalize_conflict_file_path(value: str) -> str:
    return JJ_CONFLICT_STATUS_RE.sub("", value.strip())


def conflicted_files() -> list[str]:
    proc = run_proc(["jj", "resolve", "--list", "--color=never"])
    if proc.returncode == 0:
        files: list[str] = []
        seen: set[str] = set()
        for line in proc.stdout.splitlines():
            path = normalize_conflict_file_path(line)
            if path and path not in seen:
                files.append(path)
                seen.add(path)
        return sorted(files)
    if "No conflicts found" in proc.stdout or "No conflicts found" in proc.stderr:
        return []
    return []


def has_unresolved_conflicts_at_current_change() -> bool:
    return has_unresolved_conflicts("@")


def refresh_result(
    *,
    stage: str,
    status: str,
    repairable: bool,
    remote: str,
    base: str,
    base_revision: str,
    base_commit_before_fetch: str | None,
    base_commit_after_fetch: str | None,
    parent_commits_before: list[str],
    parent_commits_after: list[str],
    current_change_id: str,
    rebased: bool,
    has_unresolved_conflicts: bool,
    conflicted: list[str],
    message: str,
    commands: list[str],
    fetch_stdout: str = "",
    fetch_stderr: str = "",
    rebase_stdout: str = "",
    rebase_stderr: str = "",
    rebase_exit_code: int | None = None,
) -> dict[str, Any]:
    result: dict[str, Any] = {
        "schema_version": 1,
        "stage": stage,
        "status": status,
        "repairable": repairable,
        "remote": remote,
        "base": base,
        "base_revision": base_revision,
        "base_commit_before_fetch": base_commit_before_fetch,
        "base_commit_after_fetch": base_commit_after_fetch,
        "parent_commits_before": parent_commits_before,
        "parent_commits_after": parent_commits_after,
        "current_change_id": current_change_id,
        "rebased": rebased,
        "has_unresolved_conflicts": has_unresolved_conflicts,
        "conflicted_files": conflicted,
        "metadata_base_change_id_updated": False,
        "message": message,
        "commands": commands,
    }
    if fetch_stdout.strip():
        result["fetch_stdout"] = fetch_stdout
    if fetch_stderr.strip():
        result["fetch_stderr"] = fetch_stderr
    if rebase_stdout.strip():
        result["rebase_stdout"] = rebase_stdout
    if rebase_stderr.strip():
        result["rebase_stderr"] = rebase_stderr
    if rebase_exit_code is not None:
        result["rebase_exit_code"] = rebase_exit_code
    return result


def first_commit_id(commits: list[str] | None) -> str | None:
    if commits:
        return commits[0]
    return None


def refresh_base(stage: str) -> dict[str, Any]:
    base, remote = configured_publish_base()
    remote_base = f"{base}@{remote}"
    commands: list[str] = []
    base_commits_before_fetch = revision_commit_ids_if_exists(remote_base)
    parent_commits_before = current_parent_commit_ids()
    current_change_id = current_change_id_short()

    fetch_args, fetch_proc = fetch_base_result(base, remote)
    commands.append(command_display(fetch_args))
    if fetch_proc.stdout:
        print(fetch_proc.stdout, end="")
    if fetch_proc.stderr:
        print(fetch_proc.stderr, end="", file=sys.stderr)
    if fetch_proc.returncode != 0:
        return refresh_result(
            stage=stage,
            status="fetch_failed",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=remote_base,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=None,
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=has_unresolved_conflicts_at_current_change(),
            conflicted=conflicted_files(),
            message=(
                f"could not fetch jj workspace base {base!r} from remote {remote!r}; "
                "fetch or configure SCHERZO_JJ_WORKSPACE_REMOTE/"
                "SCHERZO_JJ_WORKSPACE_BASE_BRANCH and retry"
            ),
            commands=commands,
            fetch_stdout=fetch_proc.stdout,
            fetch_stderr=fetch_proc.stderr,
        )

    base_revision, base_commits_after_fetch, _used_local_fallback = resolve_base_revision(base, remote)
    if base_revision is None or base_commits_after_fetch is None:
        return refresh_result(
            stage=stage,
            status="base_not_found",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=remote_base,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=None,
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=has_unresolved_conflicts_at_current_change(),
            conflicted=conflicted_files(),
            message=f"could not find publish base revision {remote_base!r} or {base!r}",
            commands=commands,
        )

    existing_conflicts = has_unresolved_conflicts_at_current_change()
    existing_conflicted_files = conflicted_files() if existing_conflicts else []
    if existing_conflicts:
        return refresh_result(
            stage=stage,
            status="conflicts",
            repairable=True,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=True,
            conflicted=existing_conflicted_files,
            message="current change already has unresolved conflicts after fetching publish base",
            commands=commands,
        )

    if len(base_commits_after_fetch) == 1 and parent_commits_before == base_commits_after_fetch:
        return refresh_result(
            stage=stage,
            status="fresh",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=False,
            conflicted=[],
            message="current parent already matches publish base",
            commands=commands,
        )

    if stage == "publish":
        print("## Publish base normalization")
        print(
            f"Rebasing final implementation change onto `{base_revision}` before "
            "publishing so the PR branch does not push local workspace ancestors."
        )
    else:
        print("## Refreshing implementation base")
        print(f"Rebasing current implementation change onto `{base_revision}`.")

    rebase_args = ["jj", "rebase", "-r", "@", "-d", base_revision, "--color=never"]
    rebase_proc = run_proc(rebase_args)
    commands.append(command_display(rebase_args))
    if rebase_proc.stdout:
        print(rebase_proc.stdout, end="")
    if rebase_proc.stderr:
        print(rebase_proc.stderr, end="", file=sys.stderr)

    unresolved = has_unresolved_conflicts_at_current_change()
    files = conflicted_files() if unresolved else []
    parent_commits_after = current_parent_commit_ids()
    if unresolved:
        return refresh_result(
            stage=stage,
            status="conflicts",
            repairable=True,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=parent_commits_after,
            current_change_id=current_change_id,
            rebased=True,
            has_unresolved_conflicts=True,
            conflicted=files,
            message="rebasing onto the publish base left unresolved conflicts"
            if files
            else "rebasing onto the publish base left unresolved conflicts; conflicted file list could not be determined",
            commands=commands,
            rebase_stdout=rebase_proc.stdout,
            rebase_stderr=rebase_proc.stderr,
            rebase_exit_code=rebase_proc.returncode,
        )
    if rebase_proc.returncode != 0:
        return refresh_result(
            stage=stage,
            status="rebase_failed",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=parent_commits_after,
            current_change_id=current_change_id,
            rebased=True,
            has_unresolved_conflicts=False,
            conflicted=[],
            message="could not rebase the implementation change onto the publish base",
            commands=commands,
            rebase_stdout=rebase_proc.stdout,
            rebase_stderr=rebase_proc.stderr,
            rebase_exit_code=rebase_proc.returncode,
        )
    return refresh_result(
        stage=stage,
        status="rebased_clean",
        repairable=False,
        remote=remote,
        base=base,
        base_revision=base_revision,
        base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
        base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
        parent_commits_before=parent_commits_before,
        parent_commits_after=parent_commits_after,
        current_change_id=current_change_id,
        rebased=True,
        has_unresolved_conflicts=False,
        conflicted=[],
        message="rebased current change onto publish base without unresolved conflicts",
        commands=commands,
        rebase_stdout=rebase_proc.stdout,
        rebase_stderr=rebase_proc.stderr,
        rebase_exit_code=rebase_proc.returncode,
    )


def driver_refresh_result(stage: str) -> dict[str, Any]:
    payload, proc = run_workspace_driver_json(
        ["refresh-base", "--stage", stage, "--json"],
        check=False,
        failure_code="workspace_driver_refresh_base_failed",
    )
    status = str(payload.get("status") or "")
    conflict_files = payload.get("conflict_files")
    if not isinstance(conflict_files, list):
        conflict_files = []
    repairable = status == "conflicts"
    result = {
        "schema_version": 1,
        "version": payload.get("version"),
        "stage": payload.get("stage") or stage,
        "status": status,
        "failure_code": str(payload.get("failure_code") or "workspace_driver_refresh_base_failed"),
        "exit_code": proc.returncode,
        "repairable": repairable,
        "remote": os.environ.get("SCHERZO_JJ_WORKSPACE_REMOTE", "origin").strip() or "origin",
        "base": payload.get("base_ref") or os.environ.get("SCHERZO_JJ_WORKSPACE_BASE_BRANCH", "main").strip() or "main",
        "base_revision": payload.get("base_revision") or payload.get("base_ref") or "",
        "base_commit_before_fetch": None,
        "base_commit_after_fetch": payload.get("base_revision") or "",
        "parent_commits_before": [str(payload.get("before_revision") or "")],
        "parent_commits_after": [str(payload.get("after_revision") or "")],
        "current_change_id": str(payload.get("change_id") or payload.get("after_revision") or ""),
        "rebased": status == "rebased_clean",
        "has_unresolved_conflicts": status == "conflicts",
        "conflicted_files": [str(item) for item in conflict_files if isinstance(item, str)],
        "metadata_base_change_id_updated": False,
        "message": str(payload.get("message") or status),
        "commands": ["$SCHERZO_WORKSPACE_DRIVER refresh-base --stage " + stage + " --json"],
    }
    if proc.returncode != 0 and status not in {"conflicts", "fetch_failed", "base_not_found", "rebase_failed"}:
        result["status"] = status or "rebase_failed"
        result["repairable"] = False
    return result


def update_start_refresh_metadata(result: dict[str, Any]) -> None:
    if result.get("stage") != "before-implementation":
        return
    if result.get("status") not in {"fresh", "rebased_clean"}:
        return
    metadata = load_implementation_metadata()
    if workspace_driver_available():
        refreshed_base_change_id = str(result.get("base_revision") or "").strip()
        if not refreshed_base_change_id:
            refreshed_base_change_id = str(result.get("parent_commits_after", [""])[0] or "")
    else:
        refreshed_base_change_id = current_base_change_id()
    previous_base_change_id = metadata.get("base_change_id")
    if previous_base_change_id != refreshed_base_change_id:
        if "initial_base_change_id" not in metadata:
            metadata["initial_base_change_id"] = previous_base_change_id
        metadata["base_change_id"] = refreshed_base_change_id
        write_implementation_metadata(metadata)
        result["metadata_base_change_id_updated"] = True


def write_refresh_base_result(result: dict[str, Any]) -> Path:
    path = refresh_base_json_path(str(result["stage"]))
    write_json(path, result)
    write_json(BASE_REFRESH_LATEST_PATH, result)
    print(f"REFRESH_BASE_STATUS={result['status']}")
    print(f"REFRESH_BASE_REPAIRABLE={str(bool(result['repairable'])).lower()}")
    print(f"REFRESH_BASE_REBASED={str(bool(result['rebased'])).lower()}")
    print(f"REFRESH_BASE_BASE_REVISION={result['base_revision']}")
    print(f"REFRESH_BASE_JSON={path}")
    print("REFRESH_BASE_CONFLICTED_FILES:")
    files = result.get("conflicted_files") or []
    if files:
        for file in files:
            print(f"- {file}")
    else:
        print("- None")
    return path


def refresh_base_command(args: list[str]) -> None:
    stage = parse_refresh_base_args(args)
    if workspace_driver_available():
        result = driver_refresh_result(stage)
    else:
        require_command("jj")
        result = refresh_base(stage)
    update_start_refresh_metadata(result)
    write_refresh_base_result(result)
    status = result["status"]
    if status in {"fresh", "rebased_clean"}:
        sys.exit(0)
    if status == "conflicts":
        sys.exit(20)
    sys.exit(1)


def append_base_drift_repair_summary(body: str) -> tuple[str, bool]:
    if not BASE_DRIFT_REPAIR_SUMMARY_PATH.exists():
        return body, False
    summary = BASE_DRIFT_REPAIR_SUMMARY_PATH.read_text().strip()
    section = "\n\n## Base drift repair\n\n"
    if summary:
        section += summary + "\n"
    else:
        section += f"See `{BASE_DRIFT_REPAIR_SUMMARY_PATH}`.\n"
    return body.rstrip() + section, True


def publish_blocked_after_refresh(result: dict[str, Any], *, failure_code: str) -> None:
    print("PUBLISH_BLOCKED=true")
    print("PUBLISH_BLOCKED_REASON=base drift after final validation")
    message = str(result.get("message") or "base moved after final validation")
    if result.get("status") == "conflicts":
        files = result.get("conflicted_files") or []
        if files:
            message += "\nConflicted files:\n" + "\n".join(f"- {file}" for file in files)
    fail(
        "publish blocked because the PR base moved after the repair window. "
        "Rerun the workflow or repair the retained workspace manually.\n" + message,
        failure_code=failure_code,
    )



def clean_lines(value: str) -> list[str]:
    return [line.strip() for line in value.splitlines() if line.strip()]


def detect_languages(files: list[str]) -> tuple[list[str], list[str], list[str]]:
    languages: list[str] = []
    supported_files: list[str] = []
    unsupported_files: list[str] = []
    for file in files:
        lower = file.lower()
        if lower.endswith(".gleam"):
            if "gleam" not in languages:
                languages.append("gleam")
            supported_files.append(file)
        elif is_review_relevant(file):
            unsupported_files.append(file)
    return languages, supported_files, unsupported_files


def is_review_relevant(file: str) -> bool:
    lower = file.lower()
    return any(
        lower.endswith(ext)
        for ext in [
            ".erl",
            ".hrl",
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".py",
            ".rs",
            ".go",
            ".fs",
            ".fsx",
            ".elm",
        ]
    )


def review_commands(_languages: list[str]) -> list[str]:
    # Review is performed by repo-local staged `.scherzo/workflows/scripts/scherzo-review` lanes in
    # the workflow DAG. Keep this compatibility field empty so prompts do not
    # depend on a local pi `/review` command or language-specific local skills.
    return []


def run_root_for_current_workspace() -> Path:
    explicit = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if explicit:
        return Path(explicit).resolve()

    cwd = Path.cwd().resolve()
    parts = cwd.parts
    if len(parts) >= 3 and parts[-2] == "workspaces":
        return cwd.parent.parent
    return cwd.parent


def retention_marker_path() -> Path:
    return run_root_for_current_workspace() / RETENTION_MARKER


def write_retention_marker(source_kind: str, source_ref: str) -> None:
    marker = retention_marker_path()
    marker.write_text(
        "Scherzo retained this run because an implementation workflow "
        "has not published a PR yet.\n"
        f"Source kind: {source_kind}\n"
        f"Source: {source_ref}\n"
    )


def clear_retention_marker() -> None:
    marker = retention_marker_path()
    if marker.exists():
        marker.unlink()


def sanitize_ref_part(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value


def githubish_host(host: str) -> bool:
    normalized = host.lower()
    return normalized == "github.com" or normalized.startswith("github")


def owner_repo_from_url(url: str) -> str | None:
    if url.startswith("https://github.com/"):
        value = url.removeprefix("https://github.com/")
    else:
        scp_match = re.match(r"^git@([^:]+):(.+)$", url)
        ssh_match = re.match(r"^ssh://(?:git@)?([^/]+)/(.+)$", url)
        if scp_match and githubish_host(scp_match.group(1)):
            value = scp_match.group(2)
        elif ssh_match and githubish_host(ssh_match.group(1)):
            value = ssh_match.group(2)
        else:
            return None
    value = value.split("?", 1)[0].split("#", 1)[0].rstrip("/").removesuffix(".git")
    parts = value.split("/")
    if len(parts) >= 2 and parts[0] and parts[1]:
        return f"{parts[0]}/{parts[1]}"
    return None


def remote_url(remote: str) -> str | None:
    output = run(["jj", "git", "remote", "list", "--color=never"])
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == remote:
            return parts[1]
    return None


def explicit_repo_env() -> tuple[str, str] | None:
    for name in ["SCHERZO_GITHUB_REPO", "SCHERZO_PR_REPO"]:
        explicit = os.environ.get(name, "").strip()
        if explicit:
            return name, explicit
    return None


def default_repo(remote: str) -> str:
    url = remote_url(remote)
    if not url:
        fail(f"could not find jj git remote: {remote}")
    remote_repo = owner_repo_from_url(url)
    explicit = explicit_repo_env()
    if explicit:
        name, repo = explicit
        if remote_repo and repo.lower() != remote_repo.lower():
            fail(
                f"{name}={repo} does not match selected jj publication remote "
                f"'{remote}' ({remote_repo}); update {name} or "
                "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE"
            )
        return repo
    if remote_repo:
        return remote_repo
    github_repo = os.environ.get("GITHUB_REPOSITORY", "").strip()
    if github_repo:
        return github_repo
    fail(f"could not infer GitHub owner/repo from remote URL: {url}")


def plan_title(plan_path: str) -> str:
    text = Path(plan_path).read_text(encoding="utf-8")
    if plan_path.endswith(".html"):
        for pattern in [r"<h1\b[^>]*>(.*?)</h1>", r"<title\b[^>]*>(.*?)</title>"]:
            match = re.search(pattern, text, flags=re.IGNORECASE | re.DOTALL)
            if match:
                title = re.sub(r"<[^>]+>", " ", match.group(1))
                title = html.unescape(re.sub(r"\s+", " ", title)).strip()
                title = re.sub(r"\s+[—-]\s+Scherzo ExecPlan.*$", "", title).strip()
                if title:
                    return title
    for line in text.splitlines():
        if line.startswith("# "):
            return line.removeprefix("# ").strip()
    return f"Implement {plan_path}"


def label_names(issue: dict[str, Any]) -> list[str]:
    labels = issue.get("labels", {}).get("nodes", [])
    names = [label.get("name") or "" for label in labels]
    return sorted([name for name in names if name])


def comment_nodes(issue: dict[str, Any]) -> list[dict[str, Any]]:
    comments = issue.get("comments", {}).get("nodes", [])
    return sorted(comments, key=lambda c: c.get("createdAt") or "")


def render_ticket_brief(issue: dict[str, Any]) -> str:
    identifier = issue.get("identifier") or "unknown-issue"
    title = issue.get("title") or "Untitled"
    url = issue.get("url") or ""
    state = (issue.get("state") or {}).get("name") or "Unknown"
    priority = issue.get("priority")
    description = issue.get("description") or "_No description provided._"
    labels = label_names(issue)
    comments = comment_nodes(issue)
    labels_truncated = issue.get("labels", {}).get("pageInfo", {}).get("hasNextPage") is True
    comments_truncated = issue.get("comments", {}).get("pageInfo", {}).get("hasNextPage") is True

    lines = [
        f"# Task context for {identifier}: {title}",
        "",
        "## Metadata",
        "",
        f"- Identifier: {identifier}",
        f"- Title: {title}",
        f"- URL: {url or 'None'}",
        f"- State: {state}",
        f"- Priority: {priority if priority is not None else 'None'}",
        "- Labels: " + (", ".join(labels) if labels else "None"),
        "",
        "## Description",
        "",
        description,
        "",
        "## Comments",
        "",
    ]

    if comments:
        for index, comment in enumerate(comments, start=1):
            created = comment.get("createdAt") or "unknown time"
            user = (comment.get("user") or {}).get("name") or "unknown user"
            body = comment.get("body") or ""
            lines.extend([
                f"### Comment {index} — {created} — {user}",
                "",
                body or "_No body._",
                "",
            ])
    else:
        lines.extend(["None.", ""])

    if labels_truncated or comments_truncated:
        lines.extend(["## Fetch notes", ""])
        if labels_truncated:
            lines.append("- Linear returned more than 50 labels; the label list above is truncated.")
        if comments_truncated:
            lines.append("- Linear returned more than 100 comments; the comment list above is truncated.")
        lines.append("")

    return "\n".join(lines).rstrip() + "\n"


def write_ticket_brief(issue: dict[str, Any]) -> Path:
    TICKET_BRIEF_PATH.parent.mkdir(parents=True, exist_ok=True)
    TICKET_BRIEF_PATH.write_text(render_ticket_brief(issue))
    return TICKET_BRIEF_PATH


def parse_prepare_source(args: list[str]) -> str:
    if args == ["--source", "ticket"]:
        return "ticket"
    usage()
    sys.exit(2)


def prepare_command(args: list[str]) -> None:
    source_kind = parse_prepare_source(args)
    issue_identifier = infer_issue_identifier()
    # Create the retention marker before any fetch or workspace inspection can fail so
    # prepare-step diagnostics remain available for triage.
    write_retention_marker(source_kind, issue_identifier)
    if workspace_driver_available():
        base_change_id = str(workspace_driver_baseline()["baseline_id"])
    else:
        require_command("jj")
        base_change_id = current_base_change_id()

    issue = fetch_linear_issue_context(issue_identifier)
    brief_path = write_ticket_brief(issue)
    issue_ref = issue.get("identifier") or issue_identifier
    write_retention_marker(source_kind, issue_ref)
    metadata = {
        "source_kind": source_kind,
        "issue_identifier": issue_ref,
        "issue_title": issue.get("title") or "",
        "issue_url": issue.get("url") or "",
        "brief_path": str(brief_path),
        "base_change_id": base_change_id,
    }
    write_implementation_metadata(metadata)
    print(f"SOURCE_KIND={source_kind}")
    print(f"BRIEF_PATH={brief_path}")
    print(f"BASE_CHANGE_ID={base_change_id}")
    print(f"RETENTION_MARKER={retention_marker_path()}")
    print("VALIDATION=ok")


def require_plan_brief_metadata() -> tuple[dict[str, Any], str]:
    metadata = load_implementation_metadata()
    if metadata.get("source_kind") != "execplan":
        fail(
            "plan-brief only applies to execplan implementation workflows; "
            f"found source_kind={metadata.get('source_kind')!r}"
        )
    if not (
        metadata.get("execplan_v2_bundle_path") or metadata.get("plan_artifact_ref")
    ):
        fail(
            "plan-brief requires ExecPlan bundle metadata produced by "
            "scherzo-execplan implementation-prepare",
            failure_code="execplan_metadata_invalid",
        )
    plan_path = str(metadata.get("plan_path") or "").strip()
    if not plan_path:
        fail(
            f"missing plan_path in {METADATA_PATH}; run "
            "scherzo-execplan implementation-prepare first",
            failure_code="execplan_metadata_invalid",
        )
    validate_prepared_execplan_path(plan_path, Path.cwd())
    return metadata, plan_path


def load_plan_index_hash(index_path: str) -> str | None:
    try:
        index = json.loads(Path(index_path).read_text())
    except (OSError, json.JSONDecodeError):
        return None
    value = str(index.get("source_sha256") or "").strip()
    if re.fullmatch(r"[0-9a-f]{64}", value):
        return value
    return None


def plan_brief_freshness(metadata: dict[str, Any], plan_path: str) -> str:
    if metadata.get("plan_brief_status") != "ok":
        return "unavailable"
    brief_path = str(metadata.get("plan_brief_path") or "").strip()
    index_path = str(metadata.get("plan_index_path") or "").strip()
    metadata_hash = str(metadata.get("plan_source_sha256") or "").strip()
    if not brief_path or not index_path or not Path(brief_path).is_file() or not Path(index_path).is_file():
        return "unavailable"
    index_hash = load_plan_index_hash(index_path)
    if not index_hash or not re.fullmatch(r"[0-9a-f]{64}", metadata_hash):
        return "unavailable"
    current_hash = plan_source_sha256(plan_path)
    if current_hash == metadata_hash == index_hash:
        return "fresh"
    return "stale"


def plan_brief_command(args: list[str]) -> None:
    if args != [] and args != ["--check"] and args != ["--refresh-if-stale"]:
        usage()
        sys.exit(2)
    metadata, plan_path = require_plan_brief_metadata()
    if args == ["--check"]:
        status = plan_brief_freshness(metadata, plan_path)
        print(f"PLAN_BRIEF_STATUS={status}")
        if status == "fresh":
            print(f"PLAN_BRIEF_PATH={metadata.get('plan_brief_path')}")
            print(f"PLAN_INDEX_PATH={metadata.get('plan_index_path')}")
            print(f"PLAN_SOURCE_SHA256={metadata.get('plan_source_sha256')}")
            return
        if status == "stale":
            sys.exit(2)
        sys.exit(1)
    if args == ["--refresh-if-stale"]:
        status = plan_brief_freshness(metadata, plan_path)
        if status == "fresh":
            print("PLAN_BRIEF_STATUS=fresh")
            print(f"PLAN_BRIEF_PATH={metadata.get('plan_brief_path')}")
            print(f"PLAN_INDEX_PATH={metadata.get('plan_index_path')}")
            print(f"PLAN_SOURCE_SHA256={metadata.get('plan_source_sha256')}")
            return
    result = generate_plan_brief(plan_path)
    apply_plan_brief_result(metadata, result)
    write_implementation_metadata(metadata)
    print_plan_brief_result(result)
    if result["status"] != "ok":
        sys.exit(1)


def analyze_command() -> None:
    metadata = load_implementation_metadata()
    files = workspace_driver_changed_files() if workspace_driver_available() else changed_files_since(metadata["base_change_id"])
    if not files:
        fail("no changed files found since the workflow started")
    languages, supported_files, unsupported_files = detect_languages(files)
    commands = review_commands(languages)
    analysis = {
        "changed_files": files,
        "languages": languages,
        "supported_review_files": supported_files,
        "unsupported_review_files": unsupported_files,
        "review_commands": commands,
    }
    write_json(ANALYSIS_PATH, analysis)
    print_list("CHANGED_FILES", files)
    print("LANGUAGES=" + comma_join(languages))
    print_list("SUPPORTED_REVIEW_FILES", supported_files)
    print_list("UNSUPPORTED_REVIEW_FILES", unsupported_files)
    print_list("REVIEW_COMMANDS", commands)


def require_execplan_metadata(metadata: dict[str, Any]) -> tuple[str, str]:
    source_kind = metadata.get("source_kind")
    if source_kind != "execplan":
        fail(
            "plan-completion checks only apply to execplan implementation workflows; "
            f"found source_kind={source_kind!r}",
            failure_code="plan_completion_verdict_malformed",
        )
    plan_path = str(metadata.get("plan_path") or "").strip()
    if not plan_path:
        fail(
            f"missing plan_path in {METADATA_PATH}; run "
            "scherzo-execplan implementation-prepare first",
            failure_code="plan_completion_verdict_malformed",
        )
    base_change_id = str(metadata.get("base_change_id") or "").strip()
    if not base_change_id:
        fail(
            f"missing base_change_id in {METADATA_PATH}; run prepare first",
            failure_code="plan_completion_verdict_malformed",
        )
    return plan_path, base_change_id


def changed_files_in_current_patch() -> list[str]:
    if workspace_driver_available():
        return workspace_driver_changed_files()
    output = run([
        "jj",
        "diff",
        "--from",
        "@-",
        "--to",
        "@",
        "--name-only",
        "--color=never",
    ])
    return clean_lines(output)


def current_patch_diff() -> str:
    if workspace_driver_available():
        return workspace_driver_diff_text()
    return run(["jj", "diff", "--from", "@-", "--to", "@", "--color=never"])


def sha256_json(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def plan_completion_snapshot(metadata: dict[str, Any]) -> dict[str, Any]:
    plan_path, base_change_id = require_execplan_metadata(metadata)
    changed_files = changed_files_in_current_patch()
    diff = current_patch_diff()
    if workspace_driver_available():
        baseline = workspace_driver_baseline()
        verified_base_change_id = str(baseline["baseline_id"])
        verified_change_id = str(baseline["change_id"])
        verified_parent_commit_ids = [str(baseline["baseline_id"])]
    else:
        verified_base_change_id = base_change_id
        verified_change_id = current_change_id_short()
        verified_parent_commit_ids = current_parent_commit_ids()
    fingerprint = sha256_json(
        {
            "schema_version": 1,
            "changed_files": changed_files,
            "diff": diff,
        }
    )
    snapshot = {
        "schema_version": 1,
        "source_kind": "execplan",
        "plan_path": plan_path,
        "verified_base_change_id": verified_base_change_id,
        "verified_change_id": verified_change_id,
        "verified_parent_commit_ids": verified_parent_commit_ids,
        "verified_diff_fingerprint": fingerprint,
        "changed_files": changed_files,
        "verdict_path": str(PLAN_COMPLETION_VERDICT_PATH),
    }
    for metadata_key, context_key in [
        ("plan_brief_status", "plan_brief_status"),
        ("plan_brief_path", "plan_brief_path"),
        ("plan_index_path", "plan_index_path"),
        ("plan_source_sha256", "plan_source_sha256"),
    ]:
        value = metadata.get(metadata_key)
        if isinstance(value, str) and value.strip():
            snapshot[context_key] = value.strip()
    return snapshot


def plan_completion_context_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    if not workspace_driver_available():
        require_command("jj")
    restore_status = restore_execplan_artifacts()
    metadata = load_implementation_metadata()
    context = plan_completion_snapshot(metadata)
    write_json(PLAN_COMPLETION_CONTEXT_PATH, context)
    print(f"EXECPLAN_ARTIFACT_RESTORE_STATUS={restore_status}")
    print(f"PLAN_COMPLETION_CONTEXT_PATH={PLAN_COMPLETION_CONTEXT_PATH}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={PLAN_COMPLETION_VERDICT_PATH}")
    print(f"PLAN_COMPLETION_PLAN_PATH={context['plan_path']}")
    print(f"PLAN_COMPLETION_BASE_CHANGE_ID={context['verified_base_change_id']}")
    print(f"PLAN_COMPLETION_CHANGE_ID={context['verified_change_id']}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(context["verified_diff_fingerprint"])
    )
    if "plan_brief_status" in context:
        print(f"PLAN_BRIEF_STATUS={context['plan_brief_status']}")
    if "plan_brief_path" in context:
        print(f"PLAN_BRIEF_PATH={context['plan_brief_path']}")
    if "plan_index_path" in context:
        print(f"PLAN_INDEX_PATH={context['plan_index_path']}")
    if "plan_source_sha256" in context:
        print(f"PLAN_SOURCE_SHA256={context['plan_source_sha256']}")
    print_list("PLAN_COMPLETION_CHANGED_FILES", context["changed_files"])


def fail_plan_completion_gate(message: str, *, failure_code: str) -> None:
    print("PLAN_COMPLETION_GATE=failed")
    fail(message, failure_code=failure_code)


def string_list_field(value: dict[str, Any], key: str) -> list[str]:
    field = value.get(key)
    if not isinstance(field, list):
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} field {key!r} must be a list of strings",
            failure_code="plan_completion_verdict_malformed",
        )
    strings: list[str] = []
    for item in field:
        if not isinstance(item, str):
            fail_plan_completion_gate(
                f"{PLAN_COMPLETION_VERDICT_PATH} field {key!r} must be a list of strings",
                failure_code="plan_completion_verdict_malformed",
            )
        strings.append(item)
    return strings


def deferred_manual_verification_field(value: dict[str, Any]) -> list[dict[str, str]]:
    field = value.get("deferred_manual_verification", [])
    if not isinstance(field, list):
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} field 'deferred_manual_verification' must be a list of objects",
            failure_code="plan_completion_verdict_malformed",
        )
    entries: list[dict[str, str]] = []
    for item in field:
        if not isinstance(item, dict):
            fail_plan_completion_gate(
                f"{PLAN_COMPLETION_VERDICT_PATH} field 'deferred_manual_verification' must be a list of objects",
                failure_code="plan_completion_verdict_malformed",
            )
        entry: dict[str, str] = {}
        for key in ["check", "reason", "owner", "when"]:
            item_value = item.get(key)
            if not isinstance(item_value, str) or not item_value.strip():
                fail_plan_completion_gate(
                    f"{PLAN_COMPLETION_VERDICT_PATH} deferred manual verification entries must include non-empty {key!r}",
                    failure_code="plan_completion_verdict_malformed",
                )
            entry[key] = item_value.strip()
        entries.append(entry)
    return entries


def deferred_manual_verification_summaries(entries: list[dict[str, str]]) -> list[str]:
    summaries: list[str] = []
    for entry in entries:
        summaries.append(
            f"{entry['check']} (owner: {entry['owner']}; when: {entry['when']}; reason: {entry['reason']})"
        )
    return summaries


def required_string_field(value: dict[str, Any], key: str) -> str:
    field = value.get(key)
    if not isinstance(field, str) or not field.strip():
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} field {key!r} must be a non-empty string",
            failure_code="plan_completion_verdict_malformed",
        )
    return field.strip()


def load_plan_completion_verdict() -> dict[str, Any]:
    if not PLAN_COMPLETION_VERDICT_PATH.exists():
        fail_plan_completion_gate(
            f"missing {PLAN_COMPLETION_VERDICT_PATH}; the plan-completion verifier must write this artifact before review/publish",
            failure_code="plan_completion_verdict_missing",
        )
    try:
        verdict = json.loads(PLAN_COMPLETION_VERDICT_PATH.read_text())
    except json.JSONDecodeError as exc:
        fail_plan_completion_gate(
            f"invalid JSON in {PLAN_COMPLETION_VERDICT_PATH}: {exc}",
            failure_code="plan_completion_verdict_malformed",
        )
    if not isinstance(verdict, dict):
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} must contain a JSON object",
            failure_code="plan_completion_verdict_malformed",
        )
    return verdict


def validate_plan_completion_verdict_shape(verdict: dict[str, Any]) -> dict[str, Any]:
    if verdict.get("schema_version") != 1:
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} must set schema_version to 1",
            failure_code="plan_completion_verdict_malformed",
        )
    raw_verdict = verdict.get("verdict")
    if raw_verdict not in {"pass", "fail"}:
        fail_plan_completion_gate(
            f"{PLAN_COMPLETION_VERDICT_PATH} field 'verdict' must be 'pass' or 'fail'",
            failure_code="plan_completion_verdict_malformed",
        )
    blocking_findings = string_list_field(verdict, "blocking_findings")
    evidence = string_list_field(verdict, "evidence")
    checked_acceptance_criteria = string_list_field(
        verdict,
        "checked_acceptance_criteria",
    )
    plan_path = required_string_field(verdict, "plan_path")
    verified_base_change_id = required_string_field(
        verdict,
        "verified_base_change_id",
    )
    verified_change_id = required_string_field(verdict, "verified_change_id")
    verified_diff_fingerprint = required_string_field(
        verdict,
        "verified_diff_fingerprint",
    )
    if not re.fullmatch(r"[0-9a-f]{64}", verified_diff_fingerprint):
        fail_plan_completion_gate(
            "verified_diff_fingerprint must be a lowercase SHA-256 hex digest",
            failure_code="plan_completion_verdict_malformed",
        )
    changed_files = string_list_field(verdict, "changed_files")
    deferred_manual_verification = deferred_manual_verification_field(verdict)
    return {
        "verdict": raw_verdict,
        "blocking_findings": blocking_findings,
        "evidence": evidence,
        "checked_acceptance_criteria": checked_acceptance_criteria,
        "plan_path": plan_path,
        "verified_base_change_id": verified_base_change_id,
        "verified_change_id": verified_change_id,
        "verified_diff_fingerprint": verified_diff_fingerprint,
        "changed_files": changed_files,
        "deferred_manual_verification": deferred_manual_verification,
    }


def current_plan_completion_verdict(
    metadata: dict[str, Any],
    *,
    gate_label: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    current_plan_path, _current_base_change_id = require_execplan_metadata(metadata)
    verdict = validate_plan_completion_verdict_shape(load_plan_completion_verdict())
    if not workspace_driver_available():
        require_command("jj")
    current = plan_completion_snapshot(metadata)

    if verdict["plan_path"] != current_plan_path:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for plan {verdict['plan_path']!r}; current plan is {current_plan_path!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_base_change_id"] != current["verified_base_change_id"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for base change {verdict['verified_base_change_id']!r}; current base is {current['verified_base_change_id']!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_change_id"] != current["verified_change_id"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for change {verdict['verified_change_id']!r}; current change is {current['verified_change_id']!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_diff_fingerprint"] != current["verified_diff_fingerprint"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict fingerprint; rerun plan-completion verification after the latest implementation changes",
            failure_code="plan_completion_verdict_stale",
        )
    return verdict, current


def canonical_plan_completion_verdict_path() -> Path | None:
    return canonical_implementation_state_path(CANONICAL_PLAN_COMPLETION_VERDICT_NAME)


def restore_plan_completion_verdict() -> str:
    canonical_path = canonical_plan_completion_verdict_path()
    if canonical_path is None:
        return "skipped_no_run_root"
    if not canonical_path.exists():
        return "skipped_missing"
    PLAN_COMPLETION_VERDICT_PATH.parent.mkdir(parents=True, exist_ok=True)
    if canonical_path.resolve() != PLAN_COMPLETION_VERDICT_PATH.resolve():
        PLAN_COMPLETION_VERDICT_PATH.write_bytes(canonical_path.read_bytes())
    return "restored"


def checkpoint_plan_completion_verdict_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    canonical_path = canonical_plan_completion_verdict_path()
    if canonical_path is None:
        fail(
            "SCHERZO_RUN_ROOT is required to checkpoint plan-completion verdicts",
            failure_code="plan_completion_checkpoint_unavailable",
        )
    metadata = load_implementation_metadata()
    verdict, current = current_plan_completion_verdict(
        metadata,
        gate_label="plan-completion verdict checkpoint",
    )
    canonical_path.parent.mkdir(parents=True, exist_ok=True)
    canonical_path.write_bytes(PLAN_COMPLETION_VERDICT_PATH.read_bytes())
    print("PLAN_COMPLETION_VERDICT_CHECKPOINT=written")
    print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={PLAN_COMPLETION_VERDICT_PATH}")
    print(f"PLAN_COMPLETION_CANONICAL_VERDICT_PATH={canonical_path}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(current["verified_diff_fingerprint"])
    )


def plan_completion_retry_command(metadata: dict[str, Any]) -> str:
    issue_identifier = implementation_issue_identifier(metadata)
    if issue_identifier:
        return f"scherzoctl task retry {issue_identifier}"
    return "scherzoctl task retry <issue>"


def plan_completion_recovery_summary_markdown(payload: dict[str, Any]) -> str:
    lines = [
        "# Plan-completion recovery summary",
        "",
        f"- Status: `{payload['status']}`",
        f"- Phase: `{payload['phase']}`",
        f"- Attempt: `{payload['attempt']}` of `{payload['max_attempts']}`",
        f"- Verdict artifact: `{payload['verdict_path']}`",
        f"- Recovery JSON: `{PLAN_COMPLETION_RECOVERY_PATH}`",
    ]
    if payload.get("recovery_summary_path"):
        lines.append(f"- Recovery summary: `{payload['recovery_summary_path']}`")
    if payload.get("plan_path"):
        lines.append(f"- Review doc: `{payload['plan_path']}`")
    if payload.get("retention_marker"):
        lines.append(f"- Retention marker: `{payload['retention_marker']}`")
    if payload.get("retry_command"):
        lines.append(f"- Retry command: `{payload['retry_command']}`")
    lines.extend(["", "## Blocking findings", ""])
    blocking_findings = payload.get("blocking_findings") or []
    if blocking_findings:
        lines.extend(f"- {finding}" for finding in blocking_findings)
    else:
        lines.append("- None")
    lines.extend(["", "## Deferred manual verification", ""])
    deferred_manual_verification = payload.get("deferred_manual_verification") or []
    deferred_summaries = deferred_manual_verification_summaries(
        deferred_manual_verification
    )
    if deferred_summaries:
        lines.extend(f"- {item}" for item in deferred_summaries)
    else:
        lines.append("- None")
    lines.extend([
        "",
        "## Next action",
        "",
        str(payload.get("next_action") or "None."),
    ])
    return "\n".join(lines) + "\n"


def write_plan_completion_recovery_artifacts(payload: dict[str, Any]) -> None:
    write_json(PLAN_COMPLETION_RECOVERY_PATH, payload)
    PLAN_COMPLETION_RECOVERY_SUMMARY_PATH.parent.mkdir(parents=True, exist_ok=True)
    PLAN_COMPLETION_RECOVERY_SUMMARY_PATH.write_text(
        plan_completion_recovery_summary_markdown(payload),
        encoding="utf-8",
    )


def print_plan_completion_recovery_summary(payload: dict[str, Any]) -> None:
    print(f"PLAN_COMPLETION_RECOVERY_STATUS={payload['status']}")
    print(f"PLAN_COMPLETION_RECOVERY_PHASE={payload['phase']}")
    print(f"PLAN_COMPLETION_RECOVERY_ATTEMPT={payload['attempt']}")
    print(f"PLAN_COMPLETION_RECOVERY_MAX_ATTEMPTS={payload['max_attempts']}")
    print(f"PLAN_COMPLETION_VERDICT={payload['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={payload['verdict_path']}")
    print(f"PLAN_COMPLETION_RECOVERY_PATH={PLAN_COMPLETION_RECOVERY_PATH}")
    print(
        "PLAN_COMPLETION_RECOVERY_SUMMARY_PATH="
        + str(PLAN_COMPLETION_RECOVERY_SUMMARY_PATH)
    )
    print(f"PLAN_COMPLETION_PLAN_PATH={payload['plan_path']}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(payload["verified_diff_fingerprint"])
    )
    if payload.get("retry_command"):
        print(f"PLAN_COMPLETION_RETRY_COMMAND={payload['retry_command']}")
    if payload.get("retention_marker"):
        print(f"PLAN_COMPLETION_RETENTION_MARKER={payload['retention_marker']}")
    print_list("PLAN_COMPLETION_BLOCKING_FINDINGS", payload["blocking_findings"])
    print_list(
        "PLAN_COMPLETION_DEFERRED_MANUAL_VERIFICATION",
        deferred_manual_verification_summaries(
            payload["deferred_manual_verification"]
        ),
    )


def parse_plan_completion_recovery_args(args: list[str]) -> tuple[str, int, int]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "--phase",
        required=True,
        choices=[
            "before-late-repair",
            "before-final-repair",
            "after-late-repair",
            "after-final-repair",
            "final",
        ],
    )
    parser.add_argument("--attempt", required=True, type=int)
    parser.add_argument("--max-attempts", required=True, type=int)
    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        usage()
        sys.exit(2)
    return str(parsed.phase), int(parsed.attempt), int(parsed.max_attempts)


def plan_completion_recovery_command(args: list[str]) -> None:
    phase, attempt, max_attempts = parse_plan_completion_recovery_args(args)
    metadata = load_implementation_metadata()
    verdict, current = current_plan_completion_verdict(
        metadata,
        gate_label="plan-completion recovery",
    )
    payload: dict[str, Any] = {
        "schema_version": 1,
        "status": "not_needed",
        "phase": phase,
        "attempt": attempt,
        "max_attempts": max_attempts,
        "verdict": verdict["verdict"],
        "verdict_path": str(PLAN_COMPLETION_VERDICT_PATH),
        "recovery_summary_path": str(PLAN_COMPLETION_RECOVERY_SUMMARY_PATH),
        "plan_path": str(current["plan_path"]),
        "verified_diff_fingerprint": str(current["verified_diff_fingerprint"]),
        "changed_files": verdict["changed_files"],
        "blocking_findings": verdict["blocking_findings"],
        "checked_acceptance_criteria": verdict["checked_acceptance_criteria"],
        "evidence": verdict["evidence"],
        "deferred_manual_verification": verdict["deferred_manual_verification"],
    }
    if verdict["verdict"] == "pass":
        payload["next_action"] = "No bounded plan-completion repair is needed."
        write_plan_completion_recovery_artifacts(payload)
        print_plan_completion_recovery_summary(payload)
        return

    repair_budget_description = (
        "attempt 1 is apply_plan_completion_feedback; "
        "attempt 2 is the late pre-review repair; "
        "attempt 3 is the final pre-review salvage repair"
    )
    retry_command = plan_completion_retry_command(metadata)
    issue_identifier = implementation_issue_identifier(metadata)
    source_ref = issue_identifier or str(current["plan_path"])

    repair_next_actions = {
        "before-late-repair": "run late plan-completion repair step",
        "before-final-repair": "run final plan-completion repair step",
    }
    if phase in repair_next_actions and attempt <= max_attempts:
        payload.update(
            {
                "status": "repair_needed",
                "retryable": True,
                "repair_budget_description": repair_budget_description,
                "next_action": repair_next_actions[phase],
            }
        )
        write_plan_completion_recovery_artifacts(payload)
        print_plan_completion_recovery_summary(payload)
        return

    write_retention_marker("execplan", source_ref)
    payload.update(
        {
            "status": "exhausted",
            "retryable": False,
            "repair_budget_description": repair_budget_description,
            "failure_code": "plan_completion_recovery_exhausted",
            "retention_marker": RETENTION_MARKER,
            "retry_command": retry_command,
            "next_action": "Inspect or salvage from the retained workspace, then use the normal full workflow retry command when safe: "
            + retry_command,
        }
    )
    write_plan_completion_recovery_artifacts(payload)
    print_plan_completion_recovery_summary(payload)
    fail(
        "plan-completion recovery exhausted; inspect the retained workspace and recovery summary before retrying the full workflow",
        failure_code="plan_completion_recovery_exhausted",
    )


def gate_plan_completion_command(args: list[str]) -> None:
    if args != [] and args != ["--final"]:
        usage()
        sys.exit(2)
    final_gate = args == ["--final"]
    gate_label = "final plan-completion gate" if final_gate else "plan-completion gate"
    verdict_restore_status = restore_plan_completion_verdict() if final_gate else "not_needed"
    metadata = load_implementation_metadata()
    verdict, current = current_plan_completion_verdict(metadata, gate_label=gate_label)

    print(f"PLAN_COMPLETION_GATE_MODE={'final' if final_gate else 'pre_review'}")
    print(f"PLAN_COMPLETION_VERDICT_RESTORE_STATUS={verdict_restore_status}")
    print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={PLAN_COMPLETION_VERDICT_PATH}")
    print_list(
        "PLAN_COMPLETION_DEFERRED_MANUAL_VERIFICATION",
        deferred_manual_verification_summaries(
            verdict["deferred_manual_verification"]
        ),
    )
    if verdict["verdict"] != "pass":
        print_list("PLAN_COMPLETION_BLOCKING_FINDINGS", verdict["blocking_findings"])
        fail_plan_completion_gate(
            "plan-completion verifier reported blocking findings; code review/publish is blocked until the ExecPlan's promised behavior is complete",
            failure_code="plan_completion_failed",
        )

    print("PLAN_COMPLETION_GATE=passed")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(current["verified_diff_fingerprint"])
    )


def print_list(label: str, values: list[str]) -> None:
    print(label + ":")
    if values:
        for value in values:
            print(f"- {value}")
    else:
        print("- None")


def comma_join(values: list[str]) -> str:
    return ",".join(values) if values else "none"


def validation_env() -> dict[str, str]:
    env = os.environ.copy()
    # Validation runs the repository test suite, and some tests execute Scherzo
    # helper scripts against fixture directories. Workflow-run-scoped settings
    # must not leak into those nested helper invocations; otherwise fixtures can
    # infer the outer Scherzo run's issue/run/workspace, use the outer workspace
    # driver/base configuration, or publish against the outer workflow remote
    # instead of their own temporary test context.
    for key in [
        "SCHERZO_CONFIG_DIR",
        "GITHUB_REPOSITORY",
        "SCHERZO_GITHUB_REPO",
        "SCHERZO_ISSUE_ID",
        "SCHERZO_ISSUE_IDENTIFIER",
        "SCHERZO_JJ_WORKSPACE_BASE",
        "SCHERZO_JJ_WORKSPACE_BASE_BRANCH",
        "SCHERZO_JJ_WORKSPACE_FETCH_BASE",
        "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE",
        "SCHERZO_JJ_WORKSPACE_REMOTE",
        "SCHERZO_PR_BASE",
        "SCHERZO_PR_DRAFT",
        "SCHERZO_PR_REMOTE",
        "SCHERZO_PR_REPO",
        "SCHERZO_REPO_ROOT",
        "SCHERZO_RUN_ID",
        "SCHERZO_RUN_ROOT",
        "SCHERZO_SOURCE_WORKSPACE_PATH",
        "SCHERZO_WORKFLOW_BUNDLE_DIR",
        "SCHERZO_WORKFLOW_ID",
        "SCHERZO_WORKSPACE_CAPABILITIES",
        "SCHERZO_WORKSPACE_DRIVER",
        "SCHERZO_WORKSPACE_NAME",
        "SCHERZO_WORKSPACE_PATH",
        "SCHERZO_WORKSPACE_PROFILE",
        "SCHERZO_WORKSPACE_ROOT",
    ]:
        env.pop(key, None)
    return env


def fallback_validation_base_revision() -> str:
    base, remote = configured_publish_base()
    return f"{base}@{remote}"


def final_validation_base_revision(*, failure_code: str | None = None) -> str:
    if not BASE_REFRESH_LATEST_PATH.exists():
        return fallback_validation_base_revision()
    try:
        refresh = json.loads(BASE_REFRESH_LATEST_PATH.read_text())
    except json.JSONDecodeError as exc:
        fail(
            f"invalid {BASE_REFRESH_LATEST_PATH}; cannot resolve validation base revision: {exc}",
            failure_code=failure_code,
        )
    base_revision = str(refresh.get("base_revision") or "").strip()
    if base_revision:
        return base_revision
    return fallback_validation_base_revision()


# Canonical local/CI gate. The dogfood validate step, devenv `check`, and
# Buildkite all drive `scripts/scherzo-ci`, so there is a single source of truth
# for what validation runs.
VALIDATION_SCRIPT = "scripts/scherzo-ci"


def scherzo_ci_validation_command() -> list[str]:
    return ["direnv", "exec", ".", VALIDATION_SCRIPT]


def validation_command_display(command: list[str]) -> str:
    return " ".join(command)


def write_validation_result(
    *,
    base_revision: str,
    setup_commands: list[list[str]],
    validation_command: list[str],
    status: str,
    exit_code: int | None = None,
    stdout: str = "",
    stderr: str = "",
    fingerprint: str | None = None,
    cached: bool = False,
) -> None:
    result: dict[str, Any] = {
        "base_revision": base_revision,
        "commands": [validation_command_display(validation_command)],
        "setup_commands": [validation_command_display(c) for c in setup_commands],
        "status": status,
        "validator": "scherzo-ci",
    }
    if fingerprint:
        result["fingerprint"] = fingerprint
    if cached:
        result["cached"] = True
    if exit_code is not None:
        result["exit_code"] = exit_code
    if status != "passed":
        result["failure_summary"] = validation_failure_summary(stdout, stderr)
        result["stdout_excerpt"] = diagnostic_excerpt(
            stdout, VALIDATION_RESULT_EXCERPT_MAX_CHARS
        )
        result["stderr_excerpt"] = diagnostic_excerpt(
            stderr, VALIDATION_RESULT_EXCERPT_MAX_CHARS
        )
        result["diagnostic_note"] = (
            "Full command output is retained in the workflow command-step diagnostics "
            "for the failing validation step when Scherzo artifact retention is enabled."
        )
    write_json(VALIDATION_PATH, result)


def previous_validation_failure_details() -> str:
    if not VALIDATION_PATH.exists():
        return (
            f"No structured validation artifact was found at {VALIDATION_PATH}. "
            "Inspect the earlier validate_after_refresh command-step diagnostics."
        )
    try:
        validation = json.loads(VALIDATION_PATH.read_text())
    except json.JSONDecodeError as exc:
        return f"Structured validation artifact {VALIDATION_PATH} is invalid JSON: {exc}"

    lines = ["Previous validation result:"]
    status = str(validation.get("status") or "unknown")
    lines.append(f"- status: {status}")
    exit_code = validation.get("exit_code")
    if exit_code is not None:
        lines.append(f"- exit_code: {exit_code}")
    base_revision = str(validation.get("base_revision") or "").strip()
    if base_revision:
        lines.append(f"- base_revision: {base_revision}")
    commands = validation.get("commands")
    if isinstance(commands, list) and commands:
        lines.append("- command: " + str(commands[0]))
    lines.append(f"- structured_validation_artifact: {VALIDATION_PATH}")
    lines.append(
        "- full_output_hint: inspect .scherzo/command-step-diagnostics/validate_after_refresh.txt in the retained workspace"
    )
    summary = str(validation.get("failure_summary") or "").strip()
    if summary:
        lines.append("\nFailure summary:\n" + summary)
    return "\n".join(lines)


def assert_base_drift_repair_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    if not BASE_DRIFT_REPAIR_FAILURE_PATH.exists():
        print("BASE_DRIFT_REPAIR_DECISION=ok")
        return

    failure = BASE_DRIFT_REPAIR_FAILURE_PATH.read_text().strip()
    previous_validation = previous_validation_failure_details()
    fail(
        f"base drift repair requested workflow failure via {BASE_DRIFT_REPAIR_FAILURE_PATH}:"
        + ("\n" + failure if failure else "")
        + "\n\n"
        + previous_validation,
        failure_code="base_drift_repair_failed",
    )


def validation_fingerprint() -> str | None:
    # Fingerprint the exact tree state validation runs against: the base commit
    # the change is stacked on plus the change's own diff. base_commit + diff
    # fully determines the working tree, so an identical fingerprint means an
    # identical tree under test and a prior passing scherzo-ci run can be reused
    # instead of re-running the full gate. Best-effort: any resolution failure
    # returns None so validation simply runs. SCHERZO_VALIDATE_FINGERPRINT lets
    # callers/tests pin the value when jj is unavailable.
    override = os.environ.get("SCHERZO_VALIDATE_FINGERPRINT", "").strip()
    if override:
        return override
    if not command_exists("jj"):
        return None
    base = run_proc([
        "jj", "log", "-r", "@-", "--no-graph",
        "-T", "commit_id ++ \"\\n\"", "--color=never",
    ])
    diff = run_proc(["jj", "diff", "--from", "@-", "--to", "@", "--color=never"])
    if base.returncode != 0 or diff.returncode != 0:
        return None
    base_ids = clean_lines(base.stdout)
    if not base_ids:
        return None
    return sha256_json(
        {
            "schema_version": 1,
            "base_commit_ids": base_ids,
            "diff": diff.stdout,
        }
    )


def cached_passing_validation(fingerprint: str | None) -> dict[str, Any] | None:
    if not fingerprint or not VALIDATION_PATH.exists():
        return None
    try:
        prior = json.loads(VALIDATION_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if prior.get("status") == "passed" and prior.get("fingerprint") == fingerprint:
        return prior
    return None


def validate_command(*, failure_code: str | None = None) -> None:
    if command_exists("jj") and has_unresolved_conflicts_at_current_change():
        files = conflicted_files()
        details = ""
        if files:
            details = "\nConflicted files:\n" + "\n".join(f"- {file}" for file in files)
        else:
            details = "\nConflicted file list could not be determined by `jj resolve --list`."
        fail(
            "jj reports unresolved conflicts in the current change; resolve base-drift "
            "conflicts before validation." + details,
            failure_code=failure_code,
        )
    require_command("direnv")
    base_revision = final_validation_base_revision(failure_code=failure_code)
    setup_commands = [["direnv", "allow", "."]]
    validation_command = scherzo_ci_validation_command()
    fingerprint = validation_fingerprint()
    if cached_passing_validation(fingerprint) is not None:
        # The working tree is byte-identical to a previously passing run (same
        # base + diff), so the gate result is unchanged; reuse it instead of
        # re-running ~15m of checks. final_validate stays authoritative because
        # it re-runs whenever the fingerprint differs.
        write_validation_result(
            base_revision=base_revision,
            setup_commands=setup_commands,
            validation_command=validation_command,
            status="passed",
            fingerprint=fingerprint,
            cached=True,
        )
        restore_status = restore_execplan_artifacts()
        verdict_restore_status = restore_plan_completion_verdict()
        short = fingerprint[:12] if fingerprint else ""
        print(
            "scherzo-ci validation skipped: working tree unchanged since the last "
            f"passing run (fingerprint {short})",
            flush=True,
        )
        print("FINAL_VALIDATION=passed")
        print("VALIDATION_CACHED=1")
        print(f"EXECPLAN_ARTIFACT_RESTORE_STATUS={restore_status}")
        print(f"PLAN_COMPLETION_VERDICT_RESTORE_STATUS={verdict_restore_status}")
        return
    env = validation_env()
    for command in setup_commands:
        run_and_print(command, failure_code=failure_code, env=env)
    print("$ " + " ".join(shell_display(arg) for arg in validation_command), flush=True)
    proc = run_proc_with_heartbeat(validation_command, env=env)
    print_process_output(proc)
    if proc.returncode != 0:
        write_validation_result(
            base_revision=base_revision,
            setup_commands=setup_commands,
            validation_command=validation_command,
            status="failed",
            exit_code=proc.returncode,
            stdout=proc.stdout,
            stderr=proc.stderr,
            fingerprint=fingerprint,
        )
        restore_status = restore_execplan_artifacts()
        verdict_restore_status = restore_plan_completion_verdict()
        print("FINAL_VALIDATION=failed")
        print(f"VALIDATION_RESULT_PATH={VALIDATION_PATH}")
        print(f"EXECPLAN_ARTIFACT_RESTORE_STATUS={restore_status}")
        print(f"PLAN_COMPLETION_VERDICT_RESTORE_STATUS={verdict_restore_status}")
        summary = validation_failure_summary(proc.stdout, proc.stderr)
        fail(
            f"command failed with exit code {proc.returncode}: {' '.join(validation_command)}"
            f"\nStructured validation artifact: {VALIDATION_PATH}"
            + ("\nFailure summary:\n" + summary if summary else ""),
            failure_code=failure_code,
        )
    write_validation_result(
        base_revision=base_revision,
        setup_commands=setup_commands,
        validation_command=validation_command,
        status="passed",
        fingerprint=fingerprint,
    )
    restore_status = restore_execplan_artifacts()
    verdict_restore_status = restore_plan_completion_verdict()
    print("FINAL_VALIDATION=passed")
    print(f"EXECPLAN_ARTIFACT_RESTORE_STATUS={restore_status}")
    print(f"PLAN_COMPLETION_VERDICT_RESTORE_STATUS={verdict_restore_status}")


def ensure_validation_passed() -> None:
    if not VALIDATION_PATH.exists():
        fail(f"missing {VALIDATION_PATH}; run validate before publish")
    validation = json.loads(VALIDATION_PATH.read_text())
    if validation.get("status") != "passed":
        fail("final validation did not pass; run validate before publish")


def metadata_field(metadata: dict[str, Any], *keys: str) -> str:
    for key in keys:
        value = str(metadata.get(key) or "").strip()
        if value:
            return value
    return ""


def implementation_issue_identifier(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "implementation_issue_identifier", "issue_identifier")


def implementation_issue_title(metadata: dict[str, Any], fallback: str = "") -> str:
    return metadata_field(metadata, "implementation_issue_title", "issue_title") or fallback


def implementation_issue_url(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "implementation_issue_url", "issue_url")


def source_issue_identifier(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_identifier")


def source_issue_title(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_title")


def source_issue_url(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_url")


def ticket_slug(metadata: dict[str, Any]) -> str:
    identifier = sanitize_ref_part(metadata.get("issue_identifier") or "")
    title = sanitize_ref_part(metadata.get("issue_title") or "")
    value = "-".join(part for part in [identifier, title] if part)
    return value[:60].strip("-") or "ticket"


def execplan_implementation_slug(metadata: dict[str, Any]) -> str:
    # Linear's GitHub integration is most reliable when the implementation
    # issue key appears in the branch name. Avoid deriving ExecPlan
    # implementation branches from the source plan filename because those
    # filenames often contain the planning ticket key instead.
    identifier = sanitize_ref_part(implementation_issue_identifier(metadata))
    title = sanitize_ref_part(implementation_issue_title(metadata))
    value = "-".join(part for part in [identifier, title] if part)
    if value:
        return value[:60].strip("-") or "execplan-implementation"
    plan_path = metadata["plan_path"]
    return sanitize_ref_part(Path(plan_path).stem)[:60] or "plan"


def implementation_subject(title: str, fallback: str) -> str:
    value = (title or fallback).strip()
    for pattern in [r"(?i)^implement\s+plan\s*:\s*", r"(?i)^implement\s*:\s*"]:
        stripped = re.sub(pattern, "", value, count=1).strip()
        if stripped != value:
            return stripped or value
    return value or fallback


def format_issue_line(issue_identifier: str, issue_title: str, issue_url: str) -> str:
    if issue_identifier and issue_title and issue_url:
        return f"Task: [{issue_identifier}: {issue_title}]({issue_url})"
    if issue_identifier and issue_title:
        return f"Task: {issue_identifier}: {issue_title}"
    if issue_identifier:
        return f"Task: {issue_identifier}"
    return "Task: Linear issue"


def current_validation_result() -> dict[str, Any]:
    if not VALIDATION_PATH.exists():
        fail(f"missing {VALIDATION_PATH}; run validate before publish")
    return json.loads(VALIDATION_PATH.read_text())


def validation_commands_from_result(validation: dict[str, Any]) -> list[str]:
    commands = validation.get("commands")
    if not isinstance(commands, list):
        return []
    return [str(command).strip() for command in commands if str(command).strip()]


def validation_body_section() -> str:
    validation = current_validation_result()
    commands = validation_commands_from_result(validation)
    if not commands:
        commands = [" ".join(scherzo_ci_validation_command())]
    label = "Validation completed before publication"
    if not commands:
        return label + ".\n\n"
    lines = [label + ":", ""]
    lines.extend(f"- `{command}`" for command in commands)
    lines.append("")
    return "\n".join(lines) + "\n"


def execplan_plan_display_path(metadata: dict[str, Any]) -> str:
    for key in ["review_surface_path", "legacy_review_doc_path", "plan_artifact_ref", "plan_path"]:
        value = str(metadata.get(key) or "").strip()
        if value:
            return value
    return "unknown"


def execplan_source_issue_line(metadata: dict[str, Any]) -> str:
    identifier = source_issue_identifier(metadata)
    title = source_issue_title(metadata)
    url = source_issue_url(metadata)
    if not identifier and not title and not url:
        return ""
    return format_issue_line(identifier, title, url).replace(
        "Task:",
        "Source ExecPlan issue:",
        1,
    )


def execplan_publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str]:
    plan_path = metadata["plan_path"]
    issue_identifier = implementation_issue_identifier(metadata)
    issue_title = implementation_issue_title(metadata, plan_title(plan_path))
    issue_url = implementation_issue_url(metadata)
    slug = execplan_implementation_slug(metadata)
    branch_prefix = "scherzo/execplan-implementation"
    description = f"feat: implement {sanitize_ref_part(issue_identifier) or slug}"
    subject = implementation_subject(issue_title, plan_title(plan_path))
    pr_title = (
        f"Implement {issue_identifier}: {subject}"
        if issue_identifier
        else subject if subject.lower().startswith("implement")
        else "Implement: " + subject
    )
    source_line = execplan_source_issue_line(metadata)
    if source_line:
        source_line += "\n\n"
    body = (
        "Implements an implementation handoff task through Scherzo's "
        "`workflow:execplan-implementation` dogfood workflow. Linear and "
        "GitHub linkage target the implementation task; the ExecPlan source "
        "issue is listed separately when available.\n\n"
        f"{format_issue_line(issue_identifier, issue_title, issue_url)}\n\n"
        f"{source_line}"
        f"Source ExecPlan plan: `{execplan_plan_display_path(metadata)}`\n\n"
        + validation_body_section()
        + "This PR is ready for human acceptance.\n"
    )
    return branch_prefix, description, pr_title, body


def ticket_publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str]:
    slug = ticket_slug(metadata)
    issue_identifier = metadata.get("issue_identifier") or "task"
    issue_title = metadata.get("issue_title") or "Untitled"
    issue_url = metadata.get("issue_url") or ""
    branch_prefix = "scherzo/implementation"
    description = f"feat: implement {sanitize_ref_part(issue_identifier) or slug}"
    pr_title = f"Implement {issue_identifier}: {issue_title}"
    task_line = format_issue_line(issue_identifier, issue_title, issue_url)
    body = (
        "Implements a task through Scherzo's `workflow:implementation` dogfood workflow. The source task is fetched from Linear today.\n\n"
        f"{task_line}\n\n"
        "Source: task title, description, labels, and recent comments fetched from Linear. No ExecPlan is required for this workflow.\n\n"
        + validation_body_section()
        + "This PR is ready for human acceptance.\n"
    )
    return branch_prefix, description, pr_title, body


def publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str, str, str]:
    source_kind = metadata.get("source_kind")
    if not source_kind:
        fail(f"missing source_kind in {METADATA_PATH}; run prepare first")
    if source_kind == "ticket":
        branch_prefix, description, pr_title, body = ticket_publish_values(metadata)
        slug = ticket_slug(metadata)
    elif source_kind == "execplan":
        branch_prefix, description, pr_title, body = execplan_publish_values(metadata)
        slug = execplan_implementation_slug(metadata)
    else:
        fail(f"unknown source_kind in {METADATA_PATH}: {source_kind}")
    return source_kind, branch_prefix, slug, description, pr_title, body


def add_publish_issue_identity_fields(
    publish: dict[str, Any], metadata: dict[str, Any], source_kind: str
) -> None:
    if source_kind == "execplan":
        implementation_identifier = implementation_issue_identifier(metadata)
        publish["issue_identifier"] = implementation_identifier
        publish["implementation_issue_identifier"] = implementation_identifier
        publish["implementation_issue_title"] = implementation_issue_title(metadata)
        publish["implementation_issue_url"] = implementation_issue_url(metadata)
        publish["source_issue_identifier"] = source_issue_identifier(metadata)
        publish["source_issue_title"] = source_issue_title(metadata)
        publish["source_issue_url"] = source_issue_url(metadata)
    else:
        publish["issue_identifier"] = metadata.get("issue_identifier") or ""



def write_publish_metadata_files(pr_title: str, body: str) -> tuple[Path, Path, bool]:
    body, repair_summary_included = append_base_drift_repair_summary(body)
    title_path = TMP_DIR / "scherzo-implementation-pr-title.txt"
    title_path.parent.mkdir(parents=True, exist_ok=True)
    title_path.write_text(pr_title.strip() + "\n")
    PR_BODY_PATH.write_text(body)
    return title_path, PR_BODY_PATH, repair_summary_included


def materialize_commit_stack_artifact(
    *,
    repository: str,
    base_ref: str,
    base_revision: str,
    description_title: str,
) -> dict[str, Any]:
    try:
        return commit_stack_helper.materialize_commit_stack_artifact(
            repository=repository,
            base_ref=base_ref,
            base_revision=base_revision,
            output_path=COMMIT_STACK_PATH,
            carrier_name=COMMIT_STACK_CARRIER_NAME,
            description_title=description_title,
            bundle_ref_namespace="commit-stack",
            tmp_dir=TMP_DIR,
        )
    except commit_stack_helper.CommitStackError as exc:
        fail(exc.message, failure_code=exc.code)


def publish_command() -> None:
    if not workspace_driver_available():
        workspace_driver_missing(failure_code="workspace_driver_unavailable")

    pr_draft_setting()
    require_command("jj")
    ensure_validation_passed()
    metadata = load_implementation_metadata()
    base, _remote = configured_publish_base()
    refresh = driver_refresh_result("publish")
    write_refresh_base_result(refresh)
    refresh_status = str(refresh.get("status") or "")
    if refresh_status == "conflicts":
        publish_blocked_after_refresh(refresh, failure_code="publish_rebase_conflict")
    if refresh_status == "rebase_failed":
        publish_blocked_after_refresh(refresh, failure_code="publish_rebase_conflict")
    if refresh_status in {"fetch_failed", "base_not_found"}:
        publish_blocked_after_refresh(refresh, failure_code="base_refresh_conflict")
    refresh_exit_code = refresh.get("exit_code")
    if refresh_exit_code not in {0, None}:
        message = str(refresh.get("message") or refresh_status or "refresh-base failed")
        fail(
            "workspace driver refresh-base failed before publication: "
            f"{refresh_status or '<empty>'}\n{message}",
            failure_code=str(refresh.get("failure_code") or "workspace_driver_refresh_base_failed"),
        )
    if refresh_status not in {"fresh", "rebased_clean"}:
        message = str(refresh.get("message") or refresh_status or "refresh-base failed")
        fail(
            "workspace driver refresh-base returned a non-publishable status before publication: "
            f"{refresh_status or '<empty>'}\n{message}",
            failure_code=str(refresh.get("failure_code") or "workspace_driver_refresh_base_failed"),
        )

    base_revision = str(refresh.get("base_revision") or base)
    if refresh_status == "rebased_clean":
        print("")
        print("## Revalidation after publish-base normalization")
        try:
            validate_command(failure_code="publish_revalidation_failed")
            ensure_validation_passed()
        except SystemExit:
            print("PUBLISH_BLOCKED=true")
            print("PUBLISH_BLOCKED_REASON=base drift after final validation")
            raise

    source_kind, _branch_prefix, _slug, _description, pr_title, body = publish_values(metadata)
    files = workspace_driver_changed_files()
    if not files:
        fail("refusing to publish because no changed files were found")

    title_path, body_path, repair_summary_included = write_publish_metadata_files(
        pr_title,
        body,
    )
    repository = default_repo(configured_publication_remote())
    commit_stack = materialize_commit_stack_artifact(
        repository=repository,
        base_ref=base,
        base_revision=base_revision,
        description_title=pr_title,
    )

    publish = {
        "source_kind": source_kind,
        "status": "ready_for_core_publication",
        "publication_mode": "commit_stack",
        "publication_orchestrator": "scherzo_core",
        "changed_files": files,
        "publish_base_revision": base_revision,
        "base_revision": base_revision,
        "branch": "pending-core-publication",
        "head_revision": commit_stack["head"]["sha"],
        "base_drift_repair_summary_included": repair_summary_included,
        "pr_title_path": str(title_path),
        "pr_body_path": str(body_path),
        "commit_stack_path": str(COMMIT_STACK_PATH),
        "commit_stack_head_revision": commit_stack["head"]["sha"],
        "commit_stack_base_revision": commit_stack["base"]["sha"],
    }
    if repair_summary_included:
        publish["base_drift_repair_summary_path"] = str(BASE_DRIFT_REPAIR_SUMMARY_PATH)
    if source_kind == "execplan":
        publish["plan_path"] = metadata["plan_path"]
    add_publish_issue_identity_fields(publish, metadata, source_kind)
    write_json(PUBLISH_PATH, publish)

    print("## Summary")
    if source_kind == "execplan":
        print(
            f"Implemented `{metadata['plan_path']}` and prepared the result for Scherzo core publication."
        )
    else:
        issue_identifier = metadata.get("issue_identifier") or "task"
        issue_title = metadata.get("issue_title") or "Untitled"
        print(
            f"Implemented task `{issue_identifier}: {issue_title}` and prepared the result for Scherzo core publication."
        )
    print("")
    print("## Publication")
    print("PUBLICATION_MODE=commit_stack")
    print("PUBLICATION_ORCHESTRATOR=scherzo_core")
    print(f"COMMIT_STACK_PATH={COMMIT_STACK_PATH}")
    print(f"PR_TITLE_PATH={title_path}")
    print(f"PR_BODY_PATH={body_path}")
    print("PR_URL will be reported by Scherzo core after declarative publication completes.")
    print("")
    print("## Validation")
    validation = current_validation_result()
    validation_commands = validation_commands_from_result(validation)
    if not validation_commands:
        validation_commands = [" ".join(scherzo_ci_validation_command())]
    for command in validation_commands:
        print(f"- `{command}`: passed")
    print("")
    print("## Changed files")
    for file in files:
        print(f"- `{file}`")


def languages_command(args: list[str]) -> None:
    if len(args) != 1:
        usage()
        sys.exit(2)
    files = clean_lines(Path(args[0]).read_text())
    languages, supported_files, unsupported_files = detect_languages(files)
    print("LANGUAGES=" + comma_join(languages))
    print_list("SUPPORTED_REVIEW_FILES", supported_files)
    print_list("UNSUPPORTED_REVIEW_FILES", unsupported_files)
    print_list("REVIEW_COMMANDS", review_commands(languages))


def ticket_brief_command(args: list[str]) -> None:
    if len(args) != 1:
        usage()
        sys.exit(2)
    issue = json.loads(Path(args[0]).read_text())
    print(render_ticket_brief(issue), end="")


def main(argv: list[str]) -> None:
    command = argv[1] if len(argv) > 1 else ""
    args = argv[2:]
    if command == "prepare":
        prepare_command(args)
    elif command == "refresh-base":
        refresh_base_command(args)
    elif command == "analyze" and not args:
        analyze_command()
    elif command == "restore-execplan-artifacts":
        restore_execplan_artifacts_command(args)
    elif command == "plan-completion-context":
        plan_completion_context_command(args)
    elif command == "checkpoint-plan-completion-verdict":
        checkpoint_plan_completion_verdict_command(args)
    elif command == "gate-plan-completion":
        gate_plan_completion_command(args)
    elif command == "plan-completion-recovery":
        plan_completion_recovery_command(args)
    elif command == "assert-base-drift-repair":
        assert_base_drift_repair_command(args)
    elif command == "validate" and not args:
        validate_command()
    elif command == "publish" and not args:
        publish_command()
    elif command == "plan-brief":
        plan_brief_command(args)
    elif command == "languages":
        languages_command(args)
    elif command == "ticket-brief":
        ticket_brief_command(args)
    elif command in {"-h", "--help", "help"}:
        usage()
    else:
        usage()
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
