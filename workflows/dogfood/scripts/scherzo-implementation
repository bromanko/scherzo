#!/usr/bin/env python3
"""Shared helpers for Scherzo implementation workflows.

The checked-in dogfood workflows have two implementation contracts:

* workflow:implementation implements directly from task context fetched from Linear.
* workflow:execplan-implementation implements a retained ExecPlan bundle
  prepared by scripts/scherzo-execplan.

This helper keeps the common mechanics in one place: fetching source context,
recording the starting jj parent, retaining failed run workspaces until a PR is
published, detecting changed file languages across the full workflow history,
running final validation, and materializing declarative commit_stack publication artifacts.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import traceback
import urllib.request
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

from scherzo_workflow import commit_stack as commit_stack_helper
from scherzo_workflow import errors as workflow_errors
from scherzo_workflow import json_io as workflow_json
from scherzo_workflow import process as workflow_process
from scherzo_workflow import workspace_driver as workflow_workspace_driver

TMP_DIR = Path("tmp")
METADATA_PATH = TMP_DIR / "scherzo-implementation.json"
CANONICAL_METADATA_RELATIVE_PATH = Path("state") / "implementation" / "metadata.json"
CANONICAL_IMPLEMENTATION_STATE_RELATIVE_DIR = Path("state") / "implementation"
CANONICAL_PLAN_COMPLETION_CONTEXT_NAME = "scherzo-plan-completion-context.json"
CANONICAL_PLAN_COMPLETION_VERDICT_NAME = "scherzo-plan-completion-verdict.json"
CANONICAL_IMPLEMENTATION_COMPLETION_DIAGNOSTIC_NAME = (
    "scherzo-implementation-completion-diagnostic.json"
)
# Legacy compatibility surface for retained workspaces from the pre-step-recovery
# topology. Checked-in workflows no longer call the old helper directly.
CANONICAL_PLAN_COMPLETION_RECOVERY_NAME = "scherzo-plan-completion-recovery.json"
CANONICAL_VALIDATION_NAME = "scherzo-implementation-validation.json"
CANONICAL_PUBLISH_NAME = "scherzo-implementation-publish.json"
CANONICAL_COMMIT_STACK_NAME = "scherzo-implementation-commit-stack.json"
ANALYSIS_PATH = TMP_DIR / "scherzo-implementation-analysis.json"
PLAN_COMPLETION_CONTEXT_PATH = TMP_DIR / "scherzo-plan-completion-context.json"
PLAN_COMPLETION_VERDICT_PATH = TMP_DIR / "scherzo-plan-completion-verdict.json"
PLAN_COMPLETION_RECOVERY_PATH = TMP_DIR / "scherzo-plan-completion-recovery.json"
PLAN_COMPLETION_RECOVERY_SUMMARY_PATH = TMP_DIR / "scherzo-plan-completion-recovery.md"
VALIDATION_PATH = TMP_DIR / "scherzo-implementation-validation.json"
PUBLISH_PATH = TMP_DIR / "scherzo-implementation-publish.json"
COMMIT_STACK_PATH = TMP_DIR / "scherzo-implementation-commit-stack.json"
COMMIT_STACK_CARRIER_NAME = "commit_stack.bundle"
TICKET_BRIEF_PATH = TMP_DIR / "scherzo-implementation-brief.md"
PLAN_BRIEF_PATH = TMP_DIR / "scherzo-execplan-brief.md"
PLAN_INDEX_PATH = TMP_DIR / "scherzo-execplan-index.json"
PR_BODY_PATH = TMP_DIR / "scherzo-implementation-pr-body.md"
BASE_REFRESH_LATEST_PATH = TMP_DIR / "scherzo-implementation-refresh-base-latest.json"
BASE_DRIFT_REPAIR_SUMMARY_PATH = TMP_DIR / "scherzo-implementation-base-drift-repair.md"
BASE_DRIFT_REPAIR_FAILURE_PATH = TMP_DIR / "scherzo-implementation-base-drift-failure.md"
RETENTION_MARKER = ".scherzo-keep-workspace"
REFRESH_STAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
JJ_CONFLICT_STATUS_RE = re.compile(r"\s+\d+-sided conflict(?:\s+.*)?$")
COMMAND_DIAGNOSTIC_MAX_CHARS = 3500
VALIDATION_RESULT_EXCERPT_MAX_CHARS = 4000
VALIDATION_FAILURE_SUMMARY_MAX_CHARS = 2500
ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def usage() -> None:
    print(
        """Usage: scherzo-implementation <prepare|refresh-base|refresh-base-and-validate|analyze|gate-implementation-completion|plan-completion-context|checkpoint-plan-completion-verdict|gate-plan-completion|plan-completion-recovery|assert-base-drift-repair|validate|publish|plan-brief|languages|ticket-brief>


Run from a Scherzo jj workflow workspace root.

prepare --source ticket
              Fetch the Linear-backed source task, write a task-context brief
              under tmp/, record the starting jj parent, and mark the run for
              retention until a PR is safely published.
analyze       Diff from the recorded starting parent to @, detect review-
              relevant languages/files, and print review metadata.
gate-implementation-completion [--submission PATH]
              Validate the broad ExecPlan implementation agent's completion
              submission against the workflow-baseline changed-file manifest.
              Forward partial unblocked work to semantic verification, while
              rejecting blocked, no-op, or invalid-evidence submissions.
plan-completion-context
              Write and print the current ExecPlan implementation patch
              context for diagnostics. Checkpoint/gate commands stamp these
              values into verdict artifacts; verifiers must not transcribe them.
checkpoint-plan-completion-verdict [--submission PATH | --submission-step STEP [--submission-artifact ARTIFACT] [--artifact-dir DIR]]
              Materialize a structured-output plan-completion semantic
              submission by stamping current workspace context, or validate the
              existing run-root canonical plan-completion verdict.
plan-brief [--check|--refresh-if-stale]
              Regenerate, check, or refresh the derived ExecPlan brief and JSON
              index recorded in run-root implementation metadata.
gate-plan-completion [--final]
              Fail closed unless the run-root canonical plan-completion verdict
              is fresh, well-formed, and passing for the current ExecPlan
              implementation patch.
gate-plan-completion --from-submission [--submission PATH]
              Read a structured-output plan-completion semantic submission from
              stdin (or PATH for manual verification), stamp the current
              workspace plan/change/diff fingerprint fields, write the
              canonical verdict artifact, and fail only for a fail verdict or
              workspace mismatch.
plan-completion-recovery --phase before-late-repair|before-final-repair|after-late-repair|after-final-repair|final --attempt INT --max-attempts INT
              Legacy compatibility helper for retained pre-step-recovery runs.
              Classify the current plan-completion verdict, write
              tmp/scherzo-plan-completion-recovery.{json,md}, and either
              authorize one bounded repair pass or fail with retained
              workspace diagnostics.
refresh-base --stage <stage>
              Fetch the canonical jj workspace base, rebase @ when needed,
              and write structured base-refresh JSON under tmp/.
refresh-base-and-validate --stage <stage>
              Run refresh-base, then run final validation only when the
              refresh result is fresh or rebased_clean. Write the same refresh
              and validation artifacts used by recovery prompts.
assert-base-drift-repair
              Legacy compatibility helper for retained pre-step-recovery runs.
              Fail closed when the bounded base-drift repair worker wrote a
              nonrepairable failure marker; otherwise report that final
              validation may proceed.
validate      Run the final direnv-backed scripts/scherzo-ci gate.
publish       Normalize and validate the final change, then materialize the
              commit_stack and PR metadata consumed by Scherzo core's
              declarative same-repo publication route.

Test helpers:
languages <file-list>
              Detect review-relevant languages from a newline-separated list.
ticket-brief <issue-json>
              Render a task-context Markdown brief from a saved Linear issue
              JSON object and print it to stdout. This helper is Linear-only.
""",
        file=sys.stderr,
    )


def fail(message: str, *, failure_code: str | None = None, exit_code: int = 1) -> None:
    workflow_errors.exit_with_failure(
        "scherzo-implementation",
        message,
        code=failure_code,
        exit_code=exit_code,
    )


def diagnostic_excerpt(value: str, max_chars: int = COMMAND_DIAGNOSTIC_MAX_CHARS) -> str:
    return workflow_process.diagnostic_excerpt(value, max_chars)


def subprocess_failure_details(stdout: str, stderr: str, returncode: int) -> str:
    return workflow_process.subprocess_failure_details(stdout, stderr, returncode)


def run_proc(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return workflow_process.run_proc(args, env=env)


def run_proc_with_heartbeat(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
    heartbeat_seconds: int = 60,
) -> subprocess.CompletedProcess[str]:
    return workflow_process.run_proc_with_heartbeat(
        args,
        env=env,
        heartbeat_seconds=heartbeat_seconds,
        label="scherzo-implementation",
    )


def run(
    args: list[str],
    *,
    check: bool = True,
    failure_code: str | None = None,
    env: dict[str, str] | None = None,
) -> str:
    proc = run_proc(args, env=env)
    if check and proc.returncode != 0:
        details = subprocess_failure_details(proc.stdout, proc.stderr, proc.returncode)
        fail(f"command failed: {' '.join(args)}\n{details}", failure_code=failure_code)
    return proc.stdout


def print_process_output(proc: subprocess.CompletedProcess[str]) -> None:
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)


def workspace_driver_command() -> str | None:
    return workflow_workspace_driver.command()


def workspace_driver_available() -> bool:
    return workflow_workspace_driver.available()


def pr_draft_setting() -> bool | None:
    value = os.environ.get("SCHERZO_PR_DRAFT")
    if value is None:
        return None
    value = value.strip()
    if not value:
        return None
    if value == "true":
        return True
    if value == "false":
        return False
    fail(
        "SCHERZO_PR_DRAFT must be true or false",
        failure_code="invalid_configuration",
    )


def workspace_driver_missing(*, failure_code: str = "workspace_driver_unavailable") -> None:
    fail(
        "SCHERZO_WORKSPACE_DRIVER is required for this driver-backed workflow operation",
        failure_code=failure_code,
    )


def run_workspace_driver_json(
    args: list[str],
    *,
    check: bool = True,
    failure_code: str = "workspace_driver_failed",
) -> tuple[dict[str, Any], subprocess.CompletedProcess[str]]:
    try:
        return workflow_workspace_driver.run_json(
            args,
            check=check,
            failure_code=failure_code,
        )
    except workflow_workspace_driver.WorkspaceDriverError as exc:
        fail(str(exc), failure_code=exc.code)


def workspace_driver_changed_file_records() -> list[dict[str, str]]:
    payload, _ = run_workspace_driver_json(
        ["changed-files", "--json"],
        failure_code="workspace_driver_changed_files_failed",
    )
    try:
        records = workflow_workspace_driver.changed_file_records(
            payload,
            validate_status=True,
        )
    except workflow_workspace_driver.WorkspaceDriverError as exc:
        fail(str(exc), failure_code=exc.code)
    return sorted(records, key=lambda record: record["path"])


def workspace_driver_changed_files() -> list[str]:
    return [record["path"] for record in workspace_driver_changed_file_records()]


def workspace_driver_diff_text() -> str:
    payload, _ = run_workspace_driver_json(
        ["diff", "--json"],
        failure_code="workspace_driver_diff_failed",
    )
    try:
        return workflow_workspace_driver.diff_text(payload)
    except workflow_workspace_driver.WorkspaceDriverError as exc:
        fail(str(exc), failure_code=exc.code)


def workspace_driver_baseline() -> dict[str, Any]:
    payload, _ = run_workspace_driver_json(
        ["baseline", "--json"],
        failure_code="workspace_driver_baseline_failed",
    )
    for key in ["baseline_id", "workspace_revision_id", "change_id"]:
        if not isinstance(payload.get(key), str) or not str(payload.get(key)).strip():
            fail(
                f"workspace driver baseline JSON missing non-empty {key}",
                failure_code="workspace_driver_baseline_failed",
            )
    if not isinstance(payload.get("dirty"), bool):
        fail(
            "workspace driver baseline JSON missing boolean dirty",
            failure_code="workspace_driver_baseline_failed",
        )
    return payload


def run_and_print(
    args: list[str],
    *,
    failure_code: str | None = None,
    env: dict[str, str] | None = None,
) -> None:
    print("$ " + " ".join(shell_display(arg) for arg in args), flush=True)
    proc = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    print_process_output(proc)
    if proc.returncode != 0:
        fail(
            f"command failed with exit code {proc.returncode}: {' '.join(args)}",
            failure_code=failure_code,
        )


def strip_ansi(value: str) -> str:
    return ANSI_ESCAPE_RE.sub("", value)


def is_progress_noise_line(line: str) -> bool:
    stripped = line.strip()
    if len(stripped) < 120:
        return False
    dot_count = stripped.count(".")
    return dot_count * 2 > len(stripped)


def validation_failure_summary(stdout: str, stderr: str) -> str:
    combined = "\n".join(part for part in [stdout, stderr] if part)
    lines = [strip_ansi(line).rstrip() for line in combined.splitlines()]
    interesting: set[int] = set()
    for index, line in enumerate(lines):
        lower = line.lower()
        stripped_lower = lower.lstrip()
        stripped = line.lstrip()
        is_interesting = (
            "❌ failed" in line
            or "hash mismatch" in lower
            or "fixed-output derivation" in lower
            or stripped_lower.startswith("error:")
            or stripped_lower.startswith("error ")
            or stripped.startswith("Error:")
            or "check command failed" in lower
            or "failed with error" in lower
            or stripped_lower.startswith("specified:")
            or stripped_lower.startswith("got:")
        )
        if is_interesting:
            for nearby in range(max(0, index - 1), min(len(lines), index + 4)):
                interesting.add(nearby)

    summary_lines: list[str] = []
    for index in sorted(interesting):
        line = lines[index].strip()
        if (
            line
            and not is_progress_noise_line(line)
            and (not summary_lines or summary_lines[-1] != line)
        ):
            summary_lines.append(line)
        if len(summary_lines) >= 24:
            break

    if not summary_lines:
        summary_lines = [line.strip() for line in lines if line.strip()][-24:]

    return diagnostic_excerpt(
        "\n".join(summary_lines), VALIDATION_FAILURE_SUMMARY_MAX_CHARS
    )


def shell_display(value: str) -> str:
    return workflow_process.shell_display(value)


def command_exists(name: str) -> bool:
    return workflow_process.command_exists(name)


def require_command(name: str) -> None:
    try:
        workflow_process.require_command(name)
    except workflow_process.ProcessError as exc:
        fail(str(exc))


def load_json(path: Path) -> dict[str, Any]:
    if not path.exists():
        fail(f"missing {path}; run prepare first")
    try:
        return workflow_json.load_json(path)
    except workflow_json.JsonIoError as exc:
        fail(str(exc))


def write_json(path: Path, value: Any) -> None:
    workflow_json.write_json(path, value)


def canonical_metadata_path() -> Path | None:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return None
    return Path(run_root) / CANONICAL_METADATA_RELATIVE_PATH


def canonical_implementation_state_path(name: str) -> Path | None:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return None
    return Path(run_root) / CANONICAL_IMPLEMENTATION_STATE_RELATIVE_DIR / name


def implementation_state_relative_path(name: str) -> Path:
    return CANONICAL_IMPLEMENTATION_STATE_RELATIVE_DIR / name


def path_under_run_root(path: Path) -> bool:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return False
    try:
        path.resolve(strict=False).relative_to(Path(run_root).resolve(strict=False))
        return True
    except (OSError, ValueError):
        return False


def display_path(path: Path) -> str:
    if not path.is_absolute():
        return path.as_posix()
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if run_root:
        try:
            return path.resolve(strict=False).relative_to(Path(run_root).resolve(strict=False)).as_posix()
        except (OSError, ValueError):
            pass
    return path.as_posix()


def resolve_run_root_relative_path(path: Path) -> Path:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if run_root and not path.is_absolute():
        if path.parts[:1] == ("state",):
            return Path(run_root) / path
        if (
            len(path.parts) >= 3
            and path.parts[0] == "workspaces"
            and path.parts[2] == "state"
        ):
            return Path(run_root).joinpath(*path.parts[2:])
    return path


def state_backed_path(tmp_path: Path, state_name: str) -> Path:
    canonical_path = canonical_implementation_state_path(state_name)
    return canonical_path or tmp_path


def copy_best_effort(source: Path, destination: Path) -> None:
    try:
        if source.resolve(strict=False) == destination.resolve(strict=False):
            return
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(source.read_bytes())
    except OSError:
        pass


def write_state_backed_json(tmp_path: Path, state_name: str, value: Any) -> Path:
    primary = state_backed_path(tmp_path, state_name)
    try:
        write_json(primary, value)
    except OSError:
        write_json(tmp_path, value)
        return tmp_path
    if primary != tmp_path:
        copy_best_effort(primary, tmp_path)
    return primary


def load_state_backed_json(tmp_path: Path, state_name: str, *, missing_message: str) -> dict[str, Any]:
    primary = state_backed_path(tmp_path, state_name)
    if primary.exists():
        data = load_json(primary)
        if primary != tmp_path:
            copy_best_effort(primary, tmp_path)
        return data
    if primary != tmp_path and tmp_path.exists():
        data = load_json(tmp_path)
        try:
            write_json(primary, data)
        except OSError:
            pass
        return data
    fail(missing_message)


def metadata_missing_message(canonical_path: Path) -> str:
    return (
        "unrecoverable workflow-state loss: missing implementation metadata in "
        f"canonical run state ({canonical_path}) and compatibility cache "
        f"({METADATA_PATH}). Restore "
        f"{CANONICAL_METADATA_RELATIVE_PATH} from retained run artifacts or "
        "abort and restart from a clean baseline; do not rerun prepare after "
        "implementation because that would overwrite the original workflow "
        "source and base metadata."
    )


def print_metadata_backfill_diagnostic(canonical_path: Path) -> None:
    print(
        "scherzo-implementation: backfilled canonical implementation metadata "
        f"from {METADATA_PATH} to {canonical_path} "
        f"({CANONICAL_METADATA_RELATIVE_PATH})",
        file=sys.stderr,
    )


def load_implementation_metadata() -> dict[str, Any]:
    canonical_path = canonical_metadata_path()
    if canonical_path is None:
        return load_json(METADATA_PATH)

    if canonical_path.exists():
        try:
            metadata = load_json(canonical_path)
        except json.JSONDecodeError as exc:
            fail(f"invalid canonical implementation metadata at {canonical_path}: {exc}")
        write_json(METADATA_PATH, metadata)
        return metadata

    if METADATA_PATH.exists():
        metadata = load_json(METADATA_PATH)
        try:
            write_json(canonical_path, metadata)
            print_metadata_backfill_diagnostic(canonical_path)
        except OSError:
            pass
        return metadata

    fail(metadata_missing_message(canonical_path))


def write_implementation_metadata(metadata: dict[str, Any]) -> None:
    canonical_path = canonical_metadata_path()
    if canonical_path is not None:
        try:
            write_json(canonical_path, metadata)
        except OSError:
            pass
    write_json(METADATA_PATH, metadata)


def infer_issue_identifier() -> str:
    explicit = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if explicit:
        return explicit

    cwd = str(Path.cwd())
    marker = "/.scherzo/workspaces/"
    if marker in cwd:
        tail = cwd.split(marker, 1)[1]
        parts = tail.split("/")
        # .scherzo/workspaces/<workflow>/<issue>/<run>/<workspace>
        if len(parts) >= 2 and parts[1]:
            return parts[1]

    fail(
        "could not infer Linear issue identifier from cwd; set "
        "SCHERZO_ISSUE_IDENTIFIER"
    )


def linear_graphql(query: str, variables: dict[str, Any]) -> dict[str, Any]:
    fixture_path = os.environ.get("SCHERZO_TEST_LINEAR_GRAPHQL_JSON", "").strip()
    if fixture_path:
        try:
            response = json.loads(Path(fixture_path).read_text())
        except (OSError, json.JSONDecodeError) as exc:
            fail(f"could not read SCHERZO_TEST_LINEAR_GRAPHQL_JSON fixture: {exc}")
        if response.get("errors"):
            fail(
                "Linear GraphQL fixture returned errors:\n"
                + diagnostic_excerpt(json.dumps(response["errors"], indent=2))
            )
        data = response.get("data")
        if not isinstance(data, dict):
            fail("SCHERZO_TEST_LINEAR_GRAPHQL_JSON fixture must contain a data object")
        return data

    token = os.environ.get("LINEAR_API_KEY", "").strip()
    if not token:
        fail("LINEAR_API_KEY is required to fetch Linear issue context")
    payload = json.dumps({"query": query, "variables": variables}).encode()
    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": token},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            response = json.loads(resp.read())
    except Exception as exc:  # pragma: no cover - defensive CLI boundary
        fail(f"Linear GraphQL request failed: {exc}")
    if response.get("errors"):
        fail(
            "Linear GraphQL returned errors:\n"
            + diagnostic_excerpt(json.dumps(response["errors"], indent=2))
        )
    return response["data"]


def fetch_linear_issue_context(identifier: str) -> dict[str, Any]:
    query = """
    query($id: String!) {
      issue(id: $id) {
        identifier
        title
        description
        url
        priority
        state { name }
        labels(first: 50) {
          nodes { name }
          pageInfo { hasNextPage }
        }
        comments(first: 100) {
          nodes {
            createdAt
            body
            user { name }
          }
          pageInfo { hasNextPage }
        }
      }
    }
    """
    issue = linear_graphql(query, {"id": identifier}).get("issue")
    if not issue:
        fail(f"Linear issue not found: {identifier}")
    return issue


def resolve_prepared_execplan_path(plan_path: str, repo_root: Path) -> Path:
    path = Path(plan_path)
    if ".." in path.parts:
        fail(
            f"invalid prepared ExecPlan path: {plan_path}; "
            "expected a repository- or run-root-relative Markdown path",
            failure_code="execplan_metadata_invalid",
        )
    if path.is_absolute():
        if not path_under_run_root(path):
            fail(
                f"invalid prepared ExecPlan path: {plan_path}; "
                "absolute paths must be inside SCHERZO_RUN_ROOT",
                failure_code="execplan_metadata_invalid",
            )
        resolved = path
    else:
        resolved = resolve_run_root_relative_path(path)
        if resolved == path:
            resolved = repo_root / path
    if path.suffix.lower() != ".md":
        fail(
            f"invalid prepared ExecPlan path: {plan_path}; expected a Markdown path",
            failure_code="execplan_metadata_invalid",
        )
    return resolved


def validate_prepared_execplan_path(plan_path: str, repo_root: Path) -> None:
    resolved = resolve_prepared_execplan_path(plan_path, repo_root)
    if not resolved.is_file():
        fail(
            f"ExecPlan file does not exist: {plan_path}",
            failure_code="execplan_metadata_invalid",
        )


def plan_source_sha256(plan_path: str) -> str:
    try:
        return hashlib.sha256(resolve_prepared_execplan_path(plan_path, Path.cwd()).read_bytes()).hexdigest()
    except OSError as exc:
        fail(f"could not read ExecPlan file {plan_path}: {exc}")


def execplan_brief_helper_path() -> Path:
    override = os.environ.get("SCHERZO_EXECPLAN_BRIEF_HELPER", "").strip()
    if override:
        return Path(override)
    return Path(__file__).resolve().parent / "scherzo-execplan-brief"


def remove_plan_brief_artifacts() -> None:
    for path in [PLAN_BRIEF_PATH, PLAN_INDEX_PATH]:
        try:
            if path.exists():
                path.unlink()
        except OSError:
            pass


def plan_brief_warning(value: str) -> str:
    return re.sub(r"\s+", " ", diagnostic_excerpt(value, 900)).strip()


def generate_plan_brief(plan_path: str) -> dict[str, str]:
    helper = execplan_brief_helper_path()
    proc = run_proc([
        sys.executable or "python3",
        str(helper),
        "brief",
        plan_path,
        str(PLAN_BRIEF_PATH),
        str(PLAN_INDEX_PATH),
    ])
    if proc.returncode != 0:
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: "
            + plan_brief_warning(subprocess_failure_details(proc.stdout, proc.stderr, proc.returncode)),
        }
    try:
        index = json.loads(PLAN_INDEX_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: " + plan_brief_warning(str(exc)),
        }
    source_hash = str(index.get("source_sha256") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{64}", source_hash):
        remove_plan_brief_artifacts()
        return {
            "status": "unavailable",
            "warning": "brief generation failed: JSON index missing lowercase source_sha256",
        }
    return {
        "status": "ok",
        "brief_path": str(PLAN_BRIEF_PATH),
        "index_path": str(PLAN_INDEX_PATH),
        "source_sha256": source_hash,
    }


def apply_plan_brief_result(metadata: dict[str, Any], result: dict[str, str]) -> None:
    for key in [
        "plan_brief_path",
        "plan_index_path",
        "plan_source_sha256",
        "plan_brief_warning",
    ]:
        metadata.pop(key, None)
    if result["status"] == "ok":
        metadata["plan_brief_status"] = "ok"
        metadata["plan_brief_path"] = result["brief_path"]
        metadata["plan_index_path"] = result["index_path"]
        metadata["plan_source_sha256"] = result["source_sha256"]
    else:
        metadata["plan_brief_status"] = "unavailable"
        metadata["plan_brief_warning"] = result.get("warning", "brief generation failed")


def print_plan_brief_result(result: dict[str, str]) -> None:
    if result["status"] == "ok":
        print("PLAN_BRIEF_STATUS=ok")
        print(f"PLAN_BRIEF_PATH={result['brief_path']}")
        print(f"PLAN_INDEX_PATH={result['index_path']}")
        print(f"PLAN_SOURCE_SHA256={result['source_sha256']}")
    else:
        print("PLAN_BRIEF_STATUS=unavailable")
        print(f"PLAN_BRIEF_WARNING={result.get('warning', 'brief generation failed')}")


def current_base_change_id() -> str:
    return run(["jj", "log", "-r", "@-", "--no-graph", "-T", "change_id", "--color=never"]).strip()


def current_change_id_short() -> str:
    return run(["jj", "log", "-r", "@", "--no-graph", "-T", "change_id.short()", "--color=never"]).strip()


def changed_files_since(base_change_id: str) -> list[str]:
    output = run([
        "jj",
        "diff",
        "--from",
        base_change_id,
        "--to",
        "@",
        "--name-only",
        "--color=never",
    ])
    return clean_lines(output)


def revision_commit_ids(revision: str) -> list[str]:
    output = run([
        "jj",
        "log",
        "-r",
        revision,
        "--no-graph",
        "-T",
        "commit_id ++ \"\\n\"",
        "--color=never",
    ])
    return clean_lines(output)


def revision_commit_ids_if_exists(revision: str) -> list[str] | None:
    proc = run_proc([
        "jj",
        "log",
        "-r",
        revision,
        "--no-graph",
        "-T",
        "commit_id ++ \"\\n\"",
        "--color=never",
    ])
    if proc.returncode == 0 and proc.stdout.strip():
        return clean_lines(proc.stdout)
    return None


def current_parent_commit_ids() -> list[str]:
    return revision_commit_ids("@-")


def has_unresolved_conflicts(revision: str) -> bool:
    proc = subprocess.run(
        [
            "jj",
            "log",
            "-r",
            f"conflicts() & ({revision})",
            "--no-graph",
            "-T",
            "change_id.short()",
            "--color=never",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return proc.returncode == 0 and bool(proc.stdout.strip())


def command_display(args: list[str]) -> str:
    return " ".join(args)


def configured_publish_base() -> tuple[str, str]:
    base = os.environ.get("SCHERZO_JJ_WORKSPACE_BASE_BRANCH", "main").strip() or "main"
    remote = os.environ.get("SCHERZO_JJ_WORKSPACE_REMOTE", "origin").strip() or "origin"
    return base, remote


def configured_publication_remote() -> str:
    return os.environ.get("SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE", "origin").strip() or "origin"


def parse_refresh_base_args(args: list[str]) -> str:
    if len(args) != 2 or args[0] != "--stage":
        fail("refresh-base requires exactly: --stage <stage>")
    stage = args[1].strip()
    if stage in {"", ".", ".."} or "/" in stage or "\\" in stage:
        fail(f"invalid refresh-base stage {args[1]!r}; stage must be a safe filename segment")
    if not REFRESH_STAGE_RE.fullmatch(stage):
        fail(
            f"invalid refresh-base stage {args[1]!r}; expected "
            "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        )
    return stage


def refresh_base_json_path(stage: str) -> Path:
    # Re-parse the constructed stage to keep this helper safe when called directly.
    safe_stage = parse_refresh_base_args(["--stage", stage])
    return TMP_DIR / f"scherzo-implementation-refresh-base-{safe_stage}.json"


def fetch_base_result(base: str, remote: str) -> tuple[list[str], subprocess.CompletedProcess[str]]:
    args = ["jj", "git", "fetch", "--remote", remote, "--branch", base]
    return args, run_proc(args)


def resolve_base_revision(base: str, remote: str) -> tuple[str | None, list[str] | None, bool]:
    remote_base = f"{base}@{remote}"
    remote_commits = revision_commit_ids_if_exists(remote_base)
    if remote_commits is not None:
        return remote_base, remote_commits, False
    local_commits = revision_commit_ids_if_exists(base)
    if local_commits is not None:
        print(
            f"warning: remote workspace base {remote_base!r} was not found after fetch; "
            f"falling back to local revision {base!r}",
            file=sys.stderr,
        )
        return base, local_commits, True
    return None, None, False


def normalize_conflict_file_path(value: str) -> str:
    return JJ_CONFLICT_STATUS_RE.sub("", value.strip())


def conflicted_files() -> list[str]:
    proc = run_proc(["jj", "resolve", "--list", "--color=never"])
    if proc.returncode == 0:
        files: list[str] = []
        seen: set[str] = set()
        for line in proc.stdout.splitlines():
            path = normalize_conflict_file_path(line)
            if path and path not in seen:
                files.append(path)
                seen.add(path)
        return sorted(files)
    if "No conflicts found" in proc.stdout or "No conflicts found" in proc.stderr:
        return []
    return []


def has_unresolved_conflicts_at_current_change() -> bool:
    return has_unresolved_conflicts("@")


def refresh_result(
    *,
    stage: str,
    status: str,
    repairable: bool,
    remote: str,
    base: str,
    base_revision: str,
    base_commit_before_fetch: str | None,
    base_commit_after_fetch: str | None,
    parent_commits_before: list[str],
    parent_commits_after: list[str],
    current_change_id: str,
    rebased: bool,
    has_unresolved_conflicts: bool,
    conflicted: list[str],
    message: str,
    commands: list[str],
    fetch_stdout: str = "",
    fetch_stderr: str = "",
    rebase_stdout: str = "",
    rebase_stderr: str = "",
    rebase_exit_code: int | None = None,
) -> dict[str, Any]:
    result: dict[str, Any] = {
        "schema_version": 1,
        "stage": stage,
        "status": status,
        "repairable": repairable,
        "remote": remote,
        "base": base,
        "base_revision": base_revision,
        "base_commit_before_fetch": base_commit_before_fetch,
        "base_commit_after_fetch": base_commit_after_fetch,
        "parent_commits_before": parent_commits_before,
        "parent_commits_after": parent_commits_after,
        "current_change_id": current_change_id,
        "rebased": rebased,
        "has_unresolved_conflicts": has_unresolved_conflicts,
        "conflicted_files": conflicted,
        "metadata_base_change_id_updated": False,
        "message": message,
        "commands": commands,
    }
    if fetch_stdout.strip():
        result["fetch_stdout"] = fetch_stdout
    if fetch_stderr.strip():
        result["fetch_stderr"] = fetch_stderr
    if rebase_stdout.strip():
        result["rebase_stdout"] = rebase_stdout
    if rebase_stderr.strip():
        result["rebase_stderr"] = rebase_stderr
    if rebase_exit_code is not None:
        result["rebase_exit_code"] = rebase_exit_code
    return result


def first_commit_id(commits: list[str] | None) -> str | None:
    if commits:
        return commits[0]
    return None


def refresh_base(stage: str) -> dict[str, Any]:
    base, remote = configured_publish_base()
    remote_base = f"{base}@{remote}"
    commands: list[str] = []
    base_commits_before_fetch = revision_commit_ids_if_exists(remote_base)
    parent_commits_before = current_parent_commit_ids()
    current_change_id = current_change_id_short()

    fetch_args, fetch_proc = fetch_base_result(base, remote)
    commands.append(command_display(fetch_args))
    if fetch_proc.stdout:
        print(fetch_proc.stdout, end="")
    if fetch_proc.stderr:
        print(fetch_proc.stderr, end="", file=sys.stderr)
    if fetch_proc.returncode != 0:
        return refresh_result(
            stage=stage,
            status="fetch_failed",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=remote_base,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=None,
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=has_unresolved_conflicts_at_current_change(),
            conflicted=conflicted_files(),
            message=(
                f"could not fetch jj workspace base {base!r} from remote {remote!r}; "
                "fetch or configure SCHERZO_JJ_WORKSPACE_REMOTE/"
                "SCHERZO_JJ_WORKSPACE_BASE_BRANCH and retry"
            ),
            commands=commands,
            fetch_stdout=fetch_proc.stdout,
            fetch_stderr=fetch_proc.stderr,
        )

    base_revision, base_commits_after_fetch, _used_local_fallback = resolve_base_revision(base, remote)
    if base_revision is None or base_commits_after_fetch is None:
        return refresh_result(
            stage=stage,
            status="base_not_found",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=remote_base,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=None,
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=has_unresolved_conflicts_at_current_change(),
            conflicted=conflicted_files(),
            message=f"could not find publish base revision {remote_base!r} or {base!r}",
            commands=commands,
        )

    existing_conflicts = has_unresolved_conflicts_at_current_change()
    existing_conflicted_files = conflicted_files() if existing_conflicts else []
    if existing_conflicts:
        return refresh_result(
            stage=stage,
            status="conflicts",
            repairable=True,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=True,
            conflicted=existing_conflicted_files,
            message="current change already has unresolved conflicts after fetching publish base",
            commands=commands,
        )

    if len(base_commits_after_fetch) == 1 and parent_commits_before == base_commits_after_fetch:
        return refresh_result(
            stage=stage,
            status="fresh",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=current_parent_commit_ids(),
            current_change_id=current_change_id,
            rebased=False,
            has_unresolved_conflicts=False,
            conflicted=[],
            message="current parent already matches publish base",
            commands=commands,
        )

    if stage == "publish":
        print("## Publish base normalization")
        print(
            f"Rebasing final implementation change onto `{base_revision}` before "
            "publishing so the PR branch does not push local workspace ancestors."
        )
    else:
        print("## Refreshing implementation base")
        print(f"Rebasing current implementation change onto `{base_revision}`.")

    rebase_args = ["jj", "rebase", "-r", "@", "-d", base_revision, "--color=never"]
    rebase_proc = run_proc(rebase_args)
    commands.append(command_display(rebase_args))
    if rebase_proc.stdout:
        print(rebase_proc.stdout, end="")
    if rebase_proc.stderr:
        print(rebase_proc.stderr, end="", file=sys.stderr)

    unresolved = has_unresolved_conflicts_at_current_change()
    files = conflicted_files() if unresolved else []
    parent_commits_after = current_parent_commit_ids()
    if unresolved:
        return refresh_result(
            stage=stage,
            status="conflicts",
            repairable=True,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=parent_commits_after,
            current_change_id=current_change_id,
            rebased=True,
            has_unresolved_conflicts=True,
            conflicted=files,
            message="rebasing onto the publish base left unresolved conflicts"
            if files
            else "rebasing onto the publish base left unresolved conflicts; conflicted file list could not be determined",
            commands=commands,
            rebase_stdout=rebase_proc.stdout,
            rebase_stderr=rebase_proc.stderr,
            rebase_exit_code=rebase_proc.returncode,
        )
    if rebase_proc.returncode != 0:
        return refresh_result(
            stage=stage,
            status="rebase_failed",
            repairable=False,
            remote=remote,
            base=base,
            base_revision=base_revision,
            base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
            base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
            parent_commits_before=parent_commits_before,
            parent_commits_after=parent_commits_after,
            current_change_id=current_change_id,
            rebased=True,
            has_unresolved_conflicts=False,
            conflicted=[],
            message="could not rebase the implementation change onto the publish base",
            commands=commands,
            rebase_stdout=rebase_proc.stdout,
            rebase_stderr=rebase_proc.stderr,
            rebase_exit_code=rebase_proc.returncode,
        )
    return refresh_result(
        stage=stage,
        status="rebased_clean",
        repairable=False,
        remote=remote,
        base=base,
        base_revision=base_revision,
        base_commit_before_fetch=first_commit_id(base_commits_before_fetch),
        base_commit_after_fetch=first_commit_id(base_commits_after_fetch),
        parent_commits_before=parent_commits_before,
        parent_commits_after=parent_commits_after,
        current_change_id=current_change_id,
        rebased=True,
        has_unresolved_conflicts=False,
        conflicted=[],
        message="rebased current change onto publish base without unresolved conflicts",
        commands=commands,
        rebase_stdout=rebase_proc.stdout,
        rebase_stderr=rebase_proc.stderr,
        rebase_exit_code=rebase_proc.returncode,
    )


def driver_refresh_result(stage: str) -> dict[str, Any]:
    payload, proc = run_workspace_driver_json(
        ["refresh-base", "--stage", stage, "--json"],
        check=False,
        failure_code="workspace_driver_refresh_base_failed",
    )
    status = str(payload.get("status") or "")
    conflict_files = payload.get("conflict_files")
    if not isinstance(conflict_files, list):
        conflict_files = []
    repairable = status == "conflicts"
    result = {
        "schema_version": 1,
        "version": payload.get("version"),
        "stage": payload.get("stage") or stage,
        "status": status,
        "failure_code": str(payload.get("failure_code") or "workspace_driver_refresh_base_failed"),
        "exit_code": proc.returncode,
        "repairable": repairable,
        "remote": os.environ.get("SCHERZO_JJ_WORKSPACE_REMOTE", "origin").strip() or "origin",
        "base": payload.get("base_ref") or os.environ.get("SCHERZO_JJ_WORKSPACE_BASE_BRANCH", "main").strip() or "main",
        "base_revision": payload.get("base_revision") or payload.get("base_ref") or "",
        "base_commit_before_fetch": None,
        "base_commit_after_fetch": payload.get("base_revision") or "",
        "parent_commits_before": [str(payload.get("before_revision") or "")],
        "parent_commits_after": [str(payload.get("after_revision") or "")],
        "current_change_id": str(payload.get("change_id") or payload.get("after_revision") or ""),
        "rebased": status == "rebased_clean",
        "has_unresolved_conflicts": status == "conflicts",
        "conflicted_files": [str(item) for item in conflict_files if isinstance(item, str)],
        "metadata_base_change_id_updated": False,
        "message": str(payload.get("message") or status),
        "commands": ["$SCHERZO_WORKSPACE_DRIVER refresh-base --stage " + stage + " --json"],
    }
    if proc.returncode != 0 and status not in {"conflicts", "fetch_failed", "base_not_found", "rebase_failed"}:
        result["status"] = status or "rebase_failed"
        result["repairable"] = False
    return result


def update_start_refresh_metadata(result: dict[str, Any]) -> None:
    if result.get("stage") != "before-implementation":
        return
    if result.get("status") not in {"fresh", "rebased_clean"}:
        return
    metadata = load_implementation_metadata()
    if workspace_driver_available():
        refreshed_base_change_id = str(result.get("base_revision") or "").strip()
        if not refreshed_base_change_id:
            refreshed_base_change_id = str(result.get("parent_commits_after", [""])[0] or "")
    else:
        refreshed_base_change_id = current_base_change_id()
    previous_base_change_id = metadata.get("base_change_id")
    if previous_base_change_id != refreshed_base_change_id:
        if "initial_base_change_id" not in metadata:
            metadata["initial_base_change_id"] = previous_base_change_id
        metadata["base_change_id"] = refreshed_base_change_id
        write_implementation_metadata(metadata)
        result["metadata_base_change_id_updated"] = True


def write_refresh_base_result(result: dict[str, Any]) -> Path:
    path = refresh_base_json_path(str(result["stage"]))
    write_json(path, result)
    write_json(BASE_REFRESH_LATEST_PATH, result)
    print(f"REFRESH_BASE_STATUS={result['status']}")
    print(f"REFRESH_BASE_REPAIRABLE={str(bool(result['repairable'])).lower()}")
    print(f"REFRESH_BASE_REBASED={str(bool(result['rebased'])).lower()}")
    print(f"REFRESH_BASE_BASE_REVISION={result['base_revision']}")
    print(f"REFRESH_BASE_JSON={path}")
    print("REFRESH_BASE_CONFLICTED_FILES:")
    files = result.get("conflicted_files") or []
    if files:
        for file in files:
            print(f"- {file}")
    else:
        print("- None")
    return path


def refresh_base_result_for_stage(stage: str) -> dict[str, Any]:
    if workspace_driver_available():
        result = driver_refresh_result(stage)
    else:
        require_command("jj")
        result = refresh_base(stage)
    update_start_refresh_metadata(result)
    write_refresh_base_result(result)
    return result


def refresh_base_command(args: list[str]) -> None:
    stage = parse_refresh_base_args(args)
    result = refresh_base_result_for_stage(stage)
    status = result["status"]
    if status in {"fresh", "rebased_clean"}:
        sys.exit(0)
    if status == "conflicts":
        sys.exit(20)
    sys.exit(1)


def refresh_base_and_validate_command(args: list[str]) -> None:
    stage = parse_refresh_base_args(args)
    result = refresh_base_result_for_stage(stage)
    status = str(result.get("status") or "")
    print(f"REFRESH_AND_VALIDATE_STATUS={status}")
    print(f"REFRESH_AND_VALIDATE_REPAIRABLE={str(bool(result.get('repairable'))).lower()}")
    print(f"REFRESH_AND_VALIDATE_JSON={display_path(refresh_base_json_path(stage))}")
    if status == "conflicts":
        print("VALIDATION_STATUS=not_run")
        sys.exit(20)
    if status not in {"fresh", "rebased_clean"}:
        print("VALIDATION_STATUS=not_run")
        sys.exit(1)
    validate_command(failure_code="base_refresh_validation_failed")
    print("VALIDATION_STATUS=passed")
    print(f"VALIDATION_RESULT_PATH={display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}")


def append_base_drift_repair_summary(body: str) -> tuple[str, bool]:
    if not BASE_DRIFT_REPAIR_SUMMARY_PATH.exists():
        return body, False
    summary = BASE_DRIFT_REPAIR_SUMMARY_PATH.read_text().strip()
    section = "\n\n## Base drift repair\n\n"
    if summary:
        section += summary + "\n"
    else:
        section += f"See `{BASE_DRIFT_REPAIR_SUMMARY_PATH}`.\n"
    return body.rstrip() + section, True


def publish_blocked_after_refresh(result: dict[str, Any], *, failure_code: str) -> None:
    print("PUBLISH_BLOCKED=true")
    print("PUBLISH_BLOCKED_REASON=base drift after final validation")
    message = str(result.get("message") or "base moved after final validation")
    if result.get("status") == "conflicts":
        files = result.get("conflicted_files") or []
        if files:
            message += "\nConflicted files:\n" + "\n".join(f"- {file}" for file in files)
    fail(
        "publish blocked because the PR base moved after the repair window. "
        "Rerun the workflow or repair the retained workspace manually.\n" + message,
        failure_code=failure_code,
    )



def clean_lines(value: str) -> list[str]:
    return [line.strip() for line in value.splitlines() if line.strip()]


def detect_languages(files: list[str]) -> tuple[list[str], list[str], list[str]]:
    languages: list[str] = []
    supported_files: list[str] = []
    unsupported_files: list[str] = []
    for file in files:
        lower = file.lower()
        if lower.endswith(".gleam"):
            if "gleam" not in languages:
                languages.append("gleam")
            supported_files.append(file)
        elif is_review_relevant(file):
            unsupported_files.append(file)
    return languages, supported_files, unsupported_files


def is_review_relevant(file: str) -> bool:
    lower = file.lower()
    return any(
        lower.endswith(ext)
        for ext in [
            ".erl",
            ".hrl",
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".py",
            ".rs",
            ".go",
            ".fs",
            ".fsx",
            ".elm",
        ]
    )


def review_commands(_languages: list[str]) -> list[str]:
    # Review is performed by repo-local staged `.scherzo/workflows/scripts/scherzo-review` lanes in
    # the workflow DAG. Keep this compatibility field empty so prompts do not
    # depend on a local pi `/review` command or language-specific local skills.
    return []


def run_root_for_current_workspace() -> Path:
    explicit = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if explicit:
        return Path(explicit).resolve()

    cwd = Path.cwd().resolve()
    parts = cwd.parts
    if len(parts) >= 3 and parts[-2] == "workspaces":
        return cwd.parent.parent
    return cwd.parent


def retention_marker_path() -> Path:
    return run_root_for_current_workspace() / RETENTION_MARKER


def write_retention_marker(source_kind: str, source_ref: str) -> None:
    marker = retention_marker_path()
    marker.write_text(
        "Scherzo retained this run because an implementation workflow "
        "has not published a PR yet.\n"
        f"Source kind: {source_kind}\n"
        f"Source: {source_ref}\n"
    )


def clear_retention_marker() -> None:
    marker = retention_marker_path()
    if marker.exists():
        marker.unlink()


def sanitize_ref_part(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value


def githubish_host(host: str) -> bool:
    normalized = host.lower()
    return normalized == "github.com" or normalized.startswith("github")


def owner_repo_from_url(url: str) -> str | None:
    if url.startswith("https://github.com/"):
        value = url.removeprefix("https://github.com/")
    else:
        scp_match = re.match(r"^git@([^:]+):(.+)$", url)
        ssh_match = re.match(r"^ssh://(?:git@)?([^/]+)/(.+)$", url)
        if scp_match and githubish_host(scp_match.group(1)):
            value = scp_match.group(2)
        elif ssh_match and githubish_host(ssh_match.group(1)):
            value = ssh_match.group(2)
        else:
            return None
    value = value.split("?", 1)[0].split("#", 1)[0].rstrip("/").removesuffix(".git")
    parts = value.split("/")
    if len(parts) >= 2 and parts[0] and parts[1]:
        return f"{parts[0]}/{parts[1]}"
    return None


def remote_url(remote: str) -> str | None:
    output = run(["jj", "git", "remote", "list", "--color=never"])
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == remote:
            return parts[1]
    return None


def explicit_repo_env() -> tuple[str, str] | None:
    for name in ["SCHERZO_GITHUB_REPO", "SCHERZO_PR_REPO"]:
        explicit = os.environ.get(name, "").strip()
        if explicit:
            return name, explicit
    return None


def default_repo(remote: str) -> str:
    url = remote_url(remote)
    if not url:
        fail(f"could not find jj git remote: {remote}")
    remote_repo = owner_repo_from_url(url)
    explicit = explicit_repo_env()
    if explicit:
        name, repo = explicit
        if remote_repo and repo.lower() != remote_repo.lower():
            fail(
                f"{name}={repo} does not match selected jj publication remote "
                f"'{remote}' ({remote_repo}); update {name} or "
                "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE"
            )
        return repo
    if remote_repo:
        return remote_repo
    github_repo = os.environ.get("GITHUB_REPOSITORY", "").strip()
    if github_repo:
        return github_repo
    fail(f"could not infer GitHub owner/repo from remote URL: {url}")


def plan_title(plan_path: str) -> str:
    text = resolve_prepared_execplan_path(plan_path, Path.cwd()).read_text(encoding="utf-8")
    for line in text.splitlines():
        if line.startswith("# "):
            return line.removeprefix("# ").strip()
    return f"Implement {plan_path}"


def label_names(issue: dict[str, Any]) -> list[str]:
    labels = issue.get("labels", {}).get("nodes", [])
    names = [label.get("name") or "" for label in labels]
    return sorted([name for name in names if name])


def comment_nodes(issue: dict[str, Any]) -> list[dict[str, Any]]:
    comments = issue.get("comments", {}).get("nodes", [])
    return sorted(comments, key=lambda c: c.get("createdAt") or "")


def render_ticket_brief(issue: dict[str, Any]) -> str:
    identifier = issue.get("identifier") or "unknown-issue"
    title = issue.get("title") or "Untitled"
    url = issue.get("url") or ""
    state = (issue.get("state") or {}).get("name") or "Unknown"
    priority = issue.get("priority")
    description = issue.get("description") or "_No description provided._"
    labels = label_names(issue)
    comments = comment_nodes(issue)
    labels_truncated = issue.get("labels", {}).get("pageInfo", {}).get("hasNextPage") is True
    comments_truncated = issue.get("comments", {}).get("pageInfo", {}).get("hasNextPage") is True

    lines = [
        f"# Task context for {identifier}: {title}",
        "",
        "## Metadata",
        "",
        f"- Identifier: {identifier}",
        f"- Title: {title}",
        f"- URL: {url or 'None'}",
        f"- State: {state}",
        f"- Priority: {priority if priority is not None else 'None'}",
        "- Labels: " + (", ".join(labels) if labels else "None"),
        "",
        "## Description",
        "",
        description,
        "",
        "## Comments",
        "",
    ]

    if comments:
        for index, comment in enumerate(comments, start=1):
            created = comment.get("createdAt") or "unknown time"
            user = (comment.get("user") or {}).get("name") or "unknown user"
            body = comment.get("body") or ""
            lines.extend([
                f"### Comment {index} — {created} — {user}",
                "",
                body or "_No body._",
                "",
            ])
    else:
        lines.extend(["None.", ""])

    if labels_truncated or comments_truncated:
        lines.extend(["## Fetch notes", ""])
        if labels_truncated:
            lines.append("- Linear returned more than 50 labels; the label list above is truncated.")
        if comments_truncated:
            lines.append("- Linear returned more than 100 comments; the comment list above is truncated.")
        lines.append("")

    return "\n".join(lines).rstrip() + "\n"


def write_ticket_brief(issue: dict[str, Any]) -> Path:
    TICKET_BRIEF_PATH.parent.mkdir(parents=True, exist_ok=True)
    TICKET_BRIEF_PATH.write_text(render_ticket_brief(issue))
    return TICKET_BRIEF_PATH


def parse_prepare_source(args: list[str]) -> str:
    if args == ["--source", "ticket"]:
        return "ticket"
    usage()
    sys.exit(2)


def prepare_command(args: list[str]) -> None:
    source_kind = parse_prepare_source(args)
    issue_identifier = infer_issue_identifier()
    # Create the retention marker before any fetch or workspace inspection can fail so
    # prepare-step diagnostics remain available for triage.
    write_retention_marker(source_kind, issue_identifier)
    if workspace_driver_available():
        base_change_id = str(workspace_driver_baseline()["baseline_id"])
    else:
        require_command("jj")
        base_change_id = current_base_change_id()

    issue = fetch_linear_issue_context(issue_identifier)
    brief_path = write_ticket_brief(issue)
    issue_ref = issue.get("identifier") or issue_identifier
    write_retention_marker(source_kind, issue_ref)
    metadata = {
        "source_kind": source_kind,
        "issue_identifier": issue_ref,
        "issue_title": issue.get("title") or "",
        "issue_url": issue.get("url") or "",
        "brief_path": str(brief_path),
        "base_change_id": base_change_id,
    }
    write_implementation_metadata(metadata)
    print(f"SOURCE_KIND={source_kind}")
    print(f"BRIEF_PATH={brief_path}")
    print(f"BASE_CHANGE_ID={base_change_id}")
    print(f"RETENTION_MARKER={retention_marker_path()}")
    print("VALIDATION=ok")


def require_plan_brief_metadata() -> tuple[dict[str, Any], str]:
    metadata = load_implementation_metadata()
    if metadata.get("source_kind") != "execplan":
        fail(
            "plan-brief only applies to execplan implementation workflows; "
            f"found source_kind={metadata.get('source_kind')!r}"
        )
    if not (
        metadata.get("execplan_v2_bundle_path") or metadata.get("plan_artifact_ref")
    ):
        fail(
            "plan-brief requires ExecPlan bundle metadata produced by "
            "scherzo-execplan implementation-prepare",
            failure_code="execplan_metadata_invalid",
        )
    plan_path = str(metadata.get("plan_path") or "").strip()
    if not plan_path:
        fail(
            f"missing plan_path in {METADATA_PATH}; run "
            "scherzo-execplan implementation-prepare first",
            failure_code="execplan_metadata_invalid",
        )
    validate_prepared_execplan_path(plan_path, Path.cwd())
    return metadata, plan_path


def load_plan_index_hash(index_path: str) -> str | None:
    try:
        index = json.loads(Path(index_path).read_text())
    except (OSError, json.JSONDecodeError):
        return None
    value = str(index.get("source_sha256") or "").strip()
    if re.fullmatch(r"[0-9a-f]{64}", value):
        return value
    return None


def plan_brief_freshness(metadata: dict[str, Any], plan_path: str) -> str:
    if metadata.get("plan_brief_status") != "ok":
        return "unavailable"
    brief_path = str(metadata.get("plan_brief_path") or "").strip()
    index_path = str(metadata.get("plan_index_path") or "").strip()
    metadata_hash = str(metadata.get("plan_source_sha256") or "").strip()
    if not brief_path or not index_path or not Path(brief_path).is_file() or not Path(index_path).is_file():
        return "unavailable"
    index_hash = load_plan_index_hash(index_path)
    if not index_hash or not re.fullmatch(r"[0-9a-f]{64}", metadata_hash):
        return "unavailable"
    current_hash = plan_source_sha256(plan_path)
    if current_hash == metadata_hash == index_hash:
        return "fresh"
    return "stale"


def plan_brief_command(args: list[str]) -> None:
    if args != [] and args != ["--check"] and args != ["--refresh-if-stale"]:
        usage()
        sys.exit(2)
    metadata, plan_path = require_plan_brief_metadata()
    if args == ["--check"]:
        status = plan_brief_freshness(metadata, plan_path)
        print(f"PLAN_BRIEF_STATUS={status}")
        if status == "fresh":
            print(f"PLAN_BRIEF_PATH={metadata.get('plan_brief_path')}")
            print(f"PLAN_INDEX_PATH={metadata.get('plan_index_path')}")
            print(f"PLAN_SOURCE_SHA256={metadata.get('plan_source_sha256')}")
            return
        if status == "stale":
            sys.exit(2)
        sys.exit(1)
    if args == ["--refresh-if-stale"]:
        status = plan_brief_freshness(metadata, plan_path)
        if status == "fresh":
            print("PLAN_BRIEF_STATUS=fresh")
            print(f"PLAN_BRIEF_PATH={metadata.get('plan_brief_path')}")
            print(f"PLAN_INDEX_PATH={metadata.get('plan_index_path')}")
            print(f"PLAN_SOURCE_SHA256={metadata.get('plan_source_sha256')}")
            return
    result = generate_plan_brief(str(resolve_prepared_execplan_path(plan_path, Path.cwd())))
    apply_plan_brief_result(metadata, result)
    write_implementation_metadata(metadata)
    print_plan_brief_result(result)
    if result["status"] != "ok":
        sys.exit(1)


def analyze_command() -> None:
    metadata = load_implementation_metadata()
    files = workspace_driver_changed_files() if workspace_driver_available() else changed_files_since(metadata["base_change_id"])
    if not files:
        fail("no changed files found since the workflow started")
    languages, supported_files, unsupported_files = detect_languages(files)
    commands = review_commands(languages)
    analysis = {
        "changed_files": files,
        "languages": languages,
        "supported_review_files": supported_files,
        "unsupported_review_files": unsupported_files,
        "review_commands": commands,
    }
    write_json(ANALYSIS_PATH, analysis)
    print_list("CHANGED_FILES", files)
    print("LANGUAGES=" + comma_join(languages))
    print_list("SUPPORTED_REVIEW_FILES", supported_files)
    print_list("UNSUPPORTED_REVIEW_FILES", unsupported_files)
    print_list("REVIEW_COMMANDS", commands)


IMPLEMENTATION_COMPLETION_REQUIRED_FIELDS = {
    "ready_for_verification",
    "changed_files",
    "acceptance_criteria",
    "guardrail_checks",
    "absence_checks",
    "required_references",
    "implementation_inventory",
    "remaining_required_work",
    "blockers",
}
IMPLEMENTATION_COMPLETION_BLOCKER_KINDS = {
    "conflict",
    "missing_input",
    "unsafe_ambiguity",
    "required_decision",
    "infrastructure",
    "other",
}
IMPLEMENTATION_COMPLETION_EVIDENCE_KINDS = {
    "code",
    "test",
    "command",
    "measurement",
    "inventory",
}
IMPLEMENTATION_COMPLETION_INVENTORY_DISPOSITIONS = {
    "unchanged",
    "changed",
    "not_applicable",
}
GENERAL_REGRESSION_COMMAND_RE = re.compile(
    r"(?:gleam\s+(?:format|test)|glinter|scherzo_lint)", re.IGNORECASE
)
PLAN_REDUCTION_RE = re.compile(
    r"(?:guardrail|ratchet).{0,180}(?:lower|fewer|shrink|reduc)|"
    r"(?:lower|fewer|shrink|reduc).{0,180}(?:guardrail|ratchet)",
    re.IGNORECASE | re.DOTALL,
)
PLAN_INVENTORY_RE = re.compile(
    r"(?:explicit\s+inventory|helper\s+inventory|touched-surface\s+inventory|"
    r"unchanged-surface\s+inventory|inventory\s+stating)",
    re.IGNORECASE,
)
PLAN_OWNER_MIGRATION_RE = re.compile(
    r"(?:owner\s+(?:record|api)|remove(?:s|d)?\s+(?:leftover|legacy).{0,40}field)",
    re.IGNORECASE,
)


def implementation_completion_diagnostic_path() -> Path:
    path = canonical_implementation_state_path(
        CANONICAL_IMPLEMENTATION_COMPLETION_DIAGNOSTIC_NAME
    )
    if path is None:
        fail(
            "SCHERZO_RUN_ROOT is required to retain implementation-completion diagnostics",
            failure_code="implementation_completion_diagnostic_write_failed",
            exit_code=2,
        )
    return path


def read_implementation_completion_submission(
    submission_path: str | None,
) -> dict[str, Any]:
    try:
        raw = (
            Path(submission_path).read_text(encoding="utf-8")
            if submission_path is not None
            else sys.stdin.read()
        )
    except OSError as exc:
        fail(
            f"could not read implementation-completion submission: {exc}",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(
            f"implementation-completion submission must be valid JSON: {exc}",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    if not isinstance(value, dict):
        fail(
            "implementation-completion submission must be a JSON object",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    return value


def implementation_completion_string_list(
    submission: dict[str, Any],
    field: str,
) -> list[str]:
    value = submission.get(field)
    if not isinstance(value, list) or any(
        not isinstance(item, str) or not item.strip() for item in value
    ):
        fail(
            f"implementation-completion field {field!r} must be a list of non-empty strings",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    normalized = [item.strip() for item in value]
    if len(normalized) != len(set(normalized)):
        fail(
            f"implementation-completion field {field!r} must not contain duplicates",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    return normalized


def valid_implementation_evidence_path(value: str) -> bool:
    path = Path(value)
    return (
        not path.is_absolute()
        and value not in {"", ".", ".."}
        and ".." not in path.parts
        and "\\" not in value
    )


def implementation_completion_non_empty_string(
    value: Any, field: str
) -> str:
    if not isinstance(value, str) or not value.strip():
        fail(
            f"implementation-completion field {field!r} must be a non-empty string",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    return value.strip()


def implementation_completion_repo_path(value: Any, field: str) -> str:
    normalized = implementation_completion_non_empty_string(value, field)
    if not valid_implementation_evidence_path(normalized):
        fail(
            f"implementation-completion field {field!r} must be a safe repository-relative path",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    return normalized


def normalize_repository_checks(value: Any, field: str) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        fail(
            f"implementation-completion field {field!r} must be a list",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    checks: list[dict[str, Any]] = []
    for index, check in enumerate(value):
        if not isinstance(check, dict) or set(check) != {"criterion", "pattern", "paths"}:
            fail(
                f"each {field} entry must contain only criterion, pattern, and paths",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        paths = check.get("paths")
        if not isinstance(paths, list) or not paths:
            fail(
                f"implementation-completion field {field}[{index}].paths must be non-empty",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        normalized_paths = [
            implementation_completion_repo_path(path, f"{field}[{index}].paths")
            for path in paths
        ]
        if len(normalized_paths) != len(set(normalized_paths)):
            fail(
                f"implementation-completion field {field}[{index}].paths must not contain duplicates",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        checks.append(
            {
                "criterion": implementation_completion_non_empty_string(
                    check.get("criterion"), f"{field}[{index}].criterion"
                ),
                "pattern": implementation_completion_non_empty_string(
                    check.get("pattern"), f"{field}[{index}].pattern"
                ),
                "paths": normalized_paths,
            }
        )
    return checks


def normalize_acceptance_criteria(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        fail(
            "implementation-completion field 'acceptance_criteria' must be a non-empty list",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    criteria: list[dict[str, Any]] = []
    for index, entry in enumerate(value):
        if not isinstance(entry, dict) or set(entry) != {"criterion", "satisfied", "evidence"}:
            fail(
                "each acceptance_criteria entry must contain only criterion, satisfied, and evidence",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        satisfied = entry.get("satisfied")
        evidence = entry.get("evidence")
        if not isinstance(satisfied, bool) or not isinstance(evidence, list) or not evidence:
            fail(
                f"acceptance_criteria[{index}] requires boolean satisfied and non-empty evidence",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        normalized_evidence: list[dict[str, str]] = []
        for evidence_index, item in enumerate(evidence):
            if not isinstance(item, dict) or set(item) != {"kind", "reference", "observation"}:
                fail(
                    "each acceptance evidence entry must contain only kind, reference, and observation",
                    failure_code="implementation_completion_submission_malformed",
                    exit_code=2,
                )
            kind = item.get("kind")
            if kind not in IMPLEMENTATION_COMPLETION_EVIDENCE_KINDS:
                fail(
                    f"acceptance_criteria[{index}].evidence[{evidence_index}] has invalid kind",
                    failure_code="implementation_completion_submission_malformed",
                    exit_code=2,
                )
            normalized_evidence.append(
                {
                    "kind": str(kind),
                    "reference": implementation_completion_non_empty_string(
                        item.get("reference"), "acceptance evidence reference"
                    ),
                    "observation": implementation_completion_non_empty_string(
                        item.get("observation"), "acceptance evidence observation"
                    ),
                }
            )
        criteria.append(
            {
                "criterion": implementation_completion_non_empty_string(
                    entry.get("criterion"), f"acceptance_criteria[{index}].criterion"
                ),
                "satisfied": satisfied,
                "evidence": normalized_evidence,
            }
        )
    return criteria


def normalize_guardrail_checks(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        fail(
            "implementation-completion field 'guardrail_checks' must be a list",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    checks: list[dict[str, Any]] = []
    expected_fields = {"metric", "path", "baseline", "measured", "requirement"}
    for index, check in enumerate(value):
        if not isinstance(check, dict) or set(check) != expected_fields:
            fail(
                "each guardrail_checks entry must contain metric, path, baseline, measured, and requirement",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        metric = check.get("metric")
        baseline = check.get("baseline")
        measured = check.get("measured")
        if metric not in {"line_count", "import_count"}:
            fail(
                f"guardrail_checks[{index}].metric is invalid",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        if (
            not isinstance(baseline, int)
            or isinstance(baseline, bool)
            or baseline < 1
            or not isinstance(measured, int)
            or isinstance(measured, bool)
            or measured < 0
            or check.get("requirement") != "decrease_from_baseline"
        ):
            fail(
                f"guardrail_checks[{index}] requires positive baseline, non-negative measured, and decrease_from_baseline",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        checks.append(
            {
                "metric": str(metric),
                "path": implementation_completion_repo_path(
                    check.get("path"), f"guardrail_checks[{index}].path"
                ),
                "baseline": baseline,
                "measured": measured,
                "requirement": "decrease_from_baseline",
            }
        )
    return checks


def normalize_implementation_inventory(value: Any) -> list[dict[str, str]]:
    if not isinstance(value, list):
        fail(
            "implementation-completion field 'implementation_inventory' must be a list",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    inventory: list[dict[str, str]] = []
    expected_fields = {"surface", "path_pattern", "disposition", "evidence"}
    for index, entry in enumerate(value):
        if not isinstance(entry, dict) or set(entry) != expected_fields:
            fail(
                "each implementation_inventory entry must contain surface, path_pattern, disposition, and evidence",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        disposition = entry.get("disposition")
        if disposition not in IMPLEMENTATION_COMPLETION_INVENTORY_DISPOSITIONS:
            fail(
                f"implementation_inventory[{index}].disposition is invalid",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        inventory.append(
            {
                "surface": implementation_completion_non_empty_string(
                    entry.get("surface"), f"implementation_inventory[{index}].surface"
                ),
                "path_pattern": implementation_completion_repo_path(
                    entry.get("path_pattern"), f"implementation_inventory[{index}].path_pattern"
                ),
                "disposition": str(disposition),
                "evidence": implementation_completion_non_empty_string(
                    entry.get("evidence"), f"implementation_inventory[{index}].evidence"
                ),
            }
        )
    return inventory


def validate_implementation_completion_submission(
    submission: dict[str, Any],
) -> dict[str, Any]:
    fields = set(submission)
    if fields != IMPLEMENTATION_COMPLETION_REQUIRED_FIELDS:
        missing = sorted(IMPLEMENTATION_COMPLETION_REQUIRED_FIELDS - fields)
        unexpected = sorted(fields - IMPLEMENTATION_COMPLETION_REQUIRED_FIELDS)
        details: list[str] = []
        if missing:
            details.append("missing: " + ", ".join(missing))
        if unexpected:
            details.append("unexpected: " + ", ".join(unexpected))
        fail(
            "implementation-completion submission fields are invalid ("
            + "; ".join(details)
            + ")",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    ready = submission.get("ready_for_verification")
    if not isinstance(ready, bool):
        fail(
            "implementation-completion field 'ready_for_verification' must be boolean",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    changed_files = implementation_completion_string_list(submission, "changed_files")
    if any(not valid_implementation_evidence_path(path) for path in changed_files):
        fail(
            "implementation-completion changed_files must contain safe repository-relative paths",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    remaining_required_work = implementation_completion_string_list(
        submission, "remaining_required_work"
    )
    blockers = submission.get("blockers")
    if not isinstance(blockers, list):
        fail(
            "implementation-completion field 'blockers' must be a list",
            failure_code="implementation_completion_submission_malformed",
            exit_code=2,
        )
    normalized_blockers: list[dict[str, str]] = []
    for blocker in blockers:
        if not isinstance(blocker, dict) or set(blocker) != {"kind", "description"}:
            fail(
                "each implementation-completion blocker must contain only kind and description",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        kind = blocker.get("kind")
        description = blocker.get("description")
        if kind not in IMPLEMENTATION_COMPLETION_BLOCKER_KINDS:
            fail(
                "implementation-completion blocker kind is invalid",
                failure_code="implementation_completion_submission_malformed",
                exit_code=2,
            )
        normalized_blockers.append(
            {
                "kind": str(kind),
                "description": implementation_completion_non_empty_string(
                    description, "blocker description"
                ),
            }
        )
    return {
        "ready_for_verification": ready,
        "changed_files": sorted(changed_files),
        "acceptance_criteria": normalize_acceptance_criteria(
            submission.get("acceptance_criteria")
        ),
        "guardrail_checks": normalize_guardrail_checks(
            submission.get("guardrail_checks")
        ),
        "absence_checks": normalize_repository_checks(
            submission.get("absence_checks"), "absence_checks"
        ),
        "required_references": normalize_repository_checks(
            submission.get("required_references"), "required_references"
        ),
        "implementation_inventory": normalize_implementation_inventory(
            submission.get("implementation_inventory")
        ),
        "remaining_required_work": remaining_required_work,
        "blockers": normalized_blockers,
    }


def implementation_completion_plan_references(
    metadata: dict[str, Any],
) -> dict[str, str]:
    fields = {
        "plan_path": str(metadata.get("plan_path") or "").strip(),
        "plan_sha256": str(metadata.get("plan_sha256") or "").strip(),
        "plan_artifact_ref": str(metadata.get("plan_artifact_ref") or "").strip(),
        "canonical_plan_path": str(metadata.get("canonical_plan_path") or "").strip(),
        "execplan_bundle_path": str(
            metadata.get("execplan_v2_bundle_path")
            or implementation_state_relative_path("execplan-bundle.json")
        ).strip(),
        "implementation_pack_path": str(
            metadata.get("execplan_v2_implementation_pack_path")
            or implementation_state_relative_path("execplan-implementation-pack.json")
        ).strip(),
    }
    return {key: value for key, value in fields.items() if value}


def implementation_completion_workspace_evidence(
    metadata: dict[str, Any],
) -> dict[str, Any]:
    base_change_id = str(metadata.get("base_change_id") or "").strip()
    if not base_change_id:
        fail(
            "implementation metadata is missing base_change_id",
            failure_code="implementation_completion_evidence_failed",
            exit_code=2,
        )
    records = [
        {"path": path, "status": "changed"}
        for path in sorted(set(changed_files_since(base_change_id)))
    ]
    manifest = "\n".join(
        f"{record['status']}\t{record['path']}" for record in records
    )
    encoded_manifest = manifest.encode("utf-8")
    return {
        "source": "jj_workflow_diff",
        "base_change_id": base_change_id,
        "changed_file_count": len(records),
        "changed_files": records,
        "diff": {
            "evidence_kind": "changed_file_manifest",
            "sha256": hashlib.sha256(encoded_manifest).hexdigest(),
            "bytes": len(encoded_manifest),
            "content_retained": False,
            "full_diff_materialized": False,
        },
    }


def execplan_acceptance_text(plan_text: str) -> str:
    lines = plan_text.splitlines()
    selected: list[str] = []
    capture_level: int | None = None
    for line in lines:
        heading = re.match(r"^(#{1,6})\s+(.+?)\s*#*\s*$", line)
        if heading:
            level = len(heading.group(1))
            title = heading.group(2).strip().casefold()
            if title in {"validation and acceptance", "acceptance criteria"}:
                capture_level = level
                selected.append(line)
                continue
            if capture_level is not None and level <= capture_level:
                capture_level = None
        if capture_level is not None:
            selected.append(line)
    return "\n".join(selected)


def normalized_prose(value: str) -> str:
    return " ".join(value.casefold().split())


def plan_mentions_baseline(plan_text: str, path: str, baseline: int) -> bool:
    path_present = path in plan_text or Path(path).name in plan_text
    baseline_forms = {
        str(baseline),
        f"{baseline:,}",
        f"{baseline:_}",
    }
    return path_present and any(form in plan_text for form in baseline_forms)


def measured_guardrail_value(path: Path, metric: str) -> int:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return -1
    if metric == "line_count":
        return len(text.splitlines())
    return sum(1 for line in text.splitlines() if re.match(r"^\s*import\s+", line))


def repository_check_failures(
    checks: list[dict[str, Any]], *, expect_absent: bool
) -> list[dict[str, str]]:
    failures: list[dict[str, str]] = []
    for check in checks:
        pattern = str(check["pattern"])
        for path_value in check["paths"]:
            path = Path(path_value)
            try:
                text = path.read_text(encoding="utf-8")
            except OSError:
                failures.append(
                    {
                        "criterion": str(check["criterion"]),
                        "needed_evidence": f"readable current-tree file {path_value}",
                    }
                )
                continue
            present = pattern in text
            if present == expect_absent:
                expectation = "absent" if expect_absent else "present"
                failures.append(
                    {
                        "criterion": str(check["criterion"]),
                        "needed_evidence": (
                            f"literal {pattern!r} must be {expectation} in {path_value}"
                        ),
                    }
                )
    return failures


def implementation_completion_semantic_failures(
    submission: dict[str, Any],
    *,
    plan_path: str,
    actual_files: list[str],
) -> tuple[list[str], list[dict[str, str]]]:
    resolved_plan_path = resolve_prepared_execplan_path(plan_path, Path.cwd())
    try:
        plan_text = resolved_plan_path.read_text(encoding="utf-8")
    except OSError as exc:
        fail(
            f"could not read canonical ExecPlan for completion checks: {exc}",
            failure_code="implementation_completion_evidence_failed",
            exit_code=2,
        )
    acceptance_text = normalized_prose(execplan_acceptance_text(plan_text))
    reason_codes: list[str] = []
    failures: list[dict[str, str]] = []

    for entry in submission["acceptance_criteria"]:
        criterion = str(entry["criterion"])
        normalized_criterion = normalized_prose(criterion)
        if normalized_criterion not in acceptance_text:
            reason_codes.append("criterion_not_in_canonical_acceptance")
            failures.append(
                {
                    "criterion": criterion,
                    "needed_evidence": (
                        "quote an exact current canonical criterion from Validation and Acceptance or Acceptance Criteria"
                    ),
                }
            )
        if not entry["satisfied"]:
            reason_codes.append("criterion_unsatisfied")
            failures.append(
                {
                    "criterion": criterion,
                    "needed_evidence": "complete the criterion and attach current-tree code, test, measurement, or inventory evidence",
                }
            )
        semantic_evidence = False
        for evidence in entry["evidence"]:
            kind = str(evidence["kind"])
            reference = str(evidence["reference"])
            if kind in {"code", "test", "inventory"}:
                if not valid_implementation_evidence_path(reference):
                    reason_codes.append("criterion_evidence_path_invalid")
                    failures.append(
                        {
                            "criterion": criterion,
                            "needed_evidence": f"safe repository-relative {kind} evidence path instead of {reference!r}",
                        }
                    )
                    continue
                if Path(reference).resolve(strict=False) == resolved_plan_path.resolve(
                    strict=False
                ):
                    reason_codes.append("historical_plan_claim_used_as_evidence")
                    failures.append(
                        {
                            "criterion": criterion,
                            "needed_evidence": "current-tree implementation evidence outside the plan Progress/Outcomes prose",
                        }
                    )
                    continue
                if reference not in actual_files and not Path(reference).exists():
                    reason_codes.append("criterion_evidence_path_missing")
                    failures.append(
                        {
                            "criterion": criterion,
                            "needed_evidence": f"existing current-tree evidence path {reference}",
                        }
                    )
                    continue
                semantic_evidence = True
            elif kind == "measurement":
                semantic_evidence = True
            elif kind == "command" and not GENERAL_REGRESSION_COMMAND_RE.search(reference):
                semantic_evidence = True
        if not semantic_evidence:
            reason_codes.append("criterion_semantic_evidence_missing")
            failures.append(
                {
                    "criterion": criterion,
                    "needed_evidence": (
                        "current-tree code, focused test, measurement, inventory, or a criterion-specific command; general format/test/lint gates prove regression safety only"
                    ),
                }
            )

    if PLAN_REDUCTION_RE.search(plan_text) and not submission["guardrail_checks"]:
        reason_codes.append("required_guardrail_evidence_missing")
        failures.append(
            {
                "criterion": "plan-required shrinking guardrail",
                "needed_evidence": "guardrail_checks with plan baseline and current line/import measurement",
            }
        )
    for check in submission["guardrail_checks"]:
        path = str(check["path"])
        baseline = int(check["baseline"])
        measured = int(check["measured"])
        actual = measured_guardrail_value(Path(path), str(check["metric"]))
        if not plan_mentions_baseline(plan_text, path, baseline):
            reason_codes.append("guardrail_baseline_not_in_plan")
            failures.append(
                {
                    "criterion": f"{check['metric']} guardrail for {path}",
                    "needed_evidence": "use the path and baseline stated in the canonical plan",
                }
            )
        if actual < 0 or measured != actual:
            reason_codes.append("guardrail_measurement_mismatch")
            failures.append(
                {
                    "criterion": f"{check['metric']} guardrail for {path}",
                    "needed_evidence": f"current-tree measurement {actual if actual >= 0 else 'from a readable file'}",
                }
            )
        if actual >= baseline:
            reason_codes.append("guardrail_reduction_not_met")
            failures.append(
                {
                    "criterion": f"{check['metric']} guardrail for {path}",
                    "needed_evidence": f"current measurement below canonical baseline {baseline}; do not raise the ratchet",
                }
            )

    absence_failures = repository_check_failures(
        submission["absence_checks"], expect_absent=True
    )
    reference_failures = repository_check_failures(
        submission["required_references"], expect_absent=False
    )
    if absence_failures:
        reason_codes.append("retained_legacy_reference")
        failures.extend(absence_failures)
    if reference_failures:
        reason_codes.append("required_owner_or_test_reference_missing")
        failures.extend(reference_failures)
    if PLAN_OWNER_MIGRATION_RE.search(plan_text):
        if not submission["absence_checks"]:
            reason_codes.append("required_absence_checks_missing")
            failures.append(
                {
                    "criterion": "owner/legacy migration",
                    "needed_evidence": "literal absence_checks for replaced legacy fields or helpers",
                }
            )
        if not submission["required_references"]:
            reason_codes.append("required_reference_checks_missing")
            failures.append(
                {
                    "criterion": "owner/legacy migration",
                    "needed_evidence": "literal required_references proving owner consumption and focused-test use",
                }
            )

    if PLAN_INVENTORY_RE.search(plan_text) and not submission["implementation_inventory"]:
        reason_codes.append("required_implementation_inventory_missing")
        failures.append(
            {
                "criterion": "plan-required implementation inventory",
                "needed_evidence": "explicit per-surface implementation_inventory entries with path globs and dispositions",
            }
        )
    for entry in submission["implementation_inventory"]:
        matches = [
            path
            for path in actual_files
            if fnmatch.fnmatch(path, str(entry["path_pattern"]))
        ]
        disposition = entry["disposition"]
        if disposition == "unchanged" and matches:
            reason_codes.append("implementation_inventory_contradiction")
            failures.append(
                {
                    "criterion": str(entry["surface"]),
                    "needed_evidence": "mark the surface changed or remove the contradictory workflow-diff changes: "
                    + ", ".join(matches),
                }
            )
        if disposition == "changed" and not matches:
            reason_codes.append("implementation_inventory_contradiction")
            failures.append(
                {
                    "criterion": str(entry["surface"]),
                    "needed_evidence": f"a changed file matching {entry['path_pattern']}",
                }
            )

    return list(dict.fromkeys(reason_codes)), failures


def write_implementation_completion_diagnostic(
    *,
    status: str,
    submission: dict[str, Any],
    validation_error: dict[str, Any] | None,
    workspace: dict[str, Any],
    metadata: dict[str, Any],
) -> Path:
    step_id = os.environ.get("SCHERZO_STEP_ID", "implement_plan").strip()
    attempt_index = os.environ.get("SCHERZO_ATTEMPT_INDEX", "0").strip()
    classification = (
        str(validation_error.get("failure_code") or "").strip()
        if validation_error is not None
        else None
    )
    operator_action = {
        "accepted": "No operator action required; continue to conflict and semantic completion verification.",
        "partial": (
            "No operator action required. Continue to the independent semantic completion verifier, whose bounded recovery treats the current-tree gaps as an actionable implementation backlog."
        ),
    }.get(
        status,
        "Inspect the retained implementation response, submission, plan references, and workspace evidence before retrying the implementation workflow; do not retry analyze_changes directly.",
    )
    diagnostic = {
        "schema_version": 1,
        "artifact_type": "scherzo.implementation_completion_diagnostic.v1",
        "status": status,
        "classification": classification,
        "submission": submission,
        "validation_error": validation_error,
        "workspace_evidence": workspace,
        "plan_references": implementation_completion_plan_references(metadata),
        "agent_final_response": {
            "retained_by": "scherzo_step_artifact",
            "step_id": step_id,
            "attempt_index": attempt_index,
            "step_artifact_ref": f"{step_id}/attempt-{attempt_index}.json",
            "field": "final_response",
        },
        "operator_action": operator_action,
    }
    path = implementation_completion_diagnostic_path()
    try:
        write_json(path, diagnostic)
    except OSError as exc:
        fail(
            f"could not write implementation-completion diagnostic {display_path(path)}: {exc}",
            failure_code="implementation_completion_diagnostic_write_failed",
            exit_code=2,
        )
    return path


def parse_implementation_completion_args(args: list[str]) -> str | None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--submission")
    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        usage()
        sys.exit(2)
    return parsed.submission


def gate_implementation_completion_command(args: list[str]) -> None:
    assert_implementation_completion_validator_workspace()
    submission_path = parse_implementation_completion_args(args)
    submission = validate_implementation_completion_submission(
        read_implementation_completion_submission(submission_path)
    )
    metadata = load_implementation_metadata()
    plan_path, _base_change_id = require_execplan_metadata(metadata)
    validate_prepared_execplan_path(plan_path, Path.cwd())
    workspace = implementation_completion_workspace_evidence(metadata)
    actual_files = sorted(
        str(record.get("path") or "").strip()
        for record in workspace["changed_files"]
        if str(record.get("path") or "").strip()
    )
    try:
        reason_codes, criterion_failures = implementation_completion_semantic_failures(
            submission,
            plan_path=plan_path,
            actual_files=actual_files,
        )
    except Exception as exc:
        error = {
            "failure_code": "implementation_completion_evidence_failed",
            "reason_codes": ["semantic_evidence_validator_crashed"],
            "criterion_failures": [],
            "message": "The implementation-completion semantic evidence validator crashed.",
            "exception_type": type(exc).__name__,
            "exception_message": str(exc),
            "traceback": traceback.format_exc(),
        }
        diagnostic_path = write_implementation_completion_diagnostic(
            status="rejected",
            submission=submission,
            validation_error=error,
            workspace=workspace,
            metadata=metadata,
        )
        print("IMPLEMENTATION_COMPLETION_GATE=error")
        print("IMPLEMENTATION_COMPLETION_REASON_CODES=semantic_evidence_validator_crashed")
        print(
            "IMPLEMENTATION_COMPLETION_DIAGNOSTIC_PATH="
            + display_path(diagnostic_path)
        )
        fail(
            "implementation-completion semantic evidence validation crashed; "
            f"inspect {display_path(diagnostic_path)}",
            failure_code="implementation_completion_evidence_failed",
            exit_code=2,
        )
    if not submission["ready_for_verification"]:
        reason_codes.append("not_ready_for_verification")
    if submission["remaining_required_work"]:
        reason_codes.append("remaining_required_work")
    if submission["blockers"]:
        reason_codes.append("blockers_reported")
    if not submission["changed_files"]:
        reason_codes.append("changed_file_evidence_missing")
    if not actual_files:
        reason_codes.append("workspace_no_implementation_changes")
    if submission["changed_files"] != actual_files:
        reason_codes.append("changed_file_evidence_mismatch")
    reason_codes = list(dict.fromkeys(reason_codes))

    explicit_partial = (
        not submission["ready_for_verification"]
        or bool(submission["remaining_required_work"])
    )
    rejection_code: str | None = None
    rejection_message: str | None = None
    if submission["blockers"]:
        rejection_code = "implementation_blocked"
        rejection_message = (
            "The implementation agent reported a concrete blocker that requires operator action."
        )
    elif not actual_files:
        rejection_code = "implementation_noop"
        rejection_message = (
            "The implementation agent produced no workflow-baseline code changes."
        )
    elif not submission["changed_files"] or submission["changed_files"] != actual_files:
        rejection_code = "implementation_completion_evidence_invalid"
        rejection_message = (
            "The submitted changed-file evidence does not match the workflow workspace."
        )

    if rejection_code is not None:
        error = {
            "failure_code": rejection_code,
            "reason_codes": reason_codes,
            "criterion_failures": criterion_failures,
            "message": rejection_message,
        }
        diagnostic_path = write_implementation_completion_diagnostic(
            status="rejected",
            submission=submission,
            validation_error=error,
            workspace=workspace,
            metadata=metadata,
        )
        print("IMPLEMENTATION_COMPLETION_GATE=rejected")
        print("IMPLEMENTATION_COMPLETION_CLASSIFICATION=" + rejection_code)
        print("IMPLEMENTATION_COMPLETION_REASON_CODES=" + ",".join(reason_codes))
        print(
            "IMPLEMENTATION_COMPLETION_DIAGNOSTIC_PATH="
            + display_path(diagnostic_path)
        )
        fail(
            "implementation completion rejected before gate_no_conflict/analyze_changes; "
            f"inspect {display_path(diagnostic_path)} and take operator action",
            failure_code=rejection_code,
        )

    if explicit_partial:
        error = {
            "failure_code": "implementation_continuation_required",
            "reason_codes": reason_codes,
            "criterion_failures": criterion_failures,
            "message": (
                "The broad implementation pass is partial but unblocked; independent semantic verification and bounded recovery must continue the canonical-plan backlog."
            ),
        }
        diagnostic_path = write_implementation_completion_diagnostic(
            status="partial",
            submission=submission,
            validation_error=error,
            workspace=workspace,
            metadata=metadata,
        )
        print("IMPLEMENTATION_COMPLETION_GATE=partial")
        print(
            "IMPLEMENTATION_COMPLETION_CLASSIFICATION=implementation_continuation_required"
        )
        print("IMPLEMENTATION_COMPLETION_REASON_CODES=" + ",".join(reason_codes))
        print(
            "IMPLEMENTATION_COMPLETION_DIAGNOSTIC_PATH="
            + display_path(diagnostic_path)
        )
        print_list("IMPLEMENTATION_COMPLETION_CHANGED_FILES", actual_files)
        return

    if reason_codes:
        error = {
            "failure_code": "implementation_completion_evidence_invalid",
            "reason_codes": reason_codes,
            "criterion_failures": criterion_failures,
            "message": (
                "The agent claimed completion, but required current-tree acceptance evidence is missing or contradictory."
            ),
        }
        diagnostic_path = write_implementation_completion_diagnostic(
            status="rejected",
            submission=submission,
            validation_error=error,
            workspace=workspace,
            metadata=metadata,
        )
        print("IMPLEMENTATION_COMPLETION_GATE=rejected")
        print(
            "IMPLEMENTATION_COMPLETION_CLASSIFICATION=implementation_completion_evidence_invalid"
        )
        print("IMPLEMENTATION_COMPLETION_REASON_CODES=" + ",".join(reason_codes))
        print(
            "IMPLEMENTATION_COMPLETION_DIAGNOSTIC_PATH="
            + display_path(diagnostic_path)
        )
        fail(
            "implementation completion evidence rejected before gate_no_conflict/analyze_changes; "
            f"inspect {display_path(diagnostic_path)} and take operator action",
            failure_code="implementation_completion_evidence_invalid",
        )

    diagnostic_path = write_implementation_completion_diagnostic(
        status="accepted",
        submission=submission,
        validation_error=None,
        workspace=workspace,
        metadata=metadata,
    )
    print("IMPLEMENTATION_COMPLETION_GATE=passed")
    print(
        "IMPLEMENTATION_COMPLETION_DIAGNOSTIC_PATH="
        + display_path(diagnostic_path)
    )
    print_list("IMPLEMENTATION_COMPLETION_CHANGED_FILES", actual_files)


def require_execplan_metadata(metadata: dict[str, Any]) -> tuple[str, str]:
    source_kind = metadata.get("source_kind")
    if source_kind != "execplan":
        fail(
            "plan-completion checks only apply to execplan implementation workflows; "
            f"found source_kind={source_kind!r}",
            failure_code="plan_completion_verdict_malformed",
        )
    plan_path = str(metadata.get("plan_path") or "").strip()
    if not plan_path:
        fail(
            f"missing plan_path in {METADATA_PATH}; run "
            "scherzo-execplan implementation-prepare first",
            failure_code="plan_completion_verdict_malformed",
        )
    base_change_id = str(metadata.get("base_change_id") or "").strip()
    if not base_change_id:
        fail(
            f"missing base_change_id in {METADATA_PATH}; run prepare first",
            failure_code="plan_completion_verdict_malformed",
        )
    return plan_path, base_change_id


def changed_files_in_current_patch() -> list[str]:
    if workspace_driver_available():
        return workspace_driver_changed_files()
    output = run([
        "jj",
        "diff",
        "--from",
        "@-",
        "--to",
        "@",
        "--name-only",
        "--color=never",
    ])
    return clean_lines(output)


def current_patch_diff() -> str:
    if workspace_driver_available():
        return workspace_driver_diff_text()
    return run(["jj", "diff", "--from", "@-", "--to", "@", "--color=never"])


def sha256_json(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def plan_completion_snapshot(metadata: dict[str, Any]) -> dict[str, Any]:
    plan_path, base_change_id = require_execplan_metadata(metadata)
    changed_files = changed_files_in_current_patch()
    diff = current_patch_diff()
    if workspace_driver_available():
        baseline = workspace_driver_baseline()
        verified_base_change_id = str(baseline["baseline_id"])
        verified_change_id = str(baseline["change_id"])
        verified_parent_commit_ids = [str(baseline["baseline_id"])]
    else:
        verified_base_change_id = base_change_id
        verified_change_id = current_change_id_short()
        verified_parent_commit_ids = current_parent_commit_ids()
    fingerprint = sha256_json(
        {
            "schema_version": 1,
            "changed_files": changed_files,
            "diff": diff,
        }
    )
    snapshot = {
        "schema_version": 1,
        "source_kind": "execplan",
        "plan_path": plan_path,
        "verified_base_change_id": verified_base_change_id,
        "verified_change_id": verified_change_id,
        "verified_parent_commit_ids": verified_parent_commit_ids,
        "verified_diff_fingerprint": fingerprint,
        "changed_files": changed_files,
        "verdict_path": plan_completion_verdict_display_path(),
    }
    for metadata_key, context_key in [
        ("plan_brief_status", "plan_brief_status"),
        ("plan_brief_path", "plan_brief_path"),
        ("plan_index_path", "plan_index_path"),
        ("plan_source_sha256", "plan_source_sha256"),
    ]:
        value = metadata.get(metadata_key)
        if isinstance(value, str) and value.strip():
            snapshot[context_key] = value.strip()
    return snapshot


def plan_completion_context_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    if not workspace_driver_available():
        require_command("jj")
    metadata = load_implementation_metadata()
    context = plan_completion_snapshot(metadata)
    write_state_backed_json(PLAN_COMPLETION_CONTEXT_PATH, CANONICAL_PLAN_COMPLETION_CONTEXT_NAME, context)
    print(f"PLAN_COMPLETION_CONTEXT_PATH={display_path(state_backed_path(PLAN_COMPLETION_CONTEXT_PATH, CANONICAL_PLAN_COMPLETION_CONTEXT_NAME))}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={plan_completion_verdict_display_path()}")
    print(f"PLAN_COMPLETION_PLAN_PATH={context['plan_path']}")
    print(f"PLAN_COMPLETION_BASE_CHANGE_ID={context['verified_base_change_id']}")
    print(f"PLAN_COMPLETION_CHANGE_ID={context['verified_change_id']}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(context["verified_diff_fingerprint"])
    )
    if "plan_brief_status" in context:
        print(f"PLAN_BRIEF_STATUS={context['plan_brief_status']}")
    if "plan_brief_path" in context:
        print(f"PLAN_BRIEF_PATH={context['plan_brief_path']}")
    if "plan_index_path" in context:
        print(f"PLAN_INDEX_PATH={context['plan_index_path']}")
    if "plan_source_sha256" in context:
        print(f"PLAN_SOURCE_SHA256={context['plan_source_sha256']}")
    print_list("PLAN_COMPLETION_CHANGED_FILES", context["changed_files"])


def fail_plan_completion_gate(
    message: str,
    *,
    failure_code: str,
    exit_code: int = 1,
) -> None:
    print("PLAN_COMPLETION_GATE=failed")
    fail(message, failure_code=failure_code, exit_code=exit_code)


PLAN_COMPLETION_MACHINE_FIELDS = {
    "plan_path",
    "verified_base_change_id",
    "verified_change_id",
    "verified_parent_commit_ids",
    "verified_diff_fingerprint",
    "changed_files",
    "verdict_path",
}
PLAN_COMPLETION_SUBMISSION_FIELDS = {
    "verdict",
    "blocking_findings",
    "evidence",
    "checked_acceptance_criteria",
    "deferred_manual_verification",
}
PLAN_COMPLETION_SUBMISSION_OPTIONAL_FIELDS = {"schema_version"}
PLAN_COMPLETION_SUBMISSION_ARTIFACT_NAME = "plan_completion_verdict_submission"
PLAN_COMPLETION_SUBMISSION_TOOL_NAME = "submit_plan_completion_verdict"


def fail_plan_completion_submission(
    message: str,
    *,
    failure_code: str = "plan_completion_submission_malformed",
) -> None:
    fail_plan_completion_gate(message, failure_code=failure_code)


def unwrap_plan_completion_structured_artifact(
    value: dict[str, Any],
    *,
    expected_step_id: str | None = None,
    expected_artifact_name: str | None = None,
    require_structured_output: bool = False,
) -> dict[str, Any]:
    if value.get("artifact_type") != "structured_output":
        if require_structured_output:
            fail_plan_completion_submission(
                "retained plan-completion submission must be a structured_output artifact "
                f"from {PLAN_COMPLETION_SUBMISSION_TOOL_NAME}",
            )
        return value

    wrapper_errors: list[str] = []
    if value.get("schema_version") != 1:
        wrapper_errors.append("schema_version must be 1")
    if value.get("format") != "json":
        wrapper_errors.append("format must be json")
    if expected_step_id is not None and value.get("step_id") != expected_step_id:
        wrapper_errors.append(f"step_id must be {expected_step_id}")
    if expected_artifact_name is not None and value.get("artifact_name") != expected_artifact_name:
        wrapper_errors.append(f"artifact_name must be {expected_artifact_name}")
    if value.get("source_type") != "pi_tool_call":
        wrapper_errors.append("source_type must be pi_tool_call")
    if value.get("source_tool_name") != PLAN_COMPLETION_SUBMISSION_TOOL_NAME:
        wrapper_errors.append(
            f"source_tool_name must be {PLAN_COMPLETION_SUBMISSION_TOOL_NAME}"
        )

    payload = value.get("payload")
    if not isinstance(payload, dict):
        wrapper_errors.append("payload must be a JSON object")

    if wrapper_errors:
        fail_plan_completion_submission(
            "invalid structured-output artifact for plan-completion verdict submission: "
            + "; ".join(wrapper_errors),
        )
    return payload


def read_plan_completion_submission(
    submission_path: str | None,
    *,
    expected_step_id: str | None = None,
    expected_artifact_name: str | None = None,
    require_structured_output: bool = False,
) -> dict[str, Any]:
    if submission_path:
        label = submission_path
        try:
            payload = Path(submission_path).read_text(encoding="utf-8")
        except OSError as exc:
            fail_plan_completion_submission(
                f"could not read plan-completion submission {submission_path}: {exc}",
                failure_code="plan_completion_submission_missing",
            )
    else:
        label = "stdin"
        payload = sys.stdin.read()
    if not payload.strip():
        fail_plan_completion_submission(
            f"plan-completion structured-output submission on {label} is required",
            failure_code="plan_completion_submission_missing",
        )
    try:
        value = json.loads(payload)
    except json.JSONDecodeError as exc:
        fail_plan_completion_submission(
            f"plan-completion structured-output submission on {label} must be valid JSON: {exc}",
        )
    if not isinstance(value, dict):
        fail_plan_completion_submission(
            f"plan-completion structured-output submission on {label} must be a JSON object",
        )
    return unwrap_plan_completion_structured_artifact(
        value,
        expected_step_id=expected_step_id,
        expected_artifact_name=expected_artifact_name,
        require_structured_output=require_structured_output,
    )


def submission_string_list_field(value: dict[str, Any], key: str) -> list[str]:
    field = value.get(key)
    if not isinstance(field, list):
        fail_plan_completion_submission(
            f"plan-completion submission field {key!r} must be a list of strings",
        )
    strings: list[str] = []
    for item in field:
        if not isinstance(item, str):
            fail_plan_completion_submission(
                f"plan-completion submission field {key!r} must be a list of strings",
            )
        strings.append(item)
    return strings


def submission_deferred_manual_verification_field(
    value: dict[str, Any],
) -> list[dict[str, str]]:
    field = value.get("deferred_manual_verification", [])
    if not isinstance(field, list):
        fail_plan_completion_submission(
            "plan-completion submission field 'deferred_manual_verification' must be a list of objects",
        )
    entries: list[dict[str, str]] = []
    for item in field:
        if not isinstance(item, dict):
            fail_plan_completion_submission(
                "plan-completion submission field 'deferred_manual_verification' must be a list of objects",
            )
        entry: dict[str, str] = {}
        for key in ["check", "reason", "owner", "when"]:
            item_value = item.get(key)
            if not isinstance(item_value, str) or not item_value.strip():
                fail_plan_completion_submission(
                    "plan-completion submission deferred manual verification entries must include non-empty "
                    f"{key!r}",
                )
            entry[key] = item_value.strip()
        entries.append(entry)
    return entries


def validate_plan_completion_submission_shape(
    submission: dict[str, Any],
) -> dict[str, Any]:
    schema_version = submission.get("schema_version")
    if schema_version is not None and schema_version != 1:
        fail_plan_completion_submission(
            "plan-completion submission schema_version, when present, must be 1",
        )
    raw_verdict = submission.get("verdict")
    if raw_verdict not in {"pass", "fail"}:
        fail_plan_completion_submission(
            "plan-completion submission field 'verdict' must be 'pass' or 'fail'",
        )
    machine_fields = sorted(
        field for field in PLAN_COMPLETION_MACHINE_FIELDS if field in submission
    )
    if machine_fields:
        fail_plan_completion_submission(
            "plan-completion submission must not include workspace-stamped fields: "
            + ", ".join(machine_fields),
        )
    unexpected_fields = sorted(
        field
        for field in submission
        if field
        not in PLAN_COMPLETION_SUBMISSION_FIELDS
        | PLAN_COMPLETION_SUBMISSION_OPTIONAL_FIELDS
    )
    if unexpected_fields:
        fail_plan_completion_submission(
            "plan-completion submission must not include unexpected fields: "
            + ", ".join(unexpected_fields),
        )
    blocking_findings = submission_string_list_field(
        submission,
        "blocking_findings",
    )
    if raw_verdict == "pass" and blocking_findings:
        fail_plan_completion_submission(
            "plan-completion submission pass verdict must not include blocking_findings",
        )
    if raw_verdict == "fail" and not blocking_findings:
        fail_plan_completion_submission(
            "plan-completion submission fail verdict must include at least one blocking_finding",
        )
    return {
        "verdict": raw_verdict,
        "blocking_findings": blocking_findings,
        "evidence": submission_string_list_field(submission, "evidence"),
        "checked_acceptance_criteria": submission_string_list_field(
            submission,
            "checked_acceptance_criteria",
        ),
        "deferred_manual_verification": submission_deferred_manual_verification_field(
            submission,
        ),
    }


def string_list_field(value: dict[str, Any], key: str) -> list[str]:
    field = value.get(key)
    if not isinstance(field, list):
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} field {key!r} must be a list of strings",
            failure_code="plan_completion_verdict_malformed",
        )
    strings: list[str] = []
    for item in field:
        if not isinstance(item, str):
            fail_plan_completion_gate(
                f"{plan_completion_verdict_display_path()} field {key!r} must be a list of strings",
                failure_code="plan_completion_verdict_malformed",
            )
        strings.append(item)
    return strings


def deferred_manual_verification_field(value: dict[str, Any]) -> list[dict[str, str]]:
    field = value.get("deferred_manual_verification", [])
    if not isinstance(field, list):
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} field 'deferred_manual_verification' must be a list of objects",
            failure_code="plan_completion_verdict_malformed",
        )
    entries: list[dict[str, str]] = []
    for item in field:
        if not isinstance(item, dict):
            fail_plan_completion_gate(
                f"{plan_completion_verdict_display_path()} field 'deferred_manual_verification' must be a list of objects",
                failure_code="plan_completion_verdict_malformed",
            )
        entry: dict[str, str] = {}
        for key in ["check", "reason", "owner", "when"]:
            item_value = item.get(key)
            if not isinstance(item_value, str) or not item_value.strip():
                fail_plan_completion_gate(
                    f"{plan_completion_verdict_display_path()} deferred manual verification entries must include non-empty {key!r}",
                    failure_code="plan_completion_verdict_malformed",
                )
            entry[key] = item_value.strip()
        entries.append(entry)
    return entries


def deferred_manual_verification_summaries(entries: list[dict[str, str]]) -> list[str]:
    summaries: list[str] = []
    for entry in entries:
        summaries.append(
            f"{entry['check']} (owner: {entry['owner']}; when: {entry['when']}; reason: {entry['reason']})"
        )
    return summaries


def required_string_field(value: dict[str, Any], key: str) -> str:
    field = value.get(key)
    if not isinstance(field, str) or not field.strip():
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} field {key!r} must be a non-empty string",
            failure_code="plan_completion_verdict_malformed",
        )
    return field.strip()


def load_plan_completion_verdict() -> dict[str, Any]:
    primary = plan_completion_verdict_path()
    source = primary
    if not source.exists() and primary != PLAN_COMPLETION_VERDICT_PATH and PLAN_COMPLETION_VERDICT_PATH.exists():
        source = PLAN_COMPLETION_VERDICT_PATH
    if not source.exists():
        fail_plan_completion_gate(
            f"missing {plan_completion_verdict_display_path()}; the plan-completion checkpoint step must stamp this artifact before review/publish",
            failure_code="plan_completion_verdict_missing",
        )
    try:
        verdict = json.loads(source.read_text())
    except json.JSONDecodeError as exc:
        fail_plan_completion_gate(
            f"invalid JSON in {display_path(source)}: {exc}",
            failure_code="plan_completion_verdict_malformed",
        )
    if not isinstance(verdict, dict):
        fail_plan_completion_gate(
            f"{display_path(source)} must contain a JSON object",
            failure_code="plan_completion_verdict_malformed",
        )
    if source != primary:
        write_json(primary, verdict)
    if primary != PLAN_COMPLETION_VERDICT_PATH:
        copy_best_effort(primary, PLAN_COMPLETION_VERDICT_PATH)
    return verdict


def validate_plan_completion_verdict_shape(verdict: dict[str, Any]) -> dict[str, Any]:
    if verdict.get("schema_version") != 1:
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} must set schema_version to 1",
            failure_code="plan_completion_verdict_malformed",
        )
    raw_verdict = verdict.get("verdict")
    if raw_verdict not in {"pass", "fail"}:
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} field 'verdict' must be 'pass' or 'fail'",
            failure_code="plan_completion_verdict_malformed",
        )
    blocking_findings = string_list_field(verdict, "blocking_findings")
    if raw_verdict == "pass" and blocking_findings:
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} pass verdict must not include blocking_findings",
            failure_code="plan_completion_verdict_malformed",
        )
    if raw_verdict == "fail" and not blocking_findings:
        fail_plan_completion_gate(
            f"{plan_completion_verdict_display_path()} fail verdict must include at least one blocking_finding",
            failure_code="plan_completion_verdict_malformed",
        )
    evidence = string_list_field(verdict, "evidence")
    checked_acceptance_criteria = string_list_field(
        verdict,
        "checked_acceptance_criteria",
    )
    plan_path = required_string_field(verdict, "plan_path")
    verified_base_change_id = required_string_field(
        verdict,
        "verified_base_change_id",
    )
    verified_change_id = required_string_field(verdict, "verified_change_id")
    verified_diff_fingerprint = required_string_field(
        verdict,
        "verified_diff_fingerprint",
    )
    if not re.fullmatch(r"[0-9a-f]{64}", verified_diff_fingerprint):
        fail_plan_completion_gate(
            "verified_diff_fingerprint must be a lowercase SHA-256 hex digest",
            failure_code="plan_completion_verdict_malformed",
        )
    changed_files = string_list_field(verdict, "changed_files")
    deferred_manual_verification = deferred_manual_verification_field(verdict)
    return {
        "verdict": raw_verdict,
        "blocking_findings": blocking_findings,
        "evidence": evidence,
        "checked_acceptance_criteria": checked_acceptance_criteria,
        "plan_path": plan_path,
        "verified_base_change_id": verified_base_change_id,
        "verified_change_id": verified_change_id,
        "verified_diff_fingerprint": verified_diff_fingerprint,
        "changed_files": changed_files,
        "deferred_manual_verification": deferred_manual_verification,
    }


def current_plan_completion_verdict(
    metadata: dict[str, Any],
    *,
    gate_label: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    current_plan_path, _current_base_change_id = require_execplan_metadata(metadata)
    verdict = validate_plan_completion_verdict_shape(load_plan_completion_verdict())
    if not workspace_driver_available():
        require_command("jj")
    current = plan_completion_snapshot(metadata)

    if verdict["plan_path"] != current_plan_path:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for plan {verdict['plan_path']!r}; current plan is {current_plan_path!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_base_change_id"] != current["verified_base_change_id"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for base change {verdict['verified_base_change_id']!r}; current base is {current['verified_base_change_id']!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_change_id"] != current["verified_change_id"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict for change {verdict['verified_change_id']!r}; current change is {current['verified_change_id']!r}",
            failure_code="plan_completion_verdict_stale",
        )
    if verdict["verified_diff_fingerprint"] != current["verified_diff_fingerprint"]:
        fail_plan_completion_gate(
            f"{gate_label} found a stale verdict fingerprint; rerun plan-completion verification after the latest implementation changes",
            failure_code="plan_completion_verdict_stale",
        )
    return verdict, current


def canonical_plan_completion_verdict_path() -> Path | None:
    return canonical_implementation_state_path(CANONICAL_PLAN_COMPLETION_VERDICT_NAME)


def plan_completion_verdict_path() -> Path:
    return state_backed_path(PLAN_COMPLETION_VERDICT_PATH, CANONICAL_PLAN_COMPLETION_VERDICT_NAME)


def plan_completion_verdict_display_path() -> str:
    return display_path(plan_completion_verdict_path())


def maybe_load_json_object(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) else None


def attempt_index_from_name(name: str) -> int | None:
    match = re.fullmatch(r"attempt-(\d+)(?:\.json)?", name)
    if match is None:
        return None
    try:
        return int(match.group(1))
    except ValueError:
        return None


def resolve_path_within(path: Path, root: Path) -> Path | None:
    try:
        root_resolved = root.resolve(strict=True)
        path_resolved = path.resolve(strict=True)
        path_resolved.relative_to(root_resolved)
    except (OSError, RuntimeError, ValueError):
        return None
    return path_resolved


def resolve_file_within(path: Path, root: Path) -> Path | None:
    resolved = resolve_path_within(path, root)
    if resolved is None or not resolved.is_file():
        return None
    return resolved


def structured_output_candidate_paths(path_text: str, artifact_dir: Path) -> list[Path]:
    candidate = Path(path_text)
    if candidate.is_absolute():
        return [candidate]
    return [artifact_dir / candidate, candidate]


def sha256_file(path: Path) -> str | None:
    return workflow_json.sha256_file(path, missing_ok=True)


def structured_output_sha_matches(path: Path, structured_output: dict[str, Any]) -> bool:
    expected_sha = structured_output.get("sha256")
    if not isinstance(expected_sha, str) or not expected_sha:
        return True
    if re.fullmatch(r"[0-9a-fA-F]{64}", expected_sha) is None:
        return False
    actual_sha = sha256_file(path)
    return actual_sha is not None and actual_sha.lower() == expected_sha.lower()


def structured_output_ref_matches(
    path: Path,
    artifact_dir: Path,
    structured_output: dict[str, Any],
) -> bool:
    expected_ref = structured_output.get("ref")
    if not isinstance(expected_ref, str) or not expected_ref:
        return True
    try:
        artifact_dir_resolved = artifact_dir.resolve(strict=True)
    except (OSError, RuntimeError):
        return False
    normalized_ref = expected_ref.lstrip("./")
    candidate_roots = [artifact_dir_resolved, artifact_dir_resolved.parent]
    if artifact_dir_resolved.parent.name == "runs":
        candidate_roots.append(artifact_dir_resolved.parent.parent)
    for root in candidate_roots:
        try:
            if path.relative_to(root).as_posix() == normalized_ref:
                return True
        except ValueError:
            continue
    return False


def step_artifact_payload(value: dict[str, Any]) -> dict[str, Any]:
    artifact = value.get("artifact")
    return artifact if isinstance(artifact, dict) else value


def expected_plan_completion_submission_path(
    *,
    artifact_dir: Path,
    step_id: str,
    artifact_name: str,
    attempt_index: int,
) -> Path:
    return (
        artifact_dir
        / step_id
        / f"attempt-{attempt_index}"
        / "structured"
        / f"{artifact_name}.json"
    )


def plan_completion_step_metadata_paths(
    artifact_dir: Path,
    step_id: str,
) -> list[tuple[int, Path]]:
    if not artifact_dir.exists() or not artifact_dir.is_dir():
        return []
    candidates: list[tuple[int, Path]] = []
    try:
        step_dirs = list(artifact_dir.iterdir())
    except OSError:
        return []
    for step_dir in step_dirs:
        if step_dir.name != step_id and not step_dir.name.startswith(step_id + "-"):
            continue
        resolved_step_dir = resolve_path_within(step_dir, artifact_dir)
        if resolved_step_dir is None or not resolved_step_dir.is_dir():
            continue
        try:
            attempt_files = list(resolved_step_dir.glob("attempt-*.json"))
        except OSError:
            continue
        for attempt_file in attempt_files:
            attempt_index = attempt_index_from_name(attempt_file.name)
            resolved_attempt_file = resolve_file_within(attempt_file, artifact_dir)
            if attempt_index is not None and resolved_attempt_file is not None:
                candidates.append((attempt_index, resolved_attempt_file))
    return sorted(candidates, key=lambda item: item[0], reverse=True)


def structured_output_path_from_step_metadata(
    metadata_path: Path,
    *,
    step_id: str,
    artifact_name: str,
    artifact_dir: Path,
    attempt_index: int | None,
) -> Path | None:
    metadata = maybe_load_json_object(metadata_path)
    if metadata is None:
        return None
    artifact = step_artifact_payload(metadata)
    if artifact.get("status") != "success" and artifact.get("state") != "succeeded":
        return None
    structured_output = artifact.get("structured_output")
    if not isinstance(structured_output, dict):
        return None
    if structured_output.get("status") != "valid":
        return None
    recorded_artifact_name = structured_output.get("artifact_name")
    if isinstance(recorded_artifact_name, str) and recorded_artifact_name != artifact_name:
        return None
    path_text = structured_output.get("path")
    if not isinstance(path_text, str) or not path_text:
        return None

    expected_path = None
    if attempt_index is not None:
        expected_path = resolve_file_within(
            expected_plan_completion_submission_path(
                artifact_dir=artifact_dir,
                step_id=step_id,
                artifact_name=artifact_name,
                attempt_index=attempt_index,
            ),
            artifact_dir,
        )
        if expected_path is None:
            return None

    for candidate in structured_output_candidate_paths(path_text, artifact_dir):
        resolved_candidate = resolve_file_within(candidate, artifact_dir)
        if resolved_candidate is None:
            continue
        if expected_path is not None and resolved_candidate != expected_path:
            continue
        if structured_output_ref_matches(
            resolved_candidate,
            artifact_dir,
            structured_output,
        ) and structured_output_sha_matches(resolved_candidate, structured_output):
            return resolved_candidate
    return None


def structured_plan_completion_submission_candidates(
    *,
    artifact_dir: Path,
    step_id: str,
    artifact_name: str,
) -> list[tuple[int, Path]]:
    step_dir = artifact_dir / step_id
    resolved_step_dir = resolve_path_within(step_dir, artifact_dir)
    if resolved_step_dir is None or not resolved_step_dir.is_dir():
        return []
    candidates: list[tuple[int, Path]] = []
    try:
        attempt_dirs = list(resolved_step_dir.iterdir())
    except OSError:
        return []
    for attempt_dir in attempt_dirs:
        if not attempt_dir.is_dir():
            continue
        attempt_index = attempt_index_from_name(attempt_dir.name)
        if attempt_index is None:
            continue
        candidate = attempt_dir / "structured" / f"{artifact_name}.json"
        resolved_candidate = resolve_file_within(candidate, artifact_dir)
        if resolved_candidate is not None:
            candidates.append((attempt_index, resolved_candidate))
    return sorted(candidates, key=lambda item: item[0], reverse=True)


def default_run_artifact_dir() -> Path | None:
    explicit = os.environ.get("SCHERZO_RUN_ARTIFACT_DIR", "").strip()
    if explicit:
        return Path(explicit)
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    run_id = os.environ.get("SCHERZO_RUN_ID", "").strip()
    if not run_root or not run_id:
        return None
    run_root_path = Path(run_root)
    candidates = [
        run_root_path / ".scherzo-state" / "artifacts" / "runs" / run_id,
        run_root_path.parent.parent.parent / ".scherzo-state" / "artifacts" / "runs" / run_id,
    ]
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def resolve_plan_completion_submission_path(
    *,
    submission_path: str | None,
    submission_step: str | None,
    artifact_name: str,
    artifact_dir: str | None,
) -> Path:
    if submission_path is not None:
        path = Path(submission_path)
        if path.is_file():
            return path

    resolved_artifact_dir: Path | None = None
    if artifact_dir is not None:
        resolved_artifact_dir = Path(artifact_dir)
    elif submission_step is not None:
        resolved_artifact_dir = default_run_artifact_dir()

    if submission_step is not None and resolved_artifact_dir is not None:
        for attempt_index, metadata_path in plan_completion_step_metadata_paths(
            resolved_artifact_dir,
            submission_step,
        ):
            resolved = structured_output_path_from_step_metadata(
                metadata_path,
                step_id=submission_step,
                artifact_name=artifact_name,
                artifact_dir=resolved_artifact_dir,
                attempt_index=attempt_index,
            )
            if resolved is not None:
                return resolved
        candidates = structured_plan_completion_submission_candidates(
            artifact_dir=resolved_artifact_dir,
            step_id=submission_step,
            artifact_name=artifact_name,
        )
        if candidates:
            return candidates[0][1]

    if submission_path is not None:
        return Path(submission_path)

    location = str(resolved_artifact_dir) if resolved_artifact_dir is not None else "<missing artifact dir>"
    fail_plan_completion_submission(
        "could not resolve retained structured-output plan-completion submission "
        f"for step {submission_step!r} artifact {artifact_name!r} under {location}",
        failure_code="plan_completion_submission_missing",
    )


def parse_checkpoint_plan_completion_verdict_args(
    args: list[str],
) -> tuple[str | None, str | None, str, str | None]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--submission")
    parser.add_argument("--submission-step")
    parser.add_argument(
        "--submission-artifact",
        default=PLAN_COMPLETION_SUBMISSION_ARTIFACT_NAME,
    )
    parser.add_argument("--artifact-dir")
    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        usage()
        sys.exit(2)
    submission_path = parsed.submission
    submission_step = parsed.submission_step
    artifact_name = str(parsed.submission_artifact or PLAN_COMPLETION_SUBMISSION_ARTIFACT_NAME)
    artifact_dir = parsed.artifact_dir
    if submission_path and (submission_step or artifact_dir):
        usage()
        sys.exit(2)
    if artifact_dir and not submission_step:
        usage()
        sys.exit(2)
    if not submission_path and not submission_step:
        if artifact_name != PLAN_COMPLETION_SUBMISSION_ARTIFACT_NAME or artifact_dir:
            usage()
            sys.exit(2)
    return submission_path, submission_step, artifact_name, artifact_dir


def checkpoint_plan_completion_verdict_command(args: list[str]) -> None:
    submission_path, submission_step, artifact_name, artifact_dir = (
        parse_checkpoint_plan_completion_verdict_args(args)
    )
    canonical_path = canonical_plan_completion_verdict_path()
    if canonical_path is None:
        fail(
            "SCHERZO_RUN_ROOT is required to checkpoint plan-completion verdicts",
            failure_code="plan_completion_checkpoint_unavailable",
        )
    metadata = load_implementation_metadata()

    if submission_path is not None or submission_step is not None:
        assert_plan_completion_validator_workspace()
        resolved_submission_path = resolve_plan_completion_submission_path(
            submission_path=submission_path,
            submission_step=submission_step,
            artifact_name=artifact_name,
            artifact_dir=artifact_dir,
        )
        submission = validate_plan_completion_submission_shape(
            read_plan_completion_submission(
                str(resolved_submission_path),
                expected_step_id=submission_step,
                expected_artifact_name=(
                    artifact_name if submission_step is not None else None
                ),
                require_structured_output=submission_step is not None,
            ),
        )
        if not workspace_driver_available():
            require_command("jj")
        current = plan_completion_snapshot(metadata)
        stamped = stamped_plan_completion_verdict(submission, current)
        verdict_path = write_plan_completion_validator_verdict(stamped)
        assert_plan_completion_workspace_stable(
            current,
            plan_completion_snapshot(metadata),
        )
        verdict = validate_plan_completion_verdict_shape(stamped)
        print("PLAN_COMPLETION_VERDICT_CHECKPOINT=written")
        print("PLAN_COMPLETION_VERDICT_SOURCE=structured_output")
        print(f"PLAN_COMPLETION_VERDICT_SUBMISSION_PATH={display_path(resolved_submission_path)}")
        print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
        print(f"PLAN_COMPLETION_VERDICT_PATH={display_path(verdict_path)}")
        print(f"PLAN_COMPLETION_CANONICAL_VERDICT_PATH={display_path(canonical_path)}")
        print(
            "PLAN_COMPLETION_DIFF_FINGERPRINT="
            + str(current["verified_diff_fingerprint"])
        )
        return

    verdict, current = current_plan_completion_verdict(
        metadata,
        gate_label="plan-completion verdict checkpoint",
    )
    canonical_path.parent.mkdir(parents=True, exist_ok=True)
    write_json(canonical_path, load_plan_completion_verdict())
    copy_best_effort(canonical_path, PLAN_COMPLETION_VERDICT_PATH)
    print("PLAN_COMPLETION_VERDICT_CHECKPOINT=written")
    print("PLAN_COMPLETION_VERDICT_SOURCE=existing_artifact")
    print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={plan_completion_verdict_display_path()}")
    print(f"PLAN_COMPLETION_CANONICAL_VERDICT_PATH={display_path(canonical_path)}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(current["verified_diff_fingerprint"])
    )


def plan_completion_retry_command(metadata: dict[str, Any]) -> str:
    issue_identifier = implementation_issue_identifier(metadata)
    if issue_identifier:
        return f"scherzoctl task retry {issue_identifier}"
    return "scherzoctl task retry <issue>"


def plan_completion_recovery_summary_markdown(payload: dict[str, Any]) -> str:
    lines = [
        "# Plan-completion recovery summary",
        "",
        f"- Status: `{payload['status']}`",
        f"- Phase: `{payload['phase']}`",
        f"- Attempt: `{payload['attempt']}` of `{payload['max_attempts']}`",
        f"- Verdict artifact: `{payload['verdict_path']}`",
        f"- Recovery JSON: `{display_path(state_backed_path(PLAN_COMPLETION_RECOVERY_PATH, CANONICAL_PLAN_COMPLETION_RECOVERY_NAME))}`",
    ]
    if payload.get("recovery_summary_path"):
        lines.append(f"- Recovery summary: `{payload['recovery_summary_path']}`")
    if payload.get("plan_path"):
        lines.append(f"- Review doc: `{payload['plan_path']}`")
    if payload.get("retention_marker"):
        lines.append(f"- Retention marker: `{payload['retention_marker']}`")
    if payload.get("retry_command"):
        lines.append(f"- Retry command: `{payload['retry_command']}`")
    lines.extend(["", "## Blocking findings", ""])
    blocking_findings = payload.get("blocking_findings") or []
    if blocking_findings:
        lines.extend(f"- {finding}" for finding in blocking_findings)
    else:
        lines.append("- None")
    lines.extend(["", "## Deferred manual verification", ""])
    deferred_manual_verification = payload.get("deferred_manual_verification") or []
    deferred_summaries = deferred_manual_verification_summaries(
        deferred_manual_verification
    )
    if deferred_summaries:
        lines.extend(f"- {item}" for item in deferred_summaries)
    else:
        lines.append("- None")
    lines.extend([
        "",
        "## Next action",
        "",
        str(payload.get("next_action") or "None."),
    ])
    return "\n".join(lines) + "\n"


def write_plan_completion_recovery_artifacts(payload: dict[str, Any]) -> None:
    write_state_backed_json(PLAN_COMPLETION_RECOVERY_PATH, CANONICAL_PLAN_COMPLETION_RECOVERY_NAME, payload)
    PLAN_COMPLETION_RECOVERY_SUMMARY_PATH.parent.mkdir(parents=True, exist_ok=True)
    PLAN_COMPLETION_RECOVERY_SUMMARY_PATH.write_text(
        plan_completion_recovery_summary_markdown(payload),
        encoding="utf-8",
    )


def print_plan_completion_recovery_summary(payload: dict[str, Any]) -> None:
    print(f"PLAN_COMPLETION_RECOVERY_STATUS={payload['status']}")
    print(f"PLAN_COMPLETION_RECOVERY_PHASE={payload['phase']}")
    print(f"PLAN_COMPLETION_RECOVERY_ATTEMPT={payload['attempt']}")
    print(f"PLAN_COMPLETION_RECOVERY_MAX_ATTEMPTS={payload['max_attempts']}")
    print(f"PLAN_COMPLETION_VERDICT={payload['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={payload['verdict_path']}")
    print(f"PLAN_COMPLETION_RECOVERY_PATH={display_path(state_backed_path(PLAN_COMPLETION_RECOVERY_PATH, CANONICAL_PLAN_COMPLETION_RECOVERY_NAME))}")
    print(
        "PLAN_COMPLETION_RECOVERY_SUMMARY_PATH="
        + str(PLAN_COMPLETION_RECOVERY_SUMMARY_PATH)
    )
    print(f"PLAN_COMPLETION_PLAN_PATH={payload['plan_path']}")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(payload["verified_diff_fingerprint"])
    )
    if payload.get("retry_command"):
        print(f"PLAN_COMPLETION_RETRY_COMMAND={payload['retry_command']}")
    if payload.get("retention_marker"):
        print(f"PLAN_COMPLETION_RETENTION_MARKER={payload['retention_marker']}")
    print_list("PLAN_COMPLETION_BLOCKING_FINDINGS", payload["blocking_findings"])
    print_list(
        "PLAN_COMPLETION_DEFERRED_MANUAL_VERIFICATION",
        deferred_manual_verification_summaries(
            payload["deferred_manual_verification"]
        ),
    )


def parse_plan_completion_recovery_args(args: list[str]) -> tuple[str, int, int]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "--phase",
        required=True,
        choices=[
            "before-late-repair",
            "before-final-repair",
            "after-late-repair",
            "after-final-repair",
            "final",
        ],
    )
    parser.add_argument("--attempt", required=True, type=int)
    parser.add_argument("--max-attempts", required=True, type=int)
    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        usage()
        sys.exit(2)
    return str(parsed.phase), int(parsed.attempt), int(parsed.max_attempts)


# Legacy compatibility for retained workspaces created before plan-completion
# recovery moved onto verifier-step recovery. Checked-in workflows no longer
# dispatch this helper, but older retained runs and operator evidence can still
# reference its artifacts and failure code.
def plan_completion_recovery_command(args: list[str]) -> None:
    phase, attempt, max_attempts = parse_plan_completion_recovery_args(args)
    metadata = load_implementation_metadata()
    verdict, current = current_plan_completion_verdict(
        metadata,
        gate_label="plan-completion recovery",
    )
    payload: dict[str, Any] = {
        "schema_version": 1,
        "status": "not_needed",
        "phase": phase,
        "attempt": attempt,
        "max_attempts": max_attempts,
        "verdict": verdict["verdict"],
        "verdict_path": plan_completion_verdict_display_path(),
        "recovery_summary_path": str(PLAN_COMPLETION_RECOVERY_SUMMARY_PATH),
        "plan_path": str(current["plan_path"]),
        "verified_diff_fingerprint": str(current["verified_diff_fingerprint"]),
        "changed_files": verdict["changed_files"],
        "blocking_findings": verdict["blocking_findings"],
        "checked_acceptance_criteria": verdict["checked_acceptance_criteria"],
        "evidence": verdict["evidence"],
        "deferred_manual_verification": verdict["deferred_manual_verification"],
    }
    if verdict["verdict"] == "pass":
        payload["next_action"] = "No bounded plan-completion repair is needed."
        write_plan_completion_recovery_artifacts(payload)
        print_plan_completion_recovery_summary(payload)
        return

    repair_budget_description = (
        "attempt 1 is apply_plan_completion_feedback; "
        "attempt 2 is the late pre-review repair; "
        "attempt 3 is the final pre-review salvage repair"
    )
    retry_command = plan_completion_retry_command(metadata)
    issue_identifier = implementation_issue_identifier(metadata)
    source_ref = issue_identifier or str(current["plan_path"])

    repair_next_actions = {
        "before-late-repair": "run late plan-completion repair step",
        "before-final-repair": "run final plan-completion repair step",
    }
    if phase in repair_next_actions and attempt <= max_attempts:
        payload.update(
            {
                "status": "repair_needed",
                "retryable": True,
                "repair_budget_description": repair_budget_description,
                "next_action": repair_next_actions[phase],
            }
        )
        write_plan_completion_recovery_artifacts(payload)
        print_plan_completion_recovery_summary(payload)
        return

    write_retention_marker("execplan", source_ref)
    payload.update(
        {
            "status": "exhausted",
            "retryable": False,
            "repair_budget_description": repair_budget_description,
            "failure_code": "plan_completion_recovery_exhausted",
            "retention_marker": RETENTION_MARKER,
            "retry_command": retry_command,
            "next_action": "Inspect or salvage from the retained workspace, then use the normal full workflow retry command when safe: "
            + retry_command,
        }
    )
    write_plan_completion_recovery_artifacts(payload)
    print_plan_completion_recovery_summary(payload)
    fail(
        "plan-completion recovery exhausted; inspect the retained workspace and recovery summary before retrying the full workflow",
        failure_code="plan_completion_recovery_exhausted",
    )


def parse_gate_plan_completion_args(
    args: list[str],
) -> tuple[bool, bool, str | None]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--final", action="store_true")
    parser.add_argument("--from-submission", action="store_true")
    parser.add_argument(
        "--submission",
        help="Read the structured-output submission from this file instead of stdin.",
    )
    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        usage()
        sys.exit(2)
    final_gate = bool(parsed.final)
    from_submission = bool(parsed.from_submission)
    submission_path = parsed.submission
    if final_gate and from_submission:
        usage()
        sys.exit(2)
    if submission_path and not from_submission:
        usage()
        sys.exit(2)
    return final_gate, from_submission, submission_path


def path_contains_or_equals(parent: Path, child: Path) -> bool:
    try:
        child.relative_to(parent)
        return True
    except ValueError:
        return False


def validator_workspace_error(gate_label: str) -> str | None:
    for env_key, location_label in [
        ("SCHERZO_WORKSPACE_PATH", "step workspace"),
        ("SCHERZO_REPO_ROOT", "repository workspace"),
    ]:
        configured_path = os.environ.get(env_key, "").strip()
        if not configured_path:
            continue
        try:
            expected = Path(configured_path).resolve(strict=False)
            cwd = Path.cwd().resolve(strict=False)
        except OSError as exc:
            return f"could not resolve {gate_label} validator {location_label} paths: {exc}"
        if not path_contains_or_equals(expected, cwd):
            return (
                f"{gate_label} validator is not running in the {location_label}: "
                f"cwd={cwd} {env_key}={expected}"
            )
    return None


def assert_implementation_completion_validator_workspace() -> None:
    error = validator_workspace_error("implementation-completion")
    if error is not None:
        fail(
            error,
            failure_code="implementation_completion_workspace_mismatch",
            exit_code=2,
        )


def assert_plan_completion_validator_workspace() -> None:
    error = validator_workspace_error("plan-completion")
    if error is not None:
        fail_plan_completion_gate(
            error,
            failure_code="plan_completion_workspace_mismatch",
            exit_code=2,
        )


def stamped_plan_completion_verdict(
    submission: dict[str, Any],
    current: dict[str, Any],
) -> dict[str, Any]:
    stamped = {
        "schema_version": 1,
        "verdict": submission["verdict"],
        "blocking_findings": submission["blocking_findings"],
        "evidence": submission["evidence"],
        "checked_acceptance_criteria": submission["checked_acceptance_criteria"],
        "plan_path": current["plan_path"],
        "verified_base_change_id": current["verified_base_change_id"],
        "verified_change_id": current["verified_change_id"],
        "verified_parent_commit_ids": current["verified_parent_commit_ids"],
        "verified_diff_fingerprint": current["verified_diff_fingerprint"],
        "changed_files": current["changed_files"],
        "deferred_manual_verification": submission["deferred_manual_verification"],
    }
    return stamped


def assert_plan_completion_workspace_stable(
    before: dict[str, Any],
    after: dict[str, Any],
) -> None:
    for key in [
        "plan_path",
        "verified_base_change_id",
        "verified_change_id",
        "verified_diff_fingerprint",
    ]:
        if before.get(key) != after.get(key):
            fail_plan_completion_gate(
                "plan-completion workspace changed while stamping verdict: "
                f"{key} was {before.get(key)!r}, now {after.get(key)!r}",
                failure_code="plan_completion_workspace_mismatch",
                exit_code=2,
            )


def write_plan_completion_validator_verdict(stamped: dict[str, Any]) -> Path:
    canonical_path = canonical_plan_completion_verdict_path()
    if canonical_path is None:
        fail_plan_completion_gate(
            "SCHERZO_RUN_ROOT is required to stamp plan-completion validator verdicts",
            failure_code="plan_completion_verdict_write_failed",
            exit_code=2,
        )
    try:
        write_json(canonical_path, stamped)
    except OSError as exc:
        fail_plan_completion_gate(
            f"could not write run-root plan-completion verdict {display_path(canonical_path)}: {exc}",
            failure_code="plan_completion_verdict_write_failed",
            exit_code=2,
        )
    return canonical_path


def gate_plan_completion_from_submission_command(submission_path: str | None) -> None:
    assert_plan_completion_validator_workspace()
    submission = validate_plan_completion_submission_shape(
        read_plan_completion_submission(submission_path),
    )
    if not workspace_driver_available():
        require_command("jj")
    metadata = load_implementation_metadata()
    current = plan_completion_snapshot(metadata)
    stamped = stamped_plan_completion_verdict(submission, current)
    verdict_path = write_plan_completion_validator_verdict(stamped)
    assert_plan_completion_workspace_stable(current, plan_completion_snapshot(metadata))
    verdict = validate_plan_completion_verdict_shape(stamped)

    print("PLAN_COMPLETION_GATE_MODE=from_submission")
    print("PLAN_COMPLETION_VERDICT_STAMP=written")
    print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={display_path(verdict_path)}")
    canonical_path = canonical_plan_completion_verdict_path()
    if canonical_path is not None:
        print(f"PLAN_COMPLETION_CANONICAL_VERDICT_PATH={display_path(canonical_path)}")
    print_list(
        "PLAN_COMPLETION_DEFERRED_MANUAL_VERIFICATION",
        deferred_manual_verification_summaries(
            verdict["deferred_manual_verification"]
        ),
    )
    if verdict["verdict"] != "pass":
        print_list("PLAN_COMPLETION_BLOCKING_FINDINGS", verdict["blocking_findings"])
        fail_plan_completion_gate(
            "plan-completion verifier reported blocking findings; code review/publish is blocked until the ExecPlan's promised behavior is complete",
            failure_code="plan_completion_failed",
        )

    print("PLAN_COMPLETION_GATE=passed")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(current["verified_diff_fingerprint"])
    )
    print_list("PLAN_COMPLETION_CHANGED_FILES", list(current["changed_files"]))


def gate_plan_completion_command(args: list[str]) -> None:
    final_gate, from_submission, submission_path = parse_gate_plan_completion_args(args)
    if from_submission:
        gate_plan_completion_from_submission_command(submission_path)
        return
    gate_label = "final plan-completion gate" if final_gate else "plan-completion gate"
    metadata = load_implementation_metadata()
    verdict, current = current_plan_completion_verdict(metadata, gate_label=gate_label)

    print(f"PLAN_COMPLETION_GATE_MODE={'final' if final_gate else 'pre_review'}")
    print(f"PLAN_COMPLETION_VERDICT={verdict['verdict']}")
    print(f"PLAN_COMPLETION_VERDICT_PATH={plan_completion_verdict_display_path()}")
    print_list(
        "PLAN_COMPLETION_DEFERRED_MANUAL_VERIFICATION",
        deferred_manual_verification_summaries(
            verdict["deferred_manual_verification"]
        ),
    )
    if verdict["verdict"] != "pass":
        print_list("PLAN_COMPLETION_BLOCKING_FINDINGS", verdict["blocking_findings"])
        fail_plan_completion_gate(
            "plan-completion verifier reported blocking findings; code review/publish is blocked until the ExecPlan's promised behavior is complete",
            failure_code="plan_completion_failed",
        )

    print("PLAN_COMPLETION_GATE=passed")
    print(
        "PLAN_COMPLETION_DIFF_FINGERPRINT="
        + str(current["verified_diff_fingerprint"])
    )


def print_list(label: str, values: list[str]) -> None:
    print(label + ":")
    if values:
        for value in values:
            print(f"- {value}")
    else:
        print("- None")


def comma_join(values: list[str]) -> str:
    return ",".join(values) if values else "none"


def validation_env() -> dict[str, str]:
    env = os.environ.copy()
    # Validation runs the repository test suite, and some tests execute Scherzo
    # helper scripts against fixture directories. Workflow-run-scoped settings
    # must not leak into those nested helper invocations; otherwise fixtures can
    # infer the outer Scherzo run's issue/run/workspace, use the outer workspace
    # driver/base configuration, or publish against the outer workflow remote
    # instead of their own temporary test context.
    for key in [
        "SCHERZO_CONFIG_DIR",
        "GITHUB_REPOSITORY",
        "SCHERZO_GITHUB_REPO",
        "SCHERZO_ISSUE_ID",
        "SCHERZO_ISSUE_IDENTIFIER",
        "SCHERZO_JJ_WORKSPACE_BASE",
        "SCHERZO_JJ_WORKSPACE_BASE_BRANCH",
        "SCHERZO_JJ_WORKSPACE_FETCH_BASE",
        "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE",
        "SCHERZO_JJ_WORKSPACE_REMOTE",
        "SCHERZO_PR_BASE",
        "SCHERZO_PR_DRAFT",
        "SCHERZO_PR_REMOTE",
        "SCHERZO_PR_REPO",
        "SCHERZO_REPO_ROOT",
        "SCHERZO_RUN_ARTIFACT_DIR",
        "SCHERZO_RUN_ID",
        "SCHERZO_RUN_ROOT",
        "SCHERZO_SOURCE_WORKSPACE_PATH",
        "SCHERZO_WORKFLOW_BUNDLE_DIR",
        "SCHERZO_WORKFLOW_ID",
        "SCHERZO_WORKSPACE_CAPABILITIES",
        "SCHERZO_WORKSPACE_DRIVER",
        "SCHERZO_WORKSPACE_NAME",
        "SCHERZO_WORKSPACE_PATH",
        "SCHERZO_WORKSPACE_PROFILE",
        "SCHERZO_WORKSPACE_ROOT",
    ]:
        env.pop(key, None)
    return env


def fallback_validation_base_revision() -> str:
    base, remote = configured_publish_base()
    return f"{base}@{remote}"


def final_validation_base_revision(*, failure_code: str | None = None) -> str:
    if not BASE_REFRESH_LATEST_PATH.exists():
        return fallback_validation_base_revision()
    try:
        refresh = json.loads(BASE_REFRESH_LATEST_PATH.read_text())
    except json.JSONDecodeError as exc:
        fail(
            f"invalid {BASE_REFRESH_LATEST_PATH}; cannot resolve validation base revision: {exc}",
            failure_code=failure_code,
        )
    base_revision = str(refresh.get("base_revision") or "").strip()
    if base_revision:
        return base_revision
    return fallback_validation_base_revision()


# Canonical local/CI gate. The dogfood validate step, devenv `check`, and
# Buildkite all drive `scripts/scherzo-ci`, so there is a single source of truth
# for what validation runs.
VALIDATION_SCRIPT = "scripts/scherzo-ci"


def scherzo_ci_validation_command() -> list[str]:
    return ["direnv", "exec", ".", VALIDATION_SCRIPT]


def validation_command_display(command: list[str]) -> str:
    return " ".join(command)


def write_validation_result(
    *,
    base_revision: str,
    setup_commands: list[list[str]],
    validation_command: list[str],
    status: str,
    exit_code: int | None = None,
    stdout: str = "",
    stderr: str = "",
    fingerprint: str | None = None,
    cached: bool = False,
) -> None:
    result: dict[str, Any] = {
        "base_revision": base_revision,
        "commands": [validation_command_display(validation_command)],
        "setup_commands": [validation_command_display(c) for c in setup_commands],
        "status": status,
        "validator": "scherzo-ci",
    }
    if fingerprint:
        result["fingerprint"] = fingerprint
    if cached:
        result["cached"] = True
    if exit_code is not None:
        result["exit_code"] = exit_code
    if status != "passed":
        result["failure_summary"] = validation_failure_summary(stdout, stderr)
        result["stdout_excerpt"] = diagnostic_excerpt(
            stdout, VALIDATION_RESULT_EXCERPT_MAX_CHARS
        )
        result["stderr_excerpt"] = diagnostic_excerpt(
            stderr, VALIDATION_RESULT_EXCERPT_MAX_CHARS
        )
        result["diagnostic_note"] = (
            "Full command output is retained in the workflow command-step diagnostics "
            "for the failing validation step when Scherzo artifact retention is enabled."
        )
    write_state_backed_json(VALIDATION_PATH, CANONICAL_VALIDATION_NAME, result)


def load_validation_result() -> dict[str, Any]:
    return load_state_backed_json(
        VALIDATION_PATH,
        CANONICAL_VALIDATION_NAME,
        missing_message=f"missing {display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}; run validate before publish",
    )


def validation_result_exists() -> bool:
    return state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME).exists() or VALIDATION_PATH.exists()


def previous_validation_failure_details() -> str:
    if not validation_result_exists():
        return (
            "No structured validation artifact was found at "
            f"{display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}. "
            "Inspect the earlier validate_after_refresh command-step diagnostics."
        )
    try:
        validation = load_validation_result()
    except json.JSONDecodeError as exc:
        return f"Structured validation artifact {display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))} is invalid JSON: {exc}"

    lines = ["Previous validation result:"]
    status = str(validation.get("status") or "unknown")
    lines.append(f"- status: {status}")
    exit_code = validation.get("exit_code")
    if exit_code is not None:
        lines.append(f"- exit_code: {exit_code}")
    base_revision = str(validation.get("base_revision") or "").strip()
    if base_revision:
        lines.append(f"- base_revision: {base_revision}")
    commands = validation.get("commands")
    if isinstance(commands, list) and commands:
        lines.append("- command: " + str(commands[0]))
    lines.append(f"- structured_validation_artifact: {display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}")
    lines.append(
        "- full_output_hint: inspect .scherzo/command-step-diagnostics/validate_after_refresh.txt in the retained workspace"
    )
    summary = str(validation.get("failure_summary") or "").strip()
    if summary:
        lines.append("\nFailure summary:\n" + summary)
    return "\n".join(lines)


# Legacy compatibility for retained workspaces created before base-drift repair
# moved onto command-step recovery. Checked-in workflows no longer dispatch this
# helper, but older retained runs can still surface its failure marker.
def assert_base_drift_repair_command(args: list[str]) -> None:
    if args:
        usage()
        sys.exit(2)
    if not BASE_DRIFT_REPAIR_FAILURE_PATH.exists():
        print("BASE_DRIFT_REPAIR_DECISION=ok")
        return

    failure = BASE_DRIFT_REPAIR_FAILURE_PATH.read_text().strip()
    previous_validation = previous_validation_failure_details()
    fail(
        f"base drift repair requested workflow failure via {BASE_DRIFT_REPAIR_FAILURE_PATH}:"
        + ("\n" + failure if failure else "")
        + "\n\n"
        + previous_validation,
        failure_code="base_drift_repair_failed",
    )


def validation_fingerprint() -> str | None:
    # Fingerprint the exact tree state validation runs against: the base commit
    # the change is stacked on plus the change's own diff. base_commit + diff
    # fully determines the working tree, so an identical fingerprint means an
    # identical tree under test and a prior passing scherzo-ci run can be reused
    # instead of re-running the full gate. Best-effort: any resolution failure
    # returns None so validation simply runs. SCHERZO_VALIDATE_FINGERPRINT lets
    # callers/tests pin the value when jj is unavailable.
    override = os.environ.get("SCHERZO_VALIDATE_FINGERPRINT", "").strip()
    if override:
        return override
    if not command_exists("jj"):
        return None
    base = run_proc([
        "jj", "log", "-r", "@-", "--no-graph",
        "-T", "commit_id ++ \"\\n\"", "--color=never",
    ])
    diff = run_proc(["jj", "diff", "--from", "@-", "--to", "@", "--color=never"])
    if base.returncode != 0 or diff.returncode != 0:
        return None
    base_ids = clean_lines(base.stdout)
    if not base_ids:
        return None
    return sha256_json(
        {
            "schema_version": 1,
            "base_commit_ids": base_ids,
            "diff": diff.stdout,
        }
    )


def cached_passing_validation(fingerprint: str | None) -> dict[str, Any] | None:
    if not fingerprint or not validation_result_exists():
        return None
    try:
        prior = load_validation_result()
    except (OSError, json.JSONDecodeError, SystemExit):
        return None
    if prior.get("status") == "passed" and prior.get("fingerprint") == fingerprint:
        return prior
    return None


def validate_command(*, failure_code: str | None = None) -> None:
    if command_exists("jj") and has_unresolved_conflicts_at_current_change():
        files = conflicted_files()
        details = ""
        if files:
            details = "\nConflicted files:\n" + "\n".join(f"- {file}" for file in files)
        else:
            details = "\nConflicted file list could not be determined by `jj resolve --list`."
        fail(
            "jj reports unresolved conflicts in the current change; resolve base-drift "
            "conflicts before validation." + details,
            failure_code=failure_code,
        )
    require_command("direnv")
    base_revision = final_validation_base_revision(failure_code=failure_code)
    setup_commands = [["direnv", "allow", "."]]
    validation_command = scherzo_ci_validation_command()
    fingerprint = validation_fingerprint()
    if cached_passing_validation(fingerprint) is not None:
        # The working tree is byte-identical to a previously passing run (same
        # base + diff), so the gate result is unchanged; reuse it instead of
        # re-running ~15m of checks. final_validate stays authoritative because
        # it re-runs whenever the fingerprint differs.
        write_validation_result(
            base_revision=base_revision,
            setup_commands=setup_commands,
            validation_command=validation_command,
            status="passed",
            fingerprint=fingerprint,
            cached=True,
        )
        short = fingerprint[:12] if fingerprint else ""
        print(
            "scherzo-ci validation skipped: working tree unchanged since the last "
            f"passing run (fingerprint {short})",
            flush=True,
        )
        print("FINAL_VALIDATION=passed")
        print("VALIDATION_CACHED=1")
        return
    env = validation_env()
    for command in setup_commands:
        run_and_print(command, failure_code=failure_code, env=env)
    print("$ " + " ".join(shell_display(arg) for arg in validation_command), flush=True)
    proc = run_proc_with_heartbeat(validation_command, env=env)
    print_process_output(proc)
    if proc.returncode != 0:
        write_validation_result(
            base_revision=base_revision,
            setup_commands=setup_commands,
            validation_command=validation_command,
            status="failed",
            exit_code=proc.returncode,
            stdout=proc.stdout,
            stderr=proc.stderr,
            fingerprint=fingerprint,
        )
        print("FINAL_VALIDATION=failed")
        print(f"VALIDATION_RESULT_PATH={display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}")
        summary = validation_failure_summary(proc.stdout, proc.stderr)
        fail(
            f"command failed with exit code {proc.returncode}: {' '.join(validation_command)}"
            f"\nStructured validation artifact: {display_path(state_backed_path(VALIDATION_PATH, CANONICAL_VALIDATION_NAME))}"
            + ("\nFailure summary:\n" + summary if summary else ""),
            failure_code=failure_code,
        )
    write_validation_result(
        base_revision=base_revision,
        setup_commands=setup_commands,
        validation_command=validation_command,
        status="passed",
        fingerprint=fingerprint,
    )
    print("FINAL_VALIDATION=passed")


def ensure_validation_passed() -> None:
    validation = load_validation_result()
    if validation.get("status") != "passed":
        fail("final validation did not pass; run validate before publish")


def metadata_field(metadata: dict[str, Any], *keys: str) -> str:
    for key in keys:
        value = str(metadata.get(key) or "").strip()
        if value:
            return value
    return ""


def implementation_issue_identifier(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "implementation_issue_identifier", "issue_identifier")


def implementation_issue_title(metadata: dict[str, Any], fallback: str = "") -> str:
    return metadata_field(metadata, "implementation_issue_title", "issue_title") or fallback


def implementation_issue_url(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "implementation_issue_url", "issue_url")


def source_issue_identifier(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_identifier")


def source_issue_title(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_title")


def source_issue_url(metadata: dict[str, Any]) -> str:
    return metadata_field(metadata, "source_issue_url")


def ticket_slug(metadata: dict[str, Any]) -> str:
    identifier = sanitize_ref_part(metadata.get("issue_identifier") or "")
    title = sanitize_ref_part(metadata.get("issue_title") or "")
    value = "-".join(part for part in [identifier, title] if part)
    return value[:60].strip("-") or "ticket"


def execplan_implementation_slug(metadata: dict[str, Any]) -> str:
    # Linear's GitHub integration is most reliable when the implementation
    # issue key appears in the branch name. Avoid deriving ExecPlan
    # implementation branches from the source plan filename because those
    # filenames often contain the planning ticket key instead.
    identifier = sanitize_ref_part(implementation_issue_identifier(metadata))
    title = sanitize_ref_part(implementation_issue_title(metadata))
    value = "-".join(part for part in [identifier, title] if part)
    if value:
        return value[:60].strip("-") or "execplan-implementation"
    plan_path = metadata["plan_path"]
    return sanitize_ref_part(Path(plan_path).stem)[:60] or "plan"


def implementation_subject(title: str, fallback: str) -> str:
    value = (title or fallback).strip()
    for pattern in [r"(?i)^implement\s+plan\s*:\s*", r"(?i)^implement\s*:\s*"]:
        stripped = re.sub(pattern, "", value, count=1).strip()
        if stripped != value:
            return stripped or value
    return value or fallback


def format_issue_line(issue_identifier: str, issue_title: str, issue_url: str) -> str:
    if issue_identifier and issue_title and issue_url:
        return f"Task: [{issue_identifier}: {issue_title}]({issue_url})"
    if issue_identifier and issue_title:
        return f"Task: {issue_identifier}: {issue_title}"
    if issue_identifier:
        return f"Task: {issue_identifier}"
    return "Task: Linear issue"


def current_validation_result() -> dict[str, Any]:
    return load_validation_result()


def validation_commands_from_result(validation: dict[str, Any]) -> list[str]:
    commands = validation.get("commands")
    if not isinstance(commands, list):
        return []
    return [str(command).strip() for command in commands if str(command).strip()]


def validation_body_section() -> str:
    validation = current_validation_result()
    commands = validation_commands_from_result(validation)
    if not commands:
        commands = [" ".join(scherzo_ci_validation_command())]
    label = "Validation completed before publication"
    if not commands:
        return label + ".\n\n"
    lines = [label + ":", ""]
    lines.extend(f"- `{command}`" for command in commands)
    lines.append("")
    return "\n".join(lines) + "\n"


def execplan_plan_display_path(metadata: dict[str, Any]) -> str:
    for key in ["plan_publication_path", "review_surface_path", "plan_artifact_ref", "plan_path"]:
        value = str(metadata.get(key) or "").strip()
        if value:
            return value
    return "unknown"


def execplan_source_issue_line(metadata: dict[str, Any]) -> str:
    identifier = source_issue_identifier(metadata)
    title = source_issue_title(metadata)
    url = source_issue_url(metadata)
    if not identifier and not title and not url:
        return ""
    return format_issue_line(identifier, title, url).replace(
        "Task:",
        "Source ExecPlan issue:",
        1,
    )


def execplan_publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str]:
    plan_path = metadata["plan_path"]
    issue_identifier = implementation_issue_identifier(metadata)
    issue_title = implementation_issue_title(metadata, plan_title(plan_path))
    issue_url = implementation_issue_url(metadata)
    slug = execplan_implementation_slug(metadata)
    branch_prefix = "scherzo/execplan-implementation"
    description = f"feat: implement {sanitize_ref_part(issue_identifier) or slug}"
    subject = implementation_subject(issue_title, plan_title(plan_path))
    pr_title = (
        f"Implement {issue_identifier}: {subject}"
        if issue_identifier
        else subject if subject.lower().startswith("implement")
        else "Implement: " + subject
    )
    source_line = execplan_source_issue_line(metadata)
    if source_line:
        source_line += "\n\n"
    body = (
        "Implements an implementation handoff task through Scherzo's "
        "`workflow:execplan-implementation` dogfood workflow. Linear and "
        "GitHub linkage target the implementation task; the ExecPlan source "
        "issue is listed separately when available.\n\n"
        f"{format_issue_line(issue_identifier, issue_title, issue_url)}\n\n"
        f"{source_line}"
        f"Source ExecPlan plan: `{execplan_plan_display_path(metadata)}`\n\n"
        + validation_body_section()
        + "This PR is ready for human acceptance.\n"
    )
    return branch_prefix, description, pr_title, body


def ticket_publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str]:
    slug = ticket_slug(metadata)
    issue_identifier = metadata.get("issue_identifier") or "task"
    issue_title = metadata.get("issue_title") or "Untitled"
    issue_url = metadata.get("issue_url") or ""
    branch_prefix = "scherzo/implementation"
    description = f"feat: implement {sanitize_ref_part(issue_identifier) or slug}"
    pr_title = f"Implement {issue_identifier}: {issue_title}"
    task_line = format_issue_line(issue_identifier, issue_title, issue_url)
    body = (
        "Implements a task through Scherzo's `workflow:implementation` dogfood workflow. The source task is fetched from Linear today.\n\n"
        f"{task_line}\n\n"
        "Source: task title, description, labels, and recent comments fetched from Linear. No ExecPlan is required for this workflow.\n\n"
        + validation_body_section()
        + "This PR is ready for human acceptance.\n"
    )
    return branch_prefix, description, pr_title, body


def publish_values(metadata: dict[str, Any]) -> tuple[str, str, str, str, str, str]:
    source_kind = metadata.get("source_kind")
    if not source_kind:
        fail(f"missing source_kind in {METADATA_PATH}; run prepare first")
    if source_kind == "ticket":
        branch_prefix, description, pr_title, body = ticket_publish_values(metadata)
        slug = ticket_slug(metadata)
    elif source_kind == "execplan":
        branch_prefix, description, pr_title, body = execplan_publish_values(metadata)
        slug = execplan_implementation_slug(metadata)
    else:
        fail(f"unknown source_kind in {METADATA_PATH}: {source_kind}")
    return source_kind, branch_prefix, slug, description, pr_title, body


def add_publish_issue_identity_fields(
    publish: dict[str, Any], metadata: dict[str, Any], source_kind: str
) -> None:
    if source_kind == "execplan":
        implementation_identifier = implementation_issue_identifier(metadata)
        publish["issue_identifier"] = implementation_identifier
        publish["implementation_issue_identifier"] = implementation_identifier
        publish["implementation_issue_title"] = implementation_issue_title(metadata)
        publish["implementation_issue_url"] = implementation_issue_url(metadata)
        publish["source_issue_identifier"] = source_issue_identifier(metadata)
        publish["source_issue_title"] = source_issue_title(metadata)
        publish["source_issue_url"] = source_issue_url(metadata)
    else:
        publish["issue_identifier"] = metadata.get("issue_identifier") or ""



def write_publish_metadata_files(pr_title: str, body: str) -> tuple[Path, Path, bool]:
    body, repair_summary_included = append_base_drift_repair_summary(body)
    title_path = TMP_DIR / "scherzo-implementation-pr-title.txt"
    title_path.parent.mkdir(parents=True, exist_ok=True)
    title_path.write_text(pr_title.strip() + "\n")
    PR_BODY_PATH.write_text(body)
    return title_path, PR_BODY_PATH, repair_summary_included


def materialize_commit_stack_artifact(
    *,
    repository: str,
    base_ref: str,
    base_revision: str,
    description_title: str,
) -> dict[str, Any]:
    output_path = state_backed_path(COMMIT_STACK_PATH, CANONICAL_COMMIT_STACK_NAME)
    try:
        artifact = commit_stack_helper.materialize_commit_stack_artifact(
            repository=repository,
            base_ref=base_ref,
            base_revision=base_revision,
            output_path=output_path,
            carrier_name=COMMIT_STACK_CARRIER_NAME,
            description_title=description_title,
            bundle_ref_namespace="commit-stack",
            tmp_dir=TMP_DIR,
        )
        copy_best_effort(output_path, COMMIT_STACK_PATH)
        return artifact
    except commit_stack_helper.CommitStackError as exc:
        fail(exc.message, failure_code=exc.code)


def publish_command() -> None:
    if not workspace_driver_available():
        workspace_driver_missing(failure_code="workspace_driver_unavailable")

    pr_draft_setting()
    require_command("jj")
    ensure_validation_passed()
    metadata = load_implementation_metadata()
    base, _remote = configured_publish_base()
    refresh = driver_refresh_result("publish")
    write_refresh_base_result(refresh)
    refresh_status = str(refresh.get("status") or "")
    if refresh_status == "conflicts":
        publish_blocked_after_refresh(refresh, failure_code="publish_rebase_conflict")
    if refresh_status == "rebase_failed":
        publish_blocked_after_refresh(refresh, failure_code="publish_rebase_conflict")
    if refresh_status in {"fetch_failed", "base_not_found"}:
        publish_blocked_after_refresh(refresh, failure_code="base_refresh_conflict")
    refresh_exit_code = refresh.get("exit_code")
    if refresh_exit_code not in {0, None}:
        message = str(refresh.get("message") or refresh_status or "refresh-base failed")
        fail(
            "workspace driver refresh-base failed before publication: "
            f"{refresh_status or '<empty>'}\n{message}",
            failure_code=str(refresh.get("failure_code") or "workspace_driver_refresh_base_failed"),
        )
    if refresh_status not in {"fresh", "rebased_clean"}:
        message = str(refresh.get("message") or refresh_status or "refresh-base failed")
        fail(
            "workspace driver refresh-base returned a non-publishable status before publication: "
            f"{refresh_status or '<empty>'}\n{message}",
            failure_code=str(refresh.get("failure_code") or "workspace_driver_refresh_base_failed"),
        )

    base_revision = str(refresh.get("base_revision") or base)
    if refresh_status == "rebased_clean":
        print("")
        print("## Revalidation after publish-base normalization")
        try:
            validate_command(failure_code="publish_revalidation_failed")
            ensure_validation_passed()
        except SystemExit:
            print("PUBLISH_BLOCKED=true")
            print("PUBLISH_BLOCKED_REASON=base drift after final validation")
            raise

    source_kind, _branch_prefix, _slug, _description, pr_title, body = publish_values(metadata)
    files = workspace_driver_changed_files()
    if not files:
        fail("refusing to publish because no changed files were found")

    title_path, body_path, repair_summary_included = write_publish_metadata_files(
        pr_title,
        body,
    )
    repository = default_repo(configured_publication_remote())
    commit_stack = materialize_commit_stack_artifact(
        repository=repository,
        base_ref=base,
        base_revision=base_revision,
        description_title=pr_title,
    )

    publish = {
        "source_kind": source_kind,
        "status": "ready_for_core_publication",
        "publication_mode": "commit_stack",
        "publication_orchestrator": "scherzo_core",
        "changed_files": files,
        "publish_base_revision": base_revision,
        "base_revision": base_revision,
        "branch": "pending-core-publication",
        "head_revision": commit_stack["head"]["sha"],
        "base_drift_repair_summary_included": repair_summary_included,
        "pr_title_path": str(title_path),
        "pr_body_path": str(body_path),
        "commit_stack_path": display_path(state_backed_path(COMMIT_STACK_PATH, CANONICAL_COMMIT_STACK_NAME)),
        "commit_stack_head_revision": commit_stack["head"]["sha"],
        "commit_stack_base_revision": commit_stack["base"]["sha"],
    }
    if repair_summary_included:
        publish["base_drift_repair_summary_path"] = str(BASE_DRIFT_REPAIR_SUMMARY_PATH)
    if source_kind == "execplan":
        publish["plan_path"] = metadata["plan_path"]
    add_publish_issue_identity_fields(publish, metadata, source_kind)
    write_state_backed_json(PUBLISH_PATH, CANONICAL_PUBLISH_NAME, publish)

    print("## Summary")
    if source_kind == "execplan":
        print(
            f"Implemented `{metadata['plan_path']}` and prepared the result for Scherzo core publication."
        )
    else:
        issue_identifier = metadata.get("issue_identifier") or "task"
        issue_title = metadata.get("issue_title") or "Untitled"
        print(
            f"Implemented task `{issue_identifier}: {issue_title}` and prepared the result for Scherzo core publication."
        )
    print("")
    print("## Publication")
    print("PUBLICATION_MODE=commit_stack")
    print("PUBLICATION_ORCHESTRATOR=scherzo_core")
    print(f"COMMIT_STACK_PATH={display_path(state_backed_path(COMMIT_STACK_PATH, CANONICAL_COMMIT_STACK_NAME))}")
    print(f"PR_TITLE_PATH={title_path}")
    print(f"PR_BODY_PATH={body_path}")
    print("PR_URL will be reported by Scherzo core after declarative publication completes.")
    print("")
    print("## Validation")
    validation = current_validation_result()
    validation_commands = validation_commands_from_result(validation)
    if not validation_commands:
        validation_commands = [" ".join(scherzo_ci_validation_command())]
    for command in validation_commands:
        print(f"- `{command}`: passed")
    print("")
    print("## Changed files")
    for file in files:
        print(f"- `{file}`")


def languages_command(args: list[str]) -> None:
    if len(args) != 1:
        usage()
        sys.exit(2)
    files = clean_lines(Path(args[0]).read_text())
    languages, supported_files, unsupported_files = detect_languages(files)
    print("LANGUAGES=" + comma_join(languages))
    print_list("SUPPORTED_REVIEW_FILES", supported_files)
    print_list("UNSUPPORTED_REVIEW_FILES", unsupported_files)
    print_list("REVIEW_COMMANDS", review_commands(languages))


def ticket_brief_command(args: list[str]) -> None:
    if len(args) != 1:
        usage()
        sys.exit(2)
    issue = json.loads(Path(args[0]).read_text())
    print(render_ticket_brief(issue), end="")


def main(argv: list[str]) -> None:
    command = argv[1] if len(argv) > 1 else ""
    args = argv[2:]
    if command == "prepare":
        prepare_command(args)
    elif command == "refresh-base":
        refresh_base_command(args)
    elif command == "refresh-base-and-validate":
        refresh_base_and_validate_command(args)
    elif command == "analyze" and not args:
        analyze_command()
    elif command == "gate-implementation-completion":
        gate_implementation_completion_command(args)
    elif command == "plan-completion-context":
        plan_completion_context_command(args)
    elif command == "checkpoint-plan-completion-verdict":
        checkpoint_plan_completion_verdict_command(args)
    elif command == "gate-plan-completion":
        gate_plan_completion_command(args)
    elif command == "plan-completion-recovery":
        plan_completion_recovery_command(args)
    elif command == "assert-base-drift-repair":
        assert_base_drift_repair_command(args)
    elif command == "validate" and not args:
        validate_command()
    elif command == "publish" and not args:
        publish_command()
    elif command == "plan-brief":
        plan_brief_command(args)
    elif command == "languages":
        languages_command(args)
    elif command == "ticket-brief":
        ticket_brief_command(args)
    elif command in {"-h", "--help", "help"}:
        usage()
    else:
        usage()
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
