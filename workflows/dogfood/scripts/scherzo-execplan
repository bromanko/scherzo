def usage() -> None:
    print(
        """Usage: scherzo-execplan <command> [options]

Commands:
  prepare-review-doc-target --from-issue-context [--write-target PATH]
  validate-review-doc --path PATH
  validate-review-doc --discover-changed-review-doc --write-path PATH [--target-file PATH]
  materialize-pack --review-doc PATH --submission PATH --output PATH
  materialize-pack --review-doc-path-file PATH --submission-step STEP --submission-artifact NAME --output PATH
  validate-bundle --bundle PATH [--bundle-sha256 SHA] [--artifact-root PATH] --repo-root PATH
  materialize-commit-stack --review-doc-path-file PATH --output PATH [--previous-bundle PATH --target-output PATH]
  materialize-bundle --review-doc-path-file PATH --pack PATH --publish-context PATH --output PATH
  prepare-revision (--from-workstream-input|--from-issue-context|--prefer-workstream-input) --write-bundle PATH --write-review-doc-path PATH --write-pack PATH
  materialize-revision --previous-bundle PATH --review-doc-path-file PATH --pack PATH --publish-context PATH --status auto --output PATH
  implementation-prepare (--from-workstream-input|--from-issue-context|--prefer-workstream-input)
  gate-no-conflict
  materialize-code-change-bundle --bundle PATH --output PATH
""",
        file=sys.stderr,
    )


def fail(message: str, *, code: str | None = None, exit_code: int = 2) -> None:
    if code:
        print(f"{FAILURE_PREFIX}{code}", file=sys.stderr)
    print(f"scherzo-execplan: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def fail_descriptor_required(reason: str) -> None:
    fail(
        reason
        + "; exec_plan_bundle.v2 is descriptor-only after the LIV-1359 cutoff. "
        "The bundle must have artifact_type='scherzo.exec_plan_bundle.v2', "
        "kind='artifact_set', media_type='application/json', and an entries[] "
        "file named 'plan' with artifact_type='scherzo.exec_plan.v1' and "
        "media_type='text/markdown'. Legacy pre-descriptor bundles that rely on "
        "exec_plan_bundle.plan.ref or review_doc.path are not resumable; see "
        + EXEC_PLAN_BUNDLE_DESCRIPTOR_ONLY_NOTE
        + ".",
        code=EXEC_PLAN_DESCRIPTOR_REQUIRED_CODE,
    )


def env_value(name: str, default: str = "", *, legacy: str | None = None) -> str:
    value = os.environ.get(name, "").strip()
    if value:
        return value
    if legacy:
        value = os.environ.get(legacy, "").strip()
        if value:
            return value
    return default


def env_enabled(name: str, *, legacy: str | None = None) -> bool:
    return bool(env_value(name, legacy=legacy))


def canonical_json(value: Any) -> str:
    return json.dumps(value, indent=2, sort_keys=True, separators=(",", ": ")) + "\n"


def write_json(path: Path, value: Any) -> None:
    path = resolve_run_root_relative_path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(canonical_json(value), encoding="utf-8")


def descriptor_file_entry(
    name: str,
    ref: str,
    sha256: str,
    bytes_: int,
    media_type: str,
    artifact_type: str,
    *,
    metadata: dict[str, Any] | None = None,
) -> dict[str, Any]:
    entry = {
        "name": name,
        "kind": "file",
        "artifact_type": artifact_type,
        "ref": ref,
        "sha256": sha256,
        "bytes": bytes_,
        "media_type": media_type,
    }
    if metadata is not None:
        entry["metadata"] = metadata
    return entry


def named_retained_artifact_entry(artifact: dict[str, Any], *, media_type: str = "application/json") -> dict[str, Any]:
    return descriptor_file_entry(
        str(artifact["name"]),
        str(artifact["ref"]),
        str(artifact["sha256"]),
        int(artifact["bytes"]),
        media_type,
        str(artifact["name"]),
    )


def implementation_pack_descriptor(pack: dict[str, Any]) -> dict[str, Any]:
    review_doc = pack["review_doc"]
    return {
        "kind": "file",
        "media_type": "application/json",
        "artifact_type": IMPLEMENTATION_PACK_ARTIFACT_TYPE,
        **review_doc,
    }


def plan_publication_metadata(review_meta: dict[str, Any]) -> dict[str, Any]:
    return {
        "publication": {
            "destination_path": review_meta["path"],
        }
    }


def review_surface_from_publish_context(
    publish_context: dict[str, Any] | None,
    *,
    review_doc_path: str,
) -> dict[str, Any]:
    if publish_context is None:
        return {
            "status": "not_applicable",
            "pr_url": None,
            "branch": None,
            "source_bundle_ref": None,
            "head_revision": None,
            "review_doc_path": review_doc_path,
        }
    return {
        "status": publish_context["review_surface"]["status"],
        "pr_url": publish_context["pr"]["url"],
        "branch": publish_context["pr"]["branch"],
        "source_bundle_ref": publish_context["review_surface"].get("source_bundle_ref"),
        "head_revision": publish_context["review_surface"].get("head_revision") or publish_context["pr"].get("head_revision"),
        "review_doc_path": review_doc_path,
    }


def implementation_state_dir() -> Path | None:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if not run_root:
        return None
    return Path(run_root) / IMPLEMENTATION_STATE_RELATIVE_DIR


def implementation_state_path(name: str) -> Path | None:
    state_dir = implementation_state_dir()
    if state_dir is None:
        return None
    return state_dir / name


def implementation_state_relative_path(name: str) -> Path:
    return IMPLEMENTATION_STATE_RELATIVE_DIR / name


def display_path(path: Path) -> str:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if run_root:
        try:
            return path.resolve(strict=False).relative_to(Path(run_root).resolve(strict=False)).as_posix()
        except (OSError, ValueError):
            pass
    return path.as_posix()


def resolve_run_root_relative_path(path: Path) -> Path:
    run_root = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    if run_root and not path.is_absolute() and path.parts[:1] == ("state",):
        return Path(run_root) / path
    return path


def copy_best_effort(source: Path, destination: Path) -> None:
    try:
        if source.resolve(strict=False) == destination.resolve(strict=False):
            return
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(source.read_bytes())
    except OSError:
        pass


def load_json(path: Path, *, code: str | None = None) -> Any:
    path = resolve_run_root_relative_path(path)
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"missing JSON file: {path}", code=code)
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON in {path}: {exc}", code=code)


def path_bytes(path: Path, *, code: str | None = None) -> bytes:
    path = resolve_run_root_relative_path(path)
    try:
        return path.read_bytes()
    except FileNotFoundError:
        fail(f"missing file: {path}", code=code)
    except OSError as exc:
        fail(f"could not read {path}: {exc}", code=code)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def file_meta(path: Path, *, code: str | None = None) -> dict[str, Any]:
    data = path_bytes(path, code=code)
    return {"sha256": sha256_bytes(data), "bytes": len(data)}


def repo_root(default: str | None = None) -> Path:
    if default:
        return Path(default)
    value = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if value:
        return Path(value)
    return Path.cwd()


def schema_path(path: Path, root: Path | None = None) -> Path:
    if path.is_absolute():
        return path
    base = root or SCRIPT_ROOT
    parts = path.parts
    if len(parts) >= 2 and parts[0] == ".scherzo" and parts[1] == "workflows":
        if (base / ".scherzo").exists():
            return base / path
        return base / Path(*parts[2:])
    return base / path


def validate_schema(value: Any, schema_rel: Path, *, root: Path | None = None) -> None:
    if jsonschema is None:
        fail("python jsonschema package is required")
    schema_file = schema_path(schema_rel, root or BUNDLE_ROOT)
    schema = load_json(schema_file)
    validator = jsonschema.Draft202012Validator(schema)
    errors = sorted(validator.iter_errors(value), key=lambda e: list(e.path))
    if errors:
        first = errors[0]
        location = "/".join(str(part) for part in first.path) or "<root>"
        fail(f"schema validation failed for {schema_rel} at {location}: {first.message}")


def normalize_repo_relative_path(value: str, *, label: str) -> str:
    raw = value.strip().strip("`'\"").rstrip(".,;:").strip()
    if raw.startswith("<absolute-local-path>"):
        fail(f"{label} must be repository-relative, not absolute: {value!r}")
    raw = raw.strip("<>").strip()
    if not raw:
        fail(f"{label} must be a non-empty repository-relative path")
    if "\x00" in raw:
        fail(f"{label} must not contain NUL bytes: {value!r}")
    normalized_separators = raw.replace("\\", "/")
    if normalized_separators.startswith("/") or normalized_separators.startswith("<absolute-local-path>"):
        fail(f"{label} must be repository-relative, not absolute: {value!r}")
    if WINDOWS_ABSOLUTE_PATH_RE.match(raw) or WINDOWS_ABSOLUTE_PATH_RE.match(normalized_separators):
        fail(f"{label} must be repository-relative, not a Windows absolute path: {value!r}")
    if URI_SCHEME_RE.match(normalized_separators):
        fail(f"{label} must be a repository-relative path, not a URL: {value!r}")
    parts: list[str] = []
    for part in normalized_separators.split("/"):
        if part in {"", "."}:
            continue
        if part == "..":
            fail(f"{label} must not contain parent-directory traversal: {value!r}")
        parts.append(part)
    if not parts:
        fail(f"{label} must name a file or directory inside the repository: {value!r}")
    return "/".join(parts)


def is_repo_relative(value: str) -> bool:
    try:
        normalize_repo_relative_path(value, label="path")
    except SystemExit:
        return False
    return True


def ensure_repo_relative_path(value: str, *, label: str) -> None:
    normalize_repo_relative_path(value, label=label)


def review_doc_filesystem_path(path_value: str, root: Path | None = None) -> Path:
    normalized = normalize_repo_relative_path(path_value, label="review doc path")
    return (root or repo_root()) / normalized


def plan_entry_publication_destination_path(bundle: dict[str, Any], *, required: bool = False) -> str | None:
    try:
        entry = descriptor_plan_entry(bundle)
    except SystemExit:
        if required:
            raise
        return None
    metadata = entry.get("metadata")
    if not isinstance(metadata, dict):
        if required:
            fail_descriptor_required(
                "descriptor plan entry is missing metadata.publication.destination_path"
            )
        return None
    publication = metadata.get("publication")
    if not isinstance(publication, dict):
        if required:
            fail_descriptor_required(
                "descriptor plan entry is missing metadata.publication.destination_path"
            )
        return None
    destination = publication.get("destination_path")
    if not isinstance(destination, str) or not destination.strip():
        if required:
            fail_descriptor_required(
                "descriptor plan entry is missing metadata.publication.destination_path"
            )
        return None
    return normalize_repo_relative_path(
        destination,
        label="artifact.metadata.publication.destination_path",
    )


def review_surface_review_doc_path(bundle: dict[str, Any]) -> str | None:
    surface = bundle.get("review_surface")
    if not isinstance(surface, dict):
        return None
    value = surface.get("review_doc_path")
    if not isinstance(value, str) or not value.strip():
        return None
    return normalize_repo_relative_path(value, label="review_surface.review_doc_path")


def review_doc_seed_filesystem_path(bundle: dict[str, Any], root: Path) -> Path:
    normalized = plan_entry_publication_destination_path(bundle, required=True)
    if normalized is None:
        fail_descriptor_required(
            "descriptor plan entry is missing metadata.publication.destination_path"
        )
    if not normalized.endswith(".md"):
        fail(
            "descriptor plan publication destination must be Markdown source: "
            + normalized,
            code="execplan_revision_base_missing",
        )
    expected_surface_path = review_surface_review_doc_path(bundle)
    if expected_surface_path is not None and normalized != expected_surface_path:
        fail(
            "descriptor plan publication destination does not match review_surface.review_doc_path: "
            + normalized,
            code="execplan_revision_base_missing",
        )
    return root / normalized


def headings(markdown: str) -> list[tuple[int, str]]:
    result: list[tuple[int, str]] = []
    in_fence = False
    fence_marker = ""
    heading_re = re.compile(r"^(#{1,6})[ \t]+(.+?)\s*#*\s*$")
    for line in markdown.splitlines():
        fence_match = re.match(r"^\s*(```+|~~~+)", line)
        if fence_match:
            marker = fence_match.group(1)[:3]
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif marker == fence_marker:
                in_fence = False
                fence_marker = ""
            continue
        if in_fence:
            continue
        match = heading_re.match(line)
        if not match:
            continue
        title = re.sub(r"\s+", " ", match.group(2)).strip()
        title = re.sub(r"\s+#*$", "", title).strip()
        if title:
            result.append((len(match.group(1)), title))
    return result


def markdown_sections(markdown: str) -> dict[str, str]:
    sections: dict[str, list[str]] = {}
    current: str | None = None
    in_fence = False
    fence_marker = ""
    heading_re = re.compile(r"^(#{1,6})[ \t]+(.+?)\s*#*\s*$")
    for line in markdown.splitlines():
        fence_match = re.match(r"^\s*(```+|~~~+)", line)
        if fence_match:
            marker = fence_match.group(1)[:3]
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif marker == fence_marker:
                in_fence = False
                fence_marker = ""
            if current is not None:
                sections[current].append(line)
            continue
        if not in_fence:
            match = heading_re.match(line)
            if match:
                level = len(match.group(1))
                title = re.sub(r"\s+", " ", match.group(2)).strip()
                title = re.sub(r"\s+#*$", "", title).strip()
                if level == 2:
                    current = title
                    sections.setdefault(current, [])
                    continue
        if current is not None:
            sections[current].append(line)
    return {title: "\n".join(lines).strip() for title, lines in sections.items()}


def review_doc_section_has_meaningful_content(markdown: str) -> bool:
    visible = re.sub(r"<!--.*?-->", " ", markdown, flags=re.DOTALL)
    for raw in visible.splitlines():
        line = raw.strip()
        line = re.sub(r"^>\s*", "", line)
        line = re.sub(r"^[-*+]\s+(?:\[[ xX-]\]\s*)?", "", line)
        line = re.sub(r"^\d+[.)](?:\s+(?:\[[ xX-]\]\s*)?)?", "", line)
        line = re.sub(r"^\[[ xX-]\]\s*", "", line)
        line = re.sub(r"`([^`]*)`", r"\1", line)
        line = re.sub(r"!\[[^\]]*\]\([^)]+\)", " ", line)
        line = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", line)
        line = re.sub(r"<[^>]+>", " ", line)
        line = re.sub(r"[*_~`#\\|<>{}=:+.,;!?()[\]/-]+", " ", line)
        line = re.sub(r"\s+", " ", line).strip()
        if re.search(r"[A-Za-z0-9]", line):
            return True
    return False


def fail_review_doc_required_section(message: str, *, code: str) -> None:
    fail(f"{message}\n{REVIEW_DOC_REQUIRED_SECTION_REPAIR_HINT}", code=code)


def strip_markdown_code_blocks(markdown: str) -> str:
    lines: list[str] = []
    in_fence = False
    fence_marker = ""
    for line in markdown.splitlines():
        fence_match = re.match(r"^\s*(```+|~~~+)", line)
        if fence_match:
            marker = fence_match.group(1)[:3]
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif marker == fence_marker:
                in_fence = False
                fence_marker = ""
            continue
        if not in_fence:
            lines.append(line)
    return "\n".join(lines)


def significant_words(text: str) -> set[str]:
    normalized = re.sub(r"`([^`]*)`", r" \1 ", text.lower())
    words = set(re.findall(r"[a-z][a-z0-9_-]{3,}", normalized))
    return {word for word in words if word not in COMPLETION_PREFLIGHT_STOP_WORDS}


def nonempty_content_lines(text: str) -> list[str]:
    lines: list[str] = []
    for raw in strip_markdown_code_blocks(text).splitlines():
        line = raw.strip()
        line = re.sub(r"^[-*+]\s+", "", line)
        line = re.sub(r"^\d+[.)]\s+", "", line)
        if line:
            lines.append(line)
    return lines


def pack_completion_search_text(pack: dict[str, Any]) -> str:
    sections = pack.get("sections") if isinstance(pack.get("sections"), dict) else {}
    texts: list[str] = []
    testing = sections.get("testing_and_falsifiability") if isinstance(sections, dict) else None
    if isinstance(testing, str):
        texts.append(testing)
    steps = sections.get("concrete_steps") if isinstance(sections, dict) else None
    if isinstance(steps, list):
        for step in steps:
            if not isinstance(step, dict):
                continue
            for key in ["title", "instructions", "expected_result"]:
                value = step.get(key)
                if isinstance(value, str):
                    texts.append(value)
            for key in ["files", "commands"]:
                values = step.get(key)
                if isinstance(values, list):
                    texts.extend(str(value) for value in values if isinstance(value, str))
    return "\n".join(texts)


def cue_match_is_negated(line: str, match: re.Match[str]) -> bool:
    prefix = line[max(0, match.start() - 24) : match.start()].lower()
    suffix = line[match.end() : match.end() + 48].lower()
    return bool(re.search(r"\b(?:no|not|without)\b", prefix) or re.search(r"\b(?:not required|not needed|out of scope)\b", suffix))


def text_has_unnegated_match(text: str, pattern: re.Pattern[str], *, include_code_blocks: bool = False) -> bool:
    raw_lines = text.splitlines() if include_code_blocks else nonempty_content_lines(text)
    for raw in raw_lines:
        line = raw.strip()
        line = re.sub(r"^[-*+]\s+", "", line)
        line = re.sub(r"^\d+[.)]\s+", "", line)
        if not line:
            continue
        start = 0
        while True:
            match = pattern.search(line, start)
            if not match:
                break
            if not cue_match_is_negated(line, match):
                return True
            start = match.end()
    return False


def review_requires_pack_cue(obligation_text: str, review_re: re.Pattern[str]) -> bool:
    return text_has_unnegated_match(obligation_text, review_re)


def completion_review_doc_findings(markdown: str) -> list[str]:
    sections = markdown_sections(markdown)
    findings: list[str] = []
    validation = sections.get("Validation and Acceptance", "")
    milestones = sections.get("Milestones", "")
    progress = sections.get("Progress", "")
    if not text_has_unnegated_match(validation, COMPLETION_PREFLIGHT_EVIDENCE_RE, include_code_blocks=True):
        findings.append(
            "Validation and Acceptance is not verifiable: include concrete commands, tests, observable artifacts, expected output, explicit pre-publish manual-evidence requirements, or explicit deferred post-implementation manual evidence."
        )
    if re.search(
        r"\b(?:works|good|done|complete|sufficient|appropriate|as needed|where practical)\b", validation, re.IGNORECASE
    ) and not text_has_unnegated_match(validation, COMPLETION_PREFLIGHT_CONCRETE_EVIDENCE_RE, include_code_blocks=True):
        findings.append("Validation and Acceptance uses broad completion wording without concrete evidence requirements.")
    for line in nonempty_content_lines(milestones):
        if COMPLETION_PREFLIGHT_AMBIGUOUS_RE.search(line) and not re.search(
            r"`[^`]+`|\b(?:test|artifact|evidence|file|path|command|validator|schema|manual|browser|dogfood|lint)\b",
            line,
            re.IGNORECASE,
        ):
            findings.append(f"Milestones contain an ambiguous milestone without an observable outcome: {line}")
            break
    for raw in strip_markdown_code_blocks(progress).splitlines():
        line = raw.strip()
        if re.match(r"^[-*+]\s+\[ \]\s+", line) and COMPLETION_PREFLIGHT_PROGRESS_OBLIGATION_RE.search(line):
            findings.append(
                "Progress contains an unchecked required implementation or validation obligation; move planned work to Milestones/Validation and keep Progress for completed living-document updates: "
                + line
            )
            break
    return findings


def completion_pack_alignment_findings(markdown: str, pack: dict[str, Any]) -> list[str]:
    sections = markdown_sections(markdown)
    obligation_text = "\n".join(sections.get(title, "") for title in COMPLETION_PREFLIGHT_OBLIGATION_SECTIONS)
    pack_text = pack_completion_search_text(pack)
    findings: list[str] = []
    for label, review_re, pack_re in COMPLETION_PREFLIGHT_PACK_CUES:
        if review_requires_pack_cue(obligation_text, review_re) and not text_has_unnegated_match(pack_text, pack_re):
            findings.append(
                f"Review doc requires {label}, but the implementation pack concrete steps/testing do not mention corresponding evidence."
            )
    pack_words = significant_words(pack_text)
    for title in COMPLETION_PREFLIGHT_OBLIGATION_SECTIONS:
        for line in nonempty_content_lines(sections.get(title, "")):
            if not COMPLETION_PREFLIGHT_REQUIRED_RE.search(line):
                continue
            words = significant_words(line)
            if len(words) < 4:
                continue
            overlap = words.intersection(pack_words)
            required_overlap = 2 if len(words) >= 7 else 1
            if len(overlap) < required_overlap:
                findings.append(
                    "Required behavior in the review doc is not represented in implementation pack concrete steps/testing: "
                    + line
                )
                break
    sections_value = pack.get("sections") if isinstance(pack.get("sections"), dict) else {}
    steps = sections_value.get("concrete_steps") if isinstance(sections_value, dict) else None
    commands: list[str] = []
    if isinstance(steps, list):
        for step in steps:
            if isinstance(step, dict) and isinstance(step.get("commands"), list):
                commands.extend(str(command) for command in step["commands"] if isinstance(command, str))
    if re.search(r"\b(?:test|validation|validate|lint|dogfood|manual|browser|evidence)\w*\b", obligation_text, re.IGNORECASE):
        command_text = "\n".join(commands)
        if not commands and not text_has_unnegated_match(pack_text, COMPLETION_PREFLIGHT_MANUAL_PACK_RE):
            findings.append("Review doc requires validation/test evidence, but the implementation pack has no validation commands or explicit manual-evidence step.")
        elif commands and not re.search(r"\b(?:test|validate|lint|check|py_compile|scherzo-ci|selfci|dogfood)\b", command_text, re.IGNORECASE):
            findings.append(
                "Review doc requires validation/test evidence, but the implementation pack commands do not include a recognizable test, validation, lint, check, or dogfood command."
            )
    return findings


def fail_completion_preflight(findings: list[str]) -> None:
    if not findings:
        return
    fail(
        "ExecPlan completion preflight failed before implementation:\n"
        + "\n".join(f"- {finding}" for finding in findings),
        code="execplan_completion_preflight_failed",
    )


def review_doc_target_from_value(value: str, *, is_default: bool = False) -> dict[str, Any]:
    normalized = normalize_repo_relative_path(value, label="ExecPlan output path")
    kind = "file" if normalized.lower().endswith(".md") else "directory"
    target = {
        "schema_version": REVIEW_DOC_TARGET_SCHEMA_VERSION,
        "artifact_type": "execplan_review_doc_target",
        "kind": kind,
        "path": normalized,
        "default": is_default,
    }
    if kind == "file":
        parent = normalized.rsplit("/", 1)[0] if "/" in normalized else "."
        target["directory"] = parent
    else:
        target["directory"] = normalized
    return target


def default_review_doc_target() -> dict[str, Any]:
    return review_doc_target_from_value(DEFAULT_REVIEW_DOC_DIRECTORY, is_default=True)


def phrase_review_doc_target_is_path_like(value: str) -> bool:
    stripped = value.strip()
    if stripped.startswith("`") and stripped.endswith("`"):
        return True
    candidate = stripped.strip("'\"").rstrip(".,;:").strip("<>").strip()
    return "/" in candidate or "\\" in candidate or candidate.lower().endswith(".md")


def requested_review_doc_target_values(text: str) -> list[str]:
    values: list[str] = []
    for match in REVIEW_DOC_TARGET_FIELD_RE.finditer(text):
        values.append(match.group(1))
    for match in REVIEW_DOC_TARGET_PHRASE_RE.finditer(text):
        value = match.group(1)
        if phrase_review_doc_target_is_path_like(value):
            values.append(value)
    return values


def review_doc_target_from_text(text: str) -> dict[str, Any]:
    targets: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for value in requested_review_doc_target_values(text):
        target = review_doc_target_from_value(value)
        key = (str(target["kind"]), str(target["path"]))
        if key not in seen:
            targets.append(target)
            seen.add(key)
    if not targets:
        return default_review_doc_target()
    if len(targets) > 1:
        details = ", ".join(f"{target['kind']}:{target['path']}" for target in targets)
        fail(
            "ambiguous ExecPlan output path request; specify exactly one repository-relative destination. "
            f"Found: {details}"
        )
    return targets[0]


def read_review_doc_target_file(path: Path) -> dict[str, Any]:
    payload = load_json(path)
    if not isinstance(payload, dict):
        fail(f"review doc target file must contain a JSON object: {path}")
    if payload.get("schema_version") != REVIEW_DOC_TARGET_SCHEMA_VERSION or payload.get("artifact_type") != "execplan_review_doc_target":
        fail(f"review doc target file has an unsupported shape: {path}")
    kind = payload.get("kind")
    target_path = payload.get("path")
    if kind not in {"directory", "file"} or not isinstance(target_path, str):
        fail(f"review doc target file must include kind and path: {path}")
    target = review_doc_target_from_value(target_path, is_default=bool(payload.get("default")))
    if target["kind"] != kind:
        fail(f"review doc target file kind does not match path extension: {path}")
    return target


def review_doc_target_instruction(target: dict[str, Any]) -> str:
    path = str(target["path"])
    if target["kind"] == "file":
        return f"Write the ExecPlan review document exactly at `{path}`; create its parent directory if it is missing."
    return f"Write exactly one Markdown ExecPlan review document directly under `{path}/`; create that directory if it is missing."


def ensure_review_doc_target_directory(target: dict[str, Any]) -> None:
    directory = str(target.get("directory") or target["path"])
    if directory == ".":
        return
    directory = normalize_repo_relative_path(directory, label="ExecPlan output directory")
    try:
        (Path.cwd() / directory).mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(f"could not create ExecPlan output directory `{directory}`: {exc}")


def review_doc_path_matches_target(path_value: str, target: dict[str, Any]) -> bool:
    try:
        normalized = normalize_repo_relative_path(path_value, label="review doc path")
    except SystemExit:
        return False
    if not normalized.lower().endswith(".md"):
        return False
    target_path = str(target["path"])
    if target["kind"] == "file":
        return normalized == target_path
    prefix = target_path.rstrip("/") + "/"
    if not normalized.startswith(prefix):
        return False
    remainder = normalized[len(prefix) :]
    return bool(remainder) and "/" not in remainder


def validate_review_doc_path(path: Path, *, allow_fixture: bool = True, target: dict[str, Any] | None = None) -> dict[str, Any]:
    value = normalize_repo_relative_path(str(path), label="review doc path")
    path = Path(value)
    if not value.endswith(".md"):
        fail(f"review doc must be Markdown source, not generated HTML or another format: {value}")
    if not allow_fixture:
        expected = target or default_review_doc_target()
        if not review_doc_path_matches_target(value, expected):
            fail(
                "discovered review doc must match the requested ExecPlan output target "
                f"({expected['kind']} `{expected['path']}`), got: {value}"
            )
    data = path_bytes(path)
    text = data.decode("utf-8", errors="replace")
    if re.search(r"<!doctype\s+html|<html\b", text, flags=re.IGNORECASE):
        fail("review doc must be Markdown source, not generated HTML")
    if re.search(r"/Users/|/home/|/private/|/var/folders/|<absolute-local-path>", text):
        fail("review doc contains absolute local path shapes; use repository-relative paths only")
    all_headings = headings(text)
    if not any(level == 1 for level, _ in all_headings):
        fail("review doc must contain a level-1 title")
    section_titles = {title for level, title in all_headings if level == 2}
    sections = markdown_sections(text)
    for section in REQUIRED_REVIEW_DOC_SECTIONS:
        if section not in section_titles:
            fail_review_doc_required_section(
                f"review doc missing required section: {section}",
                code="execplan_review_doc_required_section_missing",
            )
        if not review_doc_section_has_meaningful_content(sections.get(section, "")):
            fail_review_doc_required_section(
                f"review doc required section has no meaningful content: {section}",
                code="execplan_review_doc_required_section_empty",
            )
    forbidden = sorted(FORBIDDEN_REVIEW_DOC_SECTIONS.intersection(section_titles))
    if forbidden:
        fail(
            "review doc contains mechanical implementation sections that belong in implementation_pack.sections: "
            + ", ".join(forbidden)
        )
    fail_completion_preflight(completion_review_doc_findings(text))
    return {"path": value, "sha256": sha256_bytes(data), "bytes": len(data)}


def workspace_driver_command() -> str | None:
    value = os.environ.get("SCHERZO_WORKSPACE_DRIVER", "").strip()
    return value or None


def subprocess_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def format_seconds(value: float) -> str:
    number = float(value)
    if number.is_integer():
        return str(int(number))
    return str(number)


def run_proc(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        stdout = subprocess_text(exc.stdout)
        stderr = subprocess_text(exc.stderr).strip()
        timeout_text = format_seconds(timeout or 0.0)
        message = f"command timed out after {timeout_text}s"
        detail = (stderr + "\n" + message).strip() if stderr else message
        return subprocess.CompletedProcess(args, 124, stdout, detail)


def run(args: list[str], *, check: bool = True) -> str:
    proc = run_proc(args)
    if check and proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        fail(f"command failed: {' '.join(args)}\n{detail}")
    return proc.stdout


def workspace_driver_json(args: list[str]) -> dict[str, Any]:
    driver = workspace_driver_command()
    if not driver:
        fail("SCHERZO_WORKSPACE_DRIVER is required for this operation")
    proc = run_proc([driver, *args])
    try:
        payload = json.loads(proc.stdout)
    except Exception as exc:
        fail(f"workspace driver returned malformed JSON for {' '.join(args)}: {exc}")
    if proc.returncode != 0:
        fail(str(payload.get("message") or proc.stderr or "workspace driver command failed"))
    if not isinstance(payload, dict) or payload.get("version") != 1:
        fail(f"workspace driver JSON for {' '.join(args)} must be an object with version=1")
    return payload


def changed_file_records() -> list[dict[str, str]]:
    payload = workspace_driver_json(["changed-files", "--json"])
    files = payload.get("files")
    if not isinstance(files, list):
        fail("workspace driver changed-files JSON must contain a files list")
    records: list[dict[str, str]] = []
    for item in files:
        if not isinstance(item, dict):
            fail("workspace driver changed-files entries must be objects")
        path = item.get("path")
        status = item.get("status")
        if not isinstance(path, str) or not isinstance(status, str):
            fail("workspace driver changed-files entries must include path and status strings")
        records.append({"path": path, "status": status})
    return records


def configured_repo() -> str:
    for name in ["SCHERZO_GITHUB_REPO", "SCHERZO_PR_REPO", "GITHUB_REPOSITORY"]:
        value = os.environ.get(name, "").strip()
        if value:
            return value
    fail(
        "missing GitHub repository; set SCHERZO_GITHUB_REPO, SCHERZO_PR_REPO, or GITHUB_REPOSITORY before materializing a commit_stack"
    )


def configured_base_branch() -> str:
    return os.environ.get("SCHERZO_JJ_WORKSPACE_BASE_BRANCH", "main").strip() or "main"


def fail_commit_stack(error: commit_stack_helper.CommitStackError) -> None:
    fail(error.message, code=error.code)


def validate_commit_stack_changed_files(review_path: Path) -> list[dict[str, str]]:
    normalized_review = normalize_repo_relative_path(str(review_path), label="review doc path")
    allowed_statuses = {"added", "modified"}
    records = changed_file_records()
    matching = [
        record
        for record in records
        if normalize_repo_relative_path(record["path"], label="changed review doc path") == normalized_review
        and record["status"] in allowed_statuses
    ]
    if len(matching) != 1:
        fail(
            f"workspace changed-files must contain exactly one added or modified review doc at {normalized_review}; found {len(matching)}"
        )
    unrelated = [
        normalize_repo_relative_path(record["path"], label="changed file path")
        for record in records
        if normalize_repo_relative_path(record["path"], label="changed file path") != normalized_review
    ]
    if unrelated:
        fail(
            "workspace changed-files must contain only the review doc change for ExecPlan publication; "
            + "unexpected paths: "
            + ", ".join(sorted(unrelated))
        )
    return records


def stable_branch_target_artifact() -> dict[str, Any]:
    return {
        "schema_version": 1,
        "artifact_type": "scherzo.github_publication_target.v1",
        "kind": "stable_branch",
    }


def existing_pr_branch_target_artifact(
    *,
    evidence: dict[str, Any],
    repository: str,
    base_branch: str,
    base_oid: str,
) -> dict[str, Any] | None:
    branch = str(evidence.get("branch") or "").strip()
    pr_url = str(evidence.get("pr_url") or "").strip()
    expected_head_sha = str(evidence.get("head_revision") or "").strip().lower()
    pr_number = int(github_pr_number(pr_url) or "0") if pr_url else 0
    if (
        pr_number <= 0
        or not branch
        or branch == "reused"
        or not safe_revision_branch(branch)
        or not safe_publication_guard_head(expected_head_sha)
    ):
        return None
    return {
        "schema_version": 1,
        "artifact_type": "scherzo.github_publication_target.v1",
        "kind": "existing_pr_branch",
        "existing_pr_branch": {
            "schema_version": 1,
            "artifact_type": "scherzo.github_existing_pr_branch_target.v1",
            "repository": {"repo": repository},
            "head": {
                "repo": repository,
                "branch": branch,
                "sha": expected_head_sha,
            },
            "base": {
                "branch": base_branch,
                "sha": base_oid,
            },
            "pull_request": {"number": pr_number, "url": pr_url},
        },
    }


def review_surface_publication_evidence(bundle: dict[str, Any]) -> dict[str, Any] | None:
    surface = bundle.get("review_surface")
    if not isinstance(surface, dict):
        return None
    return {
        "source": "review_surface",
        "status": str(surface.get("status") or "").strip(),
        "branch": str(surface.get("branch") or "").strip(),
        "pr_url": str(surface.get("pr_url") or "").strip(),
        "head_revision": str(surface.get("head_revision") or "").strip(),
    }


def bundle_run_ids(bundle: dict[str, Any]) -> list[str]:
    values: list[str] = []
    workflow = bundle.get("workflow")
    if isinstance(workflow, dict):
        values.append(str(workflow.get("run_id") or "").strip())
    handoff = bundle.get("implementation_handoff")
    if isinstance(handoff, dict):
        values.append(run_id_from_artifact_ref(str(handoff.get("bundle_ref") or "")))
    for key in ["plan", "implementation_pack"]:
        entry = bundle.get(key)
        if isinstance(entry, dict):
            values.append(run_id_from_artifact_ref(str(entry.get("ref") or "")))
    entries = bundle.get("entries")
    if isinstance(entries, list):
        for entry in entries:
            if isinstance(entry, dict):
                values.append(run_id_from_artifact_ref(str(entry.get("ref") or "")))
    unique: list[str] = []
    seen: set[str] = set()
    for value in values:
        if value and ARTIFACT_RUN_ID_RE.fullmatch(value) and value not in seen:
            unique.append(value)
            seen.add(value)
    return unique


def run_id_from_artifact_ref(ref: str) -> str:
    match = re.match(r"^runs/([^/]+)/", ref.strip())
    return match.group(1) if match else ""


def retained_publication_manifest_paths(bundle: dict[str, Any], publication_id: str) -> list[Path]:
    paths: list[Path] = []
    for run_id in bundle_run_ids(bundle):
        relative_dir = Path("runs") / run_id / "publications" / publication_id
        for root in artifact_roots(repo_root_arg=str(Path.cwd())):
            candidate_dir = root / relative_dir
            try:
                candidate_dir.resolve().relative_to(root.resolve())
            except Exception:
                continue
            if not candidate_dir.is_dir():
                continue
            paths.extend(sorted(candidate_dir.glob("*.json")))
    return unique_paths(paths)


def int_or_zero(value: Any) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def retained_review_publication_evidence(bundle: dict[str, Any]) -> list[dict[str, Any]]:
    evidence: list[dict[str, Any]] = []
    for path in retained_publication_manifest_paths(bundle, EXECPLAN_REVIEW_DOC_PUBLICATION_ID):
        try:
            manifest = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        item = publication_evidence_from_manifest(manifest)
        if item is not None:
            item["manifest_path"] = str(path)
            evidence.append(item)
    evidence.sort(
        key=lambda item: (
            int_or_zero(item.get("generated_at_ms")),
            str(item.get("attempt_id") or ""),
            str(item.get("manifest_path") or ""),
        ),
        reverse=True,
    )
    return evidence


def publication_evidence_from_manifest(manifest: Any) -> dict[str, Any] | None:
    if not isinstance(manifest, dict):
        return None
    if manifest.get("artifact_type") != ARTIFACT_PUBLICATION_MANIFEST_ARTIFACT_TYPE:
        return None
    if manifest.get("publication_id") != EXECPLAN_REVIEW_DOC_PUBLICATION_ID:
        return None
    if str(manifest.get("status") or "").strip() not in {"published", "unchanged"}:
        return None
    return {
        "source": "publication_manifest",
        "status": str(manifest.get("status") or "").strip(),
        "branch": str(manifest.get("branch") or "").strip(),
        "pr_url": str(manifest.get("pr_url") or "").strip(),
        "head_revision": str(manifest.get("head_revision") or manifest.get("commit_sha") or "").strip(),
        "generated_at_ms": int_or_zero(manifest.get("generated_at_ms")),
        "attempt_id": str(manifest.get("attempt_id") or ""),
    }


def retained_publication_matches_review_surface(
    evidence: dict[str, Any], surface: dict[str, Any] | None
) -> bool:
    if surface is None:
        return True
    surface_pr_url = str(surface.get("pr_url") or "").strip()
    if not surface_pr_url:
        return True
    evidence_pr_url = str(evidence.get("pr_url") or "").strip()
    return evidence_pr_url == surface_pr_url


def revision_publication_evidence(bundle: dict[str, Any]) -> list[dict[str, Any]]:
    evidence: list[dict[str, Any]] = []
    surface = review_surface_publication_evidence(bundle)
    for item in retained_review_publication_evidence(bundle):
        if retained_publication_matches_review_surface(item, surface):
            evidence.append(item)
    if surface is not None:
        evidence.append(surface)
    return evidence


def review_surface_target_artifact(
    *,
    previous_bundle: dict[str, Any],
    repository: str,
    base_branch: str,
    base_oid: str,
) -> dict[str, Any]:
    for evidence in revision_publication_evidence(previous_bundle):
        target = existing_pr_branch_target_artifact(
            evidence=evidence,
            repository=repository,
            base_branch=base_branch,
            base_oid=base_oid,
        )
        if target is not None:
            return target
    return stable_branch_target_artifact()


def discover_changed_review_doc(write_path: Path, *, target: dict[str, Any] | None = None) -> dict[str, Any]:
    expected = target or default_review_doc_target()
    records = changed_file_records()
    candidates = [
        normalize_repo_relative_path(record["path"], label="changed review doc path")
        for record in records
        if record["status"] in {"added", "modified"}
        and review_doc_path_matches_target(record["path"], expected)
    ]
    if len(candidates) != 1:
        fail(
            "expected exactly one added or modified Markdown ExecPlan review doc matching "
            f"{expected['kind']} `{expected['path']}`, found {len(candidates)}"
        )
    review_path = Path(candidates[0])
    meta = validate_review_doc_path(review_path, allow_fixture=False, target=expected)
    write_path.parent.mkdir(parents=True, exist_ok=True)
    write_path.write_text(str(review_path) + "\n", encoding="utf-8")
    print(f"REVIEW_DOC_TARGET_KIND={expected['kind']}")
    print(f"REVIEW_DOC_TARGET_PATH={expected['path']}")
    print(f"REVIEW_DOC_PATH={review_path}")
    print(f"REVIEW_DOC_SHA256={meta['sha256']}")
    print(f"REVIEW_DOC_PATH_FILE={write_path}")
    return meta


def command_prepare_review_doc_target(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan prepare-review-doc-target")
    parser.add_argument("--from-issue-context", action="store_true", required=True)
    parser.add_argument("--write-target")
    ns = parser.parse_args(args)
    target = review_doc_target_from_text(issue_context_text())
    ensure_review_doc_target_directory(target)
    if ns.write_target:
        write_json(Path(ns.write_target), target)
    print(f"REVIEW_DOC_TARGET_KIND={target['kind']}")
    print(f"REVIEW_DOC_TARGET_PATH={target['path']}")
    print(f"REVIEW_DOC_TARGET_DEFAULT={'1' if target['default'] else '0'}")
    print(f"REVIEW_DOC_TARGET_INSTRUCTIONS={review_doc_target_instruction(target)}")
    if ns.write_target:
        print(f"REVIEW_DOC_TARGET_FILE={ns.write_target}")


def command_validate_review_doc(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan validate-review-doc")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--path")
    group.add_argument("--discover-changed-review-doc", action="store_true")
    parser.add_argument("--write-path")
    parser.add_argument("--target-file")
    ns = parser.parse_args(args)
    target = read_review_doc_target_file(Path(ns.target_file)) if ns.target_file else None
    if ns.discover_changed_review_doc:
        if not ns.write_path:
            fail("--discover-changed-review-doc requires --write-path")
        discover_changed_review_doc(Path(ns.write_path), target=target)
        return
    if ns.write_path:
        fail("--write-path is only valid with --discover-changed-review-doc")
    if ns.target_file:
        fail("--target-file is only valid with --discover-changed-review-doc")
    meta = validate_review_doc_path(Path(ns.path))
    print("REVIEW_DOC_VALID=ok")
    print(f"REVIEW_DOC_PATH={meta['path']}")
    print(f"REVIEW_DOC_SHA256={meta['sha256']}")


def read_review_doc_path_file(path: Path) -> Path:
    try:
        value = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        fail(f"missing review doc path file: {path}")
    if not value:
        fail(f"review doc path file is empty: {path}")
    normalized = normalize_repo_relative_path(value, label="review doc path")
    return Path(normalized)


def run_root() -> Path | None:
    value = os.environ.get("SCHERZO_RUN_ROOT", "").strip()
    return Path(value) if value else None


def implementation_run_root() -> Path | None:
    root = run_root()
    if root is not None:
        return root
    cwd = Path.cwd().resolve()
    if cwd.parent.name == "workspaces":
        return cwd.parent.parent
    return None


def implementation_retention_marker_path() -> Path | None:
    root = implementation_run_root()
    return root / RETENTION_MARKER if root is not None else None


def write_implementation_retention_marker(source_kind: str, source_ref: str) -> Path | None:
    marker = implementation_retention_marker_path()
    if marker is None:
        return None
    marker.write_text(
        f"Schema: scherzo.retained-workspace.v1\n"
        f"Review state: publication_guard\n"
        f"Created at ms: {int(dt.datetime.now(tz=dt.timezone.utc).timestamp() * 1000)}\n"
        f"Source kind: {source_kind}\n"
        f"Source: {source_ref}\n"
        "Scherzo retained this run because an implementation workflow "
        "has not published a PR yet.\n"
        f"Source kind: {source_kind}\n"
        f"Source: {source_ref}\n",
        encoding="utf-8",
    )
    return marker


def artifact_run_id(default: str = "local-run") -> str:
    try:
        return commit_stack_helper.require_artifact_run_id(
            os.environ.get("SCHERZO_RUN_ID", default)
        )
    except commit_stack_helper.CommitStackError as exc:
        fail(exc.message, code=exc.code)


def run_artifact_dir() -> Path | None:
    value = os.environ.get("SCHERZO_RUN_ARTIFACT_DIR", "").strip()
    if value:
        return Path(value)
    return commit_stack_helper.run_artifact_dir(artifact_run_id())


def materialization_run_artifact_dir(run_id: str) -> Path:
    run_dir = run_artifact_dir()
    if run_dir is not None:
        return run_dir
    if os.environ.get("SCHERZO_RUN_ROOT", "").strip() or os.environ.get("SCHERZO_REPO_ROOT", "").strip():
        fail(
            "could not resolve durable run artifact directory; set SCHERZO_RUN_ARTIFACT_DIR or provide SCHERZO_RUN_ROOT/SCHERZO_REPO_ROOT with an artifact store",
            code="run_artifact_dir_missing",
        )
    return Path(".scherzo-state") / "artifacts" / "runs" / run_id


def unique_paths(paths: Iterable[Path]) -> list[Path]:
    unique: list[Path] = []
    seen: set[str] = set()
    for path in paths:
        key = str(path)
        if key not in seen:
            unique.append(path)
            seen.add(key)
    return unique


def run_root_artifact_roots() -> list[Path]:
    root = run_root()
    if root is None:
        return []
    workspace_root = (root / "../../..").resolve()
    return unique_paths(
        [
            root / ".scherzo-state" / "artifacts",
            workspace_root / ".scherzo-state" / "artifacts",
        ]
    )


def artifact_roots(*, artifact_root: str | None = None, repo_root_arg: str | None = None) -> list[Path]:
    roots: list[Path] = []
    if artifact_root:
        roots.append(Path(artifact_root))
    run_dir = run_artifact_dir()
    if run_dir is not None:
        roots.append(run_dir.parent)
    roots.extend(run_root_artifact_roots())
    env_root = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if env_root:
        roots.append(Path(env_root) / ".scherzo-state" / "artifacts")
    roots.append(Path.cwd() / ".scherzo-state" / "artifacts")
    if repo_root_arg:
        roots.append(Path(repo_root_arg) / "test" / "fixtures" / "execplan_v2" / "artifacts")
    return unique_paths(roots)


def validate_artifact_ref(ref: str) -> None:
    if not ref.startswith("runs/"):
        fail(f"artifact ref must start with runs/: {ref!r}")
    ensure_repo_relative_path(ref, label="artifact ref")


def resolve_artifact_ref(ref: str, *, artifact_root: str | None = None, repo_root_arg: str | None = None, code: str | None = None) -> Path:
    validate_artifact_ref(ref)
    tried: list[str] = []
    for root in artifact_roots(artifact_root=artifact_root, repo_root_arg=repo_root_arg):
        tried.append(str(root))
        candidate = root / ref
        try:
            candidate.resolve().relative_to(root.resolve())
        except Exception:
            continue
        if candidate.exists():
            return candidate
    fail(
        f"could not resolve artifact ref {ref}; tried artifact roots from --artifact-root, SCHERZO_RUN_ARTIFACT_DIR parent, SCHERZO_RUN_ROOT, SCHERZO_REPO_ROOT, .scherzo-state/artifacts, and test fixtures: {', '.join(tried)}",
        code=code,
    )


def validate_workstream_artifact_ref(ref: str) -> None:
    if not WORKSTREAM_ARTIFACT_REF_RE.fullmatch(ref):
        fail(f"workstream artifact ref must be an immutable sha256 snapshot: {ref!r}")
    ensure_repo_relative_path(ref, label="workstream artifact ref")


def resolve_stored_artifact_ref(ref: str, *, code: str | None = None) -> Path:
    if ref.startswith("runs/"):
        return resolve_artifact_ref(ref, code=code)
    if ref.startswith("workstream-artifacts/"):
        validate_workstream_artifact_ref(ref)
        tried: list[str] = []
        for root in artifact_roots(repo_root_arg=str(Path.cwd())):
            tried.append(str(root))
            candidate = root / ref
            try:
                candidate.resolve().relative_to(root.resolve())
            except Exception:
                continue
            if candidate.exists():
                return candidate
        fail(
            f"could not resolve workstream artifact ref {ref}; tried artifact roots: {', '.join(tried)}",
            code=code,
        )
    fail(f"unsupported artifact ref for exec_plan_bundle input: {ref!r}", code=code)


def current_input_manifest_path() -> Path | None:
    run_id = os.environ.get("SCHERZO_RUN_ID", "").strip()
    if not run_id:
        return None
    ref = f"runs/{run_id}/inputs.v1.json"
    validate_artifact_ref(ref)
    for root in artifact_roots(repo_root_arg=str(Path.cwd())):
        candidate = root / ref
        try:
            candidate.resolve().relative_to(root.resolve())
        except Exception:
            continue
        if candidate.exists():
            return candidate
    return None


def canonical_plan_ref(run_id: str) -> str:
    return f"runs/{run_id}/outputs/{CANONICAL_PLAN_OUTPUT_NAME}.md"


def canonical_plan_descriptor(run_id: str, source: Path) -> dict[str, Any]:
    data = path_bytes(source, code="execplan_v2_plan_missing")
    return {
        "ref": canonical_plan_ref(run_id),
        "sha256": sha256_bytes(data),
        "bytes": len(data),
        "media_type": CANONICAL_PLAN_MEDIA_TYPE,
    }


def write_canonical_plan_output(source: Path) -> dict[str, Any]:
    canonical_path = implementation_state_path(CANONICAL_IMPLEMENTATION_PLAN_STATE_NAME) or CANONICAL_PLAN_OUTPUT_PATH
    canonical_path.parent.mkdir(parents=True, exist_ok=True)
    source = resolve_run_root_relative_path(source)
    if source.resolve(strict=False) != canonical_path.resolve(strict=False):
        shutil.copyfile(source, canonical_path)
    copy_best_effort(canonical_path, CANONICAL_PLAN_OUTPUT_PATH)
    return canonical_plan_descriptor(os.environ.get("SCHERZO_RUN_ID", "local-run"), canonical_path)


def bundle_expected_plan_sha(bundle: dict[str, Any]) -> str:
    return str(descriptor_plan_entry(bundle).get("sha256") or "")


def validate_bundle_plan(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    plan = descriptor_plan_entry(bundle)
    plan_ref = str(plan.get("ref") or "")
    plan_path = resolve_artifact_ref(
        plan_ref,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
        code="execplan_v2_plan_missing",
    )
    data = path_bytes(plan_path, code="execplan_v2_plan_missing")
    meta = {"sha256": sha256_bytes(data), "bytes": len(data)}
    if meta["sha256"] != plan.get("sha256") or meta["bytes"] != plan.get("bytes"):
        fail("plan artifact bytes do not match descriptor plan entry", code="execplan_v2_plan_hash_mismatch")
    return meta, plan_path


def validate_bundle_canonical_plan(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    return validate_bundle_plan(bundle, artifact_root=artifact_root, repo_root_arg=repo_root_arg)


def bundle_review_path(bundle: dict[str, Any]) -> str:
    return plan_entry_publication_destination_path(bundle) or ""


def structured_artifact_candidates(step: str, artifact_name: str) -> list[Path]:
    roots: list[Path] = []
    run_dir = run_artifact_dir()
    if run_dir is not None:
        roots.append(run_dir)
    run_id = os.environ.get("SCHERZO_RUN_ID", "").strip()
    if run_id:
        roots.extend(root / "runs" / run_id for root in run_root_artifact_roots())
    env_root = os.environ.get("SCHERZO_REPO_ROOT", "").strip()
    if run_id and env_root:
        roots.append(Path(env_root) / ".scherzo-state" / "artifacts" / "runs" / run_id)
    if run_id:
        roots.append(Path.cwd() / ".scherzo-state" / "artifacts" / "runs" / run_id)
    candidates: list[Path] = []
    for root in unique_paths(roots):
        pattern = str(root / step / "attempt-*" / "structured" / f"{artifact_name}.json")
        candidates.extend(Path(path) for path in glob.glob(pattern))
    return sorted(unique_paths(candidates))


def attempt_number(path: Path) -> int:
    for part in path.parts:
        match = re.match(r"attempt-(\d+)$", part)
        if match:
            return int(match.group(1))
    return 0


def resolve_structured_submission(step: str, artifact_name: str) -> Path:
    candidates = structured_artifact_candidates(step, artifact_name)
    valid: list[Path] = []
    for candidate in candidates:
        payload = load_json(candidate)
        if isinstance(payload, dict) and payload.get("artifact_name") == artifact_name and isinstance(payload.get("payload"), dict):
            valid.append(candidate)
    if not valid:
        fail(f"no structured-output artifact found for step {step!r} artifact {artifact_name!r}")
    highest = max(attempt_number(path) for path in valid)
    latest = [path for path in valid if attempt_number(path) == highest]
    if len(latest) != 1:
        fail(f"ambiguous structured-output artifacts for step {step!r} artifact {artifact_name!r}")
    return latest[0]


def submission_payload(path: Path) -> dict[str, Any]:
    value = load_json(path)
    if not isinstance(value, dict):
        fail(f"submission must be a JSON object: {path}")
    if isinstance(value.get("payload"), dict):
        value = value["payload"]
    if not isinstance(value, dict):
        fail(f"submission payload must be a JSON object: {path}")
    return value


def now_iso() -> str:
    fixed = env_value("SCHERZO_EXECPLAN_FIXED_TIME", legacy="SCHERZO_EXECPLAN_V2_FIXED_TIME")
    if fixed:
        return fixed
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def source_issue_from_submission_or_env(payload: dict[str, Any]) -> dict[str, str]:
    source = payload.get("source_issue")
    if isinstance(source, dict):
        identifier = str(source.get("identifier") or "").strip()
        title = str(source.get("title") or "").strip()
        url = str(source.get("url") or "").strip()
        if identifier and title and url:
            return {"identifier": identifier, "title": title, "url": url}
    identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "LIV-UNKNOWN").strip() or "LIV-UNKNOWN"
    title = os.environ.get("SCHERZO_ISSUE_TITLE", "Untitled source task").strip() or "Untitled source task"
    url = os.environ.get("SCHERZO_ISSUE_URL", f"https://linear.app/living-systems/issue/{identifier}").strip()
    return {"identifier": identifier, "title": title, "url": url}


def materialize_pack(review_doc: Path, submission: Path, output: Path) -> dict[str, Any]:
    review_meta = validate_review_doc_path(review_doc)
    payload = submission_payload(submission)
    artifact_type = payload.get("artifact_type")
    if artifact_type == "exec_plan_revision_submission":
        validate_schema(payload, EXEC_PLAN_REVISION_SUBMISSION_SCHEMA)
    else:
        validate_schema(payload, IMPLEMENTATION_PACK_SUBMISSION_SCHEMA)
    review_text = path_bytes(review_doc).decode("utf-8", errors="replace")
    fail_completion_preflight(completion_pack_alignment_findings(review_text, payload))
    source_issue = source_issue_from_submission_or_env(payload)
    pack_id = str(payload.get("pack_id") or f"pack-{source_issue['identifier'].lower()}-{os.environ.get('SCHERZO_RUN_ID', 'local')}")
    pack = {
        "schema_version": 2,
        "kind": "file",
        "media_type": "application/json",
        "artifact_type": IMPLEMENTATION_PACK_ARTIFACT_TYPE,
        "pack_id": pack_id,
        "source_issue": source_issue,
        "review_doc": review_meta,
        "derived_from": {
            "review_doc_path": review_meta["path"],
            "review_doc_sha256": review_meta["sha256"],
        },
        "provenance": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan"),
            "run_id": os.environ.get("SCHERZO_RUN_ID", "local-run"),
            "step_id": os.environ.get("SCHERZO_STEP_ID", "materialize_pack"),
            "created_at": now_iso(),
        },
        "sections": payload["sections"],
        "conflict_policy": str(payload["conflict_policy"]),
    }
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA)
    output = resolve_run_root_relative_path(output)
    write_json(output, pack)
    copy_best_effort(output, Path("tmp/execplan-implementation-pack.json"))
    sys.stdout.write(canonical_json(pack))
    return pack


def command_materialize_pack(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-pack")
    parser.add_argument("--review-doc")
    parser.add_argument("--review-doc-path-file")
    parser.add_argument("--submission")
    parser.add_argument("--submission-step")
    parser.add_argument("--submission-artifact")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    if bool(ns.review_doc) == bool(ns.review_doc_path_file):
        fail("provide exactly one of --review-doc or --review-doc-path-file")
    if ns.review_doc_path_file:
        review_doc = read_review_doc_path_file(Path(ns.review_doc_path_file))
    else:
        review_doc = Path(ns.review_doc)
    if ns.submission:
        submission = Path(ns.submission)
    else:
        if not ns.submission_step or not ns.submission_artifact:
            fail("provide --submission or both --submission-step and --submission-artifact")
        submission = resolve_structured_submission(ns.submission_step, ns.submission_artifact)
    materialize_pack(review_doc, submission, Path(ns.output))


def reject_bundle_self_hash(bundle: dict[str, Any]) -> None:
    forbidden = {"sha256", "bundle_sha256", "bundle_hash", "self_sha256", "canonical_sha256"}
    present = sorted(forbidden.intersection(bundle.keys()))
    if present:
        fail("exec_plan_bundle must not store its own SHA-256 inside the bundle body: " + ", ".join(present))


def canonicalize_execplan_bundle(bundle: Any) -> Any:
    if not isinstance(bundle, dict):
        return bundle
    handoff = bundle.get("implementation_handoff")
    if isinstance(handoff, dict) and handoff.get("workflow_label") == LEGACY_IMPLEMENTATION_WORKFLOW_LABEL:
        handoff["workflow_label"] = CANONICAL_IMPLEMENTATION_WORKFLOW_LABEL
    return bundle


def load_unvalidated_execplan_bundle(bundle_path: Path) -> dict[str, Any]:
    bundle = load_json(bundle_path)
    if not isinstance(bundle, dict):
        fail("bundle JSON must be an object", code="execplan_v2_bundle_missing")
    reject_bundle_self_hash(bundle)
    canonicalize_execplan_bundle(bundle)
    descriptor_plan_entry(bundle)
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    validate_execplan_bundle_descriptor_entries(bundle)
    return bundle


def load_execplan_bundle_payload(
    bundle_path: Path, *, bundle_sha256: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], str]:
    bundle_data = path_bytes(bundle_path, code="execplan_v2_bundle_missing")
    actual_bundle_sha = sha256_bytes(bundle_data)
    expected_bundle_sha = bundle_sha256.lower() if bundle_sha256 else None
    if expected_bundle_sha and actual_bundle_sha != expected_bundle_sha:
        fail("bundle file SHA-256 does not match supplied --bundle-sha256", code="execplan_v2_bundle_hash_mismatch")
    try:
        bundle = json.loads(bundle_data.decode("utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"invalid bundle JSON: {exc}", code="execplan_v2_bundle_missing")
    if not isinstance(bundle, dict):
        fail("bundle JSON must be an object", code="execplan_v2_bundle_missing")
    reject_bundle_self_hash(bundle)
    canonicalize_execplan_bundle(bundle)
    descriptor_plan_entry(bundle)
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA, root=repo_root(repo_root_arg))
    validate_execplan_bundle_descriptor_entries(bundle)
    return bundle, actual_bundle_sha


def load_bundle_json(bundle_path: Path, *, bundle_sha256: str | None = None, repo_root_arg: str | None = None) -> dict[str, Any]:
    bundle, _actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    return bundle


def validate_bundle_review_doc(
    bundle: dict[str, Any],
    *,
    repo_root_arg: str | None = None,
    missing_code: str = "execplan_v2_review_doc_missing",
) -> dict[str, Any]:
    review_path_value = plan_entry_publication_destination_path(bundle, required=True)
    if review_path_value is None:
        fail_descriptor_required(
            "descriptor plan entry is missing metadata.publication.destination_path"
        )
    review_path = review_doc_filesystem_path(review_path_value, repo_root(repo_root_arg))
    review_meta = file_meta(review_path, code=missing_code)
    plan = descriptor_plan_entry(bundle)
    if review_meta["sha256"] != plan["sha256"] or review_meta["bytes"] != plan["bytes"]:
        fail("review doc bytes do not match descriptor plan entry", code="execplan_v2_review_doc_hash_mismatch")
    return review_meta


def review_doc_meta_for_bundle(
    bundle: dict[str, Any],
    *,
    repo_root_arg: str | None = None,
    missing_code: str = "execplan_v2_review_doc_missing",
) -> dict[str, Any]:
    return validate_bundle_review_doc(bundle, repo_root_arg=repo_root_arg, missing_code=missing_code)


def validate_bundle_implementation_pack(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    expected_plan_sha = bundle_expected_plan_sha(bundle)
    pack_ref = bundle["implementation_pack"]["ref"]
    pack_path = resolve_artifact_ref(
        pack_ref,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
        code="execplan_v2_implementation_pack_missing",
    )
    pack_data = path_bytes(pack_path, code="execplan_v2_implementation_pack_missing")
    pack_sha = sha256_bytes(pack_data)
    if pack_sha != bundle["implementation_pack"]["sha256"] or len(pack_data) != bundle["implementation_pack"]["bytes"]:
        fail("implementation pack bytes do not match bundle metadata", code="execplan_v2_implementation_pack_hash_mismatch")
    try:
        pack = json.loads(pack_data.decode("utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"invalid implementation pack JSON: {exc}", code="execplan_v2_implementation_pack_missing")
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA, root=repo_root(repo_root_arg))
    pack_review_sha = str(pack.get("derived_from", {}).get("review_doc_sha256") or "")
    if pack_review_sha != expected_plan_sha:
        fail("implementation pack was derived from a different plan hash", code="execplan_v2_stale_implementation_pack")
    if bundle["implementation_pack"]["derived_from_review_doc_sha256"] != expected_plan_sha:
        fail("bundle implementation_pack.derived_from_review_doc_sha256 is stale", code="execplan_v2_stale_implementation_pack")
    if pack.get("review_doc", {}).get("sha256") != expected_plan_sha:
        fail("implementation pack review_doc hash does not match bundle plan", code="execplan_v2_stale_implementation_pack")
    return pack, pack_path


def descriptor_entries_by_name(bundle: dict[str, Any]) -> dict[str, dict[str, Any]]:
    if bundle.get("schema_version") != 2:
        fail_descriptor_required("exec_plan_bundle schema_version must be 2")
    if bundle.get("artifact_type") != EXEC_PLAN_BUNDLE_ARTIFACT_TYPE:
        fail_descriptor_required(
            "exec_plan_bundle artifact_type must be scherzo.exec_plan_bundle.v2"
        )
    if bundle.get("kind") != "artifact_set" or bundle.get("media_type") != "application/json":
        fail_descriptor_required(
            "exec_plan_bundle must be an artifact_set with media_type application/json"
        )
    entries = bundle.get("entries")
    if not isinstance(entries, list):
        fail_descriptor_required("exec_plan_bundle is missing descriptor entries[]")
    by_name: dict[str, dict[str, Any]] = {}
    for entry in entries:
        if not isinstance(entry, dict):
            fail("exec_plan_bundle entries must be objects", code="execplan_v2_descriptor_entry_mismatch")
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            fail("exec_plan_bundle entries require names", code="execplan_v2_descriptor_entry_mismatch")
        if name in by_name:
            fail(f"duplicate exec_plan_bundle descriptor entry: {name}", code="execplan_v2_descriptor_entry_mismatch")
        by_name[name] = entry
    return by_name


def require_descriptor_entry(entries: dict[str, dict[str, Any]], name: str) -> dict[str, Any]:
    entry = entries.get(name)
    if entry is None and name == CANONICAL_PLAN_OUTPUT_NAME:
        fail_descriptor_required("exec_plan_bundle entries[] is missing the descriptor plan entry")
    if entry is None:
        fail(f"exec_plan_bundle missing descriptor entry: {name}", code="execplan_v2_descriptor_entry_mismatch")
    return entry


def descriptor_plan_entry(bundle: dict[str, Any]) -> dict[str, Any]:
    entry = require_descriptor_entry(descriptor_entries_by_name(bundle), CANONICAL_PLAN_OUTPUT_NAME)
    if entry.get("kind") != "file":
        fail("exec_plan_bundle descriptor plan entry kind must be file", code="execplan_v2_descriptor_entry_mismatch")
    if entry.get("artifact_type") != EXEC_PLAN_ARTIFACT_TYPE:
        fail(
            "exec_plan_bundle descriptor plan entry artifact_type must be scherzo.exec_plan.v1",
            code="execplan_v2_descriptor_entry_mismatch",
        )
    if entry.get("media_type") != CANONICAL_PLAN_MEDIA_TYPE:
        fail(
            "exec_plan_bundle descriptor plan entry media_type must be text/markdown",
            code="execplan_v2_descriptor_entry_mismatch",
        )
    return entry


def require_descriptor_entry_field(entry: dict[str, Any], name: str, field: str, expected: Any) -> None:
    if entry.get(field) != expected:
        fail(
            f"exec_plan_bundle descriptor entry {name}.{field} does not match canonical metadata",
            code="execplan_v2_descriptor_entry_mismatch",
        )


def validate_descriptor_file_entry(
    entry: dict[str, Any], name: str, expected: dict[str, Any], *, artifact_type: str, media_type: str
) -> None:
    require_descriptor_entry_field(entry, name, "kind", "file")
    require_descriptor_entry_field(entry, name, "artifact_type", artifact_type)
    require_descriptor_entry_field(entry, name, "ref", expected.get("ref"))
    require_descriptor_entry_field(entry, name, "sha256", expected.get("sha256"))
    require_descriptor_entry_field(entry, name, "bytes", expected.get("bytes"))
    require_descriptor_entry_field(entry, name, "media_type", media_type)


def validate_execplan_bundle_descriptor_entries(bundle: dict[str, Any]) -> None:
    if bundle.get("artifact_type") != EXEC_PLAN_BUNDLE_ARTIFACT_TYPE:
        return
    plan = bundle.get("plan")
    if not isinstance(plan, dict):
        fail("descriptor-first exec_plan_bundle requires plan metadata", code="execplan_v2_descriptor_entry_mismatch")
    implementation_pack = bundle.get("implementation_pack")
    if not isinstance(implementation_pack, dict):
        fail("exec_plan_bundle requires implementation_pack metadata", code="execplan_v2_descriptor_entry_mismatch")
    entries = descriptor_entries_by_name(bundle)
    validate_descriptor_file_entry(
        require_descriptor_entry(entries, "plan"),
        "plan",
        plan,
        artifact_type=EXEC_PLAN_ARTIFACT_TYPE,
        media_type=CANONICAL_PLAN_MEDIA_TYPE,
    )
    validate_descriptor_file_entry(
        require_descriptor_entry(entries, "implementation_pack"),
        "implementation_pack",
        implementation_pack,
        artifact_type=IMPLEMENTATION_PACK_ARTIFACT_TYPE,
        media_type="application/json",
    )


def load_bundle_pack(
    bundle: dict[str, Any], *, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], Path]:
    return validate_bundle_implementation_pack(bundle, artifact_root=artifact_root, repo_root_arg=repo_root_arg)


def load_and_validate_bundle(
    bundle_path: Path, *, bundle_sha256: str | None = None, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], dict[str, Any], Path]:
    bundle, _actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    validate_bundle_canonical_plan(bundle, artifact_root=artifact_root, repo_root_arg=repo_root_arg)
    pack, pack_path = validate_bundle_implementation_pack(
        bundle,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
    )
    validate_execplan_bundle_descriptor_entries(bundle)
    return bundle, pack, pack_path


def load_and_validate_retained_bundle(
    bundle_path: Path, *, bundle_sha256: str | None = None, artifact_root: str | None = None, repo_root_arg: str | None = None
) -> tuple[dict[str, Any], dict[str, Any], Path, str]:
    bundle, actual_bundle_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=bundle_sha256,
        repo_root_arg=repo_root_arg,
    )
    validate_bundle_plan(bundle, artifact_root=artifact_root, repo_root_arg=repo_root_arg)
    pack, pack_path = validate_bundle_implementation_pack(
        bundle,
        artifact_root=artifact_root,
        repo_root_arg=repo_root_arg,
    )
    validate_execplan_bundle_descriptor_entries(bundle)
    return bundle, pack, pack_path, actual_bundle_sha


def command_validate_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan validate-bundle")
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--bundle-sha256")
    parser.add_argument("--artifact-root")
    parser.add_argument("--repo-root", required=True)
    ns = parser.parse_args(args)
    bundle, _pack, _pack_path = load_and_validate_bundle(
        Path(ns.bundle),
        bundle_sha256=ns.bundle_sha256,
        artifact_root=ns.artifact_root,
        repo_root_arg=ns.repo_root,
    )
    print("BUNDLE_VALID=ok")
    print(f"BUNDLE_ID={bundle['bundle_id']}")


def slug(value: str) -> str:
    value = value.lower()
    value = re.sub(r"[^a-z0-9._-]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value or "task"


def issue_context_text(*, allow_linear: bool = True) -> str:
    env = os.environ.get("SCHERZO_ISSUE_CONTEXT", "")
    if env:
        return env
    identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if allow_linear and identifier and shutil.which("linear"):
        proc = run_proc(
            ["linear", "issue", "view", identifier, "--json", "--no-download"],
            timeout=LINEAR_ISSUE_CONTEXT_TIMEOUT_SECONDS,
        )
        if proc.returncode == 0:
            print("scherzo-execplan: loaded issue context via Linear CLI fallback", file=sys.stderr)
            try:
                data = json.loads(proc.stdout)
            except Exception:
                data = {}
            if isinstance(data, dict):
                return "\n".join(
                    str(data.get(key) or "") for key in ["identifier", "title", "url", "description"]
                )
    title = os.environ.get("SCHERZO_ISSUE_TITLE", "")
    url = os.environ.get("SCHERZO_ISSUE_URL", "")
    return f"{identifier}\n{title}\n\n{url}"


def source_issue_from_context_or_env(default: dict[str, Any] | None = None) -> dict[str, str]:
    if default:
        return {
            "identifier": str(default.get("identifier") or "LIV-UNKNOWN"),
            "title": str(default.get("title") or "Untitled source task"),
            "url": str(default.get("url") or "https://linear.app/living-systems/issue/LIV-UNKNOWN"),
        }
    return source_issue_from_submission_or_env({})


def load_pack_for_review(pack_path: Path, review_meta: dict[str, Any]) -> dict[str, Any]:
    pack = load_json(pack_path)
    validate_schema(pack, IMPLEMENTATION_PACK_SCHEMA)
    expected_sha = review_meta["sha256"]
    if pack.get("derived_from", {}).get("review_doc_sha256") != expected_sha:
        fail("implementation pack is stale for current review doc", code="execplan_v2_stale_implementation_pack")
    if pack.get("review_doc", {}).get("sha256") != expected_sha:
        fail("implementation pack review_doc hash does not match current review doc", code="execplan_v2_stale_implementation_pack")
    return pack



def ensure_source_issue_identifier_matches(source_issue: dict[str, str], expected_identifier: str | None, context: str) -> None:
    expected = str(expected_identifier or "").strip()
    if not expected or expected == "LIV-UNKNOWN":
        return
    actual = source_issue["identifier"].strip()
    if actual != expected:
        fail(
            f"implementation pack source issue identifier {actual!r} does not match {context} {expected!r}",
            code="execplan_v2_source_issue_mismatch",
        )



def linear_issue_nodes(payload: Any) -> list[Any]:
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict) and isinstance(payload.get("nodes"), list):
        return payload["nodes"]
    return []


def issue_has_workflow_label(issue: dict[str, Any], label: str) -> bool:
    raw_labels = issue.get("labels")
    if isinstance(raw_labels, dict):
        raw_labels = raw_labels.get("nodes")
    if not isinstance(raw_labels, list):
        return False
    for item in raw_labels:
        if isinstance(item, str) and item.lower() == label.lower():
            return True
        if isinstance(item, dict) and str(item.get("name") or "").lower() == label.lower():
            return True
    return False


def strip_ansi(value: str) -> str:
    return ANSI_ESCAPE_RE.sub("", value)


def linear_issue_identifier(value: str) -> str:
    match = LINEAR_ISSUE_IDENTIFIER_RE.search(strip_ansi(value))
    return match.group(1).upper() if match else ""


def find_existing_handoff_issue(team: str, bundle_ref: str) -> dict[str, str] | None:
    proc = run_proc(["linear", "issue", "query", "--team", team, "--search", bundle_ref, "--limit", "250", "--json"])
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except Exception:
        return None
    for item in linear_issue_nodes(payload):
        if not isinstance(item, dict):
            continue
        text = str(item.get("title") or "") + "\n" + str(item.get("description") or "")
        if bundle_ref in text and issue_has_workflow_label(item, "workflow:execplan-implementation"):
            return issue_result_from_json(item)
    return None


def issue_result_from_json(data: Any) -> dict[str, str] | None:
    if not isinstance(data, dict):
        return None
    if isinstance(data.get("issue"), dict):
        data = data["issue"]
    elif isinstance(data.get("data"), dict):
        nested = data["data"]
        if isinstance(nested.get("issue"), dict):
            data = nested["issue"]
        elif isinstance(nested.get("issueCreate"), dict) and isinstance(nested["issueCreate"].get("issue"), dict):
            data = nested["issueCreate"]["issue"]
    identifier = linear_issue_identifier(str(data.get("identifier") or data.get("id") or ""))
    url = strip_ansi(str(data.get("url") or "")).strip()
    if not identifier and url:
        identifier = linear_issue_identifier(url)
    if not identifier:
        return None
    if not url:
        url = f"https://linear.app/living-systems/issue/{identifier}"
    return {"issue_identifier": identifier, "issue_url": url}


def issue_result_from_create_output(output: str) -> dict[str, str] | None:
    cleaned = strip_ansi(output)
    try:
        parsed = json.loads(cleaned)
    except Exception:
        parsed = None
    from_json = issue_result_from_json(parsed)
    if from_json is not None:
        return from_json

    url_match = LINEAR_ISSUE_URL_RE.search(cleaned)
    if url_match:
        return {"issue_identifier": url_match.group(1).upper(), "issue_url": url_match.group(0).rstrip(".,;")}

    identifier = linear_issue_identifier(cleaned)
    if identifier:
        return {"issue_identifier": identifier, "issue_url": f"https://linear.app/living-systems/issue/{identifier}"}
    return None


def view_linear_issue_json(identifier: str) -> Any | None:
    proc = run_proc(["linear", "issue", "view", identifier, "--json", "--no-download"])
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout)
    except Exception:
        return None


def view_linear_issue(identifier: str) -> dict[str, str] | None:
    data = view_linear_issue_json(identifier)
    if data is None:
        return None
    return issue_result_from_json(data)


def linear_issue_project_name(identifier: str) -> str:
    data = view_linear_issue_json(identifier)
    if not isinstance(data, dict):
        return ""
    issue = data
    if isinstance(data.get("issue"), dict):
        issue = data["issue"]
    elif isinstance(data.get("data"), dict) and isinstance(data["data"].get("issue"), dict):
        issue = data["data"]["issue"]
    project = issue.get("project")
    if not isinstance(project, dict):
        return ""
    return str(project.get("name") or "").strip()


def handoff_issue_description(
    source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str
) -> str:
    note = (
        "This description will be updated automatically with the final bundle hash before implementation dispatch. "
        "If it still says `pending`, use the follow-up helper comment with the final bundle hash."
        if bundle_sha == "pending"
        else "This description contains the final bundle hash required by the implementation workflow."
    )
    return (
        f"Implement the ExecPlan bundle produced for {source_issue['identifier']}.\n\n"
        f"Bundle ref: {bundle_ref}\n"
        f"Bundle sha256: {bundle_sha}\n"
        f"Review doc: {review_path}\n"
        f"Implementation pack sha256: {pack_sha}\n\n"
        "Use `workflow:execplan-implementation` after the review doc PR is merged and a human moves this task to Todo. "
        f"{note}\n"
    )


def create_or_reuse_handoff_issue(
    source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str
) -> dict[str, str]:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        identifier = env_value("SCHERZO_EXECPLAN_HANDOFF_IDENTIFIER", source_issue["identifier"] + "-IMPL", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_IDENTIFIER")
        url = env_value("SCHERZO_EXECPLAN_HANDOFF_URL", f"https://linear.app/living-systems/issue/{identifier}", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_URL")
        return {"issue_identifier": identifier, "issue_url": url}
    team = source_issue["identifier"].split("-", 1)[0]
    existing = find_existing_handoff_issue(team, bundle_ref)
    if existing is not None and existing.get("issue_identifier"):
        return existing
    title = f"Implement: {source_issue['title']}"
    description = handoff_issue_description(source_issue, bundle_ref, bundle_sha, pack_sha, review_path)
    tmp = Path("tmp") / "execplan-handoff-body.md"
    tmp.parent.mkdir(exist_ok=True)
    tmp.write_text(description, encoding="utf-8")
    create_args = [
        "linear",
        "issue",
        "create",
        "--team",
        team,
        "--title",
        title,
        "--description-file",
        str(tmp),
        "--label",
        "workflow:execplan-implementation",
        "--state",
        "Backlog",
        "--no-interactive",
    ]
    project = env_value("SCHERZO_EXECPLAN_HANDOFF_PROJECT", legacy="SCHERZO_EXECPLAN_V2_HANDOFF_PROJECT") or linear_issue_project_name(
        source_issue["identifier"]
    )
    if project:
        create_args.extend(["--project", project])
    proc = run_proc(create_args)
    if proc.returncode != 0:
        fail("failed to create Linear implementation handoff task: " + (proc.stderr.strip() or proc.stdout.strip()))
    created = issue_result_from_create_output(proc.stdout)
    if created is None:
        fail("failed to parse created Linear implementation handoff task: " + proc.stdout.strip())
    viewed = view_linear_issue(created["issue_identifier"])
    return viewed or created


def update_handoff_issue_description(handoff: dict[str, str], source_issue: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str) -> None:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        return
    identifier = handoff.get("issue_identifier", "").strip()
    if not identifier:
        return
    tmp = Path("tmp") / "execplan-handoff-body-final.md"
    tmp.parent.mkdir(exist_ok=True)
    tmp.write_text(
        handoff_issue_description(source_issue, bundle_ref, bundle_sha, pack_sha, review_path),
        encoding="utf-8",
    )
    proc = run_proc(["linear", "issue", "update", identifier, "--description-file", str(tmp)])
    if proc.returncode != 0:
        fail("failed to update Linear implementation handoff task with final bundle hash: " + (proc.stderr.strip() or proc.stdout.strip()))


def annotate_handoff_issue(handoff: dict[str, str], bundle_ref: str, bundle_sha: str, pack_sha: str, review_path: str) -> None:
    if env_enabled("SCHERZO_EXECPLAN_OFFLINE_LINEAR", legacy="SCHERZO_EXECPLAN_V2_OFFLINE_LINEAR") or not shutil.which("linear"):
        return
    identifier = handoff.get("issue_identifier", "").strip()
    if not identifier:
        return
    body = (
        "ExecPlan bundle materialized.\n\n"
        f"Bundle ref: {bundle_ref}\n"
        f"Bundle sha256: {bundle_sha}\n"
        f"Review doc: {review_path}\n"
        f"Implementation pack sha256: {pack_sha}\n"
    )
    proc = run_proc(["linear", "issue", "comment", "add", identifier, "--body", body])
    if proc.returncode != 0:
        fail("failed to annotate Linear implementation handoff task: " + (proc.stderr.strip() or proc.stdout.strip()))


def command_materialize_commit_stack(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-commit-stack")
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--previous-bundle")
    parser.add_argument("--target-output")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    previous_bundle = None
    if ns.target_output:
        if not ns.previous_bundle:
            fail("materialize-commit-stack requires --previous-bundle when --target-output is set")
        previous_bundle = load_unvalidated_execplan_bundle(Path(ns.previous_bundle))
        refresh_revision_base_for_publication(previous_bundle, stage="materialize_commit_stack")
    review_meta = validate_review_doc_path(review_path)
    validate_commit_stack_changed_files(review_path)
    repository = configured_repo()
    base_branch = configured_base_branch()
    output_path = resolve_run_root_relative_path(Path(ns.output))
    try:
        artifact = commit_stack_helper.materialize_commit_stack_artifact(
            repository=repository,
            base_ref=base_branch,
            base_revision="@-",
            output_path=output_path,
            carrier_name=COMMIT_STACK_CARRIER_NAME,
            description_title=f"ExecPlan review doc: {review_meta['path']}",
            bundle_ref_namespace="commit-stack",
        )
        copy_best_effort(output_path, Path("tmp/execplan-commit-stack.json"))
    except commit_stack_helper.CommitStackError as exc:
        fail_commit_stack(exc)
    base_oid = artifact["base"]["sha"]
    head_oid = artifact["head"]["sha"]
    if ns.target_output:
        target = review_surface_target_artifact(
            previous_bundle=previous_bundle or {},
            repository=repository,
            base_branch=base_branch,
            base_oid=base_oid,
        )
        ensure_commit_stack_base_matches_publication_target(artifact=artifact, target=target)
        target_output_path = resolve_run_root_relative_path(Path(ns.target_output))
        write_json(target_output_path, target)
        copy_best_effort(target_output_path, Path("tmp/execplan-publication-target.json"))
        print(f"TARGET_OUTPUT={display_path(target_output_path)}")
        print(f"TARGET_KIND={target['kind']}")
        if target["kind"] == "existing_pr_branch":
            existing = target["existing_pr_branch"]
            print(f"TARGET_BRANCH={existing['head']['branch']}")
            print(f"TARGET_PR_URL={existing['pull_request']['url']}")
    print(f"REVIEW_DOC_PATH={review_meta['path']}")
    print(f"COMMIT_STACK_BASE_REF={base_branch}")
    print(f"COMMIT_STACK_BASE_SHA={base_oid}")
    print(f"COMMIT_STACK_HEAD_SHA={head_oid}")
    print(f"COMMIT_STACK_PATH={display_path(output_path)}")


def materialize_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-bundle")
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--pack", required=True)
    parser.add_argument("--publish-context")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    review_meta = validate_review_doc_path(review_path)
    pack_path = Path(ns.pack)
    pack = load_pack_for_review(pack_path, review_meta)
    pack_meta = file_meta(pack_path)
    source_issue = source_issue_from_submission_or_env(pack)
    ensure_source_issue_identifier_matches(source_issue, os.environ.get("SCHERZO_ISSUE_IDENTIFIER"), "SCHERZO_ISSUE_IDENTIFIER")
    publish_context = load_json(Path(ns.publish_context)) if ns.publish_context else None
    publish_source_issue = publish_context.get("source_issue") if isinstance(publish_context, dict) else None
    if isinstance(publish_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(publish_source_issue.get("identifier") or ""),
            "publish context source_issue.identifier",
        )
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    plan_meta = write_canonical_plan_output(review_path)
    pack_ref = f"runs/{run_id}/outputs/implementation_pack.json"
    bundle_ref = f"runs/{run_id}/outputs/exec_plan_bundle.json"
    plan_entry_metadata = plan_publication_metadata(review_meta)
    bundle = {
        "schema_version": 2,
        "kind": "artifact_set",
        "media_type": "application/json",
        "artifact_type": EXEC_PLAN_BUNDLE_ARTIFACT_TYPE,
        "bundle_id": f"bundle-{source_issue['identifier'].lower()}-{run_id}",
        "source_issue": source_issue,
        "workflow": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan"),
            "run_id": run_id,
            "workflow_fingerprint": os.environ.get("SCHERZO_WORKFLOW_FINGERPRINT", "unknown"),
        },
        "revision": {"status": "created", "number": 1, "supersedes": None},
        "plan": plan_meta,
        "review_doc": review_meta,
        "implementation_pack": {
            "ref": pack_ref,
            "sha256": pack_meta["sha256"],
            "bytes": pack_meta["bytes"],
            "schema": str(IMPLEMENTATION_PACK_SCHEMA),
            "derived_from_review_doc_sha256": review_meta["sha256"],
        },
        "entries": [
            descriptor_file_entry(
                "plan",
                plan_meta["ref"],
                plan_meta["sha256"],
                plan_meta["bytes"],
                plan_meta["media_type"],
                EXEC_PLAN_ARTIFACT_TYPE,
                metadata=plan_entry_metadata,
            ),
            descriptor_file_entry(
                "implementation_pack",
                pack_ref,
                pack_meta["sha256"],
                pack_meta["bytes"],
                "application/json",
                IMPLEMENTATION_PACK_ARTIFACT_TYPE,
            ),
        ],
        "review_surface": review_surface_from_publish_context(
            publish_context,
            review_doc_path=review_meta["path"],
        ),
        "implementation_handoff": {
            "issue_identifier": "pending",
            "issue_url": "https://linear.app/living-systems/issue/pending",
            "workflow_label": "workflow:execplan-implementation",
            "bundle_ref": bundle_ref,
        },
        "validation": [{"name": "materialize-bundle", "status": "passed"}],
    }
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    handoff = create_or_reuse_handoff_issue(
        bundle["source_issue"],
        bundle_ref,
        "pending",
        pack_meta["sha256"],
        review_meta["path"],
    )
    bundle["implementation_handoff"]["issue_identifier"] = handoff["issue_identifier"]
    bundle["implementation_handoff"]["issue_url"] = handoff["issue_url"]
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    output_path = resolve_run_root_relative_path(Path(ns.output))
    write_json(output_path, bundle)
    copy_best_effort(output_path, Path("tmp/execplan-bundle.json"))
    final_text = canonical_json(bundle)
    final_sha = sha256_bytes(final_text.encode("utf-8"))
    update_handoff_issue_description(
        handoff,
        bundle["source_issue"],
        bundle_ref,
        final_sha,
        pack_meta["sha256"],
        review_meta["path"],
    )
    annotate_handoff_issue(handoff, bundle_ref, final_sha, pack_meta["sha256"], review_meta["path"])
    print(f"BUNDLE_REF={bundle_ref}", file=sys.stderr)
    print(f"BUNDLE_SHA256={final_sha}", file=sys.stderr)
    sys.stdout.write(final_text)


def explicit_bundle_ref_and_sha(text: str) -> tuple[str, str] | None:
    ref_match = BUNDLE_REF_RE.search(text)
    sha_match = BUNDLE_SHA_RE.search(text)
    if not ref_match or not sha_match:
        return None
    return ref_match.group(1).rstrip(".,;"), sha_match.group(1)


def parse_bundle_ref_and_sha(text: str) -> tuple[str, str]:
    parsed = explicit_bundle_ref_and_sha(text)
    if parsed is None:
        fail("task context must contain `Bundle ref:` and `Bundle sha256:` lines")
    return parsed


def load_bundle_payload_from_context() -> tuple[dict[str, Any], Path, str, str]:
    ref, sha = parse_bundle_ref_and_sha(issue_context_text())
    bundle_path = resolve_stored_artifact_ref(ref, code="execplan_v2_bundle_missing")
    bundle, actual_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=sha,
        repo_root_arg=str(Path.cwd()),
    )
    return bundle, bundle_path, ref, actual_sha


def trim_reference(value: str) -> str:
    return value.strip().strip("`'\"<>").rstrip(".,;:")


def normalize_url(value: str) -> str:
    return trim_reference(value).rstrip("/").lower()


def github_pr_key(value: str) -> str:
    match = GITHUB_PR_URL_RE.search(trim_reference(value))
    if not match:
        return ""
    return f"{match.group(1).lower()}/{match.group(2).lower()}#{match.group(3)}"


def github_pr_number(value: str) -> str:
    match = GITHUB_PR_URL_RE.search(trim_reference(value))
    return match.group(3) if match else ""


def bundle_discovery_anchors(text: str) -> dict[str, set[str]]:
    urls = {normalize_url(match.group(0)) for match in URL_RE.finditer(text)}
    issue_identifiers = {match.group(1).upper() for match in LINEAR_ISSUE_IDENTIFIER_RE.finditer(strip_ansi(text))}
    current_issue_identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip().upper()
    if current_issue_identifier:
        issue_identifiers.discard(current_issue_identifier)
        urls = {url for url in urls if f"/issue/{current_issue_identifier.lower()}" not in url}
    pr_keys = {key for key in (github_pr_key(url) for url in urls) if key}
    pr_numbers = {match.group(1) for match in GITHUB_PR_TEXT_RE.finditer(text)}
    pr_numbers.update(number for number in (github_pr_number(url) for url in urls) if number)
    return {
        "artifact_refs": {trim_reference(match.group(0)) for match in RUN_ARTIFACT_REF_RE.finditer(text)},
        "issue_identifiers": issue_identifiers,
        "pr_keys": pr_keys,
        "pr_numbers": pr_numbers,
        "review_doc_paths": {trim_reference(match.group(0)) for match in REVIEW_DOC_PATH_RE.finditer(text)},
        "sha256s": {match.group(0).lower() for match in SHA256_TEXT_RE.finditer(text)},
        "urls": urls,
    }


def has_bundle_discovery_anchors(anchors: dict[str, set[str]]) -> bool:
    return any(anchors.get(key) for key in ["artifact_refs", "issue_identifiers", "pr_keys", "pr_numbers", "review_doc_paths", "sha256s", "urls"])


def output_manifest_bundle_entries(root: Path, manifest_path: Path) -> list[dict[str, Any]]:
    try:
        payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception:
        return []
    outputs = payload.get("outputs") if isinstance(payload, dict) else None
    if not isinstance(outputs, list):
        return []
    entries: list[dict[str, Any]] = []
    for output in outputs:
        if not isinstance(output, dict):
            continue
        value = output.get("value")
        if not isinstance(value, dict):
            continue
        if value.get("type") != "exec_plan_bundle" or value.get("status") != "present":
            continue
        if value.get("ref_kind") != "run_artifact":
            continue
        ref = value.get("ref")
        if not isinstance(ref, str) or not ref.startswith("runs/"):
            continue
        sha = value.get("sha256")
        if isinstance(sha, str):
            sha = sha.lower()
        else:
            sha = None
        entries.append({"root": root, "ref": ref, "sha256": sha, "source": str(manifest_path)})
    return entries


def retained_bundle_entries() -> list[dict[str, Any]]:
    roots = [root for root in artifact_roots() if root.exists()]
    entries: list[dict[str, Any]] = []
    manifest_refs: set[tuple[str, str]] = set()
    for root in roots:
        for manifest_path in sorted(root.glob("runs/*/outputs.v1.json")):
            for entry in output_manifest_bundle_entries(root, manifest_path):
                entries.append(entry)
                manifest_refs.add((str(root.resolve()), str(entry["ref"])))
    for root in roots:
        for bundle_path in sorted(root.glob("runs/*/outputs/exec_plan_bundle.json")):
            try:
                ref = str(bundle_path.relative_to(root)).replace(os.sep, "/")
            except ValueError:
                continue
            if (str(root.resolve()), ref) in manifest_refs:
                continue
            entries.append({"root": root, "ref": ref, "sha256": None, "source": str(bundle_path)})
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[str, str, str]] = set()
    for entry in entries:
        key = (str(Path(entry["root"]).resolve()), str(entry["ref"]), str(entry.get("sha256") or ""))
        if key not in seen:
            deduped.append(entry)
            seen.add(key)
    return deduped


def retained_bundle_path(root: Path, ref: str) -> Path:
    validate_artifact_ref(ref)
    candidate = root / ref
    try:
        candidate.resolve().relative_to(root.resolve())
    except Exception:
        fail(f"artifact ref escapes artifact root: {ref!r}", code="execplan_v2_bundle_missing")
    return candidate


def load_retained_bundle_metadata(entry: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
    root = Path(entry["root"])
    ref = str(entry["ref"])
    stderr = io.StringIO()
    try:
        with contextlib.redirect_stderr(stderr):
            bundle_path = retained_bundle_path(root, ref)
            bundle, actual_sha = load_execplan_bundle_payload(
                bundle_path,
                bundle_sha256=entry.get("sha256"),
                repo_root_arg=str(Path.cwd()),
            )
        return {
            "bundle": bundle,
            "ref": ref,
            "sha256": actual_sha,
            "root": root,
            "source": entry.get("source"),
        }, None
    except SystemExit:
        detail = stderr.getvalue().strip() or "candidate failed retained bundle metadata validation"
        return None, f"{ref} ({detail})"


def load_retained_bundle_candidate(entry: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
    root = Path(entry["root"])
    ref = str(entry["ref"])
    stderr = io.StringIO()
    try:
        with contextlib.redirect_stderr(stderr):
            bundle_path = retained_bundle_path(root, ref)
            bundle, pack, pack_path, actual_sha = load_and_validate_retained_bundle(
                bundle_path,
                bundle_sha256=entry.get("sha256"),
                artifact_root=str(root),
                repo_root_arg=str(Path.cwd()),
            )
        return {
            "bundle": bundle,
            "pack": pack,
            "pack_path": pack_path,
            "ref": ref,
            "sha256": actual_sha,
            "root": root,
            "source": entry.get("source"),
        }, None
    except SystemExit:
        detail = stderr.getvalue().strip() or "candidate failed retained bundle validation"
        return None, f"{ref} ({detail})"


def bundle_url_matches(label: str, value: Any, anchors: dict[str, set[str]], reasons: list[str]) -> None:
    if not isinstance(value, str) or not value.strip():
        return
    normalized = normalize_url(value)
    if normalized in anchors["urls"]:
        reasons.append(f"{label}:{value}")


def bundle_match_reasons(candidate: dict[str, Any], anchors: dict[str, set[str]]) -> list[str]:
    bundle = candidate["bundle"]
    ref = str(candidate["ref"])
    sha = str(candidate["sha256"])
    reasons: list[str] = []
    handoff = bundle.get("implementation_handoff") if isinstance(bundle.get("implementation_handoff"), dict) else {}
    source_issue = bundle.get("source_issue") if isinstance(bundle.get("source_issue"), dict) else {}
    review_surface = bundle.get("review_surface") if isinstance(bundle.get("review_surface"), dict) else {}
    review_path = plan_entry_publication_destination_path(bundle) or ""
    implementation_pack = bundle.get("implementation_pack") if isinstance(bundle.get("implementation_pack"), dict) else {}

    for candidate_ref, label in [
        (ref, "bundle_ref"),
        (handoff.get("bundle_ref"), "handoff_bundle_ref"),
        (review_surface.get("source_bundle_ref"), "source_bundle_ref"),
    ]:
        if isinstance(candidate_ref, str) and candidate_ref in anchors["artifact_refs"]:
            reasons.append(f"{label}:{candidate_ref}")

    for issue, label in [(source_issue, "source_issue"), (handoff, "handoff_issue")]:
        identifier = str(issue.get("identifier") or issue.get("issue_identifier") or "").upper()
        if identifier and identifier in anchors["issue_identifiers"]:
            reasons.append(f"{label}:{identifier}")
        bundle_url_matches(label, issue.get("url") or issue.get("issue_url"), anchors, reasons)

    pr_url = review_surface.get("pr_url")
    bundle_url_matches("pr_url", pr_url, anchors, reasons)
    if isinstance(pr_url, str):
        pr_key = github_pr_key(pr_url)
        pr_number = github_pr_number(pr_url)
        if pr_key and pr_key in anchors["pr_keys"]:
            reasons.append(f"pr:{pr_key}")
        if pr_number and pr_number in anchors["pr_numbers"]:
            reasons.append(f"pr_number:{pr_number}")

    if review_path and review_path in anchors["review_doc_paths"]:
        reasons.append(f"plan_publication_path:{review_path}")
    pack_sha = str(implementation_pack.get("sha256") or "").lower()
    if sha in anchors["sha256s"]:
        reasons.append("bundle_sha256")
    if pack_sha and pack_sha in anchors["sha256s"]:
        reasons.append("implementation_pack_sha256")

    deduped: list[str] = []
    seen: set[str] = set()
    for reason in reasons:
        if reason not in seen:
            deduped.append(reason)
            seen.add(reason)
    return deduped


def bundle_candidate_summary(candidate: dict[str, Any]) -> str:
    bundle = candidate["bundle"]
    source_issue = bundle.get("source_issue") if isinstance(bundle.get("source_issue"), dict) else {}
    review_surface = bundle.get("review_surface") if isinstance(bundle.get("review_surface"), dict) else {}
    handoff = bundle.get("implementation_handoff") if isinstance(bundle.get("implementation_handoff"), dict) else {}
    return (
        f"ref={candidate['ref']} sha256={candidate['sha256']} "
        f"source_issue={source_issue.get('identifier') or '-'} "
        f"pr={review_surface.get('pr_url') or '-'} "
        f"handoff={handoff.get('issue_identifier') or '-'} "
        f"matched_on={','.join(candidate.get('matches') or [])}"
    )


def missing_bundle_discovery_message(anchors: dict[str, set[str]], skipped: list[str]) -> str:
    anchor_hint = ""
    if not has_bundle_discovery_anchors(anchors):
        anchor_hint = " No PR URL, source issue identifier, review doc path, handoff issue, bundle ref, or hash anchor was found in the issue context."
    skipped_hint = ""
    if skipped:
        skipped_hint = " Skipped invalid retained bundle candidates: " + "; ".join(skipped[:5])
    return (
        "missing-bundle-discovery: could not discover a retained exec_plan_bundle for this revision issue."
        + anchor_hint
        + skipped_hint
        + " Include a PR URL/number, source Linear issue URL or identifier, implementation handoff issue, review doc path, or explicit `Bundle ref:` and `Bundle sha256:` lines. If the matching artifacts were pruned, rerun or recover the source execplan workflow, or paste the bundle lines from trusted Scherzo output."
    )


def discover_bundle_from_issue_context(text: str) -> tuple[dict[str, Any], dict[str, Any], Path, str, str, dict[str, Any]]:
    anchors = bundle_discovery_anchors(text)
    if not has_bundle_discovery_anchors(anchors):
        fail(missing_bundle_discovery_message(anchors, []), code="execplan_v2_missing_bundle_discovery")
    matches: list[dict[str, Any]] = []
    skipped: list[str] = []
    for entry in retained_bundle_entries():
        metadata, error = load_retained_bundle_metadata(entry)
        if metadata is None:
            if error:
                skipped.append(error)
            continue
        reasons = bundle_match_reasons(metadata, anchors)
        if not reasons:
            continue
        candidate, error = load_retained_bundle_candidate(entry)
        if candidate is None:
            if error:
                skipped.append(error)
            continue
        candidate["matches"] = reasons
        matches.append(candidate)
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for candidate in matches:
        key = (str(candidate["ref"]), str(candidate["sha256"]))
        if key in seen:
            continue
        deduped.append(candidate)
        seen.add(key)
    if len(deduped) == 1:
        candidate = deduped[0]
        return (
            candidate["bundle"],
            candidate["pack"],
            candidate["pack_path"],
            str(candidate["ref"]),
            str(candidate["sha256"]),
            {"source": "discovered", "matches": candidate.get("matches") or []},
        )
    if len(deduped) > 1:
        detail = "\n- ".join(bundle_candidate_summary(candidate) for candidate in deduped)
        fail(
            "ambiguous-bundle-discovery: multiple retained exec_plan_bundle artifacts match this revision issue. Add explicit `Bundle ref:` and `Bundle sha256:` lines to disambiguate. Candidates:\n- "
            + detail,
            code="execplan_v2_ambiguous_bundle_discovery",
        )
    fail(missing_bundle_discovery_message(anchors, skipped), code="execplan_v2_missing_bundle_discovery")


def load_bundle_from_mapped_input(
    *, validate_review_doc: bool = True
) -> tuple[dict[str, Any], dict[str, Any], Path, str, str, dict[str, Any]] | None:
    manifest_path = current_input_manifest_path()
    if manifest_path is None:
        return None
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception as exc:
        fail(
            f"could not read workflow input manifest {manifest_path}: {exc}",
            code="execplan_v2_input_manifest_invalid",
        )
    inputs = manifest.get("inputs") if isinstance(manifest, dict) else None
    if not isinstance(inputs, list):
        fail(
            f"workflow input manifest {manifest_path} does not contain an inputs list",
            code="execplan_v2_input_manifest_invalid",
        )
    selected: dict[str, Any] | None = None
    for entry in inputs:
        if isinstance(entry, dict) and entry.get("name") == "exec_plan_bundle":
            value = entry.get("value")
            if isinstance(value, dict):
                selected = value
                break
            fail(
                "workflow input manifest exec_plan_bundle entry is malformed",
                code="execplan_v2_input_manifest_invalid",
            )
    if selected is None or selected.get("status") == "absent":
        return None
    if selected.get("status") != "present" or selected.get("type") != "exec_plan_bundle":
        fail(
            "workflow input manifest exec_plan_bundle entry is not a present exec_plan_bundle",
            code="execplan_v2_input_manifest_invalid",
        )
    ref = selected.get("ref")
    sha = selected.get("sha256")
    if not isinstance(ref, str) or not isinstance(sha, str) or not ref or not sha:
        fail(
            "workflow input manifest exec_plan_bundle entry is missing ref or sha256",
            code="execplan_v2_input_manifest_invalid",
        )
    bundle_path = resolve_stored_artifact_ref(ref, code="execplan_v2_bundle_missing")
    bundle, actual_sha = load_execplan_bundle_payload(
        bundle_path,
        bundle_sha256=sha,
        repo_root_arg=str(Path.cwd()),
    )
    if validate_review_doc:
        validate_bundle_canonical_plan(bundle, artifact_root=None, repo_root_arg=str(Path.cwd()))
    pack, pack_path = validate_bundle_implementation_pack(
        bundle,
        artifact_root=None,
        repo_root_arg=str(Path.cwd()),
    )
    return (
        bundle,
        pack,
        pack_path,
        ref,
        actual_sha,
        {"source": "mapped_input", "manifest": str(manifest_path)},
    )


def load_bundle_from_context(
    *, source_mode: str, allow_discovery: bool = False, validate_review_doc: bool = True
) -> tuple[dict[str, Any], dict[str, Any], Path, str, str, dict[str, Any]]:
    if source_mode in {"workstream_input", "prefer_workstream_input"}:
        mapped = load_bundle_from_mapped_input(validate_review_doc=validate_review_doc)
        if mapped is not None:
            return mapped
        if source_mode == "workstream_input":
            fail(
                "workflow input manifest does not contain a present exec_plan_bundle input",
                code="execplan_v2_input_bundle_missing",
            )
    elif source_mode != "issue_context":
        fail(f"unsupported exec_plan_bundle source mode: {source_mode!r}", code="execplan_v2_source_mode_invalid")
    text = issue_context_text()
    explicit = explicit_bundle_ref_and_sha(text)
    if explicit is not None:
        ref, sha = explicit
        bundle_path = resolve_stored_artifact_ref(ref, code="execplan_v2_bundle_missing")
        bundle, actual_sha = load_execplan_bundle_payload(
            bundle_path,
            bundle_sha256=sha,
            repo_root_arg=str(Path.cwd()),
        )
        if validate_review_doc:
            validate_bundle_canonical_plan(bundle, artifact_root=None, repo_root_arg=str(Path.cwd()))
        pack, pack_path = validate_bundle_implementation_pack(
            bundle,
            artifact_root=None,
            repo_root_arg=str(Path.cwd()),
        )
        return bundle, pack, pack_path, ref, actual_sha, {"source": "explicit", "matches": []}
    if not allow_discovery:
        parse_bundle_ref_and_sha(text)
    bundle, pack, pack_path, ref, sha, diagnostics = discover_bundle_from_issue_context(text)
    if validate_review_doc:
        validate_bundle_canonical_plan(bundle, artifact_root=None, repo_root_arg=str(Path.cwd()))
    return bundle, pack, pack_path, ref, sha, diagnostics



def source_mode_from_args(ns: argparse.Namespace) -> str:
    if getattr(ns, "from_workstream_input", False):
        return "workstream_input"
    if getattr(ns, "prefer_workstream_input", False):
        return "prefer_workstream_input"
    return "issue_context"


def review_doc_state_for_bundle(bundle: dict[str, Any], *, repo_root_arg: str | None = None) -> tuple[str, dict[str, Any] | None, str]:
    review_path_value = plan_entry_publication_destination_path(bundle, required=True)
    if review_path_value is None:
        fail_descriptor_required(
            "descriptor plan entry is missing metadata.publication.destination_path"
        )
    review_path = review_doc_filesystem_path(review_path_value, repo_root(repo_root_arg))
    try:
        data = review_path.read_bytes()
    except FileNotFoundError:
        return "missing", None, str(review_path)
    except OSError as exc:
        fail(f"could not read {review_path}: {exc}", code="execplan_v2_review_doc_missing")
    meta = {"sha256": sha256_bytes(data), "bytes": len(data)}
    plan = descriptor_plan_entry(bundle)
    if meta["sha256"] == plan["sha256"] and meta["bytes"] == plan["bytes"]:
        return "ok", meta, str(review_path)
    return "mismatch", meta, str(review_path)


def truncate_driver_detail(value: str) -> str:
    text = ANSI_ESCAPE_RE.sub("", value).strip()
    if len(text) <= MAX_WORKSPACE_DRIVER_DETAIL_CHARS:
        return text
    return text[:MAX_WORKSPACE_DRIVER_DETAIL_CHARS] + "... [truncated]"


def revision_refresh_timeout_seconds() -> float:
    raw = env_value("SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS")
    if not raw:
        return DEFAULT_REVISION_REFRESH_TIMEOUT_SECONDS
    try:
        value = float(raw)
    except ValueError:
        fail(
            "SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS must be a positive number",
            code="execplan_revision_base_missing",
        )
    if value <= 0:
        fail(
            "SCHERZO_EXECPLAN_REVISION_REFRESH_TIMEOUT_SECONDS must be greater than zero",
            code="execplan_revision_base_missing",
        )
    return value


def safe_revision_head(value: str) -> bool:
    return bool(REVISION_HEAD_RE.fullmatch(value))


def safe_publication_guard_head(value: str) -> bool:
    return bool(PUBLICATION_GUARD_HEAD_RE.fullmatch(value))


def safe_revision_branch(value: str) -> bool:
    if not REVISION_BRANCH_RE.fullmatch(value):
        return False
    if value.endswith(("/", ".", ".lock")):
        return False
    if ".." in value or "@{" in value or "//" in value:
        return False
    parts = value.split("/")
    return all(
        part not in {"", ".", ".."} and not part.startswith(".") and not part.endswith(".lock")
        for part in parts
    )


def safe_revision_remote(value: str) -> bool:
    return bool(REVISION_REMOTE_RE.fullmatch(value))


def revision_remote() -> str:
    remote = env_value("SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE", "origin")
    if not safe_revision_remote(remote):
        fail(
            f"revision publication remote {remote!r} is not a safe remote name for refresh-base",
            code="execplan_revision_base_missing",
        )
    return remote


def revision_base_candidates(bundle: dict[str, Any]) -> list[str]:
    values: list[str] = []
    rejected: list[str] = []
    for evidence in revision_publication_evidence(bundle):
        source = str(evidence.get("source") or "review_surface")
        head_label = "review_surface.head_revision" if source == "review_surface" else "retained publication manifest head_revision"
        branch_label = "review_surface.branch" if source == "review_surface" else "retained publication manifest branch"
        head = str(evidence.get("head_revision") or "").strip()
        branch = str(evidence.get("branch") or "").strip()
        if head and head not in {"head", "reused"}:
            if safe_revision_head(head):
                values.append(head)
            else:
                rejected.append(f"{head_label} is not a hex commit id")
        if branch and branch != "reused":
            if safe_revision_branch(branch):
                remote = revision_remote()
                values.append(f"{branch}@{remote}")
                values.append(branch)
            else:
                rejected.append(f"{branch_label} contains unsupported revision-ref characters")
    if rejected and not values:
        fail(
            "previous exec_plan_bundle records no safe review_surface branch/head to resolve: "
            + "; ".join(rejected),
            code="execplan_revision_base_missing",
        )
    unique: list[str] = []
    seen: set[str] = set()
    for value in values:
        if value not in seen:
            unique.append(value)
            seen.add(value)
    return unique


def refresh_revision_base(target: str, *, stage: str = "prepare_revision") -> tuple[bool, str]:
    driver = workspace_driver_command()
    if not driver:
        return False, "SCHERZO_WORKSPACE_DRIVER is not set"
    timeout = revision_refresh_timeout_seconds()
    proc = run_proc(
        [driver, "refresh-base", "--stage", stage, "--target", target, "--json"],
        timeout=timeout,
    )
    payload: dict[str, Any] = {}
    if proc.stdout.strip():
        try:
            parsed = json.loads(proc.stdout)
            if isinstance(parsed, dict):
                payload = parsed
        except Exception:
            payload = {}
    detail = truncate_driver_detail(
        str(
            payload.get("message")
            or proc.stderr.strip()
            or proc.stdout.strip()
            or f"exit {proc.returncode}"
        )
    )
    if proc.returncode != 0:
        return False, detail
    if payload.get("version") != 1:
        return False, "workspace driver returned malformed refresh-base JSON"
    status = str(payload.get("status") or "")
    if status in {"fresh", "rebased_clean"}:
        return True, status
    return False, detail or f"refresh-base returned status {status!r}"


def refresh_revision_base_for_publication(bundle: dict[str, Any], *, stage: str) -> None:
    candidates = revision_base_candidates(bundle)
    if not candidates or workspace_driver_command() is None:
        return
    attempts: list[str] = []
    for target in candidates:
        refreshed, message = refresh_revision_base(target, stage=stage)
        if refreshed:
            return
        attempts.append(f"{target}: {message}")
    fail(
        "could not refresh workspace to previous ExecPlan publication head for revision; tried "
        + "; ".join(attempts),
        code="execplan_revision_base_missing",
    )


def ensure_commit_stack_base_matches_publication_target(
    *,
    artifact: dict[str, Any],
    target: dict[str, Any],
) -> None:
    if target.get("kind") != "existing_pr_branch":
        return
    existing = target.get("existing_pr_branch")
    if not isinstance(existing, dict):
        return
    head = existing.get("head")
    if not isinstance(head, dict):
        return
    expected_head_sha = str(head.get("sha") or "").strip().lower()
    base = artifact.get("base")
    actual_base_sha = str(base.get("sha") if isinstance(base, dict) else "").strip().lower()
    if actual_base_sha == expected_head_sha:
        return
    branch = str(head.get("branch") or "existing PR branch")
    fail(
        "revision commit_stack base sha "
        f"{actual_base_sha or '<missing>'} does not match expected head {expected_head_sha or '<missing>'} "
        f"for {branch}; refresh the revision workspace to the existing PR branch head before publication",
        code="execplan_revision_base_mismatch",
    )


def seed_revision_review_doc_from_canonical_plan(bundle: dict[str, Any], *, repo_root_arg: str | None = None) -> bool:
    try:
        _plan_meta, plan_path = validate_bundle_plan(bundle, artifact_root=None, repo_root_arg=repo_root_arg)
    except SystemExit:
        return False
    review_path = review_doc_seed_filesystem_path(
        bundle,
        repo_root(repo_root_arg),
    )
    review_path.parent.mkdir(parents=True, exist_ok=True)
    if review_path.resolve() != plan_path.resolve():
        shutil.copyfile(plan_path, review_path)
    validate_bundle_review_doc(
        bundle,
        repo_root_arg=repo_root_arg,
        missing_code="execplan_revision_base_missing",
    )
    return True



def ensure_revision_review_doc_available(bundle: dict[str, Any], *, repo_root_arg: str | None = None) -> None:
    state, _meta, review_path = review_doc_state_for_bundle(bundle, repo_root_arg=repo_root_arg)
    if state == "ok":
        return
    if state in {"missing", "mismatch"} and seed_revision_review_doc_from_canonical_plan(
        bundle,
        repo_root_arg=repo_root_arg,
    ):
        return
    candidates = revision_base_candidates(bundle)
    if not candidates:
        fail(
            f"review doc {review_path} is {state}, and the previous exec_plan_bundle does not record a review_surface branch/head to resolve",
            code="execplan_revision_base_missing",
        )
    attempts: list[str] = []
    mismatch_details: list[str] = []
    for target in candidates:
        refreshed, message = refresh_revision_base(target)
        if not refreshed:
            attempts.append(f"{target}: {message}")
            continue
        resolved_state, resolved_meta, _ = review_doc_state_for_bundle(bundle, repo_root_arg=repo_root_arg)
        if resolved_state == "ok":
            return
        if resolved_state == "mismatch" and resolved_meta is not None:
            mismatch_details.append(
                f"{target}: resolved review doc hash {resolved_meta['sha256']} bytes {resolved_meta['bytes']} did not match bundle"
            )
        else:
            attempts.append(f"{target}: review doc still missing after refresh-base")
    if mismatch_details:
        fail(
            "resolved previous ExecPlan review surface, but review doc bytes do not match exec_plan_bundle.review_doc: "
            + "; ".join(mismatch_details),
            code="execplan_v2_review_doc_hash_mismatch",
        )
    fail(
        "could not resolve previous ExecPlan review surface for revision; tried " + "; ".join(attempts),
        code="execplan_revision_base_missing",
    )


def command_prepare_revision(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan prepare-revision")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--from-issue-context", action="store_true")
    source.add_argument("--from-workstream-input", action="store_true")
    source.add_argument("--prefer-workstream-input", action="store_true")
    parser.add_argument("--write-bundle", required=True)
    parser.add_argument("--write-review-doc-path", required=True)
    parser.add_argument("--write-pack", required=True)
    ns = parser.parse_args(args)
    source_mode = source_mode_from_args(ns)
    bundle, _pack, pack_path, ref, sha, diagnostics = load_bundle_from_context(
        source_mode=source_mode,
        allow_discovery=True,
        validate_review_doc=False,
    )
    ensure_revision_review_doc_available(bundle, repo_root_arg=str(Path.cwd()))
    refresh_revision_base_for_publication(bundle, stage="prepare_revision")
    validate_bundle_review_doc(
        bundle,
        repo_root_arg=str(Path.cwd()),
        missing_code="execplan_revision_base_missing",
    )
    write_json(Path(ns.write_bundle), bundle)
    shutil.copyfile(pack_path, ns.write_pack)
    review_doc_path = plan_entry_publication_destination_path(bundle, required=True)
    if review_doc_path is None:
        fail_descriptor_required(
            "descriptor plan entry is missing metadata.publication.destination_path"
        )
    Path(ns.write_review_doc_path).parent.mkdir(parents=True, exist_ok=True)
    Path(ns.write_review_doc_path).write_text(review_doc_path + "\n", encoding="utf-8")
    print("PREPARE_REVISION_STATUS=ok")
    print(f"BUNDLE_DISCOVERY_STATUS={diagnostics['source']}")
    if diagnostics.get("matches"):
        print("BUNDLE_DISCOVERY_MATCHES=" + ",".join(diagnostics["matches"]))
    print(f"BUNDLE_REF={ref}")
    print(f"BUNDLE_SHA256={sha}")
    print(f"REVIEW_DOC_PATH={review_doc_path}")


def materialize_revision(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-revision")
    parser.add_argument("--previous-bundle", required=True)
    parser.add_argument("--review-doc-path-file", required=True)
    parser.add_argument("--pack", required=True)
    parser.add_argument("--publish-context")
    parser.add_argument("--status", choices=["auto", "changed", "unchanged"], default="auto")
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    previous = canonicalize_execplan_bundle(load_json(Path(ns.previous_bundle)))
    if not isinstance(previous, dict):
        fail("previous bundle JSON must be an object", code="execplan_v2_bundle_missing")
    reject_bundle_self_hash(previous)
    descriptor_plan_entry(previous)
    validate_schema(previous, EXEC_PLAN_BUNDLE_SCHEMA)
    validate_execplan_bundle_descriptor_entries(previous)
    review_path = read_review_doc_path_file(Path(ns.review_doc_path_file))
    review_meta = validate_review_doc_path(review_path)
    pack_path = Path(ns.pack)
    pack = load_pack_for_review(pack_path, review_meta)
    pack_meta = file_meta(pack_path)
    source_issue = source_issue_from_submission_or_env(pack)
    previous_source_issue = previous.get("source_issue")
    if isinstance(previous_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(previous_source_issue.get("identifier") or ""),
            "previous bundle source_issue.identifier",
        )
    publish_context = load_json(Path(ns.publish_context)) if ns.publish_context else None
    publish_source_issue = publish_context.get("source_issue") if isinstance(publish_context, dict) else None
    if isinstance(publish_source_issue, dict):
        ensure_source_issue_identifier_matches(
            source_issue,
            str(publish_source_issue.get("identifier") or ""),
            "publish context source_issue.identifier",
        )
    previous_ref = previous.get("implementation_handoff", {}).get("bundle_ref") or "runs/unknown/outputs/exec_plan_bundle.json"
    previous_sha = sha256_bytes(canonical_json(previous).encode("utf-8"))
    status = ns.status
    if status == "auto":
        status = "unchanged" if review_meta["sha256"] == bundle_expected_plan_sha(previous) and pack_meta["sha256"] == previous["implementation_pack"]["sha256"] else "changed"
    run_id = os.environ.get("SCHERZO_RUN_ID", "local-run")
    plan_meta = write_canonical_plan_output(review_path)
    bundle_ref = f"runs/{run_id}/outputs/exec_plan_bundle.json"
    plan_entry_metadata = plan_publication_metadata(review_meta)
    bundle = {
        **previous,
        "kind": "artifact_set",
        "media_type": "application/json",
        "artifact_type": EXEC_PLAN_BUNDLE_ARTIFACT_TYPE,
        "bundle_id": f"bundle-{source_issue['identifier'].lower()}-{run_id}",
        "source_issue": source_issue,
        "workflow": {
            "workflow_id": os.environ.get("SCHERZO_WORKFLOW_ID", "execplan-revision"),
            "run_id": run_id,
            "workflow_fingerprint": os.environ.get("SCHERZO_WORKFLOW_FINGERPRINT", previous.get("workflow", {}).get("workflow_fingerprint", "unknown")),
        },
        "revision": {
            "status": status,
            "number": int(previous.get("revision", {}).get("number") or 1) + 1,
            "supersedes": {"ref": previous_ref, "sha256": previous_sha},
        },
        "plan": plan_meta,
        "review_doc": review_meta,
        "implementation_pack": {
            "ref": f"runs/{run_id}/outputs/implementation_pack.json",
            "sha256": pack_meta["sha256"],
            "bytes": pack_meta["bytes"],
            "schema": str(IMPLEMENTATION_PACK_SCHEMA),
            "derived_from_review_doc_sha256": review_meta["sha256"],
        },
        "entries": [
            descriptor_file_entry(
                "plan",
                plan_meta["ref"],
                plan_meta["sha256"],
                plan_meta["bytes"],
                plan_meta["media_type"],
                EXEC_PLAN_ARTIFACT_TYPE,
                metadata=plan_entry_metadata,
            ),
            descriptor_file_entry(
                "implementation_pack",
                f"runs/{run_id}/outputs/implementation_pack.json",
                pack_meta["sha256"],
                pack_meta["bytes"],
                "application/json",
                IMPLEMENTATION_PACK_ARTIFACT_TYPE,
            ),
        ],
        "review_surface": review_surface_from_publish_context(
            publish_context,
            review_doc_path=review_meta["path"],
        ),
        "implementation_handoff": {
            **previous["implementation_handoff"],
            "bundle_ref": bundle_ref,
        },
        "validation": [{"name": "materialize-revision", "status": "passed"}],
    }
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    output_path = resolve_run_root_relative_path(Path(ns.output))
    write_json(output_path, bundle)
    copy_best_effort(output_path, Path("tmp/execplan-bundle.json"))
    final_text = canonical_json(bundle)
    final_sha = sha256_bytes(final_text.encode("utf-8"))
    handoff = bundle["implementation_handoff"]
    update_handoff_issue_description(
        handoff,
        bundle["source_issue"],
        bundle_ref,
        final_sha,
        pack_meta["sha256"],
        review_meta["path"],
    )
    annotate_handoff_issue(handoff, bundle_ref, final_sha, pack_meta["sha256"], review_meta["path"])
    sys.stdout.write(final_text)


def same_issue_identifier(left: str, right: str) -> bool:
    return bool(
        left.strip()
        and right.strip()
        and left.strip().upper() == right.strip().upper()
    )


def ensure_current_issue_matches_handoff(handoff_identifier: str) -> None:
    current_identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    if (
        current_identifier
        and handoff_identifier
        and not same_issue_identifier(current_identifier, handoff_identifier)
    ):
        fail(
            "current workflow issue SCHERZO_ISSUE_IDENTIFIER="
            f"{current_identifier} does not match "
            "exec_plan_bundle.implementation_handoff.issue_identifier="
            f"{handoff_identifier}; source_issue.identifier may differ from "
            "implementation_handoff.issue_identifier, but the current workflow "
            "issue must match the implementation handoff recorded in the bundle. "
            "Use the correct handoff task or regenerate the bundle.",
            code="execplan_implementation_handoff_mismatch",
        )


def implementation_issue_title_for_prepare(
    handoff: dict[str, Any], source_issue: dict[str, Any]
) -> str:
    handoff_identifier = str(handoff.get("issue_identifier") or "").strip()
    source_identifier = str(source_issue.get("identifier") or "").strip()
    source_title = str(source_issue.get("title") or "").strip()
    env_identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    env_title = os.environ.get("SCHERZO_ISSUE_TITLE", "").strip()
    if env_title and (
        not env_identifier
        or not handoff_identifier
        or same_issue_identifier(env_identifier, handoff_identifier)
    ):
        return env_title
    explicit = str(handoff.get("issue_title") or handoff.get("title") or "").strip()
    if explicit:
        return explicit
    if handoff_identifier and source_identifier and not same_issue_identifier(handoff_identifier, source_identifier):
        return f"Implement: {source_title}" if source_title else "ExecPlan implementation handoff"
    return source_title


def command_implementation_prepare(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan implementation-prepare")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--from-issue-context", action="store_true")
    source.add_argument("--from-workstream-input", action="store_true")
    source.add_argument("--prefer-workstream-input", action="store_true")
    ns = parser.parse_args(args)
    source_mode = source_mode_from_args(ns)
    marker = write_implementation_retention_marker(
        "execplan",
        os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "unknown-issue").strip() or "unknown-issue",
    )
    bundle, _pack, pack_path, _ref, _sha, _diagnostics = load_bundle_from_context(source_mode=source_mode)
    plan_meta, plan_source_path = validate_bundle_canonical_plan(
        bundle,
        artifact_root=None,
        repo_root_arg=str(Path.cwd()),
    )
    tmp = Path("tmp")
    tmp.mkdir(exist_ok=True)
    prepared_plan_path = tmp / "execplan-review-doc.md"
    prepared_pack_path = tmp / "execplan-implementation-pack.json"
    prepared_bundle_path = tmp / "execplan-bundle.json"
    state_dir = implementation_state_dir()
    canonical_plan_path = prepared_plan_path
    canonical_pack_path = prepared_pack_path
    canonical_bundle_path = prepared_bundle_path
    plan_metadata_path = prepared_plan_path
    pack_metadata_path = prepared_pack_path
    bundle_metadata_path = prepared_bundle_path
    if state_dir is not None:
        state_dir.mkdir(parents=True, exist_ok=True)
        canonical_plan_path = state_dir / CANONICAL_IMPLEMENTATION_PLAN_STATE_NAME
        canonical_pack_path = state_dir / CANONICAL_IMPLEMENTATION_PACK_STATE_NAME
        canonical_bundle_path = state_dir / CANONICAL_IMPLEMENTATION_BUNDLE_STATE_NAME
        plan_metadata_path = implementation_state_relative_path(CANONICAL_IMPLEMENTATION_PLAN_STATE_NAME)
        pack_metadata_path = implementation_state_relative_path(CANONICAL_IMPLEMENTATION_PACK_STATE_NAME)
        bundle_metadata_path = implementation_state_relative_path(CANONICAL_IMPLEMENTATION_BUNDLE_STATE_NAME)
        if plan_source_path.resolve(strict=False) != canonical_plan_path.resolve(strict=False):
            shutil.copyfile(plan_source_path, canonical_plan_path)
        if pack_path.resolve(strict=False) != canonical_pack_path.resolve(strict=False):
            shutil.copyfile(pack_path, canonical_pack_path)
        write_json(canonical_bundle_path, bundle)
    copy_best_effort(canonical_plan_path, prepared_plan_path)
    if not prepared_plan_path.exists() and plan_source_path.resolve(strict=False) != prepared_plan_path.resolve(strict=False):
        shutil.copyfile(plan_source_path, prepared_plan_path)
    copy_best_effort(canonical_pack_path, prepared_pack_path)
    if not prepared_pack_path.exists() and pack_path.resolve(strict=False) != prepared_pack_path.resolve(strict=False):
        shutil.copyfile(pack_path, prepared_pack_path)
    copy_best_effort(canonical_bundle_path, prepared_bundle_path)
    if not prepared_bundle_path.exists():
        write_json(prepared_bundle_path, bundle)
    base_change_id = "unknown-base"
    if workspace_driver_command():
        try:
            baseline = workspace_driver_json(["baseline", "--json"])
            base_change_id = str(baseline.get("baseline_id") or baseline.get("base_revision") or base_change_id)
        except SystemExit:
            raise
    handoff = bundle["implementation_handoff"]
    source_issue = bundle["source_issue"]
    source_issue_identifier = str(source_issue.get("identifier") or "").strip()
    source_issue_title = str(source_issue.get("title") or "").strip()
    source_issue_url = str(source_issue.get("url") or "").strip()
    handoff_issue_identifier = str(handoff.get("issue_identifier") or "").strip()
    current_issue_identifier = os.environ.get("SCHERZO_ISSUE_IDENTIFIER", "").strip()
    current_issue_url = os.environ.get("SCHERZO_ISSUE_URL", "").strip()
    ensure_current_issue_matches_handoff(handoff_issue_identifier)
    implementation_issue_identifier = (
        current_issue_identifier or handoff_issue_identifier or source_issue_identifier
    )
    implementation_issue_url = (
        (current_issue_url if current_issue_identifier else "")
        or str(handoff.get("issue_url") or "").strip()
        or source_issue_url
    )
    implementation_issue_title = implementation_issue_title_for_prepare(handoff, source_issue)
    descriptor_plan = descriptor_plan_entry(bundle)
    plan_publication_path = plan_entry_publication_destination_path(bundle) or ""
    review_surface_path = str(bundle.get("review_surface", {}).get("review_doc_path") or "")
    metadata = {
        "source_kind": "execplan",
        # Backward compatibility: issue_* remains the implementation handoff issue
        # because Linear, branch, retry, and publish linkage should target the
        # implementation task that owns this workflow run.
        "issue_identifier": implementation_issue_identifier,
        "issue_title": implementation_issue_title,
        "issue_url": implementation_issue_url,
        "implementation_issue_identifier": implementation_issue_identifier,
        "implementation_issue_title": implementation_issue_title,
        "implementation_issue_url": implementation_issue_url,
        "source_issue_identifier": source_issue_identifier,
        "source_issue_title": source_issue_title,
        "source_issue_url": source_issue_url,
        "plan_path": display_path(plan_metadata_path),
        "plan_sha256": plan_meta["sha256"],
        "plan_bytes": plan_meta["bytes"],
        "plan_media_type": CANONICAL_PLAN_MEDIA_TYPE,
        "plan_artifact_ref": str(descriptor_plan.get("ref") or ""),
        "plan_publication_path": plan_publication_path,
        "canonical_plan_path": display_path(canonical_plan_path),
        "review_surface_path": review_surface_path,
        "base_change_id": base_change_id,
        "execplan_v2_bundle_path": display_path(bundle_metadata_path),
        "execplan_v2_implementation_pack_path": display_path(pack_metadata_path),
        "tmp_execplan_v2_bundle_path": "tmp/execplan-bundle.json",
        "tmp_execplan_v2_implementation_pack_path": "tmp/execplan-implementation-pack.json",
        "canonical_execplan_v2_bundle_path": display_path(canonical_bundle_path),
        "canonical_execplan_v2_implementation_pack_path": display_path(canonical_pack_path),
    }
    marker_source = str(descriptor_plan.get("ref") or prepared_plan_path)
    marker = write_implementation_retention_marker("execplan", marker_source)
    if state_dir is not None:
        write_json(state_dir / "metadata.json", metadata)
    write_json(tmp / "scherzo-implementation.json", metadata)
    print("IMPLEMENTATION_PREPARE_STATUS=ok")
    print(f"PLAN={display_path(plan_metadata_path)}")
    print(f"REVIEW_DOC={display_path(plan_metadata_path)}")
    print(f"IMPLEMENTATION_PACK={display_path(pack_metadata_path)}")
    print(f"BUNDLE={display_path(bundle_metadata_path)}")
    print("TMP_PLAN=tmp/execplan-review-doc.md")
    print("TMP_IMPLEMENTATION_PACK=tmp/execplan-implementation-pack.json")
    print("TMP_BUNDLE=tmp/execplan-bundle.json")
    print(f"CANONICAL_PLAN={display_path(canonical_plan_path)}")
    print(f"CANONICAL_IMPLEMENTATION_PACK={display_path(canonical_pack_path)}")
    print(f"CANONICAL_BUNDLE={display_path(canonical_bundle_path)}")
    print(f"IMPLEMENTATION_ISSUE_IDENTIFIER={implementation_issue_identifier}")
    print(f"SOURCE_ISSUE_IDENTIFIER={source_issue_identifier}")
    if (
        implementation_issue_identifier
        and source_issue_identifier
        and not same_issue_identifier(
            implementation_issue_identifier,
            source_issue_identifier,
        )
    ):
        print("HANDOFF_SOURCE_IDENTITY_SPLIT=expected")
    else:
        print("HANDOFF_SOURCE_IDENTITY_SPLIT=same")
    if marker is not None:
        print(f"RETENTION_MARKER={marker}")


def command_gate_no_conflict(args: list[str]) -> None:
    if args:
        fail("gate-no-conflict takes no arguments")
    path = Path("tmp/execplan-conflict.md")
    if path.exists() and path.read_text(encoding="utf-8").strip():
        fail("implementation agent reported a review-doc / implementation-pack conflict; see tmp/execplan-conflict.md", code="execplan_v2_conflict")
    print("EXECPLAN_V2_CONFLICT=none")


def copy_file_to_artifact(src: Path, dest: Path, *, run_id: str, run_dir: Path) -> dict[str, Any]:
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.exists():
        shutil.copyfile(src, dest)
    else:
        dest.write_text("", encoding="utf-8")
    data = dest.read_bytes()
    ref = "runs/" + run_id + "/" + str(dest.relative_to(run_dir)).replace("\\", "/")
    return {"ref": ref, "sha256": sha256_bytes(data), "bytes": len(data)}


def source_file_candidates(paths: Iterable[Path]) -> Path | None:
    for path in paths:
        if path.exists():
            return path
    return None


def normalize_changed_files(value: Any) -> list[dict[str, str]]:
    if not isinstance(value, list):
        return []
    out: list[dict[str, str]] = []
    for item in value:
        if isinstance(item, str):
            out.append({"path": item, "status": "modified"})
        elif isinstance(item, dict) and isinstance(item.get("path"), str):
            out.append({"path": str(item["path"]), "status": str(item.get("status") or "modified")})
    return out


def materialize_code_change_bundle(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="scherzo-execplan materialize-code-change-bundle")
    parser.add_argument("--bundle", required=True)
    parser.add_argument("--output", required=True)
    ns = parser.parse_args(args)
    bundle_path = resolve_run_root_relative_path(Path(ns.bundle))
    bundle = canonicalize_execplan_bundle(load_json(bundle_path))
    if not isinstance(bundle, dict):
        fail("bundle JSON must be an object", code="execplan_v2_bundle_missing")
    reject_bundle_self_hash(bundle)
    descriptor_plan_entry(bundle)
    validate_schema(bundle, EXEC_PLAN_BUNDLE_SCHEMA)
    validate_execplan_bundle_descriptor_entries(bundle)
    bundle_meta = file_meta(bundle_path)
    publish_path = implementation_state_path("scherzo-implementation-publish.json") or Path("tmp/scherzo-implementation-publish.json")
    publish = load_json(publish_path) if publish_path.exists() else {}
    validation_path = implementation_state_path("scherzo-implementation-validation.json") or Path("tmp/scherzo-implementation-validation.json")
    plan_completion_path = implementation_state_path("scherzo-plan-completion-verdict.json") or Path("tmp/scherzo-plan-completion-verdict.json")
    run_id = artifact_run_id()
    run_dir = materialization_run_artifact_dir(run_id)
    code_dir = run_dir / "execplan" / "code-change"
    diff_path = env_value("SCHERZO_EXECPLAN_DIFF_PATH", legacy="SCHERZO_EXECPLAN_V2_DIFF_PATH")
    diff_src = source_file_candidates([
        Path(diff_path) if diff_path else Path("__missing__"),
        Path(os.environ.get("SCHERZO_RUN_ROOT", "")) / "input.diff" if os.environ.get("SCHERZO_RUN_ROOT") else Path("__missing__"),
        Path("tmp/scherzo-implementation.diff"),
    ])
    diff_meta = copy_file_to_artifact(
        diff_src or Path("__missing__"),
        code_dir / "diff.patch",
        run_id=run_id,
        run_dir=run_dir,
    )
    changed_files = normalize_changed_files(publish.get("changed_files"))
    changed_path = code_dir / "changed-files.v1.json"
    changed_path.parent.mkdir(parents=True, exist_ok=True)
    changed_path.write_text(canonical_json(changed_files), encoding="utf-8")
    validation_artifacts: list[dict[str, Any]] = []
    if validation_path.exists():
        meta = copy_file_to_artifact(
            validation_path,
            code_dir / "validation" / "scherzo-ci.json",
            run_id=run_id,
            run_dir=run_dir,
        )
        validation_artifacts.append({"name": "scherzo-ci", **meta})
    plan_completion_payload = load_json(plan_completion_path) if plan_completion_path.exists() else {"verdict": "blocked"}
    pc_meta = copy_file_to_artifact(
        plan_completion_path if plan_completion_path.exists() else Path("__missing__"),
        code_dir / "plan-completion.json",
        run_id=run_id,
        run_dir=run_dir,
    )
    raw_verdict = str(plan_completion_payload.get("verdict") or "blocked")
    verdict = {"pass": "complete", "fail": "incomplete"}.get(raw_verdict, raw_verdict)
    if verdict not in {"complete", "incomplete", "blocked"}:
        verdict = "blocked"
    review_artifacts: list[dict[str, Any]] = []
    run_root = Path(os.environ.get("SCHERZO_RUN_ROOT", "")) if os.environ.get("SCHERZO_RUN_ROOT") else None
    review_final = source_file_candidates([
        run_root / "artifacts" / "review" / "final_dispositions" / "final-review.v1.json" if run_root else Path("__missing__"),
        run_root / "artifacts" / "review" / "synthesize_review" / "final-review.v1.json" if run_root else Path("__missing__"),
        Path("tmp/final-review.v1.json"),
    ])
    if review_final:
        meta = copy_file_to_artifact(
            review_final,
            code_dir / "review" / "final-review.v1.json",
            run_id=run_id,
            run_dir=run_dir,
        )
        review_artifacts.append({"name": "final-review", **meta})
    extra_review_artifacts = [
        (
            "final-review-markdown",
            source_file_candidates([
                run_root / "artifacts" / "review" / "final_dispositions" / "final-review.md" if run_root else Path("__missing__"),
            ]),
            code_dir / "review" / "final-review.md",
        ),
        (
            "review-finding-dispositions",
            source_file_candidates([
                run_root / "artifacts" / "review" / "final_dispositions" / "review-finding-dispositions.v1.json" if run_root else Path("__missing__"),
            ]),
            code_dir / "review" / "review-finding-dispositions.v1.json",
        ),
        (
            "review-finding-dispositions-markdown",
            source_file_candidates([
                run_root / "artifacts" / "review" / "final_dispositions" / "review-finding-dispositions.md" if run_root else Path("__missing__"),
            ]),
            code_dir / "review" / "review-finding-dispositions.md",
        ),
    ]
    for name, src, dest in extra_review_artifacts:
        if src:
            meta = copy_file_to_artifact(src, dest, run_id=run_id, run_dir=run_dir)
            review_artifacts.append({"name": name, **meta})
    pack = bundle["implementation_pack"]
    source_plan_sha = bundle_expected_plan_sha(bundle)
    source_plan_path = plan_entry_publication_destination_path(bundle) or display_path(implementation_state_relative_path(CANONICAL_IMPLEMENTATION_PLAN_STATE_NAME))
    descriptor_entries = [
        descriptor_file_entry(
            "diff",
            diff_meta["ref"],
            diff_meta["sha256"],
            diff_meta["bytes"],
            "text/x-diff",
            "diff",
        ),
        descriptor_file_entry(
            "plan_completion",
            pc_meta["ref"],
            pc_meta["sha256"],
            pc_meta["bytes"],
            "application/json",
            "plan_completion",
        ),
        *[named_retained_artifact_entry(artifact) for artifact in validation_artifacts],
        *[named_retained_artifact_entry(artifact) for artifact in review_artifacts],
    ]
    code_bundle = {
        "schema_version": 2,
        "kind": "artifact_set",
        "media_type": "application/json",
        "artifact_type": CODE_CHANGE_BUNDLE_ARTIFACT_TYPE,
        "entries": descriptor_entries,
        "source_bundle": {
            "ref": bundle["implementation_handoff"]["bundle_ref"],
            "sha256": bundle_meta["sha256"],
            "review_doc_sha256": source_plan_sha,
            "implementation_pack_sha256": pack["sha256"],
        },
        "review_doc": {"path": source_plan_path, "sha256": source_plan_sha},
        "implementation_pack": {"ref": pack["ref"], "sha256": pack["sha256"]},
        "pr": {
            "url": str(publish.get("pr_url") or publish.get("url") or "https://github.com/living-systems/scherzo/pull/0"),
            "branch": str(publish.get("branch") or "unknown"),
            "base_revision": str(publish.get("publish_base_revision") or publish.get("base_revision") or "unknown-base"),
            "head_revision": str(publish.get("driver_head_revision") or publish.get("head_revision") or publish.get("branch") or "unknown-head"),
        },
        "change": {"changed_files": changed_files, "diff": diff_meta},
        "validation_artifacts": validation_artifacts,
        "plan_completion": {"verdict": verdict, **pc_meta},
        "review_artifacts": review_artifacts,
    }
    validate_schema(code_bundle, CODE_CHANGE_BUNDLE_SCHEMA)
    output_path = resolve_run_root_relative_path(Path(ns.output))
    write_json(output_path, code_bundle)
    copy_best_effort(output_path, Path("tmp/execplan-code-change-bundle.json"))
    sys.stdout.write(canonical_json(code_bundle))


def main(argv: list[str]) -> None:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        raise SystemExit(0 if argv else 2)
    command, args = argv[0], argv[1:]
    if command == "prepare-review-doc-target":
        command_prepare_review_doc_target(args)
    elif command == "validate-review-doc":
        command_validate_review_doc(args)
    elif command == "materialize-pack":
        command_materialize_pack(args)
    elif command == "validate-bundle":
        command_validate_bundle(args)
    elif command == "materialize-commit-stack":
        command_materialize_commit_stack(args)
    elif command == "materialize-bundle":
        materialize_bundle(args)
    elif command == "prepare-revision":
        command_prepare_revision(args)
    elif command == "materialize-revision":
        materialize_revision(args)
    elif command == "implementation-prepare":
        command_implementation_prepare(args)
    elif command == "gate-no-conflict":
        command_gate_no_conflict(args)
    elif command == "materialize-code-change-bundle":
        materialize_code_change_bundle(args)
    else:
        usage()
        fail(f"unknown command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])
