{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/tracker-conformance-driver-request.v1.schema.json",
  "title": "Tracker conformance driver request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "task_source.fetch_candidates",
        "task_source.refresh_by_refs",
        "task_source.lookup_by_operator_ref",
        "comments.post_or_update",
        "state_transitions.transition"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
