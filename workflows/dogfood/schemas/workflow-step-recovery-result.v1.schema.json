{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "decision", "summary", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "workflow_step_recovery_result" },
    "decision": {
      "type": "string",
      "enum": ["recheck", "gave_up"]
    },
    "summary": { "type": "string" },
    "reason": { "type": "string" }
  }
}
