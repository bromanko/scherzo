{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/implementation-completion-submission.v1.schema.json",
  "title": "Scherzo broad implementation completion submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ready_for_verification",
    "changed_files",
    "acceptance_criteria",
    "guardrail_checks",
    "absence_checks",
    "required_references",
    "implementation_inventory",
    "remaining_required_work",
    "blockers"
  ],
  "properties": {
    "ready_for_verification": { "type": "boolean" },
    "changed_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/repo_path" },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "satisfied", "evidence"],
        "properties": {
          "criterion": { "$ref": "#/$defs/non_empty_string" },
          "satisfied": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference", "observation"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["code", "test", "command", "measurement", "inventory"]
                },
                "reference": { "$ref": "#/$defs/non_empty_string" },
                "observation": { "$ref": "#/$defs/non_empty_string" }
              }
            }
          }
        }
      }
    },
    "guardrail_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "path", "baseline", "measured", "requirement"],
        "properties": {
          "metric": { "type": "string", "enum": ["line_count", "import_count"] },
          "path": { "$ref": "#/$defs/repo_path" },
          "baseline": { "type": "integer", "minimum": 1 },
          "measured": { "type": "integer", "minimum": 0 },
          "requirement": { "const": "decrease_from_baseline" }
        }
      }
    },
    "absence_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_check" }
    },
    "required_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_check" }
    },
    "implementation_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "path_pattern", "disposition", "evidence"],
        "properties": {
          "surface": { "$ref": "#/$defs/non_empty_string" },
          "path_pattern": { "$ref": "#/$defs/repo_path" },
          "disposition": {
            "type": "string",
            "enum": ["unchanged", "changed", "not_applicable"]
          },
          "evidence": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "remaining_required_work": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "conflict",
              "missing_input",
              "unsafe_ambiguity",
              "required_decision",
              "infrastructure",
              "other"
            ]
          },
          "description": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "repository_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "pattern", "paths"],
      "properties": {
        "criterion": { "$ref": "#/$defs/non_empty_string" },
        "pattern": { "$ref": "#/$defs/non_empty_string" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo_path" },
          "uniqueItems": true
        }
      }
    }
  }
}
