{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/plan-completion-verdict-submission.v1.schema.json",
  "title": "Scherzo ExecPlan plan-completion verifier submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "blocking_findings",
    "evidence",
    "checked_acceptance_criteria",
    "deferred_manual_verification"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "pass" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": { "blocking_findings": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "fail" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": { "blocking_findings": { "minItems": 1 } }
      }
    }
  ],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "checked_acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deferred_manual_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "reason", "owner", "when"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
