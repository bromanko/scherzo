{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "workstream_id",
    "action_id",
    "gate_id",
    "kind",
    "decided_at_ms",
    "decided_by",
    "rationale",
    "inputs",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "scherzo.decision.v1"
    },
    "artifact_id": {
      "type": "string"
    },
    "workstream_id": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "approve",
        "request_changes",
        "reject",
        "deviate"
      ]
    },
    "decided_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "decided_by": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ref", "sha256"],
        "properties": {
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "pattern": "^workstream-artifacts/sha256/[0-9a-f]{64}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
