{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "workstream_id",
    "phase_id",
    "summary",
    "outputs",
    "recommended_next_actions",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "scherzo.handoff.v1"
    },
    "artifact_id": {
      "type": "string"
    },
    "workstream_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "snapshot"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256",
              "bytes",
              "media_type",
              "original_path",
              "descriptor",
              "producer",
              "validation",
              "summary"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^workstream-artifacts/sha256/[0-9a-f]{64}\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "media_type": {
                "type": "string"
              },
              "original_path": {
                "type": "string",
                "pattern": "^(?!/)(?!\\.\\.($|/))(?!.*(/\\.\\.)(/|$)).+$"
              },
              "descriptor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": { "type": "string" },
                  "ref_type": { "type": "string" },
                  "media_type": { "type": "string" },
                  "artifact_type": { "type": "string" },
                  "source": { "type": "object" },
                  "validation": { "type": "object" },
                  "metadata": { "type": "object" }
                }
              },
              "contract_type": {
                "type": "string"
              },
              "producer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "workflow_id",
                  "run_id",
                  "step_id"
                ],
                "properties": {
                  "workflow_id": {
                    "type": "string"
                  },
                  "run_id": {
                    "type": "string"
                  },
                  "step_id": {
                    "type": "string"
                  }
                }
              },
              "validation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "validator",
                  "checked_at"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "validator": {
                    "type": "string"
                  },
                  "checked_at": {
                    "type": "string"
                  }
                }
              },
              "summary": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
