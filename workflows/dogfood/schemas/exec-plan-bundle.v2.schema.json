{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/exec-plan-bundle.v2.schema.json",
  "title": "Scherzo ExecPlan v2 descriptor-only bundle",
  "$comment": "LIV-1359 narrows v2 consumers to descriptor-first plan resolution through entries[].name == plan. Legacy pre-descriptor plan.ref/review_doc.path-only shapes are rejected by workflow helpers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "media_type",
    "artifact_type",
    "bundle_id",
    "source_issue",
    "workflow",
    "revision",
    "plan",
    "implementation_pack",
    "entries",
    "review_surface",
    "implementation_handoff",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "scherzo.exec_plan_bundle.v2"
    },
    "bundle_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_issue": {
      "$ref": "#/$defs/source_issue"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "run_id",
        "workflow_fingerprint"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "workflow_fingerprint": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "number",
        "supersedes"
      ],
      "properties": {
        "status": {
          "enum": [
            "created",
            "changed",
            "unchanged"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/artifact_ref"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        }
      }
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "review_doc": {
      "$ref": "#/$defs/review_doc"
    },
    "implementation_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes",
        "schema",
        "derived_from_review_doc_sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "schema": {
          "const": ".scherzo/workflows/schemas/implementation-pack.v2.schema.json"
        },
        "derived_from_review_doc_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "review_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pr_url",
        "branch",
        "source_bundle_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "published",
            "reused",
            "not_applicable"
          ]
        },
        "pr_url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ]
        },
        "source_bundle_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact_ref"
            }
          ]
        },
        "head_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ]
        },
        "review_doc_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/repo_path"
            }
          ]
        }
      }
    },
    "implementation_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_identifier",
        "issue_url",
        "workflow_label",
        "bundle_ref"
      ],
      "properties": {
        "issue_identifier": {
          "$ref": "#/$defs/non_empty_string"
        },
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "workflow_label": {
          "const": "workflow:execplan-implementation"
        },
        "bundle_ref": {
          "$ref": "#/$defs/artifact_ref"
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "warning",
              "skipped"
            ]
          },
          "diagnostic": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "kind": {
      "const": "artifact_set"
    },
    "media_type": {
      "const": "application/json"
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/descriptor_entry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_surface": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_surface": {
            "properties": {
              "pr_url": {
                "type": "null"
              },
              "branch": {
                "type": "null"
              },
              "source_bundle_ref": {
                "type": "null"
              },
              "head_revision": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "properties": {
              "status": {
                "enum": [
                  "created",
                  "changed"
                ]
              }
            }
          },
          "review_surface": {
            "properties": {
              "status": {
                "const": "published"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_surface": {
            "properties": {
              "pr_url": {
                "type": "string",
                "format": "uri"
              },
              "branch": {
                "$ref": "#/$defs/non_empty_string"
              },
              "source_bundle_ref": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "properties": {
              "status": {
                "const": "unchanged"
              }
            }
          },
          "review_surface": {
            "properties": {
              "status": {
                "const": "reused"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "properties": {
              "supersedes": {
                "type": "object"
              }
            }
          },
          "review_surface": {
            "properties": {
              "pr_url": {
                "type": "string",
                "format": "uri"
              },
              "branch": {
                "$ref": "#/$defs/non_empty_string"
              },
              "source_bundle_ref": {
                "$ref": "#/$defs/artifact_ref"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "scherzo.exec_plan_bundle.v2"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "media_type",
          "entries"
        ]
      }
    }
  ],
  "$defs": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^runs/[^/]+/.+"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "media_type": {
          "const": "text/markdown"
        }
      }
    },
    "review_doc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "title",
        "url"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "descriptor_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "artifact_type",
        "ref",
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "const": "file"
        },
        "artifact_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "media_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "metadata": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
