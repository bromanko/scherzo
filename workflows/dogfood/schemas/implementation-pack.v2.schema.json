{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scherzo.local/workflows/schemas/implementation-pack.v2.schema.json",
  "title": "Scherzo ExecPlan v2 implementation pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "pack_id",
    "source_issue",
    "review_doc",
    "derived_from",
    "provenance",
    "sections",
    "conflict_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "enum": [
        "scherzo.implementation_pack.v2",
        "implementation_pack"
      ]
    },
    "pack_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_issue": {
      "$ref": "#/$defs/source_issue"
    },
    "review_doc": {
      "$ref": "#/$defs/review_doc"
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_doc_path",
        "review_doc_sha256"
      ],
      "properties": {
        "review_doc_path": {
          "$ref": "#/$defs/repo_path"
        },
        "review_doc_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "run_id",
        "step_id",
        "created_at"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "step_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "created_at": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_context",
        "verified_facts",
        "concrete_steps",
        "testing_and_falsifiability",
        "interfaces_and_dependencies",
        "artifacts_and_notes"
      ],
      "properties": {
        "repo_context": {
          "$ref": "#/$defs/non_empty_string"
        },
        "verified_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact",
              "evidence"
            ],
            "properties": {
              "fact": {
                "$ref": "#/$defs/non_empty_string"
              },
              "evidence": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        "concrete_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "instructions",
              "files",
              "commands",
              "expected_result"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/non_empty_string"
              },
              "instructions": {
                "$ref": "#/$defs/non_empty_string"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/repo_path"
                }
              },
              "commands": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/non_empty_string"
                }
              },
              "expected_result": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        "testing_and_falsifiability": {
          "$ref": "#/$defs/non_empty_string"
        },
        "interfaces_and_dependencies": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifacts_and_notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "conflict_policy": {
      "$ref": "#/$defs/non_empty_string"
    },
    "kind": {
      "const": "file"
    },
    "media_type": {
      "const": "application/json"
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^runs/[^/]+/.+"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
    },
    "review_doc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "title",
        "url"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "scherzo.implementation_pack.v2"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "media_type"
        ]
      }
    }
  ]
}
