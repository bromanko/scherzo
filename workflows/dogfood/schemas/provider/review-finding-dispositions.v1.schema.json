{
  "type": "object",
  "description": "Provider-facing review finding disposition input. Scherzo captures this with submit_review_finding_dispositions and materializes it to tmp/review-finding-dispositions.v1.json before finalization.",
  "required": [
    "schema_version",
    "artifact_type",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "JSON number 1. Strings such as \"1\" are invalid.",
      "minimum": 1,
      "maximum": 1
    },
    "artifact_type": {
      "type": "string",
      "description": "Must be review_finding_disposition_input.",
      "pattern": "^review_finding_disposition_input$"
    },
    "entries": {
      "type": "array",
      "description": "One disposition entry for each synthesized finding id in final-review.v1.json.",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "disposition",
          "rationale",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "disposition": {
            "type": "string",
            "pattern": "^(resolved|rejected|deferred|obsolete)$"
          },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "ref": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
