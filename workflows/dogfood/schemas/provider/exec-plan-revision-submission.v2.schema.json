{
  "type": "object",
  "description": "Provider-facing ExecPlan v2 revision submission. Scherzo validates captured submissions against the canonical exec-plan-revision-submission.v2 schema after tool capture.",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "revision_status",
    "source_issue",
    "sections",
    "conflict_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^exec_plan_revision_submission$"
    },
    "revision_status": {
      "type": "string",
      "pattern": "^(changed|unchanged)$"
    },
    "pack_id": { "type": "string", "minLength": 1 },
    "source_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "title", "url"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_context",
        "verified_facts",
        "concrete_steps",
        "testing_and_falsifiability",
        "interfaces_and_dependencies",
        "artifacts_and_notes"
      ],
      "properties": {
        "repo_context": { "type": "string", "minLength": 1 },
        "verified_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact", "evidence"],
            "properties": {
              "fact": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "concrete_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "instructions",
              "files",
              "commands",
              "expected_result"
            ],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "instructions": { "type": "string", "minLength": 1 },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
                }
              },
              "commands": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "expected_result": { "type": "string", "minLength": 1 }
            }
          }
        },
        "testing_and_falsifiability": { "type": "string", "minLength": 1 },
        "interfaces_and_dependencies": { "type": "string", "minLength": 1 },
        "artifacts_and_notes": { "type": "string", "minLength": 1 }
      }
    },
    "conflict_policy": { "type": "string", "minLength": 1 },
    "revision_notes": { "type": "string" }
  }
}
