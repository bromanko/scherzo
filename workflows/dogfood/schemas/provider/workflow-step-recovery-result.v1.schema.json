{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "decision", "summary", "reason"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "artifact_type": { "type": "string", "pattern": "^workflow_step_recovery_result$" },
    "decision": {
      "type": "string",
      "pattern": "^(recheck|gave_up)$"
    },
    "summary": { "type": "string" },
    "reason": { "type": "string" }
  }
}
