{
  "type": "object",
  "description": "Provider-facing full review lane draft schema for native structured-output contract probes. Scherzo validates captured drafts against the canonical review-lane-draft.v1 schema after tool capture.",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at_utc",
    "producer",
    "lane",
    "input_refs",
    "draft_findings",
    "review_notes",
    "evidence_requests",
    "self_check",
    "remote_mutations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^review_lane_draft$"
    },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "category", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(correctness|test-quality|idioms-maintainability|security-performance)$"
        },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tool": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["artifact_type", "path"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\$(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)(?:[\\\\/]|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "draft_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "draft_finding_id",
          "title",
          "claim",
          "severity",
          "proposed_blocking",
          "locations",
          "evidence_request_ids"
        ],
        "properties": {
          "draft_finding_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "severity": {
            "type": "string",
            "pattern": "^(info|low|medium|high|critical)$"
          },
          "proposed_blocking": { "type": "boolean" },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\$(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)(?:[\\\\/]|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
                },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string" },
                "diff_hunk": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          },
          "evidence_request_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "suggested_fix": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "kind",
          "category",
          "severity",
          "locations",
          "summary",
          "details",
          "suggested_action"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "pattern": "^(risk_note|coverage_note|review_note|follow_up_test)$"
          },
          "category": {
            "type": "string",
            "pattern": "^(correctness|maintainability|security|performance|testing|workflow|documentation|artifact_contract|other)$"
          },
          "severity": {
            "type": "string",
            "pattern": "^(info|low|medium|high|critical)$"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string" },
                "diff_hunk": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          },
          "summary": { "type": "string", "minLength": 1 },
          "details": { "type": "string", "minLength": 1 },
          "suggested_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "request_id",
          "draft_finding_id",
          "evidence_key",
          "claim",
          "expected_observation",
          "target"
        ],
        "properties": {
          "request_id": { "type": "string", "minLength": 1 },
          "draft_finding_id": { "type": "string", "minLength": 1 },
          "evidence_key": { "type": "string", "minLength": 1, "description": "Allowed native review evidence keys: gleam_test, glinter, scherzo_lint, schema_validate_artifacts, diff_static_scan, fixture_reproduction, context_only. Use context_only for unsupported or manual review context instead of inventing lane-specific keys." },
          "claim": { "type": "string", "minLength": 1 },
          "expected_observation": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "test_name": { "type": "string", "minLength": 1 },
              "fixture_id": { "type": "string", "minLength": 1 },
              "artifact_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\$(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)(?:[\\\\/]|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
              },
              "changed_file_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\$(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)(?:[\\\\/]|$))(?![A-Za-z]:[\\\\/])(?!<absolute-local-path>)[^\\u0000]+$"
              },
              "static_scan_rule": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": true
    },
    "remote_mutations": {
      "type": "string",
      "pattern": "^none$"
    }
  }
}
