import gleam/list

pub fn without_workflow_context(command: String) -> String {
  let prefix =
    workflow_context_keys()
    |> list.fold("env", fn(prefix, key) { prefix <> " -u " <> key })

  prefix <> " " <> command
}

fn workflow_context_keys() -> List(String) {
  [
    "SCHERZO_ATTEMPT_INDEX",
    "SCHERZO_ATTEMPT_KEY",
    "GITHUB_REPOSITORY",
    "SCHERZO_CONFIG_DIR",
    "SCHERZO_GITHUB_REPO",
