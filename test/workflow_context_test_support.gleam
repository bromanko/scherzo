    "SCHERZO_JJ_WORKSPACE_BASE_BRANCH",
    "SCHERZO_JJ_WORKSPACE_FETCH_BASE",
    "SCHERZO_JJ_WORKSPACE_PUBLISH_REMOTE",
    "SCHERZO_JJ_WORKSPACE_REMOTE",
    "SCHERZO_PR_BASE",
    "SCHERZO_PR_DRAFT",
    "SCHERZO_PR_REMOTE",
    "SCHERZO_PR_REPO",
    "SCHERZO_REPO_ROOT",
    "SCHERZO_RUN_ATTEMPT",
    "SCHERZO_RUN_ID",
    "SCHERZO_RUN_KIND",
    "SCHERZO_RUN_ROOT",
    "SCHERZO_SCHEDULED_JOB_ID",
    "SCHERZO_SCHEDULE_DUE_AT",
