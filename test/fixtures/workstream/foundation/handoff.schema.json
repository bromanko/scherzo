{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "workstream_id",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "scherzo.handoff.v1"
    },
    "workstream_id": {
      "type": "string",
      "pattern": "^linear:[A-Z]+-[0-9]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
