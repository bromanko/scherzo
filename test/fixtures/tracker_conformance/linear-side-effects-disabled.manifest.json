{
  "schema_version": 1,
  "adapter_kind": "linear",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "scripts/scherzo-linear-conformance",
      "args": ["driver", "--mode", "live", "--project", "fixture-linear-conformance"],
      "cwd": ".",
      "env": [
        { "name": "SCHERZO_LINEAR_CONFORMANCE_API_KEY", "value": "fake-linear-token" }
      ]
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": ["task_source", "comments.create", "comments.update", "comments.allow_create_fallback"],
    "requested_packs": ["task_source", "comments"],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref",
      "comments.post_or_update"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/linear-fixture-tasks.json",
    "tasks": [
      {
        "name": "linear-task-source-primary",
        "ref": {
          "backend_kind": "linear",
          "remote_id": "lin-fixture-1",
          "key": "SCONF-1",
          "url": "https://linear.example/scherzo-conformance/SCONF-1"
        },
        "operator_refs": ["SCONF-1", "lin-fixture-1"],
        "purpose": "Synthetic fixture used to verify live side-effect packs stay disabled"
      }
    ]
  },
  "report": { "redact": ["fake-linear-token"] }
}
