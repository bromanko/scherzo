{
  "schema_version": 1,
  "adapter_kind": "linear",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "scripts/scherzo-linear-conformance",
      "args": [
        "driver",
        "--mode",
        "offline",
        "--fixture-file",
        "test/fixtures/tracker_conformance/linear-fixture-tasks.json"
      ],
      "cwd": ".",
      "env": [
        { "name": "SCHERZO_LINEAR_CONFORMANCE_API_KEY", "value": "fake-linear-token" }
      ]
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": ["task_source"],
    "requested_packs": ["task_source"],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/linear-fixture-tasks.json",
    "tasks": [
      {
        "name": "linear-task-source-primary",
        "ref": {
          "backend_kind": "linear",
          "remote_id": "lin-fixture-1",
          "key": "SCONF-1",
          "url": "https://linear.example/scherzo-conformance/SCONF-1"
        },
        "operator_refs": ["SCONF-1", "lin-fixture-1"],
        "purpose": "Synthetic offline Linear fixture used to verify repeated setup and cleanup"
      }
    ]
  },
  "probes": [
    {
      "name": "linear-visible",
      "command": {
        "executable": "sh",
        "args": ["-c", "printf 'probe ok linear-fixture-secret\\n' >&2"],
        "cwd": "."
      }
    }
  ],
  "hooks": {
    "setup": {
      "executable": "sh",
      "args": ["-c", "printf 'setup ok linear-fixture-secret\\n' >&2"],
      "cwd": "."
    },
    "cleanup": {
      "executable": "sh",
      "args": ["-c", "printf 'cleanup ok linear-fixture-secret\\n' >&2"],
      "cwd": "."
    }
  },
  "report": {
    "redact": [
      "fake-linear-token",
      "Bearer fake-linear-token",
      "linear-fixture-secret"
    ]
  }
}
