{
  "schema_version": 1,
  "adapter_kind": "test-memory",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "test/fixtures/tracker_conformance/fake_task_source_driver.sh",
      "args": ["--mode", "serve", "--scenario", "pass"],
      "cwd": ".",
      "env": [{ "name": "TEST_MODE", "value": "fixture" }]
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": ["task_source"],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/task-source-fetch.response.json"
  },
  "probes": [
    {
      "name": "fixture-visible",
      "command": { "executable": "sh", "args": ["-c", "printf 'probe ok SECRET_TOKEN\\n' >&2"], "cwd": "." }
    }
  ],
  "hooks": {
    "setup": { "executable": "sh", "args": ["-c", "printf 'setup ok SECRET_TOKEN\\n' >&2"], "cwd": "." },
    "cleanup": { "executable": "sh", "args": ["-c", "printf 'cleanup ok SECRET_TOKEN\\n' >&2"], "cwd": "." }
  },
  "report": {
    "redact": ["SECRET_TOKEN"]
  }
}
