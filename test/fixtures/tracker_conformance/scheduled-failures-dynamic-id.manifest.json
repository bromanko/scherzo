{
  "schema_version": 1,
  "adapter_kind": "test-memory",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "test/fixtures/tracker_conformance/fake_task_source_driver.sh",
      "args": [
        "--scenario",
        "scheduled-failures-dynamic-id"
      ],
      "cwd": ".",
      "env": []
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": [
      "task_source",
      "scheduled_failures"
    ],
    "requested_packs": [
      "task_source",
      "scheduled_failures"
    ],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref",
      "scheduled_failures.publish"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/task-source-fetch.response.json"
  },
  "probes": [
    {
      "name": "scheduled-failures-visible",
      "command": {
        "executable": "test/fixtures/tracker_conformance/fake_conformance_state.sh",
        "args": [
          "scheduled",
          "probe",
          "scheduled-failures-dynamic-id"
        ],
        "cwd": "."
      }
    }
  ],
  "hooks": {
    "setup": {
      "executable": "test/fixtures/tracker_conformance/fake_conformance_state.sh",
      "args": [
        "scheduled",
        "setup",
        "scheduled-failures-dynamic-id"
      ],
      "cwd": "."
    },
    "cleanup": {
      "executable": "test/fixtures/tracker_conformance/fake_conformance_state.sh",
      "args": [
        "scheduled",
        "cleanup",
        "scheduled-failures-dynamic-id"
      ],
      "cwd": "."
    }
  },
  "report": {
    "redact": [
      "SECRET_TOKEN"
    ]
  }
}
