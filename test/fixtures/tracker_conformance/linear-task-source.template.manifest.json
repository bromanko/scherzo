{
  "schema_version": 1,
  "adapter_kind": "linear",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "scripts/scherzo-linear-conformance",
      "args": [
        "driver",
        "--mode",
        "live",
        "--project",
        "<fixture-project-slug>"
      ],
      "cwd": ".",
      "env": [
        {
          "name": "SCHERZO_LINEAR_CONFORMANCE_API_KEY",
          "value": "<set-by-operator-wrapper>"
        }
      ]
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": ["task_source"],
    "requested_packs": ["task_source"],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/linear-fixture-tasks.json",
    "tasks": [
      {
        "name": "linear-task-source-primary",
        "ref": {
          "backend_kind": "linear",
          "remote_id": "<fixture-linear-issue-id>",
          "key": "SCONF-1",
          "url": "https://linear.app/<workspace-or-team>/issue/SCONF-1"
        },
        "operator_refs": ["SCONF-1", "<fixture-linear-issue-id>"],
        "purpose": "Synthetic read-only Linear fixture used for task_source refresh and lookup checks"
      }
    ]
  },
  "report": {
    "redact": [
      "<resolved-conformance-token>",
      "Bearer <resolved-conformance-token>",
      "<fixture-secret-marker>"
    ]
  }
}
