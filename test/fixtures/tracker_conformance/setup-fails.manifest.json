{
  "schema_version": 1,
  "adapter_kind": "test-memory",
  "driver": {
    "transport": "cli",
    "command": {
      "executable": "test/fixtures/tracker_conformance/fake_task_source_driver.sh",
      "args": ["--mode", "serve", "--scenario", "pass"],
      "cwd": ".",
      "env": []
    },
    "timeout_ms": 5000
  },
  "profile": {
    "name": "task_source",
    "capabilities": ["task_source"],
    "adapter_operations": [
      "task_source.fetch_candidates",
      "task_source.refresh_by_refs",
      "task_source.lookup_by_operator_ref"
    ]
  },
  "fixtures": {
    "task_file": "test/fixtures/tracker_conformance/task-source-fetch.response.json"
  },
  "probes": [],
  "hooks": {
    "setup": { "executable": "sh", "args": ["-c", "printf 'setup failed SECRET_TOKEN\\n' >&2; exit 4"], "cwd": "." }
  },
  "report": { "redact": ["SECRET_TOKEN"] }
}
